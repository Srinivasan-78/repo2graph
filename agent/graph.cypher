MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_nan_exp_claim_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_nan_exp_claim_is_refused", `name`: "test_a_nan_exp_claim_is_refused", `qualname`: "test_a_nan_exp_claim_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 274, `end_line`: 282, `signature`: "def test_a_nan_exp_claim_is_refused():", `docstring`: "NaN compares False against every relational operator in IEEE 754.\n\n    `float(\"nan\") + CLOCK_SKEW < now` is False, so a naive expiry check lets a\n    NaN `exp` claim through as if the token never expires. It must fail closed.", `entrypoint`: true, `reach`: 26};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_an_infinite_exp_claim_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_an_infinite_exp_claim_is_refused", `name`: "test_an_infinite_exp_claim_is_refused", `qualname`: "test_an_infinite_exp_claim_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 285, `end_line`: 289, `signature`: "def test_an_infinite_exp_claim_is_refused():", `docstring`: "+Infinity satisfies `exp + CLOCK_SKEW < now` as False forever too.", `entrypoint`: true, `reach`: 26};
