MERGE (n:R2G:Symbol {id: "sym:repo2graph/changelog.py::_edge_line"}) SET n += {`id`: "sym:repo2graph/changelog.py::_edge_line", `name`: "_edge_line", `qualname`: "_edge_line", `kind`: "function", `path`: "repo2graph/changelog.py", `lang`: "python", `start_line`: 121, `end_line`: 124, `signature`: "def _edge_line(e: dict[str, Any]) -> str:", `docstring`: ""};
