MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_iss90_auto_build_reaches_the_pool_and_detaches_its_workers"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss90_auto_build_reaches_the_pool_and_detaches_its_workers", `name`: "test_iss90_auto_build_reaches_the_pool_and_detaches_its_workers", `qualname`: "test_iss90_auto_build_reaches_the_pool_and_detaches_its_workers", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1202, `end_line`: 1236, `signature`: "def test_iss90_auto_build_reaches_the_pool_and_detaches_its_workers(\n    wide_repo, tmp_path, monkeypatch\n):", `docstring`: "The pin is gone: above PARALLEL_MIN_FILES the auto-build really forks\n    out, and the pool it builds carries the stdio initializer.\n\n    `wide_repo` is the fixture #67 asks for -- every other fixture in the\n    suite is under the threshold, so before it existed this branch could not\n    be reached from a test at all.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_iss90_auto_build_reaches_the_pool_and_detaches_its_workers.Recording"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss90_auto_build_reaches_the_pool_and_detaches_its_workers.Recording", `name`: "Recording", `qualname`: "test_iss90_auto_build_reaches_the_pool_and_detaches_its_workers.Recording", `kind`: "class", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1220, `end_line`: 1223, `signature`: "class Recording(real):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_iss90_auto_build_reaches_the_pool_and_detaches_its_workers.Recording.__init__"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss90_auto_build_reaches_the_pool_and_detaches_its_workers.Recording.__init__", `name`: "__init__", `qualname`: "test_iss90_auto_build_reaches_the_pool_and_detaches_its_workers.Recording.__init__", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1221, `end_line`: 1223, `signature`: "def __init__(self, *args, **kwargs):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_iss90_pool_workers_cannot_reach_the_parents_stdin_or_stdout"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss90_pool_workers_cannot_reach_the_parents_stdin_or_stdout", `name`: "test_iss90_pool_workers_cannot_reach_the_parents_stdin_or_stdout", `qualname`: "test_iss90_pool_workers_cannot_reach_the_parents_stdin_or_stdout", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1239, `end_line`: 1281, `signature`: "def test_iss90_pool_workers_cannot_reach_the_parents_stdin_or_stdout():", `docstring`: "The mechanism itself, in a child process whose stdio is a pipe.\n\n    `_pool_stdio_probe.py` starts a pool with the exact kwargs `parse_all`\n    passes, and has one worker write a sentinel to fd 1 and read a byte from\n    fd 0. Measured on Windows (spawn) before the fix, a worker did both for\n    real: the sentinel landed in the parent's stdout pipe and the worker\n    consumed the byte the parent had queued -- which under `repo2graph-mcp`\n    is a frame of the client's request stream the server then waits for\n    forever.\n\n    `timeout=` is the hard bound: a regression that hangs a worker on fd", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_iss90_tools_call_over_serve_completes_on_the_parallel_path"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss90_tools_call_over_serve_completes_on_the_parallel_path", `name`: "test_iss90_tools_call_over_serve_completes_on_the_parallel_path", `qualname`: "test_iss90_tools_call_over_serve_completes_on_the_parallel_path", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1285, `end_line`: 1377, `signature`: "def test_iss90_tools_call_over_serve_completes_on_the_parallel_path(wide_repo, tmp_path):", `docstring`: "AC-2, end to end: a real `serve()` over real pipes against a repo above\n    PARALLEL_MIN_FILES answers its first tool call.\n\n    The marker file is what makes this about the *parallel* path: the launcher\n    records every ProcessPoolExecutor the server process builds, so a silent\n    fall back to serial fails here rather than passing quietly.\n\n    Timeouts everywhere -- a queue-fed reader thread, not a bare readline --\n    because the bug being guarded is a hang, and a test that reproduces it\n    with `proc.stdout.readline()` would never return.", `entrypoint`: true, `reach`: 49};
MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_iss90_tools_call_over_serve_completes_on_the_parallel_path.pump"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss90_tools_call_over_serve_completes_on_the_parallel_path.pump", `name`: "pump", `qualname`: "test_iss90_tools_call_over_serve_completes_on_the_parallel_path.pump", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1311, `end_line`: 1316, `signature`: "def pump():", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_iss90_tools_call_over_serve_completes_on_the_parallel_path.send"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss90_tools_call_over_serve_completes_on_the_parallel_path.send", `name`: "send", `qualname`: "test_iss90_tools_call_over_serve_completes_on_the_parallel_path.send", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1320, `end_line`: 1322, `signature`: "def send(payload):", `docstring`: ""};
