MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_rmtree_removes_read_only_files"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_rmtree_removes_read_only_files", `name`: "test_rmtree_removes_read_only_files", `qualname`: "test_rmtree_removes_read_only_files", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2632, `end_line`: 2647, `signature`: "def test_rmtree_removes_read_only_files(tmp_path):", `docstring`: "index_github's temp-clone cleanup must survive the read-only bit Git puts\n    on Windows pack files, or it leaks the whole clone (matters only on Windows;\n    on POSIX unlink needs write on the parent dir, not the file).", `entrypoint`: true};
