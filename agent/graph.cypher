MERGE (n:R2G:`Symbol` {id: "sym:tests/test_integrity.py::TestBuildLock.test_an_aged_lock_is_not_stolen_from_a_live_holder"}) SET n += {`id`: "sym:tests/test_integrity.py::TestBuildLock.test_an_aged_lock_is_not_stolen_from_a_live_holder", `name`: "test_an_aged_lock_is_not_stolen_from_a_live_holder", `qualname`: "TestBuildLock.test_an_aged_lock_is_not_stolen_from_a_live_holder", `kind`: "function", `path`: "tests/test_integrity.py", `lang`: "python", `start_line`: 289, `end_line`: 313, `signature`: "def test_an_aged_lock_is_not_stolen_from_a_live_holder(self, tmp_path):", `docstring`: "A build slower than the stale threshold keeps its lock.\n\n        `_write_metadata` runs once, at acquire, so mtime measures how long\n        the holder has been working -- not whether it is stuck. Reclaiming on\n        that alone meant any build over the threshold was joined by a second.", `entrypoint`: true};
