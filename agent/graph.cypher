MERGE (n:R2G:`Symbol` {id: "sym:tests/test_grammar_availability.py::test_language_pack_is_capped_below_1_0"}) SET n += {`id`: "sym:tests/test_grammar_availability.py::test_language_pack_is_capped_below_1_0", `name`: "test_language_pack_is_capped_below_1_0", `qualname`: "test_language_pack_is_capped_below_1_0", `kind`: "function", `path`: "tests/test_grammar_availability.py", `lang`: "python", `start_line`: 268, `end_line`: 288, `signature`: "def test_language_pack_is_capped_below_1_0():", `docstring`: "0.x bundles every grammar in the wheel; 1.x downloads them on first use.\n\n    0.13.0 ships a 33 MB wheel. 1.20.0 ships 2.5 MB and an 89 KB sdist, fetching\n    ~21 MB of unsigned native code from the network into the process holding the\n    user's source. That contradicts the no-network guarantee in README.md and\n    .github/SECURITY.md, and makes `uv.lock` and the SBOM describe a loader\n    rather than what actually executes. A dependabot bump must not quietly undo\n    this, so the bound is asserted rather than merely commented.", `entrypoint`: true};
