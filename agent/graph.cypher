MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_mcp_open_index_detects_external_rebuild"}) SET n += {`id`: "sym:tests/test_mcp.py::test_mcp_open_index_detects_external_rebuild", `name`: "test_mcp_open_index_detects_external_rebuild", `qualname`: "test_mcp_open_index_detects_external_rebuild", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1667, `end_line`: 1699, `signature`: "def test_mcp_open_index_detects_external_rebuild(tmp_path):", `docstring`: "Issue 125: open_index detects when index was rebuilt externally and reloads.", `entrypoint`: true, `reach`: 82};
