MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::is_test_path"}) SET n += {`id`: "sym:repo2graph/query.py::is_test_path", `name`: "is_test_path", `qualname`: "is_test_path", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 234, `end_line`: 253, `signature`: "def is_test_path(path: str) -> bool:", `docstring`: "Whether a repo-relative path is test code, matched per path component.\n\n    `endswith(\"test.py\")` is true of `latest.py`, `fastest.py` and\n    `manifest.py`, so the check is on components and known suffixes -- the bug\n    the original version of this predicate was written to fix, which is why the\n    property test in `tests/test_properties.py` pins separator invariance.\n\n    It lived in `impact.py` until that module was removed; retrieval is the only\n    remaining caller, so it lives here now."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::classify_query"}) SET n += {`id`: "sym:repo2graph/query.py::classify_query", `name`: "classify_query", `qualname`: "classify_query", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 271, `end_line`: 297, `signature`: "def classify_query(query: str) -> str:", `docstring`: "What shape of answer the question asks for.\n\n    Returns one of `\"callers\"`, `\"callees\"`, `\"trace\"` or `\"concept\"`.\n    `\"concept\"` is the default and the one that changes nothing: a question that\n    named no direction must keep following both, because narrowing it on a guess\n    would lose answers that the old behaviour found.\n\n    Callee phrasings are tested first. \"What are the callees of X\" contains\n    \"call\", so a caller pattern would otherwise claim it."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::asks_about_tests"}) SET n += {`id`: "sym:repo2graph/query.py::asks_about_tests", `name`: "asks_about_tests", `qualname`: "asks_about_tests", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 300, `end_line`: 314, `signature`: "def asks_about_tests(query: str) -> bool:", `docstring`: "Whether the question is asking *about* the tests.\n\n    Deliberately independent of `classify_query`, because the two answers are:\n    \"which tests use the parser\" is a caller question *and* a question about\n    tests, and it needs the caller direction filter and the test seeds left\n    alone. Reading it off the single shape gave it neither -- the caller pattern\n    `(what|who|which)\\\\s+(\\\\w+\\\\s+){0,3}?uses?` claims \"which tests use X\"\n    before `_TEST_PATTERNS` is reached, so `classify_query` answered \"callers\"\n    and the demotion below fired on exactly the chunks the question asked for.\n   "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::edge_dirs_for"}) SET n += {`id`: "sym:repo2graph/query.py::edge_dirs_for", `name`: "edge_dirs_for", `qualname`: "edge_dirs_for", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 317, `end_line`: 325, `signature`: "def edge_dirs_for(shape: str) -> dict[str, tuple[str, ...]] | None:", `docstring`: "The traversal filter a question shape implies, or None to keep the default."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::read_jsonl"}) SET n += {`id`: "sym:repo2graph/query.py::read_jsonl", `name`: "read_jsonl", `qualname`: "read_jsonl", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 346, `end_line`: 377, `signature`: "def read_jsonl(path: Path) -> list[Record]:", `docstring`: "Load and parse JSONL records from a file with per-line byte ceilings.\n\n    Args:\n        path: Path to the JSONL file.\n\n    Returns:\n        List of parsed JSON record dictionaries.\n\n    Raises:\n        ValueError: If path is a symlink, or if any line exceeds MAX_JSONL_LINE_BYTES,\n            or contains invalid JSON."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::count_tokens"}) SET n += {`id`: "sym:repo2graph/query.py::count_tokens", `name`: "count_tokens", `qualname`: "count_tokens", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 380, `end_line`: 383, `signature`: "def count_tokens(text: str) -> int:", `docstring`: "The default token estimate: len(text) // CHARS_PER_TOKEN, never 0 for a\n    non-empty string (a block that costs nothing would defeat any budget)."};
