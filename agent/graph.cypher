MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp/retrieval.py::_encloses"}) SET n += {`id`: "sym:repo2graph/mcp/retrieval.py::_encloses", `name`: "_encloses", `qualname`: "_encloses", `kind`: "function", `path`: "repo2graph/mcp/retrieval.py", `lang`: "python", `start_line`: 516, `end_line`: 521, `signature`: "def _encloses(node: dict[str, Any], line: int) -> bool:", `docstring`: "Whether `node` covers `line`: a file covers all of itself, a symbol its span."};
