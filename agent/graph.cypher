MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::pick_provider"}) SET n += {`id`: "sym:repo2graph/answer.py::pick_provider", `name`: "pick_provider", `qualname`: "pick_provider", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 116, `end_line`: 148, `signature`: "def pick_provider(\n    env: dict[str, str] | os._Environ[str] | Any | None = None,\n    provider: str | None = None,\n) -> dict[str, str] | None:", `docstring`: "The configured provider, or first in GEMINI > OPENAI > ANTHROPIC > OLLAMA order."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::build_prompt"}) SET n += {`id`: "sym:repo2graph/answer.py::build_prompt", `name`: "build_prompt", `qualname`: "build_prompt", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 151, `end_line`: 175, `signature`: "def build_prompt(pack: dict[str, Any] | None, *, nonce: str | None = None) -> tuple[str, str]:", `docstring`: "(system, user). The pack rides inside a nonced untrusted-content fence.\n\n    `nonce` is injectable for tests only; production callers leave it None and\n    get a fresh random one per call."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_request"}) SET n += {`id`: "sym:repo2graph/answer.py::_request", `name`: "_request", `qualname`: "_request", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 178, `end_line`: 240, `signature`: "def _request(\n    spec: dict[str, str], model: str | None, system: str, user: str\n) -> tuple[str, dict[str, str], dict[str, Any]]:", `docstring`: "(url, headers, payload) for the chosen provider's streaming endpoint."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_ollama_base"}) SET n += {`id`: "sym:repo2graph/answer.py::_ollama_base", `name`: "_ollama_base", `qualname`: "_ollama_base", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 243, `end_line`: 257, `signature`: "def _ollama_base(value: str) -> str:", `docstring`: "Normalise OLLAMA_HOST to an http(s) base URL.\n\n    `ollama serve` documents (and exports) the schemeless `127.0.0.1:11434`,\n    which urlopen rejects with `unknown url type: 127.0.0.1`. Default the\n    scheme to http and refuse anything that is not http(s), so a stray\n    `file://` value cannot turn into an urlopen target."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_delta"}) SET n += {`id`: "sym:repo2graph/answer.py::_delta", `name`: "_delta", `qualname`: "_delta", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 260, `end_line`: 282, `signature`: "def _delta(name: str, raw: bytes) -> str:", `docstring`: "One streamed line -> the text it carries, or '' if it carries none."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_blocks"}) SET n += {`id`: "sym:repo2graph/answer.py::_blocks", `name`: "_blocks", `qualname`: "_blocks", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 285, `end_line`: 306, `signature`: "def _blocks(resp: Any) -> Iterator[bytes]:", `docstring`: "Yield the response body in READ_BLOCK-sized pieces.\n\n    `http.client.HTTPResponse.read(n)` is the real path here, and the sized read\n    is the whole point: `for raw in resp` reads until a newline, so a body that\n    never sends one is already a single unbounded `bytes` by the time the caller\n    is handed it. Some response-like objects only support iteration (a test\n    stand-in, a pre-split body); those keep their own framing, and the byte\n    ceiling in `_BoundedLines` still applies to what they yield."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_BoundedLines"}) SET n += {`id`: "sym:repo2graph/answer.py::_BoundedLines", `name`: "_BoundedLines", `qualname`: "_BoundedLines", `kind`: "class", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 309, `end_line`: 360, `signature`: "class _BoundedLines:", `docstring`: "Newline framing over a response body, with a hard byte ceiling.\n\n    Three unbounded reads close here. The body arrives in fixed blocks, so no\n    single newline-less line can grow without limit; the running total stops the\n    stream once `limit` bytes have been taken, so a trickle of well-formed small\n    deltas cannot either; and `deadline` stops it once the whole transfer has\n    run longer than a real answer ever does, which is the case neither of the\n    other two catches -- a host sending one byte at a time, slowly, stays under\n    the byte ceiling forever and resets the socket timeout "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_BoundedLines.__init__"}) SET n += {`id`: "sym:repo2graph/answer.py::_BoundedLines.__init__", `name`: "__init__", `qualname`: "_BoundedLines.__init__", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 326, `end_line`: 332, `signature`: "def __init__(self, resp: Any, limit: int, seconds: float | None = None) -> None:", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_BoundedLines.__iter__"}) SET n += {`id`: "sym:repo2graph/answer.py::_BoundedLines.__iter__", `name`: "__iter__", `qualname`: "_BoundedLines.__iter__", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 334, `end_line`: 360, `signature`: "def __iter__(self) -> Iterator[bytes]:", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_note_truncated"}) SET n += {`id`: "sym:repo2graph/answer.py::_note_truncated", `name`: "_note_truncated", `qualname`: "_note_truncated", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 363, `end_line`: 378, `signature`: "def _note_truncated(name: str, limit: int) -> None:", `docstring`: "Say on stderr that the answer was cut off at the byte ceiling.\n\n    A ceiling that silently drops the tail turns a partial answer into one that\n    looks whole, which is the failure mode `_empty_answer` exists to avoid for\n    the no-text case. stderr, not stdout, for the same reason `_disclose` uses\n    it: stdout is the answer and has to stay pipeable."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_note_timed_out"}) SET n += {`id`: "sym:repo2graph/answer.py::_note_timed_out", `name`: "_note_timed_out", `qualname`: "_note_timed_out", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 381, `end_line`: 396, `signature`: "def _note_timed_out(name: str, seconds: float) -> None:", `docstring`: "Say on stderr that the stream ran past its wall-clock budget.\n\n    Distinct wording from `_note_truncated` on purpose: \"too slow\" and \"too\n    much\" point at different causes, and a user who sees the byte-ceiling\n    message for a stalled endpoint will go looking for an answer that was never\n    large."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_writer"}) SET n += {`id`: "sym:repo2graph/answer.py::_writer", `name`: "_writer", `qualname`: "_writer", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 399, `end_line`: 423, `signature`: "def _writer(out: Any = None) -> Callable[[str], None]:", `docstring`: "A write callable that cannot raise UnicodeEncodeError.\n\n    Always writes through the stream's own text-mode `write`, never through\n    `sys.stdout.buffer`: on Windows the console expects bytes in its active\n    codepage (cp1252, cp437, ...), and writing raw UTF-8 bytes straight to\n    the buffer bypasses `TextIOWrapper`'s console translation, producing\n    mojibake even though no exception is raised (#169). A non-ASCII token\n    from a model would otherwise abort the whole answer mid-sentence, so the\n    chunk is folded to what the stream's own encoding can represent first."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_writer.write_text"}) SET n += {`id`: "sym:repo2graph/answer.py::_writer.write_text", `name`: "write_text", `qualname`: "_writer.write_text", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 412, `end_line`: 421, `signature`: "def write_text(chunk: str) -> None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_flush"}) SET n += {`id`: "sym:repo2graph/answer.py::_flush", `name`: "_flush", `qualname`: "_flush", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 426, `end_line`: 430, `signature`: "def _flush(stream: Any) -> None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_http_error"}) SET n += {`id`: "sym:repo2graph/answer.py::_http_error", `name`: "_http_error", `qualname`: "_http_error", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 433, `end_line`: 445, `signature`: "def _http_error(spec: dict[str, str], exc: Any) -> str:", `docstring`: "A one-line explanation of a provider HTTP error, without its URL.\n\n    HTTPError.url can carry credentials for some providers, so it is never\n    echoed; the status and the provider's own message are enough to act on."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_empty_answer"}) SET n += {`id`: "sym:repo2graph/answer.py::_empty_answer", `name`: "_empty_answer", `qualname`: "_empty_answer", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 448, `end_line`: 470, `signature`: "def _empty_answer(spec: dict[str, str], raw_tail: list[bytes]) -> str:", `docstring`: "Why a 200 response carried no answer text.\n\n    Ollama answers HTTP 200 with {\"error\": \"model 'x' not found\"}; without this\n    the command would print nothing and exit 0, which reads as a valid empty\n    answer."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_disclose"}) SET n += {`id`: "sym:repo2graph/answer.py::_disclose", `name`: "_disclose", `qualname`: "_disclose", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 473, `end_line`: 503, `signature`: "def _disclose(name: str, env: str, url: str, n_chars: int) -> None:", `docstring`: "Tell the user, on stderr, where their repository content is going.\n\n    Takes the three scalars it prints rather than the provider `spec`, because\n    that dict also carries the resolved API key under \"value\". A logging\n    function has no business holding a credential even if it never prints it:\n    the only way to be sure a secret cannot be logged is for it not to be in\n    scope. This also clears CodeQL alert #1 (py/clear-text-logging-sensitive-data),\n    which flagged the whole-dict argument reaching a print.\n\n    The pack can contain any indexed file, `.env` included. stderr, not stdout:\n"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_SameOriginRedirect"}) SET n += {`id`: "sym:repo2graph/answer.py::_SameOriginRedirect", `name`: "_SameOriginRedirect", `qualname`: "_SameOriginRedirect", `kind`: "class", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 506, `end_line`: 546, `signature`: "class _SameOriginRedirect(urllib.request.HTTPRedirectHandler):", `docstring`: "Keep a provider redirect on its origin, and never let it downgrade.\n\n    The request carries the API key in a header -- `Authorization`,\n    `x-api-key` or `x-goog-api-key`, depending on the provider -- and CPython's\n    redirect handler forwards every header except `content-length` and\n    `content-type` to the new target, whatever host and whatever scheme it\n    names. A provider answering `302 http://somewhere-else` is therefore handed\n    the credential, in clear, by a client that had no say in it.\n\n    It would also make `_disclose` untrue. That function prints the provider\n    and hostna"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_SameOriginRedirect.redirect_request"}) SET n += {`id`: "sym:repo2graph/answer.py::_SameOriginRedirect.redirect_request", `name`: "redirect_request", `qualname`: "_SameOriginRedirect.redirect_request", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 529, `end_line`: 546, `signature`: "def redirect_request(\n        self,\n        req: urllib.request.Request,\n        fp: Any,\n        code: int,\n        msg: str,\n        headers: Any,\n        newurl: str,\n    ) -> urllib.request.Request | None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::stream_answer"}) SET n += {`id`: "sym:repo2graph/answer.py::stream_answer", `name`: "stream_answer", `qualname`: "stream_answer", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 554, `end_line`: 620, `signature`: "def stream_answer(\n    pack: dict[str, Any] | None,\n    model: str | None = None,\n    env: dict[str, str] | os._Environ[str] | Any | None = None,\n    out: Any = None,\n    provider: str | None = None,\n) -> str:", `docstring`: "Ask the configured provider and stream the answer out. Returns the text."};
