MERGE (n:R2G:`Symbol` {id: "sym:tests/test_resolution_heuristics.py::test_ambiguous_calls_stat_non_heuristic_fanout"}) SET n += {`id`: "sym:tests/test_resolution_heuristics.py::test_ambiguous_calls_stat_non_heuristic_fanout", `name`: "test_ambiguous_calls_stat_non_heuristic_fanout", `qualname`: "test_ambiguous_calls_stat_non_heuristic_fanout", `kind`: "function", `path`: "tests/test_resolution_heuristics.py", `lang`: "python", `start_line`: 143, `end_line`: 171, `signature`: "def test_ambiguous_calls_stat_non_heuristic_fanout(tmp_path):", `docstring`: "A bare name in 2+ files, no import/same-file/same-dir boost.\n\n    Count once per call site that emits ambiguous=True CALLS edges, and\n    persist the key through the normal stats.json / manifest dump.", `entrypoint`: true, `reach`: 427};
MERGE (n:R2G:`File` {id: "file:tests/test_resource_limits.py"}) SET n += {`id`: "file:tests/test_resource_limits.py", `name`: "test_resource_limits.py", `path`: "tests/test_resource_limits.py", `lang`: "python", `file_type`: "code", `size`: 8287, `lines`: 189, `parse_errors`: 0, `chunked`: false};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_resource_limits.py::repo"}) SET n += {`id`: "sym:tests/test_resource_limits.py::repo", `name`: "repo", `qualname`: "repo", `kind`: "function", `path`: "tests/test_resource_limits.py", `lang`: "python", `start_line`: 36, `end_line`: 48, `signature`: "def repo(tmp_path):", `docstring`: "Write the fixture with LF endings on every platform.\n\n    `Path.write_text` translates \"\\\\n\" to \"\\\\r\\\\n\" on Windows, which would make\n    each file two bytes longer per line than `len(body.encode())` says -- and\n    the byte-budget tests below derive their budgets from exactly that length.\n    Writing bytes keeps the budget arithmetic identical on Windows and POSIX.", `entrypoint`: true, `reach`: 13};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_resource_limits.py::built"}) SET n += {`id`: "sym:tests/test_resource_limits.py::built", `name`: "built", `qualname`: "built", `kind`: "function", `path`: "tests/test_resource_limits.py", `lang`: "python", `start_line`: 51, `end_line`: 55, `signature`: "def built(repo, out, **kw):", `docstring`: "Build and dump; return the parsed stats.json."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_resource_limits.py::test_an_unbounded_build_records_no_limits"}) SET n += {`id`: "sym:tests/test_resource_limits.py::test_an_unbounded_build_records_no_limits", `name`: "test_an_unbounded_build_records_no_limits", `qualname`: "test_an_unbounded_build_records_no_limits", `kind`: "function", `path`: "tests/test_resource_limits.py", `lang`: "python", `start_line`: 58, `end_line`: 67, `signature`: "def test_an_unbounded_build_records_no_limits(repo, tmp_path):", `docstring`: "The baseline every other test here is measured against.\n\n    Also pins that `limits_hit` is always present rather than conditionally\n    absent: a consumer checking it should not have to distinguish \"no limit\n    fired\" from \"this index predates the field\".", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_resource_limits.py::test_max_edges_caps_the_graph"}) SET n += {`id`: "sym:tests/test_resource_limits.py::test_max_edges_caps_the_graph", `name`: "test_max_edges_caps_the_graph", `qualname`: "test_max_edges_caps_the_graph", `kind`: "function", `path`: "tests/test_resource_limits.py", `lang`: "python", `start_line`: 70, `end_line`: 73, `signature`: "def test_max_edges_caps_the_graph(repo, tmp_path):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_resource_limits.py::test_max_edges_truncation_is_deterministic"}) SET n += {`id`: "sym:tests/test_resource_limits.py::test_max_edges_truncation_is_deterministic", `name`: "test_max_edges_truncation_is_deterministic", `qualname`: "test_max_edges_truncation_is_deterministic", `kind`: "function", `path`: "tests/test_resource_limits.py", `lang`: "python", `start_line`: 76, `end_line`: 89, `signature`: "def test_max_edges_truncation_is_deterministic(repo, tmp_path):", `docstring`: "Two builds of one tree under one ceiling keep the *same* edges.\n\n    This is the property that makes a bounded index usable at all. Discovery is\n    sorted, so edges are added in a fixed order and the prefix the ceiling keeps\n    is fixed too. If that ever stopped holding, two machines would hold\n    different subsets of the same graph and each would answer questions the\n    other could not -- the same failure `--max-files` had before discovery was\n    sorted.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_resource_limits.py::test_a_dropped_duplicate_is_not_counted_against_the_ceiling"}) SET n += {`id`: "sym:tests/test_resource_limits.py::test_a_dropped_duplicate_is_not_counted_against_the_ceiling", `name`: "test_a_dropped_duplicate_is_not_counted_against_the_ceiling", `qualname`: "test_a_dropped_duplicate_is_not_counted_against_the_ceiling", `kind`: "function", `path`: "tests/test_resource_limits.py", `lang`: "python", `start_line`: 92, `end_line`: 104, `signature`: "def test_a_dropped_duplicate_is_not_counted_against_the_ceiling(repo, tmp_path):", `docstring`: "`add_edge` dedupes before it checks the limit.\n\n    Counting a repeat as a drop would make `edges_dropped` report loss that did\n    not happen, and would let a graph with many duplicate edges trip a ceiling\n    it never actually reached.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_resource_limits.py::test_a_duplicate_of_a_dropped_edge_is_also_counted_once"}) SET n += {`id`: "sym:tests/test_resource_limits.py::test_a_duplicate_of_a_dropped_edge_is_also_counted_once", `name`: "test_a_duplicate_of_a_dropped_edge_is_also_counted_once", `qualname`: "test_a_duplicate_of_a_dropped_edge_is_also_counted_once", `kind`: "function", `path`: "tests/test_resource_limits.py", `lang`: "python", `start_line`: 107, `end_line`: 132, `signature`: "def test_a_duplicate_of_a_dropped_edge_is_also_counted_once(repo, tmp_path):", `docstring`: "`edges_dropped` counts distinct edges lost, not attempts.\n\n    The sibling test above covers a repeat of an edge that *was* added -- the\n    dedupe check sees it and returns before the ceiling. A repeat of an edge the\n    ceiling already rejected took the other path: `_edge_seen.add(key)` sat after\n    the ceiling's `return`, so the key was never recorded and every re-proposal\n    was counted again. `edges_dropped` is published in stats.json and read as the\n    number of edges the graph is missing, so counting attempts overstated the\n    loss for any edge discovered more than once -- which is ", `entrypoint`: true, `reach`: 365};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_resource_limits.py::test_max_bytes_stops_at_a_prefix_of_discovery_order"}) SET n += {`id`: "sym:tests/test_resource_limits.py::test_max_bytes_stops_at_a_prefix_of_discovery_order", `name`: "test_max_bytes_stops_at_a_prefix_of_discovery_order", `qualname`: "test_max_bytes_stops_at_a_prefix_of_discovery_order", `kind`: "function", `path`: "tests/test_resource_limits.py", `lang`: "python", `start_line`: 135, `end_line`: 151, `signature`: "def test_max_bytes_stops_at_a_prefix_of_discovery_order(repo, tmp_path):", `docstring`: "The budget keeps a prefix, never a best-fit selection.\n\n    Skipping an oversized file and continuing would make which small files are\n    indexed depend on the sizes of files *after* them, so adding one large file\n    in the middle of a repository could silently change the tail of the\n    selection. A prefix is the only reproducible answer.", `entrypoint`: true, `reach`: 437};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_resource_limits.py::test_a_budget_that_fits_everything_records_nothing"}) SET n += {`id`: "sym:tests/test_resource_limits.py::test_a_budget_that_fits_everything_records_nothing", `name`: "test_a_budget_that_fits_everything_records_nothing", `qualname`: "test_a_budget_that_fits_everything_records_nothing", `kind`: "function", `path`: "tests/test_resource_limits.py", `lang`: "python", `start_line`: 154, `end_line`: 159, `signature`: "def test_a_budget_that_fits_everything_records_nothing(repo, tmp_path):", `docstring`: "An inert limit must not report a truncation that did not occur.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_resource_limits.py::test_truncate_is_quiet_on_stderr_but_still_records"}) SET n += {`id`: "sym:tests/test_resource_limits.py::test_truncate_is_quiet_on_stderr_but_still_records", `name`: "test_truncate_is_quiet_on_stderr_but_still_records", `qualname`: "test_truncate_is_quiet_on_stderr_but_still_records", `kind`: "function", `path`: "tests/test_resource_limits.py", `lang`: "python", `start_line`: 162, `end_line`: 171, `signature`: "def test_truncate_is_quiet_on_stderr_but_still_records(repo, tmp_path, capsys):", `docstring`: "The whole point of the two policies.\n\n    `truncate` buys silence on stderr and nothing else. An index that was cut\n    and cannot say so is the failure this field exists to prevent, so the\n    record is not the policy's to suppress.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_resource_limits.py::test_warn_announces_the_ceiling_once"}) SET n += {`id`: "sym:tests/test_resource_limits.py::test_warn_announces_the_ceiling_once", `name`: "test_warn_announces_the_ceiling_once", `qualname`: "test_warn_announces_the_ceiling_once", `kind`: "function", `path`: "tests/test_resource_limits.py", `lang`: "python", `start_line`: 174, `end_line`: 182, `signature`: "def test_warn_announces_the_ceiling_once(repo, tmp_path, capsys):", `docstring`: "Once per limit, not once per dropped edge.\n\n    A ceiling reached early drops thousands of edges; a line each would bury\n    the build's real output and make the warning useless.", `entrypoint`: true};
