MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/fetch.py::_rmtree"}) SET n += {`id`: "sym:repo2graph/fetch.py::_rmtree", `name`: "_rmtree", `qualname`: "_rmtree", `kind`: "function", `path`: "repo2graph/fetch.py", `lang`: "python", `start_line`: 36, `end_line`: 58, `signature`: "def _rmtree(path: Path) -> None:", `docstring`: "Best-effort recursive delete of a temp clone.\n\n    Git marks pack files under .git/objects read-only; on Windows os.unlink then\n    raises PermissionError and shutil.rmtree(ignore_errors=True) would leave the\n    whole clone (often hundreds of MB) behind. Clear the bit and retry."};
