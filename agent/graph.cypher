MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_annotations_are_honest_about_auto_build"}) SET n += {`id`: "sym:tests/test_mcp.py::test_annotations_are_honest_about_auto_build", `name`: "test_annotations_are_honest_about_auto_build", `qualname`: "test_annotations_are_honest_about_auto_build", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 497, `end_line`: 529, `signature`: "def test_annotations_are_honest_about_auto_build():", `docstring`: "#292: a client inspecting annotations must not be told a tool is\n    read-only when its first call, on a server that can auto-build, may\n    parse the whole repository, run git, and write `.r2g/**` to disk.\n\n    `get_tools(auto_build=False)` -- an already-indexed server, or one\n    started with `--no-auto-build` -- keeps every tool read-only: that\n    annotation is true in that mode. `get_tools(auto_build=True)` -- stdio\n    with a repo to build from and auto-build not disabled -- must mark every\n    build-capable tool `readOnlyHint=False`, except `repo_build_status`,\n    which `run_tool` spec", `entrypoint`: true};
