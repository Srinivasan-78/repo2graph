MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::classify_query"}) SET n += {`id`: "sym:repo2graph/query.py::classify_query", `name`: "classify_query", `qualname`: "classify_query", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 300, `end_line`: 326, `signature`: "def classify_query(query: str) -> str:", `docstring`: "What shape of answer the question asks for.\n\n    Returns one of `\"callers\"`, `\"callees\"`, `\"trace\"` or `\"concept\"`.\n    `\"concept\"` is the default and the one that changes nothing: a question that\n    named no direction must keep following both, because narrowing it on a guess\n    would lose answers that the old behaviour found.\n\n    Callee phrasings are tested first. \"What are the callees of X\" contains\n    \"call\", so a caller pattern would otherwise claim it."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::asks_about_tests"}) SET n += {`id`: "sym:repo2graph/query.py::asks_about_tests", `name`: "asks_about_tests", `qualname`: "asks_about_tests", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 329, `end_line`: 343, `signature`: "def asks_about_tests(query: str) -> bool:", `docstring`: "Whether the question is asking *about* the tests.\n\n    Deliberately independent of `classify_query`, because the two answers are:\n    \"which tests use the parser\" is a caller question *and* a question about\n    tests, and it needs the caller direction filter and the test seeds left\n    alone. Reading it off the single shape gave it neither -- the caller pattern\n    `(what|who|which)\\\\s+(\\\\w+\\\\s+){0,3}?uses?` claims \"which tests use X\"\n    before `_TEST_PATTERNS` is reached, so `classify_query` answered \"callers\"\n    and the demotion below fired on exactly the chunks the question asked for.\n   "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::edge_dirs_for"}) SET n += {`id`: "sym:repo2graph/query.py::edge_dirs_for", `name`: "edge_dirs_for", `qualname`: "edge_dirs_for", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 379, `end_line`: 387, `signature`: "def edge_dirs_for(shape: str) -> dict[str, tuple[str, ...]] | None:", `docstring`: "The traversal filter a question shape implies, or None to keep the default."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::read_jsonl"}) SET n += {`id`: "sym:repo2graph/query.py::read_jsonl", `name`: "read_jsonl", `qualname`: "read_jsonl", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 413, `end_line`: 444, `signature`: "def read_jsonl(path: Path) -> list[Record]:", `docstring`: "Load and parse JSONL records from a file with per-line byte ceilings.\n\n    Args:\n        path: Path to the JSONL file.\n\n    Returns:\n        List of parsed JSON record dictionaries.\n\n    Raises:\n        ValueError: If path is a symlink, or if any line exceeds MAX_JSONL_LINE_BYTES,\n            or contains invalid JSON."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::_single_char_idents"}) SET n += {`id`: "sym:repo2graph/query.py::_single_char_idents", `name`: "_single_char_idents", `qualname`: "_single_char_idents", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 453, `end_line`: 464, `signature`: "def _single_char_idents(query: str) -> list[str]:", `docstring`: "The one-character identifiers a query names, skipping `a`/`I` used as words.\n\n    `T`, `f` and `x` always count; `a` counts when it reads as code -- last in\n    the query, before `(` or `.`, or in backticks -- but not in \"reach a view\"."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::count_tokens"}) SET n += {`id`: "sym:repo2graph/query.py::count_tokens", `name`: "count_tokens", `qualname`: "count_tokens", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 467, `end_line`: 470, `signature`: "def count_tokens(text: str) -> int:", `docstring`: "The default token estimate: len(text) // CHARS_PER_TOKEN, never 0 for a\n    non-empty string (a block that costs nothing would defeat any budget)."};
