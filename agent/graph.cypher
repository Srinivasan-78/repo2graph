MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_a_cheap_container_is_not_penalised"}) SET n += {`id`: "sym:tests/test_answerability.py::test_a_cheap_container_is_not_penalised", `name`: "test_a_cheap_container_is_not_penalised", `qualname`: "test_a_cheap_container_is_not_penalised", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 81, `end_line`: 99, `signature`: "def test_a_cheap_container_is_not_penalised(tmp_path):", `docstring`: "The penalty is about crowding bodies out of the budget, which a small\n    container does not do.\n\n    Penalising by kind alone dropped the demo fixture's 91-token `app/store.py`\n    residual -- the chunk that answered \"trace a request to persistence\" -- for\n    no budget saved. `test_demo.py` caught it; the benchmark did not.", `entrypoint`: true, `reach`: 127};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_a_matching_name_is_boosted"}) SET n += {`id`: "sym:tests/test_answerability.py::test_a_matching_name_is_boosted", `name`: "test_a_matching_name_is_boosted", `qualname`: "test_a_matching_name_is_boosted", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 102, `end_line`: 108, `signature`: "def test_a_matching_name_is_boosted(index):", `docstring`: "Two shared terms is the cap, so this is the full `NAME_TERM_BOOST`.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_one_shared_term_earns_half_the_boost"}) SET n += {`id`: "sym:tests/test_answerability.py::test_one_shared_term_earns_half_the_boost", `name`: "test_one_shared_term_earns_half_the_boost", `qualname`: "test_one_shared_term_earns_half_the_boost", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 111, `end_line`: 122, `signature`: "def test_one_shared_term_earns_half_the_boost(index):", `docstring`: "The boost scales with overlap rather than firing on any single match.\n\n    \"refunded\" shares only \"order\" with `refund_order`: the tokenizer splits\n    subtokens but does not stem, so this is the common case for a question\n    phrased in natural English.", `entrypoint`: true};
