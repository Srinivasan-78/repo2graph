MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::_sanitize_header_value"}) SET n += {`id`: "sym:repo2graph/http_server.py::_sanitize_header_value", `name`: "_sanitize_header_value", `qualname`: "_sanitize_header_value", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 85, `end_line`: 89, `signature`: "def _sanitize_header_value(value: str) -> str:", `docstring`: "Strip CR/LF/NUL from a value about to be placed in a response header."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::_hostname_from_host_header"}) SET n += {`id`: "sym:repo2graph/http_server.py::_hostname_from_host_header", `name`: "_hostname_from_host_header", `qualname`: "_hostname_from_host_header", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 92, `end_line`: 111, `signature`: "def _hostname_from_host_header(value: str | None) -> str | None:", `docstring`: "The bare hostname of a `Host` header, with `:port` and `[...]` stripped.\n\n    Returns None for anything empty or unparseable -- fail closed rather than\n    guess."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::_hostname_from_origin"}) SET n += {`id`: "sym:repo2graph/http_server.py::_hostname_from_origin", `name`: "_hostname_from_origin", `qualname`: "_hostname_from_origin", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 114, `end_line`: 129, `signature`: "def _hostname_from_origin(value: str | None) -> str | None:", `docstring`: "The hostname of an `Origin` header, or None if absent/unparseable.\n\n    `null` (sandboxed iframes, `file://` pages) is treated as unparseable: it\n    never matches an allowlist of real hostnames, so it is rejected."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::_host_header_allowed"}) SET n += {`id`: "sym:repo2graph/http_server.py::_host_header_allowed", `name`: "_host_header_allowed", `qualname`: "_host_header_allowed", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 132, `end_line`: 138, `signature`: "def _host_header_allowed(value: str | None, allowed_hostnames: frozenset[str]) -> bool:", `docstring`: "Whether a `Host` header names one of the accepted hostnames.\n\n    Fails closed: a missing or unparseable header is not allowed."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::_origin_header_allowed"}) SET n += {`id`: "sym:repo2graph/http_server.py::_origin_header_allowed", `name`: "_origin_header_allowed", `qualname`: "_origin_header_allowed", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 141, `end_line`: 152, `signature`: "def _origin_header_allowed(value: str | None, allowed_hostnames: frozenset[str]) -> bool:", `docstring`: "Whether an `Origin` header, if present, names an accepted hostname.\n\n    No `Origin` header at all is allowed -- that is the common case for\n    non-browser clients (curl, an MCP client library) and carries none of the\n    cross-origin-browser risk this check exists for. A present-but-unparseable\n    or cross-origin value is refused."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::_content_type_ok"}) SET n += {`id`: "sym:repo2graph/http_server.py::_content_type_ok", `name`: "_content_type_ok", `qualname`: "_content_type_ok", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 155, `end_line`: 175, `signature`: "def _content_type_ok(value: str | None) -> bool:", `docstring`: "Whether a `Content-Type` header names JSON-RPC's media type (#293).\n\n    Accepts `application/json` case-insensitively, with or without\n    parameters (`; charset=utf-8` is the common one a client adds) -- only\n    the media type before the first `;` is compared, per RFC 9110 \u00a78.3.\n\n    A **missing** header is refused, not accepted. `urllib.request.Request(\n    data=<bytes>)` silently defaults to `application/x-www-form-urlencoded`\n    when the caller sets no header at all, which is exactly the shape a\n    misconfigured client produces; treating \"no header\" as \"assume JSON\"\n    would accept th"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::_json_nesting_exceeds"}) SET n += {`id`: "sym:repo2graph/http_server.py::_json_nesting_exceeds", `name`: "_json_nesting_exceeds", `qualname`: "_json_nesting_exceeds", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 178, `end_line`: 209, `signature`: "def _json_nesting_exceeds(text: str, limit: int) -> bool:", `docstring`: "Whether `text` contains `{`/`[` nested deeper than `limit`, string-aware.\n\n    A single linear pass, bracket characters inside JSON string literals are\n    skipped (tracking `\\\\\"` escapes) so a message body like `{\"note\": \"[[[[\"}`\n    is not mistaken for nesting. Runs before `json.loads` so a hostile\n    `\"[\" * 20000` is refused in a few hundred character reads rather than\n    parsed and then measured -- and short-circuits the moment the limit is\n    crossed, so the cost of the attack case is bounded by `limit`, not by the\n    body length."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::_dedup_object_pairs"}) SET n += {`id`: "sym:repo2graph/http_server.py::_dedup_object_pairs", `name`: "_dedup_object_pairs", `qualname`: "_dedup_object_pairs", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 212, `end_line`: 229, `signature`: "def _dedup_object_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:", `docstring`: "`object_pairs_hook` that refuses a JSON object with a repeated key.\n\n    Plain `json.loads` silently keeps the last value for a duplicate key,\n    which is exactly the ambiguity RFC 8259 \u00a74 calls out and leaves to the\n    implementation: two parsers disagreeing about which `\"id\"` or `\"method\"`\n    won is a request-smuggling shape, not merely untidy input (#293). Raising\n    here lands in the same `except (ValueError, RecursionError)` PARSE_ERROR\n    path every other structurally-invalid body already takes.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::_reject_json_constant"}) SET n += {`id`: "sym:repo2graph/http_server.py::_reject_json_constant", `name`: "_reject_json_constant", `qualname`: "_reject_json_constant", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 232, `end_line`: 241, `signature`: "def _reject_json_constant(name: str) -> Any:", `docstring`: "`parse_constant` hook refusing `NaN`/`Infinity`/`-Infinity` (#293).\n\n    `json.loads` accepts these three bare tokens by default -- a CPython\n    extension to the JSON grammar, not standard JSON -- and a non-finite\n    JSON-RPC `id` would round-trip into this server's own `json.dumps` calls\n    as the same non-standard token, which a stricter downstream parser (or a\n    SIEM ingesting the audit log) is not obliged to accept.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::_parse_rpc_body"}) SET n += {`id`: "sym:repo2graph/http_server.py::_parse_rpc_body", `name`: "_parse_rpc_body", `qualname`: "_parse_rpc_body", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 244, `end_line`: 267, `signature`: "def _parse_rpc_body(text: str) -> Any:", `docstring`: "Parse one JSON-RPC frame with every #293 structural guard applied.\n\n    Args:\n        text: The decoded request body; empty string means no body was sent.\n\n    Returns:\n        The parsed value, or None for an empty body.\n\n    Raises:\n        ValueError: Invalid JSON, a duplicate object key, a non-finite\n            numeric constant, or nesting past `MAX_JSON_DEPTH`.\n        RecursionError: A vanishingly small residual risk -- the depth scan\n            above already refuses anything past `MAX_JSON_DEPTH`, which is\n            far below CPython's default recursion ceiling -- kept here as a\n   "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::_validate_envelope"}) SET n += {`id`: "sym:repo2graph/http_server.py::_validate_envelope", `name`: "_validate_envelope", `qualname`: "_validate_envelope", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 275, `end_line`: 310, `signature`: "def _validate_envelope(request: dict[str, Any]) -> tuple[int, int, str] | None:", `docstring`: "Structural JSON-RPC 2.0 checks beyond \"is this a dict\" (#293).\n\n    Runs after the body has parsed as a JSON object and before any field is\n    trusted for dispatch, authentication or logging.\n\n    Args:\n        request: The parsed JSON-RPC request object.\n\n    Returns:\n        `(http_status, jsonrpc_code, message)` for the first violation found,\n        or None when the envelope is well-formed. Checked in a fixed order so\n        the same malformed request always reports the same reason."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::RateLimitConfig"}) SET n += {`id`: "sym:repo2graph/http_server.py::RateLimitConfig", `name`: "RateLimitConfig", `qualname`: "RateLimitConfig", `kind`: "class", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 314, `end_line`: 350, `signature`: "class RateLimitConfig:", `docstring`: "Configurable ceilings for #264 -- per-client rate, concurrency, size.\n\n    Attributes:\n        requests_per_window: Requests one client identity may make in\n            `window_seconds` before being throttled.\n        window_seconds: The sliding window's width, in seconds.\n        max_concurrent_requests: Server-wide in-flight `tools/call`/\n            `tools/list`/`initialize` requests admitted at once.\n        max_queue_size: Requests allowed to wait for a concurrency slot once\n            `max_concurrent_requests` is saturated; beyond this, a request is\n            refused immediately rathe"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::RateLimiter"}) SET n += {`id`: "sym:repo2graph/http_server.py::RateLimiter", `name`: "RateLimiter", `qualname`: "RateLimiter", `kind`: "class", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 353, `end_line`: 446, `signature`: "class RateLimiter:", `docstring`: "Per-client rate limiting plus server-wide concurrency quotas (#264).\n\n    One instance is shared across every request the transport serves --\n    `MCPRequestHandler` is instantiated per request by `BaseHTTPRequestHandler`,\n    so the limiter has to live on the class, not the instance, to see traffic\n    across connections at all.\n\n    Args:\n        config: The configured ceilings.\n        clock: Monotonic time source, injected so a test can move the sliding\n            window without sleeping -- the same reasoning `JWKSCache` and\n            `ResultCache` use their own injected clocks for."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::RateLimiter.__init__"}) SET n += {`id`: "sym:repo2graph/http_server.py::RateLimiter.__init__", `name`: "__init__", `qualname`: "RateLimiter.__init__", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 368, `end_line`: 378, `signature`: "def __init__(\n        self, config: RateLimitConfig, clock: Callable[[], float] = time.monotonic\n    ) -> None:", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::RateLimiter.check_rate"}) SET n += {`id`: "sym:repo2graph/http_server.py::RateLimiter.check_rate", `name`: "check_rate", `qualname`: "RateLimiter.check_rate", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 380, `end_line`: 415, `signature`: "def check_rate(self, client_id: str) -> bool:", `docstring`: "Record one request from `client_id`; False if it must be throttled."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::RateLimiter.acquire_slot"}) SET n += {`id`: "sym:repo2graph/http_server.py::RateLimiter.acquire_slot", `name`: "acquire_slot", `qualname`: "RateLimiter.acquire_slot", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 417, `end_line`: 436, `signature`: "def acquire_slot(self) -> bool:", `docstring`: "Reserve a concurrency slot, honouring the queue-size cap.\n\n        Returns:\n            True if a slot was reserved -- the caller must call\n            `release_slot()` exactly once when done. False if the server is\n            at capacity and the queue itself is full: refused immediately,\n            never silently dropped into an unbounded wait."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::RateLimiter.release_slot"}) SET n += {`id`: "sym:repo2graph/http_server.py::RateLimiter.release_slot", `name`: "release_slot", `qualname`: "RateLimiter.release_slot", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 438, `end_line`: 439, `signature`: "def release_slot(self) -> None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::RateLimiter.acquire_build_slot"}) SET n += {`id`: "sym:repo2graph/http_server.py::RateLimiter.acquire_build_slot", `name`: "acquire_build_slot", `qualname`: "RateLimiter.acquire_build_slot", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 441, `end_line`: 443, `signature`: "def acquire_build_slot(self) -> bool:", `docstring`: "Non-blocking: True if a build/open slot was reserved."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::RateLimiter.release_build_slot"}) SET n += {`id`: "sym:repo2graph/http_server.py::RateLimiter.release_build_slot", `name`: "release_build_slot", `qualname`: "RateLimiter.release_build_slot", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 445, `end_line`: 446, `signature`: "def release_build_slot(self) -> None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::_first_forwarded_ip"}) SET n += {`id`: "sym:repo2graph/http_server.py::_first_forwarded_ip", `name`: "_first_forwarded_ip", `qualname`: "_first_forwarded_ip", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 449, `end_line`: 467, `signature`: "def _first_forwarded_ip(value: str | None) -> str | None:", `docstring`: "The left-most address in an `X-Forwarded-For` header, if it parses.\n\n    Only called when the immediate peer is in the operator's `trusted_proxies`\n    allowlist (#267) -- this function itself does no trust decision, it only\n    refuses to hand back a value that is not a syntactically real address, so\n    a malformed or absent header degrades to \"use the socket peer\" rather\n    than to a fabricated identity."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::_public_repo_label"}) SET n += {`id`: "sym:repo2graph/http_server.py::_public_repo_label", `name`: "_public_repo_label", `qualname`: "_public_repo_label", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 544, `end_line`: 554, `signature`: "def _public_repo_label(repo: Any) -> str | None:", `docstring`: "Basename of `repo` for the unauthenticated discovery document.\n\n    `GET /.well-known/mcp-server-metadata` skips auth, so an absolute host\n    path must never appear. Both `/` and `\\\\` count as separators so a\n    Windows-style path cannot leak on a POSIX host either."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::server_metadata"}) SET n += {`id`: "sym:repo2graph/http_server.py::server_metadata", `name`: "server_metadata", `qualname`: "server_metadata", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 557, `end_line`: 602, `signature`: "def server_metadata(\n    repo: Any,\n    index_present: bool,\n    auth_modes: Any,\n    index_built_at: str | None = None,\n    tools: Any = None,\n) -> dict[str, Any]:", `docstring`: "The `.well-known/mcp-server-metadata` document.\n\n    Lets a registry or client learn what this server does without opening a\n    session. Deliberately says nothing about repository *content* -- only that\n    an index exists and when it was built -- because this endpoint is\n    unauthenticated by necessity. `repo` is the basename only; the absolute\n    path would locate the project on the host.\n\n    Args:\n        repo: Repository path the server was pointed at, or None. Only the\n            basename is published.\n        index_present: Whether a readable index exists right now.\n        auth_mod"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::index_built_at"}) SET n += {`id`: "sym:repo2graph/http_server.py::index_built_at", `name`: "index_built_at", `qualname`: "index_built_at", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 605, `end_line`: 621, `signature`: "def index_built_at(out: Any) -> str | None:", `docstring`: "When the index at `out` was last written, as ISO-8601, or None.\n\n    Args:\n        out: The index directory.\n\n    Returns:\n        The manifest's mtime in ISO-8601 UTC, or None when absent or unreadable."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::MCPRequestHandler"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler", `name`: "MCPRequestHandler", `qualname`: "MCPRequestHandler", `kind`: "class", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 624, `end_line`: 1280, `signature`: "class MCPRequestHandler(BaseHTTPRequestHandler):", `docstring`: "One HTTP request. Configuration arrives via class attributes.\n\n    `BaseHTTPRequestHandler` instantiates the class per request, so there is no\n    constructor to pass configuration through; `make_handler` builds a subclass\n    carrying it instead."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::MCPRequestHandler.log_message"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler.log_message", `name`: "log_message", `qualname`: "MCPRequestHandler.log_message", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 672, `end_line`: 679, `signature`: "def log_message(self, fmt: str, *args: Any) -> None:", `docstring`: "Silence the default stderr access log.\n\n        BaseHTTPRequestHandler writes an apache-style line per request. The\n        audit log is the structured record of the same events, and two\n        overlapping logs on one stream is worse than either alone.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::MCPRequestHandler._send_json"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler._send_json", `name`: "_send_json", `qualname`: "MCPRequestHandler._send_json", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 681, `end_line`: 735, `signature`: "def _send_json(\n        self,\n        status: int,\n        payload: dict[str, Any],\n        extra_headers: dict[str, str] | None = None,\n        send_body: bool = True,\n        enforce_response_limit: bool = False,\n    ) -> None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::MCPRequestHandler._read_body"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler._read_body", `name`: "_read_body", `qualname`: "MCPRequestHandler._read_body", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 737, `end_line`: 776, `signature`: "def _read_body(self) -> bytes:", `docstring`: "Read the request body, refusing anything this server will not read.\n\n        Raises:\n            AuthError: Carrying the status to refuse with -- 411 for a framing\n                this server does not speak, 400 for an unparseable\n                Content-Length, 413 for an oversized one, 408 for a body that\n                never fully arrived."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::MCPRequestHandler._drain_body"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler._drain_body", `name`: "_drain_body", `qualname`: "MCPRequestHandler._drain_body", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 778, `end_line`: 804, `signature`: "def _drain_body(self) -> None:", `docstring`: "Discard the request body before refusing without having read it.\n\n        Closing a socket that still holds unread bytes makes the OS send an RST\n        rather than a FIN. On Windows the client then loses the response it was\n        about to read and raises `ConnectionAbortedError` (WinError 10053)\n        instead -- so a refusal that goes to the trouble of naming its reason\n        (\"Origin not allowed\") arrives as an opaque connection error. The Host\n        and Origin checks run before `_read_body` by design, which is what left\n        them in that position.\n\n        Best-effort and silent"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::MCPRequestHandler._origin_ok"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler._origin_ok", `name`: "_origin_ok", `qualname`: "MCPRequestHandler._origin_ok", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 806, `end_line`: 817, `signature`: "def _origin_ok(self, drain: bool = True) -> bool:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::MCPRequestHandler.do_HEAD"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler.do_HEAD", `name`: "do_HEAD", `qualname`: "MCPRequestHandler.do_HEAD", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 821, `end_line`: 823, `signature`: "def do_HEAD(self) -> None:", `docstring`: "Serve headers for GET paths without sending response body.", `entrypoint`: true};
