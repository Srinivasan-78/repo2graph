MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index._load_text"}) SET n += {id: "sym:repo2graph/query.py::Index._load_text", name: "_load_text", qualname: "Index._load_text", kind: "function", path: "repo2graph/query.py", lang: "python", start_line: 169, end_line: 182, signature: "def _load_text(self, name: str) -> str:", docstring: "Read an optional artifact, trying every section it is written to.\n\n        newline=\"\\n\" for the same reason read_jsonl uses it: universal-newline\n        mode rewrites U+2028/U+2029/U+0085 line ends and would desync the text\n        from what was written."};
