MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_iss197_a_withheld_request_body_is_answered_rather_than_waited_on"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss197_a_withheld_request_body_is_answered_rather_than_waited_on", `name`: "test_iss197_a_withheld_request_body_is_answered_rather_than_waited_on", `qualname`: "test_iss197_a_withheld_request_body_is_answered_rather_than_waited_on", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 933, `end_line`: 960, `signature`: "def test_iss197_a_withheld_request_body_is_answered_rather_than_waited_on(make_server, monkeypatch):", `docstring`: "Issue 197: headers promising a megabyte, then silence.\n\n    Without a handler `timeout`, socketserver never arms settimeout() and\n    `rfile.read(Content-Length)` blocks for as long as the client cares to hold\n    the socket -- one pinned thread per connection, on a server that caps\n    neither. The shipped 30s is far too long to sit through here, so the test\n    pins the attribute's existence separately and then shrinks it to prove the\n    second half: that the read failing becomes a 408 rather than a handler\n    thread dying with the client still waiting.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_iss197_a_body_shorter_than_content_length_is_408_not_a_hang"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss197_a_body_shorter_than_content_length_is_408_not_a_hang", `name`: "test_iss197_a_body_shorter_than_content_length_is_408_not_a_hang", `qualname`: "test_iss197_a_body_shorter_than_content_length_is_408_not_a_hang", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 963, `end_line`: 986, `signature`: "def test_iss197_a_body_shorter_than_content_length_is_408_not_a_hang(make_server, monkeypatch):", `docstring`: "The polite version of the same thing: the client closes early.\n\n    `rfile.read(length)` returns short at EOF rather than raising, so this path\n    never reaches the timeout at all -- it has to be noticed by comparing what\n    arrived against what was promised.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::AbortingWriter"}) SET n += {`id`: "sym:tests/test_http_transport.py::AbortingWriter", `name`: "AbortingWriter", `qualname`: "AbortingWriter", `kind`: "class", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 989, `end_line`: 1019, `signature`: "class AbortingWriter:", `docstring`: "A `wfile` that raises ConnectionAbortedError from the nth write on.\n\n    The real shape is a client that hangs up mid-response, which Windows\n    reports as ConnectionAbortedError -- the sibling of BrokenPipeError and\n    ConnectionResetError that the old guard did not name. Forcing it beats\n    racing a real socket close, which lands on a different write every run.\n\n    Write 1 is the header flush from `end_headers()`; write 2 is the body."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::AbortingWriter.__init__"}) SET n += {`id`: "sym:tests/test_http_transport.py::AbortingWriter.__init__", `name`: "__init__", `qualname`: "AbortingWriter.__init__", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1000, `end_line`: 1003, `signature`: "def __init__(self, inner, fail_from):", `docstring`: "", `entrypoint`: true};
