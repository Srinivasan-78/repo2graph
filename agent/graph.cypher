MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_discovery_document_without_an_issuer_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_discovery_document_without_an_issuer_is_refused", `name`: "test_a_discovery_document_without_an_issuer_is_refused", `qualname`: "test_a_discovery_document_without_an_issuer_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 828, `end_line`: 841, `signature`: "def test_a_discovery_document_without_an_issuer_is_refused():", `docstring`: "RFC 8414 \u00a73.2 makes `issuer` REQUIRED.\n\n    Absence used to skip the mismatch check entirely, so a document opted out\n    of being compared by leaving the field off.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_redirect_off_https_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_redirect_off_https_is_refused", `name`: "test_a_redirect_off_https_is_refused", `qualname`: "test_a_redirect_off_https_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 844, `end_line`: 866, `signature`: "def test_a_redirect_off_https_is_refused():", `docstring`: "urlopen follows redirects; CPython's handler allows http, https and ftp.\n\n    Without this the scheme check in `_fetch_json` covers the first hop only,\n    and a 302 to http:// puts the signing keys on the wire in clear -- where\n    an on-path attacker substitutes their own modulus and mints tokens that\n    pass every remaining check in the module.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_fetch_json_goes_through_the_guarded_opener"}) SET n += {`id`: "sym:tests/test_auth.py::test_fetch_json_goes_through_the_guarded_opener", `name`: "test_fetch_json_goes_through_the_guarded_opener", `qualname`: "test_fetch_json_goes_through_the_guarded_opener", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 869, `end_line`: 886, `signature`: "def test_fetch_json_goes_through_the_guarded_opener(monkeypatch):", `docstring`: "The handler only helps if `_fetch_json` stops using the default opener.\n\n    A bare `urlopen` would silently keep the permissive redirect handler, so\n    pin the call site rather than only the handler's own logic.", `entrypoint`: true};
