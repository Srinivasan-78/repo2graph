MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/tasks.py::_default_estimator"}) SET n += {`id`: "sym:repo2graph/tasks.py::_default_estimator", `name`: "_default_estimator", `qualname`: "_default_estimator", `kind`: "function", `path`: "repo2graph/tasks.py", `lang`: "python", `start_line`: 229, `end_line`: 247, `signature`: "def _default_estimator(repo: Any) -> float:", `docstring`: "Guess a build's duration from how many files discovery finds.\n\n    Discovery is cheap next to parsing -- it is a `git ls-files` or one walk --\n    so paying for it up front to produce an honest eta is worth it.\n\n    Args:\n        repo: Repository directory.\n\n    Returns:\n        Estimated seconds, never less than one.", `entrypoint`: true};
