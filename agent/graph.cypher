MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::_warn_locking_unavailable"}) SET n += {`id`: "sym:repo2graph/audit.py::_warn_locking_unavailable", `name`: "_warn_locking_unavailable", `qualname`: "_warn_locking_unavailable", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 82, `end_line`: 104, `signature`: "def _warn_locking_unavailable(path: str, exc: BaseException | None) -> None:", `docstring`: "Say once that records are being appended without an advisory lock.\n\n    Records are still written -- that is the point -- but they are no longer\n    serialised against other processes sharing the file, and an operator\n    reading a shredded line later deserves to know why rather than to guess.\n\n    Args:\n        path: The audit sink the lock could not be taken on.\n        exc: What the locking call raised, when it raised at all."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::_LockedAppender"}) SET n += {`id`: "sym:repo2graph/audit.py::_LockedAppender", `name`: "_LockedAppender", `qualname`: "_LockedAppender", `kind`: "class", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 107, `end_line`: 259, `signature`: "class _LockedAppender:", `docstring`: "Append-only writer that survives several processes sharing one file.\n\n    Locking is advisory and per-write: the lock is taken, one whole line is\n    written and flushed, and the lock is released. Two servers configured with\n    the same `--audit-log` therefore interleave whole records rather than\n    shredding each other's lines.\n\n    A sink that cannot be opened at all leaves `_fh` None and every method a\n    no-op. The constructor holds the same line `write` does: an audit file the\n    operator mistyped is a degraded log, not a server that refuses to start,\n    and the stderr copy of every "};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::_LockedAppender.__init__"}) SET n += {`id`: "sym:repo2graph/audit.py::_LockedAppender.__init__", `name`: "__init__", `qualname`: "_LockedAppender.__init__", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 126, `end_line`: 150, `signature`: "def __init__(self, path: Any, fsync: bool = False) -> None:", `docstring`: "", `entrypoint`: true, `reach`: 27};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::_LockedAppender.write"}) SET n += {`id`: "sym:repo2graph/audit.py::_LockedAppender.write", `name`: "write", `qualname`: "_LockedAppender.write", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 152, `end_line`: 183, `signature`: "def write(self, line: str) -> None:", `docstring`: "Append one line, holding an OS-level lock for the write."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::_LockedAppender._acquire"}) SET n += {`id`: "sym:repo2graph/audit.py::_LockedAppender._acquire", `name`: "_acquire", `qualname`: "_LockedAppender._acquire", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 185, `end_line`: 225, `signature`: "def _acquire(self, fh: TextIO) -> None:\n        # sys.platform branches, not a bare try/except ImportError: mypy checks\n        # each platform's CI job against that job's own sys.platform, so it\n        # statically knows the other branch is unreachable there and needs no\n        # ignore comment o", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::_LockedAppender._release"}) SET n += {`id`: "sym:repo2graph/audit.py::_LockedAppender._release", `name`: "_release", `qualname`: "_LockedAppender._release", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 227, `end_line`: 250, `signature`: "def _release(self, fh: TextIO) -> None:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::_LockedAppender.close"}) SET n += {`id`: "sym:repo2graph/audit.py::_LockedAppender.close", `name`: "close", `qualname`: "_LockedAppender.close", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 252, `end_line`: 259, `signature`: "def close(self) -> None:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::AuditConfig"}) SET n += {`id`: "sym:repo2graph/audit.py::AuditConfig", `name`: "AuditConfig", `qualname`: "AuditConfig", `kind`: "class", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 263, `end_line`: 278, `signature`: "class AuditConfig:", `docstring`: "Where audit records go and which ones are kept.\n\n    Attributes:\n        level: \"none\", \"errors\" (rejections and failures only) or \"all\".\n        path: Optional file to append to in addition to stderr.\n        fsync: Sync the file sink to stable storage after every record. Off by\n            default: flushing already makes the line whole for anything else\n            reading the file, and the same record is on stderr regardless, so\n            the cost of a disk sync per tool call buys only crash durability\n            for the file copy. Deployments that need exactly that turn it on."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::AuditLogger"}) SET n += {`id`: "sym:repo2graph/audit.py::AuditLogger", `name`: "AuditLogger", `qualname`: "AuditLogger", `kind`: "class", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 281, `end_line`: 391, `signature`: "class AuditLogger:", `docstring`: "Emits one structured record per tool call.\n\n    Args:\n        config: Level and optional file sink.\n        stream: Where the stderr copy goes; resolved at call time when None."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::AuditLogger.__init__"}) SET n += {`id`: "sym:repo2graph/audit.py::AuditLogger.__init__", `name`: "__init__", `qualname`: "AuditLogger.__init__", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 289, `end_line`: 298, `signature`: "def __init__(self, config: AuditConfig | None = None, stream: TextIO | None = None) -> None:", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::AuditLogger.enabled"}) SET n += {`id`: "sym:repo2graph/audit.py::AuditLogger.enabled", `name`: "enabled", `qualname`: "AuditLogger.enabled", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 301, `end_line`: 303, `signature`: "def enabled(self) -> bool:", `docstring`: "False when the level is \"none\", in which case nothing is emitted.", `entrypoint`: true};
