MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/embed.py::text_hash"}) SET n += {`id`: "sym:repo2graph/embed.py::text_hash", `name`: "text_hash", `qualname`: "text_hash", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 136, `end_line`: 140, `signature`: "def text_hash(chunk: str | dict[str, Any]) -> str:", `docstring`: "sha256 of a chunk's text. A chunk's vector depends on nothing else, so\n    this is a sound reuse key even when the surrounding graph changed."};
