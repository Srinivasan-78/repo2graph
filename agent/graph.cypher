MERGE (n:R2G:Symbol {id: "sym:repo2graph/parse.py::_base_clauses"}) SET n += {id: "sym:repo2graph/parse.py::_base_clauses", name: "_base_clauses", qualname: "_base_clauses", kind: "function", path: "repo2graph/parse.py", lang: "python", start_line: 424, end_line: 437, signature: "def _base_clauses(node):", docstring: "Supertype clauses of a definition, preferring the innermost one.\n\n    TypeScript wraps extends_clause/implements_clause in a class_heritage and\n    Java wraps a type_list in super_interfaces; the outer node's text would join\n    several names into one string, so descend when a child is a clause too."};
