MERGE (n:R2G:Symbol {id: "sym:repo2graph/doctor.py::_is_repo2graph_manifest"}) SET n += {`id`: "sym:repo2graph/doctor.py::_is_repo2graph_manifest", `name`: "_is_repo2graph_manifest", `qualname`: "_is_repo2graph_manifest", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 347, `end_line`: 364, `signature`: "def _is_repo2graph_manifest(manifest_file: Path) -> bool:", `docstring`: "True only if `manifest_file` parses as a repo2graph manifest.json.\n\n    A bare `agent/` directory or a `chunks.jsonl` are not proof of a\n    repo2graph index -- both names collide with unrelated projects (agent\n    frameworks, ML repos with their own chunk files). The manifest's\n    \"format\" key, written by export.write_manifest as \"repo2graph/1\", is\n    the only reliable signal. A missing or unparseable manifest means \"not\n    our index\", not \"corrupt index\" -- check_artifact_integrity only\n    reports corruption once this function has confirmed the directory is\n    actually ours."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/doctor.py::_find_index_dir"}) SET n += {`id`: "sym:repo2graph/doctor.py::_find_index_dir", `name`: "_find_index_dir", `qualname`: "_find_index_dir", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 367, `end_line`: 398, `signature`: "def _find_index_dir(path: Path) -> Path | None:", `docstring`: "Locate an existing repo2graph index directory if present.\n\n    \".r2g\" is repo2graph's own default -o name (cli.py) and collides with\n    nothing else, so a bare agent/ or chunks.jsonl found there is already\n    corroborating evidence -- including a corrupt manifest.json, which\n    check_artifact_integrity should go on to report as broken. Anywhere\n    else, \"agent/\" and \"chunks.jsonl\" are generic names that unrelated\n    projects (agent frameworks, ML repos) use too, so only a manifest.json\n    that actually parses as ours counts as proof."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/doctor.py::check_artifact_integrity"}) SET n += {`id`: "sym:repo2graph/doctor.py::check_artifact_integrity", `name`: "check_artifact_integrity", `qualname`: "check_artifact_integrity", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 401, `end_line`: 475, `signature`: "def check_artifact_integrity(path: Path) -> CheckResult:", `docstring`: ""};
