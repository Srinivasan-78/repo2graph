MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/frameworks.py::route_from_decorator"}) SET n += {`id`: "sym:repo2graph/frameworks.py::route_from_decorator", `name`: "route_from_decorator", `qualname`: "route_from_decorator", `kind`: "function", `path`: "repo2graph/frameworks.py", `lang`: "python", `start_line`: 191, `end_line`: 234, `signature`: "def route_from_decorator(src: bytes, node: Node, lang: str) -> list[dict[str, Any]]:", `docstring`: "Route facts for one decorator node, or `[]` if it declares no route.\n\n    A list because one decorator can declare several routes:\n    `@app.route(\"/x\", methods=[\"GET\", \"POST\"])` is two, and they are two\n    different things to an agent asking which handler serves a POST.\n\n    The path is kept exactly as written -- `{uid}`, `<int:uid>` and `:id` are\n    three frameworks' syntax for the same thing, and normalising them would\n    make the edge's own evidence not match the source it cites."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/frameworks.py::mount_prefix"}) SET n += {`id`: "sym:repo2graph/frameworks.py::mount_prefix", `name`: "mount_prefix", `qualname`: "mount_prefix", `kind`: "function", `path`: "repo2graph/frameworks.py", `lang`: "python", `start_line`: 237, `end_line`: 252, `signature`: "def mount_prefix(src: bytes, node: Node) -> str | None:", `docstring`: "The path prefix a class-level mount decorator contributes, or None.\n\n    `@Controller('users')` makes every route in the class sit under `users`.\n    A mount decorator with no string argument still mounts, at no prefix, so\n    `\"\"` and `None` mean different things and both are returned faithfully."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/frameworks.py::join_path"}) SET n += {`id`: "sym:repo2graph/frameworks.py::join_path", `name`: "join_path", `qualname`: "join_path", `kind`: "function", `path`: "repo2graph/frameworks.py", `lang`: "python", `start_line`: 255, `end_line`: 260, `signature`: "def join_path(prefix: str, path: str) -> str:", `docstring`: "Join a mount prefix and a route path into the path the client calls."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/frameworks.py::injected_dependencies"}) SET n += {`id`: "sym:repo2graph/frameworks.py::injected_dependencies", `name`: "injected_dependencies", `qualname`: "injected_dependencies", `kind`: "function", `path`: "repo2graph/frameworks.py", `lang`: "python", `start_line`: 263, `end_line`: 297, `signature`: "def injected_dependencies(src: bytes, node: Node) -> list[dict[str, Any]]:", `docstring`: "Names this definition's parameters inject, from `Depends(...)` defaults.\n\n    Read off the parameter list rather than the signature *text* so that a\n    default spanning lines, or one containing a comma, cannot be mis-split.\n    Only a plain callable name is taken: `Depends(get_db)` resolves, and\n    `Depends(Factory().build)` does not, because the thing being named is then\n    an expression rather than a symbol this repository defines."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/frameworks.py::_descend_calls"}) SET n += {`id`: "sym:repo2graph/frameworks.py::_descend_calls", `name`: "_descend_calls", `qualname`: "_descend_calls", `kind`: "function", `path`: "repo2graph/frameworks.py", `lang`: "python", `start_line`: 300, `end_line`: 309, `signature`: "def _descend_calls(node: Node, depth: int = 0) -> list[Node]:", `docstring`: "Calls inside `node`, bounded. A parameter default is a small tree."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/frameworks.py::model_relations"}) SET n += {`id`: "sym:repo2graph/frameworks.py::model_relations", `name`: "model_relations", `qualname`: "model_relations", `kind`: "function", `path`: "repo2graph/frameworks.py", `lang`: "python", `start_line`: 312, `end_line`: 362, `signature`: "def model_relations(src: bytes, node: Node, lang: str) -> list[dict[str, Any]]:", `docstring`: "Related-model names this class body declares, from its ORM fields.\n\n    `author = models.ForeignKey(\"Author\")` and\n    `books = relationship(\"Book\")` both name another model. The name is taken\n    from the first argument whether it is a string (`\"Author\"`, including\n    Django's `\"app.Author\"` form, whose last segment is the class) or a bare\n    identifier (`ForeignKey(Author)`), and resolved later like a reference:\n    same file, or imported by that name, never a repository-wide guess.\n\n    `\"self\"` is Django's self-reference and is returned as such, so a\n    self-referential model gets an ho"};
