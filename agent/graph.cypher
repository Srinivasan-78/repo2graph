MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss16_token_never_appears_in_clone_argv"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss16_token_never_appears_in_clone_argv", `name`: "test_iss16_token_never_appears_in_clone_argv", `qualname`: "test_iss16_token_never_appears_in_clone_argv", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1215, `end_line`: 1227, `signature`: "def test_iss16_token_never_appears_in_clone_argv(tmp_path, monkeypatch):", `docstring`: "AC-7 (ISS-16): no argv element handed to subprocess.run may contain the\n    token. At HEAD the token is interpolated into the clone URL argv element.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss18_every_fetch_subprocess_call_passes_timeout"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss18_every_fetch_subprocess_call_passes_timeout", `name`: "test_iss18_every_fetch_subprocess_call_passes_timeout", `qualname`: "test_iss18_every_fetch_subprocess_call_passes_timeout", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1230, `end_line`: 1243, `signature`: "def test_iss18_every_fetch_subprocess_call_passes_timeout(tmp_path, monkeypatch):", `docstring`: "AC-8 (ISS-18, SH-6): every subprocess.run in fetch.py must carry a timeout\n    and specify encoding='utf8' and errors='replace'.", `entrypoint`: true, `reach`: 18};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss13_discover_matches_between_git_and_walk"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss13_discover_matches_between_git_and_walk", `name`: "test_iss13_discover_matches_between_git_and_walk", `qualname`: "test_iss13_discover_matches_between_git_and_walk", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1246, `end_line`: 1267, `signature`: "def test_iss13_discover_matches_between_git_and_walk(tmp_path):", `docstring`: "AC-9 (ISS-13, NC-2): discover() must return the same relative paths whether or\n    not the tree is a git checkout. At HEAD the os.walk fallback drops every\n    dot-directory while the git path keeps it, so `.github/**` appears only in a\n    git checkout.", `entrypoint`: true};
