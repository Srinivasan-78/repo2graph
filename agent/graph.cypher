MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_overview"}) SET n += {`id`: "sym:repo2graph/export.py::write_overview", `name`: "write_overview", `qualname`: "write_overview", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 534, `end_line`: 575, `signature`: "def write_overview(g: \"Graph\", path: Path, top: int = 25) -> None:", `docstring`: "Human/LLM-readable repo map: top directories, hub files, entry points."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_git_short_sha"}) SET n += {`id`: "sym:repo2graph/export.py::_git_short_sha", `name`: "_git_short_sha", `qualname`: "_git_short_sha", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 578, `end_line`: 608, `signature`: "def _git_short_sha(root: Path | str) -> str | None:", `docstring`: "The short commit `root` was built at, or None outside a git repo.\n\n    Same subprocess pattern as graph.add_cochange / walker._git_files (see\n    AGENTS.md): quotepath=false, bytes decoded with surrogateescape (never\n    text=True -- a Windows cp1252 locale raises UnicodeDecodeError on any\n    non-ASCII byte), stdin closed, bounded timeout. Any failure -- not a repo,\n    no git on PATH, a slow filesystem -- just omits the \"Built at\" row."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_overview_human"}) SET n += {`id`: "sym:repo2graph/export.py::write_overview_human", `name`: "write_overview_human", `qualname`: "write_overview_human", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 621, `end_line`: 720, `signature`: "def write_overview_human(g: \"Graph\", path: Path, top: int = 25) -> None:", `docstring`: "Structured, scannable repo map for `human/overview.md`.\n\n    Unlike `write_overview` (still the agent/overview.md prose, unchanged),\n    this reads edge-type and symbol-kind counts straight out of `g.stats`\n    rather than rescanning `g.nodes`/`g.edges`, per the repo convention that\n    `g.stats` is the single source of truth for those counts."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_fanout"}) SET n += {`id`: "sym:repo2graph/export.py::_fanout", `name`: "_fanout", `qualname`: "_fanout", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 853, `end_line`: 863, `signature`: "def _fanout(text: str, max_call_candidates: int) -> str:", `docstring`: "Substitute a build's fan-out limit into one manifest prose template.\n\n    `str.replace`, not `str.format`: these are prose strings that an editor may\n    well one day want a literal brace in (a JSON snippet, a dict example), and\n    `format` would raise KeyError on it here -- turning a typo in documentation\n    copy into a failed build. A template that loses its `{n}` degrades to a\n    sentence with no number, which the top-level `max_call_candidates` key\n    still answers."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_manifest"}) SET n += {`id`: "sym:repo2graph/export.py::write_manifest", `name`: "write_manifest", `qualname`: "write_manifest", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 866, `end_line`: 1017, `signature`: "def write_manifest(\n    g: Any, path: Path, written: list[str], *, checksums: dict[str, Any] | None = None\n) -> None:", `docstring`: "Describe the agent-facing output so a reader needs no other docs.\n\n    `g` is `Any`, not `Graph`, on purpose: every read below is a defaulted\n    `getattr`, and the contract this function has always offered -- see the\n    `max_call_candidates` note -- is that anything quacking like a Graph is\n    accepted. Narrowing the annotation would document a promise it does not make."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_stats_extra"}) SET n += {`id`: "sym:repo2graph/export.py::_stats_extra", `name`: "_stats_extra", `qualname`: "_stats_extra", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1025, `end_line`: 1074, `signature`: "def _stats_extra(g: \"Graph\") -> dict[str, Any]:", `docstring`: "Additive stats.json fields, computed live from `g` at write time.\n\n    Never re-read from nodes.jsonl/edges.jsonl -- dump_all always has the\n    Graph in memory here, and re-deriving from the files it is about to write\n    would be a circular dependency for no reason."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_mark_has_vectors"}) SET n += {`id`: "sym:repo2graph/export.py::_mark_has_vectors", `name`: "_mark_has_vectors", `qualname`: "_mark_has_vectors", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1077, `end_line`: 1094, `signature`: "def _mark_has_vectors(outdir: Path | str) -> None:", `docstring`: "Flip stats.json's has_vectors to True after `embed` writes vectors.npy.\n\n    Best-effort, same as register_written: a missing or unreadable stats.json\n    (e.g. a fixture built with --formats that never writes one) is not\n    embed's problem to fix, so any failure here is silently skipped."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::register_written"}) SET n += {`id`: "sym:repo2graph/export.py::register_written", `name`: "register_written", `qualname`: "register_written", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1097, `end_line`: 1139, `signature`: "def register_written(outdir: Path | str, names: Iterable[str]) -> bool:", `docstring`: "Merge `names` into an existing manifest's `written`, `files`, and `checksums`.\n\n    `embed` runs after `build` as a separate command, so it must append to the\n    manifest dump_all already wrote rather than rewrite it: every other key --\n    counts, entrypoints, how_to_read -- is left exactly as it was. Returns\n    False when there is no readable manifest to append to."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_state"}) SET n += {`id`: "sym:repo2graph/export.py::write_state", `name`: "write_state", `qualname`: "write_state", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1142, `end_line`: 1168, `signature`: "def write_state(g: \"Graph\", path: Path, n_chunks: int) -> None:", `docstring`: "The per-file content hashes a later incremental build reads back.\n\n    `filters` records the discovery filters this build used. Anything that\n    re-runs discovery to compare the tree against the index -- `index-status`,\n    `doctor`'s freshness check -- must apply the same ones, or a build with\n    any `--exclude` reports every deliberately excluded file as newly added\n    and therefore reads as permanently stale."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_parse_cache"}) SET n += {`id`: "sym:repo2graph/export.py::write_parse_cache", `name`: "write_parse_cache", `qualname`: "write_parse_cache", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1171, `end_line`: 1186, `signature`: "def write_parse_cache(g: \"Graph\", path: Path) -> None:", `docstring`: "Write the per-file parse cache the next `--incremental` build reads.\n\n    Args:\n        g: The Graph just built; its `parse_cache` is the payload.\n        path: Destination for `parse.cache.json`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::load_parse_cache"}) SET n += {`id`: "sym:repo2graph/export.py::load_parse_cache", `name`: "load_parse_cache", `qualname`: "load_parse_cache", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1189, `end_line`: 1214, `signature`: "def load_parse_cache(outdir: Path) -> dict[str, Any]:", `docstring`: "Read a previous build's parse cache out of an index directory.\n\n    Every failure mode -- no index, no cache file, unreadable, malformed JSON,\n    a format bump -- returns an empty dict, which makes the next build a full\n    one. An incremental build that silently reuses entries it does not\n    understand is the failure this whole feature was deferred to avoid, so the\n    only safe response to an unrecognised cache is to ignore it.\n\n    Args:\n        outdir: The index directory (the one holding `agent/`).\n\n    Returns:\n        `{relpath: entry}`, or an empty dict when no usable cache is presen"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_atomic_dir_swap"}) SET n += {`id`: "sym:repo2graph/export.py::_atomic_dir_swap", `name`: "_atomic_dir_swap", `qualname`: "_atomic_dir_swap", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1217, `end_line`: 1249, `signature`: "def _atomic_dir_swap(staging: Path, target: Path) -> None:", `docstring`: "Atomically replace target directory with staging directory.\n\n    On Windows, os.replace doesn't work for non-empty directories, so we use\n    a rename dance: target -> backup, staging -> target, then remove backup.\n    If the staging rename fails, we restore the backup."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_local"}) SET n += {`id`: "sym:repo2graph/export.py::write_local", `name`: "write_local", `qualname`: "write_local", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1261, `end_line`: 1281, `signature`: "def write_local(g: Any, index_root: Path) -> None:", `docstring`: "Write LOCAL_FILE (the absolute source root) plus a `.gitignore` for it.\n\n    `index-status` and `doctor <index>` read the root so an `-o` outside the\n    repo is not mistaken for \"the index's parent is the source tree\". A remote\n    build has no surviving tree, so it records none."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::dump_all"}) SET n += {`id`: "sym:repo2graph/export.py::dump_all", `name`: "dump_all", `qualname`: "dump_all", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1296, `end_line`: 1390, `signature`: "def dump_all(\n    g: \"Graph\",\n    chunks: Iterable[Record] | None,\n    outdir: Path,\n    formats: set[str],\n    viz_nodes: int = MAX_NODES,\n) -> tuple[list[str], int]:", `docstring`: "Write the requested artifacts. `chunks` is an iterable of chunk dicts (a\n    build_chunks generator) or None. Returns (written_paths, chunk_count).\n\n    Artifacts are staged in a sibling directory and atomically swapped into\n    outdir on success; a failed or interrupted build never leaves a partial\n    index behind."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::dump_all.out"}) SET n += {`id`: "sym:repo2graph/export.py::dump_all.out", `name`: "out", `qualname`: "dump_all.out", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1333, `end_line`: 1335, `signature`: "def out(name: str) -> list[Path]:", `docstring`: ""};
