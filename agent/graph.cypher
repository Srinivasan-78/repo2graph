MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/__init__.py::_parse_toml"}) SET n += {`id`: "sym:repo2graph/__init__.py::_parse_toml", `name`: "_parse_toml", `qualname`: "_parse_toml", `kind`: "function", `path`: "repo2graph/__init__.py", `lang`: "python", `start_line`: 21, `end_line`: 44, `signature`: "def _parse_toml(content: str) -> tuple[bool, dict[str, Any] | None]:", `docstring`: "`(tomllib_was_available, parsed_or_None)`.\n\n    The two failures have to stay distinguishable: no tomllib means fall back\n    to the regex reader, whereas tomllib rejecting the file means the file is\n    malformed and there is nothing to fall back *to*.\n\n    tomllib is 3.11+ and this project supports 3.10, so the import must be\n    conditional. Returning the result rather than rebinding the module name to\n    None is deliberate: `tomllib = None` in an except branch needs a\n    `type: ignore[assignment]` under a mypy run that can see the module, and\n    that same ignore is reported as unused un"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/__init__.py::_pyproject_version"}) SET n += {`id`: "sym:repo2graph/__init__.py::_pyproject_version", `name`: "_pyproject_version", `qualname`: "_pyproject_version", `kind`: "function", `path`: "repo2graph/__init__.py", `lang`: "python", `start_line`: 47, `end_line`: 70, `signature`: "def _pyproject_version(pyproject: Path) -> str | None:", `docstring`: "`[project] version` read straight out of a pyproject.toml, or None.\n\n    stdlib-only and tomllib-with-regex-fallback, matching the same pattern\n    scripts/check_version.py and tests/test_version_surfaces.py already use:\n    tomllib is 3.11+ and this project supports 3.10."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/__init__.py::_resolve_version"}) SET n += {`id`: "sym:repo2graph/__init__.py::_resolve_version", `name`: "_resolve_version", `qualname`: "_resolve_version", `kind`: "function", `path`: "repo2graph/__init__.py", `lang`: "python", `start_line`: 73, `end_line`: 96, `signature`: "def _resolve_version() -> str:", `docstring`: "Source checkout beats a stale installed dist-info (issue #340).\n\n    `importlib.metadata.version(\"repo2graph\")` answers from whatever\n    package this interpreter's environment happens to have registered -- a\n    leftover `pip install repo2graph==1.6.0` elsewhere on the path silently\n    shadows the real version of a source checkout being run directly\n    (`python -m repo2graph.cli`, `pytest`, an editable checkout that ended\n    up behind a stale dist-info). When this file's own directory sits\n    inside a checkout with a top-level pyproject.toml that names this\n    project, that pyproject.tom"};
