MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_check_room_for_answer"}) SET n += {`id`: "sym:repo2graph/answer.py::_check_room_for_answer", `name`: "_check_room_for_answer", `qualname`: "_check_room_for_answer", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 759, `end_line`: 774, `signature`: "def _check_room_for_answer(model: str, system: str, user: str) -> None:", `docstring`: "Refuse a prompt that leaves no room for MAX_TOKENS of answer (#290).\n\n    The prompt size is the 4-chars-per-token estimate plus a margin, because it\n    is an estimate. Only models in CONTEXT_WINDOWS are checked."};
