MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::_is_secret_path"}) SET n += {`id`: "sym:repo2graph/query.py::_is_secret_path", `name`: "_is_secret_path", `qualname`: "_is_secret_path", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 130, `end_line`: 163, `signature`: "def _is_secret_path(path: str) -> bool:", `docstring`: "Return True if path points to a sensitive file (secrets, keys, credentials)."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::read_jsonl"}) SET n += {`id`: "sym:repo2graph/query.py::read_jsonl", `name`: "read_jsonl", `qualname`: "read_jsonl", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 166, `end_line`: 182, `signature`: "def read_jsonl(path: Path) -> list:", `docstring`: "Load a JSONL file written by export.write_jsonl.\n\n    newline=\"\\n\" matters: json.dumps(ensure_ascii=False) passes U+2028, U+2029\n    and U+0085 through verbatim, and both str.splitlines() and universal-newline\n    mode treat those as line breaks, which would cut records in half."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::count_tokens"}) SET n += {`id`: "sym:repo2graph/query.py::count_tokens", `name`: "count_tokens", `qualname`: "count_tokens", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 185, `end_line`: 188, `signature`: "def count_tokens(text: str) -> int:", `docstring`: "The default token estimate: len(text) // CHARS_PER_TOKEN, never 0 for a\n    non-empty string (a block that costs nothing would defeat any budget)."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::tokenize"}) SET n += {`id`: "sym:repo2graph/query.py::tokenize", `name`: "tokenize", `qualname`: "tokenize", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 196, `end_line`: 203, `signature`: "def tokenize(text: str) -> list[str]:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index"}) SET n += {`id`: "sym:repo2graph/query.py::Index", `name`: "Index", `qualname`: "Index", `kind`: "class", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 206, `end_line`: 805, `signature`: "class Index:\n    # (fused, candidates) for the most recent score_rrf call, or None if no\n    # fused query has run on this Index yet. A class-level default so every\n    # Index has the attribute without __init__ having to care.", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.__init__"}) SET n += {`id`: "sym:repo2graph/query.py::Index.__init__", `name`: "__init__", `qualname`: "Index.__init__", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 212, `end_line`: 249, `signature`: "def __init__(self, outdir: Path):", `docstring`: "", `entrypoint`: true, `reach`: 9};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index._load_vectors"}) SET n += {`id`: "sym:repo2graph/query.py::Index._load_vectors", `name`: "_load_vectors", `qualname`: "Index._load_vectors", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 251, `end_line`: 273, `signature`: "def _load_vectors(self) -> None:", `docstring`: "Load agent/vectors.npy into chunk-list-index keys, or give up quietly.\n\n        The file is keyed by chunk id; ids the current chunks.jsonl no longer\n        holds are dropped rather than shifted onto a neighbouring row, because\n        a mis-aligned vector produces plausible-looking garbage rankings that\n        nothing downstream can detect."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.fuse_ok"}) SET n += {`id`: "sym:repo2graph/query.py::Index.fuse_ok", `name`: "fuse_ok", `qualname`: "Index.fuse_ok", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 275, `end_line`: 307, `signature`: "def fuse_ok(self, embedder) -> tuple[bool, str]:", `docstring`: "May `embedder`'s query vectors be fused with this index's vectors?\n\n        A silent model or width mismatch is worse than no vectors at all: the\n        rankings stay plausible while being meaningless, so the answer is a\n        refusal naming both sides rather than a best effort."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index._load_text"}) SET n += {`id`: "sym:repo2graph/query.py::Index._load_text", `name`: "_load_text", `qualname`: "Index._load_text", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 309, `end_line`: 333, `signature`: "def _load_text(self, name: str) -> str:", `docstring`: "Read an optional artifact, trying every section it is written to.\n\n        newline=\"\\n\" for the same reason read_jsonl uses it: universal-newline\n        mode rewrites U+2028/U+2029/U+0085 line ends and would desync the text\n        from what was written.\n\n        overview.md is the one artifact split across two sections with\n        different content: human/overview.md is the structured table view for\n        a person, agent/overview.md is the terse prose the GraphRAG protocol\n        (and this repo map) are built around. Try the agent copy first so\n        pack_context/rag output keeps readi"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index._load_manifest"}) SET n += {`id`: "sym:repo2graph/query.py::Index._load_manifest", `name`: "_load_manifest", `qualname`: "Index._load_manifest", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 335, `end_line`: 345, `signature`: "def _load_manifest(self) -> dict:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.overview"}) SET n += {`id`: "sym:repo2graph/query.py::Index.overview", `name`: "overview", `qualname`: "Index.overview", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 354, `end_line`: 355, `signature`: "def overview(self, value: str) -> None:", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.manifest"}) SET n += {`id`: "sym:repo2graph/query.py::Index.manifest", `name`: "manifest", `qualname`: "Index.manifest", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 364, `end_line`: 365, `signature`: "def manifest(self, value: dict) -> None:", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.score"}) SET n += {`id`: "sym:repo2graph/query.py::Index.score", `name`: "score", `qualname`: "Index.score", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 369, `end_line`: 387, `signature`: "def score(self, query: str) -> list[tuple[float, int]]:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index._boost_identifiers"}) SET n += {`id`: "sym:repo2graph/query.py::Index._boost_identifiers", `name`: "_boost_identifiers", `qualname`: "Index._boost_identifiers", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 389, `end_line`: 409, `signature`: "def _boost_identifiers(self, query: str, acc: dict) -> None:", `docstring`: "Multiply the score of chunks the query names outright.\n\n        A pinpoint query like `normalize_provider` should return the symbol, not\n        the prose that happens to repeat the word. Only whole identifiers from\n        the query count (not tokenize()'s sub-words), and only chunks BM25\n        already scored are touched, so score()'s invariants are unchanged."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.score_rrf"}) SET n += {`id`: "sym:repo2graph/query.py::Index.score_rrf", `name`: "score_rrf", `qualname`: "Index.score_rrf", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 411, `end_line`: 459, `signature`: "def score_rrf(self, query: str, vectors=None, embedder=None) -> list[tuple[float, int]]:", `docstring`: "BM25 fused with an optional dense ranking by reciprocal rank fusion.\n\n        With neither `vectors` nor `embedder` this is exactly `score()` \u2014 the\n        zero-dependency default path. `embedder` is any object with\n        `.encode(list[str]) -> list[sequence[float]]` (sentence-transformers\n        satisfies it); `vectors` is a mapping of chunk index -> vector, which may\n        carry the query vector under the key \"query\". Similarity is computed in\n        plain Python, so no optional dependency is imported here either."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index._vectors_for"}) SET n += {`id`: "sym:repo2graph/query.py::Index._vectors_for", `name`: "_vectors_for", `qualname`: "Index._vectors_for", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 461, `end_line`: 520, `signature`: "def _vectors_for(self, query, candidates, vectors, embedder):", `docstring`: "Query vector plus one vector per candidate, or a reason there is none.\n\n        Args:\n            query: The raw query string.\n            candidates: Chunk list-indices BM25 shortlisted, in rank order.\n            vectors: Index-keyed vector mapping, or None to embed on the fly.\n            embedder: An object with `.encode(list[str])`, or None.\n\n        Returns:\n            `(query_vector, candidate_vectors, reason)`. On success `reason` is\n            the empty string; on failure the first two are `None`/`[]` and\n            `reason` names *why*, so the caller can report a fusion that\n     "};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.expand"}) SET n += {`id`: "sym:repo2graph/query.py::Index.expand", `name`: "expand", `qualname`: "Index.expand", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 522, `end_line`: 568, `signature`: "def expand(\n        self, seed_nodes, hops=1, edge_types=None, per_hop=6, min_confidence=1.0, edge_dirs=None\n    ):", `docstring`: "Walk `hops` edges out from `seed_nodes`, newest frontier first.\n\n        `min_confidence` gates CALLS edges only: call resolution is name-based\n        and an overloaded name fans out to several candidates at 1/n confidence,\n        while IMPORTS/DEFINES/INHERITS carry no `confidence` key at all and must\n        never be dropped by the gate. `edge_dirs` maps an edge type to the\n        directions worth following (see DEFAULT_EDGE_DIRS)."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.retrieve"}) SET n += {`id`: "sym:repo2graph/query.py::Index.retrieve", `name`: "retrieve", `qualname`: "Index.retrieve", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 570, `end_line`: 636, `signature`: "def retrieve(\n        self,\n        query: str,\n        k: int = 8,\n        hops: int = 1,\n        budget_chars: int = 24000,\n        *,\n        min_confidence: float | None = None,\n        vectors=None,\n        embedder=None,\n    ):", `docstring`: "Lexical seeds plus their graph neighbours, budgeted on chunk text.\n\n        `budget_chars` bounds the sum of the returned chunks' `text` only \u2014 it\n        says nothing about how a caller renders them. pack_context() uses the\n        other model (the whole rendered markdown); do not unify the two.\n        `min_confidence=None` means \"do not filter CALLS on confidence\", which is\n        this method's historical behaviour. With `vectors` and `embedder` both\n        None -- the default -- seeds come from `score()` exactly as they always\n        have; supply either and they come from the fused rank"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.map_prepend"}) SET n += {`id`: "sym:repo2graph/query.py::Index.map_prepend", `name`: "map_prepend", `qualname`: "Index.map_prepend", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 640, `end_line`: 663, `signature`: "def map_prepend(self) -> str:", `docstring`: "The repo map: the prose overview plus the top entry points.\n\n        Entry points come straight off `manifest[\"entrypoints\"]`, which\n        export.write_manifest already sorted by reach. Both sources are\n        optional; with neither, this is the empty string."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.pack_context"}) SET n += {`id`: "sym:repo2graph/query.py::Index.pack_context", `name`: "pack_context", `qualname`: "Index.pack_context", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 665, `end_line`: 805, `signature`: "def pack_context(\n        self,\n        query: str,\n        k: int = 8,\n        hops: int = 1,\n        budget_chars: int = 24000,\n        min_confidence: float = 1.0,\n        expand_graph: bool = True,\n        vectors=None,\n        embedder=None,\n        exclude_secrets: bool = False,\n        budget", `docstring`: "An agent-ready markdown pack: repo map, `---`, then cited chunks.\n\n        `budget_chars` bounds the WHOLE returned markdown \u2014 map prepend, `---`\n        separator and every `### [cite: ...]` header included \u2014 unlike\n        retrieve(), which budgets chunk text only. `budget_chars <= 0` means\n        unbounded. Spending order is map (capped at MAP_BUDGET_FRAC of the\n        budget), then seeds in score order at full text, then graph neighbours\n        at full text or, if that no longer fits, compressed to their header\n        lines plus the signature line. Nothing is truncated mid-line.\n\n     "};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.pack_context.fits"}) SET n += {`id`: "sym:repo2graph/query.py::Index.pack_context.fits", `name`: "fits", `qualname`: "Index.pack_context.fits", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 750, `end_line`: 751, `signature`: "def fits(block: str) -> bool:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::_first"}) SET n += {`id`: "sym:repo2graph/query.py::_first", `name`: "_first", `qualname`: "_first", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 808, `end_line`: 811, `signature`: "def _first(seq):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::_has_vector"}) SET n += {`id`: "sym:repo2graph/query.py::_has_vector", `name`: "_has_vector", `qualname`: "_has_vector", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 814, `end_line`: 823, `signature`: "def _has_vector(vectors, i) -> bool:", `docstring`: "True when `vectors` holds a vector for chunk index `i`.\n\n    Used only to count what is missing for a diagnostic message, so it answers\n    False for every failure mode rather than distinguishing them."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::_dim_mismatch_reason"}) SET n += {`id`: "sym:repo2graph/query.py::_dim_mismatch_reason", `name`: "_dim_mismatch_reason", `qualname`: "_dim_mismatch_reason", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 826, `end_line`: 844, `signature`: "def _dim_mismatch_reason(qvec, cvecs) -> str:", `docstring`: "Empty when every candidate vector matches `qvec`'s width, else a reason.\n\n    `zip()` truncates to the shorter operand, so a width mismatch (e.g. 768 vs\n    1536 from two different embedding models) would otherwise pass straight\n    into `_cosine()` and compute a plausible-looking but meaningless score\n    instead of raising. Catching it here keeps the promise the rest of\n    `_vectors_for` makes: a bad vector turns fusion off and falls back to\n    BM25, it never raises out to the caller."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::_cosine"}) SET n += {`id`: "sym:repo2graph/query.py::_cosine", `name`: "_cosine", `qualname`: "_cosine", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 847, `end_line`: 865, `signature`: "def _cosine(a, b) -> float:", `docstring`: "Cosine similarity over any two sequences of floats (no numpy needed).\n\n    Raises `ValueError` on mismatched lengths rather than letting `zip()`\n    silently truncate to the shorter vector and compute a meaningless score.\n    Callers that accept caller-supplied vectors (`score_rrf` via\n    `_vectors_for`) must validate widths themselves and never let this\n    exception reach their own caller -- see `_dim_mismatch_reason`."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::_fit_lines"}) SET n += {`id`: "sym:repo2graph/query.py::_fit_lines", `name`: "_fit_lines", `qualname`: "_fit_lines", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 868, `end_line`: 884, `signature`: "def _fit_lines(text: str, limit: int, measure=len) -> str:", `docstring`: "The longest whole-line prefix of `text` that fits in `limit` units.\n\n    The candidate is measured whole rather than line by line, so a measure that\n    is not additive (any token estimate) is applied to the string that will\n    actually be emitted. With the default `len` this is exactly the running\n    \"len(line) + a newline\" arithmetic it replaces."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::_compress"}) SET n += {`id`: "sym:repo2graph/query.py::_compress", `name`: "_compress", `qualname`: "_compress", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 887, `end_line`: 902, `signature`: "def _compress(text: str) -> str:", `docstring`: "A chunk reduced to its `#` metadata header plus the signature line.\n\n    chunks.build_chunks always emits `# file:` / `# <kind>:` header lines ahead\n    of the body, so the first non-blank line after them is the def/class line."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::_cite_block"}) SET n += {`id`: "sym:repo2graph/query.py::_cite_block", `name`: "_cite_block", `qualname`: "_cite_block", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 905, `end_line`: 916, `signature`: "def _cite_block(chunk: dict, text: str) -> str:", `docstring`: "One `### [cite: path:start-end] `symbol` (why)` block, trailing blank line."};
