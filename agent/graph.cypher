MERGE (n:R2G:`Symbol` {id: "sym:tests/test_demo.py::test_blast_radius_question_shows_the_direct_caller"}) SET n += {`id`: "sym:tests/test_demo.py::test_blast_radius_question_shows_the_direct_caller", `name`: "test_blast_radius_question_shows_the_direct_caller", `qualname`: "test_blast_radius_question_shows_the_direct_caller", `kind`: "function", `path`: "tests/test_demo.py", `lang`: "python", `start_line`: 258, `end_line`: 272, `signature`: "def test_blast_radius_question_shows_the_direct_caller(tmp_path):", `docstring`: "Question 4 promised direct callers but its pack showed only FakeStore.\n\n    The CALLS edge place_order -> OrderStore.insert exists at low confidence\n    (untyped receiver, name shared with the test double), so search does not\n    walk it; the demo lists the node's own CALLS-in edges instead.", `entrypoint`: true};
