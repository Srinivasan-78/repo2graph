MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/status.py::_read_json"}) SET n += {`id`: "sym:repo2graph/status.py::_read_json", `name`: "_read_json", `qualname`: "_read_json", `kind`: "function", `path`: "repo2graph/status.py", `lang`: "python", `start_line`: 90, `end_line`: 95, `signature`: "def _read_json(path: Path) -> dict[str, Any]:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/status.py::_index_root_of"}) SET n += {`id`: "sym:repo2graph/status.py::_index_root_of", `name`: "_index_root_of", `qualname`: "_index_root_of", `kind`: "function", `path`: "repo2graph/status.py", `lang`: "python", `start_line`: 98, `end_line`: 100, `signature`: "def _index_root_of(agent_dir: Path) -> Path:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/status.py::stored_source_root"}) SET n += {`id`: "sym:repo2graph/status.py::stored_source_root", `name`: "stored_source_root", `qualname`: "stored_source_root", `kind`: "function", `path`: "repo2graph/status.py", `lang`: "python", `start_line`: 103, `end_line`: 123, `signature`: "def stored_source_root(agent_dir: Path) -> Path | None:", `docstring`: "The source root the build recorded, if it still exists.\n\n    Read from the machine-local `local.json` at the index root (never shipped;\n    see ../.github/SECURITY.md), else from `manifest.json`'s `source_root` for an\n    index built before that file existed. None for an index with neither, an\n    unreadable file, or a recorded root that is gone (the index was moved or\n    shipped to another machine) -- callers then fall back to the\n    `<repo>/.r2g` heuristic."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/status.py::stored_remote_source"}) SET n += {`id`: "sym:repo2graph/status.py::stored_remote_source", `name`: "stored_remote_source", `qualname`: "stored_remote_source", `kind`: "function", `path`: "repo2graph/status.py", `lang`: "python", `start_line`: 126, `end_line`: 129, `signature`: "def stored_remote_source(agent_dir: Path) -> str | None:", `docstring`: "`github:owner/repo@sha` for an index `repo2graph github` built, else None."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/status.py::remote_refresh_command"}) SET n += {`id`: "sym:repo2graph/status.py::remote_refresh_command", `name`: "remote_refresh_command", `qualname`: "remote_refresh_command", `kind`: "function", `path`: "repo2graph/status.py", `lang`: "python", `start_line`: 132, `end_line`: 135, `signature`: "def remote_refresh_command(remote: str, out: Path | str) -> str:", `docstring`: "The command that rebuilds a remote index: `github owner/repo`, never `build <cwd>`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/status.py::remote_freshness"}) SET n += {`id`: "sym:repo2graph/status.py::remote_freshness", `name`: "remote_freshness", `qualname`: "remote_freshness", `kind`: "function", `path`: "repo2graph/status.py", `lang`: "python", `start_line`: 138, `end_line`: 154, `signature`: "def remote_freshness(remote: str, agent_dir: Path, out: Path | str) -> Freshness:", `docstring`: "Freshness for a remote build: not checkable, and says how to refresh.\n\n    The clone it was built from was deleted, so comparing against any local\n    tree -- the working directory, the index's parent -- reports every file as\n    added and suggests rebuilding the wrong directory."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/status.py::compute_freshness"}) SET n += {`id`: "sym:repo2graph/status.py::compute_freshness", `name`: "compute_freshness", `qualname`: "compute_freshness", `kind`: "function", `path`: "repo2graph/status.py", `lang`: "python", `start_line`: 157, `end_line`: 351, `signature`: "def compute_freshness(repo: Path, idx_dir: Path, agent_dir: Path) -> Freshness:", `docstring`: "Three independent signals that the index no longer matches the tree.\n\n    Cheapest first, and each one degrades to a note rather than an error:\n\n    1. The commit recorded in `manifest.json` against the tree's `HEAD`. One\n       subprocess, exact for committed state, silent on a non-git tree.\n    2. The file set discovery finds now against the one `index.state.json`\n       recorded -- a set difference over paths, no file reads.\n    3. A real sha256 for each file whose mtime is newer than `manifest.json`.\n       The mtime *only chooses what to hash*: a file touched but not changed\n       hashes"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/status.py::_dir_size"}) SET n += {`id`: "sym:repo2graph/status.py::_dir_size", `name`: "_dir_size", `qualname`: "_dir_size", `kind`: "function", `path`: "repo2graph/status.py", `lang`: "python", `start_line`: 354, `end_line`: 366, `signature`: "def _dir_size(path: Path) -> tuple[int, int]:", `docstring`: "(total bytes, file count) under `path`. Symlinks are not followed."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/status.py::human_bytes"}) SET n += {`id`: "sym:repo2graph/status.py::human_bytes", `name`: "human_bytes", `qualname`: "human_bytes", `kind`: "function", `path`: "repo2graph/status.py", `lang`: "python", `start_line`: 369, `end_line`: 378, `signature`: "def human_bytes(n: int) -> str:", `docstring`: "'1.4 MB'. Decimal units, because that is what `ls -lh --si` and every\n    cloud storage bill use, and this number is most often compared to one."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/status.py::index_status"}) SET n += {`id`: "sym:repo2graph/status.py::index_status", `name`: "index_status", `qualname`: "index_status", `kind`: "function", `path`: "repo2graph/status.py", `lang`: "python", `start_line`: 397, `end_line`: 504, `signature`: "def index_status(out: Path | str, repo: Path | str | None = None) -> dict[str, Any]:", `docstring`: "The full report. Raises FileNotFoundError when there is no index.\n\n    Args:\n        out: The `-o` output directory (or the `agent/` directory itself).\n        repo: The source tree. Defaults to the index directory's parent,\n            which is right for the conventional `<repo>/.r2g` layout.\n\n    Returns:\n        A JSON-serialisable dict. `repo2graph index-status --json` prints it\n        verbatim, so every key here is public."};
