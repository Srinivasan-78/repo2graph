MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli_embed.py::cmd_embed"}) SET n += {`id`: "sym:repo2graph/cli_embed.py::cmd_embed", `name`: "cmd_embed", `qualname`: "cmd_embed", `kind`: "function", `path`: "repo2graph/cli_embed.py", `lang`: "python", `start_line`: 23, `end_line`: 97, `signature`: "def cmd_embed(args: argparse.Namespace) -> int | None:", `docstring`: "Embed an index's chunks, reusing every vector whose text is unchanged.", `entrypoint`: true, `reach`: 189};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli_embed.py::_reusable_vectors"}) SET n += {`id`: "sym:repo2graph/cli_embed.py::_reusable_vectors", `name`: "_reusable_vectors", `qualname`: "_reusable_vectors", `kind`: "function", `path`: "repo2graph/cli_embed.py", `lang`: "python", `start_line`: 100, `end_line`: 133, `signature`: "def _reusable_vectors(npy: Path, model_id: str, hashes: dict[str, Any]) -> dict[str, Any]:", `docstring`: "Stored vectors whose chunk id *and* chunk text are both unchanged.\n\n    A chunk's vector depends on its own text and nothing else, so this is\n    correct by construction \u2014 unlike reusing anything that depends on the\n    graph, whose call confidences are global."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli_embed.py::verify_rag"}) SET n += {`id`: "sym:repo2graph/cli_embed.py::verify_rag", `name`: "verify_rag", `qualname`: "verify_rag", `kind`: "function", `path`: "repo2graph/cli_embed.py", `lang`: "python", `start_line`: 136, `end_line`: 222, `signature`: "def verify_rag(\n    idx: Index,\n    out: Path,\n    embed_model: str | None = None,\n    embed_backend: str | None = None,\n) -> tuple[dict[str, Any], str | None]:", `docstring`: "Self-test the dense-retrieval path against one index.\n\n    Answers the four questions that distinguish \"dense retrieval is working\"\n    from \"dense retrieval silently is not\": are there vectors at all, which\n    model and width were they built with, does the active embedder agree, and\n    does every chunk actually have one.\n\n    Args:\n        idx: An open `Index`.\n        out: The index directory, for error messages.\n        embed_model: Model id to check against, or None for the built-in\n            default. Never defaulted to the index's own `model_id` -- comparing\n            a value with i"};
