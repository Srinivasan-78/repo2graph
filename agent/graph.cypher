MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_count_gitignored"}) SET n += {`id`: "sym:repo2graph/parse.py::_count_gitignored", `name`: "_count_gitignored", `qualname`: "_count_gitignored", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 516, `end_line`: 550, `signature`: "def _count_gitignored(root: Path) -> int:", `docstring`: "How many untracked files .gitignore (or another exclude-standard rule)\n    kept out of _git_files' listing.\n\n    Purely a count for the human overview's \"what was skipped\" section --\n    `_git_files` already applies `--exclude-standard` itself, so these files\n    never reach `discover()`'s loop below and this never changes what is\n    yielded. Same subprocess pattern as `_git_files`: quotepath=false, bytes\n    decoded with surrogateescape (never text=True -- see CONTRIBUTING.md), bounded\n    timeout."};
