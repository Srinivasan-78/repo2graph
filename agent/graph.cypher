MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::grammar_fingerprint"}) SET n += {`id`: "sym:repo2graph/parse.py::grammar_fingerprint", `name`: "grammar_fingerprint", `qualname`: "grammar_fingerprint", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 730, `end_line`: 759, `signature`: "def grammar_fingerprint() -> str:", `docstring`: "Identity of the installed grammars, for the incremental parse cache key.\n\n    `PARSE_CACHE_FORMAT` is bumped by hand whenever *our* extraction changes, so\n    it catches every change we make and none that we don't. A tree-sitter\n    grammar upgrade is the second kind: the same source, parsed by a newer\n    grammar, can yield different node types and therefore different symbols,\n    calls and qualnames -- with `PARSE_CACHE_FORMAT` untouched, because nothing\n    in this repository changed. `--incremental` would then reuse entries\n    produced by the old grammar for every file whose bytes did not"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::parser_for"}) SET n += {`id`: "sym:repo2graph/parse.py::parser_for", `name`: "parser_for", `qualname`: "parser_for", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 763, `end_line`: 788, `signature`: "def parser_for(lang: str):", `docstring`: "The parser for `lang`, or None if one cannot be obtained for any reason.\n\n    The except clause is deliberately broad. It used to name\n    `(LookupError, ValueError, ImportError, AttributeError)`, which covers what\n    tree-sitter-language-pack 0.x raises but not 1.x: that line raises its own\n    `DownloadError`, `ChecksumMismatchError`, `CacheLockError`,\n    `DynamicLoadError`, `ParserSetupError` and friends, all deriving from a\n    private `tree_sitter_language_pack.exceptions.Error` rather than from\n    anything in the tuple. Offline, every one of those escaped `parser_for`\n    instead of a"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::Symbol"}) SET n += {`id`: "sym:repo2graph/parse.py::Symbol", `name`: "Symbol", `qualname`: "Symbol", `kind`: "class", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 792, `end_line`: 812, `signature`: "class Symbol:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::symbol_key"}) SET n += {`id`: "sym:repo2graph/parse.py::symbol_key", `name`: "symbol_key", `qualname`: "symbol_key", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 815, `end_line`: 823, `signature`: "def symbol_key(sym: Symbol) -> str:", `docstring`: "The part of a symbol's node id after `sym:<path>::`.\n\n    Equal to `qualname` for every first definition of a name in a file; a later\n    definition with the same qualname (Java/C#/Kotlin/Swift/C++ overloads, a\n    Python conditional redefinition) carries `@L<line>` so it gets a node and\n    a chunk of its own instead of silently collapsing into the first one."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::symbol_parent_key"}) SET n += {`id`: "sym:repo2graph/parse.py::symbol_parent_key", `name`: "symbol_parent_key", `qualname`: "symbol_parent_key", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 826, `end_line`: 828, `signature`: "def symbol_parent_key(sym: Symbol) -> str | None:", `docstring`: "The `symbol_key` of the enclosing symbol, or None for a file-level one."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::disambiguate_key"}) SET n += {`id`: "sym:repo2graph/parse.py::disambiguate_key", `name`: "disambiguate_key", `qualname`: "disambiguate_key", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 831, `end_line`: 846, `signature`: "def disambiguate_key(qualname: str, line: int, used: set[str]) -> str:", `docstring`: "Empty string if `qualname` is still free in `used`, else a stable `@L<line>` key.\n\n    Deterministic: depends only on source order and line numbers. Two same-named\n    definitions on one line (minified code) fall back to `@L<line>~<n>`."};
