MERGE (n:R2G:Symbol {id: "sym:repo2graph/parse.py::_split_bases"}) SET n += {`id`: "sym:repo2graph/parse.py::_split_bases", `name`: "_split_bases", `qualname`: "_split_bases", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 640, `end_line`: 660, `signature`: "def _split_bases(text: str) -> list[str]:", `docstring`: "Split a base-class list on top-level commas only.\n\n    A generic's type arguments (`Generic[T, U]`, `Handler<Request, Response>`)\n    contain commas that must not split the base list itself, so track bracket\n    depth and only split where it is zero."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/parse.py::_clean_base"}) SET n += {`id`: "sym:repo2graph/parse.py::_clean_base", `name`: "_clean_base", `qualname`: "_clean_base", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 663, `end_line`: 670, `signature`: "def _clean_base(text: str) -> str:", `docstring`: "'public B', 'extends B', '< B' -> 'B'."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/parse.py::_base_clauses"}) SET n += {`id`: "sym:repo2graph/parse.py::_base_clauses", `name`: "_base_clauses", `qualname`: "_base_clauses", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 673, `end_line`: 686, `signature`: "def _base_clauses(node):", `docstring`: "Supertype clauses of a definition, preferring the innermost one.\n\n    TypeScript wraps extends_clause/implements_clause in a class_heritage and\n    Java wraps a type_list in super_interfaces; the outer node's text would join\n    several names into one string, so descend when a child is a clause too."};
