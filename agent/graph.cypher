MERGE (n:R2G:Symbol {id: "sym:tests/test_secrets_hardening.py::test_redact_content_on_repeated_begin_stays_linear"}) SET n += {`id`: "sym:tests/test_secrets_hardening.py::test_redact_content_on_repeated_begin_stays_linear", `name`: "test_redact_content_on_repeated_begin_stays_linear", `qualname`: "test_redact_content_on_repeated_begin_stays_linear", `kind`: "function", `path`: "tests/test_secrets_hardening.py", `lang`: "python", `start_line`: 595, `end_line`: 610, `signature`: "def test_redact_content_on_repeated_begin_stays_linear():", `docstring`: "redact_content runs the scan and then rewrites; both must stay bounded.\n\n    Sized at 200k, not 100k: at 100k the quadratic form takes ~2s, which slips\n    under this bound and makes the test a detector in name only.", `entrypoint`: true};
