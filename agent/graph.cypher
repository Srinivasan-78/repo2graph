MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::test_release_commit_paths_cover_every_bumped_path_plus_the_changelog"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_release_commit_paths_cover_every_bumped_path_plus_the_changelog", `name`: "test_release_commit_paths_cover_every_bumped_path_plus_the_changelog", `qualname`: "test_release_commit_paths_cover_every_bumped_path_plus_the_changelog", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 76, `end_line`: 85, `signature`: "def test_release_commit_paths_cover_every_bumped_path_plus_the_changelog():", `docstring`: "publish.yml passes this list to `--files`. A path `rewrite()` touches but\n    the list omits produces a release commit that bumps some surfaces and not\n    others, on a tag PyPI will not let you reuse.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::test_files_mode_prints_exactly_those_paths"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_files_mode_prints_exactly_those_paths", `name`: "test_files_mode_prints_exactly_those_paths", `qualname`: "test_files_mode_prints_exactly_those_paths", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 88, `end_line`: 99, `signature`: "def test_files_mode_prints_exactly_those_paths():", `docstring`: "The `--files` CLI is what publish.yml shells out to; if its output stops\n    being a plain space-separated list, `read -ra` silently builds the wrong\n    array.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::test_every_surface_path_exists"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_every_surface_path_exists", `name`: "test_every_surface_path_exists", `qualname`: "test_every_surface_path_exists", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 102, `end_line`: 106, `signature`: "def test_every_surface_path_exists():", `docstring`: "A renamed doc silently drops its surface from both the bump and the\n    check, so the table naming a file that is gone must fail loudly.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::test_precommit_hook_fires_for_every_surface_it_guards"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_precommit_hook_fires_for_every_surface_it_guards", `name`: "test_precommit_hook_fires_for_every_surface_it_guards", `qualname`: "test_precommit_hook_fires_for_every_surface_it_guards", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 109, `end_line`: 134, `signature`: "def test_precommit_hook_fires_for_every_surface_it_guards():", `docstring`: "The `version-consistency` hook's `files:` regex must match every path in\n    the surface table.\n\n    The regex is maintained by hand next to a comment claiming it mirrors\n    `version_surfaces.SURFACES`, and it had drifted both ways: it still named\n    four deleted docs, and it had never been updated for `npm/package.json`,\n    `CITATION.cff` or `docs/cli.md`, so a commit touching only those bumped a\n    version the local hook never checked. CI runs `check_version.py`\n    unconditionally, so this was a local-hook gap rather than a missed gate --\n    which is exactly why nothing caught it.", `entrypoint`: true};
