MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_add_cochange_byte_cap_drops_trailing_partial_commit"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_add_cochange_byte_cap_drops_trailing_partial_commit", `name`: "test_add_cochange_byte_cap_drops_trailing_partial_commit", `qualname`: "test_add_cochange_byte_cap_drops_trailing_partial_commit", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2734, `end_line`: 2754, `signature`: "def test_add_cochange_byte_cap_drops_trailing_partial_commit(monkeypatch):", `docstring`: "When stdout exceeds MAX_COCHANGE_BYTES, the cut truncates the oldest\n    commit block. If that commit originally touched > 25 files (a noise commit),\n    truncating it must not leave a surviving slice (<= 25 files) that emits\n    spurious CO_CHANGE pairs.", `entrypoint`: true, `reach`: 46};
