MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss67_build_takes_the_pool_path_above_parallel_min_files"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss67_build_takes_the_pool_path_above_parallel_min_files", `name`: "test_iss67_build_takes_the_pool_path_above_parallel_min_files", `qualname`: "test_iss67_build_takes_the_pool_path_above_parallel_min_files", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1535, `end_line`: 1567, `signature`: "def test_iss67_build_takes_the_pool_path_above_parallel_min_files(wide_repo, monkeypatch):", `docstring`: "#67: every other fixture is under PARALLEL_MIN_FILES, so nothing in the\n    suite ever entered `parse_all`'s ProcessPoolExecutor branch -- which is how\n    the MCP auto-build hang (#90) survived a green run.\n\n    `wide_repo` crosses the threshold, and this asserts the branch is taken\n    *and* that the pool is built with the initializer that keeps its workers\n    off whatever stdin/stdout the parent had.", `entrypoint`: true};
