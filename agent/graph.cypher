MERGE (n:R2G:Symbol {id: "sym:repo2graph/embed.py::default_embedder"}) SET n += {`id`: "sym:repo2graph/embed.py::default_embedder", `name`: "default_embedder", `qualname`: "default_embedder", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 258, `end_line`: 271, `signature`: "def default_embedder(name: str | None = None):", `docstring`: "Load `name` (default DEFAULT_MODEL) through sentence-transformers.\n\n    The import is deliberately here and not at module scope: `repo2graph.embed`\n    must import on a bare install, and only this function needs the extra."};
