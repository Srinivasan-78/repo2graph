MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp_sse.py::test_create_sse_app_warns_when_built_without_a_token"}) SET n += {`id`: "sym:tests/test_mcp_sse.py::test_create_sse_app_warns_when_built_without_a_token", `name`: "test_create_sse_app_warns_when_built_without_a_token", `qualname`: "test_create_sse_app_warns_when_built_without_a_token", `kind`: "function", `path`: "tests/test_mcp_sse.py", `lang`: "python", `start_line`: 328, `end_line`: 357, `signature`: "def test_create_sse_app_warns_when_built_without_a_token(mini_index, capsys):", `docstring`: "The exported constructor must not hand back an open index in silence.\n\n    ...but it must also stay quiet for the documented loopback default, or every\n    ordinary local `--transport sse` user is warned for doing the sanctioned\n    thing. An unknown bind host is treated as exposed, since that is the safe\n    direction for a check whose only effect is a warning.", `entrypoint`: true};
