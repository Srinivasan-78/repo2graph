MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_an_expired_ttl_refetches"}) SET n += {`id`: "sym:tests/test_auth.py::test_an_expired_ttl_refetches", `name`: "test_an_expired_ttl_refetches", `qualname`: "test_an_expired_ttl_refetches", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 352, `end_line`: 373, `signature`: "def test_an_expired_ttl_refetches():", `docstring`: "Keys are re-read once the TTL has elapsed.\n\n    The clock is injected rather than slept through. An earlier version used\n    ttl=0.0 and two back-to-back calls, which passes only if the monotonic\n    clock ticks between them -- so it passed on one machine and failed on\n    another, where Windows falls back to GetTickCount64's ~15.6ms granularity\n    and both calls read the same instant.", `entrypoint`: true, `reach`: 27};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_zero_ttl_never_caches"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_zero_ttl_never_caches", `name`: "test_a_zero_ttl_never_caches", `qualname`: "test_a_zero_ttl_never_caches", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 376, `end_line`: 388, `signature`: "def test_a_zero_ttl_never_caches():", `docstring`: "`ttl=0` means \"do not cache\", whatever the clock's resolution.\n\n    With a strict `>` comparison this promise silently depended on the clock\n    ticking between calls, which is exactly the flake above in its other form:\n    a configuration that says \"never cache\" would keep serving stale keys.", `entrypoint`: true, `reach`: 26};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_an_unknown_kid_refetches_exactly_once_then_fails"}) SET n += {`id`: "sym:tests/test_auth.py::test_an_unknown_kid_refetches_exactly_once_then_fails", `name`: "test_an_unknown_kid_refetches_exactly_once_then_fails", `qualname`: "test_an_unknown_kid_refetches_exactly_once_then_fails", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 391, `end_line`: 399, `signature`: "def test_an_unknown_kid_refetches_exactly_once_then_fails():", `docstring`: "Key rotation costs one refetch; a kid flood must not cost one each.", `entrypoint`: true, `reach`: 26};
