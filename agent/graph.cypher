MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_chained_call_attributes_outer_callee"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_chained_call_attributes_outer_callee", `name`: "test_chained_call_attributes_outer_callee", `qualname`: "test_chained_call_attributes_outer_callee", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 3050, `end_line`: 3072, `signature`: "def test_chained_call_attributes_outer_callee():", `docstring`: "Verify a chained call `obj.get_user().save()` must record BOTH\n    `save` (the outer call) and `get_user` (the inner call) as callees --\n    not `get_user` twice with `save` silently dropped.\n\n    Before the fix, `_callee_name` stripped everything from the first \"(\"\n    onward in the outer call's `function`-field text\n    (\"obj.get_user().save\"), which ate the trailing \".save\" and left\n    \"obj.get_user\" -> \"get_user\". `save()` never registered at all.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_callee_name_macro_and_fn_pointers"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_callee_name_macro_and_fn_pointers", `name`: "test_callee_name_macro_and_fn_pointers", `qualname`: "test_callee_name_macro_and_fn_pointers", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 3075, `end_line`: 3084, `signature`: "def test_callee_name_macro_and_fn_pointers():", `docstring`: "Verify callee extraction handles C function pointer calls and Rust macros.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_callee_name_resolves_php_namespace_separator"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_callee_name_resolves_php_namespace_separator", `name`: "test_callee_name_resolves_php_namespace_separator", `qualname`: "test_callee_name_resolves_php_namespace_separator", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 3087, `end_line`: 3098, `signature`: "def test_callee_name_resolves_php_namespace_separator():", `docstring`: "#344: a PHP namespaced call must resolve to its bare function name.\n\n    `\\\\App\\\\Utils\\\\compute()` is a fully-qualified call outside any class; its\n    `function` field text carries the leading namespace segments, and without\n    \"\\\\\" in _callee_name's separator tuple those segments survived into the\n    recorded callee, which then never matched `graph.py`'s by-bare-name index.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_inherits_edges_for_cpp_scope_and_php_namespace_bases"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_inherits_edges_for_cpp_scope_and_php_namespace_bases", `name`: "test_inherits_edges_for_cpp_scope_and_php_namespace_bases", `qualname`: "test_inherits_edges_for_cpp_scope_and_php_namespace_bases", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 3101, `end_line`: 3122, `signature`: "def test_inherits_edges_for_cpp_scope_and_php_namespace_bases(tmp_path):", `docstring`: "#341: `::`- and `\\\\`-qualified base classes must resolve to their node.\n\n    Uses class names outside COMMON_STDLIB_BASES (`Base`/`Model`/... are\n    deliberately unresolved unless local/imported -- unrelated to this bug)\n    so the assertion isolates the separator-stripping fix.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_self_recursive_function_is_still_an_entrypoint_root"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_self_recursive_function_is_still_an_entrypoint_root", `name`: "test_self_recursive_function_is_still_an_entrypoint_root", `qualname`: "test_self_recursive_function_is_still_an_entrypoint_root", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 3125, `end_line`: 3139, `signature`: "def test_self_recursive_function_is_still_an_entrypoint_root(tmp_path):", `docstring`: "#342: a self-CALLS edge (src == dst) must not disqualify a root.\n\n    `entry` calls only itself and has no external caller, so it must still be\n    marked `entrypoint`. `helper`, called by `other`, must not be -- proving\n    the fix did not also stop *external* calls from marking a destination.", `entrypoint`: true, `reach`: 170};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_header_content_sniff_picks_c_or_cpp"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_header_content_sniff_picks_c_or_cpp", `name`: "test_header_content_sniff_picks_c_or_cpp", `qualname`: "test_header_content_sniff_picks_c_or_cpp", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 3142, `end_line`: 3159, `signature`: "def test_header_content_sniff_picks_c_or_cpp(tmp_path):", `docstring`: "#377: `.h` must be parsed as cpp when its content says so, else c.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_header_sniff_also_applies_to_a_chunked_large_header"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_header_sniff_also_applies_to_a_chunked_large_header", `name`: "test_header_sniff_also_applies_to_a_chunked_large_header", `qualname`: "test_header_sniff_also_applies_to_a_chunked_large_header", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 3162, `end_line`: 3187, `signature`: "def test_header_sniff_also_applies_to_a_chunked_large_header(tmp_path):", `docstring`: "#377: a `.h` over `max_file_bytes` takes the chunked reader, which must sniff too.\n\n    `_read_and_parse` sniffs the full bytes it already read, but a file larger\n    than `max_file_bytes` returns early into `_chunk_and_parse`, which streams\n    and never holds them -- so that path needed its own sniff against the first\n    slice. An amalgamated single-header C++ library is the ordinary case for a\n    `.h` this size.", `entrypoint`: true};
