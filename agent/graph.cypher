MERGE (n:R2G:`Symbol` {id: "sym:tests/test_schema.py::test_chunk_records_carry_every_required_schema_field"}) SET n += {`id`: "sym:tests/test_schema.py::test_chunk_records_carry_every_required_schema_field", `name`: "test_chunk_records_carry_every_required_schema_field", `qualname`: "test_chunk_records_carry_every_required_schema_field", `kind`: "function", `path`: "tests/test_schema.py", `lang`: "python", `start_line`: 34, `end_line`: 40, `signature`: "def test_chunk_records_carry_every_required_schema_field(mini_index):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_schema.py::test_node_and_edge_records_carry_their_documented_minimum"}) SET n += {`id`: "sym:tests/test_schema.py::test_node_and_edge_records_carry_their_documented_minimum", `name`: "test_node_and_edge_records_carry_their_documented_minimum", `qualname`: "test_node_and_edge_records_carry_their_documented_minimum", `kind`: "function", `path`: "tests/test_schema.py", `lang`: "python", `start_line`: 43, `end_line`: 55, `signature`: "def test_node_and_edge_records_carry_their_documented_minimum(mini_index):", `docstring`: "`export.FILE_NOTES` promises `id`/`type` on every node and\n    `src`/`dst`/`type` on every edge -- NodeRecord/EdgeRecord are `total=False`\n    (every field is type-specific), so this checks the one invariant that\n    actually holds for all of them rather than a TypedDict's required set.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_schema.py::test_every_emitted_node_and_edge_field_is_declared_in_schema"}) SET n += {`id`: "sym:tests/test_schema.py::test_every_emitted_node_and_edge_field_is_declared_in_schema", `name`: "test_every_emitted_node_and_edge_field_is_declared_in_schema", `qualname`: "test_every_emitted_node_and_edge_field_is_declared_in_schema", `kind`: "function", `path`: "tests/test_schema.py", `lang`: "python", `start_line`: 58, `end_line`: 92, `signature`: "def test_every_emitted_node_and_edge_field_is_declared_in_schema(mini_index):", `docstring`: "The direction the test above cannot see: a field emitted but undeclared.\n\n    `NodeRecord`/`EdgeRecord` are `total=False`, so `__required_keys__` is the\n    empty set and any \"does the record carry what we declared\" check is\n    vacuously true for them. That left the *other* drift undetected, and it had\n    accumulated: `start_line`, `end_line` and `signature` were emitted on every\n    symbol node and declared nowhere -- the three keys `impact.py` reads -- along\n    with `size`/`chunked`/`parse_errors`/`external` on nodes and the seven\n    resolution/inheritance fields on edges.\n\n    schema.py", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_schema.py::test_inherits_and_external_records_are_declared"}) SET n += {`id`: "sym:tests/test_schema.py::test_inherits_and_external_records_are_declared", `name`: "test_inherits_and_external_records_are_declared", `qualname`: "test_inherits_and_external_records_are_declared", `kind`: "function", `path`: "tests/test_schema.py", `lang`: "python", `start_line`: 95, `end_line`: 155, `signature`: "def test_inherits_and_external_records_are_declared(tmp_path):", `docstring`: "The edge and node types `mini_index` never produces.\n\n    `mini_repo` has no class hierarchy and no call out of the tree, so the drift\n    check above never sees an `INHERITS` edge (`raw_base`, `subtype`), a\n    `CALLS_EXTERNAL` edge (`ambiguous`) or an `external` node -- 8 of the fields\n    this module declares. A drift detector blind to a third of the surface is the\n    kind of test that passes while the contract rots, so this builds a repo that\n    does emit them rather than asserting against the same narrow fixture twice.", `entrypoint`: true, `reach`: 440};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_schema.py::test_manifest_carries_every_required_schema_field"}) SET n += {`id`: "sym:tests/test_schema.py::test_manifest_carries_every_required_schema_field", `name`: "test_manifest_carries_every_required_schema_field", `qualname`: "test_manifest_carries_every_required_schema_field", `kind`: "function", `path`: "tests/test_schema.py", `lang`: "python", `start_line`: 158, `end_line`: 166, `signature`: "def test_manifest_carries_every_required_schema_field(mini_index):", `docstring`: "", `entrypoint`: true};
