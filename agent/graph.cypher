MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answer_limits.py::trickle"}) SET n += {`id`: "sym:tests/test_answer_limits.py::trickle", `name`: "trickle", `qualname`: "trickle", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 443, `end_line`: 448, `signature`: "def trickle(monkeypatch, body: bytes, block: int, seconds_per_read: float) -> TricklingResponse:", `docstring`: "Serve `body` slowly, with `answer`'s clock driven by the response itself."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answer_limits.py::test_a_trickling_provider_cannot_stream_forever"}) SET n += {`id`: "sym:tests/test_answer_limits.py::test_a_trickling_provider_cannot_stream_forever", `name`: "test_a_trickling_provider_cannot_stream_forever", `qualname`: "test_a_trickling_provider_cannot_stream_forever", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 451, `end_line`: 476, `signature`: "def test_a_trickling_provider_cannot_stream_forever(monkeypatch, capsys):", `docstring`: "Axis 3 (C26b): a slow stream is bounded by wall-clock time, not bytes.\n\n    Neither existing bound closes this. `MAX_ANSWER_BYTES` only fires once the\n    body is enormous, and this one is a few kilobytes. `HTTP_TIMEOUT` measures\n    the gap *between* reads and resets whenever a byte arrives, so a host that\n    sends a little, forever, never trips it. Before `MAX_ANSWER_SECONDS` the\n    call had no upper bound on its own duration at all.\n\n    The budget is the real `MAX_ANSWER_SECONDS`, not a shrunken one, so a\n    fixture that is merely short cannot pass this by accident.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answer_limits.py::test_a_prompt_stream_is_not_reported_as_timed_out"}) SET n += {`id`: "sym:tests/test_answer_limits.py::test_a_prompt_stream_is_not_reported_as_timed_out", `name`: "test_a_prompt_stream_is_not_reported_as_timed_out", `qualname`: "test_a_prompt_stream_is_not_reported_as_timed_out", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 479, `end_line`: 489, `signature`: "def test_a_prompt_stream_is_not_reported_as_timed_out(monkeypatch, capsys):", `docstring`: "The budget must not fire on a normal answer that simply took some time.", `entrypoint`: true};
