MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::build.names_home"}) SET n += {`id`: "sym:repo2graph/graph.py::build.names_home", `name`: "names_home", `qualname`: "build.names_home", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1940, `end_line`: 1954, `signature`: "def names_home(rel: str, cd: dict, cand: str) -> bool:", `docstring`: "Whether a call's receiver visibly names where `cand` lives.\n\n        `Util.remove()` -> a method of `Util`; `store.get()` with `store`\n        imported -> a function in `store.py`; `Config::get()` -> a `::` scope."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::build.tier3_imported"}) SET n += {`id`: "sym:repo2graph/graph.py::build.tier3_imported", `name`: "tier3_imported", `qualname`: "build.tier3_imported", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1956, `end_line`: 1967, `signature`: "def tier3_imported(rel: str, callee: str, all_cands: list[str]) -> tuple[list[str], str]:", `docstring`: "Candidates reachable through `rel`'s own imports, and how they matched."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::mark_entrypoints"}) SET n += {`id`: "sym:repo2graph/graph.py::mark_entrypoints", `name`: "mark_entrypoints", `qualname`: "mark_entrypoints", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 2285, `end_line`: 2329, `signature`: "def mark_entrypoints(g: Graph):", `docstring`: "Flag the call-graph roots: symbols nothing else in the repo calls.\n\n    Those are the doors into a codebase \u2014 CLI commands, request handlers, test\n    bodies, public API \u2014 and they are where a reader tracing a flow has to\n    start. A symbol nested inside a function is skipped: an uncalled closure is\n    dead weight, not a door. `reach` (how many symbols the root can reach\n    through CALLS) is filled in for the busiest roots only, so ranking them\n    stays cheap on a big repo."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_reach"}) SET n += {`id`: "sym:repo2graph/graph.py::_reach", `name`: "_reach", `qualname`: "_reach", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 2332, `end_line`: 2340, `signature`: "def _reach(start: str, out: dict) -> int:", `docstring`: "How many distinct symbols `start` reaches through CALLS edges."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_read_capped"}) SET n += {`id`: "sym:repo2graph/graph.py::_read_capped", `name`: "_read_capped", `qualname`: "_read_capped", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 2343, `end_line`: 2356, `signature`: "def _read_capped(stream, limit: int) -> tuple[bytes, bool]:", `docstring`: "Read at most `limit` bytes from `stream`, and report whether there were more.\n\n    Reads one byte past the cap deliberately: that byte is the only way to tell\n    \"the output was exactly `limit` bytes\" from \"the output was larger and we\n    stopped early\" without reading the rest of it."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_reap_child"}) SET n += {`id`: "sym:repo2graph/graph.py::_reap_child", `name`: "_reap_child", `qualname`: "_reap_child", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 2359, `end_line`: 2382, `signature`: "def _reap_child(proc, reader=None) -> None:", `docstring`: "Kill a child, let go of its pipe and collect its exit status.\n\n    Order matters. The child is killed *first*: a reader parked in read() only\n    comes back when the write end disappears, and closing the read end out from\n    under it is unsafe on both platforms. Every step is best-effort -- a build\n    must not fail because a doomed `git log` was slow to die."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::add_cochange"}) SET n += {`id`: "sym:repo2graph/graph.py::add_cochange", `name`: "add_cochange", `qualname`: "add_cochange", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 2389, `end_line`: 2517, `signature`: "def add_cochange(g: Graph, root: Path, commits: int, file_index: set[str], min_pairs: int = 3):", `docstring`: "CO_CHANGE edges from files edited together in the last N commits.\n\n    Formula and semantics:\n    - History depth: Scans up to `commits` commits (capped at MAX_COCHANGE_COMMITS = 5000).\n    - Merge handling: `--no-merges` skips merge commits to avoid false co-change correlations.\n    - Noise filter: Commits touching > 25 files are skipped as bulk refactors/noise.\n    - Path filtering: Only paths matching `file_index` (current indexed tree) are paired.\n    - Pair counting: Each commit touching 2..25 files increments pair count by +1 for all pairs.\n    - Threshold: Emits an edge if pair count >="};
