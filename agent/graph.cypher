MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_add_cochange_splits_git_log_on_newline_only"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_add_cochange_splits_git_log_on_newline_only", `name`: "test_add_cochange_splits_git_log_on_newline_only", `qualname`: "test_add_cochange_splits_git_log_on_newline_only", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1360, `end_line`: 1374, `signature`: "def test_add_cochange_splits_git_log_on_newline_only(monkeypatch):", `docstring`: "Verify add_cochange must split\n    `git log` output on \"\\\\n\" only. With core.quotepath=false git emits a path\n    containing a raw U+2028; str.splitlines() would cut that path in two so\n    neither fragment matches file_index and the CO_CHANGE edge vanishes.", `entrypoint`: true, `reach`: 166};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_graphml_roundtrips_with_a_control_char"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_graphml_roundtrips_with_a_control_char", `name`: "test_graphml_roundtrips_with_a_control_char", `qualname`: "test_graphml_roundtrips_with_a_control_char", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1377, `end_line`: 1403, `signature`: "def test_graphml_roundtrips_with_a_control_char(tmp_path):", `docstring`: "Verify a C0 control char inside a docstring must not make the\n    GraphML unparseable. stdlib only, never skipped. Currently, ElementTree writes\n    the raw \\\\x0c and ET.parse raises ParseError.", `entrypoint`: true};
