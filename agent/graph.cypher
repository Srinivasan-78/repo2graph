MERGE (n:R2G:`Symbol` {id: "sym:.github/scripts/summary.py::load_stats"}) SET n += {`id`: "sym:.github/scripts/summary.py::load_stats", `name`: "load_stats", `qualname`: "load_stats", `kind`: "function", `path`: ".github/scripts/summary.py", `lang`: "python", `start_line`: 44, `end_line`: 54, `signature`: "def load_stats(path: str) -> tuple[dict, bool]:", `docstring`: "Return (stats dict, ok). ok is False if the file is missing/unreadable\n    /not valid JSON/not a JSON object -- the caller uses that to tell \"loaded\n    but genuinely has no data\" apart from \"could not be read at all\"."};
MERGE (n:R2G:`Symbol` {id: "sym:.github/scripts/summary.py::read_jsonl"}) SET n += {`id`: "sym:.github/scripts/summary.py::read_jsonl", `name`: "read_jsonl", `qualname`: "read_jsonl", `kind`: "function", `path`: ".github/scripts/summary.py", `lang`: "python", `start_line`: 57, `end_line`: 73, `signature`: "def read_jsonl(path: str):", `docstring`: "Yield decoded JSON objects from a JSONL file. A missing file yields\n    nothing; an unparsable line is skipped rather than aborting the read."};
MERGE (n:R2G:`Symbol` {id: "sym:.github/scripts/summary.py::_git_short_sha"}) SET n += {`id`: "sym:.github/scripts/summary.py::_git_short_sha", `name`: "_git_short_sha", `qualname`: "_git_short_sha", `kind`: "function", `path`: ".github/scripts/summary.py", `lang`: "python", `start_line`: 76, `end_line`: 97, `signature`: "def _git_short_sha(cwd: Path) -> str | None:", `docstring`: "Best-effort `git rev-parse --short HEAD`. None on any failure -- not a\n    git checkout, git missing, a timeout, or a non-zero exit.\n\n    Follows the repo's git-subprocess-decoding rule (CONTRIBUTING.md): no\n    text=True/encoding=, quotepath disabled, bytes decoded with\n    surrogateescape, and a timeout that turns into a plain failure rather\n    than a hang."};
MERGE (n:R2G:`Symbol` {id: "sym:.github/scripts/summary.py::counts_from_stats"}) SET n += {`id`: "sym:.github/scripts/summary.py::counts_from_stats", `name`: "counts_from_stats", `qualname`: "counts_from_stats", `kind`: "function", `path`: ".github/scripts/summary.py", `lang`: "python", `start_line`: 105, `end_line`: 122, `signature`: "def counts_from_stats(stats: dict, stats_ok: bool):", `docstring`: "(files, functions, classes, edges), each an int or None (\"N/A\").\n\n    None only when stats.json itself could not be loaded -- a key that is\n    simply absent from a successfully-loaded stats dict means a real zero\n    (e.g. a repo with no classes), not a missing value."};
