MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::cmd_github"}) SET n += {`id`: "sym:repo2graph/cli.py::cmd_github", `name`: "cmd_github", `qualname`: "cmd_github", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 232, `end_line`: 314, `signature`: "def cmd_github(args):", `docstring`: "", `entrypoint`: true, `reach`: 245};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_require_index"}) SET n += {`id`: "sym:repo2graph/cli.py::_require_index", `name`: "_require_index", `qualname`: "_require_index", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 317, `end_line`: 337, `signature`: "def _require_index(out: Path, name: str) -> Path:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_resolve_vectors"}) SET n += {`id`: "sym:repo2graph/cli.py::_resolve_vectors", `name`: "_resolve_vectors", `qualname`: "_resolve_vectors", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 340, `end_line`: 374, `signature`: "def _resolve_vectors(idx, args, out=None):", `docstring`: "(vectors, embedder) for a query, honouring --vectors / --no-vectors.\n\n    Dense fusion is **opt-in**. Without `--vectors` the ranking is lexical and\n    no embedder is constructed at all: building one loads sentence-transformers\n    and, on a cold cache, downloads ~90 MB of model weights. An unannounced\n    network fetch has no business on the default `query`/`rag` path, whose only\n    promised dependency is tree-sitter -- and an index is a shippable artifact,\n    so \"the index happens to carry vectors\" is not consent to go fetch a model.\n\n    `--vectors` is a demand: if the index has none, th"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::cmd_embed"}) SET n += {`id`: "sym:repo2graph/cli.py::cmd_embed", `name`: "cmd_embed", `qualname`: "cmd_embed", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 377, `end_line`: 450, `signature`: "def cmd_embed(args):", `docstring`: "Embed an index's chunks, reusing every vector whose text is unchanged.", `entrypoint`: true, `reach`: 96};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_reusable_vectors"}) SET n += {`id`: "sym:repo2graph/cli.py::_reusable_vectors", `name`: "_reusable_vectors", `qualname`: "_reusable_vectors", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 453, `end_line`: 475, `signature`: "def _reusable_vectors(npy: Path, model_id: str, hashes: dict) -> dict:", `docstring`: "Stored vectors whose chunk id *and* chunk text are both unchanged.\n\n    A chunk's vector depends on its own text and nothing else, so this is\n    correct by construction \u2014 unlike reusing anything that depends on the\n    graph, whose call confidences are global."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_validate_auto_build_out"}) SET n += {`id`: "sym:repo2graph/cli.py::_validate_auto_build_out", `name`: "_validate_auto_build_out", `qualname`: "_validate_auto_build_out", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 478, `end_line`: 501, `signature`: "def _validate_auto_build_out(out, repo_root) -> None:", `docstring`: "Harden an auto-build output directory, the way `build` hardens its `-o`.\n\n    `build` runs `validate_outdir` before it writes anything. The *implicit*\n    builds -- `rag <src>`'s and the MCP server's -- did\n    not, even though they finish at the same `dump_all`, whose directory swap\n    renames the target aside and then deletes it. `repo2graph rag . -o .`\n    therefore deleted the working tree.\n\n    No `force` parameter: `build --force` exists because a human typed both the\n    path and the override. Nothing is typed here, so there is no override to\n    honour -- the caller should run `build`"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_warn_exclude_secrets_deprecated"}) SET n += {`id`: "sym:repo2graph/cli.py::_warn_exclude_secrets_deprecated", `name`: "_warn_exclude_secrets_deprecated", `qualname`: "_warn_exclude_secrets_deprecated", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 504, `end_line`: 510, `signature`: "def _warn_exclude_secrets_deprecated(args) -> None:", `docstring`: "`--exclude-secrets` is accepted for compatibility; it is the default now."};
