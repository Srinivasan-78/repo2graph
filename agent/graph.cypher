MERGE (n:R2G:`Symbol` {id: "sym:tests/test_viz_safety.py::test_pointer_capture_is_released_on_both_pointerup_and_pointercancel"}) SET n += {`id`: "sym:tests/test_viz_safety.py::test_pointer_capture_is_released_on_both_pointerup_and_pointercancel", `name`: "test_pointer_capture_is_released_on_both_pointerup_and_pointercancel", `qualname`: "test_pointer_capture_is_released_on_both_pointerup_and_pointercancel", `kind`: "function", `path`: "tests/test_viz_safety.py", `lang`: "python", `start_line`: 193, `end_line`: 207, `signature`: "def test_pointer_capture_is_released_on_both_pointerup_and_pointercancel():", `docstring`: "A capture never released swallows every later pointer event on the page.\n\n    This is a source-level assertion rather than a DOM test: a real one needs a\n    JS runtime (jsdom or playwright), and this repo has no Node toolchain in its\n    dev extra. It pins the property that actually regressed -- a handler losing\n    its release call -- but it cannot prove the released id matches the captured\n    one. This is the one untested-in-a-browser property here.", `entrypoint`: true};
