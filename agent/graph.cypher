MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/viz.py::aggregate"}) SET n += {`id`: "sym:repo2graph/viz.py::aggregate", `name`: "aggregate", `qualname`: "aggregate", `kind`: "function", `path`: "repo2graph/viz.py", `lang`: "python", `start_line`: 258, `end_line`: 327, `signature`: "def aggregate(g: Any, max_dirs: int) -> dict[str, Any] | None:", `docstring`: "The summary view (#305): one node per directory group, relationships added up.\n\n    Every node in the graph is counted in exactly one group, so nothing is\n    sampled; see `_groups` for how the tree is cut. None when the result is a\n    single group, which summarises nothing."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/viz.py::payload"}) SET n += {`id`: "sym:repo2graph/viz.py::payload", `name`: "payload", `qualname`: "payload", `kind`: "function", `path`: "repo2graph/viz.py", `lang`: "python", `start_line`: 330, `end_line`: 383, `signature`: "def payload(\n    g: Any, max_nodes: int | None = MAX_NODES, shrunk_from: int | None = None\n) -> dict[str, Any]:", `docstring`: "The JSON the page draws: nodes, edges by index, legend counts.\n\n    When the cap leaves nodes out, it also carries `sampled` (what was left\n    out and why, for the page's banner) and, where the tree has more than one\n    directory, `dirs`: the directory summary every node is counted in."};
