MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::import_targets"}) SET n += {`id`: "sym:repo2graph/graph.py::import_targets", `name`: "import_targets", `qualname`: "import_targets", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 203, `end_line`: 263, `signature`: "def import_targets(raw: str, lang: str) -> list[str]:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::path_index"}) SET n += {`id`: "sym:repo2graph/graph.py::path_index", `name`: "path_index", `qualname`: "path_index", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 266, `end_line`: 279, `signature`: "def path_index(file_index) -> dict:", `docstring`: "Lookup tables so import resolution never rescans the whole file list.\n\n    by_name: basename -> sorted paths.  by_dir: directory -> sorted paths.\n    Sorted so a repo with several same-named files resolves deterministically."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::resolve_import"}) SET n += {`id`: "sym:repo2graph/graph.py::resolve_import", `name`: "resolve_import", `qualname`: "resolve_import", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 282, `end_line`: 547, `signature`: "def resolve_import(\n    target: str, from_path: str, lang: str, file_index: set[str], ctx: dict | None = None\n) -> str | None:", `docstring`: "Map an import target to an in-repo file path when possible."};
