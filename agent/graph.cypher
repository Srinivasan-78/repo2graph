MERGE (n:R2G:`Symbol` {id: "sym:scripts/generate_examples.py::clone_scoped"}) SET n += {`id`: "sym:scripts/generate_examples.py::clone_scoped", `name`: "clone_scoped", `qualname`: "clone_scoped", `kind`: "function", `path`: "scripts/generate_examples.py", `lang`: "python", `start_line`: 104, `end_line`: 128, `signature`: "def clone_scoped(entry: dict, dest: Path) -> str:", `docstring`: "Clone entry['url']@entry['ref'] into dest. Returns the checked-out commit SHA.\n\n    Only ever runs: clone (--filter=blob:none, optionally --depth), sparse-checkout\n    set, checkout. No submodules, no hooks (clone-triggered hooks do not exist;\n    none are ever invoked), no build/test/install commands \u2014 that is the whole\n    contract of \"treat the target repository as untrusted input\" from\n    docs/benchmarks.md."};
MERGE (n:R2G:`Symbol` {id: "sym:scripts/generate_examples.py::run_queries"}) SET n += {`id`: "sym:scripts/generate_examples.py::run_queries", `name`: "run_queries", `qualname`: "run_queries", `kind`: "function", `path`: "scripts/generate_examples.py", `lang`: "python", `start_line`: 131, `end_line`: 160, `signature`: "def run_queries(index_dir: Path, queries: list[str]) -> list[dict]:", `docstring`: "Real repo2graph.query.Index.retrieve() calls against the just-built index.\n\n    Runs while the index (including chunks.jsonl) still exists in the scratch\n    workdir. Each flow keeps only the fields a citation needs \u2014 node id, path,\n    line range, symbol name and the reason it was pulled in \u2014 never the chunk's\n    `text`, so no source excerpt survives into the committed flow file."};
