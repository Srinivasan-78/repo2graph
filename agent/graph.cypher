MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_ac31_tool_descriptions_stay_under_budget"}) SET n += {`id`: "sym:tests/test_mcp.py::test_ac31_tool_descriptions_stay_under_budget", `name`: "test_ac31_tool_descriptions_stay_under_budget", `qualname`: "test_ac31_tool_descriptions_stay_under_budget", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 213, `end_line`: 236, `signature`: "def test_ac31_tool_descriptions_stay_under_budget():", `docstring`: "AC-31: the published tool set, capped under 2500 characters (~500 tokens).\n\n    The character budget balances agent context overhead against Glama TDQS\n    (Tool Definition Quality Standard) requirements. Tool descriptions are loaded\n    into every agent's context every turn, so they must stay tightly bounded;\n    however, they must also provide explicit usage guidance, sibling disambiguation,\n    and safety disclosures.", `entrypoint`: true};
