MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_protocol_version_matches_what_this_transport_implements"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_protocol_version_matches_what_this_transport_implements", `name`: "test_protocol_version_matches_what_this_transport_implements", `qualname`: "test_protocol_version_matches_what_this_transport_implements", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 98, `end_line`: 111, `signature`: "def test_protocol_version_matches_what_this_transport_implements(make_server):", `docstring`: "#390: advertise the revision whose semantics are actually served.\n\n    Pinned as a literal, not compared against the module constant the\n    implementation itself uses -- `AGENTS.md`'s \"never compare the\n    implementation to itself\" rule. This transport is plain JSON-RPC\n    request/response over POST (Content-Length framing, HTTP/1.0,\n    connection-close, no SSE, no Mcp-Session-Id): `2024-11-05` is the\n    revision that describes, not `2025-06-18` (Streamable HTTP).", `entrypoint`: true};
