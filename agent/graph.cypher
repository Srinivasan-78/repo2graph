MERGE (n:R2G:`Symbol` {id: "sym:tests/test_incremental.py::test_incremental_preserves_import_alias_resolution"}) SET n += {`id`: "sym:tests/test_incremental.py::test_incremental_preserves_import_alias_resolution", `name`: "test_incremental_preserves_import_alias_resolution", `qualname`: "test_incremental_preserves_import_alias_resolution", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 450, `end_line`: 469, `signature`: "def test_incremental_preserves_import_alias_resolution(tmp_path):", `docstring`: "An aliased import resolves identically on a cached rebuild.\n\n    `import_details` was not persisted in the parse cache, so a cache hit lost\n    every alias and the full build's `import_alias` edge came back as\n    `CALLS_EXTERNAL` / `unresolved_external`.\n\n    The module's headline byte-equality test cannot see this: a *plain*\n    `from x import y` still resolves through the IMPORTS edges, which are\n    rebuilt from `pf.imports`, and only the alias branch reads `import_details`.", `entrypoint`: true};
