MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_overview"}) SET n += {`id`: "sym:repo2graph/export.py::write_overview", `name`: "write_overview", `qualname`: "write_overview", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 564, `end_line`: 618, `signature`: "def write_overview(g: \"Graph\", path: Path, top: int = 25) -> None:", `docstring`: "Write human/LLM-readable repo map highlighting hub files and entry points.\n\n    Args:\n        g: Graph instance containing parsed nodes and edges.\n        path: File path for overview markdown output.\n        top: Maximum number of hub files and symbols to list."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_git_short_sha"}) SET n += {`id`: "sym:repo2graph/export.py::_git_short_sha", `name`: "_git_short_sha", `qualname`: "_git_short_sha", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 621, `end_line`: 636, `signature`: "def _git_short_sha(root: Path | str) -> str | None:", `docstring`: "Get the short git commit SHA at the repository root.\n\n    Executes git rev-parse with safe subprocess decoding and bounded timeout.\n    Returns None if not in a git repo or if git is unavailable.\n\n    Args:\n        root: Root path of the repository.\n\n    Returns:\n        Short commit SHA string, or None."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_overview_human"}) SET n += {`id`: "sym:repo2graph/export.py::write_overview_human", `name`: "write_overview_human", `qualname`: "write_overview_human", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 652, `end_line`: 765, `signature`: "def write_overview_human(g: \"Graph\", path: Path, top: int = 25) -> None:", `docstring`: "Write structured markdown repo overview for human inspection.\n\n    Reads edge-type and symbol-kind counts directly from graph stats\n    for consistent reporting.\n\n    Args:\n        g: Graph instance containing parsed nodes, edges, and statistics.\n        path: File path for human overview markdown output.\n        top: Maximum number of top-connected files to display."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_fanout"}) SET n += {`id`: "sym:repo2graph/export.py::_fanout", `name`: "_fanout", `qualname`: "_fanout", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 900, `end_line`: 910, `signature`: "def _fanout(text: str, max_call_candidates: int) -> str:", `docstring`: "Substitute a build's fan-out limit into one manifest prose template.\n\n    `str.replace`, not `str.format`: these are prose strings that an editor may\n    well one day want a literal brace in (a JSON snippet, a dict example), and\n    `format` would raise KeyError on it here -- turning a typo in documentation\n    copy into a failed build. A template that loses its `{n}` degrades to a\n    sentence with no number, which the top-level `max_call_candidates` key\n    still answers."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_manifest"}) SET n += {`id`: "sym:repo2graph/export.py::write_manifest", `name`: "write_manifest", `qualname`: "write_manifest", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 913, `end_line`: 1074, `signature`: "def write_manifest(\n    g: Any, path: Path, written: list[str], *, checksums: dict[str, Any] | None = None\n) -> None:", `docstring`: "Write manifest.json describing index metadata, schemas, and statistics.\n\n    Args:\n        g: Graph instance or duck-typed object carrying nodes and stats.\n        path: Target file path for the manifest.\n        written: List of relative artifact paths generated during export.\n        checksums: Optional mapping of relative artifact paths to SHA-256 hashes."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_stats_extra"}) SET n += {`id`: "sym:repo2graph/export.py::_stats_extra", `name`: "_stats_extra", `qualname`: "_stats_extra", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1082, `end_line`: 1141, `signature`: "def _stats_extra(g: \"Graph\") -> dict[str, Any]:", `docstring`: "Additive stats.json fields, computed live from `g` at write time.\n\n    Never re-read from nodes.jsonl/edges.jsonl -- dump_all always has the\n    Graph in memory here, and re-deriving from the files it is about to write\n    would be a circular dependency for no reason."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_mark_has_vectors"}) SET n += {`id`: "sym:repo2graph/export.py::_mark_has_vectors", `name`: "_mark_has_vectors", `qualname`: "_mark_has_vectors", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1144, `end_line`: 1161, `signature`: "def _mark_has_vectors(outdir: Path | str) -> None:", `docstring`: "Flip stats.json's has_vectors to True after `embed` writes vectors.npy.\n\n    Best-effort, same as register_written: a missing or unreadable stats.json\n    (e.g. a fixture built with --formats that never writes one) is not\n    embed's problem to fix, so any failure here is silently skipped."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::register_written"}) SET n += {`id`: "sym:repo2graph/export.py::register_written", `name`: "register_written", `qualname`: "register_written", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1164, `end_line`: 1206, `signature`: "def register_written(outdir: Path | str, names: Iterable[str]) -> bool:", `docstring`: "Merge `names` into an existing manifest's `written`, `files`, and `checksums`.\n\n    `embed` runs after `build` as a separate command, so it must append to the\n    manifest dump_all already wrote rather than rewrite it: every other key --\n    counts, entrypoints, how_to_read -- is left exactly as it was. Returns\n    False when there is no readable manifest to append to."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_state"}) SET n += {`id`: "sym:repo2graph/export.py::write_state", `name`: "write_state", `qualname`: "write_state", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1209, `end_line`: 1235, `signature`: "def write_state(g: \"Graph\", path: Path, n_chunks: int) -> None:", `docstring`: "The per-file content hashes a later incremental build reads back.\n\n    `filters` records the discovery filters this build used. Anything that\n    re-runs discovery to compare the tree against the index -- `index-status`,\n    `doctor`'s freshness check -- must apply the same ones, or a build with\n    any `--exclude` reports every deliberately excluded file as newly added\n    and therefore reads as permanently stale."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_parse_cache"}) SET n += {`id`: "sym:repo2graph/export.py::write_parse_cache", `name`: "write_parse_cache", `qualname`: "write_parse_cache", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1238, `end_line`: 1258, `signature`: "def write_parse_cache(g: \"Graph\", path: Path) -> None:", `docstring`: "Write the per-file parse cache the next `--incremental` build reads.\n\n    Args:\n        g: The Graph just built; its `parse_cache` is the payload.\n        path: Destination for `parse.cache.json`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::load_parse_cache"}) SET n += {`id`: "sym:repo2graph/export.py::load_parse_cache", `name`: "load_parse_cache", `qualname`: "load_parse_cache", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1261, `end_line`: 1311, `signature`: "def load_parse_cache(outdir: Path) -> dict[str, Any]:", `docstring`: "Read a previous build's parse cache out of an index directory.\n\n    Every failure mode -- no index, no cache file, unreadable, malformed JSON,\n    a format bump, a grammar upgrade -- returns an empty dict, which makes the\n    next build a full one. An incremental build that silently reuses entries it\n    does not understand is the failure this whole feature was deferred to avoid,\n    so the only safe response to an unrecognised cache is to ignore it.\n\n    The grammar check is the one that does not depend on anyone remembering to\n    bump a constant: `PARSE_CACHE_FORMAT` tracks changes to our o"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_atomic_dir_swap"}) SET n += {`id`: "sym:repo2graph/export.py::_atomic_dir_swap", `name`: "_atomic_dir_swap", `qualname`: "_atomic_dir_swap", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1314, `end_line`: 1346, `signature`: "def _atomic_dir_swap(staging: Path, target: Path) -> None:", `docstring`: "Atomically replace target directory with staging directory.\n\n    On Windows, os.replace doesn't work for non-empty directories, so we use\n    a rename dance: target -> backup, staging -> target, then remove backup.\n    If the staging rename fails, we restore the backup."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_local"}) SET n += {`id`: "sym:repo2graph/export.py::write_local", `name`: "write_local", `qualname`: "write_local", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1358, `end_line`: 1386, `signature`: "def write_local(g: Any, index_root: Path) -> None:", `docstring`: "Write machine-local build metadata and ignore file to index root.\n\n    Args:\n        g: Graph instance or object with root/source_remote attributes.\n        index_root: Destination root directory of the index."};
