MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::NodeRecord"}) SET n += {`id`: "sym:repo2graph/schema.py::NodeRecord", `name`: "NodeRecord", `qualname`: "NodeRecord", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 72, `end_line`: 106, `signature`: "class NodeRecord(TypedDict, total=False):", `docstring`: "One line of `nodes.jsonl`. Only `id` and `type` are on every node \u2014\n    see `export.FILE_NOTES[\"nodes.jsonl\"]`, which says the same thing."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::EdgeRecord"}) SET n += {`id`: "sym:repo2graph/schema.py::EdgeRecord", `name`: "EdgeRecord", `qualname`: "EdgeRecord", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 109, `end_line`: 152, `signature`: "class EdgeRecord(TypedDict, total=False):", `docstring`: "One line of `edges.jsonl`.\n\n    `src`/`dst`/`type` are on every edge, and so are `method`, `confidence` and\n    `evidence` \u2014 `Graph.add_edge` runs every edge through `edgemeta.normalize`,\n    which is the chokepoint that makes those three unconditional (see the\n    .github/CONTRIBUTING.md rule on edge evidence). `evidence: None` is a real answer for\n    `CONTAINS` and `CO_CHANGE` rather than a missing value.\n\n    Everything below that is edge-type-specific \u2014 see `export.EDGE_TYPES` for\n    which type carries what: `IMPORTS` carries `target`/`internal`, `CALLS` and\n    `CALLS_EXTERNAL` carry th"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::_NeighbourEdgeRequired"}) SET n += {`id`: "sym:repo2graph/schema.py::_NeighbourEdgeRequired", `name`: "_NeighbourEdgeRequired", `qualname`: "_NeighbourEdgeRequired", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 155, `end_line`: 158, `signature`: "class _NeighbourEdgeRequired(TypedDict):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::NeighbourEdge"}) SET n += {`id`: "sym:repo2graph/schema.py::NeighbourEdge", `name`: "NeighbourEdge", `qualname`: "NeighbourEdge", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 161, `end_line`: 169, `signature`: "class NeighbourEdge(_NeighbourEdgeRequired, total=False):", `docstring`: "One entry of a chunk's `caller_edges`/`callee_edges`/`base_edges` \u2014\n    see `chunks._neighbour_edge`. `confidence` is present only when the edge\n    is an ambiguous `CALLS` edge scoring below 1.0; `IMPORTS`/`DEFINES`/\n    `INHERITS` neighbours never carry it (they have no `confidence` key to\n    read in the first place \u2014 see the `min_confidence` note in .github/CONTRIBUTING.md)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::ChunkSplit"}) SET n += {`id`: "sym:repo2graph/schema.py::ChunkSplit", `name`: "ChunkSplit", `qualname`: "ChunkSplit", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 172, `end_line`: 177, `signature`: "class ChunkSplit(TypedDict):", `docstring`: "Where a part sits when one symbol was too large for one chunk."};
