MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/tasks.py::TaskManager.start"}) SET n += {`id`: "sym:repo2graph/tasks.py::TaskManager.start", `name`: "start", `qualname`: "TaskManager.start", `kind`: "function", `path`: "repo2graph/tasks.py", `lang`: "python", `start_line`: 134, `end_line`: 162, `signature`: "def start(self, repo: str | Path, out: str | Path) -> BuildTask:", `docstring`: "Begin (or join) a background build for `out`.\n\n        Args:\n            repo: Repository to index.\n            out: Index directory to write.\n\n        Returns:\n            The task covering this build, new or already running.", `entrypoint`: true, `reach`: 20};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/tasks.py::TaskManager._evict_locked"}) SET n += {`id`: "sym:repo2graph/tasks.py::TaskManager._evict_locked", `name`: "_evict_locked", `qualname`: "TaskManager._evict_locked", `kind`: "function", `path`: "repo2graph/tasks.py", `lang`: "python", `start_line`: 164, `end_line`: 180, `signature`: "def _evict_locked(self) -> None:", `docstring`: "Drop the oldest finished tasks once `_by_id` exceeds MAX_TRACKED_TASKS.\n        Caller must hold self._lock.\n\n        A task still BUILDING is skipped rather than evicted -- an in-flight\n        build must always remain pollable -- so if enough builds are running\n        concurrently, `_by_id` can briefly stay above the cap; it shrinks back\n        as soon as those tasks finish and a new one triggers eviction again."};
