MERGE (n:R2G:`Symbol` {id: "sym:tests/test_alias_seeds.py::test_the_fixture_indexes_an_alias"}) SET n += {`id`: "sym:tests/test_alias_seeds.py::test_the_fixture_indexes_an_alias", `name`: "test_the_fixture_indexes_an_alias", `qualname`: "test_the_fixture_indexes_an_alias", `kind`: "function", `path`: "tests/test_alias_seeds.py", `lang`: "python", `start_line`: 82, `end_line`: 85, `signature`: "def test_the_fixture_indexes_an_alias(alias_index: Index) -> None:", `docstring`: "Guard the fixture: no alias chunk makes every assertion below vacuous.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_alias_seeds.py::test_an_alias_never_becomes_a_seed"}) SET n += {`id`: "sym:tests/test_alias_seeds.py::test_an_alias_never_becomes_a_seed", `name`: "test_an_alias_never_becomes_a_seed", `qualname`: "test_an_alias_never_becomes_a_seed", `kind`: "function", `path`: "tests/test_alias_seeds.py", `lang`: "python", `start_line`: 88, `end_line`: 101, `signature`: "def test_an_alias_never_becomes_a_seed(alias_index: Index) -> None:", `docstring`: "The mechanism, at the one place it is applied.\n\n    Asserted across budgets because the defect was budget-dependent: the alias\n    took its slot at a *small* budget, where better seeds had been rejected.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_alias_seeds.py::test_an_alias_still_scores_in_the_ranking"}) SET n += {`id`: "sym:tests/test_alias_seeds.py::test_an_alias_still_scores_in_the_ranking", `name`: "test_an_alias_still_scores_in_the_ranking", `qualname`: "test_an_alias_still_scores_in_the_ranking", `kind`: "function", `path`: "tests/test_alias_seeds.py", `lang`: "python", `start_line`: 104, `end_line`: 113, `signature`: "def test_an_alias_still_scores_in_the_ranking(alias_index: Index) -> None:", `docstring`: "The skip is in seed selection only -- the ranking is left intact.\n\n    If the alias stopped scoring, the skip would be hiding a ranking change,\n    and a question whose answer really is the rename would have nothing to find.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_alias_seeds.py::test_retrieve_still_returns_aliases"}) SET n += {`id`: "sym:tests/test_alias_seeds.py::test_retrieve_still_returns_aliases", `name`: "test_retrieve_still_returns_aliases", `qualname`: "test_retrieve_still_returns_aliases", `kind`: "function", `path`: "tests/test_alias_seeds.py", `lang`: "python", `start_line`: 116, `end_line`: 124, `signature`: "def test_retrieve_still_returns_aliases(alias_index: Index) -> None:", `docstring`: "`repo2graph query` must keep returning what it always has.\n\n    `retrieve()` is that command's path. Narrowing it would change documented\n    output for every user, and the skip is deliberately not applied there.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_alias_seeds.py::test_the_skip_does_not_consume_the_node"}) SET n += {`id`: "sym:tests/test_alias_seeds.py::test_the_skip_does_not_consume_the_node", `name`: "test_the_skip_does_not_consume_the_node", `qualname`: "test_the_skip_does_not_consume_the_node", `kind`: "function", `path`: "tests/test_alias_seeds.py", `lang`: "python", `start_line`: 127, `end_line`: 150, `signature`: "def test_the_skip_does_not_consume_the_node(alias_index: Index) -> None:", `docstring`: "Skipping an alias as a seed must leave it available to expansion.\n\n    This is the half that makes D7 worth anything: the alias is how a caller of\n    the public name reaches the private implementation, and it arrives as a\n    graph neighbour. Marking it seen in the seed loop would silently delete\n    that path, and the retrieval benchmark would lose the point it just gained.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_alias_seeds.py::test_non_alias_seeds_are_unaffected"}) SET n += {`id`: "sym:tests/test_alias_seeds.py::test_non_alias_seeds_are_unaffected", `name`: "test_non_alias_seeds_are_unaffected", `qualname`: "test_non_alias_seeds_are_unaffected", `kind`: "function", `path`: "tests/test_alias_seeds.py", `lang`: "python", `start_line`: 153, `end_line`: 158, `signature`: "def test_non_alias_seeds_are_unaffected(alias_index: Index) -> None:", `docstring`: "Real definitions must still seed exactly as before.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_alias_seeds.py::test_an_alias_is_never_name_boosted"}) SET n += {`id`: "sym:tests/test_alias_seeds.py::test_an_alias_is_never_name_boosted", `name`: "test_an_alias_is_never_name_boosted", `qualname`: "test_an_alias_is_never_name_boosted", `kind`: "function", `path`: "tests/test_alias_seeds.py", `lang`: "python", `start_line`: 161, `end_line`: 182, `signature`: "def test_an_alias_is_never_name_boosted(alias_index: Index) -> None:", `docstring`: "Found by merging the alias skip with answerability re-ranking.\n\n    An alias is *nothing but* a name, so it collects `NAME_TERM_BOOST` more\n    reliably than any real definition can: here its name is literally the\n    query's strongest term. The seed loop skips aliases, so a boosted alias\n    cannot reach a pack -- but the re-rank window is `k * 3`, and an alias\n    hauled up it pushes a real candidate out. That is the one way an alias can\n    still cost an answer after being made unseedable.", `entrypoint`: true};
