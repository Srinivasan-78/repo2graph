MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::ChunkedParsedFile"}) SET n += {`id`: "sym:repo2graph/graph.py::ChunkedParsedFile", `name`: "ChunkedParsedFile", `qualname`: "ChunkedParsedFile", `kind`: "class", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 847, `end_line`: 856, `signature`: "class ChunkedParsedFile(ParsedFile):", `docstring`: "What `_chunk_and_parse` produces: a `ParsedFile` plus what it could not read.\n\n    `undecodable_slices` does not belong on `ParsedFile` itself -- it is\n    meaningless for the whole-file reader, which either decodes a file or does\n    not. Every reader of the field uses `getattr(pf, ..., 0)`, the same way\n    `build()` already reads `is_chunked` and `used_cpp`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_incomplete_utf8_tail"}) SET n += {`id`: "sym:repo2graph/graph.py::_incomplete_utf8_tail", `name`: "_incomplete_utf8_tail", `qualname`: "_incomplete_utf8_tail", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 864, `end_line`: 889, `signature`: "def _incomplete_utf8_tail(buf: bytes) -> int:", `docstring`: "Length of the *truncated* UTF-8 sequence at the end of `buf`, else 0.\n\n    Slices are taken at raw byte offsets, so a multi-byte character can\n    straddle a boundary -- its lead byte ends slice N and its continuation bytes\n    begin slice N+1. Both then fail to decode and *both* were dropped, losing up\n    to 2 x max_file_bytes of source with nothing recording it. Reporting the\n    length of the dangling prefix lets the caller carry those bytes into the next\n    slice so the boundary lands on a character boundary instead.\n\n    Only a genuinely truncated sequence counts. A complete character, "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_chunk_and_parse"}) SET n += {`id`: "sym:repo2graph/graph.py::_chunk_and_parse", `name`: "_chunk_and_parse", `qualname`: "_chunk_and_parse", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 892, `end_line`: 1041, `signature`: "def _chunk_and_parse(rel, abspath, lang, config, size):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_safe_read_bytes"}) SET n += {`id`: "sym:repo2graph/graph.py::_safe_read_bytes", `name`: "_safe_read_bytes", `qualname`: "_safe_read_bytes", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1047, `end_line`: 1070, `signature`: "def _safe_read_bytes(path: Path) -> bytes:", `docstring`: "Read file bytes using O_NOFOLLOW where supported to avoid symlink TOCTOU races.\n\n    On POSIX systems, O_NOFOLLOW causes open() to fail if the trailing component is a\n    symlink (protecting against an attacker replacing a discovered regular file with a\n    symlink to a sensitive file before open). On Windows, O_NOFOLLOW is not supported\n    by the OS open(), so standard read flags are used."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_safe_open"}) SET n += {`id`: "sym:repo2graph/graph.py::_safe_open", `name`: "_safe_open", `qualname`: "_safe_open", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1073, `end_line`: 1093, `signature`: "def _safe_open(path: Path, mode: str = \"rb\"):", `docstring`: "Open a file with O_NOFOLLOW where supported.\n\n    Like _safe_read_bytes, but returns a file object for chunked reading\n    (used by _chunk_and_parse for files larger than config.max_file_bytes)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_redact_metadata"}) SET n += {`id`: "sym:repo2graph/graph.py::_redact_metadata", `name`: "_redact_metadata", `qualname`: "_redact_metadata", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1096, `end_line`: 1115, `signature`: "def _redact_metadata(text: str, g) -> str:", `docstring`: "Redact secrets in a signature or docstring before it enters the graph.\n\n    These two fields are copied into chunk headers, `nodes.jsonl`, `graph.html`,\n    GraphML and Cypher without passing through the chunk-body scan, so this is\n    the one place that covers every consumer. `warn-only` and `off` deliberately\n    leave the text alone, matching what those policies mean for chunk bodies --\n    `Index._served` is the serve-time net for them."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_read_and_parse"}) SET n += {`id`: "sym:repo2graph/graph.py::_read_and_parse", `name`: "_read_and_parse", `qualname`: "_read_and_parse", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1118, `end_line`: 1167, `signature`: "def _read_and_parse(item):", `docstring`: "Read one file and parse it if it is code.\n\n    Top level, and returns only counts plus the ParsedFile, so a process pool\n    can pickle both the call and its result. The fourth element of the read\n    tuple is the sha256 of the bytes just parsed: it is computed here because\n    this is the only place that holds them, and build() never keeps them."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_last_segment"}) SET n += {`id`: "sym:repo2graph/graph.py::_last_segment", `name`: "_last_segment", `qualname`: "_last_segment", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1220, `end_line`: 1222, `signature`: "def _last_segment(name: str) -> str:", `docstring`: "`pkg.mod.Base` / `ns::Base` / `Base<T>` -> `Base`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::cache_entry"}) SET n += {`id`: "sym:repo2graph/graph.py::cache_entry", `name`: "cache_entry", `qualname`: "cache_entry", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1225, `end_line`: 1267, `signature`: "def cache_entry(lang: str | None, size: int, lines: int, pf, digest: str) -> dict:", `docstring`: "Serialise one file's parse result for `parse.cache.json`.\n\n    Args:\n        lang: Language id the file was parsed as, or None for a non-code file.\n        size: Length in bytes of the file as indexed.\n        lines: Newline count + 1, as recorded on the file node.\n        pf: The `ParsedFile` for this file, or None if it was not parsed.\n        digest: sha256 hex digest of the bytes this entry describes.\n\n    Returns:\n        A JSON-serialisable dict holding everything `build()` needs to rebuild\n        this file's nodes and edges without re-reading or re-parsing it."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::entry_read"}) SET n += {`id`: "sym:repo2graph/graph.py::entry_read", `name`: "entry_read", `qualname`: "entry_read", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1270, `end_line`: 1321, `signature`: "def entry_read(entry: dict) -> tuple | None:", `docstring`: "Rebuild `_read_and_parse`'s result tuple from a cache entry.\n\n    Args:\n        entry: One record out of `parse.cache.json`.\n\n    Returns:\n        The `(size, lines, ParsedFile | None, digest)` tuple the build loop\n        consumes, or None if the entry is malformed. A malformed entry is a\n        cache miss, never an exception: a corrupt cache must cost a re-parse,\n        not the build."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::parse_incremental"}) SET n += {`id`: "sym:repo2graph/graph.py::parse_incremental", `name`: "parse_incremental", `qualname`: "parse_incremental", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1324, `end_line`: 1382, `signature`: "def parse_incremental(files, jobs: int, cache: dict, counts: dict, config=None):", `docstring`: "Read every file, but re-parse only the ones whose bytes changed.\n\n    A file's `ParsedFile` is a pure function of its bytes and its language and\n    nothing else, so reusing one for a file whose sha256 still matches is exact\n    -- not an approximation. Everything downstream of parsing (the global name\n    index, CALLS confidences, INHERITS, entrypoints and reach) is then recomputed\n    from scratch over the full symbol set by `build()`, which is what makes an\n    incremental build byte-identical to a full one instead of merely close.\n\n    Reading is still done for every file: the hash *is* th"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::resolve_jobs"}) SET n += {`id`: "sym:repo2graph/graph.py::resolve_jobs", `name`: "resolve_jobs", `qualname`: "resolve_jobs", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1385, `end_line`: 1389, `signature`: "def resolve_jobs(jobs: int) -> int:", `docstring`: "0 means one worker per core, capped so the parent keeps up with results."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::silence_worker_io"}) SET n += {`id`: "sym:repo2graph/graph.py::silence_worker_io", `name`: "silence_worker_io", `qualname`: "silence_worker_io", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1402, `end_line`: 1457, `signature`: "def silence_worker_io() -> None:", `docstring`: "Detach a parse worker from the stdin/stdout it inherited (#90).\n\n    Runs as the `ProcessPoolExecutor` initializer, i.e. *inside* the worker and\n    once per worker. It exists because of who the parent may be: when the pool\n    is started from `repo2graph-mcp`, fd 0 and fd 1 are the client's JSON-RPC\n    pipes. Measured on Windows (spawn), a worker inherits both for real --\n    `os.write(1, ...)` lands in the parent's stdout pipe, and `os.read(0, 1)`\n    *consumes a byte of the client's request stream*, which is a request the\n    server then waits for forever. Parsing writes to neither today; ", `entrypoint`: true, `reach`: 6};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::parse_all"}) SET n += {`id`: "sym:repo2graph/graph.py::parse_all", `name`: "parse_all", `qualname`: "parse_all", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1460, `end_line`: 1498, `signature`: "def parse_all(files, jobs: int, config=None):", `docstring`: "Read and parse every file, in discovery order, across `jobs` processes.\n\n    tree-sitter parsing is CPU bound and dominates a large build, so this is\n    the difference between one core and all of them. Order is preserved, which\n    keeps node ids and edge order identical to a serial run.\n\n    Every worker runs `silence_worker_io` first, so the pool is safe to start\n    from a process whose stdin/stdout are a protocol stream rather than a\n    terminal -- which is what `repo2graph-mcp`'s auto-build is (#90)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_within_byte_budget"}) SET n += {`id`: "sym:repo2graph/graph.py::_within_byte_budget", `name`: "_within_byte_budget", `qualname`: "_within_byte_budget", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1501, `end_line`: 1542, `signature`: "def _within_byte_budget(files, budget: int, g: \"Graph\"):", `docstring`: "The leading files whose cumulative size fits in `budget` bytes.\n\n    Stops at the first file that would exceed the budget rather than skipping\n    it and continuing: skipping would make the selection depend on the sizes of\n    files *after* the one that did not fit, so inserting a large file in the\n    middle of a repository could silently change which small files at the end\n    were indexed. Stopping keeps the selection a prefix of the discovery order,\n    which is the property that makes it reproducible.\n\n    A single file larger than the whole budget therefore yields nothing, which\n    is c"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::build"}) SET n += {`id`: "sym:repo2graph/graph.py::build", `name`: "build", `qualname`: "build", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1546, `end_line`: 2278, `signature`: "def build(\n    root: Path,\n    include=None,\n    exclude=None,\n    git_history: int = 0,\n    max_files: int = 0,\n    jobs: int = 0,\n    cache: dict | None = None,\n    max_call_candidates: int = DEFAULT_MAX_CALL_CANDIDATES,\n    config=None,\n    cochange_min: int = 3,\n    max_bytes: int = 0,\n    max_e", `docstring`: "Parse `root` into a Graph.\n\n    Args:\n        root: Repository directory to index.\n        include: Optional glob(s) restricting discovery.\n        exclude: Optional glob(s) removing paths from discovery.\n        git_history: When non-zero, add CO_CHANGE edges from the last N commits.\n        max_files: When positive, index only the first N discovered files.\n        jobs: Parser processes; 0 means one per core, 1 means serial.\n        cache: A previous build's `{relpath: entry}` parse cache. When given,\n            files whose sha256 and language both still match are not re-parsed.\n           "};
