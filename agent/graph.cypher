MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doctor.py::test_doctor_artifact_integrity_ignores_unrelated_agent_dir"}) SET n += {`id`: "sym:tests/test_doctor.py::test_doctor_artifact_integrity_ignores_unrelated_agent_dir", `name`: "test_doctor_artifact_integrity_ignores_unrelated_agent_dir", `qualname`: "test_doctor_artifact_integrity_ignores_unrelated_agent_dir", `kind`: "function", `path`: "tests/test_doctor.py", `lang`: "python", `start_line`: 152, `end_line`: 170, `signature`: "def test_doctor_artifact_integrity_ignores_unrelated_agent_dir(tmp_path):", `docstring`: "A top-level agent/ dir that isn't ours must not be treated as a\n    broken repo2graph index.\n\n    \"agent/\" and \"chunks.jsonl\" are generic names used by unrelated\n    projects (agent frameworks, ML repos with their own chunk files). Only\n    a directory carrying repo2graph's own manifest.json -- or a \".r2g\"\n    subdirectory, which nothing else names -- counts as ours.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doctor.py::test_doctor_artifact_integrity_still_catches_corrupt_dot_r2g"}) SET n += {`id`: "sym:tests/test_doctor.py::test_doctor_artifact_integrity_still_catches_corrupt_dot_r2g", `name`: "test_doctor_artifact_integrity_still_catches_corrupt_dot_r2g", `qualname`: "test_doctor_artifact_integrity_still_catches_corrupt_dot_r2g", `kind`: "function", `path`: "tests/test_doctor.py", `lang`: "python", `start_line`: 173, `end_line`: 187, `signature`: "def test_doctor_artifact_integrity_still_catches_corrupt_dot_r2g(tmp_path):", `docstring`: "A corrupt manifest.json *inside* a `.r2g` dir must still FAIL.\n\n    `.r2g` is repo2graph's own default -o name and nothing else uses it, so\n    it's still strong enough evidence to report corruption on, even without\n    a manifest that parses.", `entrypoint`: true};
