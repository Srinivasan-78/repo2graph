MERGE (n:R2G:`Symbol` {id: "sym:tests/test_compat.py::test_commit_release_uses_signing_mutation_not_git_data"}) SET n += {`id`: "sym:tests/test_compat.py::test_commit_release_uses_signing_mutation_not_git_data", `name`: "test_commit_release_uses_signing_mutation_not_git_data", `qualname`: "test_commit_release_uses_signing_mutation_not_git_data", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 1173, `end_line`: 1209, `signature`: "def test_commit_release_uses_signing_mutation_not_git_data():", `docstring`: "The commit must be created by GraphQL createCommitOnBranch.\n\n    GitHub signs commits it authors (Contents API, createCommitOnBranch) and\n    does not sign ones assembled through the Git Data API. `main` requires\n    signed commits, so a regression back to blobs/trees/commits would leave\n    every release PR unmergeable without an admin bypass.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_compat.py::test_commit_release_stages_an_existing_branch_before_moving_it"}) SET n += {`id`: "sym:tests/test_compat.py::test_commit_release_stages_an_existing_branch_before_moving_it", `name`: "test_commit_release_stages_an_existing_branch_before_moving_it", `qualname`: "test_commit_release_stages_an_existing_branch_before_moving_it", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 1212, `end_line`: 1240, `signature`: "def test_commit_release_stages_an_existing_branch_before_moving_it(monkeypatch):", `docstring`: "An existing PR branch must never be reset to base in place.\n\n    Resetting it leaves the open PR with zero commits and GitHub closes the PR\n    automatically, so the branch is rebuilt on a staging ref and moved in one\n    force-update instead.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_compat.py::test_commit_release_commits_directly_on_a_new_branch"}) SET n += {`id`: "sym:tests/test_compat.py::test_commit_release_commits_directly_on_a_new_branch", `name`: "test_commit_release_commits_directly_on_a_new_branch", `qualname`: "test_commit_release_commits_directly_on_a_new_branch", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 1243, `end_line`: 1249, `signature`: "def test_commit_release_commits_directly_on_a_new_branch(monkeypatch):", `docstring`: "A branch that does not exist yet needs no staging ref.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_compat.py::test_commit_release_splits_headline_from_body"}) SET n += {`id`: "sym:tests/test_compat.py::test_commit_release_splits_headline_from_body", `name`: "test_commit_release_splits_headline_from_body", `qualname`: "test_commit_release_splits_headline_from_body", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 1252, `end_line`: 1259, `signature`: "def test_commit_release_splits_headline_from_body(monkeypatch):", `docstring`: "GraphQL takes headline and body separately, not one git-style blob.", `entrypoint`: true};
