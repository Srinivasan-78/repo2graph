MERGE (n:R2G:Symbol {id: "sym:tests/conftest.py::use_stub_embedder"}) SET n += {`id`: "sym:tests/conftest.py::use_stub_embedder", `name`: "use_stub_embedder", `qualname`: "use_stub_embedder", `kind`: "function", `path`: "tests/conftest.py", `lang`: "python", `start_line`: 296, `end_line`: 329, `signature`: "def use_stub_embedder(monkeypatch):", `docstring`: "Make `embed.default_embedder()` hand back a StubEmbedder.\n\n    Returns the factory's record: `.made` is every embedder handed out, `.names`\n    every `name` argument it was called with. The patch is applied to\n    `repo2graph.embed` (and to `repo2graph.cli` if it re-exports the symbol), so\n    it holds whether the CLI reaches the function through the module or through\n    a function-local `from .embed import default_embedder`.", `entrypoint`: true};
