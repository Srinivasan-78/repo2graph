MERGE (n:R2G:`Symbol` {id: "sym:tests/test_integrity.py::TestBuildLock.test_a_windows_sharing_violation_is_retried_not_treated_as_unwritable"}) SET n += {`id`: "sym:tests/test_integrity.py::TestBuildLock.test_a_windows_sharing_violation_is_retried_not_treated_as_unwritable", `name`: "test_a_windows_sharing_violation_is_retried_not_treated_as_unwritable", `qualname`: "TestBuildLock.test_a_windows_sharing_violation_is_retried_not_treated_as_unwritable", `kind`: "function", `path`: "tests/test_integrity.py", `lang`: "python", `start_line`: 222, `end_line`: 252, `signature`: "def test_a_windows_sharing_violation_is_retried_not_treated_as_unwritable(self, tmp_path):", `docstring`: "OneDrive, antivirus and the search indexer briefly hold a new index's\n        files open; NTFS answers EACCES until they let go, and it clears.\n\n        `export._rename` already retries exactly that. This lock used to retry\n        every OSError too, then started fast-failing on EACCES -- turning a\n        self-clearing hiccup into a build failure that blamed a read-only\n        parent. The third attempt here succeeds, so acquire() must as well.", `entrypoint`: true};
