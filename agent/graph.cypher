MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_shipped_manifest_carries_no_absolute_source_root"}) SET n += {`id`: "sym:tests/test_index_status.py::test_shipped_manifest_carries_no_absolute_source_root", `name`: "test_shipped_manifest_carries_no_absolute_source_root", `qualname`: "test_shipped_manifest_carries_no_absolute_source_root", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 579, `end_line`: 603, `signature`: "def test_shipped_manifest_carries_no_absolute_source_root(tmp_path):", `docstring`: "manifest.json ships (committed .r2g, Action artifacts): no build path in it.\n\n    The absolute root lives in the index root's local.json, which a generated\n    .gitignore keeps out of git, and index-status still finds it through there\n    for an index built outside the tree it describes.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_old_manifest_source_root_is_still_honoured"}) SET n += {`id`: "sym:tests/test_index_status.py::test_old_manifest_source_root_is_still_honoured", `name`: "test_old_manifest_source_root_is_still_honoured", `qualname`: "test_old_manifest_source_root_is_still_honoured", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 606, `end_line`: 618, `signature`: "def test_old_manifest_source_root_is_still_honoured(tmp_path):", `docstring`: "An index from before local.json existed keeps working.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_github_build_is_reported_as_remote_not_stale"}) SET n += {`id`: "sym:tests/test_index_status.py::test_github_build_is_reported_as_remote_not_stale", `name`: "test_github_build_is_reported_as_remote_not_stale", `qualname`: "test_github_build_is_reported_as_remote_not_stale", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 621, `end_line`: 661, `signature`: "def test_github_build_is_reported_as_remote_not_stale(tmp_path, monkeypatch, capsys):", `docstring`: "`repo2graph github owner/repo -o dir`: the temp clone is gone afterwards.\n\n    Comparing against cwd read as `[STALE] N added` and suggested `build <cwd>`,\n    which indexes the wrong tree. It must say freshness cannot be checked and\n    suggest the github command instead.", `entrypoint`: true, `reach`: 475};
