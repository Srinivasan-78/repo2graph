MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_forwarded_for_is_ignored_when_the_peer_is_not_in_the_allowlist"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_forwarded_for_is_ignored_when_the_peer_is_not_in_the_allowlist", `name`: "test_forwarded_for_is_ignored_when_the_peer_is_not_in_the_allowlist", `qualname`: "test_forwarded_for_is_ignored_when_the_peer_is_not_in_the_allowlist", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 679, `end_line`: 701, `signature`: "def test_forwarded_for_is_ignored_when_the_peer_is_not_in_the_allowlist(index):", `docstring`: "trust_proxy=True alone is not enough -- the peer must also be listed.", `entrypoint`: true, `reach`: 57};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_forwarded_headers_never_affect_authentication"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_forwarded_headers_never_affect_authentication", `name`: "test_forwarded_headers_never_affect_authentication", `qualname`: "test_forwarded_headers_never_affect_authentication", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 704, `end_line`: 717, `signature`: "def test_forwarded_headers_never_affect_authentication(make_server):", `docstring`: "#267: forwarded identity headers are ignored for authentication too --\n    trivially true here since Authenticator only ever reads Authorization,\n    but pinned so a future change that starts consulting them is caught.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_non_loopback_bind_with_auth_warns_unless_acknowledged"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_non_loopback_bind_with_auth_warns_unless_acknowledged", `name`: "test_non_loopback_bind_with_auth_warns_unless_acknowledged", `qualname`: "test_non_loopback_bind_with_auth_warns_unless_acknowledged", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 720, `end_line`: 738, `signature`: "def test_non_loopback_bind_with_auth_warns_unless_acknowledged(index, capsys):", `docstring`: "#267 acceptance: binding to 0.0.0.0 without a TLS/reverse-proxy\n    acknowledgement produces a high-visibility warning. Existing behaviour\n    (`test_binding_beyond_loopback_with_auth_is_allowed` in\n    test_http_transport.py) requires this to still be non-fatal, so the\n    property under test is the warning's presence, not a refusal to start.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_non_loopback_bind_warning_is_suppressed_with_explicit_ack"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_non_loopback_bind_warning_is_suppressed_with_explicit_ack", `name`: "test_non_loopback_bind_warning_is_suppressed_with_explicit_ack", `qualname`: "test_non_loopback_bind_warning_is_suppressed_with_explicit_ack", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 741, `end_line`: 754, `signature`: "def test_non_loopback_bind_warning_is_suppressed_with_explicit_ack(index, capsys):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_the_client_identity_map_is_bounded_by_its_own_ceiling"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_the_client_identity_map_is_bounded_by_its_own_ceiling", `name`: "test_the_client_identity_map_is_bounded_by_its_own_ceiling", `qualname`: "test_the_client_identity_map_is_bounded_by_its_own_ceiling", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 757, `end_line`: 785, `signature`: "def test_the_client_identity_map_is_bounded_by_its_own_ceiling():", `docstring`: "#264: the sliding window keeps per-identity state, so a flood of\n    one-shot identities is itself a memory attack.\n\n    The ceiling is `max_tracked_clients` and nothing else. It used to be\n    derived as `8 * max_concurrent_requests`, which conflates two unrelated\n    numbers: a server tuned for 64 concurrent requests would evict real\n    clients after 512 distinct identities -- and eviction is not a throttle,\n    it *clears* a client's history and hands it a fresh allowance. So the\n    two knobs are set in opposition here: a tiny tracking ceiling alongside\n    a large concurrency setting. Un", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::TestRateLimiterPrimitives"}) SET n += {`id`: "sym:tests/test_http_hardening.py::TestRateLimiterPrimitives", `name`: "TestRateLimiterPrimitives", `qualname`: "TestRateLimiterPrimitives", `kind`: "class", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 788, `end_line`: 851, `signature`: "class TestRateLimiterPrimitives:", `docstring`: "#264's concurrency primitives, exercised directly.\n\n    Every other test here drives them through a live HTTP request, which is the\n    right shape for the policy but leaves the accounting inside `acquire_slot`\n    untested on its own -- and that accounting is the part that can leak. A\n    queue counter that is not decremented on the timeout path degrades the\n    server permanently: every later caller sees a full queue and is refused,\n    while the concurrency semaphore itself sits idle."};
