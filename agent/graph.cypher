MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_iss422_disconnected_rule_skips_files_the_graph_cannot_relate"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_iss422_disconnected_rule_skips_files_the_graph_cannot_relate", `name`: "test_iss422_disconnected_rule_skips_files_the_graph_cannot_relate", `qualname`: "test_iss422_disconnected_rule_skips_files_the_graph_cannot_relate", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 493, `end_line`: 525, `signature`: "def test_iss422_disconnected_rule_skips_files_the_graph_cannot_relate(sample_graph_index):", `docstring`: "R2G-IMP-001 must not fire on a file that has no graph presence at all.\n\n    `.github/workflows/ci.yml` has no symbols and no imports in any index ever\n    built, so \"no graph relationships connect it to the other changes\" is true of\n    it in every multi-file diff -- a finding that names an ordinary CI edit and\n    can never be resolved. Same for `PR_IMPACT.md`, which the index does not\n    contain at all.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_iss422_disconnected_rule_needs_two_relatable_files"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_iss422_disconnected_rule_needs_two_relatable_files", `name`: "test_iss422_disconnected_rule_needs_two_relatable_files", `qualname`: "test_iss422_disconnected_rule_needs_two_relatable_files", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 528, `end_line`: 550, `signature`: "def test_iss422_disconnected_rule_needs_two_relatable_files(sample_graph_index):", `docstring`: "One source file plus any number of unrelatable ones is not an orphan diff.\n\n    pkg/core.py is the only graph-relatable file in this diff, so there is\n    nothing in the change it could have been connected to.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_iss422_report_states_which_changed_files_the_index_is_missing"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_iss422_report_states_which_changed_files_the_index_is_missing", `name`: "test_iss422_report_states_which_changed_files_the_index_is_missing", `qualname`: "test_iss422_report_states_which_changed_files_the_index_is_missing", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 553, `end_line`: 586, `signature`: "def test_iss422_report_states_which_changed_files_the_index_is_missing(sample_graph_index):", `docstring`: "An index that predates the diff produces a silent wrong answer.\n\n    Nothing can be said about a changed file the index has never seen -- no\n    caller, no test, no public API -- and the report has to say so rather than\n    render zeros that read like evidence of no impact. This is the shape of an\n    index built on the base ref while the diff's line numbers are head-side.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_iss422_no_stale_index_notice_when_the_index_covers_the_diff"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_iss422_no_stale_index_notice_when_the_index_covers_the_diff", `name`: "test_iss422_no_stale_index_notice_when_the_index_covers_the_diff", `qualname`: "test_iss422_no_stale_index_notice_when_the_index_covers_the_diff", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 589, `end_line`: 602, `signature`: "def test_iss422_no_stale_index_notice_when_the_index_covers_the_diff(sample_graph_index):", `docstring`: "", `entrypoint`: true};
