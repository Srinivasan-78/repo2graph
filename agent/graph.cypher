MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_sh1_add_cochange_splits_git_log_on_newline_only"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_sh1_add_cochange_splits_git_log_on_newline_only", `name`: "test_sh1_add_cochange_splits_git_log_on_newline_only", `qualname`: "test_sh1_add_cochange_splits_git_log_on_newline_only", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1343, `end_line`: 1357, `signature`: "def test_sh1_add_cochange_splits_git_log_on_newline_only(monkeypatch):", `docstring`: "REVIEW SH-1 (ISS-22 bug class, graph.py:380): add_cochange must split\n    `git log` output on \"\\\\n\" only. With core.quotepath=false git emits a path\n    containing a raw U+2028; str.splitlines() would cut that path in two so\n    neither fragment matches file_index and the CO_CHANGE edge vanishes.", `entrypoint`: true, `reach`: 47};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss27_graphml_roundtrips_with_a_control_char"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss27_graphml_roundtrips_with_a_control_char", `name`: "test_iss27_graphml_roundtrips_with_a_control_char", `qualname`: "test_iss27_graphml_roundtrips_with_a_control_char", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1360, `end_line`: 1386, `signature`: "def test_iss27_graphml_roundtrips_with_a_control_char(tmp_path):", `docstring`: "AC-5 (ISS-27): a C0 control char inside a docstring must not make the\n    GraphML unparseable. stdlib only, never skipped. At HEAD ElementTree writes\n    the raw \\\\x0c and ET.parse raises ParseError.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss19_parse_spec_rejects_traversal_and_option_specs"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss19_parse_spec_rejects_traversal_and_option_specs", `name`: "test_iss19_parse_spec_rejects_traversal_and_option_specs", `qualname`: "test_iss19_parse_spec_rejects_traversal_and_option_specs", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1390, `end_line`: 1396, `signature`: "def test_iss19_parse_spec_rejects_traversal_and_option_specs(spec):", `docstring`: "AC-6 (ISS-19): traversal / option-like specs must raise. At HEAD\n    parse_spec(\"owner/..\") returns (\"owner\", \"..\") instead of raising.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss19_parse_spec_still_accepts_valid_specs"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss19_parse_spec_still_accepts_valid_specs", `name`: "test_iss19_parse_spec_still_accepts_valid_specs", `qualname`: "test_iss19_parse_spec_still_accepts_valid_specs", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1407, `end_line`: 1411, `signature`: "def test_iss19_parse_spec_still_accepts_valid_specs(spec):", `docstring`: "AC-6 (ISS-19): the hardening must not reject legitimate specs.", `entrypoint`: true};
