MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/auth.py::Authenticator.authenticate"}) SET n += {`id`: "sym:repo2graph/auth.py::Authenticator.authenticate", `name`: "authenticate", `qualname`: "Authenticator.authenticate", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 684, `end_line`: 754, `signature`: "def authenticate(self, header: str | None) -> Identity:", `docstring`: "Validate one Authorization header.\n\n        Args:\n            header: The raw header value, or None when absent.\n\n        Returns:\n            The caller's Identity. With no auth configured this is always the\n            anonymous identity and the header is ignored entirely.\n\n        Raises:\n            AuthError: When a credential is required and this one does not pass."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/auth.py::client_metadata_document"}) SET n += {`id`: "sym:repo2graph/auth.py::client_metadata_document", `name`: "client_metadata_document", `qualname`: "client_metadata_document", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 757, `end_line`: 782, `signature`: "def client_metadata_document(base_url: str, name: str = \"repo2graph\") -> dict[str, Any]:", `docstring`: "A Client ID Metadata Document, as RFC 7591 client metadata.\n\n    CIMD serves this at a URL and uses that URL as the `client_id`, so the\n    document must be reachable at the id it advertises.\n\n    Args:\n        base_url: The externally reachable base URL of this server.\n        name: Human-readable client name.\n\n    Returns:\n        The metadata document."};
