MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_settle"}) SET n += {`id`: "sym:repo2graph/graph.py::_settle", `name`: "_settle", `qualname`: "_settle", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1088, `end_line`: 1107, `signature`: "def _settle(\n    item: tuple[str, Path, str | None, BuildConfig | None],\n    outcome: tuple[ReadResult, float] | str,\n    timeout: float,\n) -> ReadResult:", `docstring`: "`parse_all`'s result for one file, from what its parse came back with.\n\n    `outcome` is `(result, seconds)` or parsepool's TIMEOUT / CRASH marker. A\n    parse that finished but over budget is discarded the same as one that had\n    to be killed, so where the deadline is noticed never changes the output."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_abandoned"}) SET n += {`id`: "sym:repo2graph/graph.py::_abandoned", `name`: "_abandoned", `qualname`: "_abandoned", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1110, `end_line`: 1134, `signature`: "def _abandoned(item: tuple[str, Path, str | None, BuildConfig | None], reason: str) -> ReadResult:", `docstring`: "The result for a file whose worker was killed or died under it (#81).\n\n    Read again here because the bytes died with the worker. Size, line count\n    and digest come out exactly as a finished parse reports them, so the file\n    node is the one a parse would have made; the language is settled from the\n    first slice, as `_chunk_and_parse` settles it for a file too big to hold."};
