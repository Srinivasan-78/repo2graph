MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index._load_vectors"}) SET n += {`id`: "sym:repo2graph/query.py::Index._load_vectors", `name`: "_load_vectors", `qualname`: "Index._load_vectors", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 243, `end_line`: 265, `signature`: "def _load_vectors(self) -> None:", `docstring`: "Load agent/vectors.npy into chunk-list-index keys, or give up quietly.\n\n        The file is keyed by chunk id; ids the current chunks.jsonl no longer\n        holds are dropped rather than shifted onto a neighbouring row, because\n        a mis-aligned vector produces plausible-looking garbage rankings that\n        nothing downstream can detect."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.fuse_ok"}) SET n += {`id`: "sym:repo2graph/query.py::Index.fuse_ok", `name`: "fuse_ok", `qualname`: "Index.fuse_ok", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 267, `end_line`: 299, `signature`: "def fuse_ok(self, embedder: \"Embedder\") -> tuple[bool, str]:", `docstring`: "May `embedder`'s query vectors be fused with this index's vectors?\n\n        A silent model or width mismatch is worse than no vectors at all: the\n        rankings stay plausible while being meaningless, so the answer is a\n        refusal naming both sides rather than a best effort."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index._load_text"}) SET n += {`id`: "sym:repo2graph/query.py::Index._load_text", `name`: "_load_text", `qualname`: "Index._load_text", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 301, `end_line`: 325, `signature`: "def _load_text(self, name: str) -> str:", `docstring`: "Read an optional artifact, trying every section it is written to.\n\n        newline=\"\\n\" for the same reason read_jsonl uses it: universal-newline\n        mode rewrites U+2028/U+2029/U+0085 line ends and would desync the text\n        from what was written.\n\n        overview.md is the one artifact split across two sections with\n        different content: human/overview.md is the structured table view for\n        a person, agent/overview.md is the terse prose the GraphRAG protocol\n        (and this repo map) are built around. Try the agent copy first so\n        pack_context/rag output keeps readi"};
