MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::_has_index"}) SET n += {`id`: "sym:repo2graph/mcp.py::_has_index", `name`: "_has_index", `qualname`: "_has_index", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 260, `end_line`: 262, `signature`: "def _has_index(out_path: Path) -> bool:", `docstring`: "True when `out_path` holds an index a tool can actually read."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::_build_index"}) SET n += {`id`: "sym:repo2graph/mcp.py::_build_index", `name`: "_build_index", `qualname`: "_build_index", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 265, `end_line`: 287, `signature`: "def _build_index(repo: Path, out: Path) -> None:", `docstring`: "Index `repo` into `out`, in-process, single-process, silent on stdout.\n\n    Two constraints, both of them about the transport rather than about graphs:\n\n    * Nothing may reach stdout. It carries the JSON-RPC stream, and one stray\n      `print` ends the session. `graph.build` and `export.dump_all` write no\n      console output of their own -- the CLI's `cmd_build` is what emits the\n      JSON report -- so calling them directly is what keeps the wire clean.\n    * `jobs=1`, always. `build()` reaches for a process pool above\n      PARALLEL_MIN_FILES files, and spawning one from inside the running"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::open_index"}) SET n += {`id`: "sym:repo2graph/mcp.py::open_index", `name`: "open_index", `qualname`: "open_index", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 290, `end_line`: 321, `signature`: "def open_index(out, repo=None, cache=None) -> Index:", `docstring`: "One Index per output directory, reused for the life of the process.\n\n    Building an Index reads and inverts every chunk; doing that per tool call\n    would make the second call as expensive as the first.\n\n    `repo` is the opt-in half. Without it this is what it has always been: open\n    an index that exists, or exit naming the command that creates one. With it,\n    an absent index is built from that directory first -- so an agent that was\n    pointed at a repo gets an answer instead of an error it cannot act on. It\n    stays opt-in because inferring a repo to index from an output path alone "};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::open_index_or_task"}) SET n += {`id`: "sym:repo2graph/mcp.py::open_index_or_task", `name`: "open_index_or_task", `qualname`: "open_index_or_task", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 324, `end_line`: 363, `signature`: "def open_index_or_task(out, repo=None, cache=None, tasks=None):", `docstring`: "Open the index, or start a background build and say so.\n\n    Args:\n        out: Index directory.\n        repo: Repository to build from, or None.\n        cache: A `ResultCache` to clear on a completed rebuild, or None.\n        tasks: A `TaskManager` when `--async-build` is on, else None.\n\n    Returns:\n        `(index, None)` when an index is available, or `(None, message)` when a\n        build is in flight or has failed -- the message being what the caller\n        should hand back to the agent verbatim."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::tool_repo_map"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_repo_map", `name`: "tool_repo_map", `qualname`: "tool_repo_map", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 369, `end_line`: 371, `signature`: "def tool_repo_map(index: Index) -> str:", `docstring`: "The repo map, verbatim: stable, cacheable, no query argument."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::tool_repo_search"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_repo_search", `name`: "tool_repo_search", `qualname`: "tool_repo_search", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 374, `end_line`: 400, `signature`: "def tool_repo_search(\n    index: Index, query: str, k: int = 8, hops: int = 1, budget_tokens=None\n) -> str:", `docstring`: "Cited markdown for `query`, never wider than MCP_MAX_BUDGET_TOKENS."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::tool_repo_neighbours"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_repo_neighbours", `name`: "tool_repo_neighbours", `qualname`: "tool_repo_neighbours", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 403, `end_line`: 432, `signature`: "def tool_repo_neighbours(\n    index: Index, node_id: str, hops: int = 1, limit: int = MCP_NEIGHBOUR_LIMIT\n) -> str:", `docstring`: "One graph hop from `node_id` \u2014 the thing grep cannot do."};
