MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/exclusions.py::ExclusionGroup"}) SET n += {`id`: "sym:repo2graph/exclusions.py::ExclusionGroup", `name`: "ExclusionGroup", `qualname`: "ExclusionGroup", `kind`: "class", `path`: "repo2graph/exclusions.py", `lang`: "python", `start_line`: 31, `end_line`: 49, `signature`: "class ExclusionGroup:", `docstring`: "One named set of paths, as the globs that exclude them.\n\n    Args:\n        name: The `--exclude-group` value.\n        description: One line, shown by `--exclude-group help`.\n        globs: Patterns for `build --exclude`, in `parse._glob_re` syntax.\n        already_default: True when repo2graph's *defaults* already keep these\n            out of an index, so naming the group changes nothing. Recorded so\n            the docs and `--exclude-group help` cannot overclaim.\n        representative: Paths the group must match. The determinism suite\n            feeds these back through the real matcher."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/exclusions.py::globs_for"}) SET n += {`id`: "sym:repo2graph/exclusions.py::globs_for", `name`: "globs_for", `qualname`: "globs_for", `kind`: "function", `path`: "repo2graph/exclusions.py", `lang`: "python", `start_line`: 200, `end_line`: 225, `signature`: "def globs_for(names: list[str] | tuple[str, ...]) -> list[str]:", `docstring`: "Every glob for the named groups, de-duplicated, in a stable order.\n\n    \"all\" expands to every group. An unknown name raises ValueError naming the\n    valid ones -- argparse `choices` already rejects it at the CLI, so this is\n    for the Python API."};
