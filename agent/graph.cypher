MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_run_tool_writes_one_audit_record_per_call"}) SET n += {`id`: "sym:tests/test_mcp.py::test_run_tool_writes_one_audit_record_per_call", `name`: "test_run_tool_writes_one_audit_record_per_call", `qualname`: "test_run_tool_writes_one_audit_record_per_call", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1902, `end_line`: 1930, `signature`: "def test_run_tool_writes_one_audit_record_per_call(mini_index, tmp_path):", `docstring`: "The --audit-log flags have to produce records, not just be accepted.\n\n    `serve()` built an `AuditLogger`, closed it, and never handed it to the\n    tool-call path, so `record()` was unreachable in production while its own\n    583 lines of tests passed. An operator pointing --audit-log at a file got an\n    empty file. Nothing covered serve() -> record(), which is why it survived.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_an_audit_record_is_written_when_the_tool_fails"}) SET n += {`id`: "sym:tests/test_mcp.py::test_an_audit_record_is_written_when_the_tool_fails", `name`: "test_an_audit_record_is_written_when_the_tool_fails", `qualname`: "test_an_audit_record_is_written_when_the_tool_fails", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1933, `end_line`: 1957, `signature`: "def test_an_audit_record_is_written_when_the_tool_fails(mini_index, tmp_path):", `docstring`: "A failure is the case an audit trail exists for, so it must be recorded.\n\n    `errors` level keeps only non-success outcomes, which makes this the exact\n    configuration an operator would run in and the one that must not be silent.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_a_missing_index_mid_session_costs_one_call_not_the_server"}) SET n += {`id`: "sym:tests/test_mcp.py::test_a_missing_index_mid_session_costs_one_call_not_the_server", `name`: "test_a_missing_index_mid_session_costs_one_call_not_the_server", `qualname`: "test_a_missing_index_mid_session_costs_one_call_not_the_server", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1960, `end_line`: 1974, `signature`: "def test_a_missing_index_mid_session_costs_one_call_not_the_server(tmp_path):", `docstring`: "One bad request must not take the stdio server down.\n\n    `open_index` raises SystemExit when it has no index and no repo, which is\n    right for the startup preflight and for a direct call. On the per-request\n    path it meant an index deleted while the server ran killed the process and\n    the client saw a closed pipe instead of an error. SystemExit is a\n    BaseException, so an ordinary `except Exception` around the handler does not\n    hold it -- this pins the conversion explicitly.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_audit_logging_is_off_by_default"}) SET n += {`id`: "sym:tests/test_mcp.py::test_audit_logging_is_off_by_default", `name`: "test_audit_logging_is_off_by_default", `qualname`: "test_audit_logging_is_off_by_default", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1977, `end_line`: 1982, `signature`: "def test_audit_logging_is_off_by_default(mini_index):", `docstring`: "No logger means no record and no cost -- the default stays silent.", `entrypoint`: true};
