MERGE (n:R2G:`File` {id: "file:tests/test_mcp.py"}) SET n += {`id`: "file:tests/test_mcp.py", `name`: "test_mcp.py", `path`: "tests/test_mcp.py", `lang`: "python", `file_type`: "code", `size`: 82333, `lines`: 2170, `parse_errors`: 0, `chunked`: false};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::_has_mcp"}) SET n += {`id`: "sym:tests/test_mcp.py::_has_mcp", `name`: "_has_mcp", `qualname`: "_has_mcp", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 31, `end_line`: 59, `signature`: "def _has_mcp():", `docstring`: "A real, currently-*supported* SDK is importable.\n\n    #407/#291 dropped mcp 1.x: `serve()` now speaks only the 2.x registration\n    API (`on_list_tools=`/`on_call_tool=`), so a test that drives a live\n    subprocess needs mcp>=2.0. This used to check\n    `hasattr(Server, \"list_tools\")`, which is true only for the *unsupported*\n    1.x generation -- so on any environment with the (now required) 2.x SDK\n    installed, every test gated on it silently skipped forever. Detector:\n    reverting this to the old hasattr check makes\n    test_stdio_roundtrip_against_a_repo_with_no_index and\n    test_ac34", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::_has_any_mcp"}) SET n += {`id`: "sym:tests/test_mcp.py::_has_any_mcp", `name`: "_has_any_mcp", `qualname`: "_has_any_mcp", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 65, `end_line`: 78, `signature`: "def _has_any_mcp():", `docstring`: "Any `mcp` SDK is importable at all, supported or not.\n\n    Only `test_iss90_...parallel_path` uses this -- it exercises `serve()`'s\n    own real behaviour (including refusing an unsupported SDK), so it must\n    run whenever *some* SDK is installed, not only a supported one.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::mcp_module"}) SET n += {`id`: "sym:tests/test_mcp.py::mcp_module", `name`: "mcp_module", `qualname`: "mcp_module", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 84, `end_line`: 87, `signature`: "def mcp_module():", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::tokens"}) SET n += {`id`: "sym:tests/test_mcp.py::tokens", `name`: "tokens", `qualname`: "tokens", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 90, `end_line`: 93, `signature`: "def tokens(text: str) -> int:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_ac26_repo_map_is_exactly_map_prepend"}) SET n += {`id`: "sym:tests/test_mcp.py::test_ac26_repo_map_is_exactly_map_prepend", `name`: "test_ac26_repo_map_is_exactly_map_prepend", `qualname`: "test_ac26_repo_map_is_exactly_map_prepend", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 101, `end_line`: 106, `signature`: "def test_ac26_repo_map_is_exactly_map_prepend(mini_index):", `docstring`: "AC-26: no reformatting, no truncation, no query argument.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_iss383_repo_map_is_silent_when_the_tree_is_unchanged"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss383_repo_map_is_silent_when_the_tree_is_unchanged", `name`: "test_iss383_repo_map_is_silent_when_the_tree_is_unchanged", `qualname`: "test_iss383_repo_map_is_silent_when_the_tree_is_unchanged", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 109, `end_line`: 114, `signature`: "def test_iss383_repo_map_is_silent_when_the_tree_is_unchanged(mini_repo, mini_index):", `docstring`: "#383: an index whose tree has not moved reports no staleness note --\n    the check must not become a false positive on every call.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_iss383_repo_map_warns_when_the_working_tree_moved"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss383_repo_map_warns_when_the_working_tree_moved", `name`: "test_iss383_repo_map_warns_when_the_working_tree_moved", `qualname`: "test_iss383_repo_map_warns_when_the_working_tree_moved", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 117, `end_line`: 148, `signature`: "def test_iss383_repo_map_warns_when_the_working_tree_moved(mini_repo, mini_index):", `docstring`: "#383: `_index_mtime`/`open_index`'s reload check both compare the index\n    against itself at an earlier moment -- neither ever looks at the source\n    tree, so a long-running server answered from a stale graph indefinitely\n    and every `[cite: path:start-end]` anchor was then confidently wrong.\n    `tool_repo_map` must surface the mismatch using the per-file sha256\n    `index.state.json` already records (`status.compute_freshness`), not stay\n    silent forever.\n\n    Detector: reverting `tool_repo_map` to `index.map_prepend()` (its\n    pre-#383 body) makes this fail while\n    test_iss383_repo", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_ac27_repo_search_returns_cited_markdown_within_the_default_budget"}) SET n += {`id`: "sym:tests/test_mcp.py::test_ac27_repo_search_returns_cited_markdown_within_the_default_budget", `name`: "test_ac27_repo_search_returns_cited_markdown_within_the_default_budget", `qualname`: "test_ac27_repo_search_returns_cited_markdown_within_the_default_budget", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 156, `end_line`: 175, `signature`: "def test_ac27_repo_search_returns_cited_markdown_within_the_default_budget(big_index):", `docstring`: "AC-27: at least one `### [cite: path:start-end]` header, and the result\n    measures no more than MCP_BUDGET_TOKENS.\n\n    `big_index` packs to well over the default budget when unbounded, so the\n    default really is enforced here rather than merely not exceeded.", `entrypoint`: true};
