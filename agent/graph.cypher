MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::test_bump_moves_every_surface_to_the_new_version"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_bump_moves_every_surface_to_the_new_version", `name`: "test_bump_moves_every_surface_to_the_new_version", `qualname`: "test_bump_moves_every_surface_to_the_new_version", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 177, `end_line`: 185, `signature`: "def test_bump_moves_every_surface_to_the_new_version(tmp_path):", `docstring`: "The whole point: after a bump, nothing still reads the old version.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::test_bump_rewrites_the_documented_major_tag"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_bump_rewrites_the_documented_major_tag", `name`: "test_bump_rewrites_the_documented_major_tag", `qualname`: "test_bump_rewrites_the_documented_major_tag", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 188, `end_line`: 195, `signature`: "def test_bump_rewrites_the_documented_major_tag(tmp_path):", `docstring`: "Named separately because it is the surface that was missed. `@v9` and\n    \"every 9.x release\", hand-derived from a 9.9.9 target.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::_rewrite_in_sandbox"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::_rewrite_in_sandbox", `name`: "_rewrite_in_sandbox", `qualname`: "_rewrite_in_sandbox", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 198, `end_line`: 215, `signature`: "def _rewrite_in_sandbox(tmp_path: Path, version: str) -> dict[str, str]:", `docstring`: "Run `rewrite(version)` against copies, never the real checkout.\n\n    `version_surfaces.ROOT` is module state, so it is swapped for the duration\n    and restored -- a test that bumped the working tree and failed halfway would\n    leave the repo claiming a version it never released."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::test_the_sandbox_helper_leaves_the_real_tree_alone"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_the_sandbox_helper_leaves_the_real_tree_alone", `name`: "test_the_sandbox_helper_leaves_the_real_tree_alone", `qualname`: "test_the_sandbox_helper_leaves_the_real_tree_alone", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 218, `end_line`: 224, `signature`: "def test_the_sandbox_helper_leaves_the_real_tree_alone(tmp_path):", `docstring`: "The guard on the guard: if `_rewrite_in_sandbox` ever edited the checkout,\n    every other test here would still pass while corrupting the repo.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::test_major_surfaces_carry_only_the_major"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_major_surfaces_carry_only_the_major", `name`: "test_major_surfaces_carry_only_the_major", `qualname`: "test_major_surfaces_carry_only_the_major", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 227, `end_line`: 236, `signature`: "def test_major_surfaces_carry_only_the_major():", `docstring`: "`kind=\"major\"` exists because publish.yml's floating tag is `vN`. If a\n    major surface started expecting a full version, every bump would write\n    `@v2.1.0` into a `uses:` line and point users at a tag that does not move.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::test_no_assertion_in_the_suite_spells_out_the_current_version"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_no_assertion_in_the_suite_spells_out_the_current_version", `name`: "test_no_assertion_in_the_suite_spells_out_the_current_version", `qualname`: "test_no_assertion_in_the_suite_spells_out_the_current_version", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 239, `end_line`: 274, `signature`: "def test_no_assertion_in_the_suite_spells_out_the_current_version():", `docstring`: "A test that hardcodes the version under release is red the moment the\n    bump lands -- and the first run that can see it is publish.yml's `pypi`\n    job, which tests the already-tagged commit.\n\n    The bug: tests/test_export_hardening.py asserted the static `__version__`\n    fallback equalled `\"2.2.0\"`. Nothing could fail that until a bump rewrote\n    the literal it was shadowing, so it passed every PR and aborted the 3.0.0\n    release after the tag was cut and the bump PR merged. The fix is to read\n    the surface -- `declared_version()` here, or the literal in\n    `repo2graph/__init__.py` -", `entrypoint`: true};
