MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/scip.py::decode_index"}) SET n += {`id`: "sym:repo2graph/scip.py::decode_index", `name`: "decode_index", `qualname`: "decode_index", `kind`: "function", `path`: "repo2graph/scip.py", `lang`: "python", `start_line`: 384, `end_line`: 416, `signature`: "def decode_index(data: bytes, wanted: Collection[str] | None = None) -> ScipIndex:", `docstring`: "Decode a serialized `scip.Index`.\n\n    Args:\n        data: The raw bytes of an `index.scip` file. Untrusted.\n        wanted: Repository-relative paths whose documents should be decoded in\n            full; every other document is framed and counted but its\n            occurrences are skipped unread. None decodes every document.\n\n    Returns:\n        The decoded index.\n\n    Raises:\n        ScipError: The bytes are not a well-formed index within the bounds\n            above. No other exception escapes for any input."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/scip.py::read_index_bytes"}) SET n += {`id`: "sym:repo2graph/scip.py::read_index_bytes", `name`: "read_index_bytes", `qualname`: "read_index_bytes", `kind`: "function", `path`: "repo2graph/scip.py", `lang`: "python", `start_line`: 419, `end_line`: 444, `signature`: "def read_index_bytes(path: Path, max_bytes: int | None = None) -> bytes:", `docstring`: "Read an index file, refusing anything over `max_bytes` before reading it.\n\n    Args:\n        path: The index file.\n        max_bytes: Size ceiling; `MAX_INDEX_BYTES` when None.\n\n    Raises:\n        ScipError: Not a regular file, or too large.\n        OSError: The file could not be read."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/scip.py::index_path"}) SET n += {`id`: "sym:repo2graph/scip.py::index_path", `name`: "index_path", `qualname`: "index_path", `kind`: "function", `path`: "repo2graph/scip.py", `lang`: "python", `start_line`: 447, `end_line`: 466, `signature`: "def index_path(value: str | None, repo_root: Path, from_config: bool) -> str | None:", `docstring`: "Where to read the index from, for `build`.\n\n    A `--scip` flag is a path as typed, relative to the working directory. The\n    `scip` config key is the repository speaking for itself, so its path is\n    relative to the repository root and has to stay inside it -- a checked-in\n    config cannot point a build at a file elsewhere on the machine.\n\n    Raises:\n        ScipError: A config-file path that resolves outside the repository."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/scip.py::_read_name"}) SET n += {`id`: "sym:repo2graph/scip.py::_read_name", `name`: "_read_name", `qualname`: "_read_name", `kind`: "function", `path`: "repo2graph/scip.py", `lang`: "python", `start_line`: 474, `end_line`: 494, `signature`: "def _read_name(s: str, i: int) -> tuple[str | None, int]:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/scip.py::parse_descriptors"}) SET n += {`id`: "sym:repo2graph/scip.py::parse_descriptors", `name`: "parse_descriptors", `qualname`: "parse_descriptors", `kind`: "function", `path`: "repo2graph/scip.py", `lang`: "python", `start_line`: 497, `end_line`: 547, `signature`: "def parse_descriptors(symbol: str) -> list[tuple[str, str]] | None:", `docstring`: "`[(name, kind), ...]` for a global SCIP symbol, outermost first.\n\n    Follows the grammar in scip.proto: `<scheme> ' ' <manager> ' ' <name> ' '\n    <version> ' ' <descriptor>+`, with `  ` escaping a space inside the first\n    four. `kind` is namespace/type/term/meta/macro/method/parameter/\n    type-parameter. None for a local symbol or anything that does not parse;\n    the parse is a single linear scan whatever the input."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/scip.py::symbol_name"}) SET n += {`id`: "sym:repo2graph/scip.py::symbol_name", `name`: "symbol_name", `qualname`: "symbol_name", `kind`: "function", `path`: "repo2graph/scip.py", `lang`: "python", `start_line`: 550, `end_line`: 561, `signature`: "def symbol_name(symbol: str, display_names: Mapping[str, str] | None = None) -> tuple[str, str]:", `docstring`: "`(name, kind)` of a symbol's last descriptor; `(\"\", \"\")` when unknown.\n\n    A local symbol (`local 3`) carries no name of its own, so it is only\n    nameable through its `SymbolInformation.display_name`."};
