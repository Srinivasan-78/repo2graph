MERGE (n:R2G:`Module` {id: "module:pip"}) SET n += {`id`: "module:pip", `name`: "pip", `external`: true};
MERGE (n:R2G:`File` {id: "file:repo2graph/edgemeta.py"}) SET n += {`id`: "file:repo2graph/edgemeta.py", `name`: "edgemeta.py", `path`: "repo2graph/edgemeta.py", `lang`: "python", `file_type`: "code", `size`: 9464, `lines`: 223, `parse_errors`: 0, `chunked`: false};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/edgemeta.py::counts_as_call"}) SET n += {`id`: "sym:repo2graph/edgemeta.py::counts_as_call", `name`: "counts_as_call", `qualname`: "counts_as_call", `kind`: "function", `path`: "repo2graph/edgemeta.py", `lang`: "python", `start_line`: 83, `end_line`: 98, `signature`: "def counts_as_call(e: dict[str, Any]) -> bool:", `docstring`: "Whether a CALLS edge makes its target \"called\" for rankings/entrypoints.\n\n    Gated on what the edge is, not only its number: an untyped-receiver\n    builtin (`d.get()` -> `_AppCtxGlobals.get`) never counts; a scoped\n    fan-out (overloads, same class/file, through an import) always does; a\n    global-name or same-module guess counts only at or above\n    OVERVIEW_MIN_CALL_CONFIDENCE. An edge without `resolution_kind` (an older\n    index) falls back to the threshold alone."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/edgemeta.py::tree_sitter_method"}) SET n += {`id`: "sym:repo2graph/edgemeta.py::tree_sitter_method", `name`: "tree_sitter_method", `qualname`: "tree_sitter_method", `kind`: "function", `path`: "repo2graph/edgemeta.py", `lang`: "python", `start_line`: 117, `end_line`: 124, `signature`: "def tree_sitter_method(lang: str | None) -> str:", `docstring`: "`tree-sitter/python`, or plain `tree-sitter` when the language is unknown.\n\n    The language is part of the method on purpose: the same edge type carries\n    different weight from different grammars, and a consumer that has learned\n    to distrust, say, the C fallback needs to be able to say so."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/edgemeta.py::evidence"}) SET n += {`id`: "sym:repo2graph/edgemeta.py::evidence", `name`: "evidence", `qualname`: "evidence", `kind`: "function", `path`: "repo2graph/edgemeta.py", `lang`: "python", `start_line`: 127, `end_line`: 138, `signature`: "def evidence(path: str | None, line: int | None) -> dict[str, Any] | None:", `docstring`: "An `{\"path\", \"line\"}` record, or None when there is no line to point at.\n\n    None is a real answer, not a gap to paper over: a CONTAINS edge between a\n    directory and a file is not written down anywhere, so claiming a line for\n    it would be a fabricated citation \u2014 the exact failure this module exists\n    to prevent. Line numbers are 1-based, matching every editor and every\n    `path:line` convention."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/edgemeta.py::file_of"}) SET n += {`id`: "sym:repo2graph/edgemeta.py::file_of", `name`: "file_of", `qualname`: "file_of", `kind`: "function", `path`: "repo2graph/edgemeta.py", `lang`: "python", `start_line`: 141, `end_line`: 152, `signature`: "def file_of(node_id: str) -> str | None:", `docstring`: "The source path a node id refers to, or None for ids without one.\n\n    `sym:pkg/mod.py::Class.method` -> `pkg/mod.py`\n    `file:pkg/mod.py`              -> `pkg/mod.py`\n    `dir:pkg`, `repo:x`, `module:os`, `external:len` -> None"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/edgemeta.py::normalize"}) SET n += {`id`: "sym:repo2graph/edgemeta.py::normalize", `name`: "normalize", `qualname`: "normalize", `kind`: "function", `path`: "repo2graph/edgemeta.py", `lang`: "python", `start_line`: 155, `end_line`: 177, `signature`: "def normalize(edge: dict[str, Any]) -> dict[str, Any]:", `docstring`: "Fill in the standard fields an edge is missing, in a stable key order.\n\n    Called from one place (`Graph.add_edge`) so that an edge type added later\n    cannot ship without them \u2014 the failure mode this replaces was four of the\n    six edge types quietly carrying nothing but a triple. A caller that\n    supplied a value always wins; this only supplies defaults.\n\n    Key order is fixed rather than insertion-ordered because `edges.jsonl` is\n    a committable artifact whose diff humans read, and a field that moves\n    between lines makes every edge look changed."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/edgemeta.py::cite"}) SET n += {`id`: "sym:repo2graph/edgemeta.py::cite", `name`: "cite", `qualname`: "cite", `kind`: "function", `path`: "repo2graph/edgemeta.py", `lang`: "python", `start_line`: 180, `end_line`: 193, `signature`: "def cite(edge: dict[str, Any]) -> str | None:", `docstring`: "`path/file.py:123` for an edge's evidence, or None when it has none.\n\n    The one rendering of a citation, so the CLI, the MCP tools and the\n    explain output cannot each invent their own and drift. `path:line` is the\n    form terminals and editors already make clickable."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/edgemeta.py::describe"}) SET n += {`id`: "sym:repo2graph/edgemeta.py::describe", `name`: "describe", `qualname`: "describe", `kind`: "function", `path`: "repo2graph/edgemeta.py", `lang`: "python", `start_line`: 196, `end_line`: 222, `signature`: "def describe(edge: dict[str, Any]) -> str:", `docstring`: "One human line explaining how much to trust this edge and why.\n\n    Used by `explain`, by the MCP tools and by the `rag` limitations block,\n    so the same edge is characterised identically wherever it surfaces."};
MERGE (n:R2G:`File` {id: "file:repo2graph/embed.py"}) SET n += {`id`: "file:repo2graph/embed.py", `name`: "embed.py", `path`: "repo2graph/embed.py", `lang`: "python", `file_type`: "code", `size`: 12458, `lines`: 308, `parse_errors`: 0, `chunked`: false};
