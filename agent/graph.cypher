MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_a_non_finite_numeric_argument_is_bad_input_not_a_tool_error"}) SET n += {`id`: "sym:tests/test_mcp.py::test_a_non_finite_numeric_argument_is_bad_input_not_a_tool_error", `name`: "test_a_non_finite_numeric_argument_is_bad_input_not_a_tool_error", `qualname`: "test_a_non_finite_numeric_argument_is_bad_input_not_a_tool_error", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1835, `end_line`: 1848, `signature`: "def test_a_non_finite_numeric_argument_is_bad_input_not_a_tool_error(mini_index, arguments):", `docstring`: "`json.loads('{\"k\": 1e999}')` yields inf; the handler used to raise\n    OverflowError out of `_int` and the call became a tool error.", `entrypoint`: true};
