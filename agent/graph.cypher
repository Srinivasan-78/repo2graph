MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_cli_doc_tables_cover_every_flag_of_the_retrieval_commands"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_cli_doc_tables_cover_every_flag_of_the_retrieval_commands", `name`: "test_cli_doc_tables_cover_every_flag_of_the_retrieval_commands", `qualname`: "test_cli_doc_tables_cover_every_flag_of_the_retrieval_commands", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 532, `end_line`: 551, `signature`: "def test_cli_doc_tables_cover_every_flag_of_the_retrieval_commands():", `docstring`: "`build --max-call-candidates` and `--max-nodes` were in --help, not docs/cli.md.\n\n    `rag` was added to this list after its table was found to be missing\n    `--secret-policy`, `--secret-keyword` and `--secret-dir`: the three commands\n    originally covered here were the ones that had drifted once, and `rag` then\n    drifted silently because nothing checked it.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_build_reports_the_resolved_absolute_out_path"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_build_reports_the_resolved_absolute_out_path", `name`: "test_build_reports_the_resolved_absolute_out_path", `qualname`: "test_build_reports_the_resolved_absolute_out_path", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 554, `end_line`: 576, `signature`: "def test_build_reports_the_resolved_absolute_out_path(tmp_path, capsys):", `docstring`: "`build` reports the resolved index path, not the `-o` argument verbatim.\n\n    A relative `out` in the report sends a reader looking in whichever directory\n    they happen to be in. This was previously guarded only by a sample pasted\n    into the quickstart, so it broke silently when that page moved; asserting it\n    against the real report keeps it pinned wherever the docs go.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::_all_real_long_flags"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::_all_real_long_flags", `name`: "_all_real_long_flags", `qualname`: "_all_real_long_flags", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 603, `end_line`: 614, `signature`: "def _all_real_long_flags() -> set[str]:", `docstring`: "Every `--flag` the shipped CLI or the MCP server actually accepts."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_unreleased_changelog_does_not_advertise_flags_that_do_not_exist"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_unreleased_changelog_does_not_advertise_flags_that_do_not_exist", `name`: "test_unreleased_changelog_does_not_advertise_flags_that_do_not_exist", `qualname`: "test_unreleased_changelog_does_not_advertise_flags_that_do_not_exist", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 617, `end_line`: 642, `signature`: "def test_unreleased_changelog_does_not_advertise_flags_that_do_not_exist():", `docstring`: "A removed subsystem left its flags behind in `[Unreleased]` (`647e76f3`).\n\n    The HTTP transport and the OIDC/JWT auth engine were deleted, but the\n    section kept advertising `--http-insecure-ok`, `--trust-proxy`,\n    `--rate-limit-requests` and six more. That section is not just prose:\n    `.github/workflows/publish.yml` reads it and uses it as the GitHub Release\n    body, so the next release would have shipped notes describing flags that\n    fail as unknown arguments.\n\n    The `### Removed` subsection is exempt by design -- naming a flag that no\n    longer exists is exactly its job.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_examples_table_matches_the_recorded_run"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_examples_table_matches_the_recorded_run", `name`: "test_examples_table_matches_the_recorded_run", `qualname`: "test_examples_table_matches_the_recorded_run", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 658, `end_line`: 705, `signature`: "def test_examples_table_matches_the_recorded_run():", `docstring`: "`examples/README.md`'s table must be what `benchmarks/results.json` records.\n\n    That page states every number in it \"came from an actual run recorded in\n    ../benchmarks/results.json, never typed in by hand\" -- but the table is\n    hand-maintained (`generate_examples.py` writes `examples/<id>/README.md` and\n    `results.json`, never the index page), so the claim rested on whoever last\n    regenerated remembering to retype five rows. This is the check that was\n    missing when all five examples were regenerated from 1.6.0 to 2.2.0.\n\n    Deliberately *not* asserted here: that `repo2graph_vers", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_examples_table_matches_the_recorded_run._n"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_examples_table_matches_the_recorded_run._n", `name`: "_n", `qualname`: "test_examples_table_matches_the_recorded_run._n", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 687, `end_line`: 688, `signature`: "def _n(text: str) -> int:", `docstring`: ""};
