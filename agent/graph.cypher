MERGE (n:R2G:`Symbol` {id: "sym:tests/test_destructive_paths.py::test_mcp_refuses_to_auto_build_over_a_foreign_directory"}) SET n += {`id`: "sym:tests/test_destructive_paths.py::test_mcp_refuses_to_auto_build_over_a_foreign_directory", `name`: "test_mcp_refuses_to_auto_build_over_a_foreign_directory", `qualname`: "test_mcp_refuses_to_auto_build_over_a_foreign_directory", `kind`: "function", `path`: "tests/test_destructive_paths.py", `lang`: "python", `start_line`: 60, `end_line`: 73, `signature`: "def test_mcp_refuses_to_auto_build_over_a_foreign_directory(tmp_path):", `docstring`: "The server's auto-build is the third implicit build and the last one left.\n\n    It raises `ValueError`, not `SystemExit`: this runs inside a live stdio\n    server, which must answer the tool call rather than exit the process. A\n    `SystemExit` here would take the client's whole session down.", `entrypoint`: true};
