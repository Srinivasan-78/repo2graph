MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_select_zero_draws_an_empty_graph"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_select_zero_draws_an_empty_graph", `name`: "test_select_zero_draws_an_empty_graph", `qualname`: "test_select_zero_draws_an_empty_graph", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2386, `end_line`: 2410, `signature`: "def test_select_zero_draws_an_empty_graph():", `docstring`: "0 means zero nodes, and `None` is the only spelling for \"no cap\".\n\n    Previously, `max_nodes <= 0` meant no cap.\n    That made \"draw everything\" and \"draw nothing\" -- the two most opposite\n    intentions a caller can have -- share a spelling, so a mistyped or\n    defaulted-to-zero argument silently rendered the *largest* possible page.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_viz_nodes_flag_parses_all_and_rejects_negatives"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_viz_nodes_flag_parses_all_and_rejects_negatives", `name`: "test_viz_nodes_flag_parses_all_and_rejects_negatives", `qualname`: "test_viz_nodes_flag_parses_all_and_rejects_negatives", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2413, `end_line`: 2425, `signature`: "def test_viz_nodes_flag_parses_all_and_rejects_negatives():", `docstring`: "`--viz-nodes all` is the no-cap spelling; a negative is still refused.", `entrypoint`: true};
