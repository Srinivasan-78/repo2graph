MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_is_test_path_matches_components_not_a_path_suffix"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_is_test_path_matches_components_not_a_path_suffix", `name`: "test_is_test_path_matches_components_not_a_path_suffix", `qualname`: "test_is_test_path_matches_components_not_a_path_suffix", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 267, `end_line`: 283, `signature`: "def test_is_test_path_matches_components_not_a_path_suffix():", `docstring`: "A production module whose name merely ends in `test.py` is not a test.\n\n    The suffix form (`path.endswith(\"test.py\")`) classified `latest.py` as test\n    code, which removed every symbol in it from the public API surface, let the\n    file count as its own test coverage, and made every rule that skips tests\n    skip it.", `entrypoint`: true};
