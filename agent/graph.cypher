MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::NodeRecord"}) SET n += {`id`: "sym:repo2graph/schema.py::NodeRecord", `name`: "NodeRecord", `qualname`: "NodeRecord", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 67, `end_line`: 98, `signature`: "class NodeRecord(TypedDict, total=False):", `docstring`: "One line of `nodes.jsonl`. Only `id` and `type` are on every node \u2014\n    see `export.FILE_NOTES[\"nodes.jsonl\"]`, which says the same thing."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::EdgeRecord"}) SET n += {`id`: "sym:repo2graph/schema.py::EdgeRecord", `name`: "EdgeRecord", `qualname`: "EdgeRecord", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 101, `end_line`: 141, `signature`: "class EdgeRecord(TypedDict, total=False):", `docstring`: "One line of `edges.jsonl`.\n\n    `src`/`dst`/`type` are on every edge, and so are `method`, `confidence` and\n    `evidence` \u2014 `Graph.add_edge` runs every edge through `edgemeta.normalize`,\n    which is the chokepoint that makes those three unconditional (see the\n    AGENTS.md rule on edge evidence). `evidence: None` is a real answer for\n    `CONTAINS` and `CO_CHANGE` rather than a missing value.\n\n    Everything below that is edge-type-specific \u2014 see `export.EDGE_TYPES` for\n    which type carries what: `IMPORTS` carries `target`/`internal`, `CALLS` and\n    `CALLS_EXTERNAL` carry the resolution f"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::_NeighbourEdgeRequired"}) SET n += {`id`: "sym:repo2graph/schema.py::_NeighbourEdgeRequired", `name`: "_NeighbourEdgeRequired", `qualname`: "_NeighbourEdgeRequired", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 144, `end_line`: 147, `signature`: "class _NeighbourEdgeRequired(TypedDict):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::NeighbourEdge"}) SET n += {`id`: "sym:repo2graph/schema.py::NeighbourEdge", `name`: "NeighbourEdge", `qualname`: "NeighbourEdge", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 150, `end_line`: 158, `signature`: "class NeighbourEdge(_NeighbourEdgeRequired, total=False):", `docstring`: "One entry of a chunk's `caller_edges`/`callee_edges`/`base_edges` \u2014\n    see `chunks._neighbour_edge`. `confidence` is present only when the edge\n    is an ambiguous `CALLS` edge scoring below 1.0; `IMPORTS`/`DEFINES`/\n    `INHERITS` neighbours never carry it (they have no `confidence` key to\n    read in the first place \u2014 see the `min_confidence` note in `AGENTS.md`)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::ChunkRecord"}) SET n += {`id`: "sym:repo2graph/schema.py::ChunkRecord", `name`: "ChunkRecord", `qualname`: "ChunkRecord", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 161, `end_line`: 184, `signature`: "class ChunkRecord(TypedDict):", `docstring`: "One line of `chunks.jsonl` \u2014 exactly the field list `manifest.json`\n    publishes as `chunk_fields` (`export.write_manifest`), which is the\n    authoritative list this TypedDict mirrors."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::RetrievalResult"}) SET n += {`id`: "sym:repo2graph/schema.py::RetrievalResult", `name`: "RetrievalResult", `qualname`: "RetrievalResult", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 187, `end_line`: 195, `signature`: "class RetrievalResult(ChunkRecord):", `docstring`: "A `ChunkRecord` as returned by `Index.retrieve()` or found in\n    `pack_context()`'s `chunks`/`seeds`/`neighbors` lists: the chunk plus why\n    it was picked. `score` is 0.0 for a graph neighbour, never meaningful to\n    compare across `why` values \u2014 see `Index.retrieve`'s docstring."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::PackResult"}) SET n += {`id`: "sym:repo2graph/schema.py::PackResult", `name`: "PackResult", `qualname`: "PackResult", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 198, `end_line`: 214, `signature`: "class PackResult(TypedDict):", `docstring`: "The return value of `Index.pack_context()`. `budget_chars` is 0 when\n    `budget_tokens` was used instead \u2014 see `pack_context`'s docstring for the\n    accounting rules; this type only documents the shape, not the budget\n    semantics."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::EntrypointRecord"}) SET n += {`id`: "sym:repo2graph/schema.py::EntrypointRecord", `name`: "EntrypointRecord", `qualname`: "EntrypointRecord", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 217, `end_line`: 224, `signature`: "class EntrypointRecord(TypedDict):", `docstring`: "One entry of `manifest.json`'s `entrypoints` list."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::ManifestRecord"}) SET n += {`id`: "sym:repo2graph/schema.py::ManifestRecord", `name`: "ManifestRecord", `qualname`: "ManifestRecord", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 227, `end_line`: 257, `signature`: "class ManifestRecord(TypedDict, total=False):", `docstring`: "`manifest.json`'s shape \u2014 see `export.write_manifest`, the single\n    place that writes it. Every key here is written unconditionally by that\n    function today; `total=False` is precautionary rather than a claim that\n    any of them are actually optional in a current build."};
MERGE (n:R2G:`File` {id: "file:repo2graph/secrets.py"}) SET n += {`id`: "file:repo2graph/secrets.py", `name`: "secrets.py", `path`: "repo2graph/secrets.py", `lang`: "python", `file_type`: "code", `size`: 30513, `lines`: 772, `parse_errors`: 0, `chunked`: false};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/secrets.py::_pem_spans"}) SET n += {`id`: "sym:repo2graph/secrets.py::_pem_spans", `name`: "_pem_spans", `qualname`: "_pem_spans", `kind`: "function", `path`: "repo2graph/secrets.py", `lang`: "python", `start_line`: 281, `end_line`: 306, `signature`: "def _pem_spans(text: str) -> list[tuple[int, int]]:", `docstring`: "Span of every PEM private-key block, in one linear pass.\n\n    Each BEGIN takes the first END that follows it, exactly as the old lazy\n    pattern did, and an unterminated BEGIN yields just its own header -- which\n    is what the old optional group produced. The difference is cost: the ENDs\n    are collected once and consumed by a cursor that only moves forward, so\n    input with no END at all is O(n) instead of O(n*k)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/secrets.py::_json_secret_value_ok"}) SET n += {`id`: "sym:repo2graph/secrets.py::_json_secret_value_ok", `name`: "_json_secret_value_ok", `qualname`: "_json_secret_value_ok", `kind`: "function", `path`: "repo2graph/secrets.py", `lang`: "python", `start_line`: 359, `end_line`: 375, `signature`: "def _json_secret_value_ok(value: str) -> bool:", `docstring`: "True if a JSON value under a secret-ish key looks like a real credential.\n\n    Requires a letter *and* a digit, or three of the four character classes\n    (lower, upper, digit, symbol). That keeps `\"password\": \"Passwort\"` (an i18n\n    label) and `\"tokenType\": \"access-token\"` indexable while every generated\n    password or key -- and every human one with a digit in it -- is caught."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/secrets.py::_json_secret_spans"}) SET n += {`id`: "sym:repo2graph/secrets.py::_json_secret_spans", `name`: "_json_secret_spans", `qualname`: "_json_secret_spans", `kind`: "function", `path`: "repo2graph/secrets.py", `lang`: "python", `start_line`: 378, `end_line`: 387, `signature`: "def _json_secret_spans(text: str) -> list[tuple[int, int]]:", `docstring`: "Spans of the *values* of JSON credential pairs in `text`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/secrets.py::_fingerprint"}) SET n += {`id`: "sym:repo2graph/secrets.py::_fingerprint", `name`: "_fingerprint", `qualname`: "_fingerprint", `kind`: "function", `path`: "repo2graph/secrets.py", `lang`: "python", `start_line`: 398, `end_line`: 401, `signature`: "def _fingerprint(value: str) -> str:", `docstring`: "A short, stable, non-reversible tag for a redacted value."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/secrets.py::redact"}) SET n += {`id`: "sym:repo2graph/secrets.py::redact", `name`: "redact", `qualname`: "redact", `kind`: "function", `path`: "repo2graph/secrets.py", `lang`: "python", `start_line`: 404, `end_line`: 406, `signature`: "def redact(value: str, why: str) -> str:", `docstring`: "Replace a secret with a structured tag useful for correlation."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/secrets.py::_is_secret_path"}) SET n += {`id`: "sym:repo2graph/secrets.py::_is_secret_path", `name`: "_is_secret_path", `qualname`: "_is_secret_path", `kind`: "function", `path`: "repo2graph/secrets.py", `lang`: "python", `start_line`: 418, `end_line`: 522, `signature`: "def _is_secret_path(\n    path: str,\n    extra_keywords: tuple[str, ...] | list[str] | set[str] | None = None,\n    extra_dirs: tuple[str, ...] | list[str] | set[str] | None = None,\n) -> bool:", `docstring`: "Return True if path points to a sensitive file (secrets, keys, credentials)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/secrets.py::scan_content_secrets"}) SET n += {`id`: "sym:repo2graph/secrets.py::scan_content_secrets", `name`: "scan_content_secrets", `qualname`: "scan_content_secrets", `kind`: "function", `path`: "repo2graph/secrets.py", `lang`: "python", `start_line`: 525, `end_line`: 573, `signature`: "def scan_content_secrets(text: str) -> list[tuple[str, int, int]]:", `docstring`: "Scan string for known credential patterns.\n\n    The matched bytes are deliberately *not* returned. Every caller either\n    counts the findings or reports their types, so carrying the plaintext would\n    build a list of live credentials that exists only to be discarded -- one\n    `emit(..., findings=findings)` away from being the leak this module exists\n    to prevent. A caller that genuinely needs the bytes already holds `text`\n    and can slice the span itself.\n\n    Returns:\n        List of (secret_type, start_idx, end_idx) spans into `text`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/secrets.py::redact_content"}) SET n += {`id`: "sym:repo2graph/secrets.py::redact_content", `name`: "redact_content", `qualname`: "redact_content", `kind`: "function", `path`: "repo2graph/secrets.py", `lang`: "python", `start_line`: 576, `end_line`: 614, `signature`: "def redact_content(text: str, policy: str = \"redact-match\") -> tuple[str, int]:", `docstring`: "Apply line-preserving redaction to text containing secrets.\n\n    Args:\n        text: Source code or chunk text.\n        policy: 'redact-match', 'warn-only', or 'off'.\n\n    Returns:\n        (redacted_text, count_of_redacted_secrets)."};
