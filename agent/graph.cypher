MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_add_cochange_caps_the_history_window"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_add_cochange_caps_the_history_window", `name`: "test_add_cochange_caps_the_history_window", `qualname`: "test_add_cochange_caps_the_history_window", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2688, `end_line`: 2702, `signature`: "def test_add_cochange_caps_the_history_window(monkeypatch):", `docstring`: "An absurd --git-history makes git walk the whole history and emit every\n    path in it; it must be clamped before the command is built.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_add_cochange_caps_output_bytes_independent_of_commit_count"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_add_cochange_caps_output_bytes_independent_of_commit_count", `name`: "test_add_cochange_caps_output_bytes_independent_of_commit_count", `qualname`: "test_add_cochange_caps_output_bytes_independent_of_commit_count", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2705, `end_line`: 2721, `signature`: "def test_add_cochange_caps_output_bytes_independent_of_commit_count(monkeypatch):", `docstring`: "ISS-82: MAX_COCHANGE_COMMITS bounds the commit count, not how many\n    bytes a single pathological commit's file list can still emit. A run that\n    returns a giant stdout must be truncated before it is decoded/processed,\n    and the truncation recorded.", `entrypoint`: true, `reach`: 46};
