MERGE (n:R2G:Symbol {id: "sym:tests/test_version_surfaces.py::_rewrite_in_sandbox"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::_rewrite_in_sandbox", `name`: "_rewrite_in_sandbox", `qualname`: "_rewrite_in_sandbox", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 164, `end_line`: 181, `signature`: "def _rewrite_in_sandbox(tmp_path: Path, version: str) -> dict[str, str]:", `docstring`: "Run `rewrite(version)` against copies, never the real checkout.\n\n    `version_surfaces.ROOT` is module state, so it is swapped for the duration\n    and restored -- a test that bumped the working tree and failed halfway would\n    leave the repo claiming a version it never released."};
MERGE (n:R2G:Symbol {id: "sym:tests/test_version_surfaces.py::test_the_sandbox_helper_leaves_the_real_tree_alone"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_the_sandbox_helper_leaves_the_real_tree_alone", `name`: "test_the_sandbox_helper_leaves_the_real_tree_alone", `qualname`: "test_the_sandbox_helper_leaves_the_real_tree_alone", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 184, `end_line`: 190, `signature`: "def test_the_sandbox_helper_leaves_the_real_tree_alone(tmp_path):", `docstring`: "The guard on the guard: if `_rewrite_in_sandbox` ever edited the checkout,\n    every other test here would still pass while corrupting the repo.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_version_surfaces.py::test_major_surfaces_carry_only_the_major"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_major_surfaces_carry_only_the_major", `name`: "test_major_surfaces_carry_only_the_major", `qualname`: "test_major_surfaces_carry_only_the_major", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 193, `end_line`: 202, `signature`: "def test_major_surfaces_carry_only_the_major():", `docstring`: "`kind=\"major\"` exists because publish.yml's floating tag is `vN`. If a\n    major surface started expecting a full version, every bump would write\n    `@v2.1.0` into a `uses:` line and point users at a tag that does not move.", `entrypoint`: true};
