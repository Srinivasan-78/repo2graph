MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_incomplete_utf8_tail"}) SET n += {`id`: "sym:repo2graph/graph.py::_incomplete_utf8_tail", `name`: "_incomplete_utf8_tail", `qualname`: "_incomplete_utf8_tail", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 506, `end_line`: 531, `signature`: "def _incomplete_utf8_tail(buf: bytes) -> int:", `docstring`: "Length of the *truncated* UTF-8 sequence at the end of `buf`, else 0.\n\n    Slices are taken at raw byte offsets, so a multi-byte character can\n    straddle a boundary -- its lead byte ends slice N and its continuation bytes\n    begin slice N+1. Both then fail to decode and *both* were dropped, losing up\n    to 2 x max_file_bytes of source with nothing recording it. Reporting the\n    length of the dangling prefix lets the caller carry those bytes into the next\n    slice so the boundary lands on a character boundary instead.\n\n    Only a genuinely truncated sequence counts. A complete character, "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_chunk_and_parse"}) SET n += {`id`: "sym:repo2graph/graph.py::_chunk_and_parse", `name`: "_chunk_and_parse", `qualname`: "_chunk_and_parse", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 534, `end_line`: 712, `signature`: "def _chunk_and_parse(\n    rel: str, abspath: Path, lang: str | None, config: BuildConfig, size: int\n) -> ReadResult:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_safe_read_bytes"}) SET n += {`id`: "sym:repo2graph/graph.py::_safe_read_bytes", `name`: "_safe_read_bytes", `qualname`: "_safe_read_bytes", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 715, `end_line`: 736, `signature`: "def _safe_read_bytes(path: Path) -> bytes:", `docstring`: "Read file bytes using O_NOFOLLOW where supported to avoid symlink TOCTOU races.\n\n    On POSIX systems, O_NOFOLLOW causes open() to fail if the trailing component is a\n    symlink (protecting against an attacker replacing a discovered regular file with a\n    symlink to a sensitive file before open). On Windows, O_NOFOLLOW is not supported\n    by the OS open(), so standard read flags are used."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_safe_open"}) SET n += {`id`: "sym:repo2graph/graph.py::_safe_open", `name`: "_safe_open", `qualname`: "_safe_open", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 739, `end_line`: 757, `signature`: "def _safe_open(path: Path, mode: str = \"rb\") -> IO[bytes]:", `docstring`: "Open a file with O_NOFOLLOW where supported.\n\n    Like _safe_read_bytes, but returns a file object for chunked reading\n    (used by _chunk_and_parse for files larger than config.max_file_bytes)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_redact_metadata"}) SET n += {`id`: "sym:repo2graph/graph.py::_redact_metadata", `name`: "_redact_metadata", `qualname`: "_redact_metadata", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 760, `end_line`: 779, `signature`: "def _redact_metadata(text: str, g: Graph) -> str:", `docstring`: "Redact secrets in a signature or docstring before it enters the graph.\n\n    These two fields are copied into chunk headers, `nodes.jsonl`, `graph.html`,\n    GraphML and Cypher without passing through the chunk-body scan, so this is\n    the one place that covers every consumer. `warn-only` and `off` deliberately\n    leave the text alone, matching what those policies mean for chunk bodies --\n    `Index._served` is the serve-time net for them."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_read_and_parse"}) SET n += {`id`: "sym:repo2graph/graph.py::_read_and_parse", `name`: "_read_and_parse", `qualname`: "_read_and_parse", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 782, `end_line`: 840, `signature`: "def _read_and_parse(item: tuple[str, Path, str | None, BuildConfig | None]) -> ReadResult:", `docstring`: "Read one file and parse it if it is code.\n\n    Top level, and returns only counts plus the ParsedFile, so a process pool\n    can pickle both the call and its result. The fourth element of the read\n    tuple is the sha256 of the bytes just parsed: it is computed here because\n    this is the only place that holds them, and build() never keeps them."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::_last_segment"}) SET n += {`id`: "sym:repo2graph/graph.py::_last_segment", `name`: "_last_segment", `qualname`: "_last_segment", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 849, `end_line`: 851, `signature`: "def _last_segment(name: str) -> str:", `docstring`: "`pkg.mod.Base` / `ns::Base` / `Base<T>` -> `Base`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::parse_incremental"}) SET n += {`id`: "sym:repo2graph/graph.py::parse_incremental", `name`: "parse_incremental", `qualname`: "parse_incremental", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 854, `end_line`: 917, `signature`: "def parse_incremental(\n    files: Iterable[tuple[str, Path]],\n    jobs: int,\n    cache: dict[str, Record],\n    counts: dict[str, int],\n    config: BuildConfig | None = None,\n) -> list[ReadResult]:", `docstring`: "Read every file, but re-parse only the ones whose bytes changed.\n\n    A file's `ParsedFile` is a pure function of its bytes and its language and\n    nothing else, so reusing one for a file whose sha256 still matches is exact\n    -- not an approximation. Everything downstream of parsing (the global name\n    index, CALLS confidences, INHERITS, entrypoints and reach) is then recomputed\n    from scratch over the full symbol set by `build()`, which is what makes an\n    incremental build byte-identical to a full one instead of merely close.\n\n    Reading is still done for every file: the hash *is* th"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::resolve_jobs"}) SET n += {`id`: "sym:repo2graph/graph.py::resolve_jobs", `name`: "resolve_jobs", `qualname`: "resolve_jobs", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 920, `end_line`: 924, `signature`: "def resolve_jobs(jobs: int) -> int:", `docstring`: "0 means one worker per core, capped so the parent keeps up with results."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::silence_worker_io"}) SET n += {`id`: "sym:repo2graph/graph.py::silence_worker_io", `name`: "silence_worker_io", `qualname`: "silence_worker_io", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 937, `end_line`: 998, `signature`: "def silence_worker_io(watch: Any = None) -> None:", `docstring`: "Detach a parse worker from the stdin/stdout it inherited (#90).\n\n    Runs as the `ProcessPoolExecutor` initializer, i.e. *inside* the worker and\n    once per worker. It exists because of who the parent may be: when the pool\n    is started from `repo2graph-mcp`, fd 0 and fd 1 are the client's JSON-RPC\n    pipes. Measured on Windows (spawn), a worker inherits both for real --\n    `os.write(1, ...)` lands in the parent's stdout pipe, and `os.read(0, 1)`\n    *consumes a byte of the client's request stream*, which is a request the\n    server then waits for forever. Parsing writes to neither today; ", `entrypoint`: true, `reach`: 41};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/graph.py::parse_all"}) SET n += {`id`: "sym:repo2graph/graph.py::parse_all", `name`: "parse_all", `qualname`: "parse_all", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 1001, `end_line`: 1078, `signature`: "def parse_all(\n    files: Iterable[tuple[str, Path]], jobs: int, config: BuildConfig | None = None\n) -> list[ReadResult]:", `docstring`: "Read and parse every file, in discovery order, across `jobs` processes.\n\n    tree-sitter parsing is CPU bound and dominates a large build, so this is\n    the difference between one core and all of them. Order is preserved, which\n    keeps node ids and edge order identical to a serial run.\n\n    Every worker runs `silence_worker_io` first, so the pool is safe to start\n    from a process whose stdin/stdout are a protocol stream rather than a\n    terminal -- which is what `repo2graph-mcp`'s auto-build is (#90).\n\n    Workers are supervised (parsepool.py, #81): a file whose parse runs over\n    `conf"};
