MERGE (n:R2G:`Symbol` {id: "sym:tests/test_store.py::test_build_lock_prefers_the_sibling_when_the_parent_is_writable"}) SET n += {`id`: "sym:tests/test_store.py::test_build_lock_prefers_the_sibling_when_the_parent_is_writable", `name`: "test_build_lock_prefers_the_sibling_when_the_parent_is_writable", `qualname`: "test_build_lock_prefers_the_sibling_when_the_parent_is_writable", `kind`: "function", `path`: "tests/test_store.py", `lang`: "python", `start_line`: 395, `end_line`: 409, `signature`: "def test_build_lock_prefers_the_sibling_when_the_parent_is_writable():", `docstring`: "The fallback must not fire on an ordinary build, or the swap guarantee is lost.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_store.py::test_an_unusable_cache_dir_is_diagnosed_not_a_traceback"}) SET n += {`id`: "sym:tests/test_store.py::test_an_unusable_cache_dir_is_diagnosed_not_a_traceback", `name`: "test_an_unusable_cache_dir_is_diagnosed_not_a_traceback", `qualname`: "test_an_unusable_cache_dir_is_diagnosed_not_a_traceback", `kind`: "function", `path`: "tests/test_store.py", `lang`: "python", `start_line`: 412, `end_line`: 433, `signature`: "def test_an_unusable_cache_dir_is_diagnosed_not_a_traceback(tmp_path, monkeypatch, capsys):", `docstring`: "`REPO2GRAPH_CACHE_DIR` is operator-supplied, so it can be anything.\n\n    Its `mkdir` sits outside the `OSError` handling that guards the primary\n    path, so a file standing where the directory must go escaped as a raw\n    `FileExistsError` -- `_open_index` catches `(KeyError, ValueError,\n    FileNotFoundError, StoreUnusable)`, and that is none of them. Same defect as\n    #501, reached through the env var instead.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_store.py::test_a_cache_that_cannot_be_opened_rebuilds_instead_of_raising"}) SET n += {`id`: "sym:tests/test_store.py::test_a_cache_that_cannot_be_opened_rebuilds_instead_of_raising", `name`: "test_a_cache_that_cannot_be_opened_rebuilds_instead_of_raising", `qualname`: "test_a_cache_that_cannot_be_opened_rebuilds_instead_of_raising", `kind`: "function", `path`: "tests/test_store.py", `lang`: "python", `start_line`: 436, `end_line`: 474, `signature`: "def test_a_cache_that_cannot_be_opened_rebuilds_instead_of_raising(tmp_path, monkeypatch, capsys):", `docstring`: "An `OSError` opening a cache must degrade, not escape.\n\n    The fast path caught only `sqlite3.DatabaseError`, but opening the file can\n    fail for reasons SQLite never sees: another process holding it open at the\n    OS level on Windows, or permissions changed after it was written. Neither is\n    in `_open_index`'s catch list, so it surfaced as a traceback. The right\n    response is the one a corrupt file already gets -- rebuild.\n\n    Simulated, because an OS-level lock SQLite does not translate is not\n    something a test can portably create.", `entrypoint`: true, `reach`: 291};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_store.py::test_a_cache_that_cannot_be_opened_rebuilds_instead_of_raising.flaky_init"}) SET n += {`id`: "sym:tests/test_store.py::test_a_cache_that_cannot_be_opened_rebuilds_instead_of_raising.flaky_init", `name`: "flaky_init", `qualname`: "test_a_cache_that_cannot_be_opened_rebuilds_instead_of_raising.flaky_init", `kind`: "function", `path`: "tests/test_store.py", `lang`: "python", `start_line`: 464, `end_line`: 468, `signature`: "def flaky_init(self, path):", `docstring`: ""};
