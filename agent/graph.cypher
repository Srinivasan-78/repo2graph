MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_ollama_base"}) SET n += {id: "sym:repo2graph/answer.py::_ollama_base", name: "_ollama_base", qualname: "_ollama_base", kind: "function", path: "repo2graph/answer.py", lang: "python", start_line: 137, end_line: 152, signature: "def _ollama_base(value: str) -> str:", docstring: "Normalise OLLAMA_HOST to an http(s) base URL.\n\n    `ollama serve` documents (and exports) the schemeless `127.0.0.1:11434`,\n    which urlopen rejects with `unknown url type: 127.0.0.1`. Default the\n    scheme to http and refuse anything that is not http(s), so a stray\n    `file://` value cannot turn into an urlopen target."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_delta"}) SET n += {id: "sym:repo2graph/answer.py::_delta", name: "_delta", qualname: "_delta", kind: "function", path: "repo2graph/answer.py", lang: "python", start_line: 155, end_line: 177, signature: "def _delta(name: str, raw: bytes) -> str:", docstring: "One streamed line -> the text it carries, or '' if it carries none."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_writer"}) SET n += {id: "sym:repo2graph/answer.py::_writer", name: "_writer", qualname: "_writer", kind: "function", path: "repo2graph/answer.py", lang: "python", start_line: 180, end_line: 206, signature: "def _writer(out=None):", docstring: "A write callable that cannot raise UnicodeEncodeError.\n\n    The Windows console is cp1252: a single non-ASCII token from a model would\n    otherwise abort the whole answer mid-sentence. Bytes go straight to\n    sys.stdout.buffer when there is one; a text stream gets its input folded to\n    what its own encoding can represent first."};
