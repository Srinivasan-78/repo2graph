MERGE (n:R2G:`Symbol` {id: "sym:tests/test_packaging.py::_pyproject"}) SET n += {`id`: "sym:tests/test_packaging.py::_pyproject", `name`: "_pyproject", `qualname`: "_pyproject", `kind`: "function", `path`: "tests/test_packaging.py", `lang`: "python", `start_line`: 18, `end_line`: 23, `signature`: "def _pyproject() -> dict:", `docstring`: "Parse pyproject.toml. `tomllib` is stdlib on the 3.11 floor."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_packaging.py::test_the_py_typed_marker_exists"}) SET n += {`id`: "sym:tests/test_packaging.py::test_the_py_typed_marker_exists", `name`: "test_the_py_typed_marker_exists", `qualname`: "test_the_py_typed_marker_exists", `kind`: "function", `path`: "tests/test_packaging.py", `lang`: "python", `start_line`: 26, `end_line`: 39, `signature`: "def test_the_py_typed_marker_exists():", `docstring`: "PEP 561: without this file, inline annotations are invisible downstream.\n\n    `[tool.mypy] strict = true` checks this package's own source. It says\n    nothing about what a *consumer* of `docs/python-api.md`'s API sees, because\n    a type checker ignores annotations in an installed package that ships no\n    marker -- so every public function read as returning `Any` however strictly\n    it was checked here.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_packaging.py::test_py_typed_is_declared_as_package_data"}) SET n += {`id`: "sym:tests/test_packaging.py::test_py_typed_is_declared_as_package_data", `name`: "test_py_typed_is_declared_as_package_data", `qualname`: "test_py_typed_is_declared_as_package_data", `kind`: "function", `path`: "tests/test_packaging.py", `lang`: "python", `start_line`: 42, `end_line`: 51, `signature`: "def test_py_typed_is_declared_as_package_data():", `docstring`: "The marker has to be in the wheel, not merely in the repository.\n\n    `[tool.setuptools.packages.find]` collects `.py` files only, so a `py.typed`\n    sitting in the source tree is silently dropped from the built distribution\n    without this declaration -- the failure mode is invisible locally and only\n    shows up for someone who `pip install`s the package.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_packaging.py::test_requires_python_matches_the_declared_classifiers"}) SET n += {`id`: "sym:tests/test_packaging.py::test_requires_python_matches_the_declared_classifiers", `name`: "test_requires_python_matches_the_declared_classifiers", `qualname`: "test_requires_python_matches_the_declared_classifiers", `kind`: "function", `path`: "tests/test_packaging.py", `lang`: "python", `start_line`: 54, `end_line`: 77, `signature`: "def test_requires_python_matches_the_declared_classifiers():", `docstring`: "A classifier promising a version `requires-python` excludes is a lie.\n\n    Both are read by installers and by PyPI's own filtering, and they drift in\n    opposite directions: a new interpreter gets added to the CI matrix and the\n    classifiers, and the floor gets raised, and nothing cross-checks them.", `entrypoint`: true};
