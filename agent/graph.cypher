MERGE (n:R2G:`Symbol` {id: "sym:.github/scripts/prod-igy.js::sanitizeAiText"}) SET n += {`id`: "sym:.github/scripts/prod-igy.js::sanitizeAiText", `name`: "sanitizeAiText", `qualname`: "sanitizeAiText", `kind`: "function", `path`: ".github/scripts/prod-igy.js", `lang`: "javascript", `start_line`: 222, `end_line`: 258, `signature`: "function sanitizeAiText(text, maxChars = 4000)", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:.github/scripts/prod-igy.js::buildDiffExcerpt"}) SET n += {`id`: "sym:.github/scripts/prod-igy.js::buildDiffExcerpt", `name`: "buildDiffExcerpt", `qualname`: "buildDiffExcerpt", `kind`: "function", `path`: ".github/scripts/prod-igy.js", `lang`: "javascript", `start_line`: 275, `end_line`: 292, `signature`: "function buildDiffExcerpt(files, diffChars)", `docstring`: "// ---------------------------------------------------------------------------\n// Context assembly\n//\n// The model gets a pre-assembled, bounded document and no tools. It cannot\n// read the repository, run a command, or follow an instruction written in the\n// PR -- the only thing it can do is return one object matching AI_OUTPUT_SCHEMA.\n// That is what makes the token ceiling enforceable and what makes it safe to\n// run under pull_request_target, where the head is fork-controlled: the fork's\n// diff arrives as data via the API and is never checked out or executed.\n// --------------------------"};
