MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_stdio_roundtrip_against_a_repo_with_no_index"}) SET n += {`id`: "sym:tests/test_mcp.py::test_stdio_roundtrip_against_a_repo_with_no_index", `name`: "test_stdio_roundtrip_against_a_repo_with_no_index", `qualname`: "test_stdio_roundtrip_against_a_repo_with_no_index", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1239, `end_line`: 1297, `signature`: "def test_stdio_roundtrip_against_a_repo_with_no_index(mini_repo):", `docstring`: "The onboarding journey, end to end: add the server, ask, get an answer.\n\n    Before auto-build this sequence ended at `error: no repo2graph index found`.\n    It also proves the build does not corrupt the transport -- the handshake and\n    every later frame have to parse as JSON-RPC with a build interleaved.", `entrypoint`: true, `reach`: 58};
