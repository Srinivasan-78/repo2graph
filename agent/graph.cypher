MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graph_streaming.py::test_chunked_read_reports_the_same_digest_size_and_lines_as_a_whole_read"}) SET n += {`id`: "sym:tests/test_graph_streaming.py::test_chunked_read_reports_the_same_digest_size_and_lines_as_a_whole_read", `name`: "test_chunked_read_reports_the_same_digest_size_and_lines_as_a_whole_read", `qualname`: "test_chunked_read_reports_the_same_digest_size_and_lines_as_a_whole_read", `kind`: "function", `path`: "tests/test_graph_streaming.py", `lang`: "python", `start_line`: 71, `end_line`: 93, `signature`: "def test_chunked_read_reports_the_same_digest_size_and_lines_as_a_whole_read(tmp_path):", `docstring`: "The digest and the line count used to come from a bytearray holding the\n    entire file -- the one thing max_file_bytes exists to prevent. They are\n    streamed now, and must still be the same numbers, both against the fixture\n    bytes and against the whole-file reader on the same bytes.", `entrypoint`: true, `reach`: 169};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graph_streaming.py::_invalid_byte_source"}) SET n += {`id`: "sym:tests/test_graph_streaming.py::_invalid_byte_source", `name`: "_invalid_byte_source", `qualname`: "_invalid_byte_source", `kind`: "function", `path`: "tests/test_graph_streaming.py", `lang`: "python", `start_line`: 96, `end_line`: 114, `signature`: "def _invalid_byte_source() -> bytes:", `docstring`: "Three exactly-_LIMIT-byte slices, the middle one not UTF-8 at all.\n\n    0xFF can never begin a UTF-8 sequence, so it is not a truncated character to\n    carry forward -- it must still be skipped, must be counted, and must not\n    stall the loop or cost the slices around it."};
