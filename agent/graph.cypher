MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graph_streaming.py::test_the_byte_cap_stops_the_read_and_the_child_is_reaped"}) SET n += {`id`: "sym:tests/test_graph_streaming.py::test_the_byte_cap_stops_the_read_and_the_child_is_reaped", `name`: "test_the_byte_cap_stops_the_read_and_the_child_is_reaped", `qualname`: "test_the_byte_cap_stops_the_read_and_the_child_is_reaped", `kind`: "function", `path`: "tests/test_graph_streaming.py", `lang`: "python", `start_line`: 168, `end_line`: 188, `signature`: "def test_the_byte_cap_stops_the_read_and_the_child_is_reaped(tmp_path, monkeypatch):", `docstring`: "The cap has to bind *during* the read. A child with far more to say than\n    the cap allows must be cut off mid-write, killed and waited for -- not read\n    to EOF and trimmed afterwards, which is what capture_output=True did.", `entrypoint`: true};
