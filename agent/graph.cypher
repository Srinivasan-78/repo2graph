MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::MCPRequestHandler._dispatch_guarded"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler._dispatch_guarded", `name`: "_dispatch_guarded", `qualname`: "MCPRequestHandler._dispatch_guarded", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 996, `end_line`: 1007, `signature`: "def _dispatch_guarded(self, rpc_id: Any, method: str, params: Any, identity: Any) -> None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::MCPRequestHandler._client_identity"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler._client_identity", `name`: "_client_identity", `qualname`: "MCPRequestHandler._client_identity", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 1011, `end_line`: 1027, `signature`: "def _client_identity(self, identity: Any) -> str:", `docstring`: "A stable key for rate limiting: verified subject, else network identity.\n\n        A real OIDC subject (`sub` claim) distinguishes callers sharing one\n        server; the shared static bearer token cannot distinguish its holders\n        from each other by design (it names no one in particular), so every\n        `bearer`-mode caller collapses to one bucket keyed on the mode itself\n        -- a known, documented limitation, not an oversight. No auth\n        configured at all falls back to network identity."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/http_server.py::MCPRequestHandler._remote_ip"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler._remote_ip", `name`: "_remote_ip", `qualname`: "MCPRequestHandler._remote_ip", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 1029, `end_line`: 1042, `signature`: "def _remote_ip(self) -> str:", `docstring`: "The caller's address, honouring `X-Forwarded-For` only when both\n        `trust_proxy` is enabled AND the connecting peer is itself in\n        `trusted_proxies` (#267). Neither condition alone is enough -- an\n        operator that turns on `trust_proxy` without also naming which peers\n        may set the header would let any direct, untrusted caller claim to be\n        someone else purely by sending the header itself."};
