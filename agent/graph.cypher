MERGE (n:R2G:`Symbol` {id: "sym:tests/test_language_scorecard.py::test_tests_dimension_tracks_the_shipped_tests_edge"}) SET n += {`id`: "sym:tests/test_language_scorecard.py::test_tests_dimension_tracks_the_shipped_tests_edge", `name`: "test_tests_dimension_tracks_the_shipped_tests_edge", `qualname`: "test_tests_dimension_tracks_the_shipped_tests_edge", `kind`: "function", `path`: "tests/test_language_scorecard.py", `lang`: "python", `start_line`: 90, `end_line`: 127, `signature`: "def test_tests_dimension_tracks_the_shipped_tests_edge():", `docstring`: "The `Tests Link` dimension must describe `derived.add_tests_edges`.\n\n    The generator used to hardcode \"TESTS edge type not yet implemented\",\n    which cost all nineteen languages 10% of their weighted total for a\n    feature that had already shipped, and which no test caught because\n    `test_doc_consistency` only checks that the table matches the generator --\n    both were wrong together. These three assertions each break one way of\n    reintroducing that: the edge builder going missing, the notes going back\n    to claiming it is unimplemented, and the CALLS dependency being dropped.", `entrypoint`: true};
