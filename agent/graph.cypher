MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::test_the_backup_suffix_strip_terminates_on_a_hostile_name"}) SET n += {`id`: "sym:tests/test_rag.py::test_the_backup_suffix_strip_terminates_on_a_hostile_name", `name`: "test_the_backup_suffix_strip_terminates_on_a_hostile_name", `qualname`: "test_the_backup_suffix_strip_terminates_on_a_hostile_name", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 1725, `end_line`: 1742, `signature`: "def test_the_backup_suffix_strip_terminates_on_a_hostile_name(path):", `docstring`: "A path is attacker-supplied on every build, and this rule loops.\n\n    Each pass removes at least one character and the loop stops when no suffix\n    matches or nothing but the suffix is left, so a name that is nothing but\n    thousands of stacked suffixes must return rather than recurse without bound.\n    The time bound is deliberately loose (measured ~6ms for the worst of these).", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::test_is_secret_path_163_no_overmatch"}) SET n += {`id`: "sym:tests/test_rag.py::test_is_secret_path_163_no_overmatch", `name`: "test_is_secret_path_163_no_overmatch", `qualname`: "test_is_secret_path_163_no_overmatch", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 1745, `end_line`: 1780, `signature`: "def test_is_secret_path_163_no_overmatch(rag_index):", `docstring`: "ISS-163: _is_secret_path() must not over-match legitimate source files\n    via bare substrings (\"-env\" in name, \"token\" in name), while still\n    excluding genuinely secret-ish paths. Both directions pinned literally\n    per AGENTS.md (\"Tests must pin values, not compare the implementation to\n    itself\"). Verified as a detector: on the pre-fix code this test fails on\n    the \"must NOT match\" assertions for react-app-env.d.ts and tokenizer.json.", `entrypoint`: true};
