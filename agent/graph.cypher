MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_a_refused_request_still_gets_its_reason_with_a_large_body"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_a_refused_request_still_gets_its_reason_with_a_large_body", `name`: "test_a_refused_request_still_gets_its_reason_with_a_large_body", `qualname`: "test_a_refused_request_still_gets_its_reason_with_a_large_body", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 500, `end_line`: 517, `signature`: "def test_a_refused_request_still_gets_its_reason_with_a_large_body(make_server, headers, message):", `docstring`: "The refusal has to reach the client, not just be sent.\n\n    Host and Origin are checked before the body is read, so the handler used to\n    return with the body still sitting in the socket. Closing a socket holding\n    unread bytes sends an RST instead of a FIN, and on Windows the client then\n    raises ConnectionAbortedError (WinError 10053) *instead of* reading the 403 --\n    so the one thing this response exists to say was the thing that got lost.\n\n    The 512 KB body is what makes this deterministic rather than load-dependent.\n    It exceeds the socket buffers, so the client is guaranteed ", `entrypoint`: true};
