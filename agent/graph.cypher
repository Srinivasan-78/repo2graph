MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::sample_repo"}) SET n += {`id`: "sym:tests/test_determinism.py::sample_repo", `name`: "sample_repo", `qualname`: "sample_repo", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 38, `end_line`: 68, `signature`: "def sample_repo(tmp_path):", `docstring`: "A tree with enough shape that ordering has something to get wrong:\n    several directories, several languages, cross-file calls and imports.", `entrypoint`: true};
