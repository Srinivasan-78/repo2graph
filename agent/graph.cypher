MERGE (n:R2G:Symbol {id: "sym:tests/test_viz_safety.py::test_the_data_placeholder_in_a_repo_name_is_not_expanded"}) SET n += {`id`: "sym:tests/test_viz_safety.py::test_the_data_placeholder_in_a_repo_name_is_not_expanded", `name`: "test_the_data_placeholder_in_a_repo_name_is_not_expanded", `qualname`: "test_the_data_placeholder_in_a_repo_name_is_not_expanded", `kind`: "function", `path`: "tests/test_viz_safety.py", `lang`: "python", `start_line`: 83, `end_line`: 98, `signature`: "def test_the_data_placeholder_in_a_repo_name_is_not_expanded(tmp_path):", `docstring`: "A repo named `__R2G_DATA__` must not pull the JSON payload into <h1>.\n\n    The template is filled by a single regex pass over both placeholders, so a\n    replacement's *output* is never rescanned. A naive sequence of `.replace`\n    calls -- title first, then data -- would substitute the whole graph payload\n    into the title and the heading.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_viz_safety.py::test_the_payload_placeholder_still_receives_the_real_data"}) SET n += {`id`: "sym:tests/test_viz_safety.py::test_the_payload_placeholder_still_receives_the_real_data", `name`: "test_the_payload_placeholder_still_receives_the_real_data", `qualname`: "test_the_payload_placeholder_still_receives_the_real_data", `kind`: "function", `path`: "tests/test_viz_safety.py", `lang`: "python", `start_line`: 101, `end_line`: 105, `signature`: "def test_the_payload_placeholder_still_receives_the_real_data(tmp_path):", `docstring`: "The single-pass guard must not break the substitution it protects.", `entrypoint`: true};
