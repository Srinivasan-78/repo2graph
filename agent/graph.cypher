MERGE (n:R2G:`Symbol` {id: "sym:tests/test_query_bounds.py::TestFitLines.test_fit_lines_is_linear_not_quadratic"}) SET n += {`id`: "sym:tests/test_query_bounds.py::TestFitLines.test_fit_lines_is_linear_not_quadratic", `name`: "test_fit_lines_is_linear_not_quadratic", `qualname`: "TestFitLines.test_fit_lines_is_linear_not_quadratic", `kind`: "function", `path`: "tests/test_query_bounds.py", `lang`: "python", `start_line`: 299, `end_line`: 332, `signature`: "def test_fit_lines_is_linear_not_quadratic(self):", `docstring`: "Detector for ISS-345. The old implementation called `measure` once\n        per line either way -- the quadratic cost was in the *string building*,\n        which no call counter can see -- so this has to be a wall-clock test.\n\n        Comparing one input size against a larger one does not work here: the\n        ceiling would be anchored on a small-input timing that is itself\n        quadratic, and the two grow together. Measured, a 10x spread separates\n        the regression from the allowance by only ~2x, which is how a timing\n        test becomes a flake on a shared runner.\n\n        So calibr", `entrypoint`: true};
