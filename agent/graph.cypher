MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cpp_parse.py::test_run_cpp_stops_a_macro_bomb_at_the_limit"}) SET n += {`id`: "sym:tests/test_cpp_parse.py::test_run_cpp_stops_a_macro_bomb_at_the_limit", `name`: "test_run_cpp_stops_a_macro_bomb_at_the_limit", `qualname`: "test_run_cpp_stops_a_macro_bomb_at_the_limit", `kind`: "function", `path`: "tests/test_cpp_parse.py", `lang`: "python", `start_line`: 365, `end_line`: 376, `signature`: "def test_run_cpp_stops_a_macro_bomb_at_the_limit():", `docstring`: "#456 P4: 40 doubling macros expand to ~2^40 tokens. capture_output held\n    all of it in this process before the size check ran; the stream stops one\n    byte past the limit and kills cpp.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cpp_parse.py::test_the_cpp_child_is_refused_memory_past_its_cap"}) SET n += {`id`: "sym:tests/test_cpp_parse.py::test_the_cpp_child_is_refused_memory_past_its_cap", `name`: "test_the_cpp_child_is_refused_memory_past_its_cap", `qualname`: "test_the_cpp_child_is_refused_memory_past_its_cap", `kind`: "function", `path`: "tests/test_cpp_parse.py", `lang`: "python", `start_line`: 379, `end_line`: 419, `signature`: "def test_the_cpp_child_is_refused_memory_past_its_cap():", `docstring`: "The bomb above is stopped for its *output*; this is about what cpp spent\n    getting there, which nothing bounded.\n\n    cpp allocates while expanding and before it prints, so the output bound\n    cannot see it. The same 40-deep doubling bomb drove `cc1` to **32.6 GB** on\n    a CI runner whose commit limit is 33.6 GB -- which never failed a parse. It\n    failed whatever else on the machine asked for memory next, surfacing as\n    unrelated tests dying with `MemoryError`, `WinError 1455` and\n    `RuntimeError: can't start new thread`, on a different test each run.\n\n    Driven with a Python child ", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cpp_parse.py::test_run_cpp_asks_for_the_memory_cap"}) SET n += {`id`: "sym:tests/test_cpp_parse.py::test_run_cpp_asks_for_the_memory_cap", `name`: "test_run_cpp_asks_for_the_memory_cap", `qualname`: "test_run_cpp_asks_for_the_memory_cap", `kind`: "function", `path`: "tests/test_cpp_parse.py", `lang`: "python", `start_line`: 422, `end_line`: 435, `signature`: "def test_run_cpp_asks_for_the_memory_cap():", `docstring`: "Platform-independent half: whatever the OS does with it, `_run_cpp` must\n    request the cap for the pid it just spawned. A refactor that drops the call\n    puts the 32.6 GB back.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cpp_parse.py::test_run_cpp_returns_small_output_whole"}) SET n += {`id`: "sym:tests/test_cpp_parse.py::test_run_cpp_returns_small_output_whole", `name`: "test_run_cpp_returns_small_output_whole", `qualname`: "test_run_cpp_returns_small_output_whole", `kind`: "function", `path`: "tests/test_cpp_parse.py", `lang`: "python", `start_line`: 438, `end_line`: 441, `signature`: "def test_run_cpp_returns_small_output_whole():", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cpp_parse.py::test_include_strip_is_linear_on_nested_comment_lookalikes"}) SET n += {`id`: "sym:tests/test_cpp_parse.py::test_include_strip_is_linear_on_nested_comment_lookalikes", `name`: "test_include_strip_is_linear_on_nested_comment_lookalikes", `qualname`: "test_include_strip_is_linear_on_nested_comment_lookalikes", `kind`: "function", `path`: "tests/test_cpp_parse.py", `lang`: "python", `start_line`: 444, `end_line`: 461, `signature`: "def test_include_strip_is_linear_on_nested_comment_lookalikes():", `docstring`: "CodeQL py/redos: `/\\\\*.*?\\\\*/` inside a repeated group backtracked\n    exponentially on `#/*` followed by many `*//*`.\n\n    CPU time, not wall clock, for the reason `test_secrets_hardening.py`'s\n    three linearity checks give: under `-n auto` on a shared runner,\n    preemption alone can stretch this work past a one-second wall bound, which\n    turns a ReDoS detector into a test of how busy the machine is. The fixed\n    form costs ~0.02 s of CPU here, so the bound keeps its 50x margin while\n    the backtracking form takes seconds.", `entrypoint`: true};
