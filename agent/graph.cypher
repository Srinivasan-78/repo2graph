MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::test_every_surface_path_exists"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_every_surface_path_exists", `name`: "test_every_surface_path_exists", `qualname`: "test_every_surface_path_exists", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 103, `end_line`: 107, `signature`: "def test_every_surface_path_exists():", `docstring`: "A renamed doc silently drops its surface from both the bump and the\n    check, so the table naming a file that is gone must fail loudly.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::test_precommit_hook_fires_for_every_surface_it_guards"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_precommit_hook_fires_for_every_surface_it_guards", `name`: "test_precommit_hook_fires_for_every_surface_it_guards", `qualname`: "test_precommit_hook_fires_for_every_surface_it_guards", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 110, `end_line`: 135, `signature`: "def test_precommit_hook_fires_for_every_surface_it_guards():", `docstring`: "The `version-consistency` hook's `files:` regex must match every path in\n    the surface table.\n\n    The regex is maintained by hand next to a comment claiming it mirrors\n    `version_surfaces.SURFACES`, and it had drifted both ways: it still named\n    four deleted docs, and it had never been updated for `npm/package.json`,\n    `CITATION.cff` or `docs/cli.md`, so a commit touching only those bumped a\n    version the local hook never checked. CI runs `check_version.py`\n    unconditionally, so this was a local-hook gap rather than a missed gate --\n    which is exactly why nothing caught it.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::test_bump_leaves_unrelated_version_strings_alone"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_bump_leaves_unrelated_version_strings_alone", `name`: "test_bump_leaves_unrelated_version_strings_alone", `qualname`: "test_bump_leaves_unrelated_version_strings_alone", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 163, `end_line`: 167, `signature`: "def test_bump_leaves_unrelated_version_strings_alone(tmp_path, path, literal):", `docstring`: "", `entrypoint`: true};
