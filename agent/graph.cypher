MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp_sse.py::test_sse_refuses_unauthenticated_non_loopback_bind"}) SET n += {`id`: "sym:tests/test_mcp_sse.py::test_sse_refuses_unauthenticated_non_loopback_bind", `name`: "test_sse_refuses_unauthenticated_non_loopback_bind", `qualname`: "test_sse_refuses_unauthenticated_non_loopback_bind", `kind`: "function", `path`: "tests/test_mcp_sse.py", `lang`: "python", `start_line`: 238, `end_line`: 250, `signature`: "def test_sse_refuses_unauthenticated_non_loopback_bind(host):", `docstring`: "Binding past loopback without a token must refuse, not serve silently.\n\n    `create_sse_app` installs its auth middleware only `if auth_token`, so the\n    no-token case was not \"open with a warning\" -- it was an unauthenticated\n    index on a routable port with nothing said about it.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp_sse.py::test_sse_allows_loopback_without_a_token"}) SET n += {`id`: "sym:tests/test_mcp_sse.py::test_sse_allows_loopback_without_a_token", `name`: "test_sse_allows_loopback_without_a_token", `qualname`: "test_sse_allows_loopback_without_a_token", `kind`: "function", `path`: "tests/test_mcp_sse.py", `lang`: "python", `start_line`: 254, `end_line`: 258, `signature`: "def test_sse_allows_loopback_without_a_token(host):", `docstring`: "The documented port-forward case stays open: loopback is as private as stdin.", `entrypoint`: true};
