MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/embed.py::make_embedder"}) SET n += {`id`: "sym:repo2graph/embed.py::make_embedder", `name`: "make_embedder", `qualname`: "make_embedder", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 425, `end_line`: 442, `signature`: "def make_embedder(name: str | None = None, backend: str | None = None) -> Embedder:", `docstring`: "The embedder for `backend`, defaulting to sentence-transformers.\n\n    One entry point so the four call sites do not each grow a branch, and so\n    adding a backend is a case here rather than an edit at every caller.\n\n    Raises:\n        ValueError: `backend` is not one of `EMBED_BACKENDS`.\n        RuntimeError: the chosen backend's extra is not installed."};
