MERGE (n:R2G:Symbol {id: "sym:repo2graph/embed.py::Embedder"}) SET n += {`id`: "sym:repo2graph/embed.py::Embedder", `name`: "Embedder", `qualname`: "Embedder", `kind`: "class", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 42, `end_line`: 45, `signature`: "class Embedder(Protocol):", `docstring`: "Anything that turns texts into vectors. sentence-transformers satisfies it."};
