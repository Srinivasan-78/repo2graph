MERGE (n:R2G:Symbol {id: "sym:repo2graph/tasks.py::BuildTask.eta_s"}) SET n += {`id`: "sym:repo2graph/tasks.py::BuildTask.eta_s", `name`: "eta_s", `qualname`: "BuildTask.eta_s", `kind`: "function", `path`: "repo2graph/tasks.py", `lang`: "python", `start_line`: 85, `end_line`: 89, `signature`: "def eta_s(self) -> int:", `docstring`: "Estimated seconds remaining; 0 once the build has settled."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/tasks.py::BuildTask.snapshot"}) SET n += {`id`: "sym:repo2graph/tasks.py::BuildTask.snapshot", `name`: "snapshot", `qualname`: "BuildTask.snapshot", `kind`: "function", `path`: "repo2graph/tasks.py", `lang`: "python", `start_line`: 91, `end_line`: 101, `signature`: "def snapshot(self) -> dict[str, Any]:", `docstring`: "The status document `repo_build_status` returns."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/tasks.py::TaskManager"}) SET n += {`id`: "sym:repo2graph/tasks.py::TaskManager", `name`: "TaskManager", `qualname`: "TaskManager", `kind`: "class", `path`: "repo2graph/tasks.py", `lang`: "python", `start_line`: 104, `end_line`: 226, `signature`: "class TaskManager:", `docstring`: "Owns at most one in-flight build per index directory.\n\n    One per directory, not one per request: two concurrent builds writing the\n    same artifacts would race each other through `atomic_write`, and the loser's\n    partial work would be silently discarded. A second request for a directory\n    already building joins the existing task instead of starting another.\n\n    Args:\n        builder: Callable taking `(repo, out)` that performs the build. Injected\n            so tests need not parse a real repository.\n        estimator: Callable taking `repo` and returning an estimated duration in\n     "};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/tasks.py::TaskManager.__init__"}) SET n += {`id`: "sym:repo2graph/tasks.py::TaskManager.__init__", `name`: "__init__", `qualname`: "TaskManager.__init__", `kind`: "function", `path`: "repo2graph/tasks.py", `lang`: "python", `start_line`: 119, `end_line`: 131, `signature`: "def __init__(\n        self,\n        builder: Callable[[Any, Any], None] | None = None,\n        estimator: Callable[[Any], float] | None = None,\n    ) -> None:", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/tasks.py::TaskManager.start"}) SET n += {`id`: "sym:repo2graph/tasks.py::TaskManager.start", `name`: "start", `qualname`: "TaskManager.start", `kind`: "function", `path`: "repo2graph/tasks.py", `lang`: "python", `start_line`: 133, `end_line`: 161, `signature`: "def start(self, repo: Any, out: Any) -> BuildTask:", `docstring`: "Begin (or join) a background build for `out`.\n\n        Args:\n            repo: Repository to index.\n            out: Index directory to write.\n\n        Returns:\n            The task covering this build, new or already running."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/tasks.py::TaskManager._evict_locked"}) SET n += {`id`: "sym:repo2graph/tasks.py::TaskManager._evict_locked", `name`: "_evict_locked", `qualname`: "TaskManager._evict_locked", `kind`: "function", `path`: "repo2graph/tasks.py", `lang`: "python", `start_line`: 163, `end_line`: 179, `signature`: "def _evict_locked(self) -> None:", `docstring`: "Drop the oldest finished tasks once `_by_id` exceeds\n        MAX_TRACKED_TASKS (ISS-150). Caller must hold self._lock.\n\n        A task still BUILDING is skipped rather than evicted -- an in-flight\n        build must always remain pollable -- so if enough builds are running\n        concurrently, `_by_id` can briefly stay above the cap; it shrinks back\n        as soon as those tasks finish and a new one triggers eviction again."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/tasks.py::TaskManager._estimate"}) SET n += {`id`: "sym:repo2graph/tasks.py::TaskManager._estimate", `name`: "_estimate", `qualname`: "TaskManager._estimate", `kind`: "function", `path`: "repo2graph/tasks.py", `lang`: "python", `start_line`: 181, `end_line`: 185, `signature`: "def _estimate(self, repo: Any) -> float:", `docstring`: ""};
