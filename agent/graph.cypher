MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::_process_chunk_content"}) SET n += {`id`: "sym:repo2graph/chunks.py::_process_chunk_content", `name`: "_process_chunk_content", `qualname`: "_process_chunk_content", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 19, `end_line`: 52, `signature`: "def _process_chunk_content(\n    text: str, nid: str, path: str, policy: str, g: Any\n) -> tuple[str | None, int]:", `docstring`: "Apply secret scanning and redaction policy to chunk text."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::_lines"}) SET n += {`id`: "sym:repo2graph/chunks.py::_lines", `name`: "_lines", `qualname`: "_lines", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 55, `end_line`: 63, `signature`: "def _lines(src: str) -> list[str]:", `docstring`: "Split source the way tree-sitter counts rows: on \"\\\\n\" only.\n\n    str.splitlines() also breaks on U+2028/U+2029/U+0085/\\\\x0b/\\\\x0c, which\n    tree-sitter's row numbers do not; using it here slices symbol chunks\n    from incorrect lines. Drop a trailing \"\\\\r\" per line so\n    CRLF files still index cleanly."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::_keepends_lf"}) SET n += {`id`: "sym:repo2graph/chunks.py::_keepends_lf", `name`: "_keepends_lf", `qualname`: "_keepends_lf", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 66, `end_line`: 78, `signature`: "def _keepends_lf(text: str) -> list[str]:", `docstring`: "Split on \"\\\\n\" only, keeping the newline, so \"\".join(result) == text.\n\n    str.splitlines(keepends=True) also breaks on U+2028/U+2029/U+0085/\\\\x0b/\\\\x0c,\n    which tree-sitter does not treat as row breaks; splitting a chunk there makes\n    its pieces depend on whichever stray separators the source happens to hold.\n    Same \"\\\\n\"-only rule as _lines, but lossless."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::_split"}) SET n += {`id`: "sym:repo2graph/chunks.py::_split", `name`: "_split", `qualname`: "_split", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 81, `end_line`: 83, `signature`: "def _split(text: str, max_chars: int = MAX_CHARS) -> list[str]:", `docstring`: "The parts of `_split_spans`, without their line offsets."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::_split_spans"}) SET n += {`id`: "sym:repo2graph/chunks.py::_split_spans", `name`: "_split_spans", `qualname`: "_split_spans", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 86, `end_line`: 143, `signature`: "def _split_spans(text: str, max_chars: int = MAX_CHARS) -> list[tuple[str, int, int]]:", `docstring`: "Split on line boundaries, each part with the lines it covers.\n\n    Returns `(part, first, last)` per part, where `first` and `last` are\n    inclusive 0-based offsets into the *body's* lines. Callers turn those into\n    source line numbers, because only they know where the body started.\n\n    Every part used to be emitted carrying its parent's whole range, so a\n    243-line function became three chunks all citing `encoders.py:102-344`,\n    two of which begin mid-body with no `def` line in them. `[cite: ...]` is\n    how an agent goes and checks an answer, so a range that does not describe\n    the"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::_conf"}) SET n += {`id`: "sym:repo2graph/chunks.py::_conf", `name`: "_conf", `qualname`: "_conf", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 146, `end_line`: 149, `signature`: "def _conf(text: str, edge: dict[str, Any]) -> str:", `docstring`: "Label a CALLS edge with its confidence when the call was ambiguous."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::_neighbour_edge"}) SET n += {`id`: "sym:repo2graph/chunks.py::_neighbour_edge", `name`: "_neighbour_edge", `qualname`: "_neighbour_edge", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 152, `end_line`: 164, `signature`: "def _neighbour_edge(target: str, edge: dict[str, Any], direction: str) -> dict[str, Any]:", `docstring`: "Structured form of a callers/callees/bases entry.\n\n    Additive sibling of the callers/callees/callees_external string lists --\n    same targets, plus the edge type, direction and (only when < 1.0, to keep\n    the common case small) confidence. IMPORTS/DEFINES/INHERITS edges carry no\n    confidence key, so they fall through the 1.0 default and are never flagged."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::build_chunks"}) SET n += {`id`: "sym:repo2graph/chunks.py::build_chunks", `name`: "build_chunks", `qualname`: "build_chunks", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 167, `end_line`: 169, `signature`: "def build_chunks(g: Any, include_files: bool = True) -> list[dict[str, Any]]:", `docstring`: "All retrieval chunks as a list (stable public API)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::_decode_source"}) SET n += {`id`: "sym:repo2graph/chunks.py::_decode_source", `name`: "_decode_source", `qualname`: "_decode_source", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 172, `end_line`: 182, `signature`: "def _decode_source(raw: bytes) -> str:", `docstring`: "Decode source bytes into string, respecting UTF BOMs (UTF-8, UTF-16, UTF-32) (W10)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::iter_chunks"}) SET n += {`id`: "sym:repo2graph/chunks.py::iter_chunks", `name`: "iter_chunks", `qualname`: "iter_chunks", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 185, `end_line`: 453, `signature`: "def iter_chunks(\n    g: Any, include_files: bool = True, max_chunks: int = 0\n) -> Iterator[dict[str, Any]]:", `docstring`: "Yield chunk dicts ready for embedding, one at a time.\n\n    A generator, not a list: on a large repo the chunk text is the single\n    biggest allocation, so write_jsonl streams it straight to disk instead of\n    holding every chunk in memory at once. Source text is dropped from the cache\n    as soon as the last symbol on a file has been emitted."};
