MERGE (n:R2G:`Symbol` {id: "sym:tests/test_query_bounds.py::TestJsonlBounds.test_read_jsonl_has_no_total_bytes_ceiling"}) SET n += {`id`: "sym:tests/test_query_bounds.py::TestJsonlBounds.test_read_jsonl_has_no_total_bytes_ceiling", `name`: "test_read_jsonl_has_no_total_bytes_ceiling", `qualname`: "TestJsonlBounds.test_read_jsonl_has_no_total_bytes_ceiling", `kind`: "function", `path`: "tests/test_query_bounds.py", `lang`: "python", `start_line`: 96, `end_line`: 110, `signature`: "def test_read_jsonl_has_no_total_bytes_ceiling(self, tmp_path, monkeypatch):", `docstring`: "query.Index's read path is deliberately unbounded in total bytes --\n        CONTRIBUTING.md: a wrong constant there breaks real indexes. Many small,\n        individually-legal lines that sum well past a hypothetical total\n        ceiling must still all come back.", `entrypoint`: true};
