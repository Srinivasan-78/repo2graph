MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::AuditLogger.record"}) SET n += {`id`: "sym:repo2graph/audit.py::AuditLogger.record", `name`: "record", `qualname`: "AuditLogger.record", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 312, `end_line`: 385, `signature`: "def record(\n        self,\n        tool: str,\n        params: Any,\n        identity: str = \"anonymous\",\n        outcome: str = \"success\",\n        duration_ms: int = 0,\n        result_tokens: int = 0,\n        error: str | None = None,\n        event: str = \"tool_call\",\n    ) -> dict[str, Any] | None:", `docstring`: "Write one audit record.\n\n        Args:\n            tool: Tool name the caller asked for.\n            params: The caller's arguments; sanitized before they are written.\n            identity: `sub` claim under OIDC, else \"bearer\" or \"anonymous\".\n            outcome: \"success\", \"auth_rejected\" or \"error\".\n            duration_ms: Wall time the call took, in whole milliseconds.\n            result_tokens: Size of the result handed back, in tokens.\n            error: Message when `outcome` is \"error\", else None.\n            event: Record type; \"tool_call\" unless a caller needs another.\n\n        Retu"};
