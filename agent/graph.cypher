MERGE (n:R2G:Symbol {id: "sym:repo2graph/cli.py::_resolve_vectors"}) SET n += {`id`: "sym:repo2graph/cli.py::_resolve_vectors", `name`: "_resolve_vectors", `qualname`: "_resolve_vectors", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 178, `end_line`: 212, `signature`: "def _resolve_vectors(idx, args, out=None):", `docstring`: "(vectors, embedder) for a query, honouring --vectors / --no-vectors.\n\n    Dense fusion is **opt-in**. Without `--vectors` the ranking is lexical and\n    no embedder is constructed at all: building one loads sentence-transformers\n    and, on a cold cache, downloads ~90 MB of model weights. An unannounced\n    network fetch has no business on the default `query`/`rag` path, whose only\n    promised dependency is tree-sitter -- and an index is a shippable artifact,\n    so \"the index happens to carry vectors\" is not consent to go fetch a model.\n\n    `--vectors` is a demand: if the index has none, th"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cli.py::cmd_embed"}) SET n += {`id`: "sym:repo2graph/cli.py::cmd_embed", `name`: "cmd_embed", `qualname`: "cmd_embed", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 215, `end_line`: 268, `signature`: "def cmd_embed(args):", `docstring`: "Embed an index's chunks, reusing every vector whose text is unchanged.", `entrypoint`: true, `reach`: 51};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cli.py::_reusable_vectors"}) SET n += {`id`: "sym:repo2graph/cli.py::_reusable_vectors", `name`: "_reusable_vectors", `qualname`: "_reusable_vectors", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 271, `end_line`: 293, `signature`: "def _reusable_vectors(npy: Path, model_id: str, hashes: dict) -> dict:", `docstring`: "Stored vectors whose chunk id *and* chunk text are both unchanged.\n\n    A chunk's vector depends on its own text and nothing else, so this is\n    correct by construction \u2014 unlike reusing anything that depends on the\n    graph, whose call confidences are global."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cli.py::cmd_query"}) SET n += {`id`: "sym:repo2graph/cli.py::cmd_query", `name`: "cmd_query", `qualname`: "cmd_query", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 296, `end_line`: 323, `signature`: "def cmd_query(args):", `docstring`: "", `entrypoint`: true, `reach`: 46};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cli.py::_rag_index_dir"}) SET n += {`id`: "sym:repo2graph/cli.py::_rag_index_dir", `name`: "_rag_index_dir", `qualname`: "_rag_index_dir", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 333, `end_line`: 353, `signature`: "def _rag_index_dir(args) -> Path:", `docstring`: "Resolve the `rag` target to an index directory, building it if needed."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cli.py::verify_rag"}) SET n += {`id`: "sym:repo2graph/cli.py::verify_rag", `name`: "verify_rag", `qualname`: "verify_rag", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 356, `end_line`: 424, `signature`: "def verify_rag(idx, out, embed_model=None) -> tuple[dict, str | None]:", `docstring`: "Self-test the dense-retrieval path against one index.\n\n    Answers the four questions that distinguish \"dense retrieval is working\"\n    from \"dense retrieval silently is not\": are there vectors at all, which\n    model and width were they built with, does the active embedder agree, and\n    does every chunk actually have one.\n\n    Args:\n        idx: An open `Index`.\n        out: The index directory, for error messages.\n        embed_model: Model id to check against, or None for the built-in\n            default. Never defaulted to the index's own `model_id` -- comparing\n            a value with i"};
