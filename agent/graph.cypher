MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answer_limits.py::FakeOpener"}) SET n += {`id`: "sym:tests/test_answer_limits.py::FakeOpener", `name`: "FakeOpener", `qualname`: "FakeOpener", `kind`: "class", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 82, `end_line`: 94, `signature`: "class FakeOpener:", `docstring`: "Stand-in for `answer._OPENER`, delegating to a urlopen-shaped callable.\n\n    `stream_answer` goes through an opener rather than `urlopen` so that its\n    redirect handler cannot be bypassed (`_SameOriginRedirect`); patching the\n    opener is what keeps these tests off the network."};
