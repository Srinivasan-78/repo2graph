MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_report_sections_are_the_documented_six"}) SET n += {`id`: "sym:tests/test_index_status.py::test_report_sections_are_the_documented_six", `name`: "test_report_sections_are_the_documented_six", `qualname`: "test_report_sections_are_the_documented_six", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 97, `end_line`: 111, `signature`: "def test_report_sections_are_the_documented_six(built):", `docstring`: "The `--json` report is a public surface: `--json` prints it verbatim.\n\n    Asserted against a real report rather than by scraping the source, so a\n    section that is built but empty, or renamed in one place only, fails here.", `entrypoint`: true};
