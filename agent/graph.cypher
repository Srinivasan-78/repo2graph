MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/auth.py::AuthConfig"}) SET n += {`id`: "sym:repo2graph/auth.py::AuthConfig", `name`: "AuthConfig", `qualname`: "AuthConfig", `kind`: "class", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 631, `end_line`: 659, `signature`: "class AuthConfig:", `docstring`: "How the server authenticates requests.\n\n    Attributes:\n        token: A shared bearer token, or None.\n        oidc_issuer: An OIDC issuer URL, or None.\n        audience: Expected `aud` for OIDC tokens, or None to skip the check.\n        jwks_ttl: Seconds a fetched JWKS is trusted."};
