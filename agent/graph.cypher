MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/embed.py::build_vectors"}) SET n += {`id`: "sym:repo2graph/embed.py::build_vectors", `name`: "build_vectors", `qualname`: "build_vectors", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 163, `end_line`: 191, `signature`: "def build_vectors(\n    chunks, embedder, batch: int = DEFAULT_BATCH, reuse=None\n) -> dict[str, list[float]]:", `docstring`: "{chunk id: vector} for every chunk, embedding in batches.\n\n    `reuse` is an optional {chunk id: vector} of vectors already known to be\n    current (see cli.cmd_embed); those chunks are never handed to the embedder."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/embed.py::write_vectors"}) SET n += {`id`: "sym:repo2graph/embed.py::write_vectors", `name`: "write_vectors", `qualname`: "write_vectors", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 194, `end_line`: 231, `signature`: "def write_vectors(\n    path, vectors, model_id: str, dim: int, chunk_ids, text_hashes=None, build_id: str | None = None\n) -> int:", `docstring`: "Write vectors.npy plus its sibling vectors.meta.json; return the count.\n\n    Row order is `chunk_ids` order, which is chunks.jsonl order, so re-running\n    `embed` over an unchanged index reproduces the file byte for byte.\n\n    `build_id` is the manifest build_id for the index these vectors were built\n    against; stored so `verify_artifacts` and `doctor` can detect when a rebuild\n    has produced a new manifest build_id but `embed` has not been re-run."};
