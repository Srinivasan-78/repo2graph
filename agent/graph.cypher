MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/lock.py::BuildLock._try_fall_back_into_target"}) SET n += {`id`: "sym:repo2graph/lock.py::BuildLock._try_fall_back_into_target", `name`: "_try_fall_back_into_target", `qualname`: "BuildLock._try_fall_back_into_target", `kind`: "function", `path`: "repo2graph/lock.py", `lang`: "python", `start_line`: 121, `end_line`: 136, `signature`: "def _try_fall_back_into_target(self) -> bool:", `docstring`: "Point the lock inside the target directory. True if that is usable.\n\n        Only called once, and only after the sibling path has already failed\n        with a permanently-unwritable errno, so this cannot mask ordinary\n        contention -- a held lock is a successful `open()`, not an `OSError`."};
