MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_tampered_payload_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_tampered_payload_is_refused", `name`: "test_a_tampered_payload_is_refused", `qualname`: "test_a_tampered_payload_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 420, `end_line`: 426, `signature`: "def test_a_tampered_payload_is_refused():", `docstring`: "", `entrypoint`: true, `reach`: 32};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_jwk_with_no_modulus_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_jwk_with_no_modulus_is_refused", `name`: "test_a_jwk_with_no_modulus_is_refused", `qualname`: "test_a_jwk_with_no_modulus_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 429, `end_line`: 438, `signature`: "def test_a_jwk_with_no_modulus_is_refused():", `docstring`: "Issue 238: kty RSA and no `n` indexed straight into the dict.\n\n    `key[\"n\"]` on a key set that never published one is a KeyError, and a\n    KeyError is not an AuthError -- it becomes a 500 on the tool path and a\n    dead handler thread on the refusal path, which catches AuthError only.", `entrypoint`: true, `reach`: 35};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_jwk_with_no_exponent_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_jwk_with_no_exponent_is_refused", `name`: "test_a_jwk_with_no_exponent_is_refused", `qualname`: "test_a_jwk_with_no_exponent_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 441, `end_line`: 445, `signature`: "def test_a_jwk_with_no_exponent_is_refused():", `docstring`: "The same hole, one field over: `e` is read unguarded too.", `entrypoint`: true, `reach`: 35};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_jwk_whose_modulus_is_a_json_number_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_jwk_whose_modulus_is_a_json_number_is_refused", `name`: "test_a_jwk_whose_modulus_is_a_json_number_is_refused", `qualname`: "test_a_jwk_whose_modulus_is_a_json_number_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 448, `end_line`: 458, `signature`: "def test_a_jwk_whose_modulus_is_a_json_number_is_refused():", `docstring`: "Presence is not enough: the parameter has to be the base64url string.\n\n    `str()` of a JSON integer is a run of decimal digits, which base64url\n    either decodes to some unrelated modulus or rejects as bad padding. Either\n    way the key is silently reinterpreted rather than refused, so the type\n    check matters as much as the presence check.", `entrypoint`: true, `reach`: 35};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_jwk_declaring_use_enc_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_jwk_declaring_use_enc_is_refused", `name`: "test_a_jwk_declaring_use_enc_is_refused", `qualname`: "test_a_jwk_declaring_use_enc_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 461, `end_line`: 469, `signature`: "def test_a_jwk_declaring_use_enc_is_refused():", `docstring`: "RFC 7517 \u00a74.2: `{\"use\": \"enc\"}` is the issuer saying \"not for signatures\".\n\n    A JWKS publishes encryption and signing keys side by side, so this is a\n    real shape, not a hypothetical one.", `entrypoint`: true, `reach`: 35};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_jwk_whose_key_ops_excludes_verify_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_jwk_whose_key_ops_excludes_verify_is_refused", `name`: "test_a_jwk_whose_key_ops_excludes_verify_is_refused", `qualname`: "test_a_jwk_whose_key_ops_excludes_verify_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 472, `end_line`: 476, `signature`: "def test_a_jwk_whose_key_ops_excludes_verify_is_refused():", `docstring`: "RFC 7517 \u00a74.3: an explicit op list that omits \"verify\" forbids verifying.", `entrypoint`: true, `reach`: 35};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_jwk_declaring_neither_use_nor_key_ops_still_verifies"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_jwk_declaring_neither_use_nor_key_ops_still_verifies", `name`: "test_a_jwk_declaring_neither_use_nor_key_ops_still_verifies", `qualname`: "test_a_jwk_declaring_neither_use_nor_key_ops_still_verifies", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 479, `end_line`: 490, `signature`: "def test_a_jwk_declaring_neither_use_nor_key_ops_still_verifies():", `docstring`: "Absent means unconstrained, per RFC 7517 \u00a74.2/\u00a74.3.\n\n    This is the ordinary JWKS entry that every real issuer serves, and a\n    purpose check that reads \"absent\" as \"forbidden\" would lock out all of\n    them. Pinned as its own case because the two rejections above pass just as\n    happily under a check that rejects everything.", `entrypoint`: true, `reach`: 35};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_jwk_declaring_use_sig_and_a_verify_op_is_accepted"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_jwk_declaring_use_sig_and_a_verify_op_is_accepted", `name`: "test_a_jwk_declaring_use_sig_and_a_verify_op_is_accepted", `qualname`: "test_a_jwk_declaring_use_sig_and_a_verify_op_is_accepted", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 493, `end_line`: 496, `signature`: "def test_a_jwk_declaring_use_sig_and_a_verify_op_is_accepted():", `docstring`: "The positive declaration is honoured, not merely tolerated.", `entrypoint`: true, `reach`: 35};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_jwks_is_cached_between_calls"}) SET n += {`id`: "sym:tests/test_auth.py::test_jwks_is_cached_between_calls", `name`: "test_jwks_is_cached_between_calls", `qualname`: "test_jwks_is_cached_between_calls", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 502, `end_line`: 506, `signature`: "def test_jwks_is_cached_between_calls():", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_an_expired_ttl_refetches"}) SET n += {`id`: "sym:tests/test_auth.py::test_an_expired_ttl_refetches", `name`: "test_an_expired_ttl_refetches", `qualname`: "test_an_expired_ttl_refetches", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 509, `end_line`: 530, `signature`: "def test_an_expired_ttl_refetches():", `docstring`: "Keys are re-read once the TTL has elapsed.\n\n    The clock is injected rather than slept through. An earlier version used\n    ttl=0.0 and two back-to-back calls, which passes only if the monotonic\n    clock ticks between them -- so it passed on one machine and failed on\n    another, where Windows falls back to GetTickCount64's ~15.6ms granularity\n    and both calls read the same instant.", `entrypoint`: true, `reach`: 33};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_zero_ttl_never_caches"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_zero_ttl_never_caches", `name`: "test_a_zero_ttl_never_caches", `qualname`: "test_a_zero_ttl_never_caches", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 533, `end_line`: 545, `signature`: "def test_a_zero_ttl_never_caches():", `docstring`: "`ttl=0` means \"do not cache\", whatever the clock's resolution.\n\n    With a strict `>` comparison this promise silently depended on the clock\n    ticking between calls, which is exactly the flake above in its other form:\n    a configuration that says \"never cache\" would keep serving stale keys.", `entrypoint`: true, `reach`: 32};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_an_unknown_kid_refetches_exactly_once_then_fails"}) SET n += {`id`: "sym:tests/test_auth.py::test_an_unknown_kid_refetches_exactly_once_then_fails", `name`: "test_an_unknown_kid_refetches_exactly_once_then_fails", `qualname`: "test_an_unknown_kid_refetches_exactly_once_then_fails", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 548, `end_line`: 556, `signature`: "def test_an_unknown_kid_refetches_exactly_once_then_fails():", `docstring`: "Key rotation costs one refetch; a kid flood must not cost one each.", `entrypoint`: true, `reach`: 33};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_the_same_unknown_kid_does_not_refetch_on_repeat_lookups"}) SET n += {`id`: "sym:tests/test_auth.py::test_the_same_unknown_kid_does_not_refetch_on_repeat_lookups", `name`: "test_the_same_unknown_kid_does_not_refetch_on_repeat_lookups", `qualname`: "test_the_same_unknown_kid_does_not_refetch_on_repeat_lookups", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 559, `end_line`: 573, `signature`: "def test_the_same_unknown_kid_does_not_refetch_on_repeat_lookups():", `docstring`: "ISS-195: a negative kid lookup is remembered, so N repeats cost 1 fetch.\n\n    The previous test asked once. Asking again is what distinguishes a\n    per-request refetch (the bug) from a per-kid cap (the control the\n    module docstring claimed).", `entrypoint`: true, `reach`: 33};
MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_distinct_unknown_kids_share_a_min_refresh_interval"}) SET n += {`id`: "sym:tests/test_auth.py::test_distinct_unknown_kids_share_a_min_refresh_interval", `name`: "test_distinct_unknown_kids_share_a_min_refresh_interval", `qualname`: "test_distinct_unknown_kids_share_a_min_refresh_interval", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 576, `end_line`: 591, `signature`: "def test_distinct_unknown_kids_share_a_min_refresh_interval():", `docstring`: "ISS-195: a stream of distinct kids must not force one fetch each.", `entrypoint`: true, `reach`: 34};
