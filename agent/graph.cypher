MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_a_1x_sdk_is_refused_at_startup_not_hung"}) SET n += {`id`: "sym:tests/test_mcp.py::test_a_1x_sdk_is_refused_at_startup_not_hung", `name`: "test_a_1x_sdk_is_refused_at_startup_not_hung", `qualname`: "test_a_1x_sdk_is_refused_at_startup_not_hung", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 988, `end_line`: 1004, `signature`: "def test_a_1x_sdk_is_refused_at_startup_not_hung(monkeypatch):", `docstring`: "#407: mcp 1.x hangs on the server's first tool call rather than\n    erroring, deterministically (~4 min timeout under 1.30.0). Dropping 1.x\n    support (#291) means the version is checked here, at startup, instead of\n    only the API surface -- so the failure is a sentence, not a hang.\n\n    Detector: before the fix, `_require_sdk()` only checked\n    `hasattr(Server, \"list_tools\")`, which mcp 1.x satisfies, so this SDK\n    passed the guard and `serve()` drove the (hanging) 1.x branch.", `entrypoint`: true};
