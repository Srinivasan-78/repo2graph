MERGE (n:R2G:`Symbol` {id: "sym:scripts/llm_agent_eval.py::cited_lines"}) SET n += {`id`: "sym:scripts/llm_agent_eval.py::cited_lines", `name`: "cited_lines", `qualname`: "cited_lines", `kind`: "function", `path`: "scripts/llm_agent_eval.py", `lang`: "python", `start_line`: 326, `end_line`: 342, `signature`: "def cited_lines(transcript: str, root: Path) -> dict[str, set[int]]:", `docstring`: "Source lines the model actually saw, per path, from `[cite: p:a-b]` heads.\n\n    Scored on the citations in the transcript rather than on the model's prose:\n    a `[cite:]` header is emitted by the tools themselves, so it says what the\n    model was *shown*, which is what the index is responsible for. Whether the\n    model then read it correctly is a different question and not this one."};
