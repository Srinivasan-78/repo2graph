MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::make_handler"}) SET n += {`id`: "sym:repo2graph/http_server.py::make_handler", `name`: "make_handler", `qualname`: "make_handler", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 692, `end_line`: 738, `signature`: "def make_handler(\n    index_dir: Any,\n    repo: Any = None,\n    auth_config: AuthConfig | None = None,\n    audit: AuditLogger | None = None,\n    cache: Any = None,\n    base_url: str = \"http://127.0.0.1:8719\",\n    publish_cimd: bool = False,\n    opener: Callable[[str], Any] | None = None,\n    tasks: ", `docstring`: "Build a request-handler class bound to this server's configuration.\n\n    Args:\n        index_dir: Index directory every tool answers from.\n        repo: Repository to auto-build from, or None.\n        auth_config: An `AuthConfig`; defaults to no authentication.\n        audit: An `AuditLogger`; defaults to a fresh one at level \"all\".\n        cache: A `ResultCache`, or None.\n        base_url: Externally reachable base URL, used by the CIMD document.\n        publish_cimd: Whether `/.well-known/oauth-client-metadata` is served.\n        opener: JSON fetcher for OIDC discovery, injected by tests.\n  "};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::make_handler._Handler"}) SET n += {`id`: "sym:repo2graph/http_server.py::make_handler._Handler", `name`: "_Handler", `qualname`: "make_handler._Handler", `kind`: "class", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 724, `end_line`: 725, `signature`: "class _Handler(MCPRequestHandler):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::MCPHTTPServer"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPHTTPServer", `name`: "MCPHTTPServer", `qualname`: "MCPHTTPServer", `kind`: "class", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 741, `end_line`: 765, `signature`: "class MCPHTTPServer(ThreadingHTTPServer):", `docstring`: "`ThreadingHTTPServer` whose error reporting stays on one line.\n\n    socketserver's `handle_error` answers any exception that escapes a request\n    with a dashed banner and a full Python traceback on stderr. stderr is the\n    stream `repo2graph.events` promises is strict JSON-lines -- a SIEM tailing\n    it parses one record per line -- so the default printer turns every\n    escaping error into a dozen lines that parse as none. A handler failure is\n    precisely when an operator most needs the record to be machine-readable.\n\n    This lives on the server and not on the handler because socketserve"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::MCPHTTPServer.handle_error"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPHTTPServer.handle_error", `name`: "handle_error", `qualname`: "MCPHTTPServer.handle_error", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 757, `end_line`: 765, `signature`: "def handle_error(self, request: Any, client_address: Any) -> None:", `docstring`: "Report one escaping handler exception as a single JSON event.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::HTTPTransport"}) SET n += {`id`: "sym:repo2graph/http_server.py::HTTPTransport", `name`: "HTTPTransport", `qualname`: "HTTPTransport", `kind`: "class", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 768, `end_line`: 883, `signature`: "class HTTPTransport:", `docstring`: "The HTTP server, on a daemon thread so it never blocks stdio.\n\n    Args:\n        index_dir: Index directory to serve.\n        repo: Repository to auto-build from, or None.\n        host: Bind address; loopback unless deliberately widened.\n        port: Bind port. 0 asks the OS for a free one, which tests use.\n        auth_config: An `AuthConfig`.\n        audit: An `AuditLogger`.\n        cache: A `ResultCache`, or None.\n        publish_cimd: Whether to serve the client metadata document.\n        opener: JSON fetcher for OIDC discovery, injected by tests.\n        allow_hosts: Extra bare hostnames"};
