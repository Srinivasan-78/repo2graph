MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp/retrieval.py::_cochange_records"}) SET n += {`id`: "sym:repo2graph/mcp/retrieval.py::_cochange_records", `name`: "_cochange_records", `qualname`: "_cochange_records", `kind`: "function", `path`: "repo2graph/mcp/retrieval.py", `lang`: "python", `start_line`: 215, `end_line`: 229, `signature`: "def _cochange_records(index: Index, node_id: str, limit: int) -> list[dict[str, Any]]:", `docstring`: "Files co-edited with `node_id`'s file. A symbol has no CO_CHANGE edge of its\n    own -- history is recorded per file -- so this is the one place JSON callers\n    get it for a symbol without a second call."};
