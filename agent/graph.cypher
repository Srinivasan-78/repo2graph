MERGE (n:R2G:Symbol {id: "sym:repo2graph/changelog.py::_edge_line"}) SET n += {`id`: "sym:repo2graph/changelog.py::_edge_line", `name`: "_edge_line", `qualname`: "_edge_line", `kind`: "function", `path`: "repo2graph/changelog.py", `lang`: "python", `start_line`: 120, `end_line`: 123, `signature`: "def _edge_line(e: dict[str, Any]) -> str:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/changelog.py::_section"}) SET n += {`id`: "sym:repo2graph/changelog.py::_section", `name`: "_section", `qualname`: "_section", `kind`: "function", `path`: "repo2graph/changelog.py", `lang`: "python", `start_line`: 126, `end_line`: 130, `signature`: "def _section(lines: list[str], count: int) -> list[str]:", `docstring`: "Cap a section at MAX_ITEMS lines, appending the \"... and N more\" line."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/changelog.py::build_changelog_markdown"}) SET n += {`id`: "sym:repo2graph/changelog.py::build_changelog_markdown", `name`: "build_changelog_markdown", `qualname`: "build_changelog_markdown", `kind`: "function", `path`: "repo2graph/changelog.py", `lang`: "python", `start_line`: 133, `end_line`: 206, `signature`: "def build_changelog_markdown(\n    g: Graph,\n    prev_nodes: list[dict[str, Any]],\n    prev_edges: list[dict[str, Any]],\n    short_sha: str | None,\n    prev_short_sha: str | None,\n    build_date: str,\n) -> str:", `docstring`: "The CHANGELOG.md body for a build that has a previous index to diff.\n\n    `g` is the just-built `Graph` (its `.nodes`/`.edges` are the *new* state);\n    `prev_nodes`/`prev_edges` is the snapshot `previous_state` took before this\n    build's `dump_all` overwrote them."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/changelog.py::write_changelog"}) SET n += {`id`: "sym:repo2graph/changelog.py::write_changelog", `name`: "write_changelog", `qualname`: "write_changelog", `kind`: "function", `path`: "repo2graph/changelog.py", `lang`: "python", `start_line`: 209, `end_line`: 233, `signature`: "def write_changelog(\n    outdir: str | Path,\n    g: Graph,\n    prev_state: tuple[list[dict[str, Any]], list[dict[str, Any]]] | None,\n    short_sha: str | None,\n    prev_short_sha: str | None,\n    build_date: str,\n) -> Path:", `docstring`: "Write `human/CHANGELOG.md` via the shared `atomic_write`.\n\n    `prev_state` is `previous_state(outdir)`'s return value, captured before\n    `dump_all` ran; None means \"no previous build\" and produces the\n    `INITIAL_MESSAGE` file verbatim."};
MERGE (n:R2G:File {id: "file:repo2graph/chunks.py"}) SET n += {`id`: "file:repo2graph/chunks.py", `name`: "chunks.py", `path`: "repo2graph/chunks.py", `lang`: "python", `file_type`: "code", `size`: 11173, `lines`: 282, `parse_errors`: 0, `chunked`: false};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/chunks.py::_lines"}) SET n += {`id`: "sym:repo2graph/chunks.py::_lines", `name`: "_lines", `qualname`: "_lines", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 17, `end_line`: 25, `signature`: "def _lines(src: str) -> list[str]:", `docstring`: "Split source the way tree-sitter counts rows: on \"\\\\n\" only.\n\n    str.splitlines() also breaks on U+2028/U+2029/U+0085/\\\\x0b/\\\\x0c, which\n    tree-sitter's row numbers do not; using it here slices every later symbol's\n    chunk from the wrong lines (ISS-22). Drop a trailing \"\\\\r\" per line so\n    CRLF files still index cleanly."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/chunks.py::_keepends_lf"}) SET n += {`id`: "sym:repo2graph/chunks.py::_keepends_lf", `name`: "_keepends_lf", `qualname`: "_keepends_lf", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 28, `end_line`: 40, `signature`: "def _keepends_lf(text: str) -> list[str]:", `docstring`: "Split on \"\\\\n\" only, keeping the newline, so \"\".join(result) == text.\n\n    str.splitlines(keepends=True) also breaks on U+2028/U+2029/U+0085/\\\\x0b/\\\\x0c,\n    which tree-sitter does not treat as row breaks; splitting a chunk there makes\n    its pieces depend on whichever stray separators the source happens to hold\n    (the ISS-22 bug class). Same \"\\\\n\"-only rule as _lines, but lossless."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/chunks.py::_split"}) SET n += {`id`: "sym:repo2graph/chunks.py::_split", `name`: "_split", `qualname`: "_split", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 43, `end_line`: 75, `signature`: "def _split(text: str, max_chars: int = MAX_CHARS):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/chunks.py::_conf"}) SET n += {`id`: "sym:repo2graph/chunks.py::_conf", `name`: "_conf", `qualname`: "_conf", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 78, `end_line`: 81, `signature`: "def _conf(text: str, edge: dict) -> str:", `docstring`: "Label a CALLS edge with its confidence when the call was ambiguous."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/chunks.py::_neighbour_edge"}) SET n += {`id`: "sym:repo2graph/chunks.py::_neighbour_edge", `name`: "_neighbour_edge", `qualname`: "_neighbour_edge", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 84, `end_line`: 96, `signature`: "def _neighbour_edge(target: str, edge: dict, direction: str) -> dict:", `docstring`: "Structured form of a callers/callees/bases entry.\n\n    Additive sibling of the callers/callees/callees_external string lists --\n    same targets, plus the edge type, direction and (only when < 1.0, to keep\n    the common case small) confidence. IMPORTS/DEFINES/INHERITS edges carry no\n    confidence key, so they fall through the 1.0 default and are never flagged."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/chunks.py::build_chunks"}) SET n += {`id`: "sym:repo2graph/chunks.py::build_chunks", `name`: "build_chunks", `qualname`: "build_chunks", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 99, `end_line`: 101, `signature`: "def build_chunks(g, include_files: bool = True) -> list[dict]:", `docstring`: "All retrieval chunks as a list (stable public API)."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/chunks.py::iter_chunks"}) SET n += {`id`: "sym:repo2graph/chunks.py::iter_chunks", `name`: "iter_chunks", `qualname`: "iter_chunks", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 104, `end_line`: 281, `signature`: "def iter_chunks(g, include_files: bool = True):", `docstring`: "Yield chunk dicts ready for embedding, one at a time.\n\n    A generator, not a list: on a large repo the chunk text is the single\n    biggest allocation, so write_jsonl streams it straight to disk instead of\n    holding every chunk in memory at once. Source text is dropped from the cache\n    as soon as the last symbol on a file has been emitted."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/chunks.py::iter_chunks.source_of"}) SET n += {`id`: "sym:repo2graph/chunks.py::iter_chunks.source_of", `name`: "source_of", `qualname`: "iter_chunks.source_of", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 119, `end_line`: 125, `signature`: "def source_of(path: str) -> str:", `docstring`: ""};
