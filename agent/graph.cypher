MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/scip.py::ScipResolver.calls"}) SET n += {`id`: "sym:repo2graph/scip.py::ScipResolver.calls", `name`: "calls", `qualname`: "ScipResolver.calls", `kind`: "function", `path`: "repo2graph/scip.py", `lang`: "python", `start_line`: 666, `end_line`: 717, `signature`: "def calls(\n        self,\n        rel: str,\n        sid: str,\n        callee: str,\n        count: int,\n        call_kind: str,\n        details: list[dict[str, Any]],\n    ) -> tuple[int, int | None]:", `docstring`: "Resolve the call sites of `callee` in `sid` that the index covers.\n\n        Emits the exact edges itself and returns what is left for the\n        heuristic tiers: `(remaining call sites, first line among them)`, the\n        line None when unchanged or unknown. `(count, None)` for a file the\n        index does not cover."};
