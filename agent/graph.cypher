MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.score"}) SET n += {id: "sym:repo2graph/query.py::Index.score", name: "score", qualname: "Index.score", kind: "function", path: "repo2graph/query.py", lang: "python", start_line: 217, end_line: 231, signature: "def score(self, query: str) -> list[tuple[float, int]]:", docstring: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index._boost_identifiers"}) SET n += {id: "sym:repo2graph/query.py::Index._boost_identifiers", name: "_boost_identifiers", qualname: "Index._boost_identifiers", kind: "function", path: "repo2graph/query.py", lang: "python", start_line: 233, end_line: 253, signature: "def _boost_identifiers(self, query: str, acc: dict) -> None:", docstring: "Multiply the score of chunks the query names outright.\n\n        A pinpoint query like `normalize_provider` should return the symbol, not\n        the prose that happens to repeat the word. Only whole identifiers from\n        the query count (not tokenize()'s sub-words), and only chunks BM25\n        already scored are touched, so score()'s invariants are unchanged."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.score_rrf"}) SET n += {id: "sym:repo2graph/query.py::Index.score_rrf", name: "score_rrf", qualname: "Index.score_rrf", kind: "function", path: "repo2graph/query.py", lang: "python", start_line: 255, end_line: 284, signature: "def score_rrf(self, query: str, vectors=None, embedder=None) -> list[tuple[float, int]]:", docstring: "BM25 fused with an optional dense ranking by reciprocal rank fusion.\n\n        With neither `vectors` nor `embedder` this is exactly `score()` \u2014 the\n        zero-dependency default path. `embedder` is any object with\n        `.encode(list[str]) -> list[sequence[float]]` (sentence-transformers\n        satisfies it); `vectors` is a mapping of chunk index -> vector, which may\n        carry the query vector under the key \"query\". Similarity is computed in\n        plain Python, so no optional dependency is imported here either."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index._vectors_for"}) SET n += {id: "sym:repo2graph/query.py::Index._vectors_for", name: "_vectors_for", qualname: "Index._vectors_for", kind: "function", path: "repo2graph/query.py", lang: "python", start_line: 286, end_line: 301, signature: "def _vectors_for(self, query, candidates, vectors, embedder):", docstring: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.expand"}) SET n += {id: "sym:repo2graph/query.py::Index.expand", name: "expand", qualname: "Index.expand", kind: "function", path: "repo2graph/query.py", lang: "python", start_line: 303, end_line: 346, signature: "def expand(self, seed_nodes, hops=1, edge_types=None, per_hop=6,\n               min_confidence=1.0, edge_dirs=None):", docstring: "Walk `hops` edges out from `seed_nodes`, newest frontier first.\n\n        `min_confidence` gates CALLS edges only: call resolution is name-based\n        and an overloaded name fans out to several candidates at 1/n confidence,\n        while IMPORTS/DEFINES/INHERITS carry no `confidence` key at all and must\n        never be dropped by the gate. `edge_dirs` maps an edge type to the\n        directions worth following (see DEFAULT_EDGE_DIRS)."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.retrieve"}) SET n += {id: "sym:repo2graph/query.py::Index.retrieve", name: "retrieve", qualname: "Index.retrieve", kind: "function", path: "repo2graph/query.py", lang: "python", start_line: 348, end_line: 396, signature: "def retrieve(self, query: str, k: int = 8, hops: int = 1, budget_chars: int = 24000,\n                 *, min_confidence: float | None = None):", docstring: "Lexical seeds plus their graph neighbours, budgeted on chunk text.\n\n        `budget_chars` bounds the sum of the returned chunks' `text` only \u2014 it\n        says nothing about how a caller renders them. pack_context() uses the\n        other model (the whole rendered markdown); do not unify the two.\n        `min_confidence=None` means \"do not filter CALLS on confidence\", which is\n        this method's historical behaviour."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.map_prepend"}) SET n += {id: "sym:repo2graph/query.py::Index.map_prepend", name: "map_prepend", qualname: "Index.map_prepend", kind: "function", path: "repo2graph/query.py", lang: "python", start_line: 400, end_line: 423, signature: "def map_prepend(self) -> str:", docstring: "The repo map: the prose overview plus the top entry points.\n\n        Entry points come straight off `manifest[\"entrypoints\"]`, which\n        export.write_manifest already sorted by reach. Both sources are\n        optional; with neither, this is the empty string."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::Index.pack_context"}) SET n += {id: "sym:repo2graph/query.py::Index.pack_context", name: "pack_context", qualname: "Index.pack_context", kind: "function", path: "repo2graph/query.py", lang: "python", start_line: 425, end_line: 525, signature: "def pack_context(self, query: str, k: int = 8, hops: int = 1, budget_chars: int = 24000,\n                     min_confidence: float = 1.0, expand_graph: bool = True,\n                     vectors=None, embedder=None, exclude_secrets: bool = False) -> dict:", docstring: "An agent-ready markdown pack: repo map, `---`, then cited chunks.\n\n        `budget_chars` bounds the WHOLE returned markdown \u2014 map prepend, `---`\n        separator and every `### [cite: ...]` header included \u2014 unlike\n        retrieve(), which budgets chunk text only. `budget_chars <= 0` means\n        unbounded. Spending order is map (capped at MAP_BUDGET_FRAC of the\n        budget), then seeds in score order at full text, then graph neighbours\n        at full text or, if that no longer fits, compressed to their header\n        lines plus the signature line. Nothing is truncated mid-line."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::_first"}) SET n += {id: "sym:repo2graph/query.py::_first", name: "_first", qualname: "_first", kind: "function", path: "repo2graph/query.py", lang: "python", start_line: 528, end_line: 531, signature: "def _first(seq):", docstring: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::_cosine"}) SET n += {id: "sym:repo2graph/query.py::_cosine", name: "_cosine", qualname: "_cosine", kind: "function", path: "repo2graph/query.py", lang: "python", start_line: 534, end_line: 543, signature: "def _cosine(a, b) -> float:", docstring: "Cosine similarity over any two sequences of floats (no numpy needed)."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::_fit_lines"}) SET n += {id: "sym:repo2graph/query.py::_fit_lines", name: "_fit_lines", qualname: "_fit_lines", kind: "function", path: "repo2graph/query.py", lang: "python", start_line: 546, end_line: 557, signature: "def _fit_lines(text: str, limit: int) -> str:", docstring: "The longest whole-line prefix of `text` that fits in `limit` characters."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::_compress"}) SET n += {id: "sym:repo2graph/query.py::_compress", name: "_compress", qualname: "_compress", kind: "function", path: "repo2graph/query.py", lang: "python", start_line: 560, end_line: 575, signature: "def _compress(text: str) -> str:", docstring: "A chunk reduced to its `#` metadata header plus the signature line.\n\n    chunks.build_chunks always emits `# file:` / `# <kind>:` header lines ahead\n    of the body, so the first non-blank line after them is the def/class line."};
