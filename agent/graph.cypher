MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/embed.py::_npy_write"}) SET n += {`id`: "sym:repo2graph/embed.py::_npy_write", `name`: "_npy_write", `qualname`: "_npy_write", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 60, `end_line`: 69, `signature`: "def _npy_write(path: Path, rows: list[list[float]], cols: int) -> None:", `docstring`: "Write `rows` (a list of equal-length float sequences) as NPY v1.0.\n\n    Opened \"wb\" with no encoding: a text-mode write on Windows rewrites every\n    0x0A inside the binary payload and corrupts the file silently."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/embed.py::_npy_read"}) SET n += {`id`: "sym:repo2graph/embed.py::_npy_read", `name`: "_npy_read", `qualname`: "_npy_read", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 72, `end_line`: 124, `signature`: "def _npy_read(path: Path) -> tuple[list[list[float]], int]:", `docstring`: "Read a 2-D C-order '<f4' NPY file; returns (rows, cols).\n\n    Anything else -- a different dtype, Fortran order, a truncated header or a\n    short payload -- is a ValueError, which load_vectors turns into \"no\n    vectors\" rather than an exception in the middle of a query."};
