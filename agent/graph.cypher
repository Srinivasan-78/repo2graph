MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::atomic_write"}) SET n += {`id`: "sym:repo2graph/export.py::atomic_write", `name`: "atomic_write", `qualname`: "atomic_write", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 21, `end_line`: 40, `signature`: "def atomic_write(path: Path, mode: str = \"w\", **open_kw):", `docstring`: "Write via a sibling temp file renamed onto `path` only on a clean exit.\n\n    A crash, exception or Ctrl-C mid-write then leaves the previous artifact (or\n    none) intact rather than a truncated file that `query`/`map` would choke on.\n    The temp file is in the target's own directory, so os.replace is atomic."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::rels"}) SET n += {`id`: "sym:repo2graph/export.py::rels", `name`: "rels", `qualname`: "rels", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 62, `end_line`: 64, `signature`: "def rels(name: str) -> list[str]:", `docstring`: "Every path an artifact is written to, relative to the output directory."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::rel"}) SET n += {`id`: "sym:repo2graph/export.py::rel", `name`: "rel", `qualname`: "rel", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 67, `end_line`: 69, `signature`: "def rel(name: str) -> str:", `docstring`: "'nodes.jsonl' -> 'agent/nodes.jsonl'. The path readers should use."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::path"}) SET n += {`id`: "sym:repo2graph/export.py::path", `name`: "path", `qualname`: "path", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 72, `end_line`: 74, `signature`: "def path(outdir, name) -> Path:", `docstring`: "The path an artifact is read back from."};
