MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_chunk_neighbours_carry_structured_edge_info"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_chunk_neighbours_carry_structured_edge_info", `name`: "test_chunk_neighbours_carry_structured_edge_info", `qualname`: "test_chunk_neighbours_carry_structured_edge_info", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 817, `end_line`: 858, `signature`: "def test_chunk_neighbours_carry_structured_edge_info(tmp_path):", `docstring`: "caller_edges/callee_edges/base_edges are the additive, structured\n    sibling of callers/callees/bases: same targets, plus edge_type,\n    edge_direction and -- only when ambiguous -- confidence.", `entrypoint`: true};
