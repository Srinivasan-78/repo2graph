MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::_int"}) SET n += {`id`: "sym:repo2graph/mcp.py::_int", `name`: "_int", `qualname`: "_int", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 444, `end_line`: 449, `signature`: "def _int(value, fallback: int) -> int:", `docstring`: "An MCP client's arguments are JSON a model wrote: coerce, never raise."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::_clamp"}) SET n += {`id`: "sym:repo2graph/mcp.py::_clamp", `name`: "_clamp", `qualname`: "_clamp", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 452, `end_line`: 454, `signature`: "def _clamp(value, fallback: int, low: int, high: int) -> int:", `docstring`: "_int, then held inside [low, high]: no argument may cost unbounded time."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::_str"}) SET n += {`id`: "sym:repo2graph/mcp.py::_str", `name`: "_str", `qualname`: "_str", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 457, `end_line`: 464, `signature`: "def _str(value, max_chars: int) -> str:", `docstring`: "Coerce a caller-supplied string argument and cap its length.\n\n    A model can hand this dispatcher an arbitrarily long value; this is the\n    string-typed counterpart to `_clamp` for the numeric arguments."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::tool_cache_stats"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_cache_stats", `name`: "tool_cache_stats", `qualname`: "tool_cache_stats", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 467, `end_line`: 476, `signature`: "def tool_cache_stats(cache) -> str:", `docstring`: "Cache counters as JSON. Diagnostics only: no repository content."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::tool_build_status"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_build_status", `name`: "tool_build_status", `qualname`: "tool_build_status", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 479, `end_line`: 513, `signature`: "def tool_build_status(tasks, task_id: str) -> str:", `docstring`: "Status of one background build, as JSON.\n\n    Args:\n        tasks: The `TaskManager`, or None when builds are synchronous.\n        task_id: The id handed out when the build started.\n\n    Returns:\n        A JSON status document, or a sentence naming why there is none."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::dispatch"}) SET n += {`id`: "sym:repo2graph/mcp.py::dispatch", `name`: "dispatch", `qualname`: "dispatch", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 516, `end_line`: 584, `signature`: "def dispatch(index: \"Index | None\", name: str, arguments: dict, cache=None, tasks=None) -> str:", `docstring`: "Route one tool call to its handler. Pure, so serve() holds no logic.\n\n    Args:\n        index: The open index every tool answers from. None is allowed only\n            for `repo_build_status`, which reports on a build and therefore\n            must be answerable while there is still no index to open.\n        name: Tool name the caller asked for.\n        arguments: The caller's arguments, which are JSON a model wrote and are\n            treated as hostile throughout.\n        cache: Optional `ResultCache`. When given, repeated identical calls are\n            served from it instead of re-scoring "};
