MERGE (n:R2G:`Symbol` {id: "sym:tests/test_export_hardening.py::test_legend_and_manifest_describe_types_identically"}) SET n += {`id`: "sym:tests/test_export_hardening.py::test_legend_and_manifest_describe_types_identically", `name`: "test_legend_and_manifest_describe_types_identically", `qualname`: "test_legend_and_manifest_describe_types_identically", `kind`: "function", `path`: "tests/test_export_hardening.py", `lang`: "python", `start_line`: 137, `end_line`: 159, `signature`: "def test_legend_and_manifest_describe_types_identically(tmp_path):", `docstring`: "The end-to-end promise #349 asks for: graph.html's legend and\n    manifest.json's node_types/edge_types must say the same thing about the\n    same type, because they now read from the one definition.\n\n    Detector proof: before this fix, viz.py's NODE_TYPE_DESC/EDGE_TYPE_DESC\n    used shorter, independently-worded copy (e.g. \"the repository itself\"\n    vs. export.py's \"the repository itself; one per index\") -- this\n    assertion would have failed against the old two-dict state.", `entrypoint`: true};
