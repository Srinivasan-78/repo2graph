MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_nonneg"}) SET n += {`id`: "sym:repo2graph/cli.py::_nonneg", `name`: "_nonneg", `qualname`: "_nonneg", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 920, `end_line`: 929, `signature`: "def _nonneg(value: str) -> int:", `docstring`: "argparse type: a base-10 int >= 0 (0 has a defined meaning for every\n    numeric flag here; a negative silently mis-slices or breaks a subprocess)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_posint"}) SET n += {`id`: "sym:repo2graph/cli.py::_posint", `name`: "_posint", `qualname`: "_posint", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 932, `end_line`: 939, `signature`: "def _posint(value: str) -> int:", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_viz_nodes"}) SET n += {`id`: "sym:repo2graph/cli.py::_viz_nodes", `name`: "_viz_nodes", `qualname`: "_viz_nodes", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 942, `end_line`: 956, `signature`: "def _viz_nodes(value: str) -> int | None:", `docstring`: "argparse type for --viz-nodes: a non-negative int, or \"all\" for no cap.\n\n    Args:\n        value: The raw command-line string.\n\n    Returns:\n        None for \"all\" (no cap), otherwise the integer, 0 included.\n\n    Raises:\n        argparse.ArgumentTypeError: On a negative or non-integer value."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_unit_float"}) SET n += {`id`: "sym:repo2graph/cli.py::_unit_float", `name`: "_unit_float", `qualname`: "_unit_float", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 959, `end_line`: 973, `signature`: "def _unit_float(value: str) -> float:", `docstring`: "argparse type: a finite float in [0.0, 1.0].\n\n    A bare float() would accept nan and inf, and `confidence < nan` is False for\n    every edge \u2014 the filter would silently stop filtering."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_nonneg_float"}) SET n += {`id`: "sym:repo2graph/cli.py::_nonneg_float", `name`: "_nonneg_float", `qualname`: "_nonneg_float", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 976, `end_line`: 985, `signature`: "def _nonneg_float(value: str) -> float:", `docstring`: "argparse type: a finite float >= 0. Same reasoning as `_unit_float`:\n    `elapsed > nan` is always False, so a nan budget silently disables it.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_add_store_flag"}) SET n += {`id`: "sym:repo2graph/cli.py::_add_store_flag", `name`: "_add_store_flag", `qualname`: "_add_store_flag", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 988, `end_line`: 1004, `signature`: "def _add_store_flag(parser: argparse.ArgumentParser) -> None:", `docstring`: "`--store`: which graph backend reads `nodes.jsonl` / `edges.jsonl`.\n\n    `store.py` has carried an on-disk backend since #306, written for \"graphs\n    too big to keep resident\", with `tests/test_store.py` running the same\n    traversals over both backends and comparing byte for byte -- and no way for\n    a user to select it. The interface existed, the implementation existed, and\n    nothing outside the test suite constructed it."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_open_index"}) SET n += {`id`: "sym:repo2graph/cli.py::_open_index", `name`: "_open_index", `qualname`: "_open_index", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 1007, `end_line`: 1026, `signature`: "def _open_index(out: Path, args: argparse.Namespace) -> \"Index\":", `docstring`: "`Index` for `out`, honouring `--store`, with the two failures named.\n\n    Both call sites had this try/except verbatim; the store lookup has to go\n    inside it because a missing or symlinked database is the same class of\n    problem to the user as a corrupt JSONL."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_add_vector_flags"}) SET n += {`id`: "sym:repo2graph/cli.py::_add_vector_flags", `name`: "_add_vector_flags", `qualname`: "_add_vector_flags", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 1029, `end_line`: 1066, `signature`: "def _add_vector_flags(parser: argparse.ArgumentParser) -> None:", `docstring`: "--vectors / --no-vectors / --embed-model, for `query` and `rag`.\n\n    `dest=\"embed_model\"`, deliberately not `dest=\"model\"`: on `rag`, `--model`\n    already means the LLM for `--answer`. The two must never share a dest, or\n    `rag --answer --model gpt-4o` would try to load an LLM name as a\n    sentence-transformers checkpoint (and vice versa)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_add_rerank_flags"}) SET n += {`id`: "sym:repo2graph/cli.py::_add_rerank_flags", `name`: "_add_rerank_flags", `qualname`: "_add_rerank_flags", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 1069, `end_line`: 1083, `signature`: "def _add_rerank_flags(parser: argparse.ArgumentParser) -> None:", `docstring`: "--rerank / --rerank-model, for `query` and `rag` (#381)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_max_file_mb"}) SET n += {`id`: "sym:repo2graph/cli.py::_max_file_mb", `name`: "_max_file_mb", `qualname`: "_max_file_mb", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 1086, `end_line`: 1093, `signature`: "def _max_file_mb(value: str) -> float:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_utf8_stdio"}) SET n += {`id`: "sym:repo2graph/cli.py::_utf8_stdio", `name`: "_utf8_stdio", `qualname`: "_utf8_stdio", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 1096, `end_line`: 1116, `signature`: "def _utf8_stdio() -> None:", `docstring`: "Make a redirected or piped stdout/stderr UTF-8.\n\n    A Windows pipe or file gets the ANSI code page (cp1252), so `repo2graph\n    rag ... > pack.md` over a repository holding `\u3053\u3093\u306b\u3061\u306f` wrote `?????` --\n    `_emit` kept it from crashing, but the text was gone. A console is left\n    alone (Python already writes it as UTF-16), and so is an explicit\n    PYTHONIOENCODING: that is the user choosing the encoding, and the\n    \"Windows CP1252\" CI job relies on it to exercise `_emit`'s fallback."};
