MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp/server.py::serve"}) SET n += {`id`: "sym:repo2graph/mcp/server.py::serve", `name`: "serve", `qualname`: "serve", `kind`: "function", `path`: "repo2graph/mcp/server.py", `lang`: "python", `start_line`: 609, `end_line`: 664, `signature`: "def serve(\n    out: str | Path,\n    repo: str | Path | None = None,\n    cache: ResultCache | None = None,\n    tasks: Any = None,\n    audit: Any = None,\n    *,\n    allow_foreign_index: bool = False,\n    transport: str = \"stdio\",\n    host: str = \"127.0.0.1\",\n    port: int = 8080,\n    auth_token: str |", `docstring`: "Run MCP server over stdio or SSE.\n\n    Args:\n        out: Index directory to answer from.\n        repo: Repository to auto-build from, or None to require an existing index.\n        cache: Optional result cache.\n        tasks: Optional background build registry.\n        audit: Optional `AuditLogger`; one record per tool call when given.\n        allow_foreign_index: Whether to permit opening an index built elsewhere.\n        transport: Transport protocol ('stdio' or 'sse').\n        host: Host to bind to when transport='sse'.\n        port: Port to bind to when transport='sse'.\n        auth_token:"};
