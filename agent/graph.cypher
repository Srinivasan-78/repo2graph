MERGE (n:R2G:Symbol {id: "sym:tests/test_scoped_resolution.py::test_cli_stats_command_human_readable_and_json"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_cli_stats_command_human_readable_and_json", `name`: "test_cli_stats_command_human_readable_and_json", `qualname`: "test_cli_stats_command_human_readable_and_json", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 224, `end_line`: 257, `signature`: "def test_cli_stats_command_human_readable_and_json(tmp_path: Path, capsys):", `docstring`: "`repo2graph stats` still prints raw JSON by default; `--format text` summarises.\n\n    The default is asserted with no `--format` at all, because that is the half\n    nothing pinned: the original test passed `--format text` explicitly while\n    its own name claimed to be testing the default. Bare `stats` printing the\n    raw `stats.json` is the pre-PR contract -- there was no `--format` flag\n    before this feature -- and `test_ac27_existing_subcommands_are_untouched`\n    in tests/test_rag.py depends on it, as does any caller piping it to jq.", `entrypoint`: true};
