MERGE (n:R2G:Symbol {id: "sym:tests/test_rag.py::test_ac13_retrieve_signature_and_cmd_query_output_are_unchanged"}) SET n += {`id`: "sym:tests/test_rag.py::test_ac13_retrieve_signature_and_cmd_query_output_are_unchanged", `name`: "test_ac13_retrieve_signature_and_cmd_query_output_are_unchanged", `qualname`: "test_ac13_retrieve_signature_and_cmd_query_output_are_unchanged", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 478, `end_line`: 504, `signature`: "def test_ac13_retrieve_signature_and_cmd_query_output_are_unchanged(rag_out, capsys):", `docstring`: "AC-13: positional order preserved; `query` output still == format_pack.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_rag.py::test_ac13_retrieve_keeps_every_edge_direction"}) SET n += {`id`: "sym:tests/test_rag.py::test_ac13_retrieve_keeps_every_edge_direction", `name`: "test_ac13_retrieve_keeps_every_edge_direction", `qualname`: "test_ac13_retrieve_keeps_every_edge_direction", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 507, `end_line`: 537, `signature`: "def test_ac13_retrieve_keeps_every_edge_direction(dirs_out):", `docstring`: "AC-13: retrieve() must not inherit expand()'s DEFAULT_EDGE_DIRS.\n\n    The assertion above compares `cmd_query` output against `format_pack(\n    retrieve(...))` -- the implementation against itself -- so a traversal\n    change moves both sides together and stays green. REVIEW iteration 1 found\n    exactly that: `retrieve()` picked up expand()'s restrictive\n    DEFAULT_EDGE_DIRS ({\"DEFINES\": (\"in\",), \"IMPORTS\": (\"out\",),\n    \"INHERITS\": (\"out\",)}) and silently dropped every DEFINES-out, IMPORTS-in\n    and INHERITS-in neighbour from the `query` command.\n\n    So: pin literal (node_id, why) pairs f", `entrypoint`: true};
