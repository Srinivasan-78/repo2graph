MERGE (n:R2G:`Symbol` {id: "sym:tests/test_demo.py::test_every_fixture_module_carries_a_file_chunk"}) SET n += {`id`: "sym:tests/test_demo.py::test_every_fixture_module_carries_a_file_chunk", `name`: "test_every_fixture_module_carries_a_file_chunk", `qualname`: "test_every_fixture_module_carries_a_file_chunk", `kind`: "function", `path`: "tests/test_demo.py", `lang`: "python", `start_line`: 47, `end_line`: 67, `signature`: "def test_every_fixture_module_carries_a_file_chunk(demo_index):", `docstring`: "chunks.py drops a `file_residual` under 40 chars, and a node with no\n    chunk can be neither a seed nor a retrievable neighbour.\n\n    Verified as a detector against a module with no module-level text at all\n    (`def a(): return 1`), which is the condition that actually trips the\n    40-char floor -- a module keeping only its imports stays above it. So the\n    thing this guards is a fixture module stripped of its docstring *and* its\n    module-level constant, which is exactly how the residue rule gets broken\n    by someone tidying up.\n\n    See CONTRIBUTING.md, \"A file with little residue emit", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_demo.py::test_demo_graph_has_the_edges_the_starter_questions_rely_on"}) SET n += {`id`: "sym:tests/test_demo.py::test_demo_graph_has_the_edges_the_starter_questions_rely_on", `name`: "test_demo_graph_has_the_edges_the_starter_questions_rely_on", `qualname`: "test_demo_graph_has_the_edges_the_starter_questions_rely_on", `kind`: "function", `path`: "tests/test_demo.py", `lang`: "python", `start_line`: 70, `end_line`: 111, `signature`: "def test_demo_graph_has_the_edges_the_starter_questions_rely_on(demo_index):", `docstring`: "Hand-derived from the fixture source: routes guard -> service -> store.\n\n    Each of these is the edge one starter question exists to demonstrate, so\n    losing any of them breaks the quickstart, not just this test.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_demo.py::test_demo_has_no_cross_language_call_edges"}) SET n += {`id`: "sym:tests/test_demo.py::test_demo_has_no_cross_language_call_edges", `name`: "test_demo_has_no_cross_language_call_edges", `qualname`: "test_demo_has_no_cross_language_call_edges", `kind`: "function", `path`: "tests/test_demo.py", `lang`: "python", `start_line`: 114, `end_line`: 129, `signature`: "def test_demo_has_no_cross_language_call_edges(demo_index):", `docstring`: "The JS client must not resolve into the Python store.\n\n    `web/client.js` calls the browser global `fetch()`; when the Python store\n    had a method of the same name, the global-name fallback produced a\n    `web/client.js::createOrder -> app/store.py::OrderStore.fetch` edge. That\n    is a real property of the resolver, but a first-run demo is the wrong\n    place to display one -- the fixture is named to avoid the collision, and\n    this pins it so a future rename cannot quietly bring it back.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_demo.py::test_each_starter_question_cites_the_file_that_answers_it"}) SET n += {`id`: "sym:tests/test_demo.py::test_each_starter_question_cites_the_file_that_answers_it", `name`: "test_each_starter_question_cites_the_file_that_answers_it", `qualname`: "test_each_starter_question_cites_the_file_that_answers_it", `kind`: "function", `path`: "tests/test_demo.py", `lang`: "python", `start_line`: 146, `end_line`: 168, `signature`: "def test_each_starter_question_cites_the_file_that_answers_it(demo_index, q_index, required_path):", `docstring`: "The quickstart promises these five prompts work. This is that promise.\n\n    Set membership on paths only -- no score, no rank, no ordering, which all\n    drift with any scoring tweak (CONTRIBUTING.md).", `entrypoint`: true};
