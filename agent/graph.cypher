MERGE (n:R2G:`Symbol` {id: "sym:tests/test_explain.py::test_expansion_trace_follows_the_same_directions_retrieve_does"}) SET n += {`id`: "sym:tests/test_explain.py::test_expansion_trace_follows_the_same_directions_retrieve_does", `name`: "test_expansion_trace_follows_the_same_directions_retrieve_does", `qualname`: "test_expansion_trace_follows_the_same_directions_retrieve_does", `kind`: "function", `path`: "tests/test_explain.py", `lang`: "python", `start_line`: 194, `end_line`: 217, `signature`: "def test_expansion_trace_follows_the_same_directions_retrieve_does(trace_repo: Path):", `docstring`: "`expand()` defaults to DEFAULT_EDGE_DIRS, which is DEFINES-`in` only, but\n    `retrieve()` passes ALL_EDGE_DIRS. An explain that takes the default traces\n    a walk the retrieval below it never made -- it reported\n    `Runner.run -> Runner DEFINES in` while the chunk it printed came back\n    labelled `DEFINES out of main.py`.\n\n    The tuple below is hand-derived from the fixture source: `Runner` defines\n    the method `run`, so `sym:main.py::Runner` has a DEFINES edge *out* to\n    `sym:main.py::Runner.run`. Set membership only -- no rank, score or\n    order.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_explain.py::test_every_retrieved_neighbour_appears_in_the_expansion_trace"}) SET n += {`id`: "sym:tests/test_explain.py::test_every_retrieved_neighbour_appears_in_the_expansion_trace", `name`: "test_every_retrieved_neighbour_appears_in_the_expansion_trace", `qualname`: "test_every_retrieved_neighbour_appears_in_the_expansion_trace", `kind`: "function", `path`: "tests/test_explain.py", `lang`: "python", `start_line`: 220, `end_line`: 237, `signature`: "def test_every_retrieved_neighbour_appears_in_the_expansion_trace(trace_repo: Path):", `docstring`: "Nothing may arrive in `retrieved_chunks` by a hop the trace does not\n    show. This is the property the direction filter broke, stated without\n    naming any one edge.\n\n    The query is \"modes\" and not the three-term one above on purpose: it seeds\n    on `file:main.py` alone, so both of the fixture's neighbours really are\n    expanded rather than seeded, and the narrowed `DEFINES: (\"in\",)` leaves one\n    of them retrieved but untraced. With a query that seeds every node the\n    branch is vacuous.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_explain.py::test_primary_seeds_keep_the_short_list_order"}) SET n += {`id`: "sym:tests/test_explain.py::test_primary_seeds_keep_the_short_list_order", `name`: "test_primary_seeds_keep_the_short_list_order", `qualname`: "test_primary_seeds_keep_the_short_list_order", `kind`: "function", `path`: "tests/test_explain.py", `lang`: "python", `start_line`: 240, `end_line`: 246, `signature`: "def test_primary_seeds_keep_the_short_list_order(trace_repo: Path):", `docstring`: "`primary_seeds` was `list(a set)`. `expand()` walks its frontier in\n    order under a per-hop cap, so seed order is part of the traversal, and a\n    set makes it depend on PYTHONHASHSEED.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_explain.py::test_explain_retrieval_output_is_reproducible"}) SET n += {`id`: "sym:tests/test_explain.py::test_explain_retrieval_output_is_reproducible", `name`: "test_explain_retrieval_output_is_reproducible", `qualname`: "test_explain_retrieval_output_is_reproducible", `kind`: "function", `path`: "tests/test_explain.py", `lang`: "python", `start_line`: 249, `end_line`: 270, `signature`: "def test_explain_retrieval_output_is_reproducible(trace_repo: Path):", `docstring`: "Two runs of the same command must print the same bytes. Run in\n    subprocesses with different PYTHONHASHSEEDs: set iteration order is fixed\n    *within* a process, so a same-process comparison cannot see this.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_explain.py::test_selected_seeds_are_all_visible_in_the_text_report"}) SET n += {`id`: "sym:tests/test_explain.py::test_selected_seeds_are_all_visible_in_the_text_report", `name`: "test_selected_seeds_are_all_visible_in_the_text_report", `qualname`: "test_selected_seeds_are_all_visible_in_the_text_report", `kind`: "function", `path`: "tests/test_explain.py", `lang`: "python", `start_line`: 273, `end_line`: 286, `signature`: "def test_selected_seeds_are_all_visible_in_the_text_report(trace_repo: Path):", `docstring`: "The `*` column is what the seeds section is for, and a selected seed can\n    sit below rank k -- each one has to be the first chunk of a *distinct*\n    node. Truncating the printed list to k hid those and contradicted the\n    \"N short-listed\" count printed directly above it.", `entrypoint`: true};
