MERGE (n:R2G:`Symbol` {id: "sym:tests/test_query_bounds.py::TestSingleCharIdentifiers.test_postings_growth_from_single_char_names_is_bounded"}) SET n += {`id`: "sym:tests/test_query_bounds.py::TestSingleCharIdentifiers.test_postings_growth_from_single_char_names_is_bounded", `name`: "test_postings_growth_from_single_char_names_is_bounded", `qualname`: "TestSingleCharIdentifiers.test_postings_growth_from_single_char_names_is_bounded", `kind`: "function", `path`: "tests/test_query_bounds.py", `lang`: "python", `start_line`: 334, `end_line`: 354, `signature`: "def test_postings_growth_from_single_char_names_is_bounded(self, tmp_path):", `docstring`: "Acceptance criterion from #378: postings count grows by less than a\n        stated bound. Single-character names are drawn from\n        `[A-Za-z_]`, so at most 53 distinct new postings terms\n        (26 lower + 26 upper-folded-to-lower collapses to 26, + \"_\") can ever\n        be added by this feature, regardless of corpus size -- unlike\n        admitting single characters from free text, which would scale with\n        the corpus.", `entrypoint`: true, `reach`: 278};
