MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_cy_key"}) SET n += {`id`: "sym:repo2graph/export.py::_cy_key", `name`: "_cy_key", `qualname`: "_cy_key", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 533, `end_line`: 538, `signature`: "def _cy_key(k: str) -> str:\n    # Always backtick-quote: covers Cypher reserved words (order, match, where,\n    # distinct, ...) and any other non-bare-identifier-safe key. Doubling an\n    # embedded backtick is Cypher's own escape for it inside a quoted\n    # identifier, so a key containing one can", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_cy_label"}) SET n += {`id`: "sym:repo2graph/export.py::_cy_label", `name`: "_cy_label", `qualname`: "_cy_label", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 541, `end_line`: 546, `signature`: "def _cy_label(value: str) -> str:", `docstring`: "Backtick-quote a label/reltype. Types are internal constants; anything\n    else reaching here is a bug, not a value to escape our way out of."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_cypher"}) SET n += {`id`: "sym:repo2graph/export.py::write_cypher", `name`: "write_cypher", `qualname`: "write_cypher", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 549, `end_line`: 577, `signature`: "def write_cypher(g: \"Graph\", path: Path) -> None:", `docstring`: "Export graph nodes and edges as Cypher statements for Neo4j.\n\n    Args:\n        g: Graph instance to export.\n        path: Target file path for Cypher script."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_overview"}) SET n += {`id`: "sym:repo2graph/export.py::write_overview", `name`: "write_overview", `qualname`: "write_overview", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 580, `end_line`: 634, `signature`: "def write_overview(g: \"Graph\", path: Path, top: int = 25) -> None:", `docstring`: "Write human/LLM-readable repo map highlighting hub files and entry points.\n\n    Args:\n        g: Graph instance containing parsed nodes and edges.\n        path: File path for overview markdown output.\n        top: Maximum number of hub files and symbols to list."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_git_short_sha"}) SET n += {`id`: "sym:repo2graph/export.py::_git_short_sha", `name`: "_git_short_sha", `qualname`: "_git_short_sha", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 637, `end_line`: 652, `signature`: "def _git_short_sha(root: Path | str) -> str | None:", `docstring`: "Get the short git commit SHA at the repository root.\n\n    Executes git rev-parse with safe subprocess decoding and bounded timeout.\n    Returns None if not in a git repo or if git is unavailable.\n\n    Args:\n        root: Root path of the repository.\n\n    Returns:\n        Short commit SHA string, or None."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_overview_human"}) SET n += {`id`: "sym:repo2graph/export.py::write_overview_human", `name`: "write_overview_human", `qualname`: "write_overview_human", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 671, `end_line`: 784, `signature`: "def write_overview_human(g: \"Graph\", path: Path, top: int = 25) -> None:", `docstring`: "Write structured markdown repo overview for human inspection.\n\n    Reads edge-type and symbol-kind counts directly from graph stats\n    for consistent reporting.\n\n    Args:\n        g: Graph instance containing parsed nodes, edges, and statistics.\n        path: File path for human overview markdown output.\n        top: Maximum number of top-connected files to display."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_fanout"}) SET n += {`id`: "sym:repo2graph/export.py::_fanout", `name`: "_fanout", `qualname`: "_fanout", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 931, `end_line`: 941, `signature`: "def _fanout(text: str, max_call_candidates: int) -> str:", `docstring`: "Substitute a build's fan-out limit into one manifest prose template.\n\n    `str.replace`, not `str.format`: these are prose strings that an editor may\n    well one day want a literal brace in (a JSON snippet, a dict example), and\n    `format` would raise KeyError on it here -- turning a typo in documentation\n    copy into a failed build. A template that loses its `{n}` degrades to a\n    sentence with no number, which the top-level `max_call_candidates` key\n    still answers."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_manifest"}) SET n += {`id`: "sym:repo2graph/export.py::write_manifest", `name`: "write_manifest", `qualname`: "write_manifest", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 944, `end_line`: 1120, `signature`: "def write_manifest(\n    g: Any, path: Path, written: list[str], *, checksums: dict[str, Any] | None = None\n) -> None:", `docstring`: "Write manifest.json describing index metadata, schemas, and statistics.\n\n    Args:\n        g: Graph instance or duck-typed object carrying nodes and stats.\n        path: Target file path for the manifest.\n        written: List of relative artifact paths generated during export.\n        checksums: Optional mapping of relative artifact paths to SHA-256 hashes."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_stats_extra"}) SET n += {`id`: "sym:repo2graph/export.py::_stats_extra", `name`: "_stats_extra", `qualname`: "_stats_extra", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1128, `end_line`: 1194, `signature`: "def _stats_extra(g: \"Graph\") -> dict[str, Any]:", `docstring`: "Additive stats.json fields, computed live from `g` at write time.\n\n    Never re-read from nodes.jsonl/edges.jsonl -- dump_all always has the\n    Graph in memory here, and re-deriving from the files it is about to write\n    would be a circular dependency for no reason."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_mark_has_vectors"}) SET n += {`id`: "sym:repo2graph/export.py::_mark_has_vectors", `name`: "_mark_has_vectors", `qualname`: "_mark_has_vectors", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1197, `end_line`: 1214, `signature`: "def _mark_has_vectors(outdir: Path | str) -> None:", `docstring`: "Flip stats.json's has_vectors to True after `embed` writes vectors.npy.\n\n    Best-effort, same as register_written: a missing or unreadable stats.json\n    (e.g. a fixture built with --formats that never writes one) is not\n    embed's problem to fix, so any failure here is silently skipped."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::register_written"}) SET n += {`id`: "sym:repo2graph/export.py::register_written", `name`: "register_written", `qualname`: "register_written", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1217, `end_line`: 1259, `signature`: "def register_written(outdir: Path | str, names: Iterable[str]) -> bool:", `docstring`: "Merge `names` into an existing manifest's `written`, `files`, and `checksums`.\n\n    `embed` runs after `build` as a separate command, so it must append to the\n    manifest dump_all already wrote rather than rewrite it: every other key --\n    counts, entrypoints, how_to_read -- is left exactly as it was. Returns\n    False when there is no readable manifest to append to."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_state"}) SET n += {`id`: "sym:repo2graph/export.py::write_state", `name`: "write_state", `qualname`: "write_state", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1262, `end_line`: 1288, `signature`: "def write_state(g: \"Graph\", path: Path, n_chunks: int) -> None:", `docstring`: "The per-file content hashes a later incremental build reads back.\n\n    `filters` records the discovery filters this build used. Anything that\n    re-runs discovery to compare the tree against the index -- `index-status`,\n    `doctor`'s freshness check -- must apply the same ones, or a build with\n    any `--exclude` reports every deliberately excluded file as newly added\n    and therefore reads as permanently stale."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_parse_cache"}) SET n += {`id`: "sym:repo2graph/export.py::write_parse_cache", `name`: "write_parse_cache", `qualname`: "write_parse_cache", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1291, `end_line`: 1314, `signature`: "def write_parse_cache(g: \"Graph\", path: Path) -> None:", `docstring`: "Write the per-file parse cache the next `--incremental` build reads.\n\n    Args:\n        g: The Graph just built; its `parse_cache` is the payload.\n        path: Destination for `parse.cache.json`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::load_parse_cache"}) SET n += {`id`: "sym:repo2graph/export.py::load_parse_cache", `name`: "load_parse_cache", `qualname`: "load_parse_cache", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1317, `end_line`: 1319, `signature`: "def load_parse_cache(outdir: Path, config: Any = None) -> dict[str, Any]:", `docstring`: "`load_parse_cache_report` without the reason."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::load_parse_cache_report"}) SET n += {`id`: "sym:repo2graph/export.py::load_parse_cache_report", `name`: "load_parse_cache_report", `qualname`: "load_parse_cache_report", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1322, `end_line`: 1388, `signature`: "def load_parse_cache_report(outdir: Path, config: Any = None) -> tuple[dict[str, Any], str | None]:", `docstring`: "Read a previous build's parse cache out of an index directory.\n\n    Every failure mode -- no index, no cache file, unreadable, malformed JSON,\n    a format bump, a grammar upgrade -- returns an empty dict, which makes the\n    next build a full one. An incremental build that silently reuses entries it\n    does not understand is the failure this whole feature was deferred to avoid,\n    so the only safe response to an unrecognised cache is to ignore it.\n\n    The grammar check is the one that does not depend on anyone remembering to\n    bump a constant: `PARSE_CACHE_FORMAT` tracks changes to our o"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_fsync_dir"}) SET n += {`id`: "sym:repo2graph/export.py::_fsync_dir", `name`: "_fsync_dir", `qualname`: "_fsync_dir", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1391, `end_line`: 1405, `signature`: "def _fsync_dir(path: Path) -> None:", `docstring`: "Persist a directory's entries (POSIX). Windows cannot open a directory\n    for fsync, and NTFS journals renames itself, so there it is a no-op."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_rename"}) SET n += {`id`: "sym:repo2graph/export.py::_rename", `name`: "_rename", `qualname`: "_rename", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1413, `end_line`: 1428, `signature`: "def _rename(src: Path, dst: Path) -> None:", `docstring`: "`src.rename(dst)`, retried on Windows while something holds a file open.\n\n    OneDrive, antivirus scanners and editors briefly open files in a fresh\n    index; NTFS then refuses the rename with a sharing violation (WinError 5 or\n    32) that clears on its own. Elsewhere, and once the retries are spent, the\n    error is raised as it was."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_merge_staging_into"}) SET n += {`id`: "sym:repo2graph/export.py::_merge_staging_into", `name`: "_merge_staging_into", `qualname`: "_merge_staging_into", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1438, `end_line`: 1474, `signature`: "def _merge_staging_into(staging: Path, target: Path) -> None:", `docstring`: "Move staged entries into `target`, replacing what is there.\n\n    The fallback for a read-only parent, where `_atomic_dir_swap` cannot work:\n    renaming a directory needs write permission on the parent of *both* names,\n    and `staging` lives inside `target` here precisely because the parent is not\n    writable.\n\n    The guarantee is therefore weaker and worth stating. Each top-level entry\n    (`agent/`, `human/`, `local.json`) is replaced in one `rename`, so no\n    individual artifact is ever half-written, but the directory as a whole is\n    not swapped in one step. The build lock keeps other"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_atomic_dir_swap"}) SET n += {`id`: "sym:repo2graph/export.py::_atomic_dir_swap", `name`: "_atomic_dir_swap", `qualname`: "_atomic_dir_swap", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1477, `end_line`: 1513, `signature`: "def _atomic_dir_swap(staging: Path, target: Path) -> None:", `docstring`: "Atomically replace target directory with staging directory.\n\n    On Windows, os.replace doesn't work for non-empty directories, so we use\n    a rename dance: target -> backup, staging -> target, then remove backup.\n    If the staging rename fails, we restore the backup."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::write_local"}) SET n += {`id`: "sym:repo2graph/export.py::write_local", `name`: "write_local", `qualname`: "write_local", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1525, `end_line`: 1553, `signature`: "def write_local(g: Any, index_root: Path) -> None:", `docstring`: "Write machine-local build metadata and ignore file to index root.\n\n    Args:\n        g: Graph instance or object with root/source_remote attributes.\n        index_root: Destination root directory of the index."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::dump_all"}) SET n += {`id`: "sym:repo2graph/export.py::dump_all", `name`: "dump_all", `qualname`: "dump_all", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1568, `end_line`: 1698, `signature`: "def dump_all(\n    g: \"Graph\",\n    chunks: Iterable[Record] | None,\n    outdir: Path,\n    formats: set[str],\n    viz_nodes: int = MAX_NODES,\n) -> tuple[list[str], int]:", `docstring`: "Write all requested index artifacts to the output directory.\n\n    Artifacts are staged in a temporary sibling directory and atomically\n    swapped into outdir on completion.\n\n    Args:\n        g: Graph instance containing nodes, edges, and build statistics.\n        chunks: Optional iterable of code chunks to export.\n        outdir: Output directory path.\n        formats: Set of format strings to write ('jsonl', 'graphml', 'cypher', 'overview', 'html').\n        viz_nodes: Maximum number of nodes to include in HTML visualization.\n\n    Returns:\n        Tuple of (list of written artifact relative "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::dump_all.out"}) SET n += {`id`: "sym:repo2graph/export.py::dump_all.out", `name`: "out", `qualname`: "dump_all.out", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1630, `end_line`: 1632, `signature`: "def out(name: str) -> list[Path]:", `docstring`: ""};
