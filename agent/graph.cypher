MERGE (n:R2G:`Symbol` {id: "sym:scripts/commit_release_via_api.py::file_additions"}) SET n += {`id`: "sym:scripts/commit_release_via_api.py::file_additions", `name`: "file_additions", `qualname`: "file_additions", `kind`: "function", `path`: "scripts/commit_release_via_api.py", `lang`: "python", `start_line`: 147, `end_line`: 164, `signature`: "def file_additions(paths: list[str]) -> list[dict[str, str]]:", `docstring`: "Read each file as bytes and base64 it for `fileChanges.additions`.\n\n    Paths are normalised to POSIX (ISS-146): this script also runs on Windows,\n    where `dist\\\\sub\\\\file.txt` would otherwise be committed as a single file\n    with backslashes in its name rather than as `dist/sub/file.txt`."};
