MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_freshness_detects_a_modified_file"}) SET n += {`id`: "sym:tests/test_index_status.py::test_freshness_detects_a_modified_file", `name`: "test_freshness_detects_a_modified_file", `qualname`: "test_freshness_detects_a_modified_file", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 146, `end_line`: 158, `signature`: "def test_freshness_detects_a_modified_file(built):", `docstring`: "mtime only chooses what to hash; the finding is a hash mismatch.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_freshness_ignores_a_touched_but_unchanged_file"}) SET n += {`id`: "sym:tests/test_index_status.py::test_freshness_ignores_a_touched_but_unchanged_file", `name`: "test_freshness_ignores_a_touched_but_unchanged_file", `qualname`: "test_freshness_ignores_a_touched_but_unchanged_file", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 161, `end_line`: 172, `signature`: "def test_freshness_ignores_a_touched_but_unchanged_file(built):", `docstring`: "A fresh clone rewrites every mtime without changing a byte. Calling\n    that stale would make the check useless on exactly the machine -- CI --\n    that most needs it.", `entrypoint`: true};
