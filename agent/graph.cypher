MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_negative_infinite_nbf_claim_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_negative_infinite_nbf_claim_is_refused", `name`: "test_a_negative_infinite_nbf_claim_is_refused", `qualname`: "test_a_negative_infinite_nbf_claim_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 298, `end_line`: 305, `signature`: "def test_a_negative_infinite_nbf_claim_is_refused():", `docstring`: "-Infinity is not finite either; a not-a-finite-number claim must reject,\n\n    not be reinterpreted as \"always valid\".", `entrypoint`: true, `reach`: 26};
