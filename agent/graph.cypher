MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parsepool.py::_round"}) SET n += {`id`: "sym:repo2graph/parsepool.py::_round", `name`: "_round", `qualname`: "_round", `kind`: "function", `path`: "repo2graph/parsepool.py", `lang`: "python", `start_line`: 351, `end_line`: 456, `signature`: "def _round(\n    fn: Callable[[Any], Any],\n    items: Sequence[Any],\n    todo: list[int],\n    jobs: int,\n    timeout: float,\n    initializer: Callable[[Any], None],\n) -> tuple[dict[int, tuple[Any, float]], set[int], set[int], set[int]]:", `docstring`: "One pool over `todo`. Returns (finished, overrun, lost, crashed).\n\n    `overrun` are the items whose worker was killed for exceeding `timeout`.\n    `crashed` are the items whose worker was killed for exceeding `WORKER_MEMORY_MB`.\n    `lost` are the items workers were in the middle of when the pool broke for\n    any other reason (an unhandled crash, an OS kill): one of them did it. Items in\n    none of these sets and not finished did not get to run and can simply be retried."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parsepool.py::supervised_map"}) SET n += {`id`: "sym:repo2graph/parsepool.py::supervised_map", `name`: "supervised_map", `qualname`: "supervised_map", `kind`: "function", `path`: "repo2graph/parsepool.py", `lang`: "python", `start_line`: 459, `end_line`: 500, `signature`: "def supervised_map(\n    fn: Callable[[Any], Any],\n    items: Sequence[Any],\n    jobs: int,\n    timeout: float,\n    initializer: Callable[[Any], None],\n) -> list[tuple[Any, float] | str]:", `docstring`: "`fn` over `items` in killable worker processes, results in input order.\n\n    Each result is `(fn(item), seconds)`, or `TIMEOUT` / `CRASH` for an item\n    whose worker had to be killed or died under it. `initializer` runs once per\n    worker with the shared watch array and must call `claim_slot` on it.\n\n    A pool that breaks with an item in flight is retried without it: the items\n    other workers were running are re-run one at a time in a pool of their own,\n    so a crash is pinned on the file that causes it, not on its neighbours.\n\n    Raises:\n        PoolUnavailable: the pool broke without "};
