MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/fetch.py::_rmtree"}) SET n += {`id`: "sym:repo2graph/fetch.py::_rmtree", `name`: "_rmtree", `qualname`: "_rmtree", `kind`: "function", `path`: "repo2graph/fetch.py", `lang`: "python", `start_line`: 19, `end_line`: 41, `signature`: "def _rmtree(path: Path) -> None:", `docstring`: "Best-effort recursive delete of a temp clone.\n\n    Git marks pack files under .git/objects read-only; on Windows os.unlink then\n    raises PermissionError and shutil.rmtree(ignore_errors=True) would leave the\n    whole clone (often hundreds of MB) behind. Clear the bit and retry."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/fetch.py::_rmtree._on_error"}) SET n += {`id`: "sym:repo2graph/fetch.py::_rmtree._on_error", `name`: "_on_error", `qualname`: "_rmtree._on_error", `kind`: "function", `path`: "repo2graph/fetch.py", `lang`: "python", `start_line`: 27, `end_line`: 32, `signature`: "def _on_error(func, p, _exc):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/fetch.py::_git_version"}) SET n += {`id`: "sym:repo2graph/fetch.py::_git_version", `name`: "_git_version", `qualname`: "_git_version", `kind`: "function", `path`: "repo2graph/fetch.py", `lang`: "python", `start_line`: 69, `end_line`: 96, `signature`: "def _git_version() -> tuple[int, ...]:", `docstring`: "Probe `git --version`, memoizing only a successful result.\n\n    A transient failure (fd exhaustion, fork failure, ...) must not be cached\n    forever: that would permanently mask the version-gated security check in\n    _auth_env for the rest of the process's life. Only a successful probe is\n    memoized; a failed probe is retried on the next call."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/fetch.py::parse_spec"}) SET n += {`id`: "sym:repo2graph/fetch.py::parse_spec", `name`: "parse_spec", `qualname`: "parse_spec", `kind`: "function", `path`: "repo2graph/fetch.py", `lang`: "python", `start_line`: 99, `end_line`: 111, `signature`: "def parse_spec(spec: str) -> tuple[str, str]:", `docstring`: "'owner/repo', a GitHub URL or an SSH remote -> (owner, repo)."};
