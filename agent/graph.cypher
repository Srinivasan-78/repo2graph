MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_bare_builtin_call_is_not_bound_confidently_across_files"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_bare_builtin_call_is_not_bound_confidently_across_files", `name`: "test_bare_builtin_call_is_not_bound_confidently_across_files", `qualname`: "test_bare_builtin_call_is_not_bound_confidently_across_files", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 1609, `end_line`: 1637, `signature`: "def test_bare_builtin_call_is_not_bound_confidently_across_files(tmp_path: Path):", `docstring`: "Django regression: `super()` bound to a method named `super` in another file.\n\n    `template/loader_tags.py::BlockNode.super` -- the helper behind\n    `{{ block.super }}` -- collected 1,805 incoming `CALLS` edges at confidence\n    1.0, sourced from `db/models/fields/`, `forms/fields.py` and\n    `db/models/expressions.py`, none of which touch block inheritance. It ranked\n    second in the repo map's most-called list. The untyped-receiver rule could\n    not reach it: that gate requires `receiver == \"other\"` and a bare `super()`\n    has no receiver at all.", `entrypoint`: true};
