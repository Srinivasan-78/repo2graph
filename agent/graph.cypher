MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_an_absurdly_long_node_id_is_clamped_before_it_reaches_the_error"}) SET n += {`id`: "sym:tests/test_mcp.py::test_an_absurdly_long_node_id_is_clamped_before_it_reaches_the_error", `name`: "test_an_absurdly_long_node_id_is_clamped_before_it_reaches_the_error", `qualname`: "test_an_absurdly_long_node_id_is_clamped_before_it_reaches_the_error", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1617, `end_line`: 1631, `signature`: "def test_an_absurdly_long_node_id_is_clamped_before_it_reaches_the_error(mini_index):", `docstring`: "The ceiling has to bind, not merely fail to crash.\n\n    `_str` clamps by slicing, so a 10 MB id produces a `str` and a \"node not\n    found\" either way -- asserting only those two things passed with the clamp\n    deleted. The refusal echoes the id it looked up, so the clamped length is\n    observable in the output.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_an_absurdly_long_task_id_is_clamped_before_it_reaches_the_error"}) SET n += {`id`: "sym:tests/test_mcp.py::test_an_absurdly_long_task_id_is_clamped_before_it_reaches_the_error", `name`: "test_an_absurdly_long_task_id_is_clamped_before_it_reaches_the_error", `qualname`: "test_an_absurdly_long_task_id_is_clamped_before_it_reaches_the_error", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1634, `end_line`: 1648, `signature`: "def test_an_absurdly_long_task_id_is_clamped_before_it_reaches_the_error():", `docstring`: "Same ceiling, same reasoning, on the task-id path.\n\n    A real (empty) TaskManager is needed to reach the branch that echoes the id:\n    with `tasks=None` the server answers \"builds synchronously\" and never looks\n    at the id at all, which is why the previous `isinstance(out, str)` assertion\n    could not see the clamp.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_sane_string_arguments_are_left_alone"}) SET n += {`id`: "sym:tests/test_mcp.py::test_sane_string_arguments_are_left_alone", `name`: "test_sane_string_arguments_are_left_alone", `qualname`: "test_sane_string_arguments_are_left_alone", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1651, `end_line`: 1664, `signature`: "def test_sane_string_arguments_are_left_alone(mini_index):", `docstring`: "The ceiling must not quietly rewrite ordinary calls.", `entrypoint`: true};
