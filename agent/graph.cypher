MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_file_chunk0_id_matches_node_id"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_file_chunk0_id_matches_node_id", `name`: "test_file_chunk0_id_matches_node_id", `qualname`: "test_file_chunk0_id_matches_node_id", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 515, `end_line`: 547, `signature`: "def test_file_chunk0_id_matches_node_id(tmp_path):", `docstring`: "Verify file chunk 0 uses the unsuffixed node id, same as symbols.\n\n    On main, file chunks were `file:{path}#0` while symbol chunk 0 was\n    `sym:{path}::{qualname}`. A lookup for `file:notes.md` therefore missed\n    chunk 0 unless the caller stripped `#0`. Multi-part splits still get\n    `#1`, `#2`, \u2026 so ids stay unique and ordered.", `entrypoint`: true};
