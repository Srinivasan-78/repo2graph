MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_make_handler_binds_configuration_onto_the_handler_class"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_make_handler_binds_configuration_onto_the_handler_class", `name`: "test_make_handler_binds_configuration_onto_the_handler_class", `qualname`: "test_make_handler_binds_configuration_onto_the_handler_class", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 854, `end_line`: 886, `signature`: "def test_make_handler_binds_configuration_onto_the_handler_class():", `docstring`: "`BaseHTTPRequestHandler` is instantiated once per request, so everything\n    a request needs has to live on the *class* -- `make_handler` is where that\n    binding happens, and two fixes in this change depend on it being right:\n    `self.repo` drives the auto-build tool annotations (#292), and\n    `trust_proxy`/`trusted_proxies` decide whether `X-Forwarded-For` is ever\n    consulted (#267). Both read attributes that nothing would notice were\n    missing until a request arrived.", `entrypoint`: true};
