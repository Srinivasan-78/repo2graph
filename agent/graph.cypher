MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_pr_impact_doc_covers_every_impact_flag"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_pr_impact_doc_covers_every_impact_flag", `name`: "test_pr_impact_doc_covers_every_impact_flag", `qualname`: "test_pr_impact_doc_covers_every_impact_flag", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1653, `end_line`: 1660, `signature`: "def test_pr_impact_doc_covers_every_impact_flag():", `docstring`: "The table is the flag reference, so a new flag has to land in it.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_get_git_diff_ref_validation_prevents_command_injection"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_get_git_diff_ref_validation_prevents_command_injection", `name`: "test_get_git_diff_ref_validation_prevents_command_injection", `qualname`: "test_get_git_diff_ref_validation_prevents_command_injection", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1663, `end_line`: 1678, `signature`: "def test_get_git_diff_ref_validation_prevents_command_injection(tmp_path):", `docstring`: "A leading-dash revision is a real capability, not a theoretical one.\n\n    The argv is a list and no shell is involved, so `;` and friends are inert --\n    but `git diff --output=<path>` writes a file and `--ext-cmd=<cmd>` runs a\n    command, and both arrive as an ordinary positional revision. `_validate_ref`\n    must reject them before `subprocess.run`.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_validate_ref_accepts_every_revision_git_itself_accepts"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_validate_ref_accepts_every_revision_git_itself_accepts", `name`: "test_validate_ref_accepts_every_revision_git_itself_accepts", `qualname`: "test_validate_ref_accepts_every_revision_git_itself_accepts", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1717, `end_line`: 1720, `signature`: "def test_validate_ref_accepts_every_revision_git_itself_accepts(rev):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_get_git_diff_returns_a_real_diff_between_two_refs"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_get_git_diff_returns_a_real_diff_between_two_refs", `name`: "test_get_git_diff_returns_a_real_diff_between_two_refs", `qualname`: "test_get_git_diff_returns_a_real_diff_between_two_refs", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1723, `end_line`: 1800, `signature`: "def test_get_git_diff_returns_a_real_diff_between_two_refs(tmp_path):", `docstring`: "The only test that lets `get_git_diff` reach git, and the detector for `--`.\n\n    Everything else in this module feeds `parse_unified_diff` static text, so a\n    malformed *argv* was invisible: `git diff -U0 -- main...feat` reads the\n    revision as a **pathspec**, matches nothing, and exits **0** with empty\n    stdout. `get_git_diff` then returns `\"\"`, `parse_unified_diff` returns `{}`,\n    and every impact report claims the PR changed no files -- with a zero exit\n    code, so neither the CLI nor `.github/workflows/pr-impact.yml` notices.\n\n    `added_lines == {2}` is hand-derived from the two", `entrypoint`: true, `reach`: 60};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_get_git_diff_returns_a_real_diff_between_two_refs.git"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_get_git_diff_returns_a_real_diff_between_two_refs.git", `name`: "git", `qualname`: "test_get_git_diff_returns_a_real_diff_between_two_refs.git", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1759, `end_line`: 1769, `signature`: "def git(*args: str) -> None:\n        # Bytes, never text=True -- the AGENTS.md git-decoding rule.", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_get_git_diff_failure_paths_report_rather_than_returning_empty"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_get_git_diff_failure_paths_report_rather_than_returning_empty", `name`: "test_get_git_diff_failure_paths_report_rather_than_returning_empty", `qualname`: "test_get_git_diff_failure_paths_report_rather_than_returning_empty", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1803, `end_line`: 1840, `signature`: "def test_get_git_diff_failure_paths_report_rather_than_returning_empty(tmp_path, monkeypatch):", `docstring`: "The restructured error paths, which nothing else reaches.\n\n    Three distinct branches, each of which previously could (or now must not)\n    quietly produce an empty diff -- the failure mode this whole area exists to\n    prevent, because an empty diff reads as \"the PR changed nothing\".", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_get_git_diff_failure_paths_report_rather_than_returning_empty._no_exec"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_get_git_diff_failure_paths_report_rather_than_returning_empty._no_exec", `name`: "_no_exec", `qualname`: "test_get_git_diff_failure_paths_report_rather_than_returning_empty._no_exec", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1818, `end_line`: 1819, `signature`: "def _no_exec(*_a, **_kw):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_get_git_diff_falls_back_to_two_dot_when_there_is_no_merge_base"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_get_git_diff_falls_back_to_two_dot_when_there_is_no_merge_base", `name`: "test_get_git_diff_falls_back_to_two_dot_when_there_is_no_merge_base", `qualname`: "test_get_git_diff_falls_back_to_two_dot_when_there_is_no_merge_base", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1843, `end_line`: 1894, `signature`: "def test_get_git_diff_falls_back_to_two_dot_when_there_is_no_merge_base(tmp_path):", `docstring`: "Unrelated histories have no merge base, so `A...B` fails and `A B` works.\n\n    This is the fallback's reason for existing (a shallow clone is the other), and\n    it is the one branch that returns a diff from the *second* subprocess.", `entrypoint`: true, `reach`: 60};
