MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cpp_parse.py::test_both_cpp_invocations_close_stdin"}) SET n += {`id`: "sym:tests/test_cpp_parse.py::test_both_cpp_invocations_close_stdin", `name`: "test_both_cpp_invocations_close_stdin", `qualname`: "test_both_cpp_invocations_close_stdin", `kind`: "function", `path`: "tests/test_cpp_parse.py", `lang`: "python", `start_line`: 282, `end_line`: 299, `signature`: "def test_both_cpp_invocations_close_stdin(mock_run):", `docstring`: "#240: capture_output redirects the child's stdout and stderr only, so\n    without stdin=DEVNULL cpp inherits ours -- under repo2graph-mcp on stdio\n    that handle is the client's JSON-RPC pipe. Asserted at the call site as\n    well as in test_compat's whole-package AST sweep.", `entrypoint`: true};
