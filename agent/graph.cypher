MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_build_performance"}) SET n += {`id`: "sym:repo2graph/cli.py::_build_performance", `name`: "_build_performance", `qualname`: "_build_performance", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 400, `end_line`: 429, `signature`: "def _build_performance(\n    g: Graph,\n    outdir: Path,\n    written: list[str],\n    build_s: float,\n    write_s: float,\n    chunk_chars: int,\n) -> dict[str, Any]:", `docstring`: "Timings and sizes for one build, for regression gates (#456, #304).\n\n    Reported here rather than in stats.json, which must stay byte-identical\n    between a full and an incremental build of the same tree."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_peak_rss_mb"}) SET n += {`id`: "sym:repo2graph/cli.py::_peak_rss_mb", `name`: "_peak_rss_mb", `qualname`: "_peak_rss_mb", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 432, `end_line`: 453, `signature`: "def _peak_rss_mb() -> float | None:", `docstring`: "Peak resident set of this process and its parse workers, or None (Windows).\n\n    The `sys.platform` test is what mypy narrows on; `try/except ImportError`\n    is not a platform guard it understands, so typeshed's win32-guarded\n    `getrusage` made `make typecheck` and the `mypy-strict` pre-commit hook red\n    on every Windows checkout -- invisible in CI, which typechecks on Linux\n    only (#484). The import guard stays for a platform that has the module but\n    not the call."};
