MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_iss199_a_disconnect_during_a_response_reaches_no_error_reporter"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss199_a_disconnect_during_a_response_reaches_no_error_reporter", `name`: "test_iss199_a_disconnect_during_a_response_reaches_no_error_reporter", `qualname`: "test_iss199_a_disconnect_during_a_response_reaches_no_error_reporter", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1037, `end_line`: 1064, `signature`: "def test_iss199_a_disconnect_during_a_response_reaches_no_error_reporter(\n    make_server, monkeypatch, capsys, fail_from, what\n):", `docstring`: "Issue 199: a client that hangs up mid-response is not an error.\n\n    `_send_json` guarded only the body write and only two of ConnectionError's\n    three subclasses, so a disconnect at `end_headers()` (every platform) or a\n    ConnectionAbortedError at the body write (Windows) escaped into the\n    server's error reporter. Either way the operator gets a record for\n    something that is not a fault, and before this package owned that reporter\n    the record was a multi-line traceback in a stream promised to be JSON-lines.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_iss199_an_escaping_handler_error_is_one_json_line"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss199_an_escaping_handler_error_is_one_json_line", `name`: "test_iss199_an_escaping_handler_error_is_one_json_line", `qualname`: "test_iss199_an_escaping_handler_error_is_one_json_line", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1067, `end_line`: 1094, `signature`: "def test_iss199_an_escaping_handler_error_is_one_json_line(make_server, monkeypatch, capsys):", `docstring`: "Issue 199, second half: whatever does escape stays machine-readable.\n\n    socketserver's default `handle_error` prints a dashed banner plus a full\n    traceback to stderr, which `events.py` promises is one JSON object per\n    line. A SIEM parsing it line by line gets a dozen lines that parse as none,\n    at exactly the moment the record matters most.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_iss199_an_escaping_handler_error_is_one_json_line.exploding_get"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss199_an_escaping_handler_error_is_one_json_line.exploding_get", `name`: "exploding_get", `qualname`: "test_iss199_an_escaping_handler_error_is_one_json_line.exploding_get", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1077, `end_line`: 1078, `signature`: "def exploding_get(self, send_body=True):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_iss233_a_deeply_nested_json_body_is_a_clean_400"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss233_a_deeply_nested_json_body_is_a_clean_400", `name`: "test_iss233_a_deeply_nested_json_body_is_a_clean_400", `qualname`: "test_iss233_a_deeply_nested_json_body_is_a_clean_400", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1097, `end_line`: 1120, `signature`: "def test_iss233_a_deeply_nested_json_body_is_a_clean_400(make_server):", `docstring`: "Issue 233: `json.loads` raises RecursionError, which is not a ValueError.\n\n    ~40 KB of nesting is well inside MAX_BODY_BYTES, and this runs before\n    `authenticate()`, so any caller that can reach POST /mcp could kill a\n    handler thread outright on a server that is otherwise fully locked down.", `entrypoint`: true, `reach`: 14};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_iss243_a_crlf_in_the_oidc_issuer_cannot_inject_a_response_header"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss243_a_crlf_in_the_oidc_issuer_cannot_inject_a_response_header", `name`: "test_iss243_a_crlf_in_the_oidc_issuer_cannot_inject_a_response_header", `qualname`: "test_iss243_a_crlf_in_the_oidc_issuer_cannot_inject_a_response_header", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1123, `end_line`: 1146, `signature`: "def test_iss243_a_crlf_in_the_oidc_issuer_cannot_inject_a_response_header(make_server):", `docstring`: "Issue 243: `_challenge()` interpolates oidc_issuer into WWW-Authenticate.\n\n    Operator-supplied, so not remotely exploitable -- but the module states a\n    rule for header values and this path did not follow it. The fix is\n    structural: `_send_json` sanitises every extra header, so the rule holds\n    for call sites nobody has written yet.", `entrypoint`: true, `reach`: 19};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_iss249_a_chunked_request_body_is_refused_with_411"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss249_a_chunked_request_body_is_refused_with_411", `name`: "test_iss249_a_chunked_request_body_is_refused_with_411", `qualname`: "test_iss249_a_chunked_request_body_is_refused_with_411", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1149, `end_line`: 1170, `signature`: "def test_iss249_a_chunked_request_body_is_refused_with_411(make_server):", `docstring`: "Issue 249: Content-Length is the only framing `_read_body` understands.\n\n    A chunked body measured as zero bytes was never read, so a spec-legal\n    client got \"expected a JSON-RPC object\" and a socket still holding its\n    request. Refusing the encoding by name says what is actually wrong.", `entrypoint`: true, `reach`: 17};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_iss249_the_handler_pins_its_protocol_version_deliberately"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss249_the_handler_pins_its_protocol_version_deliberately", `name`: "test_iss249_the_handler_pins_its_protocol_version_deliberately", `qualname`: "test_iss249_the_handler_pins_its_protocol_version_deliberately", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1173, `end_line`: 1185, `signature`: "def test_iss249_the_handler_pins_its_protocol_version_deliberately():", `docstring`: "Issue 249: HTTP/1.0 here is a decision, not an inheritance.\n\n    It is also the base class's default, so only the presence of the attribute\n    on this class distinguishes \"chosen\" from \"never thought about\" -- and the\n    choice is what keeps an unread request body (a refused Transfer-Encoding, a\n    413'd Content-Length, a read that timed out part-way) from being left in a\n    socket that the next request would be parsed out of.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_missing_index_without_repo_returns_503_actionable_error"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_missing_index_without_repo_returns_503_actionable_error", `name`: "test_missing_index_without_repo_returns_503_actionable_error", `qualname`: "test_missing_index_without_repo_returns_503_actionable_error", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1188, `end_line`: 1215, `signature`: "def test_missing_index_without_repo_returns_503_actionable_error(tmp_path):", `docstring`: "When no index exists and auto-build is off, HTTP mode returns 503 with instructions (#265).", `entrypoint`: true, `reach`: 50};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_a_missing_index_does_not_tell_the_caller_where_it_looked"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_a_missing_index_does_not_tell_the_caller_where_it_looked", `name`: "test_a_missing_index_does_not_tell_the_caller_where_it_looked", `qualname`: "test_a_missing_index_does_not_tell_the_caller_where_it_looked", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1221, `end_line`: 1261, `signature`: "def test_a_missing_index_does_not_tell_the_caller_where_it_looked(tmp_path):", `docstring`: "503 must not carry the host's filesystem layout.\n\n    `open_index` raises SystemExit with a message written for an operator at a\n    terminal, naming the absolute index directory twice. Relaying str(exc) put\n    that in a JSON-RPC error -- and therefore into the context window of any\n    agent driving this server -- which is the disclosure `_public_repo_label`\n    already refuses one endpoint over. The operator's detail belongs in the\n    audit log, which is server-side.", `entrypoint`: true, `reach`: 58};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_a_deeply_nested_jwt_header_gets_a_401_and_an_audit_record"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_a_deeply_nested_jwt_header_gets_a_401_and_an_audit_record", `name`: "test_a_deeply_nested_jwt_header_gets_a_401_and_an_audit_record", `qualname`: "test_a_deeply_nested_jwt_header_gets_a_401_and_an_audit_record", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1264, `end_line`: 1278, `signature`: "def test_a_deeply_nested_jwt_header_gets_a_401_and_an_audit_record(make_server):", `docstring`: "Repro C:/bench/audit_code/jwt_srv.py: a 3000-deep JWT header used to\n    raise RecursionError out of authenticate(), dropping the connection with no\n    401 and writing no `auth_rejected` record.", `entrypoint`: true, `reach`: 20};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_a_deeply_nested_jwt_header_gets_a_401_and_an_audit_record.b64"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_a_deeply_nested_jwt_header_gets_a_401_and_an_audit_record.b64", `name`: "b64", `qualname`: "test_a_deeply_nested_jwt_header_gets_a_401_and_an_audit_record.b64", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1270, `end_line`: 1271, `signature`: "def b64(raw: bytes) -> str:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_transport.py::test_tools_list_annotations_follow_this_server_s_build_capability"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_tools_list_annotations_follow_this_server_s_build_capability", `name`: "test_tools_list_annotations_follow_this_server_s_build_capability", `qualname`: "test_tools_list_annotations_follow_this_server_s_build_capability", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1281, `end_line`: 1305, `signature`: "def test_tools_list_annotations_follow_this_server_s_build_capability(make_server, tmp_path):", `docstring`: "#292: `readOnlyHint` must describe the server answering, not the tool.\n\n    `tools/list` is answered once for a server's whole lifetime, so the\n    annotation has to reflect whether *this* server can build. A server given\n    a repo to build from may, on the first call to any tool but\n    `repo_build_status`, parse the whole repository, run git and write\n    `.r2g/**` -- and the client inspecting annotations has no other way to\n    learn that.\n\n    Detector: this handler used to spread the flat `TOOL_ANNOTATIONS`\n    constant, so the second half of this test saw `readOnlyHint: True`.", `entrypoint`: true};
