MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_hmac_algorithm_confusion_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_hmac_algorithm_confusion_is_refused", `name`: "test_hmac_algorithm_confusion_is_refused", `qualname`: "test_hmac_algorithm_confusion_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 237, `end_line`: 251, `signature`: "def test_hmac_algorithm_confusion_is_refused():", `docstring`: "HS256 signed with the RSA public key must not validate.\n\n    If the verifier picks its algorithm from the token, an attacker who has the\n    public key -- which is public -- can mint tokens at will.", `entrypoint`: true, `reach`: 26};
