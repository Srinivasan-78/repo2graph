MERGE (n:R2G:Symbol {id: "sym:repo2graph/tasks.py::TaskManager.for_dir"}) SET n += {`id`: "sym:repo2graph/tasks.py::TaskManager.for_dir", `name`: "for_dir", `qualname`: "TaskManager.for_dir", `kind`: "function", `path`: "repo2graph/tasks.py", `lang`: "python", `start_line`: 213, `end_line`: 216, `signature`: "def for_dir(self, out: Any) -> BuildTask | None:", `docstring`: "The most recent task for this index directory, or None."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/tasks.py::TaskManager.forget"}) SET n += {`id`: "sym:repo2graph/tasks.py::TaskManager.forget", `name`: "forget", `qualname`: "TaskManager.forget", `kind`: "function", `path`: "repo2graph/tasks.py", `lang`: "python", `start_line`: 218, `end_line`: 221, `signature`: "def forget(self, out: Any) -> None:", `docstring`: "Drop the task recorded for `out`, so a later failure can be retried.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/tasks.py::_default_estimator"}) SET n += {`id`: "sym:repo2graph/tasks.py::_default_estimator", `name`: "_default_estimator", `qualname`: "_default_estimator", `kind`: "function", `path`: "repo2graph/tasks.py", `lang`: "python", `start_line`: 224, `end_line`: 242, `signature`: "def _default_estimator(repo: Any) -> float:", `docstring`: "Guess a build's duration from how many files discovery finds.\n\n    Discovery is cheap next to parsing -- it is a `git ls-files` or one walk --\n    so paying for it up front to produce an honest eta is worth it.\n\n    Args:\n        repo: Repository directory.\n\n    Returns:\n        Estimated seconds, never less than one.", `entrypoint`: true};
