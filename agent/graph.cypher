MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_manifest_usage_hints_are_present_and_non_empty"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_manifest_usage_hints_are_present_and_non_empty", `name`: "test_manifest_usage_hints_are_present_and_non_empty", `qualname`: "test_manifest_usage_hints_are_present_and_non_empty", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 713, `end_line`: 744, `signature`: "def test_manifest_usage_hints_are_present_and_non_empty(tmp_path, sample_repo):", `docstring`: "usage_hints lets an agent orient without a round-trip tool call: every\n    key is populated, and edge_type_meanings/what_is_not_indexed are derived\n    from the same source manifest.json's top-level edge_types and the skip\n    labels write_overview_human's \"What was skipped\" section uses -- not a\n    second hand-authored copy that can drift.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_manifest_states_the_fan_out_this_build_used"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_manifest_states_the_fan_out_this_build_used", `name`: "test_manifest_states_the_fan_out_this_build_used", `qualname`: "test_manifest_states_the_fan_out_this_build_used", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 748, `end_line`: 772, `signature`: "def test_manifest_states_the_fan_out_this_build_used(tmp_path, sample_repo, limit):", `docstring`: "#245: the fan-out limit is per build (`--max-call-candidates`), but the\n    manifest's prose used to hardcode \"up to 5\" -- so an index built with 2\n    shipped an artifact asserting 5, to an agent that was told the manifest is\n    authoritative. Both limits here are non-default literals on purpose: at the\n    default the buggy text and the correct text are the same string, so a test\n    run only at 5 detects nothing.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_manifest_defaults_when_the_graph_never_went_through_build"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_manifest_defaults_when_the_graph_never_went_through_build", `name`: "test_manifest_defaults_when_the_graph_never_went_through_build", `qualname`: "test_manifest_defaults_when_the_graph_never_went_through_build", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 775, `end_line`: 796, `signature`: "def test_manifest_defaults_when_the_graph_never_went_through_build(tmp_path):", `docstring`: "write_manifest has only ever duck-typed `g`, and a Graph assembled by\n    hand has no build to inherit a fan-out limit from. It must still write a\n    manifest stating the default rather than raising: a wrong number is the\n    #245 bug, but no manifest at all is worse than one carrying the default.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_manifest_defaults_when_the_graph_never_went_through_build.BareGraph"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_manifest_defaults_when_the_graph_never_went_through_build.BareGraph", `name`: "BareGraph", `qualname`: "test_manifest_defaults_when_the_graph_never_went_through_build.BareGraph", `kind`: "class", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 785, `end_line`: 788, `signature`: "class BareGraph:  # only what write_manifest has ever required of `g`", `docstring`: ""};
