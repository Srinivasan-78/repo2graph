MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::mcp_client_config_paths"}) SET n += {`id`: "sym:repo2graph/doctor.py::mcp_client_config_paths", `name`: "mcp_client_config_paths", `qualname`: "mcp_client_config_paths", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 856, `end_line`: 889, `signature`: "def mcp_client_config_paths(cwd: Path | None = None) -> list[tuple[str, Path]]:", `docstring`: "(client label, config path) for every MCP client config location.\n\n    The list is the documented set from docs/mcp.md plus the two project-scoped\n    files, and it is returned whether or not the files exist -- the caller\n    decides what an absent one means."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::_is_repo2graph_server"}) SET n += {`id`: "sym:repo2graph/doctor.py::_is_repo2graph_server", `name`: "_is_repo2graph_server", `qualname`: "_is_repo2graph_server", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 892, `end_line`: 896, `signature`: "def _is_repo2graph_server(key: str, entry: dict[str, Any]) -> bool:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::_inspect_server_entry"}) SET n += {`id`: "sym:repo2graph/doctor.py::_inspect_server_entry", `name`: "_inspect_server_entry", `qualname`: "_inspect_server_entry", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 899, `end_line`: 963, `signature`: "def _inspect_server_entry(label: str, key: str, entry: dict[str, Any]) -> tuple[str, list[str]]:", `docstring`: "Validate one mcpServers entry. Returns (status, messages).\n\n    Never reads or echoes `entry[\"env\"]` values -- an MCP client config is\n    exactly where an API key lives, and this report is meant to be pasteable\n    into a bug report."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::check_mcp_client_config"}) SET n += {`id`: "sym:repo2graph/doctor.py::check_mcp_client_config", `name`: "check_mcp_client_config", `qualname`: "check_mcp_client_config", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 966, `end_line`: 1069, `signature`: "def check_mcp_client_config(cwd: Path | None = None) -> CheckResult:", `docstring`: "Find and validate repo2graph entries in the MCP clients' config files."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::check_mcp_client_config._worsen"}) SET n += {`id`: "sym:repo2graph/doctor.py::check_mcp_client_config._worsen", `name`: "_worsen", `qualname`: "check_mcp_client_config._worsen", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 973, `end_line`: 977, `signature`: "def _worsen(new: str) -> None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::check_index_freshness"}) SET n += {`id`: "sym:repo2graph/doctor.py::check_index_freshness", `name`: "check_index_freshness", `qualname`: "check_index_freshness", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 1072, `end_line`: 1168, `signature`: "def check_index_freshness(path: Path) -> CheckResult:", `docstring`: "Does the index still describe the tree it was built from?\n\n    Three independent signals, cheapest first: the commit the index records\n    versus the tree's current HEAD; the set of files discovered now versus the\n    set recorded in index.state.json; and, for files whose mtime is newer than\n    the manifest's, a real sha256 against the hash the build recorded. The\n    mtime is only used to choose what to hash -- a file that was touched but\n    not changed hashes equal and is reported as unchanged, so a checkout that\n    rewrites every mtime does not produce a false \"stale\"."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::check_parsers"}) SET n += {`id`: "sym:repo2graph/doctor.py::check_parsers", `name`: "check_parsers", `qualname`: "check_parsers", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 1171, `end_line`: 1271, `signature`: "def check_parsers(path: Path) -> CheckResult:", `docstring`: "Parse failures and unparsed file types in an index that already exists.\n\n    check_tree_sitter answers \"can this machine load the grammars\"; this one\n    answers \"did they work on this repository\" -- a grammar that loads fine\n    still produces a symbol-free file node when the source uses syntax it does\n    not model, and that file is then reachable by text but has no CALLS edges."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::check_ignored_paths"}) SET n += {`id`: "sym:repo2graph/doctor.py::check_ignored_paths", `name`: "check_ignored_paths", `qualname`: "check_ignored_paths", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 1300, `end_line`: 1370, `signature`: "def check_ignored_paths(path: Path) -> CheckResult:", `docstring`: "What discovery left out, and whether that is more than the user expects.\n\n    The failure this catches is silent: a repository whose source lives under\n    a directory name that happens to be in DEFAULT_SKIP_DIRS (`build/`,\n    `target/`, `dist/`) indexes cleanly and answers every question with\n    nothing, because most of it was never discovered."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::_generated_reason"}) SET n += {`id`: "sym:repo2graph/doctor.py::_generated_reason", `name`: "_generated_reason", `qualname`: "_generated_reason", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 1379, `end_line`: 1390, `signature`: "def _generated_reason(rel: str) -> str | None:", `docstring`: "Why `rel` looks machine-written, or None. Path-only; never reads bytes.\n\n    Delegates to `exclusions.classify`, which is also what\n    `build --exclude-group` expands from. When this check and that flag kept\n    separate tables, the check could flag a shape the flag had no pattern for,\n    and the remediation it printed then changed nothing.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::check_generated_code"}) SET n += {`id`: "sym:repo2graph/doctor.py::check_generated_code", `name`: "check_generated_code", `qualname`: "check_generated_code", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 1393, `end_line`: 1486, `signature`: "def check_generated_code(path: Path) -> CheckResult:", `docstring`: "Vendored or machine-written files that made it *into* the index.\n\n    The cost is not disk: generated code is usually the largest and most\n    repetitive text in a repository, so it dominates BM25 and crowds\n    hand-written code out of a bounded pack. Finding it is the difference\n    between \"the answers are vague\" and a one-flag fix."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::run_doctor"}) SET n += {`id`: "sym:repo2graph/doctor.py::run_doctor", `name`: "run_doctor", `qualname`: "run_doctor", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 1489, `end_line`: 1513, `signature`: "def run_doctor(path: str | Path = \".\") -> DoctorReport:", `docstring`: "Execute all diagnostic checks against the specified path."};
