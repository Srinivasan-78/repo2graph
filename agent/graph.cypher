MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_parse_unified_diff_basic"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_parse_unified_diff_basic", `name`: "test_parse_unified_diff_basic", `qualname`: "test_parse_unified_diff_basic", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 51, `end_line`: 78, `signature`: "def test_parse_unified_diff_basic():", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_a_diff_that_quotes_a_diff_does_not_rewrite_the_enclosing_file"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_a_diff_that_quotes_a_diff_does_not_rewrite_the_enclosing_file", `name`: "test_a_diff_that_quotes_a_diff_does_not_rewrite_the_enclosing_file", `qualname`: "test_a_diff_that_quotes_a_diff_does_not_rewrite_the_enclosing_file", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 81, `end_line`: 134, `signature`: "def test_a_diff_that_quotes_a_diff_does_not_rewrite_the_enclosing_file():", `docstring`: "Hunk *content* must never be read as a file header.\n\n    Every line inside a hunk carries a `+`/`-`/space prefix, so a source line\n    reading `++ b/oops.py` arrives as `+++ b/oops.py` and one reading\n    `-- /dev/null` arrives as `--- /dev/null`. Matching those against the\n    `+++ `/`--- ` header branches let a diff's own content rename the enclosing\n    file, delete its entry, and flip its status -- so every symbol in the\n    genuinely-changed file was skipped by `analyze_diff_impact`'s\n    `path not in file_diffs` test and the report named a file never touched.\n    A diff that merely quote", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_an_unparseable_file_header_does_not_bleed_into_the_previous_file"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_an_unparseable_file_header_does_not_bleed_into_the_previous_file", `name`: "test_an_unparseable_file_header_does_not_bleed_into_the_previous_file", `qualname`: "test_an_unparseable_file_header_does_not_bleed_into_the_previous_file", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 137, `end_line`: 189, `signature`: "def test_an_unparseable_file_header_does_not_bleed_into_the_previous_file():", `docstring`: "`diff --cc` and a git-quoted path both fail DIFF_GIT_RE -- and must still\n    end the previous file's block.\n\n    `current_hunk` used to be reset only on a successful DIFF_GIT_RE match, so a\n    header this parser cannot split arrived with the *previous* file's hunk still\n    open and its body lines were charged to that file. Phantom `added_lines` are\n    load-bearing: `analyze_diff_impact` selects changed symbols from exactly that\n    set, so the report names symbols the PR never touched.\n\n    Combined diffs are not supported (`@@@` is not `HUNK_RE`), and that is fine --\n    `get_git_diff` ne", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_no_newline_at_end_of_file_does_not_advance_the_line_counter"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_no_newline_at_end_of_file_does_not_advance_the_line_counter", `name`: "test_no_newline_at_end_of_file_does_not_advance_the_line_counter", `qualname`: "test_no_newline_at_end_of_file_does_not_advance_the_line_counter", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 192, `end_line`: 211, `signature`: "def test_no_newline_at_end_of_file_does_not_advance_the_line_counter():", `docstring`: "`\\\\ No newline at end of file` is legal *mid*-hunk and is not a line.\n\n    It follows the last line of whichever side lacks the trailing newline, so it\n    can land between the `-` lines and the `+` lines. Counting it as a context\n    line pushed every later `+` in the hunk down by one.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_parse_unified_diff_added_and_deleted_files"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_parse_unified_diff_added_and_deleted_files", `name`: "test_parse_unified_diff_added_and_deleted_files", `qualname`: "test_parse_unified_diff_added_and_deleted_files", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 214, `end_line`: 239, `signature`: "def test_parse_unified_diff_added_and_deleted_files():", `docstring`: "", `entrypoint`: true};
