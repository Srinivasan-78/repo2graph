MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_has_index"}) SET n += {`id`: "sym:repo2graph/mcp.py::_has_index", `name`: "_has_index", `qualname`: "_has_index", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 619, `end_line`: 621, `signature`: "def _has_index(out_path: Path) -> bool:", `docstring`: "True when `out_path` holds an index a tool can actually read."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_build_index"}) SET n += {`id`: "sym:repo2graph/mcp.py::_build_index", `name`: "_build_index", `qualname`: "_build_index", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 624, `end_line`: 649, `signature`: "def _build_index(repo: Path, out: Path) -> None:", `docstring`: "Index `repo` into `out`, in-process, silent on stdout.\n\n    One constraint, and it is about the transport rather than about graphs:\n    nothing may reach stdout. It carries the JSON-RPC stream, and one stray\n    `print` ends the session. `graph.build` and `export.dump_all` write no\n    console output of their own -- the CLI's `cmd_build` is what emits the JSON\n    report -- so calling them directly is what keeps the wire clean.\n\n    That constraint used to be met with `jobs=1`, because `build()` reaches for\n    a process pool above PARALLEL_MIN_FILES files and the workers inherit the\n    paren"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::open_index"}) SET n += {`id`: "sym:repo2graph/mcp.py::open_index", `name`: "open_index", `qualname`: "open_index", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 652, `end_line`: 717, `signature`: "def open_index(out, repo=None, cache=None) -> Index:", `docstring`: "One Index per output directory, reused for the life of the process.\n\n    Building an Index reads and inverts every chunk; doing that per tool call\n    would make the second call as expensive as the first.\n\n    `repo` is the opt-in half. Without it this is what it has always been: open\n    an index that exists, or exit naming the command that creates one. With it,\n    an absent index is built from that directory first -- so an agent that was\n    pointed at a repo gets an answer instead of an error it cannot act on. It\n    stays opt-in because inferring a repo to index from an output path alone "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::open_index_or_task"}) SET n += {`id`: "sym:repo2graph/mcp.py::open_index_or_task", `name`: "open_index_or_task", `qualname`: "open_index_or_task", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 720, `end_line`: 759, `signature`: "def open_index_or_task(out, repo=None, cache=None, tasks=None):", `docstring`: "Open the index, or start a background build and say so.\n\n    Args:\n        out: Index directory.\n        repo: Repository to build from, or None.\n        cache: A `ResultCache` to clear on a completed rebuild, or None.\n        tasks: A `TaskManager` when `--async-build` is on, else None.\n\n    Returns:\n        `(index, None)` when an index is available, or `(None, message)` when a\n        build is in flight or has failed -- the message being what the caller\n        should hand back to the agent verbatim."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::tool_repo_map"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_repo_map", `name`: "tool_repo_map", `qualname`: "tool_repo_map", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 765, `end_line`: 768, `signature`: "def tool_repo_map(index: Index) -> str:", `docstring`: "The repo map, plus a staleness note (#383) when the source tree has\n    moved since the index was built -- see `_staleness_note`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::tool_repo_search"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_repo_search", `name`: "tool_repo_search", `qualname`: "tool_repo_search", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 771, `end_line`: 816, `signature`: "def tool_repo_search(\n    index: Index, query: str, k: Any = 8, hops: Any = 1, budget_tokens=None\n) -> str:", `docstring`: "Cited markdown for `query`, never wider than MCP_MAX_BUDGET_TOKENS."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::tool_repo_neighbours"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_repo_neighbours", `name`: "tool_repo_neighbours", `qualname`: "tool_repo_neighbours", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 819, `end_line`: 860, `signature`: "def tool_repo_neighbours(\n    index: Index, node_id: str, hops: Any = 1, limit: Any = MCP_NEIGHBOUR_LIMIT\n) -> str:", `docstring`: "One graph hop from `node_id` \u2014 the thing grep cannot do."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_chunk_body_lines"}) SET n += {`id`: "sym:repo2graph/mcp.py::_chunk_body_lines", `name`: "_chunk_body_lines", `qualname`: "_chunk_body_lines", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 873, `end_line`: 905, `signature`: "def _chunk_body_lines(c: dict[str, Any]) -> list[str] | None:", `docstring`: "`c[\"text\"]` with its `chunks.iter_chunks` header stripped, one entry per\n    physical source line covering `[start_line, end_line]` -- or None when\n    that cannot be trusted.\n\n    `text` is always `\"\\\\n\".join(header) + \"\\\\n\" + body`\n    (chunks.py:257,332), and `header`'s own length varies chunk to chunk\n    (entry-point/inherits/callers/callees/doc lines are each conditional), so\n    there is no fixed offset to strip. But for a `symbol` chunk, or a `file`\n    chunk with no symbols carved out of it, `body` is *exactly*\n    `end_line - start_line + 1` physical lines (chunks.py:190,294) -- so t"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_aux"}) SET n += {`id`: "sym:repo2graph/mcp.py::_aux", `name`: "_aux", `qualname`: "_aux", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 908, `end_line`: 956, `signature`: "def _aux(index: Index) -> dict[str, Any]:", `docstring`: "Build (once) and cache {\"exact\", \"ci\", \"last_seg\", \"by_path\"} for `index`.\n\n    \"exact\"/\"ci\"/\"last_seg\" are name -> [node_id, ...] lookups for\n    repo_find_symbol, in the same precedence `_boost_identifiers` uses\n    (query.py:356-376): exact identifier, then case-insensitive, then the\n    last `::`/`.`-separated segment of qualname. \"by_path\" is\n    path -> [{start_line, end_line, lines}, ...] for repo_read, pre-stripped\n    of their chunk header (`_chunk_body_lines`) and sorted by line range;\n    chunks whose body cannot be trusted for exact-line reconstruction are\n    left out, not guessed"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::tool_repo_find_symbol"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_repo_find_symbol", `name`: "tool_repo_find_symbol", `qualname`: "tool_repo_find_symbol", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 959, `end_line`: 1015, `signature`: "def tool_repo_find_symbol(\n    index: Index,\n    name: str,\n    kind: str = \"\",\n    path_prefix: str = \"\",\n    limit: Any = MCP_FIND_LIMIT,\n) -> str:", `docstring`: "Name -> node_id(s): the lookup repo_neighbours/repo_read/repo_path_between\n    /repo_blast_radius have no other way to get, short of a repo_search round trip."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::tool_repo_read"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_repo_read", `name`: "tool_repo_read", `qualname`: "tool_repo_read", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1018, `end_line`: 1104, `signature`: "def tool_repo_read(\n    index: Index,\n    path: str,\n    start_line: Any = 1,\n    end_line: Any = None,\n    context: Any = 0,\n) -> str:", `docstring`: "Widen a `[cite: path:start-end]` citation, from chunks.jsonl, not disk.\n\n    Reading chunks rather than the filesystem is the load-bearing choice\n    (#385): chunks have already passed secret-path exclusion and content\n    redaction, the filesystem has not, and a served index may have no source\n    tree beside it at all (the `graph` branch / Action-artifact case). A span\n    not covered by any chunk -- including the `file_residual`\n    under-40-character case, AGENTS.md -- answers \"not indexed\" rather than\n    falling back to disk."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_path_secret"}) SET n += {`id`: "sym:repo2graph/mcp.py::_path_secret", `name`: "_path_secret", `qualname`: "_path_secret", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1107, `end_line`: 1109, `signature`: "def _path_secret(index: Index, node_id: str) -> bool:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_clean_edge_types"}) SET n += {`id`: "sym:repo2graph/mcp.py::_clean_edge_types", `name`: "_clean_edge_types", `qualname`: "_clean_edge_types", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1112, `end_line`: 1122, `signature`: "def _clean_edge_types(value: Any, default=DEFAULT_PATH_EDGE_TYPES) -> tuple[frozenset, str]:", `docstring`: "Coerce repo_path_between's `edge_types`, defaulting on anything unusable."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_reconstruct"}) SET n += {`id`: "sym:repo2graph/mcp.py::_reconstruct", `name`: "_reconstruct", `qualname`: "_reconstruct", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1125, `end_line`: 1141, `signature`: "def _reconstruct(parents: dict, node: str, root: str, cap: int) -> list[tuple[list, list]]:", `docstring`: "Every (node-id path, edge-tuple path) from `root` to `node`, capped at `cap`.\n\n    `parents[node]` holds every `(parent, etype, direction, edge)` that\n    reaches `node` at its shortest distance from `root` -- more than one\n    entry when several edges tie for shortest, which is how several distinct\n    shortest paths get reconstructed rather than just one."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_bidirectional_bfs"}) SET n += {`id`: "sym:repo2graph/mcp.py::_bidirectional_bfs", `name`: "_bidirectional_bfs", `qualname`: "_bidirectional_bfs", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1144, `end_line`: 1211, `signature`: "def _bidirectional_bfs(\n    index: Index,\n    from_id: str,\n    to_id: str,\n    wanted: frozenset,\n    max_hops: int,\n    visited_cap: int,\n):", `docstring`: "Meet-in-the-middle BFS over index.adj, alternating the smaller frontier.\n\n    Real work is roughly `max_hops / 2` layers deep on each side rather than\n    `max_hops` deep on one -- the difference between tractable and not on a\n    dense call graph (#386). Returns\n    `(dist_f, parents_f, dist_b, parents_b, meet, truncated)`; `dist_f`/\n    `parents_f` are rooted at `from_id`, `dist_b`/`parents_b` at `to_id`, and\n    `meet` is the node where the two frontiers first touched (or None)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::tool_repo_path_between"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_repo_path_between", `name`: "tool_repo_path_between", `qualname`: "tool_repo_path_between", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1214, `end_line`: 1329, `signature`: "def tool_repo_path_between(\n    index: Index,\n    from_id: str,\n    to_id: str,\n    max_hops: Any = MCP_PATH_HOPS,\n    edge_types: Any = None,\n    max_paths: Any = MCP_PATH_PATHS,\n) -> str:", `docstring`: "Bounded, bidirectional path(s) between `from_id` and `to_id`, with the\n    minimum edge confidence along each -- the question a graph answers that\n    grep cannot approximate at all (#386)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::tool_repo_path_between._min_conf"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_repo_path_between._min_conf", `name`: "_min_conf", `qualname`: "tool_repo_path_between._min_conf", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1271, `end_line`: 1277, `signature`: "def _min_conf(edges) -> float:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::tool_repo_impact"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_repo_impact", `name`: "tool_repo_impact", `qualname`: "tool_repo_impact", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1332, `end_line`: 1504, `signature`: "def tool_repo_impact(\n    index: Index,\n    base: str = \"main\",\n    head: str | None = None,\n    diff: str = \"\",\n    max_depth: Any = 2,\n    format: str = \"markdown\",\n) -> str:", `docstring`: "Analyze PR or git diff impact against a base branch using the code graph.\n\n    With no `head`, the working tree (committed *and* uncommitted changes) is\n    compared against `base` -- what `repo2graph impact` does. A `head` gives the\n    three-dot `base...head` comparison of two refs instead.\n\n    Enforces exclude_secrets=True unconditionally and clamps numeric arguments."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_reverse_closure"}) SET n += {`id`: "sym:repo2graph/mcp.py::_reverse_closure", `name`: "_reverse_closure", `qualname`: "_reverse_closure", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1507, `end_line`: 1543, `signature`: "def _reverse_closure(\n    index: Index, seed: str, etype: str, max_hops: int, visited_cap: int\n) -> tuple[dict[str, int], bool]:", `docstring`: "{node_id: hop_distance} walking `etype` edges backward from `seed`.\n\n    An adjacency entry `(dst, et, \"in\", edge)` on `seed` means the edge's\n    real source is `dst` -- something pointing *at* `seed` -- which is\n    exactly \"what would break if `seed` changed\": callers of callers for\n    CALLS, subclasses of subclasses for INHERITS, importers of importers for\n    IMPORTS. Capped by `visited_cap` as well as `max_hops`, and returns\n    `truncated=True` rather than a partial set presented as complete (#387)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_containing_file"}) SET n += {`id`: "sym:repo2graph/mcp.py::_containing_file", `name`: "_containing_file", `qualname`: "_containing_file", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1546, `end_line`: 1555, `signature`: "def _containing_file(index: Index, node_id: str) -> str | None:", `docstring`: "`node_id`'s own file node, or `node_id` itself when it already is one."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::tool_repo_blast_radius"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_repo_blast_radius", `name`: "tool_repo_blast_radius", `qualname`: "tool_repo_blast_radius", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1558, `end_line`: 1679, `signature`: "def tool_repo_blast_radius(\n    index: Index,\n    node_id: str,\n    max_hops: Any = MCP_IMPACT_HOPS,\n    include_cochange: Any = True,\n    limit: Any = MCP_IMPACT_LIMIT,\n) -> str:", `docstring`: "Reverse reachability from `node_id`: what would break if it changed.\n\n    The reverse of repo_neighbours' one hop in both directions: this is\n    specifically the reverse *closure* -- callers of callers, subclasses of\n    subclasses, importers of importers of the containing file -- by hop\n    distance, plus CO_CHANGE files kept visually separate because they are\n    historical correlation, not an edge the AST produced (#387). Note: #387\n    named this tool `repo_impact`, but that name already belongs to the\n    PR/diff-impact tool above (a fully built, different, existing feature);\n    it ship"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::tool_repo_blast_radius._rows"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_repo_blast_radius._rows", `name`: "_rows", `qualname`: "tool_repo_blast_radius._rows", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1592, `end_line`: 1605, `signature`: "def _rows(dist: dict[str, int]) -> list[dict[str, Any]]:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_impact_root"}) SET n += {`id`: "sym:repo2graph/mcp.py::_impact_root", `name`: "_impact_root", `qualname`: "_impact_root", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1682, `end_line`: 1699, `signature`: "def _impact_root(index: Index) -> Path:", `docstring`: "The source tree repo_impact runs git in: the server's indexed root.\n\n    Never `Path.cwd()` -- an MCP client launches the server from wherever it\n    likes. In order: the repo the server was started for (`open_index` sets\n    `repo_root`), the absolute root the build recorded in manifest.json,\n    and finally the index directory's parent (the `<repo>/.r2g` layout)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_staleness_note"}) SET n += {`id`: "sym:repo2graph/mcp.py::_staleness_note", `name`: "_staleness_note", `qualname`: "_staleness_note", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1702, `end_line`: 1750, `signature`: "def _staleness_note(index: Index) -> str:", `docstring`: "A `_note:` line when the index no longer matches the working tree (#383).\n\n    `_index_mtime`/`open_index`'s reload check both compare the index against\n    *itself at an earlier moment* -- neither ever looks at the source tree, so\n    a long-running server answers from a stale graph indefinitely and every\n    `[cite: path:start-end]` anchor it hands out is confidently wrong. The\n    fix is `status.compute_freshness`: it already does the real comparison\n    (HEAD commit, then the per-file sha256 `index.state.json` records against\n    a fresh `discover()`) for `index-status`/`doctor`, and nothi"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_scrub_paths"}) SET n += {`id`: "sym:repo2graph/mcp.py::_scrub_paths", `name`: "_scrub_paths", `qualname`: "_scrub_paths", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1759, `end_line`: 1764, `signature`: "def _scrub_paths(text: str, root: Path) -> str:", `docstring`: "Remove absolute filesystem paths from an error message."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_edge_note"}) SET n += {`id`: "sym:repo2graph/mcp.py::_edge_note", `name`: "_edge_note", `qualname`: "_edge_note", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1767, `end_line`: 1795, `signature`: "def _edge_note(index: \"Index\", src: str, dst: str, etype: str) -> str:", `docstring`: "Where the relationship is written, and how sure repo2graph is of it.\n\n    The node label already says where the *neighbour* is defined. For \"what\n    calls this\", the citation an agent actually needs is the call site, which\n    lives on the edge -- and without the confidence, an ambiguous name match\n    reads exactly like a certain one. `compute_freshness -> ResultCache.get`\n    is a real example from this repository: a `.get()` on a dict resolved to\n    one of three candidates at 0.5, and the tool presented it as fact.\n\n    Certain edges get only their evidence, so the common case stays terse"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_label"}) SET n += {`id`: "sym:repo2graph/mcp.py::_label", `name`: "_label", `qualname`: "_label", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1798, `end_line`: 1804, `signature`: "def _label(index: Index, node_id: str) -> str:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_int"}) SET n += {`id`: "sym:repo2graph/mcp.py::_int", `name`: "_int", `qualname`: "_int", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1807, `end_line`: 1819, `signature`: "def _int(value, fallback: int) -> int:", `docstring`: "An MCP client's arguments are JSON a model wrote: coerce, never raise.\n\n    `OverflowError` too: Python's `json` parses `1e999` as `float(\"inf\")` (and\n    `NaN`/`Infinity` literally), and `int(inf)` raises OverflowError rather than\n    ValueError. NaN already lands in ValueError. Both are malformed input and\n    take the fallback, like a string or a null -- a caller asking for an\n    infinite budget gets the default, not the ceiling."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_defaulted_notes"}) SET n += {`id`: "sym:repo2graph/mcp.py::_defaulted_notes", `name`: "_defaulted_notes", `qualname`: "_defaulted_notes", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1822, `end_line`: 1840, `signature`: "def _defaulted_notes(**args: tuple[Any, int]) -> str:", `docstring`: "One `_note:` line per argument that was given but is not a number.\n\n    Such a value takes the default rather than failing the call (docs/mcp.md,\n    \"Argument bounds\"), but it did so silently: `k: \"abc\"` looked honoured.\n    Charged to the output like BUDGET_DEFAULTED; empty when all were usable."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_clamp"}) SET n += {`id`: "sym:repo2graph/mcp.py::_clamp", `name`: "_clamp", `qualname`: "_clamp", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1843, `end_line`: 1845, `signature`: "def _clamp(value, fallback: int, low: int, high: int) -> int:", `docstring`: "_int, then held inside [low, high]: no argument may cost unbounded time."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_str"}) SET n += {`id`: "sym:repo2graph/mcp.py::_str", `name`: "_str", `qualname`: "_str", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1848, `end_line`: 1855, `signature`: "def _str(value, max_chars: int) -> str:", `docstring`: "Coerce a caller-supplied string argument and cap its length.\n\n    A model can hand this dispatcher an arbitrarily long value; this is the\n    string-typed counterpart to `_clamp` for the numeric arguments."};
