MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::_is_repo2graph_manifest"}) SET n += {`id`: "sym:repo2graph/doctor.py::_is_repo2graph_manifest", `name`: "_is_repo2graph_manifest", `qualname`: "_is_repo2graph_manifest", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 350, `end_line`: 367, `signature`: "def _is_repo2graph_manifest(manifest_file: Path) -> bool:", `docstring`: "True only if `manifest_file` parses as a repo2graph manifest.json.\n\n    A bare `agent/` directory or a `chunks.jsonl` are not proof of a\n    repo2graph index -- both names collide with unrelated projects (agent\n    frameworks, ML repos with their own chunk files). The manifest's\n    \"format\" key, written by export.write_manifest as \"repo2graph/1\", is\n    the only reliable signal. A missing or unparseable manifest means \"not\n    our index\", not \"corrupt index\" -- check_artifact_integrity only\n    reports corruption once this function has confirmed the directory is\n    actually ours."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::_find_index_dir"}) SET n += {`id`: "sym:repo2graph/doctor.py::_find_index_dir", `name`: "_find_index_dir", `qualname`: "_find_index_dir", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 370, `end_line`: 401, `signature`: "def _find_index_dir(path: Path) -> Path | None:", `docstring`: "Locate an existing repo2graph index directory if present.\n\n    \".r2g\" is repo2graph's own default -o name (cli.py) and collides with\n    nothing else, so a bare agent/ or chunks.jsonl found there is already\n    corroborating evidence -- including a corrupt manifest.json, which\n    check_artifact_integrity should go on to report as broken. Anywhere\n    else, \"agent/\" and \"chunks.jsonl\" are generic names that unrelated\n    projects (agent frameworks, ML repos) use too, so only a manifest.json\n    that actually parses as ours counts as proof."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::_agent_dir"}) SET n += {`id`: "sym:repo2graph/doctor.py::_agent_dir", `name`: "_agent_dir", `qualname`: "_agent_dir", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 416, `end_line`: 422, `signature`: "def _agent_dir(idx_dir: Path) -> Path:", `docstring`: "The directory holding agent artifacts, whether or not it is nested.\n\n    A caller may hand `doctor` either the `-o` output directory (artifacts\n    live under `agent/`) or the `agent/` directory itself."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::_read_stats"}) SET n += {`id`: "sym:repo2graph/doctor.py::_read_stats", `name`: "_read_stats", `qualname`: "_read_stats", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 425, `end_line`: 436, `signature`: "def _read_stats(idx_dir: Path) -> dict[str, Any]:", `docstring`: "stats.json as a dict, or {} when it is absent or unreadable."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::_iter_file_nodes"}) SET n += {`id`: "sym:repo2graph/doctor.py::_iter_file_nodes", `name`: "_iter_file_nodes", `qualname`: "_iter_file_nodes", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 439, `end_line`: 469, `signature`: "def _iter_file_nodes(idx_dir: Path) -> Iterator[dict[str, Any]]:", `docstring`: "Stream the `type == \"file\"` records out of nodes.jsonl.\n\n    newline=\"\\\\n\" and a per-line json.loads rather than read_jsonl: the whole\n    node list of a large repository does not need to be resident to answer\n    \"which of these paths look generated\", and `json.dumps(ensure_ascii=False)`\n    passes U+2028/U+2029 through verbatim -- universal-newline mode would cut\n    those records in half. Same reasoning as query.read_jsonl."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::_repo_root_for"}) SET n += {`id`: "sym:repo2graph/doctor.py::_repo_root_for", `name`: "_repo_root_for", `qualname`: "_repo_root_for", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 476, `end_line`: 491, `signature`: "def _repo_root_for(path: Path, idx_dir: Path | None) -> Path:", `docstring`: "The source tree an index describes, given whatever path was passed in.\n\n    `doctor <repo>` and `doctor <repo>/.r2g` are both documented, so the\n    source root is either `path` itself or the index directory's parent."};
