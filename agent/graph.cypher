MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cpp_parse.py::test_iss239_a_failed_probe_is_retried_rather_than_cached"}) SET n += {`id`: "sym:tests/test_cpp_parse.py::test_iss239_a_failed_probe_is_retried_rather_than_cached", `name`: "test_iss239_a_failed_probe_is_retried_rather_than_cached", `qualname`: "test_iss239_a_failed_probe_is_retried_rather_than_cached", `kind`: "function", `path`: "tests/test_cpp_parse.py", `lang`: "python", `start_line`: 253, `end_line`: 278, `signature`: "def test_iss239_a_failed_probe_is_retried_rather_than_cached(mock_run):", `docstring`: "#239: only a *successful* probe is memoized, exactly as\n    fetch._git_version does it. A transient fd-exhaustion or fork failure must\n    not disable the cpp fallback for the rest of the process's life -- which is\n    precisely what functools.lru_cache would do here.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cpp_parse.py::test_iss239_a_failed_probe_is_retried_rather_than_cached.mock_run_impl"}) SET n += {`id`: "sym:tests/test_cpp_parse.py::test_iss239_a_failed_probe_is_retried_rather_than_cached.mock_run_impl", `name`: "mock_run_impl", `qualname`: "test_iss239_a_failed_probe_is_retried_rather_than_cached.mock_run_impl", `kind`: "function", `path`: "tests/test_cpp_parse.py", `lang`: "python", `start_line`: 260, `end_line`: 266, `signature`: "def mock_run_impl(cmd, **kwargs):", `docstring`: ""};
