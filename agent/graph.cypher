MERGE (n:R2G:`Symbol` {id: "sym:tests/test_auth.py::test_an_expired_ttl_refetches"}) SET n += {`id`: "sym:tests/test_auth.py::test_an_expired_ttl_refetches", `name`: "test_an_expired_ttl_refetches", `qualname`: "test_an_expired_ttl_refetches", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 561, `end_line`: 582, `signature`: "def test_an_expired_ttl_refetches():", `docstring`: "Keys are re-read once the TTL has elapsed.\n\n    The clock is injected rather than slept through. An earlier version used\n    ttl=0.0 and two back-to-back calls, which passes only if the monotonic\n    clock ticks between them -- so it passed on one machine and failed on\n    another, where Windows falls back to GetTickCount64's ~15.6ms granularity\n    and both calls read the same instant.", `entrypoint`: true, `reach`: 33};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_auth.py::test_a_zero_ttl_never_caches"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_zero_ttl_never_caches", `name`: "test_a_zero_ttl_never_caches", `qualname`: "test_a_zero_ttl_never_caches", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 585, `end_line`: 597, `signature`: "def test_a_zero_ttl_never_caches():", `docstring`: "`ttl=0` means \"do not cache\", whatever the clock's resolution.\n\n    With a strict `>` comparison this promise silently depended on the clock\n    ticking between calls, which is exactly the flake above in its other form:\n    a configuration that says \"never cache\" would keep serving stale keys.", `entrypoint`: true, `reach`: 32};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_auth.py::test_an_unknown_kid_refetches_exactly_once_then_fails"}) SET n += {`id`: "sym:tests/test_auth.py::test_an_unknown_kid_refetches_exactly_once_then_fails", `name`: "test_an_unknown_kid_refetches_exactly_once_then_fails", `qualname`: "test_an_unknown_kid_refetches_exactly_once_then_fails", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 600, `end_line`: 608, `signature`: "def test_an_unknown_kid_refetches_exactly_once_then_fails():", `docstring`: "Key rotation costs one refetch; a kid flood must not cost one each.", `entrypoint`: true, `reach`: 33};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_auth.py::test_the_same_unknown_kid_does_not_refetch_on_repeat_lookups"}) SET n += {`id`: "sym:tests/test_auth.py::test_the_same_unknown_kid_does_not_refetch_on_repeat_lookups", `name`: "test_the_same_unknown_kid_does_not_refetch_on_repeat_lookups", `qualname`: "test_the_same_unknown_kid_does_not_refetch_on_repeat_lookups", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 611, `end_line`: 625, `signature`: "def test_the_same_unknown_kid_does_not_refetch_on_repeat_lookups():", `docstring`: "ISS-195: a negative kid lookup is remembered, so N repeats cost 1 fetch.\n\n    The previous test asked once. Asking again is what distinguishes a\n    per-request refetch (the bug) from a per-kid cap (the control the\n    module docstring claimed).", `entrypoint`: true, `reach`: 33};
