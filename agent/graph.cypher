MERGE (n:R2G:`Symbol` {id: "sym:tests/test_secrets_hardening.py::test_every_allowlisted_key_actually_matches_the_regex"}) SET n += {`id`: "sym:tests/test_secrets_hardening.py::test_every_allowlisted_key_actually_matches_the_regex", `name`: "test_every_allowlisted_key_actually_matches_the_regex", `qualname`: "test_every_allowlisted_key_actually_matches_the_regex", `kind`: "function", `path`: "tests/test_secrets_hardening.py", `lang`: "python", `start_line`: 1102, `end_line`: 1112, `signature`: "def test_every_allowlisted_key_actually_matches_the_regex():", `docstring`: "An entry that does not match SECRET_KEY_RE is dead weight.\n\n    It would silently suggest the name is dangerous when the general rule\n    never flagged it, which is how an allowlist rots into a list of guesses.", `entrypoint`: true};
