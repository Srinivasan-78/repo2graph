MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::AuthError"}) SET n += {`id`: "sym:repo2graph/auth.py::AuthError", `name`: "AuthError", `qualname`: "AuthError", `kind`: "class", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 71, `end_line`: 82, `signature`: "class AuthError(Exception):", `docstring`: "A request that must be refused, carrying the status to refuse it with.\n\n    Args:\n        message: Human-readable reason, safe to log. Never contains the token.\n        status: HTTP status to return; 401 unless the caller says otherwise."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::AuthError.__init__"}) SET n += {`id`: "sym:repo2graph/auth.py::AuthError.__init__", `name`: "__init__", `qualname`: "AuthError.__init__", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 79, `end_line`: 82, `signature`: "def __init__(self, message: str, status: int = 401):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::Identity"}) SET n += {`id`: "sym:repo2graph/auth.py::Identity", `name`: "Identity", `qualname`: "Identity", `kind`: "class", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 86, `end_line`: 99, `signature`: "class Identity:", `docstring`: "Who made a request, as far as the server can tell.\n\n    Attributes:\n        subject: The token's `sub` claim under OIDC, \"anonymous\" with no auth\n            configured, or \"bearer\" for a shared static token, which by\n            construction identifies no one in particular.\n        mode: Which authentication mode admitted this request.\n        claims: The validated JWT claims, empty for the other two modes."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::b64url_decode"}) SET n += {`id`: "sym:repo2graph/auth.py::b64url_decode", `name`: "b64url_decode", `qualname`: "b64url_decode", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 102, `end_line`: 120, `signature`: "def b64url_decode(text: str) -> bytes:", `docstring`: "Decode base64url without padding, as every JWT field is encoded.\n\n    Args:\n        text: The base64url segment.\n\n    Returns:\n        The decoded bytes.\n\n    Raises:\n        AuthError: If the segment is not valid base64url."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::_int_from_b64url"}) SET n += {`id`: "sym:repo2graph/auth.py::_int_from_b64url", `name`: "_int_from_b64url", `qualname`: "_int_from_b64url", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 123, `end_line`: 124, `signature`: "def _int_from_b64url(text: str) -> int:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::rsa_verify"}) SET n += {`id`: "sym:repo2graph/auth.py::rsa_verify", `name`: "rsa_verify", `qualname`: "rsa_verify", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 127, `end_line`: 170, `signature`: "def rsa_verify(n: int, e: int, signature: bytes, message: bytes, hash_name: str) -> bool:", `docstring`: "Verify an RSA PKCS#1 v1.5 signature using only stdlib arithmetic.\n\n    Rebuilds the complete EMSA-PKCS1-v1_5 encoded block that a correct signer\n    would have produced and compares it to what `sig**e mod n` yields. Comparing\n    the whole block rather than parsing it out is what makes this immune to the\n    Bleichenbacher '06 forgery class, where a verifier that *scans* for the\n    digest accepts garbage in the padding it skipped over.\n\n    Args:\n        n: RSA modulus.\n        e: RSA public exponent.\n        signature: The raw signature bytes.\n        message: The signed bytes (`header.paylo"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::JWKSCache"}) SET n += {`id`: "sym:repo2graph/auth.py::JWKSCache", `name`: "JWKSCache", `qualname`: "JWKSCache", `kind`: "class", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 173, `end_line`: 264, `signature`: "class JWKSCache:", `docstring`: "Fetches and caches an issuer's signing keys, with a bounded refetch.\n\n    Args:\n        issuer: The OIDC issuer URL.\n        ttl: Seconds a fetched key set is trusted before it is re-read.\n        opener: Callable taking a URL and returning decoded JSON. Injected so\n            tests never touch the network; defaults to a urllib fetch.\n        clock: Monotonic time source, injected so a test can age the cache\n            without sleeping. `ResultCache` takes one for the same reason: a\n            test that waits for real time to pass is a test that fails on\n            somebody else's machine."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::JWKSCache.__init__"}) SET n += {`id`: "sym:repo2graph/auth.py::JWKSCache.__init__", `name`: "__init__", `qualname`: "JWKSCache.__init__", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 187, `end_line`: 201, `signature`: "def __init__(\n        self,\n        issuer: str,\n        ttl: float = DEFAULT_JWKS_TTL,\n        opener: Callable[[str], Any] | None = None,\n        clock: Callable[[], float] = time.monotonic,\n    ) -> None:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::JWKSCache.discovery_url"}) SET n += {`id`: "sym:repo2graph/auth.py::JWKSCache.discovery_url", `name`: "discovery_url", `qualname`: "JWKSCache.discovery_url", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 203, `end_line`: 205, `signature`: "def discovery_url(self) -> str:", `docstring`: "The OIDC discovery document URL for this issuer."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::JWKSCache._resolve_jwks_uri"}) SET n += {`id`: "sym:repo2graph/auth.py::JWKSCache._resolve_jwks_uri", `name`: "_resolve_jwks_uri", `qualname`: "JWKSCache._resolve_jwks_uri", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 207, `end_line`: 222, `signature`: "def _resolve_jwks_uri(self) -> str:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::JWKSCache._refresh"}) SET n += {`id`: "sym:repo2graph/auth.py::JWKSCache._refresh", `name`: "_refresh", `qualname`: "JWKSCache._refresh", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 224, `end_line`: 230, `signature`: "def _refresh(self) -> None:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::JWKSCache.key_for"}) SET n += {`id`: "sym:repo2graph/auth.py::JWKSCache.key_for", `name`: "key_for", `qualname`: "JWKSCache.key_for", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 232, `end_line`: 264, `signature`: "def key_for(self, kid: str) -> dict[str, Any]:", `docstring`: "Return the JWK with this `kid`, refetching at most once on a miss.\n\n        Args:\n            kid: The key id from the token header.\n\n        Returns:\n            The matching JWK as a dict.\n\n        Raises:\n            AuthError: If the key is unknown even after one refetch."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::_fetch_json"}) SET n += {`id`: "sym:repo2graph/auth.py::_fetch_json", `name`: "_fetch_json", `qualname`: "_fetch_json", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 267, `end_line`: 295, `signature`: "def _fetch_json(url: str) -> Any:", `docstring`: "GET `url` and parse the JSON body. The only network call in this package.\n\n    Args:\n        url: An https URL to fetch.\n\n    Returns:\n        The parsed JSON body.\n\n    Raises:\n        AuthError: On a non-https URL, a transport failure, or a bad body."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::decode_jwt"}) SET n += {`id`: "sym:repo2graph/auth.py::decode_jwt", `name`: "decode_jwt", `qualname`: "decode_jwt", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 298, `end_line`: 354, `signature`: "def decode_jwt(token: str, jwks: JWKSCache, issuer: str, audience: str | None) -> dict[str, Any]:", `docstring`: "Validate a JWT's signature and claims, returning them.\n\n    Args:\n        token: The compact-serialised JWT.\n        jwks: Key source for the issuer.\n        issuer: The expected `iss` value.\n        audience: The expected `aud` value, or None to skip the check.\n\n    Returns:\n        The validated claims.\n\n    Raises:\n        AuthError: On any structural, signature or claim failure."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::_check_claims"}) SET n += {`id`: "sym:repo2graph/auth.py::_check_claims", `name`: "_check_claims", `qualname`: "_check_claims", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 357, `end_line`: 386, `signature`: "def _check_claims(claims: dict[str, Any], issuer: str, audience: str | None) -> None:", `docstring`: "Enforce iss, aud, exp and nbf. A valid signature is not a valid token."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::AuthConfig"}) SET n += {`id`: "sym:repo2graph/auth.py::AuthConfig", `name`: "AuthConfig", `qualname`: "AuthConfig", `kind`: "class", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 390, `end_line`: 420, `signature`: "class AuthConfig:", `docstring`: "How the server authenticates requests.\n\n    Attributes:\n        token: A shared bearer token, or None.\n        oidc_issuer: An OIDC issuer URL, or None.\n        audience: Expected `aud` for OIDC tokens, or None to skip the check.\n        jwks_ttl: Seconds a fetched JWKS is trusted.\n        cimd: Whether to publish a Client ID Metadata Document."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::AuthConfig.modes"}) SET n += {`id`: "sym:repo2graph/auth.py::AuthConfig.modes", `name`: "modes", `qualname`: "AuthConfig.modes", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 408, `end_line`: 415, `signature`: "def modes(self) -> list[str]:", `docstring`: "The auth modes in force, for the discovery document.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::AuthConfig.enabled"}) SET n += {`id`: "sym:repo2graph/auth.py::AuthConfig.enabled", `name`: "enabled", `qualname`: "AuthConfig.enabled", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 418, `end_line`: 420, `signature`: "def enabled(self) -> bool:", `docstring`: "True when any credential is required.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::Authenticator"}) SET n += {`id`: "sym:repo2graph/auth.py::Authenticator", `name`: "Authenticator", `qualname`: "Authenticator", `kind`: "class", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 423, `end_line`: 481, `signature`: "class Authenticator:", `docstring`: "Turns an Authorization header into an Identity, or refuses it.\n\n    Args:\n        config: The configured modes.\n        opener: JSON fetcher for OIDC discovery, injected for tests.\n        clock: Monotonic time source for the JWKS cache, injected for tests."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::Authenticator.__init__"}) SET n += {`id`: "sym:repo2graph/auth.py::Authenticator.__init__", `name`: "__init__", `qualname`: "Authenticator.__init__", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 432, `end_line`: 443, `signature`: "def __init__(\n        self,\n        config: AuthConfig,\n        opener: Callable[[str], Any] | None = None,\n        clock: Callable[[], float] = time.monotonic,\n    ) -> None:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::Authenticator.authenticate"}) SET n += {`id`: "sym:repo2graph/auth.py::Authenticator.authenticate", `name`: "authenticate", `qualname`: "Authenticator.authenticate", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 445, `end_line`: 481, `signature`: "def authenticate(self, header: str | None) -> Identity:", `docstring`: "Validate one Authorization header.\n\n        Args:\n            header: The raw header value, or None when absent.\n\n        Returns:\n            The caller's Identity. With no auth configured this is always the\n            anonymous identity and the header is ignored entirely.\n\n        Raises:\n            AuthError: When a credential is required and this one does not pass."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::client_metadata_document"}) SET n += {`id`: "sym:repo2graph/auth.py::client_metadata_document", `name`: "client_metadata_document", `qualname`: "client_metadata_document", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 484, `end_line`: 509, `signature`: "def client_metadata_document(base_url: str, name: str = \"repo2graph\") -> dict[str, Any]:", `docstring`: "A Client ID Metadata Document, as RFC 7591 client metadata.\n\n    CIMD serves this at a URL and uses that URL as the `client_id`, so the\n    document must be reachable at the id it advertises.\n\n    Args:\n        base_url: The externally reachable base URL of this server.\n        name: Human-readable client name.\n\n    Returns:\n        The metadata document."};
