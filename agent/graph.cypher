MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::HTTPTransport.start"}) SET n += {`id`: "sym:repo2graph/http_server.py::HTTPTransport.start", `name`: "start", `qualname`: "HTTPTransport.start", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 646, `end_line`: 668, `signature`: "def start(self) -> int:", `docstring`: "Start serving on a daemon thread.\n\n        Returns:\n            The port actually bound, which differs from the requested one when\n            port 0 asked the OS to choose."};
