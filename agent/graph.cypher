MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::blast_radius_index"}) SET n += {`id`: "sym:tests/test_pr_impact.py::blast_radius_index", `name`: "blast_radius_index", `qualname`: "blast_radius_index", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 628, `end_line`: 667, `signature`: "def blast_radius_index():", `docstring`: "Three symbols, each reached from three separate caller files.\n\n    `shared` is modified, `fresh` lives in a file the diff adds, and\n    `make_thing` is a test helper. Only the first is a blast-radius risk.", `entrypoint`: true, `reach`: 8};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::blast_radius_index._sym"}) SET n += {`id`: "sym:tests/test_pr_impact.py::blast_radius_index._sym", `name`: "_sym", `qualname`: "blast_radius_index._sym", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 636, `end_line`: 648, `signature`: "def _sym(path, name, start, end):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_iss422_blast_radius_rule_ignores_added_and_test_symbols"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_iss422_blast_radius_rule_ignores_added_and_test_symbols", `name`: "test_iss422_blast_radius_rule_ignores_added_and_test_symbols", `qualname`: "test_iss422_blast_radius_rule_ignores_added_and_test_symbols", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 670, `end_line`: 702, `signature`: "def test_iss422_blast_radius_rule_ignores_added_and_test_symbols(blast_radius_index):", `docstring`: "R2G-IMP-003 is about what an edit puts at risk.\n\n    An added symbol has no pre-existing dependents -- its callers arrived in the\n    same change -- so counting them reports how well new code is wired in, not\n    risk. A test helper with many callers is what a suite is supposed to look\n    like. Only `shared`, modified in place with three caller modules, qualifies.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::ambiguous_caller_index"}) SET n += {`id`: "sym:tests/test_pr_impact.py::ambiguous_caller_index", `name`: "ambiguous_caller_index", `qualname`: "ambiguous_caller_index", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 706, `end_line`: 742, `signature`: "def ambiguous_caller_index():", `docstring`: "One modified symbol reached by four callers the resolver could not pin.\n\n    `confidence` on a CALLS edge is P(this is the right target | a call exists\n    here), which the name resolver splits 1/n across the n symbols sharing a\n    name. 0.25 is what four same-named candidates look like -- the shape a\n    common method name (`start`, `run`, `get`) produces across a whole repo.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::ambiguous_caller_index._sym"}) SET n += {`id`: "sym:tests/test_pr_impact.py::ambiguous_caller_index._sym", `name`: "_sym", `qualname`: "ambiguous_caller_index._sym", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 716, `end_line`: 728, `signature`: "def _sym(path, name, start, end):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_ambiguous_call_rule_reports_once_against_the_changed_symbol"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_ambiguous_call_rule_reports_once_against_the_changed_symbol", `name`: "test_ambiguous_call_rule_reports_once_against_the_changed_symbol", `qualname`: "test_ambiguous_call_rule_reports_once_against_the_changed_symbol", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 755, `end_line`: 774, `signature`: "def test_ambiguous_call_rule_reports_once_against_the_changed_symbol(ambiguous_caller_index):", `docstring`: "R2G-IMP-004 is a claim about the symbol, not about each caller.\n\n    A low confidence is the resolver saying it could not tell which same-named\n    symbol a call meant. That is a fact about this analysis, so filing it against\n    the *caller's* line accuses a file that has nothing to do with the diff --\n    and it multiplies: changing `HTTPTransport.start` emitted 64 findings naming\n    `secrets.py::_pem_spans` (which calls `match.start()`), `graph.py` and every\n    other `.start()` call in the repo. Uploaded as SARIF, those became inline\n    review comments on untouched code.\n\n    One finding", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_blast_radius_counts_only_confidently_resolved_callers"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_blast_radius_counts_only_confidently_resolved_callers", `name`: "test_blast_radius_counts_only_confidently_resolved_callers", `qualname`: "test_blast_radius_counts_only_confidently_resolved_callers", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 777, `end_line`: 786, `signature`: "def test_blast_radius_counts_only_confidently_resolved_callers(ambiguous_caller_index):", `docstring`: "R2G-IMP-003's count is its entire claim, so a guess must not inflate it.\n\n    Four caller modules would clear the `>= 3 modules` threshold on raw count.\n    All four are 0.25 name matches, which is what `.start()` on a regex match or\n    a thread looks like to the resolver -- counting them reports that a method\n    has a common name, not that an edit is risky.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_untested_public_api_rule_needs_the_graph_to_know_the_caller"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_untested_public_api_rule_needs_the_graph_to_know_the_caller", `name`: "test_untested_public_api_rule_needs_the_graph_to_know_the_caller", `qualname`: "test_untested_public_api_rule_needs_the_graph_to_know_the_caller", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 789, `end_line`: 814, `signature`: "def test_untested_public_api_rule_needs_the_graph_to_know_the_caller(sample_graph_index):", `docstring`: "\"No test edge\" only means \"untested\" if the graph sees any caller at all.\n\n    `scripts/disconnected.py::helper` is public and has no callers of any kind,\n    which is the shape of a symbol invoked from somewhere this analysis cannot\n    see -- framework dispatch, an entry point, a plugin hook.\n    `MCPRequestHandler.do_POST` and `.do_OPTIONS` are the real case: the stdlib\n    dispatches them, so no in-repo edge points at either, and both were reported\n    as untested public APIs while 64 tests in tests/test_http_transport.py drove\n    them over real HTTP.\n\n    It has to be a *public* symbol t", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::_sample_report"}) SET n += {`id`: "sym:tests/test_pr_impact.py::_sample_report", `name`: "_sample_report", `qualname`: "_sample_report", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 822, `end_line`: 916, `signature`: "def _sample_report() -> ImpactReport:", `docstring`: "One fixed report, shared by the formatter assertions and the golden files.\n\n    Hand-built, never derived from `analyze_diff_impact`, so a traversal change\n    cannot move both the expectation and the subject at once."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_formatters"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_formatters", `name`: "test_formatters", `qualname`: "test_formatters", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 919, `end_line`: 948, `signature`: "def test_formatters():", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_iss422_pr_comment_leads_with_the_upsert_marker"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_iss422_pr_comment_leads_with_the_upsert_marker", `name`: "test_iss422_pr_comment_leads_with_the_upsert_marker", `qualname`: "test_iss422_pr_comment_leads_with_the_upsert_marker", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 951, `end_line`: 961, `signature`: "def test_iss422_pr_comment_leads_with_the_upsert_marker():", `docstring`: "The CI job finds its own previous comment by this marker and edits it.\n\n    Without the marker every push appended one more impact comment -- PR #422\n    collected three before anyone noticed.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_iss422_json_reports_old_path_for_renames"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_iss422_json_reports_old_path_for_renames", `name`: "test_iss422_json_reports_old_path_for_renames", `qualname`: "test_iss422_json_reports_old_path_for_renames", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 964, `end_line`: 974, `signature`: "def test_iss422_json_reports_old_path_for_renames():", `docstring`: "`old_path` is in the FileDiff record and in PR_IMPACT.md's documented\n    schema; it was the one field format_json dropped, so a rename rendered as an\n    unrelated add.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_iss422_formatter_output_matches_the_checked_in_fixtures"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_iss422_formatter_output_matches_the_checked_in_fixtures", `name`: "test_iss422_formatter_output_matches_the_checked_in_fixtures", `qualname`: "test_iss422_formatter_output_matches_the_checked_in_fixtures", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 993, `end_line`: 1006, `signature`: "def test_iss422_formatter_output_matches_the_checked_in_fixtures(name):", `docstring`: "The fixtures under tests/fixtures/impact/ must be what the formatters emit.\n\n    They shipped describing a schema no formatter ever produced -- `analyzed_at`,\n    `summary` and `uncertainty_notes` keys against a formatter that emits\n    `metrics` and `guardrails`, and a Markdown heading no renderer writes. An\n    example output that contradicts the code is worse than none: it is the sort\n    of fabricated artifact the citation rules exist to prevent, and nothing read\n    it, so nothing caught it.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::regenerate_golden_fixtures"}) SET n += {`id`: "sym:tests/test_pr_impact.py::regenerate_golden_fixtures", `name`: "regenerate_golden_fixtures", `qualname`: "regenerate_golden_fixtures", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1009, `end_line`: 1013, `signature`: "def regenerate_golden_fixtures() -> None:", `docstring`: "Rewrite the golden fixtures from the current formatters. Not a test.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_iss422_pr_comment_caps_the_public_api_list"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_iss422_pr_comment_caps_the_public_api_list", `name`: "test_iss422_pr_comment_caps_the_public_api_list", `qualname`: "test_iss422_pr_comment_caps_the_public_api_list", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1016, `end_line`: 1032, `signature`: "def test_iss422_pr_comment_caps_the_public_api_list():", `docstring`: "Every list in the PR comment is bounded: GitHub rejects a body over 65536\n    characters outright, so one unbounded section makes the comment unpostable\n    instead of merely long.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_mcp_tool_repo_impact"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_mcp_tool_repo_impact", `name`: "test_mcp_tool_repo_impact", `qualname`: "test_mcp_tool_repo_impact", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1040, `end_line`: 1062, `signature`: "def test_mcp_tool_repo_impact(sample_graph_index):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_mcp_tool_repo_impact_depth_clamping"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_mcp_tool_repo_impact_depth_clamping", `name`: "test_mcp_tool_repo_impact_depth_clamping", `qualname`: "test_mcp_tool_repo_impact_depth_clamping", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1065, `end_line`: 1078, `signature`: "def test_mcp_tool_repo_impact_depth_clamping(sample_graph_index):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::flood_index"}) SET n += {`id`: "sym:tests/test_pr_impact.py::flood_index", `name`: "flood_index", `qualname`: "flood_index", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1082, `end_line`: 1119, `signature`: "def flood_index():", `docstring`: "An index wide enough that the tool's output ceiling actually binds.\n\n    A bound asserted against a four-symbol fixture proves nothing (AGENTS.md's\n    MCP rule says so explicitly), so this builds 300 files x 4 public symbols,\n    each called from the next file, which is what makes the rendered report --\n    symbols, callers, modules, dependency paths -- exceed the ceiling.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::_flood_diff"}) SET n += {`id`: "sym:tests/test_pr_impact.py::_flood_diff", `name`: "_flood_diff", `qualname`: "_flood_diff", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1122, `end_line`: 1129, `signature`: "def _flood_diff(index) -> str:", `docstring`: "A diff touching every indexed path, with a wide added-line range per file."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_mcp_tool_repo_impact_output_is_bounded"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_mcp_tool_repo_impact_output_is_bounded", `name`: "test_mcp_tool_repo_impact_output_is_bounded", `qualname`: "test_mcp_tool_repo_impact_output_is_bounded", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1146, `end_line`: 1181, `signature`: "def test_mcp_tool_repo_impact_output_is_bounded(flood_index, fmt):", `docstring`: "Clamping the *input* does not bound the *output*.\n\n    `max_depth` was clamped from the start, but the rendered report grows with\n    the number of impacted symbols, and `diff` is accepted up to 1 MB. A diff\n    naming every indexed path rendered ~17.9k tokens as JSON -- 1.5x the ceiling\n    `repo_search` enforces on itself -- straight into an agent's context window.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_mcp_tool_repo_impact_pr_comment_is_self_bounding_and_never_truncated"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_mcp_tool_repo_impact_pr_comment_is_self_bounding_and_never_truncated", `name`: "test_mcp_tool_repo_impact_pr_comment_is_self_bounding_and_never_truncated", `qualname`: "test_mcp_tool_repo_impact_pr_comment_is_self_bounding_and_never_truncated", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1184, `end_line`: 1205, `signature`: "def test_mcp_tool_repo_impact_pr_comment_is_self_bounding_and_never_truncated(flood_index):", `docstring`: "`pr-comment` must come back whole, because it bounds itself.\n\n    It caps every list for GitHub's 65536-char comment limit, so it stays far\n    under the tool ceiling even on a diff touching every indexed path. The\n    contract is therefore the opposite of the test above: not \"gets truncated\"\n    but \"is returned byte-identically, with no truncation notice bolted on\".", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_mcp_tool_repo_impact_truncation_notice_never_breaks_its_own_ceiling"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_mcp_tool_repo_impact_truncation_notice_never_breaks_its_own_ceiling", `name`: "test_mcp_tool_repo_impact_truncation_notice_never_breaks_its_own_ceiling", `qualname`: "test_mcp_tool_repo_impact_truncation_notice_never_breaks_its_own_ceiling", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1208, `end_line`: 1254, `signature`: "def test_mcp_tool_repo_impact_truncation_notice_never_breaks_its_own_ceiling(\n    sample_graph_index, monkeypatch\n):", `docstring`: "The notice is appended, so its own length must be paid for in advance.\n\n    `count_tokens` is a floor division and therefore not additive: `_fit_lines`\n    may return up to `4 * room + 3` characters, so simply subtracting the notice's\n    token count still let the sum land one token over -- 12001 against a 12000\n    bound, while the code claimed that could not happen. Swept across line widths\n    and counts because the overrun depends on `len(text) % 4`.\n\n    Uses the small fixture, not `flood_index`: the renderer is stubbed, so the\n    report's own size is irrelevant to what is under test, an", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_mcp_tool_repo_impact_git_failure_does_not_leak_host_paths"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_mcp_tool_repo_impact_git_failure_does_not_leak_host_paths", `name`: "test_mcp_tool_repo_impact_git_failure_does_not_leak_host_paths", `qualname`: "test_mcp_tool_repo_impact_git_failure_does_not_leak_host_paths", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1257, `end_line`: 1291, `signature`: "def test_mcp_tool_repo_impact_git_failure_does_not_leak_host_paths(sample_graph_index, monkeypatch):", `docstring`: "`git -C <root>` names <root> in its stderr; that must not be relayed.\n\n    Every other served route goes out of its way to keep the absolute index path\n    server-side (`http_server.INDEX_UNAVAILABLE`, `_public_repo_label`). Relaying\n    `get_git_diff`'s exception text handed it back over MCP instead.\n\n    `get_git_diff` is stubbed with the exact RuntimeError shape it really raises\n    (it embeds git's stderr, and `git -C <root>` names <root> in its own \"cannot\n    change to\" message). The behaviour under test is whether `tool_repo_impact`\n    *relays* that text -- stubbing keeps the test off ", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_mcp_tool_repo_impact_git_failure_does_not_leak_host_paths._boom"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_mcp_tool_repo_impact_git_failure_does_not_leak_host_paths._boom", `name`: "_boom", `qualname`: "test_mcp_tool_repo_impact_git_failure_does_not_leak_host_paths._boom", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1273, `end_line`: 1277, `signature`: "def _boom(*_a, **_kw):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_cli_cmd_impact"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_cli_cmd_impact", `name`: "test_cli_cmd_impact", `qualname`: "test_cli_cmd_impact", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1299, `end_line`: 1357, `signature`: "def test_cli_cmd_impact(tmp_path, capsys):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::_impact_args"}) SET n += {`id`: "sym:tests/test_pr_impact.py::_impact_args", `name`: "_impact_args", `qualname`: "_impact_args", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1360, `end_line`: 1377, `signature`: "def _impact_args(tmp_path, diff_path, out_json, **over):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::_tiny_repo"}) SET n += {`id`: "sym:tests/test_pr_impact.py::_tiny_repo", `name`: "_tiny_repo", `qualname`: "_tiny_repo", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1380, `end_line`: 1398, `signature`: "def _tiny_repo(tmp_path):", `docstring`: "A source tree to build an index *from*, plus a diff against it."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_impact_builds_a_missing_index_by_default"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_impact_builds_a_missing_index_by_default", `name`: "test_impact_builds_a_missing_index_by_default", `qualname`: "test_impact_builds_a_missing_index_by_default", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1401, `end_line`: 1423, `signature`: "def test_impact_builds_a_missing_index_by_default(tmp_path):", `docstring`: "`--no-auto-build` only means something if building is the default.\n\n    The flag was declared with `dest=\"auto_build\"` but `args.auto_build` was\n    never read, so `cmd_impact` always went straight to `_require_index` and a\n    first run died with \"no index at .r2g\" \u2014 the documented default behaviour\n    could not happen. Asserted through the report, not just an exit code: a\n    build that produced no graph would still return 0.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_impact_reads_a_diff_from_stdin"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_impact_reads_a_diff_from_stdin", `name`: "test_impact_reads_a_diff_from_stdin", `qualname`: "test_impact_reads_a_diff_from_stdin", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1426, `end_line`: 1448, `signature`: "def test_impact_reads_a_diff_from_stdin(tmp_path, monkeypatch):", `docstring`: "`--diff -` is the piped form PR_IMPACT.md documents.\n\n    It was documented in two places, including a copy-pasteable\n    `git diff main...HEAD | repo2graph impact --diff -`, but `-` went down the\n    file branch and exited with \"diff file - does not exist\". Bytes, not text:\n    a piped diff on a cp1252 Windows stdin must not raise before parsing.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_impact_no_auto_build_still_refuses_a_missing_index"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_impact_no_auto_build_still_refuses_a_missing_index", `name`: "test_impact_no_auto_build_still_refuses_a_missing_index", `qualname`: "test_impact_no_auto_build_still_refuses_a_missing_index", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1451, `end_line`: 1462, `signature`: "def test_impact_no_auto_build_still_refuses_a_missing_index(tmp_path):", `docstring`: "`--no-auto-build` keeps the old contract: name the command that fixes it.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::_workflow_text"}) SET n += {`id`: "sym:tests/test_pr_impact.py::_workflow_text", `name`: "_workflow_text", `qualname`: "_workflow_text", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1475, `end_line`: 1476, `signature`: "def _workflow_text() -> str:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_iss422_workflow_builds_the_index_on_head_not_on_the_base_ref"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_iss422_workflow_builds_the_index_on_head_not_on_the_base_ref", `name`: "test_iss422_workflow_builds_the_index_on_head_not_on_the_base_ref", `qualname`: "test_iss422_workflow_builds_the_index_on_head_not_on_the_base_ref", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1479, `end_line`: 1494, `signature`: "def test_iss422_workflow_builds_the_index_on_head_not_on_the_base_ref():", `docstring`: "The analyzed index must come from the commit the diff's line numbers\n    belong to.\n\n    `parse_unified_diff` records added lines in *new file* coordinates, and\n    `analyze_diff_impact` compares them against `start_line`/`end_line` read out\n    of the index. An index built on the base ref therefore matches head-side line\n    numbers against base-side symbol spans, and cannot contain a file the PR\n    adds at all -- silently, with a green run and plausible-looking numbers.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_iss422_workflow_upserts_one_comment_using_the_module_marker"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_iss422_workflow_upserts_one_comment_using_the_module_marker", `name`: "test_iss422_workflow_upserts_one_comment_using_the_module_marker", `qualname`: "test_iss422_workflow_upserts_one_comment_using_the_module_marker", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1497, `end_line`: 1509, `signature`: "def test_iss422_workflow_upserts_one_comment_using_the_module_marker():", `docstring`: "One comment per PR, edited in place. PR #422 collected three identical\n    impact comments in four minutes because every run called `gh pr comment`.\n\n    The marker is duplicated by necessity -- Python writes it, shell greps for\n    it -- so the two spellings are pinned against each other here.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_iss422_workflow_posts_as_prod_igy"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_iss422_workflow_posts_as_prod_igy", `name`: "test_iss422_workflow_posts_as_prod_igy", `qualname`: "test_iss422_workflow_posts_as_prod_igy", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1512, `end_line`: 1529, `signature`: "def test_iss422_workflow_posts_as_prod_igy():", `docstring`: "The impact comment is prod-igy's, not github-actions[bot]'s, and the\n    minted token is scoped to what the comment step actually does rather than to\n    the App installation's whole grant.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_iss422_app_key_is_never_minted_for_a_fork_pull_request"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_iss422_app_key_is_never_minted_for_a_fork_pull_request", `name`: "test_iss422_app_key_is_never_minted_for_a_fork_pull_request", `qualname`: "test_iss422_app_key_is_never_minted_for_a_fork_pull_request", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1532, `end_line`: 1558, `signature`: "def test_iss422_app_key_is_never_minted_for_a_fork_pull_request():", `docstring`: "This job runs `pip install .` from the PR head, so on a fork PR it has\n    already executed contributor-authored build code by the time it would mint\n    the App key. Both the token step and the comment step are gated on the PR\n    coming from a branch of this repository.\n\n    prod-igy.yml solves the same problem the other way -- a base-only sparse\n    checkout, so PR code never runs at all -- and must keep doing so; this job\n    cannot, because analyzing the PR is the point.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::test_iss422_workflow_interpolates_no_expression_into_a_run_body"}) SET n += {`id`: "sym:tests/test_pr_impact.py::test_iss422_workflow_interpolates_no_expression_into_a_run_body", `name`: "test_iss422_workflow_interpolates_no_expression_into_a_run_body", `qualname`: "test_iss422_workflow_interpolates_no_expression_into_a_run_body", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1561, `end_line`: 1581, `signature`: "def test_iss422_workflow_interpolates_no_expression_into_a_run_body():", `docstring`: "Issue #108's rule: a `${{ }}` inside `run:` is shell injection surface.\n    Every value this job needs arrives through `env:`.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_pr_impact.py::_impact_help"}) SET n += {`id`: "sym:tests/test_pr_impact.py::_impact_help", `name`: "_impact_help", `qualname`: "_impact_help", `kind`: "function", `path`: "tests/test_pr_impact.py", `lang`: "python", `start_line`: 1597, `end_line`: 1611, `signature`: "def _impact_help() -> str:", `docstring`: "`repo2graph impact --help`, straight from the real parser.\n\n    `main()` builds the parser inline, so the help text is the only handle on\n    the argument list that does not duplicate it."};
