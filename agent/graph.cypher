MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::tool_build_status"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_build_status", `name`: "tool_build_status", `qualname`: "tool_build_status", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1870, `end_line`: 1923, `signature`: "def tool_build_status(tasks, task_id: str) -> str:", `docstring`: "Status of one background build, as JSON.\n\n    Args:\n        tasks: The `TaskManager`, or None when builds are synchronous.\n        task_id: The id handed out when the build started.\n\n    Returns:\n        A JSON status document, or a sentence naming why there is none."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::dispatch"}) SET n += {`id`: "sym:repo2graph/mcp.py::dispatch", `name`: "dispatch", `qualname`: "dispatch", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 1926, `end_line`: 2042, `signature`: "def dispatch(index: \"Index | None\", name: str, arguments: dict, cache=None, tasks=None) -> str:", `docstring`: "Route one tool call to its handler. Pure, so serve() holds no logic.\n\n    Args:\n        index: The open index every tool answers from. None is allowed only\n            for `repo_build_status`, which reports on a build and therefore\n            must be answerable while there is still no index to open.\n        name: Tool name the caller asked for.\n        arguments: The caller's arguments, which are JSON a model wrote and are\n            treated as hostile throughout.\n        cache: Optional `ResultCache`. When given, repeated identical calls are\n            served from it instead of re-scoring "};
