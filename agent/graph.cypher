MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::HTTPTransport"}) SET n += {`id`: "sym:repo2graph/http_server.py::HTTPTransport", `name`: "HTTPTransport", `qualname`: "HTTPTransport", `kind`: "class", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 571, `end_line`: 686, `signature`: "class HTTPTransport:", `docstring`: "The HTTP server, on a daemon thread so it never blocks stdio.\n\n    Args:\n        index_dir: Index directory to serve.\n        repo: Repository to auto-build from, or None.\n        host: Bind address; loopback unless deliberately widened.\n        port: Bind port. 0 asks the OS for a free one, which tests use.\n        auth_config: An `AuthConfig`.\n        audit: An `AuditLogger`.\n        cache: A `ResultCache`, or None.\n        publish_cimd: Whether to serve the client metadata document.\n        opener: JSON fetcher for OIDC discovery, injected by tests.\n        allow_hosts: Extra bare hostnames"};
