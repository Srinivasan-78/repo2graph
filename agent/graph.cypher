MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/store.py::SqliteGraphStore.build"}) SET n += {`id`: "sym:repo2graph/store.py::SqliteGraphStore.build", `name`: "build", `qualname`: "SqliteGraphStore.build", `kind`: "function", `path`: "repo2graph/store.py", `lang`: "python", `start_line`: 163, `end_line`: 222, `signature`: "def build(\n        cls,\n        path: Path | str,\n        nodes: Iterable[Record],\n        edges: Iterable[Record],\n        chunks: Iterable[Record] | None = None,\n        build_id: str | None = None,\n    ) -> SqliteGraphStore:", `docstring`: "Write a database from records, recording which build it came from.\n\n        `build_id` is the index's own id out of `manifest.json`. It is stored\n        so `open_graph_store` can tell a current cache from one left over from\n        a previous build without hashing the JSONL it came from."};
