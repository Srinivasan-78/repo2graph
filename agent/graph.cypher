MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_auto_build_never_spawns_a_process_pool"}) SET n += {`id`: "sym:tests/test_mcp.py::test_auto_build_never_spawns_a_process_pool", `name`: "test_auto_build_never_spawns_a_process_pool", `qualname`: "test_auto_build_never_spawns_a_process_pool", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1146, `end_line`: 1168, `signature`: "def test_auto_build_never_spawns_a_process_pool(monkeypatch, tmp_path):", `docstring`: "`build()` reaches for a ProcessPoolExecutor above PARALLEL_MIN_FILES\n    files, and spawning one from inside the running stdio server hangs: the\n    workers inherit the parent's stdin/stdout, which are the client's pipes,\n    and the tool call never returns.\n\n    Asserted on the argument rather than end to end on purpose -- the failure\n    mode is an indefinite hang, and a test that reproduces it would wedge CI\n    rather than fail it. The fixtures elsewhere in this file are all under the\n    threshold, which is exactly why this went unnoticed until a 65-file repo.", `entrypoint`: true};
