MERGE (n:R2G:`Symbol` {id: "sym:tests/test_export_hardening.py::_static_literal_version"}) SET n += {`id`: "sym:tests/test_export_hardening.py::_static_literal_version", `name`: "_static_literal_version", `qualname`: "_static_literal_version", `kind`: "function", `path`: "tests/test_export_hardening.py", `lang`: "python", `start_line`: 37, `end_line`: 50, `signature`: "def _static_literal_version() -> str:", `docstring`: "The one quoted `__version__` literal in repo2graph/__init__.py.\n\n    Read, never hardcoded: that literal is a release surface\n    (scripts/version_surfaces.py rewrites it on every bump), so a copy of it\n    spelled out in a test is red from the moment the bump commit lands --\n    inside publish.yml's `pypi` job, which runs the suite against the already\n    tagged release commit. Spelling it `\"2.2.0\"` failed the 3.0.0 release\n    exactly there, after the tag was cut and the bump PR merged."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_export_hardening.py::test_version_matches_pyproject_in_this_checkout"}) SET n += {`id`: "sym:tests/test_export_hardening.py::test_version_matches_pyproject_in_this_checkout", `name`: "test_version_matches_pyproject_in_this_checkout", `qualname`: "test_version_matches_pyproject_in_this_checkout", `kind`: "function", `path`: "tests/test_export_hardening.py", `lang`: "python", `start_line`: 60, `end_line`: 63, `signature`: "def test_version_matches_pyproject_in_this_checkout():", `docstring`: "Sanity: importing repo2graph from this tree reports pyproject.toml's\n    own version, not whatever happens to be registered as installed.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_export_hardening.py::test_version_resolves_from_source_checkout_over_stale_dist_info"}) SET n += {`id`: "sym:tests/test_export_hardening.py::test_version_resolves_from_source_checkout_over_stale_dist_info", `name`: "test_version_resolves_from_source_checkout_over_stale_dist_info", `qualname`: "test_version_resolves_from_source_checkout_over_stale_dist_info", `kind`: "function", `path`: "tests/test_export_hardening.py", `lang`: "python", `start_line`: 66, `end_line`: 78, `signature`: "def test_version_resolves_from_source_checkout_over_stale_dist_info(monkeypatch):", `docstring`: "The bug: a stale `pip install repo2graph==1.6.0` elsewhere on this\n    interpreter's path must not shadow the real version of a source checkout.\n\n    Detector proof: reverting repo2graph/__init__.py to\n    `importlib.metadata.version(\"repo2graph\")` with no checkout-first check\n    makes this fail (it returns the faked \"1.6.0\" instead of the real\n    version) -- confirmed by hand before landing this test.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_export_hardening.py::test_version_falls_back_to_dist_info_outside_a_checkout"}) SET n += {`id`: "sym:tests/test_export_hardening.py::test_version_falls_back_to_dist_info_outside_a_checkout", `name`: "test_version_falls_back_to_dist_info_outside_a_checkout", `qualname`: "test_version_falls_back_to_dist_info_outside_a_checkout", `kind`: "function", `path`: "tests/test_export_hardening.py", `lang`: "python", `start_line`: 81, `end_line`: 87, `signature`: "def test_version_falls_back_to_dist_info_outside_a_checkout(monkeypatch):", `docstring`: "No local pyproject.toml to read (a real installed package, e.g. a\n    wheel with no source tree alongside it) -- dist-info must still answer,\n    which is the \"keep the installed-package path correct\" half of #340.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_export_hardening.py::test_version_falls_back_to_static_literal_when_nothing_resolves"}) SET n += {`id`: "sym:tests/test_export_hardening.py::test_version_falls_back_to_static_literal_when_nothing_resolves", `name`: "test_version_falls_back_to_static_literal_when_nothing_resolves", `qualname`: "test_version_falls_back_to_static_literal_when_nothing_resolves", `kind`: "function", `path`: "tests/test_export_hardening.py", `lang`: "python", `start_line`: 90, `end_line`: 105, `signature`: "def test_version_falls_back_to_static_literal_when_nothing_resolves(monkeypatch):", `docstring`: "Neither a checkout's pyproject.toml nor dist-info answers (e.g. a\n    frozen/bundled build) -- the static literal at the top of __init__.py is\n    the last resort, never an exception escaping import.", `entrypoint`: true};
