MERGE (n:R2G:`File` {id: "file:repo2graph/security.py"}) SET n += {`id`: "file:repo2graph/security.py", `name`: "security.py", `path`: "repo2graph/security.py", `lang`: "python", `file_type`: "code", `size`: 51671, `lines`: 1182, `parse_errors`: 0, `chunked`: false};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::_k8s_secret_spans"}) SET n += {`id`: "sym:repo2graph/security.py::_k8s_secret_spans", `name`: "_k8s_secret_spans", `qualname`: "_k8s_secret_spans", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 402, `end_line`: 431, `signature`: "def _k8s_secret_spans(text: str) -> list[tuple[int, int]]:", `docstring`: "Value spans of every `data:`/`stringData:` entry in a k8s Secret manifest.\n\n    A multi-document file holding any Secret is treated whole, so a ConfigMap\n    beside it is redacted too; over-redaction is the safe side of that line."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::_ansible_vault_spans"}) SET n += {`id`: "sym:repo2graph/security.py::_ansible_vault_spans", `name`: "_ansible_vault_spans", `qualname`: "_ansible_vault_spans", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 434, `end_line`: 452, `signature`: "def _ansible_vault_spans(text: str) -> list[tuple[int, int]]:", `docstring`: "The vault header plus the hex payload lines under it.\n\n    The ciphertext is what an offline password guess runs against, so it goes\n    with the header rather than staying in clear beneath a redacted first line."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::_pem_spans"}) SET n += {`id`: "sym:repo2graph/security.py::_pem_spans", `name`: "_pem_spans", `qualname`: "_pem_spans", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 455, `end_line`: 480, `signature`: "def _pem_spans(text: str) -> list[tuple[int, int]]:", `docstring`: "Span of every PEM private-key block, in one linear pass.\n\n    Each BEGIN takes the first END that follows it, exactly as the old lazy\n    pattern did, and an unterminated BEGIN yields just its own header -- which\n    is what the old optional group produced. The difference is cost: the ENDs\n    are collected once and consumed by a cursor that only moves forward, so\n    input with no END at all is O(n) instead of O(n*k)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::_json_secret_value_ok"}) SET n += {`id`: "sym:repo2graph/security.py::_json_secret_value_ok", `name`: "_json_secret_value_ok", `qualname`: "_json_secret_value_ok", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 574, `end_line`: 590, `signature`: "def _json_secret_value_ok(value: str) -> bool:", `docstring`: "True if a JSON value under a secret-ish key looks like a real credential.\n\n    Requires a letter *and* a digit, or three of the four character classes\n    (lower, upper, digit, symbol). That keeps `\"password\": \"Passwort\"` (an i18n\n    label) and `\"tokenType\": \"access-token\"` indexable while every generated\n    password or key -- and every human one with a digit in it -- is caught."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::_keyword_windows"}) SET n += {`id`: "sym:repo2graph/security.py::_keyword_windows", `name`: "_keyword_windows", `qualname`: "_keyword_windows", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 602, `end_line`: 623, `signature`: "def _keyword_windows(text: str) -> list[tuple[int, int, int]]:", `docstring`: "(line start, line end, scan end) for each line holding a keyword hint.\n\n    The scan end reaches two non-blank lines further: between a key and its\n    quoted value the rules allow whitespace, newlines included, before the\n    separator and again before the opening quote."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::_keyword_matches"}) SET n += {`id`: "sym:repo2graph/security.py::_keyword_matches", `name`: "_keyword_matches", `qualname`: "_keyword_matches", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 626, `end_line`: 639, `signature`: "def _keyword_matches(\n    pattern: re.Pattern[str], text: str, windows: list[tuple[int, int, int]]\n) -> list[re.Match[str]]:", `docstring`: "`pattern`'s matches that start on a keyword line, in text order."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::_json_secret_spans"}) SET n += {`id`: "sym:repo2graph/security.py::_json_secret_spans", `name`: "_json_secret_spans", `qualname`: "_json_secret_spans", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 642, `end_line`: 663, `signature`: "def _json_secret_spans(\n    text: str, windows: list[tuple[int, int, int]] | None = None\n) -> list[tuple[int, int]]:", `docstring`: "Spans of the *values* of JSON credential pairs in `text`.\n\n    No longer exempts a value just because it contains \"://\": that exemption\n    was meant to leave `tokenUrl`/`authEndpoint`-style properties alone, but\n    `_NON_SECRET_SUFFIX_RE` already does that job by looking at the *key*,\n    which is the correct signal -- a key named `webhookSecret` or `authToken`\n    whose value happens to be a URL (a Slack/Teams/Discord webhook, or a\n    `[REDACTED:basic_auth_url]host/...` connection string) is exactly the kind of\n    secret-as-URL this project is supposed to catch, and the blanket\n    exemption let"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::_escape_char"}) SET n += {`id`: "sym:repo2graph/security.py::_escape_char", `name`: "_escape_char", `qualname`: "_escape_char", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 682, `end_line`: 683, `signature`: "def _escape_char(m: re.Match[str]) -> str:", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::has_unsafe_path_chars"}) SET n += {`id`: "sym:repo2graph/security.py::has_unsafe_path_chars", `name`: "has_unsafe_path_chars", `qualname`: "has_unsafe_path_chars", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 686, `end_line`: 692, `signature`: "def has_unsafe_path_chars(path: str) -> bool:", `docstring`: "True if `path` holds a control, line-separator or hidden character.\n\n    Such a path can forge structure wherever it is printed -- a newline in a\n    filename starts a new `[cite: ...]` header in a pack -- so discovery drops it."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::clean_identifier"}) SET n += {`id`: "sym:repo2graph/security.py::clean_identifier", `name`: "clean_identifier", `qualname`: "clean_identifier", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 695, `end_line`: 699, `signature`: "def clean_identifier(name: str, cap: int = MAX_SYMBOL_NAME_CHARS) -> str:", `docstring`: "`name` with control and hidden characters spelled out as `\\\\uXXXX`, capped."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::count_hidden_unicode"}) SET n += {`id`: "sym:repo2graph/security.py::count_hidden_unicode", `name`: "count_hidden_unicode", `qualname`: "count_hidden_unicode", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 702, `end_line`: 703, `signature`: "def count_hidden_unicode(text: str) -> int:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::escape_hidden_unicode"}) SET n += {`id`: "sym:repo2graph/security.py::escape_hidden_unicode", `name`: "escape_hidden_unicode", `qualname`: "escape_hidden_unicode", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 706, `end_line`: 710, `signature`: "def escape_hidden_unicode(text: str) -> str:", `docstring`: "For text already inside a JSON string literal: `\\\\uXXXX` escapes that\n    decode back to the same character, so the data is unchanged but the raw\n    file no longer carries an invisible override."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::_fingerprint"}) SET n += {`id`: "sym:repo2graph/security.py::_fingerprint", `name`: "_fingerprint", `qualname`: "_fingerprint", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 721, `end_line`: 724, `signature`: "def _fingerprint(value: str) -> str:", `docstring`: "A short, stable, non-reversible tag for a redacted value."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::redact"}) SET n += {`id`: "sym:repo2graph/security.py::redact", `name`: "redact", `qualname`: "redact", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 727, `end_line`: 729, `signature`: "def redact(value: str, why: str) -> str:", `docstring`: "Replace a secret with a structured tag useful for correlation."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::_is_secret_path"}) SET n += {`id`: "sym:repo2graph/security.py::_is_secret_path", `name`: "_is_secret_path", `qualname`: "_is_secret_path", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 741, `end_line`: 854, `signature`: "def _is_secret_path(\n    path: str,\n    extra_keywords: tuple[str, ...] | list[str] | set[str] | None = None,\n    extra_dirs: tuple[str, ...] | list[str] | set[str] | None = None,\n) -> bool:", `docstring`: "Return True if path points to a sensitive file (secrets, keys, credentials)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::scan_content_secrets"}) SET n += {`id`: "sym:repo2graph/security.py::scan_content_secrets", `name`: "scan_content_secrets", `qualname`: "scan_content_secrets", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 857, `end_line`: 960, `signature`: "def scan_content_secrets(text: str) -> list[tuple[str, int, int]]:", `docstring`: "Scan string for known credential patterns.\n\n    The matched bytes are deliberately *not* returned. Every caller either\n    counts the findings or reports their types, so carrying the plaintext would\n    build a list of live credentials that exists only to be discarded -- one\n    `emit(..., findings=findings)` away from being the leak this module exists\n    to prevent. A caller that genuinely needs the bytes already holds `text`\n    and can slice the span itself.\n\n    Returns:\n        List of (secret_type, start_idx, end_idx) spans into `text`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::redact_content"}) SET n += {`id`: "sym:repo2graph/security.py::redact_content", `name`: "redact_content", `qualname`: "redact_content", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 963, `end_line`: 1014, `signature`: "def redact_content(text: str, policy: str = \"redact-match\") -> tuple[str, int]:", `docstring`: "Apply line-preserving redaction to text containing secrets.\n\n    Args:\n        text: Source code or chunk text.\n        policy: 'redact-match', 'warn-only', or 'off'.\n\n    Returns:\n        (redacted_text, count_of_redacted_secrets)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::_classify_secret_shape"}) SET n += {`id`: "sym:repo2graph/security.py::_classify_secret_shape", `name`: "_classify_secret_shape", `qualname`: "_classify_secret_shape", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 1017, `end_line`: 1048, `signature`: "def _classify_secret_shape(value: str) -> str | None:", `docstring`: "Name the credential shape `value` matches, or None.\n\n    Returns a short classification label (e.g. \"aws_access_key\",\n    \"high_entropy\") -- never `value` itself and never any substring of it.\n    The label is deliberately non-sensitive: it says *what kind* of thing the\n    caller's string resembles, not what the string is, so passing it to a log\n    line or an audit record never reproduces the secret it is naming. (This\n    function used to be named with \"secret\" in a way that made static\n    scanners treat its return value as itself sensitive purely by name --\n    CodeQL's py/clear-text-stor"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::sanitize_url"}) SET n += {`id`: "sym:repo2graph/security.py::sanitize_url", `name`: "sanitize_url", `qualname`: "sanitize_url", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 1051, `end_line`: 1077, `signature`: "def sanitize_url(url: str) -> str:", `docstring`: "Redact embedded credentials and sensitive query params from a URL."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/security.py::sanitize_value"}) SET n += {`id`: "sym:repo2graph/security.py::sanitize_value", `name`: "sanitize_value", `qualname`: "sanitize_value", `kind`: "function", `path`: "repo2graph/security.py", `lang`: "python", `start_line`: 1080, `end_line`: 1173, `signature`: "def sanitize_value(\n    key: str,\n    value: Any,\n    *,\n    depth: int = 0,\n    seen: set[int] | None = None,\n) -> Any:", `docstring`: "Redact sensitive values and cap depth/length for structured logs and events.\n\n    Args:\n        key: The key or parameter name.\n        value: Any data structure.\n        depth: Current recursion depth.\n        seen: Object IDs visited, for cycle detection.\n\n    Returns:\n        Sanitized representation guaranteed safe to log."};
