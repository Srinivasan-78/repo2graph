MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_the_guarded_opener_replaces_the_permissive_handler"}) SET n += {`id`: "sym:tests/test_auth.py::test_the_guarded_opener_replaces_the_permissive_handler", `name`: "test_the_guarded_opener_replaces_the_permissive_handler", `qualname`: "test_the_guarded_opener_replaces_the_permissive_handler", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 889, `end_line`: 896, `signature`: "def test_the_guarded_opener_replaces_the_permissive_handler():", `docstring`: "build_opener drops its default only because ours subclasses it.", `entrypoint`: true};
