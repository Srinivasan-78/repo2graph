MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::_cli_choices"}) SET n += {`id`: "sym:tests/test_compat.py::_cli_choices", `name`: "_cli_choices", `qualname`: "_cli_choices", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 375, `end_line`: 400, `signature`: "def _cli_choices(command: str, flag: str, sentinel: str = \"\\x00not-a-value\") -> tuple:", `docstring`: "The argparse `choices` a subcommand declares for `flag`.\n\n    Read off the live parser rather than re-stated here, so this test asks the\n    CLI what it accepts instead of asserting a second copy of the list against\n    the first. The parser is reached by handing it a value nothing can match\n    and keeping the object argparse reports the error on -- `main` builds its\n    parser inline and never returns it."};
