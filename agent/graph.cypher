MERGE (n:R2G:Symbol {id: "sym:tests/test_answer_limits.py::serve"}) SET n += {`id`: "sym:tests/test_answer_limits.py::serve", `name`: "serve", `qualname`: "serve", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 97, `end_line`: 101, `signature`: "def serve(monkeypatch, body: bytes) -> SizedResponse:", `docstring`: "Point the opener at one canned body; return the response for its counters."};
MERGE (n:R2G:Symbol {id: "sym:tests/test_answer_limits.py::ndjson"}) SET n += {`id`: "sym:tests/test_answer_limits.py::ndjson", `name`: "ndjson", `qualname`: "ndjson", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 104, `end_line`: 106, `signature`: "def ndjson(pieces) -> bytes:", `docstring`: "An ollama-shaped newline-delimited stream carrying `pieces` in order."};
