MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_two_builds_of_one_tree_are_byte_identical"}) SET n += {`id`: "sym:tests/test_determinism.py::test_two_builds_of_one_tree_are_byte_identical", `name`: "test_two_builds_of_one_tree_are_byte_identical", `qualname`: "test_two_builds_of_one_tree_are_byte_identical", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 79, `end_line`: 87, `signature`: "def test_two_builds_of_one_tree_are_byte_identical(sample_repo, tmp_path):", `docstring`: "The baseline property: build twice, same bytes.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_serial_and_parallel_builds_agree"}) SET n += {`id`: "sym:tests/test_determinism.py::test_serial_and_parallel_builds_agree", `name`: "test_serial_and_parallel_builds_agree", `qualname`: "test_serial_and_parallel_builds_agree", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 90, `end_line`: 113, `signature`: "def test_serial_and_parallel_builds_agree(sample_repo, tmp_path, monkeypatch):", `docstring`: "`--jobs N` must not reorder anything.\n\n    `parse_all` uses `pool.map`, which preserves input order, and the build\n    loop consumes results in discovery order -- but the fixture is far under\n    PARALLEL_MIN_FILES, so the pool never starts for it. Drop the threshold so\n    the parallel path is the one actually exercised here.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::_reversed_walk"}) SET n += {`id`: "sym:tests/test_determinism.py::_reversed_walk", `name`: "_reversed_walk", `qualname`: "_reversed_walk", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 116, `end_line`: 127, `signature`: "def _reversed_walk(top, *a, **kw):", `docstring`: "os.walk with every directory listing reversed.\n\n    This stands in for \"the same tree on a different filesystem\". A\n    same-machine A/B cannot see an enumeration-order bug at all: NTFS returns\n    entries alphabetically, so the unsorted order and the sorted order happen\n    to coincide, and every assertion passes while the bug is live. ext4 with\n    dir_index returns hash order, which does not coincide.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_filesystem_enumeration_order_does_not_change_the_index"}) SET n += {`id`: "sym:tests/test_determinism.py::test_filesystem_enumeration_order_does_not_change_the_index", `name`: "test_filesystem_enumeration_order_does_not_change_the_index", `qualname`: "test_filesystem_enumeration_order_does_not_change_the_index", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 133, `end_line`: 152, `signature`: "def test_filesystem_enumeration_order_does_not_change_the_index(sample_repo, tmp_path, monkeypatch):", `docstring`: "The bug this suite exists for.\n\n    Discovery order *is* artifact order. `git ls-files` sorts its output but\n    `os.walk` does not, so the same tree indexed on two machines produced\n    three artifacts that differed byte-for-byte while describing an identical\n    graph.", `entrypoint`: true, `reach`: 226};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_git_and_walk_discovery_agree_on_the_same_tree"}) SET n += {`id`: "sym:tests/test_determinism.py::test_git_and_walk_discovery_agree_on_the_same_tree", `name`: "test_git_and_walk_discovery_agree_on_the_same_tree", `qualname`: "test_git_and_walk_discovery_agree_on_the_same_tree", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 155, `end_line`: 184, `signature`: "def test_git_and_walk_discovery_agree_on_the_same_tree(sample_repo, tmp_path):", `docstring`: "A tree with nothing ignored must index identically with and without git.\n\n    Same content, two discovery sources: `git ls-files` when `.git` is\n    present, `os.walk` when it is not. They are only interchangeable if both\n    are sorted, which is the invariant `discover()` now enforces in one place\n    for both branches.", `entrypoint`: true, `reach`: 123};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_incremental_rebuild_equals_a_full_rebuild"}) SET n += {`id`: "sym:tests/test_determinism.py::test_incremental_rebuild_equals_a_full_rebuild", `name`: "test_incremental_rebuild_equals_a_full_rebuild", `qualname`: "test_incremental_rebuild_equals_a_full_rebuild", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 187, `end_line`: 222, `signature`: "def test_incremental_rebuild_equals_a_full_rebuild(sample_repo, tmp_path):", `docstring`: "`--incremental` is a speed optimisation, not a different index.\n\n    A reused `ParsedFile` is exact -- it is a pure function of the file's\n    bytes and language -- and everything downstream (the global name index,\n    CALLS confidences, INHERITS, entrypoints, reach) is recomputed from the\n    full symbol set regardless. So the output must be byte-identical, not\n    merely close, both when nothing changed and after an edit.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_manifest_is_identical_apart_from_the_two_provenance_fields"}) SET n += {`id`: "sym:tests/test_determinism.py::test_manifest_is_identical_apart_from_the_two_provenance_fields", `name`: "test_manifest_is_identical_apart_from_the_two_provenance_fields", `qualname`: "test_manifest_is_identical_apart_from_the_two_provenance_fields", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 225, `end_line`: 244, `signature`: "def test_manifest_is_identical_apart_from_the_two_provenance_fields(sample_repo, tmp_path):", `docstring`: "Everything in manifest.json is reproducible except build_id and created_at.\n\n    Pinned as an explicit allowlist rather than \"ignore whatever differs\", so\n    a third non-deterministic field added later fails here instead of quietly\n    joining the exceptions.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_max_files_truncation_is_deterministic"}) SET n += {`id`: "sym:tests/test_determinism.py::test_max_files_truncation_is_deterministic", `name`: "test_max_files_truncation_is_deterministic", `qualname`: "test_max_files_truncation_is_deterministic", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 247, `end_line`: 278, `signature`: "def test_max_files_truncation_is_deterministic(sample_repo, tmp_path, monkeypatch):", `docstring`: "`--max-files N` takes the first N in discovery order.\n\n    Unsorted discovery made this actively dangerous rather than merely\n    untidy: which files landed in a truncated index depended on the\n    filesystem, so two machines indexed *different subsets* of the same tree\n    and each answered questions the other could not. The reversed walk is\n    what makes this a detector -- under the real one, NTFS order and sorted\n    order coincide and the assertion holds either way.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_max_files_truncation_is_deterministic.truncated"}) SET n += {`id`: "sym:tests/test_determinism.py::test_max_files_truncation_is_deterministic.truncated", `name`: "truncated", `qualname`: "test_max_files_truncation_is_deterministic.truncated", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 258, `end_line`: 267, `signature`: "def truncated(out, walker):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_every_exclusion_glob_matches_its_representative_paths"}) SET n += {`id`: "sym:tests/test_determinism.py::test_every_exclusion_glob_matches_its_representative_paths", `name`: "test_every_exclusion_glob_matches_its_representative_paths", `qualname`: "test_every_exclusion_glob_matches_its_representative_paths", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 286, `end_line`: 301, `signature`: "def test_every_exclusion_glob_matches_its_representative_paths():", `docstring`: "A pattern that matches nothing is worse than no pattern.\n\n    `parse._glob_re` anchors a pattern containing \"/\" at the repository root,\n    so `vendor/**` silently misses `packages/web/vendor/...` -- which is\n    where a monorepo keeps all of it. Each group declares the paths it must\n    cover; this runs them through the real matcher.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_exclusion_groups_do_not_match_ordinary_source"}) SET n += {`id`: "sym:tests/test_determinism.py::test_exclusion_groups_do_not_match_ordinary_source", `name`: "test_exclusion_groups_do_not_match_ordinary_source", `qualname`: "test_exclusion_groups_do_not_match_ordinary_source", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 304, `end_line`: 320, `signature`: "def test_exclusion_groups_do_not_match_ordinary_source():", `docstring`: "The other half: a group that excludes hand-written code is a footgun.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_globs_for_expands_all_and_rejects_an_unknown_group"}) SET n += {`id`: "sym:tests/test_determinism.py::test_globs_for_expands_all_and_rejects_an_unknown_group", `name`: "test_globs_for_expands_all_and_rejects_an_unknown_group", `qualname`: "test_globs_for_expands_all_and_rejects_an_unknown_group", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 323, `end_line`: 336, `signature`: "def test_globs_for_expands_all_and_rejects_an_unknown_group():", `docstring`: "", `entrypoint`: true};
