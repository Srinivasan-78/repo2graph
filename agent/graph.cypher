MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_resolve_vectors"}) SET n += {`id`: "sym:repo2graph/cli.py::_resolve_vectors", `name`: "_resolve_vectors", `qualname`: "_resolve_vectors", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 573, `end_line`: 611, `signature`: "def _resolve_vectors(\n    idx: \"Index\", args: argparse.Namespace, out: Path | None = None\n) -> tuple[dict[int, Any] | None, Any]:", `docstring`: "(vectors, embedder) for a query, honouring --vectors / --no-vectors.\n\n    Dense fusion is **opt-in**. Without `--vectors` the ranking is lexical and\n    no embedder is constructed at all: building one loads sentence-transformers\n    and, on a cold cache, downloads ~90 MB of model weights. An unannounced\n    network fetch has no business on the default `query`/`rag` path, whose only\n    promised dependency is tree-sitter -- and an index is a shippable artifact,\n    so \"the index happens to carry vectors\" is not consent to go fetch a model.\n\n    `--vectors` is a demand: if the index has none, th"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_resolve_reranker"}) SET n += {`id`: "sym:repo2graph/cli.py::_resolve_reranker", `name`: "_resolve_reranker", `qualname`: "_resolve_reranker", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 614, `end_line`: 632, `signature`: "def _resolve_reranker(args: argparse.Namespace) -> Any:", `docstring`: "The cross-encoder for `--rerank`, or None (#381).\n\n    Unlike `--vectors`, a reranker that cannot load is not an error: the\n    first-stage order is still a correct answer, so the query proceeds on it\n    and the reason goes to stderr as one `rag_rerank_disabled` line."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_validate_auto_build_out"}) SET n += {`id`: "sym:repo2graph/cli.py::_validate_auto_build_out", `name`: "_validate_auto_build_out", `qualname`: "_validate_auto_build_out", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 635, `end_line`: 658, `signature`: "def _validate_auto_build_out(out: Path, repo_root: Path) -> None:", `docstring`: "Harden an auto-build output directory, the way `build` hardens its `-o`.\n\n    `build` runs `validate_outdir` before it writes anything. The *implicit*\n    builds -- `rag <src>`'s and the MCP server's -- did\n    not, even though they finish at the same `dump_all`, whose directory swap\n    renames the target aside and then deletes it. `repo2graph rag . -o .`\n    therefore deleted the working tree.\n\n    No `force` parameter: `build --force` exists because a human typed both the\n    path and the override. Nothing is typed here, so there is no override to\n    honour -- the caller should run `build`"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_warn_exclude_secrets_deprecated"}) SET n += {`id`: "sym:repo2graph/cli.py::_warn_exclude_secrets_deprecated", `name`: "_warn_exclude_secrets_deprecated", `qualname`: "_warn_exclude_secrets_deprecated", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 661, `end_line`: 667, `signature`: "def _warn_exclude_secrets_deprecated(args: argparse.Namespace) -> None:", `docstring`: "`--exclude-secrets` is accepted for compatibility; it is the default now."};
