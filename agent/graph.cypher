MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/embed.py::dim_of"}) SET n += {`id`: "sym:repo2graph/embed.py::dim_of", `name`: "dim_of", `qualname`: "dim_of", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 152, `end_line`: 158, `signature`: "def dim_of(embedder: Any, probe: str = \"dimension probe\") -> int:", `docstring`: "The width of an embedder's output, without assuming an attribute."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/embed.py::build_vectors"}) SET n += {`id`: "sym:repo2graph/embed.py::build_vectors", `name`: "build_vectors", `qualname`: "build_vectors", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 164, `end_line`: 195, `signature`: "def build_vectors(\n    chunks: Iterable[dict[str, Any]],\n    embedder: Any,\n    batch: int = DEFAULT_BATCH,\n    reuse: dict[str, list[float]] | None = None,\n) -> dict[str, list[float]]:", `docstring`: "{chunk id: vector} for every chunk, embedding in batches.\n\n    `reuse` is an optional {chunk id: vector} of vectors already known to be\n    current (see cli.cmd_embed); those chunks are never handed to the embedder."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/embed.py::write_vectors"}) SET n += {`id`: "sym:repo2graph/embed.py::write_vectors", `name`: "write_vectors", `qualname`: "write_vectors", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 198, `end_line`: 241, `signature`: "def write_vectors(\n    path: str | Path,\n    vectors: dict[str, list[float]],\n    model_id: str,\n    dim: int,\n    chunk_ids: Iterable[str],\n    text_hashes: Iterable[str] | None = None,\n    build_id: str | None = None,\n) -> int:", `docstring`: "Write vectors.npy plus its sibling vectors.meta.json; return the count.\n\n    Row order is `chunk_ids` order, which is chunks.jsonl order, so re-running\n    `embed` over an unchanged index reproduces the file byte for byte.\n\n    `build_id` is the manifest build_id for the index these vectors were built\n    against; stored so `verify_artifacts` and `doctor` can detect when a rebuild\n    has produced a new manifest build_id but `embed` has not been re-run."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/embed.py::load_vectors"}) SET n += {`id`: "sym:repo2graph/embed.py::load_vectors", `name`: "load_vectors", `qualname`: "load_vectors", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 244, `end_line`: 294, `signature`: "def load_vectors(path: str | Path) -> tuple[dict[str, list[float]], dict[str, Any]]:", `docstring`: "Inverse of write_vectors: ({chunk id: vector}, meta).\n\n    Raises ValueError/OSError on anything malformed; callers that must not fail\n    (query.Index) catch both and fall back to BM25."};
