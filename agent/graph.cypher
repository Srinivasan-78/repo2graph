MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/store.py::_cache_file_name"}) SET n += {`id`: "sym:repo2graph/store.py::_cache_file_name", `name`: "_cache_file_name", `qualname`: "_cache_file_name", `kind`: "function", `path`: "repo2graph/store.py", `lang`: "python", `start_line`: 383, `end_line`: 392, `signature`: "def _cache_file_name(index_dir: Path) -> str:", `docstring`: "The cache file's name when it cannot live beside the index.\n\n    The digest disambiguates two index directories with the same basename; it\n    is not a secret, and the whole name is deliberately reproducible, because\n    the point of a relocated cache is to be found again on the next run."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/store.py::_restrict_to_owner"}) SET n += {`id`: "sym:repo2graph/store.py::_restrict_to_owner", `name`: "_restrict_to_owner", `qualname`: "_restrict_to_owner", `kind`: "function", `path`: "repo2graph/store.py", `lang`: "python", `start_line`: 395, `end_line`: 412, `signature`: "def _restrict_to_owner(path: Path) -> None:", `docstring`: "Narrow `path` to owner-only, best effort.\n\n    The cache holds the graph *and*, since the `chunks` table, source text. In\n    the read-only-container fallback that lands in the shared system temp\n    directory, where the default mode would leave it world-readable.\n\n    Windows has no POSIX mode bits -- the ACL inherited from the parent governs\n    -- so `chmod` there only toggles the read-only flag and is skipped. The\n    guard is on `sys.platform` rather than `os.name` because that is the form\n    mypy narrows on, and `os.getuid` below does not exist in the win32 stubs."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/store.py::_private_cache_dir"}) SET n += {`id`: "sym:repo2graph/store.py::_private_cache_dir", `name`: "_private_cache_dir", `qualname`: "_private_cache_dir", `kind`: "function", `path`: "repo2graph/store.py", `lang`: "python", `start_line`: 415, `end_line`: 466, `signature`: "def _private_cache_dir(base: Path) -> Path:", `docstring`: "A cache directory under `base` that only this user can read or write.\n\n    `base` is the system temp directory, which is world-writable and shared, so\n    a single fixed `repo2graph_cache` name under it is a classic insecure-temp\n    pattern (CWE-377/CWE-668): another local user can pre-create the directory\n    with loose permissions, or plant entries in it, and every cache path here is\n    computable from the index path.\n\n    Two things close that. The directory is per-uid, so two users never contend\n    for the same name and neither can own the other's. And an existing directory\n    is verif"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/store.py::open_graph_store"}) SET n += {`id`: "sym:repo2graph/store.py::open_graph_store", `name`: "open_graph_store", `qualname`: "open_graph_store", `kind`: "function", `path`: "repo2graph/store.py", `lang`: "python", `start_line`: 469, `end_line`: 615, `signature`: "def open_graph_store(index_dir: Path | str, kind: str = \"memory\") -> GraphStore | None:", `docstring`: "The store for an index, or None to let `Index` build the default.\n\n    `memory` returns None rather than a `MemoryGraphStore`, so the default path\n    is byte-for-byte the one `Index` has always taken -- selecting the default\n    explicitly must not route through new code.\n\n    `sqlite` materialises `graph.sqlite` beside the index on first use and\n    reuses it while it matches. \"Matches\" is the index's own `build_id` from\n    `manifest.json`, not an mtime: the same test `Index._load_bm25` applies to\n    `bm25.meta.json`, and for the same reason. An mtime comparison rebuilt the\n    cache on *e"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/store.py::open_graph_store._is_fresh"}) SET n += {`id`: "sym:repo2graph/store.py::open_graph_store._is_fresh", `name`: "_is_fresh", `qualname`: "open_graph_store._is_fresh", `kind`: "function", `path`: "repo2graph/store.py", `lang`: "python", `start_line`: 541, `end_line`: 546, `signature`: "def _is_fresh(s: SqliteGraphStore) -> bool:", `docstring`: ""};
