MERGE (n:R2G:Symbol {id: "sym:tests/test_answer_limits.py::test_iss241_a_body_with_no_newline_cannot_be_read_unbounded"}) SET n += {`id`: "sym:tests/test_answer_limits.py::test_iss241_a_body_with_no_newline_cannot_be_read_unbounded", `name`: "test_iss241_a_body_with_no_newline_cannot_be_read_unbounded", `qualname`: "test_iss241_a_body_with_no_newline_cannot_be_read_unbounded", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 122, `end_line`: 151, `signature`: "def test_iss241_a_body_with_no_newline_cannot_be_read_unbounded(monkeypatch, capsys):", `docstring`: "Axis 1: a response that never sends \"\\\\n\" is still bounded.\n\n    The old line iterator had to reach EOF before yielding anything, so the\n    whole body became one `bytes` object regardless of its size. Here the body\n    is a single valid JSON object a full megabyte past the ceiling -- more than\n    the one-block overshoot the bound allows, so an unbounded read cannot slip\n    under it -- and carries no newline anywhere.", `entrypoint`: true, `reach`: 61};
MERGE (n:R2G:Symbol {id: "sym:tests/test_answer_limits.py::test_iss241_many_small_deltas_are_capped_in_total"}) SET n += {`id`: "sym:tests/test_answer_limits.py::test_iss241_many_small_deltas_are_capped_in_total", `name`: "test_iss241_many_small_deltas_are_capped_in_total", `qualname`: "test_iss241_many_small_deltas_are_capped_in_total", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 157, `end_line`: 177, `signature`: "def test_iss241_many_small_deltas_are_capped_in_total(monkeypatch, capsys):", `docstring`: "Axis 2: a well-framed stream of small deltas stops at the ceiling.\n\n    Every line here is short and valid, so the per-line bound never binds; only\n    the running total can stop this stream. 9000 deltas of 1000 characters is\n    ~9.2 MB on the wire against an 8 MiB ceiling.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_answer_limits.py::test_iss241_the_truncation_note_goes_to_stderr_not_stdout"}) SET n += {`id`: "sym:tests/test_answer_limits.py::test_iss241_the_truncation_note_goes_to_stderr_not_stdout", `name`: "test_iss241_the_truncation_note_goes_to_stderr_not_stdout", `qualname`: "test_iss241_the_truncation_note_goes_to_stderr_not_stdout", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 183, `end_line`: 194, `signature`: "def test_iss241_the_truncation_note_goes_to_stderr_not_stdout(monkeypatch, capsys):", `docstring`: "stdout stays the answer and stays pipeable; the warning is on stderr.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_answer_limits.py::test_iss241_a_short_answer_is_never_reported_truncated"}) SET n += {`id`: "sym:tests/test_answer_limits.py::test_iss241_a_short_answer_is_never_reported_truncated", `name`: "test_iss241_a_short_answer_is_never_reported_truncated", `qualname`: "test_iss241_a_short_answer_is_never_reported_truncated", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 200, `end_line`: 209, `signature`: "def test_iss241_a_short_answer_is_never_reported_truncated(monkeypatch, capsys):", `docstring`: "An ordinary answer must not grow a warning it did not earn.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_answer_limits.py::test_iss241_a_body_ending_exactly_on_the_ceiling_is_not_truncated"}) SET n += {`id`: "sym:tests/test_answer_limits.py::test_iss241_a_body_ending_exactly_on_the_ceiling_is_not_truncated", `name`: "test_iss241_a_body_ending_exactly_on_the_ceiling_is_not_truncated", `qualname`: "test_iss241_a_body_ending_exactly_on_the_ceiling_is_not_truncated", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 212, `end_line`: 227, `signature`: "def test_iss241_a_body_ending_exactly_on_the_ceiling_is_not_truncated(monkeypatch, capsys):", `docstring`: "The bound is `>`, not `>=`: nothing was dropped, so say nothing.\n\n    The ceiling is lowered for this one case because the point is the exact\n    boundary byte, which is unreachable by padding an 8 MiB body to the byte.", `entrypoint`: true, `reach`: 62};
MERGE (n:R2G:Symbol {id: "sym:tests/test_answer_limits.py::test_iss241_every_provider_framing_survives_the_reframer"}) SET n += {`id`: "sym:tests/test_answer_limits.py::test_iss241_every_provider_framing_survives_the_reframer", `name`: "test_iss241_every_provider_framing_survives_the_reframer", `qualname`: "test_iss241_every_provider_framing_survives_the_reframer", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 265, `end_line`: 271, `signature`: "def test_iss241_every_provider_framing_survives_the_reframer(\n    monkeypatch, env, value, body, expected\n):", `docstring`: "Re-framing the byte stream must not drop line semantics for any provider.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_answer_limits.py::test_iss241_a_line_spanning_several_read_blocks_is_reassembled"}) SET n += {`id`: "sym:tests/test_answer_limits.py::test_iss241_a_line_spanning_several_read_blocks_is_reassembled", `name`: "test_iss241_a_line_spanning_several_read_blocks_is_reassembled", `qualname`: "test_iss241_a_line_spanning_several_read_blocks_is_reassembled", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 274, `end_line`: 287, `signature`: "def test_iss241_a_line_spanning_several_read_blocks_is_reassembled(monkeypatch):", `docstring`: "A delta larger than one read() must arrive whole, not in pieces.\n\n    Reading in blocks only works if the framer rejoins a line split across a\n    block boundary; dropping that would corrupt every long delta into unparsable\n    JSON and silently shorten the answer.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_answer_limits.py::test_iss241_crlf_framing_survives"}) SET n += {`id`: "sym:tests/test_answer_limits.py::test_iss241_crlf_framing_survives", `name`: "test_iss241_crlf_framing_survives", `qualname`: "test_iss241_crlf_framing_survives", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 290, `end_line`: 299, `signature`: "def test_iss241_crlf_framing_survives(monkeypatch):", `docstring`: "Some proxies rewrite the SSE terminator; the framer splits on \"\\\\n\" only.", `entrypoint`: true};
