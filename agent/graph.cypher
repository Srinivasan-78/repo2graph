MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_cy_key"}) SET n += {`id`: "sym:repo2graph/export.py::_cy_key", `name`: "_cy_key", `qualname`: "_cy_key", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 493, `end_line`: 498, `signature`: "def _cy_key(k: str) -> str:\n    # Always backtick-quote: covers Cypher reserved words (order, match, where,\n    # distinct, ...) and any other non-bare-identifier-safe key. Doubling an\n    # embedded backtick is Cypher's own escape for it inside a quoted\n    # identifier, so a key containing one can", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::_cy_label"}) SET n += {`id`: "sym:repo2graph/export.py::_cy_label", `name`: "_cy_label", `qualname`: "_cy_label", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 501, `end_line`: 506, `signature`: "def _cy_label(value: str) -> str:", `docstring`: "Backtick-quote a label/reltype. Types are internal constants; anything\n    else reaching here is a bug, not a value to escape our way out of."};
