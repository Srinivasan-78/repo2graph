MERGE (n:R2G:`Symbol` {id: "sym:tests/test_integrity.py::TestVerifyArtifacts.test_manifest_cannot_name_a_path_outside_the_index"}) SET n += {`id`: "sym:tests/test_integrity.py::TestVerifyArtifacts.test_manifest_cannot_name_a_path_outside_the_index", `name`: "test_manifest_cannot_name_a_path_outside_the_index", `qualname`: "TestVerifyArtifacts.test_manifest_cannot_name_a_path_outside_the_index", `kind`: "function", `path`: "tests/test_integrity.py", `lang`: "python", `start_line`: 544, `end_line`: 573, `signature`: "def test_manifest_cannot_name_a_path_outside_the_index(self, tmp_path, shape):", `docstring`: "An absolute or escaping key must be refused before anything is read.\n\n        `out / rel_path` discards `out` when rel_path is absolute, so the loop\n        used to hash any file the process could reach and put the real digest\n        in `errors` -- a hash-disclosure oracle -- while a missing file\n        reported differently from a mismatching one, probing for existence.", `entrypoint`: true};
