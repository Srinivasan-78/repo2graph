MERGE (n:R2G:`Symbol` {id: "sym:scripts/llm_agent_eval.py::ScriptedProvider"}) SET n += {`id`: "sym:scripts/llm_agent_eval.py::ScriptedProvider", `name`: "ScriptedProvider", `qualname`: "ScriptedProvider", `kind`: "class", `path`: "scripts/llm_agent_eval.py", `lang`: "python", `start_line`: 268, `end_line`: 320, `signature`: "class ScriptedProvider(Provider):", `docstring`: "`--dry-run`: one `repo_search`, then an answer. No network.\n\n    Exists so the loop, the dispatch wiring and the scoring can be tested and\n    changed without an API key or a cent of spend -- and so a broken refactor\n    here fails in the test suite rather than in someone's billing."};
