MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_discovery_sort_key_is_posix"}) SET n += {`id`: "sym:tests/test_determinism.py::test_discovery_sort_key_is_posix", `name`: "test_discovery_sort_key_is_posix", `qualname`: "test_discovery_sort_key_is_posix", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 445, `end_line`: 458, `signature`: "def test_discovery_sort_key_is_posix(tmp_path):", `docstring`: "Sorting on str(Path) would sort on \"\\\\\" on Windows and \"/\" elsewhere --\n    the same cross-machine divergence one level down from the os.walk bug.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_explain_path_knows_discover_never_indexes_an_index"}) SET n += {`id`: "sym:tests/test_determinism.py::test_explain_path_knows_discover_never_indexes_an_index", `name`: "test_explain_path_knows_discover_never_indexes_an_index", `qualname`: "test_explain_path_knows_discover_never_indexes_an_index", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 461, `end_line`: 497, `signature`: "def test_explain_path_knows_discover_never_indexes_an_index(tmp_path, capsys, monkeypatch):", `docstring`: "`explain-path .r2g/agent/nodes.jsonl` said INCLUDED; no build indexes it.\n\n    discover() skips the -o directory and any directory holding a repo2graph\n    agent/manifest.json before any other rule; explain-path must say so.", `entrypoint`: true, `reach`: 297};
