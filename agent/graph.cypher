MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.score"}) SET n += {`id`: "sym:repo2graph/query.py::Index.score", `name`: "score", `qualname`: "Index.score", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 975, `end_line`: 1016, `signature`: "def score(self, query: str) -> list[tuple[float, int]]:", `docstring`: "Rank indexed chunks against query using BM25 with identifier boosting.\n\n        Args:\n            query: Search terms or question string.\n\n        Returns:\n            Sorted list of (bm25_score, chunk_index) tuples."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index._demote_test_seeds"}) SET n += {`id`: "sym:repo2graph/query.py::Index._demote_test_seeds", `name`: "_demote_test_seeds", `qualname`: "Index._demote_test_seeds", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1018, `end_line`: 1035, `signature`: "def _demote_test_seeds(self, ranked: list[tuple[float, int]]) -> list[tuple[float, int]]:", `docstring`: "Re-rank a seed window so test files lose near-ties to real source.\n\n        Applied only when the question was not *about* tests, and only inside\n        `pack_context`: `retrieve()` must keep returning what `repo2graph query`\n        has always returned, so the penalty never reaches it.\n\n        A stable sort on the scaled score, so two chunks the penalty does not\n        separate keep the order BM25 gave them."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.is_container_chunk"}) SET n += {`id`: "sym:repo2graph/query.py::Index.is_container_chunk", `name`: "is_container_chunk", `qualname`: "Index.is_container_chunk", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1038, `end_line`: 1054, `signature`: "def is_container_chunk(chunk: Mapping[str, Any]) -> bool:", `docstring`: "Is this a chunk that structurally cannot hold a nested definition?\n\n        Two kinds qualify, and both for the same reason -- the chunker emits\n        their members as separate chunks and cuts them out of the parent, so\n        what is left is a header, a docstring and metadata:\n\n        * a `class` chunk, whose methods are their own chunks;\n        * a `file:` residual, which is whatever a file has left once its\n          symbols have been extracted.\n\n        They are genuine navigation aids and they are the right answer to\n        \"where is class X defined\". They are the wrong place to spe"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.query_content_terms"}) SET n += {`id`: "sym:repo2graph/query.py::Index.query_content_terms", `name`: "query_content_terms", `qualname`: "Index.query_content_terms", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1057, `end_line`: 1059, `signature`: "def query_content_terms(query: str) -> frozenset[str]:", `docstring`: "The question's content words, for `_answerability`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index._answerability"}) SET n += {`id`: "sym:repo2graph/query.py::Index._answerability", `name`: "_answerability", `qualname`: "Index._answerability", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1061, `end_line`: 1133, `signature`: "def _answerability(\n        self,\n        query_terms: frozenset[str],\n        chunk: Mapping[str, Any],\n        *,\n        boost_tests: bool = False,\n    ) -> float:", `docstring`: "Multiplier on a chunk's fused score, from how answer-shaped it is.\n\n        Deliberately a re-rank over `score_rrf`'s output rather than a change to\n        BM25 itself: RRF maps scores onto `1/(60 + rank)`, which is nearly flat\n        across the top of the list, so a modest multiplier here reorders\n        candidates that BM25 could not separate -- without touching the lexical\n        scoring that `repo2graph query` and every golden test depend on.\n\n        `boost_tests` defaults to False -- the safe case, since a question is\n        usually not about tests -- so a caller has to ask for the "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index._boost_identifiers"}) SET n += {`id`: "sym:repo2graph/query.py::Index._boost_identifiers", `name`: "_boost_identifiers", `qualname`: "Index._boost_identifiers", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1135, `end_line`: 1152, `signature`: "def _boost_identifiers(self, query: str, acc: dict[int, float]) -> None:", `docstring`: "Apply multiplier to BM25 scores for chunks matching query identifier names."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index._lexical_for_weakness"}) SET n += {`id`: "sym:repo2graph/query.py::Index._lexical_for_weakness", `name`: "_lexical_for_weakness", `qualname`: "Index._lexical_for_weakness", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1154, `end_line`: 1176, `signature`: "def _lexical_for_weakness(\n        self,\n        query: str,\n        ranked: list[tuple[float, int]],\n        vectors: Mapping[Any, Vector] | None,\n        embedder: \"Embedder | None\",\n    ) -> list[tuple[float, int]]:", `docstring`: "The BM25 ranking `is_lexical_weak` has to see, given a possibly fused one.\n\n        `is_lexical_weak`'s floors are absolute BM25 magnitudes\n        (`min_top_score=18.0`). Reciprocal-rank fusion scores are `w/(60+rank)`\n        -- about 0.016 at rank 1 -- so handing it `score_rrf` output whenever\n        vectors or an embedder were supplied put `top_score` below every floor\n        and made the answer unconditionally \"weak\". `conditional_expansion`\n        therefore suppressed nothing at all on the hybrid path, silently, while\n        working as documented on the lexical one.\n\n        `score_r"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.score_rrf"}) SET n += {`id`: "sym:repo2graph/query.py::Index.score_rrf", `name`: "score_rrf", `qualname`: "Index.score_rrf", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1178, `end_line`: 1235, `signature`: "def score_rrf(\n        self,\n        query: str,\n        vectors: Mapping[Any, Vector] | None = None,\n        embedder: \"Embedder | None\" = None,\n        weights: tuple[float, float] = (1.0, 1.0),\n    ) -> list[tuple[float, int]]:", `docstring`: "Score chunks combining lexical BM25 and dense vector rankings via RRF.\n\n        Args:\n            query: Query string.\n            vectors: Optional mapping of chunk indices to precomputed vectors.\n            embedder: Optional active embedder instance.\n            weights: Optional tuple of (w_bm25, w_vec) multipliers for reciprocal ranks.\n\n        Returns:\n            Sorted list of (rrf_score, chunk_index) tuples."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.rerank"}) SET n += {`id`: "sym:repo2graph/query.py::Index.rerank", `name`: "rerank", `qualname`: "Index.rerank", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1237, `end_line`: 1245, `signature`: "def rerank(\n        self, query: str, ranked: list[tuple[float, int]], reranker: \"Reranker\"\n    ) -> list[tuple[float, int]]:", `docstring`: "`ranked` with its top candidates re-ordered by `reranker` (#381).\n\n        A reranker that fails leaves the order as it was and says so, once, as\n        a `rag_rerank_disabled` event -- never silently."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index._apply_rerank"}) SET n += {`id`: "sym:repo2graph/query.py::Index._apply_rerank", `name`: "_apply_rerank", `qualname`: "Index._apply_rerank", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1247, `end_line`: 1260, `signature`: "def _apply_rerank(\n        self, query: str, ranked: list[tuple[float, int]], reranker: \"Reranker\"\n    ) -> tuple[list[tuple[float, int]], bool]:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index._vectors_for"}) SET n += {`id`: "sym:repo2graph/query.py::Index._vectors_for", `name`: "_vectors_for", `qualname`: "Index._vectors_for", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1262, `end_line`: 1332, `signature`: "def _vectors_for(\n        self,\n        query: str,\n        candidates: list[int],\n        vectors: Mapping[Any, Vector] | None,\n        embedder: \"Embedder | None\",\n    ) -> tuple[Vector | None, list[Vector], str]:", `docstring`: "Query vector plus one vector per candidate, or a reason there is none.\n\n        Args:\n            query: The raw query string.\n            candidates: Chunk list-indices BM25 shortlisted, in rank order.\n            vectors: Index-keyed vector mapping, or None to embed on the fly.\n            embedder: An object with `.encode(list[str])`, or None.\n\n        Returns:\n            `(query_vector, candidate_vectors, reason)`. On success `reason` is\n            the empty string; on failure the first two are `None`/`[]` and\n            `reason` names *why*, so the caller can report a fusion that\n     "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.expand"}) SET n += {`id`: "sym:repo2graph/query.py::Index.expand", `name`: "expand", `qualname`: "Index.expand", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1334, `end_line`: 1395, `signature`: "def expand(\n        self,\n        seed_nodes: Iterable[str],\n        hops: int = 1,\n        edge_types: Iterable[str] | None = None,\n        per_hop: int = 6,\n        min_confidence: float = 1.0,\n        edge_dirs: Mapping[str, tuple[str, ...]] | None = None,\n        max_results: int | None = None,\n", `docstring`: "Traverse graph outward from seed nodes.\n\n        Args:\n            seed_nodes: Starting node IDs.\n            hops: Traversal depth in hops.\n            edge_types: Allowed edge type names.\n            per_hop: Max neighbors admitted per hop.\n            min_confidence: Minimum confidence threshold for CALLS and TESTS edges.\n            edge_dirs: Direction filter mapping per edge type.\n            max_results: Stop once this many neighbours are found (None: no cap).\n\n        Returns:\n            List of (dst_node_id, edge_type, direction, src_node_id) tuples."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.retrieve"}) SET n += {`id`: "sym:repo2graph/query.py::Index.retrieve", `name`: "retrieve", `qualname`: "Index.retrieve", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1397, `end_line`: 1513, `signature`: "def retrieve(\n        self,\n        query: str,\n        k: int = 8,\n        hops: int = 1,\n        budget_chars: int = RETRIEVE_BUDGET_CHARS,\n        *,\n        min_confidence: float | None = None,\n        vectors: Mapping[Any, Vector] | None = None,\n        embedder: \"Embedder | None\" = None,\n     ", `docstring`: "Retrieve ranked seed chunks and graph neighbors within character budget.\n\n        Args:\n            query: Search terms or question string.\n            k: Number of initial seed chunks.\n            hops: Traversal depth around seeds.\n            budget_chars: Maximum character budget across returned chunk bodies.\n            min_confidence: Minimum confidence threshold for CALLS traversal.\n            vectors: Optional precomputed vector mapping.\n            embedder: Optional Embedder for hybrid search.\n            exclude_secrets: Whether to filter secret-matching paths.\n            extra_se"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.retrieve._secret"}) SET n += {`id`: "sym:repo2graph/query.py::Index.retrieve._secret", `name`: "_secret", `qualname`: "Index.retrieve._secret", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1439, `end_line`: 1445, `signature`: "def _secret(c: Record, nid: str) -> bool:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.map_prepend"}) SET n += {`id`: "sym:repo2graph/query.py::Index.map_prepend", `name`: "map_prepend", `qualname`: "Index.map_prepend", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1517, `end_line`: 1535, `signature`: "def map_prepend(self) -> str:", `docstring`: "Render repository overview and top entry points as markdown."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.pack_context"}) SET n += {`id`: "sym:repo2graph/query.py::Index.pack_context", `name`: "pack_context", `qualname`: "Index.pack_context", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1537, `end_line`: 1921, `signature`: "def pack_context(\n        self,\n        query: str,\n        k: int = 8,\n        hops: int = 1,\n        budget_chars: int = 24000,\n        min_confidence: float = 1.0,\n        expand_graph: bool = True,\n        vectors: Mapping[Any, Vector] | None = None,\n        embedder: \"Embedder | None\" = None,\n ", `docstring`: "Assemble an agent-ready markdown context pack within budget.\n\n        Graph expansion follows DEFAULT_EDGE_DIRS (CO_CHANGE excluded), steered\n        by the question's shape. `expansion` names an EXPANSION_PRESETS policy;\n        `edge_types` and `edge_dirs` override its types and directions, and an\n        explicit `min_confidence` below 1.0 overrides its floor. Each neighbour's\n        `why` names the edge type and direction that admitted it.\n\n        Args:\n            query: Question or symbol query string.\n            k: Number of seed chunks.\n            hops: Graph expansion depth.\n     "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.pack_context.fits"}) SET n += {`id`: "sym:repo2graph/query.py::Index.pack_context.fits", `name`: "fits", `qualname`: "Index.pack_context.fits", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1820, `end_line`: 1821, `signature`: "def fits(block: str) -> bool:", `docstring`: ""};
