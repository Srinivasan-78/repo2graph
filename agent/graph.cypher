MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::path_index"}) SET n += {`id`: "sym:repo2graph/graph.py::path_index", `name`: "path_index", `qualname`: "path_index", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 164, `end_line`: 177, `signature`: "def path_index(file_index) -> dict:", `docstring`: "Lookup tables so import resolution never rescans the whole file list.\n\n    by_name: basename -> sorted paths.  by_dir: directory -> sorted paths.\n    Sorted so a repo with several same-named files resolves deterministically."};
