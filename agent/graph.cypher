MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_go_receiver_type"}) SET n += {`id`: "sym:repo2graph/parse.py::_go_receiver_type", `name`: "_go_receiver_type", `qualname`: "_go_receiver_type", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 939, `end_line`: 948, `signature`: "def _go_receiver_type(src: bytes, node) -> str | None:", `docstring`: "The receiver type of a Go `func (c *T[K]) M()`, pointer/generics stripped."};
