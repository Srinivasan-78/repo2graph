MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_iss146_commit_release_api_path_posix"}) SET n += {`id`: "sym:tests/test_compat.py::test_iss146_commit_release_api_path_posix", `name`: "test_iss146_commit_release_api_path_posix", `qualname`: "test_iss146_commit_release_api_path_posix", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 1003, `end_line`: 1015, `signature`: "def test_iss146_commit_release_api_path_posix(monkeypatch):", `docstring`: "Issue 146: commit_release_via_api.py must normalize Windows paths.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_commit_release_uses_signing_mutation_not_git_data"}) SET n += {`id`: "sym:tests/test_compat.py::test_commit_release_uses_signing_mutation_not_git_data", `name`: "test_commit_release_uses_signing_mutation_not_git_data", `qualname`: "test_commit_release_uses_signing_mutation_not_git_data", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 1018, `end_line`: 1054, `signature`: "def test_commit_release_uses_signing_mutation_not_git_data():", `docstring`: "The commit must be created by GraphQL createCommitOnBranch.\n\n    GitHub signs commits it authors (Contents API, createCommitOnBranch) and\n    does not sign ones assembled through the Git Data API. `main` requires\n    signed commits, so a regression back to blobs/trees/commits would leave\n    every release PR unmergeable without an admin bypass.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_commit_release_stages_an_existing_branch_before_moving_it"}) SET n += {`id`: "sym:tests/test_compat.py::test_commit_release_stages_an_existing_branch_before_moving_it", `name`: "test_commit_release_stages_an_existing_branch_before_moving_it", `qualname`: "test_commit_release_stages_an_existing_branch_before_moving_it", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 1057, `end_line`: 1085, `signature`: "def test_commit_release_stages_an_existing_branch_before_moving_it(monkeypatch):", `docstring`: "An existing PR branch must never be reset to base in place.\n\n    Resetting it leaves the open PR with zero commits and GitHub closes the PR\n    automatically, so the branch is rebuilt on a staging ref and moved in one\n    force-update instead.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_commit_release_commits_directly_on_a_new_branch"}) SET n += {`id`: "sym:tests/test_compat.py::test_commit_release_commits_directly_on_a_new_branch", `name`: "test_commit_release_commits_directly_on_a_new_branch", `qualname`: "test_commit_release_commits_directly_on_a_new_branch", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 1088, `end_line`: 1094, `signature`: "def test_commit_release_commits_directly_on_a_new_branch(monkeypatch):", `docstring`: "A branch that does not exist yet needs no staging ref.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_commit_release_splits_headline_from_body"}) SET n += {`id`: "sym:tests/test_compat.py::test_commit_release_splits_headline_from_body", `name`: "test_commit_release_splits_headline_from_body", `qualname`: "test_commit_release_splits_headline_from_body", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 1097, `end_line`: 1104, `signature`: "def test_commit_release_splits_headline_from_body(monkeypatch):", `docstring`: "GraphQL takes headline and body separately, not one git-style blob.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_commit_release_graphql_raises_on_error_payload"}) SET n += {`id`: "sym:tests/test_compat.py::test_commit_release_graphql_raises_on_error_payload", `name`: "test_commit_release_graphql_raises_on_error_payload", `qualname`: "test_commit_release_graphql_raises_on_error_payload", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 1107, `end_line`: 1131, `signature`: "def test_commit_release_graphql_raises_on_error_payload():", `docstring`: "GraphQL reports failures as HTTP 200 with an `errors` array.\n\n    Without this check a failed commit would return None and the release would\n    carry on as though it had succeeded.", `entrypoint`: true};
