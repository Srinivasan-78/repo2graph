MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_repo_map_is_silent_when_the_tree_is_unchanged"}) SET n += {`id`: "sym:tests/test_mcp.py::test_repo_map_is_silent_when_the_tree_is_unchanged", `name`: "test_repo_map_is_silent_when_the_tree_is_unchanged", `qualname`: "test_repo_map_is_silent_when_the_tree_is_unchanged", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 110, `end_line`: 115, `signature`: "def test_repo_map_is_silent_when_the_tree_is_unchanged(mini_repo, mini_index):", `docstring`: "#383: an index whose tree has not moved reports no staleness note --\n    the check must not become a false positive on every call.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_repo_map_warns_when_the_working_tree_moved"}) SET n += {`id`: "sym:tests/test_mcp.py::test_repo_map_warns_when_the_working_tree_moved", `name`: "test_repo_map_warns_when_the_working_tree_moved", `qualname`: "test_repo_map_warns_when_the_working_tree_moved", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 118, `end_line`: 149, `signature`: "def test_repo_map_warns_when_the_working_tree_moved(mini_repo, mini_index):", `docstring`: "#383: `_index_mtime`/`open_index`'s reload check both compare the index\n    against itself at an earlier moment -- neither ever looks at the source\n    tree, so a long-running server answered from a stale graph indefinitely\n    and every `[cite: path:start-end]` anchor was then confidently wrong.\n    `tool_repo_map` must surface the mismatch using the per-file sha256\n    `index.state.json` already records (`status.compute_freshness`), not stay\n    silent forever.\n\n    Detector: reverting `tool_repo_map` to `index.map_prepend()` (its\n    pre-#383 body) makes this fail while\n    test_repo_map_is", `entrypoint`: true};
