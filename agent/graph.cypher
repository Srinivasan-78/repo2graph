MERGE (n:R2G:`Symbol` {id: "sym:tests/test_query_bounds.py::TestJsonlBounds.test_read_jsonl_bounds_the_allocation_not_just_the_report"}) SET n += {`id`: "sym:tests/test_query_bounds.py::TestJsonlBounds.test_read_jsonl_bounds_the_allocation_not_just_the_report", `name`: "test_read_jsonl_bounds_the_allocation_not_just_the_report", `qualname`: "TestJsonlBounds.test_read_jsonl_bounds_the_allocation_not_just_the_report", `kind`: "function", `path`: "tests/test_query_bounds.py", `lang`: "python", `start_line`: 35, `end_line`: 86, `signature`: "def test_read_jsonl_bounds_the_allocation_not_just_the_report(self, monkeypatch):", `docstring`: "bounded JSONL reads's first attack shape is a file with no newline in it at all.\n\n        The sibling test above only proves a ValueError is *reported*, which a\n        `for raw in fh` loop does too -- after reading the whole file into one\n        bytes object, which is the thing the ceiling exists to prevent. So this\n        counts the bytes the reader actually asks for: it must give up after\n        roughly one block past the ceiling, never serve the whole file.\n\n        Detector: restore `for lineno, raw in enumerate(fh, 1)` in read_jsonl\n        and `served` jumps from ~64 KiB to the full ", `entrypoint`: true};
