MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/events.py::is_debug_mode"}) SET n += {`id`: "sym:repo2graph/events.py::is_debug_mode", `name`: "is_debug_mode", `qualname`: "is_debug_mode", `kind`: "function", `path`: "repo2graph/events.py", `lang`: "python", `start_line`: 29, `end_line`: 32, `signature`: "def is_debug_mode() -> bool:", `docstring`: "Return True if REPO2GRAPH_DEBUG environment variable is enabled."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/events.py::reraise_if_debug"}) SET n += {`id`: "sym:repo2graph/events.py::reraise_if_debug", `name`: "reraise_if_debug", `qualname`: "reraise_if_debug", `kind`: "function", `path`: "repo2graph/events.py", `lang`: "python", `start_line`: 35, `end_line`: 42, `signature`: "def reraise_if_debug(exc: BaseException | None = None) -> None:", `docstring`: "Re-raise the current or given exception if debug mode is active."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/events.py::encodable"}) SET n += {`id`: "sym:repo2graph/events.py::encodable", `name`: "encodable", `qualname`: "encodable", `kind`: "function", `path`: "repo2graph/events.py", `lang`: "python", `start_line`: 52, `end_line`: 93, `signature`: "def encodable(text: str, stream: Any) -> str:", `docstring`: "Return `text` reduced to something `stream` is guaranteed to accept.\n\n    The stream's encoding and error handler are read at call time, not at import\n    time: tests replace `sys.stdout` after import, and a caller may reconfigure\n    it mid-run.\n\n    Args:\n        text: The text about to be written.\n        stream: The destination stream, inspected for `.encoding`/`.errors`.\n\n    Returns:\n        `text` unchanged when the stream can represent it, otherwise the same\n        text with unrepresentable characters replaced."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/events.py::write_safe"}) SET n += {`id`: "sym:repo2graph/events.py::write_safe", `name`: "write_safe", `qualname`: "write_safe", `kind`: "function", `path`: "repo2graph/events.py", `lang`: "python", `start_line`: 96, `end_line`: 123, `signature`: "def write_safe(stream: Any, text: str, newline: str = \"\\n\") -> None:", `docstring`: "Write `text` to `stream`, replacing anything it cannot encode.\n\n    Never raises: a UnicodeEncodeError, a closed stream or a broken pipe all end\n    as silence rather than as an exception in the caller.\n\n    Args:\n        stream: Destination, typically `sys.stdout` or `sys.stderr`.\n        text: The line to write, without a trailing newline.\n        newline: Appended to `text`; pass \"\" to suppress it."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/events.py::diagnostic"}) SET n += {`id`: "sym:repo2graph/events.py::diagnostic", `name`: "diagnostic", `qualname`: "diagnostic", `kind`: "function", `path`: "repo2graph/events.py", `lang`: "python", `start_line`: 126, `end_line`: 135, `signature`: "def diagnostic(text: str) -> None:", `docstring`: "One human-readable line on stderr: a warning, a note or an error.\n\n    The single way repo2graph talks to a person outside its JSON output (#43):\n    `emit()` is for structured events a program reads; this is for sentences.\n    Resolves `sys.stderr` at call time and, like `write_safe`, never raises."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/events.py::timestamp"}) SET n += {`id`: "sym:repo2graph/events.py::timestamp", `name`: "timestamp", `qualname`: "timestamp", `kind`: "function", `path`: "repo2graph/events.py", `lang`: "python", `start_line`: 138, `end_line`: 147, `signature`: "def timestamp() -> str:", `docstring`: "An ISO-8601 UTC timestamp with millisecond precision.\n\n    Returns:\n        e.g. `\"2026-09-16T10:31:07.482Z\"`. Milliseconds rather than\n        microseconds because that is what the audit record format specifies and\n        what most SIEM ingesters expect."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/events.py::emit"}) SET n += {`id`: "sym:repo2graph/events.py::emit", `name`: "emit", `qualname`: "emit", `kind`: "function", `path`: "repo2graph/events.py", `lang`: "python", `start_line`: 150, `end_line`: 190, `signature`: "def emit(\n    event: str, level: str = \"warning\", stream: TextIO | None = None, **fields: Any\n) -> dict[str, Any]:", `docstring`: "Write one structured event as a single JSON line on stderr.\n\n    Args:\n        event: Machine-readable event name, e.g. `\"rag_fusion_disabled\"`.\n        level: Severity label; \"warning\" by default.\n        stream: Destination; defaults to `sys.stderr` resolved at call time.\n        **fields: Additional JSON-serialisable fields merged into the record.\n\n    Returns:\n        The record that was emitted, so callers and tests can assert on it\n        without re-parsing stderr."};
