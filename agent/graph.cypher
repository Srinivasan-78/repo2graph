MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_serve_reports_its_own_version_not_the_sdks"}) SET n += {`id`: "sym:tests/test_mcp.py::test_serve_reports_its_own_version_not_the_sdks", `name`: "test_serve_reports_its_own_version_not_the_sdks", `qualname`: "test_serve_reports_its_own_version_not_the_sdks", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1176, `end_line`: 1201, `signature`: "def test_serve_reports_its_own_version_not_the_sdks(mini_index, monkeypatch):", `docstring`: "`Server(name)` without `version=` makes the SDK report *its* version.\n\n    The MCP SDK fills serverInfo.version from its own package when the server\n    does not supply one, so every client was told repo2graph was whatever\n    release of `mcp` happened to be installed -- 1.30.0 against a 1.4.0\n    package. It also put the two transports in disagreement, since the HTTP\n    one has always reported __version__ correctly.", `entrypoint`: true};
