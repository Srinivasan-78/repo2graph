MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_nesting_past_the_depth_ceiling_is_a_clean_parse_error"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_nesting_past_the_depth_ceiling_is_a_clean_parse_error", `name`: "test_nesting_past_the_depth_ceiling_is_a_clean_parse_error", `qualname`: "test_nesting_past_the_depth_ceiling_is_a_clean_parse_error", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 269, `end_line`: 282, `signature`: "def test_nesting_past_the_depth_ceiling_is_a_clean_parse_error(make_server):", `docstring`: "#293: a body that fits comfortably inside MAX_BODY_BYTES but nests\n    past MAX_JSON_DEPTH (32) is refused before json.loads ever runs, not\n    merely before it overflows the interpreter stack (that shape is already\n    covered by test_http_transport's ISS-233 test at depth 20,000).", `entrypoint`: true};
