MERGE (n:R2G:`Symbol` {id: "sym:tests/test_auth.py::test_a_non_ascii_credential_is_refused_rather_than_raising_typeerror"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_non_ascii_credential_is_refused_rather_than_raising_typeerror", `name`: "test_a_non_ascii_credential_is_refused_rather_than_raising_typeerror", `qualname`: "test_a_non_ascii_credential_is_refused_rather_than_raising_typeerror", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 982, `end_line`: 991, `signature`: "def test_a_non_ascii_credential_is_refused_rather_than_raising_typeerror():", `docstring`: "Issue 232: `hmac.compare_digest` raises on a non-ASCII str operand.\n\n    The credential is the raw Authorization header, so any client can trigger\n    it. A TypeError is not an AuthError, so the transport's refusal path never\n    sees it: the handler thread dies and the caller gets no response at all,\n    not a 401 and not a 500. Only AuthError is an acceptable outcome here.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_auth.py::test_a_non_ascii_credential_is_refused_with_oidc_also_configured"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_non_ascii_credential_is_refused_with_oidc_also_configured", `name`: "test_a_non_ascii_credential_is_refused_with_oidc_also_configured", `qualname`: "test_a_non_ascii_credential_is_refused_with_oidc_also_configured", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 994, `end_line`: 1002, `signature`: "def test_a_non_ascii_credential_is_refused_with_oidc_also_configured():", `docstring`: "Same header, the other configuration: the static branch runs first and\n    falls through to OIDC, so both wirings have to survive it.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_auth.py::test_a_non_ascii_configured_token_refuses_rather_than_raising"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_non_ascii_configured_token_refuses_rather_than_raising", `name`: "test_a_non_ascii_configured_token_refuses_rather_than_raising", `qualname`: "test_a_non_ascii_configured_token_refuses_rather_than_raising", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 1005, `end_line`: 1016, `signature`: "def test_a_non_ascii_configured_token_refuses_rather_than_raising():", `docstring`: "The operator's own token may be non-ASCII too.\n\n    Encoding only the credential would move the TypeError one operand across\n    and leave the dead thread exactly where it was -- reachable, this time, by\n    any request at all rather than only a non-ASCII one.", `entrypoint`: true};
