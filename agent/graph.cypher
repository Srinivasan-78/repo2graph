MERGE (n:R2G:Symbol {id: "sym:repo2graph/changelog.py::_indegree"}) SET n += {`id`: "sym:repo2graph/changelog.py::_indegree", `name`: "_indegree", `qualname`: "_indegree", `kind`: "function", `path`: "repo2graph/changelog.py", `lang`: "python", `start_line`: 106, `end_line`: 113, `signature`: "def _indegree(edges: list[dict[str, Any]]) -> dict[str, int]:", `docstring`: ""};
