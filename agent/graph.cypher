MERGE (n:R2G:Symbol {id: "sym:repo2graph/parse.py::explain_path"}) SET n += {`id`: "sym:repo2graph/parse.py::explain_path", `name`: "explain_path", `qualname`: "explain_path", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1309, `end_line`: 1517, `signature`: "def explain_path(\n    root: Path | str,\n    target: Path | str,\n    config: BuildConfig | None = None,\n    include_globs=None,\n    exclude_globs=None,\n) -> dict:", `docstring`: "Evaluate a path against the 10 inclusion/exclusion precedence rules.\n\n    Returns a dict with:\n        path: target path\n        relative_path: relative path to root\n        included: bool (True if the file would be indexed)\n        rule: string identifier of the determining rule\n        reason: human-readable explanation\n        precedence_step: step number (1-10) where the decision was reached"};
