MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graph_streaming.py::_straddling_source"}) SET n += {`id`: "sym:tests/test_graph_streaming.py::_straddling_source", `name`: "_straddling_source", `qualname`: "_straddling_source", `kind`: "function", `path`: "tests/test_graph_streaming.py", `lang`: "python", `start_line`: 41, `end_line`: 58, `signature`: "def _straddling_source() -> bytes:", `docstring`: "A module whose `\u00e9` has its lead byte at offset _LIMIT - 1, exactly.\n\n    So slice 1 (bytes 0.._LIMIT) ends on the lone lead byte 0xC3 and slice 2\n    begins on the orphaned continuation byte 0xA9: before the fix, *both* failed\n    to decode and both were dropped, taking alpha and beta with the first and\n    gamma with the second."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graph_streaming.py::test_symbols_on_both_sides_of_a_straddling_character_survive"}) SET n += {`id`: "sym:tests/test_graph_streaming.py::test_symbols_on_both_sides_of_a_straddling_character_survive", `name`: "test_symbols_on_both_sides_of_a_straddling_character_survive", `qualname`: "test_symbols_on_both_sides_of_a_straddling_character_survive", `kind`: "function", `path`: "tests/test_graph_streaming.py", `lang`: "python", `start_line`: 61, `end_line`: 68, `signature`: "def test_symbols_on_both_sides_of_a_straddling_character_survive(tmp_path):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graph_streaming.py::test_chunked_read_reports_the_same_digest_size_and_lines_as_a_whole_read"}) SET n += {`id`: "sym:tests/test_graph_streaming.py::test_chunked_read_reports_the_same_digest_size_and_lines_as_a_whole_read", `name`: "test_chunked_read_reports_the_same_digest_size_and_lines_as_a_whole_read", `qualname`: "test_chunked_read_reports_the_same_digest_size_and_lines_as_a_whole_read", `kind`: "function", `path`: "tests/test_graph_streaming.py", `lang`: "python", `start_line`: 71, `end_line`: 93, `signature`: "def test_chunked_read_reports_the_same_digest_size_and_lines_as_a_whole_read(tmp_path):", `docstring`: "The digest and the line count used to come from a bytearray holding the\n    entire file -- the one thing max_file_bytes exists to prevent. They are\n    streamed now, and must still be the same numbers, both against the fixture\n    bytes and against the whole-file reader on the same bytes.", `entrypoint`: true, `reach`: 367};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graph_streaming.py::_invalid_byte_source"}) SET n += {`id`: "sym:tests/test_graph_streaming.py::_invalid_byte_source", `name`: "_invalid_byte_source", `qualname`: "_invalid_byte_source", `kind`: "function", `path`: "tests/test_graph_streaming.py", `lang`: "python", `start_line`: 96, `end_line`: 114, `signature`: "def _invalid_byte_source() -> bytes:", `docstring`: "Three exactly-_LIMIT-byte slices, the middle one not UTF-8 at all.\n\n    0xFF can never begin a UTF-8 sequence, so it is not a truncated character to\n    carry forward -- it must still be skipped, must be counted, and must not\n    stall the loop or cost the slices around it."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graph_streaming.py::test_bytes_that_are_not_utf8_are_counted_and_cost_only_their_own_slice"}) SET n += {`id`: "sym:tests/test_graph_streaming.py::test_bytes_that_are_not_utf8_are_counted_and_cost_only_their_own_slice", `name`: "test_bytes_that_are_not_utf8_are_counted_and_cost_only_their_own_slice", `qualname`: "test_bytes_that_are_not_utf8_are_counted_and_cost_only_their_own_slice", `kind`: "function", `path`: "tests/test_graph_streaming.py", `lang`: "python", `start_line`: 117, `end_line`: 124, `signature`: "def test_bytes_that_are_not_utf8_are_counted_and_cost_only_their_own_slice(tmp_path):", `docstring`: "", `entrypoint`: true};
