MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_jwks_uri_on_another_host_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_jwks_uri_on_another_host_is_refused", `name`: "test_a_jwks_uri_on_another_host_is_refused", `qualname`: "test_a_jwks_uri_on_another_host_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 804, `end_line`: 813, `signature`: "def test_a_jwks_uri_on_another_host_is_refused():", `docstring`: "One field in a fetched document must not relocate the trust anchor.", `entrypoint`: true};
