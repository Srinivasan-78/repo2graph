MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::rel"}) SET n += {`id`: "sym:repo2graph/export.py::rel", `name`: "rel", `qualname`: "rel", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 85, `end_line`: 87, `signature`: "def rel(name: str) -> str:", `docstring`: "'nodes.jsonl' -> 'agent/nodes.jsonl'. The path readers should use."};
