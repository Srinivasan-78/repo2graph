MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_federated"}) SET n += {`id`: "sym:repo2graph/cli.py::_federated", `name`: "_federated", `qualname`: "_federated", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 826, `end_line`: 837, `signature`: "def _federated(args: argparse.Namespace) -> list[tuple[str, \"Index\"]] | None:", `docstring`: "The --index set, or None; refuses combinations that do not federate (#396)."};
