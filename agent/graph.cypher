MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp/server.py::_binds_beyond_loopback"}) SET n += {`id`: "sym:repo2graph/mcp/server.py::_binds_beyond_loopback", `name`: "_binds_beyond_loopback", `qualname`: "_binds_beyond_loopback", `kind`: "function", `path`: "repo2graph/mcp/server.py", `lang`: "python", `start_line`: 471, `end_line`: 488, `signature`: "def _binds_beyond_loopback(host: str) -> bool:", `docstring`: "Whether `--host` exposes the index past this machine.\n\n    An empty host and `*` are uvicorn's spellings of \"every interface\". A name\n    rather than a literal cannot be classified without resolving it, and this\n    runs before the socket is opened, so it is treated as exposed -- the safe\n    direction for a check whose only effect is to demand a token."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp/server.py::require_sse_auth"}) SET n += {`id`: "sym:repo2graph/mcp/server.py::require_sse_auth", `name`: "require_sse_auth", `qualname`: "require_sse_auth", `kind`: "function", `path`: "repo2graph/mcp/server.py", `lang`: "python", `start_line`: 491, `end_line`: 512, `signature`: "def require_sse_auth(host: str, auth_token: str | None) -> None:", `docstring`: "Refuse to serve the index to a network without a bearer token.\n\n    `--transport sse` turns a local, single-client stdio tool into a server,\n    and `/sse` and `/messages` hand out the same cited file content the stdio\n    transport does. Binding `0.0.0.0` without `--auth-token` therefore serves\n    the whole index to anything that can route to the port -- and because\n    `create_sse_app` installs its middleware only `if auth_token`, the\n    unauthenticated case was silent rather than refused.\n\n    Loopback stays open with no token: that is the documented container-local\n    and port-forward c"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp/server.py::create_sse_app"}) SET n += {`id`: "sym:repo2graph/mcp/server.py::create_sse_app", `name`: "create_sse_app", `qualname`: "create_sse_app", `kind`: "function", `path`: "repo2graph/mcp/server.py", `lang`: "python", `start_line`: 515, `end_line`: 606, `signature`: "def create_sse_app(\n    mcp_server: Any, auth_token: str | None = None, bind_host: str | None = None\n) -> Any:", `docstring`: "Create a Starlette ASGI application serving MCP over Server-Sent Events (SSE).\n\n    `bind_host` is only used to decide whether an absent `auth_token` deserves a\n    warning. This function does not open the socket, so it cannot otherwise know\n    whether the app is about to be exposed: pass the host you are going to bind,\n    and loopback stays silent because loopback with no token is the documented\n    container-local and port-forward case. Leave it unset and an absent token\n    warns, since an unknown bind has to be assumed to be a public one."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp/server.py::create_sse_app.handle_sse"}) SET n += {`id`: "sym:repo2graph/mcp/server.py::create_sse_app.handle_sse", `name`: "handle_sse", `qualname`: "create_sse_app.handle_sse", `kind`: "function", `path`: "repo2graph/mcp/server.py", `lang`: "python", `start_line`: 543, `end_line`: 546, `signature`: "async def handle_sse(request: Any) -> _ASGIResponse:", `docstring`: ""};
