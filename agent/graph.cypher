MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/status.py::_git_head"}) SET n += {`id`: "sym:repo2graph/status.py::_git_head", `name`: "_git_head", `qualname`: "_git_head", `kind`: "function", `path`: "repo2graph/status.py", `lang`: "python", `start_line`: 84, `end_line`: 99, `signature`: "def _git_head(repo: Path) -> str | None:", `docstring`: "The tree's current HEAD sha, or None when `repo` is not a git checkout."};
