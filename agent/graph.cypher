MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_tool_descriptions_stay_under_budget"}) SET n += {`id`: "sym:tests/test_mcp.py::test_tool_descriptions_stay_under_budget", `name`: "test_tool_descriptions_stay_under_budget", `qualname`: "test_tool_descriptions_stay_under_budget", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 305, `end_line`: 343, `signature`: "def test_tool_descriptions_stay_under_budget():", `docstring`: "Verify the published tool set, capped under a combined character budget.\n\n    The character budget balances agent context overhead against Glama TDQS\n    (Tool Definition Quality Standard) requirements. Tool descriptions are loaded\n    into every agent's context every turn, so they must stay tightly bounded;\n    however, they must also provide explicit usage guidance, sibling disambiguation,\n    and safety disclosures.\n\n    Round 1 of MCP hardening added four tools (repo_find_symbol, repo_read,\n    repo_path_between, repo_blast_radius) to the original six, each of which\n    needs its own sibli", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_tool_descriptions_contain_usage_guidance_and_siblings"}) SET n += {`id`: "sym:tests/test_mcp.py::test_tool_descriptions_contain_usage_guidance_and_siblings", `name`: "test_tool_descriptions_contain_usage_guidance_and_siblings", `qualname`: "test_tool_descriptions_contain_usage_guidance_and_siblings", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 346, `end_line`: 380, `signature`: "def test_tool_descriptions_contain_usage_guidance_and_siblings():", `docstring`: "Glama TDQS: Every tool description must contain explicit usage guidance\n    ('when to use' or 'use when') and cross-reference alternative sibling tools\n    to prevent agent mis-routing.", `entrypoint`: true};
