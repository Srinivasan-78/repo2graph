MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index"}) SET n += {`id`: "sym:repo2graph/query.py::Index", `name`: "Index", `qualname`: "Index", `kind`: "class", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 184, `end_line`: 886, `signature`: "class Index:\n    # (fused, candidates) for the most recent score_rrf call, or None if no\n    # fused query has run on this Index yet. A class-level default so every\n    # Index has the attribute without __init__ having to care.", `docstring`: ""};
