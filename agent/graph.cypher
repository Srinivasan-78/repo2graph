MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/federated.py::open_indexes"}) SET n += {`id`: "sym:repo2graph/federated.py::open_indexes", `name`: "open_indexes", `qualname`: "open_indexes", `kind`: "function", `path`: "repo2graph/federated.py", `lang`: "python", `start_line`: 27, `end_line`: 44, `signature`: "def open_indexes(dirs: list[str | Path]) -> list[tuple[str, Index]]:", `docstring`: "(repo name, Index) per readable directory; the rest are skipped, loudly."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/federated.py::merge_by_rank"}) SET n += {`id`: "sym:repo2graph/federated.py::merge_by_rank", `name`: "merge_by_rank", `qualname`: "merge_by_rank", `kind`: "function", `path`: "repo2graph/federated.py", `lang`: "python", `start_line`: 47, `end_line`: 54, `signature`: "def merge_by_rank(per_index: list[tuple[str, list[Record]]]) -> list[Record]:", `docstring`: "Interleave each index's ranked list by reciprocal rank, tagging the repo."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/federated.py::_fit"}) SET n += {`id`: "sym:repo2graph/federated.py::_fit", `name`: "_fit", `qualname`: "_fit", `kind`: "function", `path`: "repo2graph/federated.py", `lang`: "python", `start_line`: 57, `end_line`: 75, `signature`: "def _fit(records: list[Record], cost: Callable[[Record], int], budget: int | None) -> list[Record]:", `docstring`: "The records that fit, in rank order; `None` is the only unbounded value.\n\n    `None` and `0` have to stay distinguishable (#482). A caller's budget of 0\n    means \"no ceiling\", the convention `query.pack_context` also uses\n    (`bounded = budget > 0`), but 0 is equally what is *left* of a positive\n    budget the header already spent -- and reading that as unbounded is how a\n    budget too small for the header returned a pack 25x over it, with\n    `truncated` reporting False."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/federated.py::retrieve"}) SET n += {`id`: "sym:repo2graph/federated.py::retrieve", `name`: "retrieve", `qualname`: "retrieve", `kind`: "function", `path`: "repo2graph/federated.py", `lang`: "python", `start_line`: 78, `end_line`: 84, `signature`: "def retrieve(\n    indexes: list[tuple[str, Index]], query: str, budget_chars: int, **kw: Any\n) -> list[Record]:", `docstring`: "`Index.retrieve` on each index, merged, under one character budget."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/federated.py::_head"}) SET n += {`id`: "sym:repo2graph/federated.py::_head", `name`: "_head", `qualname`: "_head", `kind`: "function", `path`: "repo2graph/federated.py", `lang`: "python", `start_line`: 87, `end_line`: 106, `signature`: "def _head(names: list[str], measure: Callable[[str], int], budget: int | None) -> str:", `docstring`: "`# Context from N repositories: ...`, listing as many names as fit.\n\n    Byte-identical to the full list whenever it fits, which at any ordinary\n    budget it does -- a name costs about two tokens, so it takes hundreds of\n    indexes to trouble a 2,000-token pack. Past that the list is cut rather\n    than allowed to push the pack over its ceiling, which is what a header\n    counted against the budget but never bounded by it used to do (#482). The\n    count is the part that survives longest: it says how much was searched,\n    which the names only elaborate."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/federated.py::pack_context"}) SET n += {`id`: "sym:repo2graph/federated.py::pack_context", `name`: "pack_context", `qualname`: "pack_context", `kind`: "function", `path`: "repo2graph/federated.py", `lang`: "python", `start_line`: 109, `end_line`: 179, `signature`: "def pack_context(\n    indexes: list[tuple[str, Index]],\n    query: str,\n    *,\n    budget_chars: int = 24000,\n    budget_tokens: int | None = None,\n    count_tokens: [REDACTED:CREDENTIAL_UNQUOTED] int] = count_tokens,\n    token_margin: float = 0.0,\n    **kw: Any,\n) -> dict[str, Any]:", `docstring`: "A cited pack drawn from every index, under one budget.\n\n    Each index packs as it would alone (no repo map: maps do not merge), and\n    the chunks the packs chose are interleaved by rank and re-cut to fit.\n\n    The budget is accounted for exactly as `Index.pack_context` accounts for\n    it, and the result carries the same `ContextPack` keys. The two used to\n    diverge: `--token-margin` reached the per-index packs but never the fit\n    over the merged list, and the six budget-reporting fields -- including the\n    `token_count_method` that says how `tokens_used` was counted -- were\n    absent "};
