MERGE (n:R2G:Symbol {id: "sym:tests/test_secrets_hardening.py::test_scan_content_secrets_returns_spans_not_plaintext"}) SET n += {`id`: "sym:tests/test_secrets_hardening.py::test_scan_content_secrets_returns_spans_not_plaintext", `name`: "test_scan_content_secrets_returns_spans_not_plaintext", `qualname`: "test_scan_content_secrets_returns_spans_not_plaintext", `kind`: "function", `path`: "tests/test_secrets_hardening.py", `lang`: "python", `start_line`: 222, `end_line`: 240, `signature`: "def test_scan_content_secrets_returns_spans_not_plaintext():", `docstring`: "A finding locates a credential; it must never carry one.\n\n    Callers only count findings or report `f[0]`, so returning the matched\n    bytes built a list of live credentials that existed solely to be thrown\n    away -- and any later `emit(..., findings=findings)` would have shipped it\n    verbatim. Offsets below are hand-counted against `text`: \"tok = '\" is 7\n    characters, and the token is 36.", `entrypoint`: true};
