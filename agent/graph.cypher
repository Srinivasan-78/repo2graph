MERGE (n:R2G:Symbol {id: "sym:tests/test_cache.py::test_list_and_dict_arguments_do_not_raise"}) SET n += {`id`: "sym:tests/test_cache.py::test_list_and_dict_arguments_do_not_raise", `name`: "test_list_and_dict_arguments_do_not_raise", `qualname`: "test_list_and_dict_arguments_do_not_raise", `kind`: "function", `path`: "tests/test_cache.py", `lang`: "python", `start_line`: 63, `end_line`: 72, `signature`: "def test_list_and_dict_arguments_do_not_raise():", `docstring`: "frozenset(params.items()) raises here; canonical JSON does not.\n\n    JSON-Schema tool arguments permit arrays and objects, so a key built from a\n    frozenset of items is a TypeError waiting for the first caller who sends\n    one -- which is why this cache keys on canonical JSON instead.", `entrypoint`: true};
