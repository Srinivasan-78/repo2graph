MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_a_definition_this_file_owns_still_wins_a_bare_builtin_name"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_a_definition_this_file_owns_still_wins_a_bare_builtin_name", `name`: "test_a_definition_this_file_owns_still_wins_a_bare_builtin_name", `qualname`: "test_a_definition_this_file_owns_still_wins_a_bare_builtin_name", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 1656, `end_line`: 1677, `signature`: "def test_a_definition_this_file_owns_still_wins_a_bare_builtin_name(tmp_path: Path):", `docstring`: "Shadowing is only a guess *across* files.\n\n    A `filter()` defined in the calling file, or imported into it by name, is\n    what a bare `filter()` there means -- `SCOPED_CALL_KINDS` is exactly that\n    set, which is why the gate reads it rather than the name alone.", `entrypoint`: true};
