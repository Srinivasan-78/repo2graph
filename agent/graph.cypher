MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/status.py::Freshness"}) SET n += {`id`: "sym:repo2graph/status.py::Freshness", `name`: "Freshness", `qualname`: "Freshness", `kind`: "class", `path`: "repo2graph/status.py", `lang`: "python", `start_line`: 37, `end_line`: 82, `signature`: "class Freshness:", `docstring`: "Whether an index still describes the tree it was built from.\n\n    `status` is one of:\n      \"current\"  -- every signal checked agrees the index is up to date\n      \"stale\"    -- at least one signal says it is not\n      \"unknown\"  -- nothing could be checked (no state file, no git, bound hit)"};
