MERGE (n:R2G:`Symbol` {id: "sym:tests/test_auth.py::test_a_jwk_declaring_neither_use_nor_key_ops_still_verifies"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_jwk_declaring_neither_use_nor_key_ops_still_verifies", `name`: "test_a_jwk_declaring_neither_use_nor_key_ops_still_verifies", `qualname`: "test_a_jwk_declaring_neither_use_nor_key_ops_still_verifies", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 531, `end_line`: 542, `signature`: "def test_a_jwk_declaring_neither_use_nor_key_ops_still_verifies():", `docstring`: "Absent means unconstrained, per RFC 7517 \u00a74.2/\u00a74.3.\n\n    This is the ordinary JWKS entry that every real issuer serves, and a\n    purpose check that reads \"absent\" as \"forbidden\" would lock out all of\n    them. Pinned as its own case because the two rejections above pass just as\n    happily under a check that rejects everything.", `entrypoint`: true, `reach`: 35};
