MERGE (n:R2G:Symbol {id: "sym:repo2graph/explain.py::format_explain_node"}) SET n += {`id`: "sym:repo2graph/explain.py::format_explain_node", `name`: "format_explain_node", `qualname`: "format_explain_node", `kind`: "function", `path`: "repo2graph/explain.py", `lang`: "python", `start_line`: 247, `end_line`: 283, `signature`: "def format_explain_node(data: dict[str, Any]) -> str:", `docstring`: "Format node explanation as human-readable text."};
