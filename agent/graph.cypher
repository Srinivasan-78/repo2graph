MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::test_iss197_a_withheld_request_body_is_answered_rather_than_waited_on"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss197_a_withheld_request_body_is_answered_rather_than_waited_on", `name`: "test_iss197_a_withheld_request_body_is_answered_rather_than_waited_on", `qualname`: "test_iss197_a_withheld_request_body_is_answered_rather_than_waited_on", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 820, `end_line`: 847, `signature`: "def test_iss197_a_withheld_request_body_is_answered_rather_than_waited_on(make_server, monkeypatch):", `docstring`: "Issue 197: headers promising a megabyte, then silence.\n\n    Without a handler `timeout`, socketserver never arms settimeout() and\n    `rfile.read(Content-Length)` blocks for as long as the client cares to hold\n    the socket -- one pinned thread per connection, on a server that caps\n    neither. The shipped 30s is far too long to sit through here, so the test\n    pins the attribute's existence separately and then shrinks it to prove the\n    second half: that the read failing becomes a 408 rather than a handler\n    thread dying with the client still waiting.", `entrypoint`: true, `reach`: 20};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::test_iss197_a_body_shorter_than_content_length_is_408_not_a_hang"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss197_a_body_shorter_than_content_length_is_408_not_a_hang", `name`: "test_iss197_a_body_shorter_than_content_length_is_408_not_a_hang", `qualname`: "test_iss197_a_body_shorter_than_content_length_is_408_not_a_hang", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 850, `end_line`: 873, `signature`: "def test_iss197_a_body_shorter_than_content_length_is_408_not_a_hang(make_server, monkeypatch):", `docstring`: "The polite version of the same thing: the client closes early.\n\n    `rfile.read(length)` returns short at EOF rather than raising, so this path\n    never reaches the timeout at all -- it has to be noticed by comparing what\n    arrived against what was promised.", `entrypoint`: true, `reach`: 12};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::AbortingWriter"}) SET n += {`id`: "sym:tests/test_http_transport.py::AbortingWriter", `name`: "AbortingWriter", `qualname`: "AbortingWriter", `kind`: "class", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 876, `end_line`: 906, `signature`: "class AbortingWriter:", `docstring`: "A `wfile` that raises ConnectionAbortedError from the nth write on.\n\n    The real shape is a client that hangs up mid-response, which Windows\n    reports as ConnectionAbortedError -- the sibling of BrokenPipeError and\n    ConnectionResetError that the old guard did not name. Forcing it beats\n    racing a real socket close, which lands on a different write every run.\n\n    Write 1 is the header flush from `end_headers()`; write 2 is the body."};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::AbortingWriter.__init__"}) SET n += {`id`: "sym:tests/test_http_transport.py::AbortingWriter.__init__", `name`: "__init__", `qualname`: "AbortingWriter.__init__", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 887, `end_line`: 890, `signature`: "def __init__(self, inner, fail_from):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::AbortingWriter.write"}) SET n += {`id`: "sym:tests/test_http_transport.py::AbortingWriter.write", `name`: "write", `qualname`: "AbortingWriter.write", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 892, `end_line`: 896, `signature`: "def write(self, data):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::AbortingWriter.flush"}) SET n += {`id`: "sym:tests/test_http_transport.py::AbortingWriter.flush", `name`: "flush", `qualname`: "AbortingWriter.flush", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 898, `end_line`: 899, `signature`: "def flush(self):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::AbortingWriter.closed"}) SET n += {`id`: "sym:tests/test_http_transport.py::AbortingWriter.closed", `name`: "closed", `qualname`: "AbortingWriter.closed", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 902, `end_line`: 903, `signature`: "def closed(self):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::AbortingWriter.close"}) SET n += {`id`: "sym:tests/test_http_transport.py::AbortingWriter.close", `name`: "close", `qualname`: "AbortingWriter.close", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 905, `end_line`: 906, `signature`: "def close(self):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::abort_writes_from"}) SET n += {`id`: "sym:tests/test_http_transport.py::abort_writes_from", `name`: "abort_writes_from", `qualname`: "abort_writes_from", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 909, `end_line`: 917, `signature`: "def abort_writes_from(monkeypatch, server, fail_from):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::abort_writes_from.setup"}) SET n += {`id`: "sym:tests/test_http_transport.py::abort_writes_from.setup", `name`: "setup", `qualname`: "abort_writes_from.setup", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 913, `end_line`: 915, `signature`: "def setup(self):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::test_iss199_a_disconnect_during_a_response_reaches_no_error_reporter"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss199_a_disconnect_during_a_response_reaches_no_error_reporter", `name`: "test_iss199_a_disconnect_during_a_response_reaches_no_error_reporter", `qualname`: "test_iss199_a_disconnect_during_a_response_reaches_no_error_reporter", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 924, `end_line`: 951, `signature`: "def test_iss199_a_disconnect_during_a_response_reaches_no_error_reporter(\n    make_server, monkeypatch, capsys, fail_from, what\n):", `docstring`: "Issue 199: a client that hangs up mid-response is not an error.\n\n    `_send_json` guarded only the body write and only two of ConnectionError's\n    three subclasses, so a disconnect at `end_headers()` (every platform) or a\n    ConnectionAbortedError at the body write (Windows) escaped into the\n    server's error reporter. Either way the operator gets a record for\n    something that is not a fault, and before this package owned that reporter\n    the record was a multi-line traceback in a stream promised to be JSON-lines.", `entrypoint`: true, `reach`: 20};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::test_iss199_an_escaping_handler_error_is_one_json_line"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss199_an_escaping_handler_error_is_one_json_line", `name`: "test_iss199_an_escaping_handler_error_is_one_json_line", `qualname`: "test_iss199_an_escaping_handler_error_is_one_json_line", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 954, `end_line`: 981, `signature`: "def test_iss199_an_escaping_handler_error_is_one_json_line(make_server, monkeypatch, capsys):", `docstring`: "Issue 199, second half: whatever does escape stays machine-readable.\n\n    socketserver's default `handle_error` prints a dashed banner plus a full\n    traceback to stderr, which `events.py` promises is one JSON object per\n    line. A SIEM parsing it line by line gets a dozen lines that parse as none,\n    at exactly the moment the record matters most.", `entrypoint`: true, `reach`: 11};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::test_iss199_an_escaping_handler_error_is_one_json_line.exploding_get"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss199_an_escaping_handler_error_is_one_json_line.exploding_get", `name`: "exploding_get", `qualname`: "test_iss199_an_escaping_handler_error_is_one_json_line.exploding_get", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 964, `end_line`: 965, `signature`: "def exploding_get(self, send_body=True):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::test_iss233_a_deeply_nested_json_body_is_a_clean_400"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss233_a_deeply_nested_json_body_is_a_clean_400", `name`: "test_iss233_a_deeply_nested_json_body_is_a_clean_400", `qualname`: "test_iss233_a_deeply_nested_json_body_is_a_clean_400", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 984, `end_line`: 1007, `signature`: "def test_iss233_a_deeply_nested_json_body_is_a_clean_400(make_server):", `docstring`: "Issue 233: `json.loads` raises RecursionError, which is not a ValueError.\n\n    ~40 KB of nesting is well inside MAX_BODY_BYTES, and this runs before\n    `authenticate()`, so any caller that can reach POST /mcp could kill a\n    handler thread outright on a server that is otherwise fully locked down.", `entrypoint`: true, `reach`: 14};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::test_iss243_a_crlf_in_the_oidc_issuer_cannot_inject_a_response_header"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss243_a_crlf_in_the_oidc_issuer_cannot_inject_a_response_header", `name`: "test_iss243_a_crlf_in_the_oidc_issuer_cannot_inject_a_response_header", `qualname`: "test_iss243_a_crlf_in_the_oidc_issuer_cannot_inject_a_response_header", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1010, `end_line`: 1033, `signature`: "def test_iss243_a_crlf_in_the_oidc_issuer_cannot_inject_a_response_header(make_server):", `docstring`: "Issue 243: `_challenge()` interpolates oidc_issuer into WWW-Authenticate.\n\n    Operator-supplied, so not remotely exploitable -- but the module states a\n    rule for header values and this path did not follow it. The fix is\n    structural: `_send_json` sanitises every extra header, so the rule holds\n    for call sites nobody has written yet.", `entrypoint`: true, `reach`: 16};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::test_iss249_a_chunked_request_body_is_refused_with_411"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss249_a_chunked_request_body_is_refused_with_411", `name`: "test_iss249_a_chunked_request_body_is_refused_with_411", `qualname`: "test_iss249_a_chunked_request_body_is_refused_with_411", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1036, `end_line`: 1057, `signature`: "def test_iss249_a_chunked_request_body_is_refused_with_411(make_server):", `docstring`: "Issue 249: Content-Length is the only framing `_read_body` understands.\n\n    A chunked body measured as zero bytes was never read, so a spec-legal\n    client got \"expected a JSON-RPC object\" and a socket still holding its\n    request. Refusing the encoding by name says what is actually wrong.", `entrypoint`: true, `reach`: 14};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::test_iss249_the_handler_pins_its_protocol_version_deliberately"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_iss249_the_handler_pins_its_protocol_version_deliberately", `name`: "test_iss249_the_handler_pins_its_protocol_version_deliberately", `qualname`: "test_iss249_the_handler_pins_its_protocol_version_deliberately", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1060, `end_line`: 1072, `signature`: "def test_iss249_the_handler_pins_its_protocol_version_deliberately():", `docstring`: "Issue 249: HTTP/1.0 here is a decision, not an inheritance.\n\n    It is also the base class's default, so only the presence of the attribute\n    on this class distinguishes \"chosen\" from \"never thought about\" -- and the\n    choice is what keeps an unread request body (a refused Transfer-Encoding, a\n    413'd Content-Length, a read that timed out part-way) from being left in a\n    socket that the next request would be parsed out of.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::test_missing_index_without_repo_returns_503_actionable_error"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_missing_index_without_repo_returns_503_actionable_error", `name`: "test_missing_index_without_repo_returns_503_actionable_error", `qualname`: "test_missing_index_without_repo_returns_503_actionable_error", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1075, `end_line`: 1102, `signature`: "def test_missing_index_without_repo_returns_503_actionable_error(tmp_path):", `docstring`: "When no index exists and auto-build is off, HTTP mode returns 503 with instructions (#265).", `entrypoint`: true, `reach`: 37};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::test_a_missing_index_does_not_tell_the_caller_where_it_looked"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_a_missing_index_does_not_tell_the_caller_where_it_looked", `name`: "test_a_missing_index_does_not_tell_the_caller_where_it_looked", `qualname`: "test_a_missing_index_does_not_tell_the_caller_where_it_looked", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 1108, `end_line`: 1148, `signature`: "def test_a_missing_index_does_not_tell_the_caller_where_it_looked(tmp_path):", `docstring`: "503 must not carry the host's filesystem layout.\n\n    `open_index` raises SystemExit with a message written for an operator at a\n    terminal, naming the absolute index directory twice. Relaying str(exc) put\n    that in a JSON-RPC error -- and therefore into the context window of any\n    agent driving this server -- which is the disclosure `_public_repo_label`\n    already refuses one endpoint over. The operator's detail belongs in the\n    audit log, which is server-side.", `entrypoint`: true, `reach`: 45};
