MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::property_root"}) SET n += {`id`: "sym:tests/test_properties.py::property_root", `name`: "property_root", `qualname`: "property_root", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 165, `end_line`: 191, `signature`: "def property_root(tmp_path_factory):", `docstring`: "A read-only repo tree for the `explain_path` containment properties.\n\n    Session scoped deliberately: `explain_path` only ever stats, so there is no\n    per-example state to reset, and a function-scoped `tmp_path` would be rebuilt\n    once per *test* while Hypothesis reused it across 100 examples anyway.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_decoding_arbitrary_bytes_never_raises_and_never_moves_a_line_boundary"}) SET n += {`id`: "sym:tests/test_properties.py::test_decoding_arbitrary_bytes_never_raises_and_never_moves_a_line_boundary", `name`: "test_decoding_arbitrary_bytes_never_raises_and_never_moves_a_line_boundary", `qualname`: "test_decoding_arbitrary_bytes_never_raises_and_never_moves_a_line_boundary", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 198, `end_line`: 217, `signature`: "def test_decoding_arbitrary_bytes_never_raises_and_never_moves_a_line_boundary(raw):", `docstring`: "Detects a decode that invents or swallows a newline, desyncing every citation.\n\n    `graph._chunk_and_parse` counts newlines on the *raw bytes* (`newlines +=\n    chunk.count(b\"\\\\n\")`) and then hands the *decoded text* to the parser, whose\n    rows are what every `start_line`/`end_line` in nodes.jsonl is built from. If\n    those two counts can ever disagree -- a replacement character that is a\n    newline, a stray 0x0A consumed as part of a multi-byte sequence -- every\n    symbol below that point is cited at the wrong line and nothing in the\n    pipeline notices.\n\n    An example test can only a", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_the_carried_utf8_tail_is_bounded_and_never_holds_a_newline"}) SET n += {`id`: "sym:tests/test_properties.py::test_the_carried_utf8_tail_is_bounded_and_never_holds_a_newline", `name`: "test_the_carried_utf8_tail_is_bounded_and_never_holds_a_newline", `qualname`: "test_the_carried_utf8_tail_is_bounded_and_never_holds_a_newline", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 221, `end_line`: 240, `signature`: "def test_the_carried_utf8_tail_is_bounded_and_never_holds_a_newline(raw):", `docstring`: "Detects a carry that would double-count a line across a slice boundary.\n\n    `_incomplete_utf8_tail`'s docstring promises two things the caller depends\n    on and neither is checked anywhere else: the carry is at most three bytes\n    (the longest truncated prefix of a four-byte sequence), and it \"never\n    [contains] a newline ... so `line_offset` accounting is unaffected\". If a\n    newline could ride along in the carry it would be counted once in the slice\n    that produced it and again in the slice that consumed it, shifting\n    `line_offset` -- and so every symbol in a chunked file -- by on", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_carrying_the_utf8_tail_across_a_slice_boundary_loses_no_characters"}) SET n += {`id`: "sym:tests/test_properties.py::test_carrying_the_utf8_tail_across_a_slice_boundary_loses_no_characters", `name`: "test_carrying_the_utf8_tail_across_a_slice_boundary_loses_no_characters", `qualname`: "test_carrying_the_utf8_tail_across_a_slice_boundary_loses_no_characters", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 244, `end_line`: 265, `signature`: "def test_carrying_the_utf8_tail_across_a_slice_boundary_loses_no_characters(text, cut):", `docstring`: "Detects the two-slices-both-dropped bug `_incomplete_utf8_tail` exists to fix.\n\n    Slices are cut at raw byte offsets, so a multi-byte character straddles the\n    boundary: its lead byte ends slice N and its continuations begin slice N+1.\n    Before the carry, *both* slices failed to decode and both were discarded --\n    up to 2 x max_file_bytes of source lost silently. The property is that\n    re-splitting at the carry-adjusted offset reproduces the original text\n    exactly, for every cut point in every string.\n\n    An example can only pick one cut point in one string, and the cut points\n  ", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_encodable_output_is_writable_for_arbitrary_text"}) SET n += {`id`: "sym:tests/test_properties.py::test_encodable_output_is_writable_for_arbitrary_text", `name`: "test_encodable_output_is_writable_for_arbitrary_text", `qualname`: "test_encodable_output_is_writable_for_arbitrary_text", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 273, `end_line`: 287, `signature`: "def test_encodable_output_is_writable_for_arbitrary_text(text, encoding, errors):", `docstring`: "Detects a guard that lets an unrepresentable character reach a strict stream.\n\n    `tests/test_encoding.py` runs this cross product over five hand-picked\n    characters. Those five were each added after a crash report, which is the\n    tell: the matrix covers the failures that already happened. Hypothesis\n    covers the ones that have not, including strings mixing a lone surrogate\n    with U+2028 and CJK in one line -- the combination no reporter has sent in\n    yet and the one where `encodable`'s encode/decode round trip is most likely\n    to produce something the codec still refuses.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_lines_counts_rows_exactly_the_way_tree_sitter_does"}) SET n += {`id`: "sym:tests/test_properties.py::test_lines_counts_rows_exactly_the_way_tree_sitter_does", `name`: "test_lines_counts_rows_exactly_the_way_tree_sitter_does", `qualname`: "test_lines_counts_rows_exactly_the_way_tree_sitter_does", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 294, `end_line`: 312, `signature`: "def test_lines_counts_rows_exactly_the_way_tree_sitter_does(src):", `docstring`: "Detects a reintroduced `splitlines()` in the one helper that must not use it.\n\n    CONTRIBUTING invariant 1: tree-sitter advances `Point.row` strictly on\n    \"\\\\n\", so `_lines` must too. The property that pins it is arithmetic rather\n    than exemplary -- the row count is always `src.count(\"\\\\n\") + 1`, never\n    anything derived from the characters in between -- and the second assertion\n    states the failure mode directly: a source with no \"\\\\n\" at all is one line,\n    however many U+2028s or form feeds it contains.\n\n    An example only detects a `splitlines()` regression if its fixture happe", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_keepends_lf_is_lossless_and_breaks_only_on_lf"}) SET n += {`id`: "sym:tests/test_properties.py::test_keepends_lf_is_lossless_and_breaks_only_on_lf", `name`: "test_keepends_lf_is_lossless_and_breaks_only_on_lf", `qualname`: "test_keepends_lf_is_lossless_and_breaks_only_on_lf", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 316, `end_line`: 335, `signature`: "def test_keepends_lf_is_lossless_and_breaks_only_on_lf(text):", `docstring`: "Detects a lossy chunk split -- source text silently dropped from an artifact.\n\n    `_split` rebuilds every chunk by joining `_keepends_lf` output, so\n    `\"\".join(_keepends_lf(t)) == t` is the invariant that stands between the\n    chunker and quietly losing a line of the user's code. It is stated in the\n    docstring and was never tested against anything but LF-only ASCII.\n\n    The exotic break characters matter here for a second reason beyond line\n    numbering: `splitlines(keepends=True)` would make a chunk's *pieces* depend\n    on whichever stray separators the source happens to hold, so th", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_a_one_indexed_inclusive_line_slice_round_trips"}) SET n += {`id`: "sym:tests/test_properties.py::test_a_one_indexed_inclusive_line_slice_round_trips", `name`: "test_a_one_indexed_inclusive_line_slice_round_trips", `qualname`: "test_a_one_indexed_inclusive_line_slice_round_trips", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 339, `end_line`: 366, `signature`: "def test_a_one_indexed_inclusive_line_slice_round_trips(src, data):", `docstring`: "Detects an off-by-one in the `[start_line, end_line]` slice every chunk uses.\n\n    `chunks.iter_chunks` cuts a symbol body with\n    `\"\\\\n\".join(lines[start_line - 1 : end_line])` -- 1-indexed, inclusive at\n    both ends. The property is that the slice re-splits into exactly the lines\n    it was cut from and into exactly `end - start + 1` of them, for every valid\n    range in every text. A fixture with a 3-line function and a hand-counted\n    expectation tests one range; the boundary cases (a single line, the first\n    line, the last line, a range ending on a trailing empty line) are where the\n", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_split_covers_every_line_with_overlap_and_no_gap"}) SET n += {`id`: "sym:tests/test_properties.py::test_split_covers_every_line_with_overlap_and_no_gap", `name`: "test_split_covers_every_line_with_overlap_and_no_gap", `qualname`: "test_split_covers_every_line_with_overlap_and_no_gap", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 373, `end_line`: 407, `signature`: "def test_split_covers_every_line_with_overlap_and_no_gap(fillers, max_chars):", `docstring`: "Detects a line dropped between two chunk slices, or a slicer that never ends.\n\n    `_split`'s packer rewinds by `OVERLAP_LINES` between slices\n    (`i = max(start + 1, i - OVERLAP_LINES)`). That one expression has to do two\n    incompatible things at once: rewind far enough to overlap, and still\n    guarantee forward progress when a slice held fewer lines than the overlap.\n    Get it wrong one way and a line vanishes from every artifact; get it wrong\n    the other and the loop never terminates.\n\n    Each generated line is prefixed with its own index, so a slice can be mapped\n    back to the li", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_split_bounds_a_line_that_cannot_be_split_on_a_line_boundary"}) SET n += {`id`: "sym:tests/test_properties.py::test_split_bounds_a_line_that_cannot_be_split_on_a_line_boundary", `name`: "test_split_bounds_a_line_that_cannot_be_split_on_a_line_boundary", `qualname`: "test_split_bounds_a_line_that_cannot_be_split_on_a_line_boundary", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 415, `end_line`: 437, `signature`: "def test_split_bounds_a_line_that_cannot_be_split_on_a_line_boundary(\n    prefix_lines, blob_len, max_chars\n):", `docstring`: "Detects an unbounded chunk from minified JS, base64 or one-line JSON.\n\n    A single line longer than `max_chars` cannot be shrunk by grouping on line\n    boundaries, so `_split` pre-breaks it into `max_chars`-sized pieces. Without\n    that step the packer emits the whole line as one slice, unbounded -- the\n    retrieval budget is then silently exceeded by a chunk nobody can page past.\n\n    The two halves of the guarantee are tested together because they trade off:\n    bounding every slice is easy if you are allowed to lose characters, and\n    keeping every character is easy if you are allowed ", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_redaction_never_changes_the_line_count"}) SET n += {`id`: "sym:tests/test_properties.py::test_redaction_never_changes_the_line_count", `name`: "test_redaction_never_changes_the_line_count", `qualname`: "test_redaction_never_changes_the_line_count", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 441, `end_line`: 463, `signature`: "def test_redaction_never_changes_the_line_count(chosen):", `docstring`: "Detects redaction that shifts every citation below a secret.\n\n    `chunks.iter_chunks` scans and redacts the whole body *before* splitting,\n    and its comment states the reason that is safe: \"Redaction is\n    line-preserving, so splitting afterwards keeps every citation line number\n    intact.\" `redact_content` implements that by re-appending `text.count(\"\\\\n\",\n    start, end)` newlines to each replacement. If a single span ever lost or\n    gained one, every `[cite: path:start-end]` below it in the file would point\n    at the wrong code, and the citation would still look well-formed.\n\n    Exa", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_redaction_of_arbitrary_text_preserves_the_line_count"}) SET n += {`id`: "sym:tests/test_properties.py::test_redaction_of_arbitrary_text_preserves_the_line_count", `name`: "test_redaction_of_arbitrary_text_preserves_the_line_count", `qualname`: "test_redaction_of_arbitrary_text_preserves_the_line_count", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 467, `end_line`: 476, `signature`: "def test_redaction_of_arbitrary_text_preserves_the_line_count(text):", `docstring`: "Same invariant, but over text whose line breaks are the exotic ones.\n\n    Split out from the generated-secrets test because it fails differently: here\n    the risk is not the newline arithmetic inside a span but a scanner regex\n    that treats U+2028 as a line terminator while `_lines` does not, so the two\n    disagree about which line a finding is on.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_a_non_redacting_policy_returns_the_text_untouched"}) SET n += {`id`: "sym:tests/test_properties.py::test_a_non_redacting_policy_returns_the_text_untouched", `name`: "test_a_non_redacting_policy_returns_the_text_untouched", `qualname`: "test_a_non_redacting_policy_returns_the_text_untouched", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 480, `end_line`: 489, `signature`: "def test_a_non_redacting_policy_returns_the_text_untouched(text, policy):", `docstring`: "Detects a policy switch that quietly rewrites text it was told to leave alone.\n\n    `off` and `warn-only` exist so an operator can index a tree verbatim; a\n    single mangled character under those policies is a silent corruption of the\n    artifact rather than a visible refusal.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_secret_path_detection_is_separator_invariant"}) SET n += {`id`: "sym:tests/test_properties.py::test_secret_path_detection_is_separator_invariant", `name`: "test_secret_path_detection_is_separator_invariant", `qualname`: "test_secret_path_detection_is_separator_invariant", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 500, `end_line`: 516, `signature`: "def test_secret_path_detection_is_separator_invariant(parts, sep, lead):", `docstring`: "Detects a Windows-spelled path that dodges the secret-file refusal.\n\n    `_is_secret_path` is the gate that keeps `.env`, `*.pem` and `secrets/` out\n    of an index, and it normalizes with `str(path).replace(\"\\\\\\\\\", \"/\")` before\n    deciding. If any later comparison in that function is made against the\n    un-normalized string, the same file is refused when written `secrets/db.key`\n    and indexed when written `secrets\\\\db.key` -- a credential in chunks.jsonl,\n    reachable from every MCP tool, on exactly one platform.\n\n    Example tests spell their fixtures with forward slashes because that i", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_secret_path_detection_is_idempotent_under_renormalization"}) SET n += {`id`: "sym:tests/test_properties.py::test_secret_path_detection_is_idempotent_under_renormalization", `name`: "test_secret_path_detection_is_idempotent_under_renormalization", `qualname`: "test_secret_path_detection_is_idempotent_under_renormalization", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 524, `end_line`: 543, `signature`: "def test_secret_path_detection_is_idempotent_under_renormalization(parts, sep, lead):", `docstring`: "Detects a verdict that depends on how many times a path has been normalized.\n\n    Paths reach this function from several directions -- `parse.discover` hands\n    it `rel.as_posix()`, the MCP `repo_read` path hands it a caller-supplied\n    string it has already slash-normalized itself -- so the same file is checked\n    in more than one spelling within a single request. Normalizing again must\n    not change the answer; if it does, which spelling arrived first decides\n    whether a secret is served.\n\n    This is the `normalize(normalize(p)) == normalize(p)` property stated at the\n    level that m", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_secret_path_detection_is_case_invariant"}) SET n += {`id`: "sym:tests/test_properties.py::test_secret_path_detection_is_case_invariant", `name`: "test_secret_path_detection_is_case_invariant", `qualname`: "test_secret_path_detection_is_case_invariant", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 547, `end_line`: 559, `signature`: "def test_secret_path_detection_is_case_invariant(parts):", `docstring`: "Detects a case-sensitive comparison in a check that claims to lowercase.\n\n    Windows and macOS filesystems are case-insensitive by default, so `.ENV` and\n    `.env` are the same file. `_is_secret_path` lowercases up front for exactly\n    that reason, and the risk is a later branch comparing against the original.\n    `appsettings.Production.json` is in the segment pool on purpose: it is\n    matched by a regex rather than by an exact name, which is the branch most\n    likely to be written against the un-lowercased text.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_test_path_detection_is_separator_invariant"}) SET n += {`id`: "sym:tests/test_properties.py::test_test_path_detection_is_separator_invariant", `name`: "test_test_path_detection_is_separator_invariant", `qualname`: "test_test_path_detection_is_separator_invariant", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 563, `end_line`: 577, `signature`: "def test_test_path_detection_is_separator_invariant(parts, sep):", `docstring`: "Detects `latest.py` being re-classified as a test, or a test file missed.\n\n    `is_test_path`'s docstring records the bug it was written to fix: a suffix\n    match on `\"test.py\"` classified `latest.py`, `fastest.py` and `manifest.py`\n    as tests, which excluded them from `is_public_symbol` and credited them as\n    their own coverage. The fix matches per path *component*, which makes the\n    function depend entirely on splitting the path correctly -- so the separator\n    spelling is now load-bearing, and both spellings reach it (`impact` reads\n    paths from a diff, which on Windows can carry ", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_explain_path_never_reports_an_escaping_path_as_included"}) SET n += {`id`: "sym:tests/test_properties.py::test_explain_path_never_reports_an_escaping_path_as_included", `name`: "test_explain_path_never_reports_an_escaping_path_as_included", `qualname`: "test_explain_path_never_reports_an_escaping_path_as_included", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 584, `end_line`: 613, `signature`: "def test_explain_path_never_reports_an_escaping_path_as_included(parts, sep, property_root):", `docstring`: "Detects a `..` that walks out of the repo and still answers INCLUDED.\n\n    `explain_path` is the documented answer to \"would repo2graph index this\n    file\", and `repo2graph explain-path` feeds it whatever the user typed. It\n    resolves the *parent* only (so a leaf symlink is still rejected by\n    `discover`'s lstat) and relies on `relative_to(root)` to catch everything\n    else. The property is the one that makes it a boundary rather than a\n    convenience: if the verdict is INCLUDED, the reported relative path must not\n    be absolute, and must still land under the root once resolved.\n\n    ", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_explain_path_verdict_is_idempotent_on_its_own_output"}) SET n += {`id`: "sym:tests/test_properties.py::test_explain_path_verdict_is_idempotent_on_its_own_output", `name`: "test_explain_path_verdict_is_idempotent_on_its_own_output", `qualname`: "test_explain_path_verdict_is_idempotent_on_its_own_output", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 617, `end_line`: 632, `signature`: "def test_explain_path_verdict_is_idempotent_on_its_own_output(parts, property_root):", `docstring`: "Detects a normalizer whose output it would itself answer differently about.\n\n    `explain_path` returns `relative_path` as the canonical spelling of what it\n    was asked about. Feeding that back in has to produce the same verdict and\n    the same rule, or the CLI's own output is not a valid input to the CLI --\n    which is how a user reports \"it says excluded, but when I paste the path it\n    says included\".\n\n    This is `normalize(normalize(p)) == normalize(p)` for the one function in\n    the codebase that publishes its normalized form.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_a_trailing_dotdot_cannot_launder_an_excluded_path"}) SET n += {`id`: "sym:tests/test_properties.py::test_a_trailing_dotdot_cannot_launder_an_excluded_path", `name`: "test_a_trailing_dotdot_cannot_launder_an_excluded_path", `qualname`: "test_a_trailing_dotdot_cannot_launder_an_excluded_path", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 660, `end_line`: 679, `signature`: "def test_a_trailing_dotdot_cannot_launder_an_excluded_path(excluded, filler, property_root):", `docstring`: "Detects an exclusion rule defeated by respelling the path.\n\n    The verdict `explain_path` gives for a file must not depend on which of the\n    infinitely many spellings of that file the caller typed. `F`, `F/x/..` and\n    `F/x/y/../..` all name `F`, so all three must get `F`'s answer -- otherwise\n    the rule that refuses to index credentials is advisory rather than binding,\n    and the function that exists to explain the rules misreports them.\n\n    Hand-written examples missed this for the ordinary reason: they spell paths\n    the way the rest of the codebase produces them (`rel.as_posix()` ", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_parse_spec_never_yields_a_component_that_escapes_the_clone_directory"}) SET n += {`id`: "sym:tests/test_properties.py::test_parse_spec_never_yields_a_component_that_escapes_the_clone_directory", `name`: "test_parse_spec_never_yields_a_component_that_escapes_the_clone_directory", `qualname`: "test_parse_spec_never_yields_a_component_that_escapes_the_clone_directory", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 701, `end_line`: 726, `signature`: "def test_parse_spec_never_yields_a_component_that_escapes_the_clone_directory(spec):", `docstring`: "Detects a repo spec that makes `git clone` write outside its temp directory.\n\n    `fetch.parse_spec` feeds `owner` and `repo` straight into a clone\n    destination and into a `git` argv, so a component of `..` targets the parent\n    of the temp dir and a component starting with `-` is read by git as an\n    option. The function's own comment names both. The property asserts the\n    consequence rather than the implementation: whatever comes back, joining it\n    under a base directory and normalizing must stay under that base, and\n    neither component may be option-shaped.\n\n    A validator built", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_parse_ref_never_yields_a_ref_git_would_read_as_an_option"}) SET n += {`id`: "sym:tests/test_properties.py::test_parse_ref_never_yields_a_ref_git_would_read_as_an_option", `name`: "test_parse_ref_never_yields_a_ref_git_would_read_as_an_option", `qualname`: "test_parse_ref_never_yields_a_ref_git_would_read_as_an_option", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 747, `end_line`: 766, `signature`: "def test_parse_ref_never_yields_a_ref_git_would_read_as_an_option(ref):", `docstring`: "Detects a refname that smuggles a flag or a traversal into a `git` argv.\n\n    `parse_ref`'s comment is explicit that the pattern is \"a security check and\n    not just a spelling check\", and names the exact hazards: a leading `-`, a\n    dotted traversal component, a trailing newline that a `$`-anchored pattern\n    would have let through. Each of those was a separate hand-written example.\n    The property covers them as one statement -- whatever is returned contains\n    no `..`, no separator-adjacent dot component, no whitespace and no leading\n    dash -- and keeps covering the ones not yet thou", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_max_chars_default_is_what_the_split_properties_assume"}) SET n += {`id`: "sym:tests/test_properties.py::test_max_chars_default_is_what_the_split_properties_assume", `name`: "test_max_chars_default_is_what_the_split_properties_assume", `qualname`: "test_max_chars_default_is_what_the_split_properties_assume", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 769, `end_line`: 777, `signature`: "def test_max_chars_default_is_what_the_split_properties_assume():", `docstring`: "A guard so the generated `max_chars` range stays below the real default.\n\n    The `_split` properties drive `max_chars` between 24 and 120 to keep the\n    examples small. If `MAX_CHARS` ever drops into that range the production\n    default would be inside the generated band rather than above it, and the\n    properties would stop saying anything about the shipped configuration.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_clean_identifier_is_capped_single_line_and_free_of_hidden_chars"}) SET n += {`id`: "sym:tests/test_properties.py::test_clean_identifier_is_capped_single_line_and_free_of_hidden_chars", `name`: "test_clean_identifier_is_capped_single_line_and_free_of_hidden_chars", `qualname`: "test_clean_identifier_is_capped_single_line_and_free_of_hidden_chars", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 789, `end_line`: 804, `signature`: "def test_clean_identifier_is_capped_single_line_and_free_of_hidden_chars(name):", `docstring`: "Whatever a hostile repository names a symbol, the cleaned name fits the\n    cap, cannot break a line or a header, and carries no invisible override.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_escape_hidden_unicode_round_trips_through_json"}) SET n += {`id`: "sym:tests/test_properties.py::test_escape_hidden_unicode_round_trips_through_json", `name`: "test_escape_hidden_unicode_round_trips_through_json", `qualname`: "test_escape_hidden_unicode_round_trips_through_json", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 808, `end_line`: 816, `signature`: "def test_escape_hidden_unicode_round_trips_through_json(text):", `docstring`: "The JSONL escape is lossless: the reader gets back exactly what was there.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::test_strip_cpp_includes_leaves_no_file_opening_directive"}) SET n += {`id`: "sym:tests/test_properties.py::test_strip_cpp_includes_leaves_no_file_opening_directive", `name`: "test_strip_cpp_includes_leaves_no_file_opening_directive", `qualname`: "test_strip_cpp_includes_leaves_no_file_opening_directive", `kind`: "function", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 829, `end_line`: 845, `signature`: "def test_strip_cpp_includes_leaves_no_file_opening_directive(lines, filler):", `docstring`: "No spelling cpp accepts for a file-opening directive survives the strip,\n    and ordinary lines (including a comment that says \"include\") are kept.", `entrypoint`: true};
