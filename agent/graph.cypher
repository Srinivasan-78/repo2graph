MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cli.py::_explain_index_dir"}) SET n += {`id`: "sym:repo2graph/cli.py::_explain_index_dir", `name`: "_explain_index_dir", `qualname`: "_explain_index_dir", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 854, `end_line`: 884, `signature`: "def _explain_index_dir(repo: Path, rel: str, out: str | None) -> dict | None:", `docstring`: "The rule discover() applies *first*: never index a repo2graph output dir.\n\n    `explain_path` does not model it, so `explain-path .r2g/agent/nodes.jsonl`\n    answered INCLUDED for a file no build ever indexes. Two shapes, checked in\n    discover()'s order: the `-o` directory this build would write to, and any\n    directory holding a repo2graph `agent/manifest.json` (an earlier build)."};
