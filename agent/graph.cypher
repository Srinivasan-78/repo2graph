MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_ai_ledger_round_trip_and_hostile_input"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_ai_ledger_round_trip_and_hostile_input", `name`: "test_ai_ledger_round_trip_and_hostile_input", `qualname`: "test_ai_ledger_round_trip_and_hostile_input", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 536, `end_line`: 578, `signature`: "def test_ai_ledger_round_trip_and_hostile_input():", `docstring`: "Per-PR spend survives a comment rewrite and degrades to zero, never up.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_ai_ledger_round_trip_and_hostile_input.parse_ledger"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_ai_ledger_round_trip_and_hostile_input.parse_ledger", `name`: "parse_ledger", `qualname`: "test_ai_ledger_round_trip_and_hostile_input.parse_ledger", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 548, `end_line`: 564, `signature`: "def parse_ledger(body):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_ai_ledger_round_trip_and_hostile_input.parse_ledger.clean"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_ai_ledger_round_trip_and_hostile_input.parse_ledger.clean", `name`: "clean", `qualname`: "test_ai_ledger_round_trip_and_hostile_input.parse_ledger.clean", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 559, `end_line`: 562, `signature`: "def clean(v):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::_sanitize_model"}) SET n += {`id`: "sym:tests/test_prod_igy.py::_sanitize_model", `name`: "_sanitize_model", `qualname`: "_sanitize_model", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 584, `end_line`: 603, `signature`: "def _sanitize_model(text, max_chars=4000):", `docstring`: "Python model of prod-igy.js `sanitizeAiText`, rule for rule, in order.\n\n    The tests below pin each JS line verbatim *and* exercise this model, so a\n    rule deleted from the JS fails a pin and a rule that stops working fails\n    the behaviour. Keep the two in step.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_ai_text_cannot_forge_a_marker_or_a_mention"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_ai_text_cannot_forge_a_marker_or_a_mention", `name`: "test_ai_text_cannot_forge_a_marker_or_a_mention", `qualname`: "test_ai_text_cannot_forge_a_marker_or_a_mention", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 606, `end_line`: 648, `signature`: "def test_ai_text_cannot_forge_a_marker_or_a_mention():", `docstring`: "Model output is contributor-derived and rendered under the bot identity.\n\n    Two concrete failures this prevents:\n      - a second BOT_MARKER in the prose makes `comments.find()` return the\n        model's text forever, so prod-igy never finds its real comment again;\n      - a mention pings a real account from an App that holds issues:write.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_ai_text_strips_markdown_images_and_links"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_ai_text_strips_markdown_images_and_links", `name`: "test_ai_text_strips_markdown_images_and_links", `qualname`: "test_ai_text_strips_markdown_images_and_links", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 651, `end_line`: 722, `signature`: "def test_ai_text_strips_markdown_images_and_links():", `docstring`: "#373: markdown image/link syntax must not survive into the comment.\n\n    `![](url)` is fetched server-side by GitHub's camo proxy the moment the\n    comment renders -- a request to an attacker-controlled host that confirms\n    the workflow ran and when. `[text](url)`, a reference-style `[label]: url`\n    definition, an autolink, and an HTML `<img>` are all the same\n    reviewer-phishing primitive under a trusted bot identity. Adversarial\n    inputs: reference-style links, nested brackets, `![]()`, autolinks, HTML\n    `<img>`, and a URL that smuggles a token in its query string.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_ai_text_neutralises_protocol_relative_and_entity_encoded_links"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_ai_text_neutralises_protocol_relative_and_entity_encoded_links", `name`: "test_ai_text_neutralises_protocol_relative_and_entity_encoded_links", `qualname`: "test_ai_text_neutralises_protocol_relative_and_entity_encoded_links", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 725, `end_line`: 761, `signature`: "def test_ai_text_neutralises_protocol_relative_and_entity_encoded_links():", `docstring`: "Audit round 1: three forms the https-only / tag-allowlist rules missed.\n\n    - `<a href=\"//evil.example/login\">`: raw HTML with a protocol-relative URL;\n    - `[r]: //evil.example/x`: a reference definition with no scheme at all;\n    - `<a href=\"HTTPS&#58;//evil.example\">`: the scheme's colon as an entity,\n      which the renderer decodes *after* any regex has looked at the text.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_summary_step_does_exactly_two_things"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_summary_step_does_exactly_two_things", `name`: "test_summary_step_does_exactly_two_things", `qualname`: "test_summary_step_does_exactly_two_things", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 764, `end_line`: 796, `signature`: "def test_summary_step_does_exactly_two_things():", `docstring`: "The schema is the whole contract, and it has two fields.\n\n    Labels stay path- and size-derived: `detectType`, `detectAreas` and\n    `calculateSize` are exact, and a model guess that contradicted them would\n    make a label mean \"computed\" on some PRs and \"guessed\" on others with\n    nothing in the comment to say which. Review, risk assessment and anything\n    requiring knowledge of code outside the diff are out of scope by\n    construction -- there is no field to put them in.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_summary_step_is_not_shown_the_codebase"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_summary_step_is_not_shown_the_codebase", `name`: "test_summary_step_is_not_shown_the_codebase", `qualname`: "test_summary_step_is_not_shown_the_codebase", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 799, `end_line`: 826, `signature`: "def test_summary_step_is_not_shown_the_codebase():", `docstring`: "It sees one diff. It is not given repository rules or any other file.\n\n    Feeding CONTRIBUTING.md (or any repo content) to the model is what turns a\n    description into a review, which is the thing this bot deliberately does\n    not do. The rule checklist in the comment stays where it was: derived from\n    changed paths by `checkRepositoryInvariants`, with no model involved.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_check_results_come_from_the_api_not_the_model"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_check_results_come_from_the_api_not_the_model", `name`: "test_check_results_come_from_the_api_not_the_model", `qualname`: "test_check_results_come_from_the_api_not_the_model", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 829, `end_line`: 877, `signature`: "def test_check_results_come_from_the_api_not_the_model():", `docstring`: "\"What tests passed\" must be read, never guessed.\n\n    A model asked to comment on tests would answer from the diff, which says\n    nothing about whether CI actually ran. The counts come from\n    `checks.listForRef` on the PR head, and the model is told to stay off the\n    subject so its prose cannot contradict them.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_check_results_come_from_the_api_not_the_model.bucket"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_check_results_come_from_the_api_not_the_model.bucket", `name`: "bucket", `qualname`: "test_check_results_come_from_the_api_not_the_model.bucket", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 861, `end_line`: 868, `signature`: "def bucket(status, conclusion):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_ai_caps_are_checked_before_the_call"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_ai_caps_are_checked_before_the_call", `name`: "test_ai_caps_are_checked_before_the_call", `qualname`: "test_ai_caps_are_checked_before_the_call", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 880, `end_line`: 903, `signature`: "def test_ai_caps_are_checked_before_the_call():", `docstring`: "Both ceilings gate the request, not the bookkeeping after it.\n\n    `synchronize` fires on every push, so without a run cap a force-push loop\n    is an unbounded bill. A cap checked after the call bounds nothing.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_ai_failure_falls_back_to_the_pre_ai_behaviour"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_ai_failure_falls_back_to_the_pre_ai_behaviour", `name`: "test_ai_failure_falls_back_to_the_pre_ai_behaviour", `qualname`: "test_ai_failure_falls_back_to_the_pre_ai_behaviour", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 906, `end_line`: 950, `signature`: "def test_ai_failure_falls_back_to_the_pre_ai_behaviour():", `docstring`: "Every failure mode returns `{ai: null, reason}` -- none of them throws.\n\n    prod-igy worked before the AI step existed and must keep working when the\n    model is unreachable, the key is revoked, or the SDK never installed. This\n    is the same zero-dependency floor the rest of the repo keeps (BM25 under\n    vectors, inline rules under AGENTS.md).", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_ai_workflow_survives_a_registry_outage"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_ai_workflow_survives_a_registry_outage", `name`: "test_ai_workflow_survives_a_registry_outage", `qualname`: "test_ai_workflow_survives_a_registry_outage", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 953, `end_line`: 962, `signature`: "def test_ai_workflow_survives_a_registry_outage():", `docstring`: "A failed `npm install` must not fail the triage job.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_degraded_run_is_invisible_to_the_contributor"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_degraded_run_is_invisible_to_the_contributor", `name`: "test_degraded_run_is_invisible_to_the_contributor", `qualname`: "test_degraded_run_is_invisible_to_the_contributor", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 965, `end_line`: 991, `signature`: "def test_degraded_run_is_invisible_to_the_contributor():", `docstring`: "With no summary, the comment is the ordinary inspection and says nothing.\n\n    The degraded path must not announce itself. A contributor reading a PR\n    where the summary could not be produced sees exactly the comment prod-igy\n    posted before the summary section existed -- no banner, no apology, no\n    reference to anything having been skipped. The reason is recorded for the\n    maintainer in the run log instead.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_comment_never_discloses_how_the_summary_is_produced"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_comment_never_discloses_how_the_summary_is_produced", `name`: "test_comment_never_discloses_how_the_summary_is_produced", `qualname`: "test_comment_never_discloses_how_the_summary_is_produced", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 994, `end_line`: 1024, `signature`: "def test_comment_never_discloses_how_the_summary_is_produced():", `docstring`: "No machine-provenance language reaches a contributor-visible string.\n\n    The comment carries prod-igy's bot identity in its heading and that is the\n    whole of the disclosure. Naming a model, a confidence score, or a fallback\n    in the prose makes the comment worse to read and is not what the heading\n    already communicates.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_summary_routes_back_to_the_reviewer"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_summary_routes_back_to_the_reviewer", `name`: "test_summary_routes_back_to_the_reviewer", `qualname`: "test_summary_routes_back_to_the_reviewer", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 1027, `end_line`: 1050, `signature`: "def test_summary_routes_back_to_the_reviewer():", `docstring`: "The summary section tags a human, and the title is suggested, not applied.\n\n    The cc is the buffer: every PR that gets a summary puts it in front of the\n    maintainer. It reads as an ordinary hand-off, which is all it needs to be.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_ai_prompt_frames_pr_text_as_data"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_ai_prompt_frames_pr_text_as_data", `name`: "test_ai_prompt_frames_pr_text_as_data", `qualname`: "test_ai_prompt_frames_pr_text_as_data", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 1053, `end_line`: 1074, `signature`: "def test_ai_prompt_frames_pr_text_as_data():", `docstring`: "The PR body and diff are contributor-controlled and reach the model.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_edited_does_not_retrigger_the_privileged_job"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_edited_does_not_retrigger_the_privileged_job", `name`: "test_edited_does_not_retrigger_the_privileged_job", `qualname`: "test_edited_does_not_retrigger_the_privileged_job", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 1077, `end_line`: 1089, `signature`: "def test_edited_does_not_retrigger_the_privileged_job():", `docstring`: "#374: `edited` fires whenever a PR's title or body changes -- which the\n    author (including a fork author) controls and can pull at will, against a\n    job holding pull-requests: write, issues: write and an API key. It must\n    not be in the trigger's `types:` list.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_app_token_probe_env_is_job_level_not_step_level"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_app_token_probe_env_is_job_level_not_step_level", `name`: "test_app_token_probe_env_is_job_level_not_step_level", `qualname`: "test_app_token_probe_env_is_job_level_not_step_level", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 1092, `end_line`: 1128, `signature`: "def test_app_token_probe_env_is_job_level_not_step_level():", `docstring`: "#375: the app-token step's `if:` used to read `env.HAS_APP_ID` /\n    `env.HAS_PRIVATE_KEY` from an `env:` block declared on that same step,\n    which works only if the step's own `env:` is guaranteed resolved before\n    its `if:` evaluates -- behaviour GitHub documents loosely. Promoting the\n    probes to job level removes the ordering question: every step's `if:`\n    reads the same job-level env the normal way.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_the_fallback_identity_is_logged"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_the_fallback_identity_is_logged", `name`: "test_the_fallback_identity_is_logged", `qualname`: "test_the_fallback_identity_is_logged", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 1131, `end_line`: 1138, `signature`: "def test_the_fallback_identity_is_logged():", `docstring`: "#375 (acceptance): the GITHUB_TOKEN fallback is no longer silent --\n    a run log line says which identity is posting.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_github_app_token_is_scoped_to_the_job_permissions"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_github_app_token_is_scoped_to_the_job_permissions", `name`: "test_github_app_token_is_scoped_to_the_job_permissions", `qualname`: "test_github_app_token_is_scoped_to_the_job_permissions", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 1141, `end_line`: 1169, `signature`: "def test_github_app_token_is_scoped_to_the_job_permissions():", `docstring`: "The app token must not inherit the App installation's full permission\n    grant: each `permission-<name>` input narrows it to something the job\n    actually does, and never to more than the job's own `permissions:` block.\n\n    `permission-issues` and `permission-checks` must NOT come back.\n    `permission-*` requests that exact set and the API answers 422 \"The\n    permissions requested are not granted to this installation\" when any one of\n    them is absent from the installation's grant -- so an extra entry mints\n    nothing at all rather than a slightly wider token, and the job silently falls", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_ai_diff_budget_is_per_file"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_ai_diff_budget_is_per_file", `name`: "test_ai_diff_budget_is_per_file", `qualname`: "test_ai_diff_budget_is_per_file", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 1172, `end_line`: 1188, `signature`: "def test_ai_diff_budget_is_per_file():", `docstring`: "One generated file must not consume the whole diff allowance.\n\n    Concatenate-then-truncate would let a single 50k-line lockfile or vendored\n    blob push every other file out of the context, so the model would summarise\n    a change it never saw.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_ai_diff_budget_is_per_file.per_file"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_ai_diff_budget_is_per_file.per_file", `name`: "per_file", `qualname`: "test_ai_diff_budget_is_per_file.per_file", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 1182, `end_line`: 1183, `signature`: "def per_file(diff_chars, n):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_zizmor_ignore_pins_still_point_at_what_they_suppress"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_zizmor_ignore_pins_still_point_at_what_they_suppress", `name`: "test_zizmor_ignore_pins_still_point_at_what_they_suppress", `qualname`: "test_zizmor_ignore_pins_still_point_at_what_they_suppress", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 1191, `end_line`: 1242, `signature`: "def test_zizmor_ignore_pins_still_point_at_what_they_suppress():", `docstring`: "`.github/zizmor.yml` suppresses findings by `file:line`.\n\n    Its own header says a shifted line number un-ignores the finding rather than\n    silently keeping it suppressed -- but the reverse is worse and just as quiet:\n    an edit above a pinned line slides the pin onto unrelated YAML, where it\n    suppresses whatever finding lands there next. Only zizmor itself can prove a\n    pin still matches, and zizmor is not a dependency of the pytest environment,\n    so this pins the *construct* each entry was written for.\n\n    The window is **per pin and tight**, which is the whole detector. An earli", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_existing_bot_comment_filters_on_bot_author"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_existing_bot_comment_filters_on_bot_author", `name`: "test_existing_bot_comment_filters_on_bot_author", `qualname`: "test_existing_bot_comment_filters_on_bot_author", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 1245, `end_line`: 1251, `signature`: "def test_existing_bot_comment_filters_on_bot_author():", `docstring`: "C3/C10: Comments matching BOT_MARKER are only treated as the bot's own\n    comment if authored by a bot, preventing commenters from forging spend caps.", `entrypoint`: true};
