MERGE (n:R2G:`Symbol` {id: "sym:tests/test_compat.py::test_embed_backend_casing_picks_the_right_extra"}) SET n += {`id`: "sym:tests/test_compat.py::test_embed_backend_casing_picks_the_right_extra", `name`: "test_embed_backend_casing_picks_the_right_extra", `qualname`: "test_embed_backend_casing_picks_the_right_extra", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 1424, `end_line`: 1458, `signature`: "def test_embed_backend_casing_picks_the_right_extra(tmp_path, backend):", `docstring`: "R-6 (b): `embed-backend: Static` must not install torch.\n\n    The same bug the `embed` boolean already had: GitHub's `==` is\n    case-insensitive and bash's `=` is not. Here the cost is concrete --\n    a case-sensitive test read `Static` as \"not static\", installed several GB of\n    sentence-transformers/torch, and only then failed on `--embed-backend\n    Static`, paying exactly what the static backend exists to avoid before\n    reporting the typo.", `entrypoint`: true};
