MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/rerank.py::rerank"}) SET n += {`id`: "sym:repo2graph/rerank.py::rerank", `name`: "rerank", `qualname`: "rerank", `kind`: "function", `path`: "repo2graph/rerank.py", `lang`: "python", `start_line`: 79, `end_line`: 105, `signature`: "def rerank(\n    query: str,\n    ranked: list[tuple[float, int]],\n    text_of: Callable[[int], str],\n    reranker: Reranker,\n    limit: int = CROSS_ENCODER_CANDIDATES,\n) -> tuple[list[tuple[float, int]], str]:", `docstring`: "Re-order the top `limit` of `ranked` by `reranker`; `(ranked, reason)`.\n\n    `ranked` is `(score, chunk_index)` in descending score order. On success\n    `reason` is empty; on any failure the input comes back unchanged with the\n    reason, for the caller to report."};
