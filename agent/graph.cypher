MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::_hostname_from_host_header"}) SET n += {`id`: "sym:repo2graph/http_server.py::_hostname_from_host_header", `name`: "_hostname_from_host_header", `qualname`: "_hostname_from_host_header", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 62, `end_line`: 81, `signature`: "def _hostname_from_host_header(value: str | None) -> str | None:", `docstring`: "The bare hostname of a `Host` header, with `:port` and `[...]` stripped.\n\n    Returns None for anything empty or unparseable -- fail closed rather than\n    guess."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::_hostname_from_origin"}) SET n += {`id`: "sym:repo2graph/http_server.py::_hostname_from_origin", `name`: "_hostname_from_origin", `qualname`: "_hostname_from_origin", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 84, `end_line`: 99, `signature`: "def _hostname_from_origin(value: str | None) -> str | None:", `docstring`: "The hostname of an `Origin` header, or None if absent/unparseable.\n\n    `null` (sandboxed iframes, `file://` pages) is treated as unparseable: it\n    never matches an allowlist of real hostnames, so it is rejected."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::_host_header_allowed"}) SET n += {`id`: "sym:repo2graph/http_server.py::_host_header_allowed", `name`: "_host_header_allowed", `qualname`: "_host_header_allowed", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 102, `end_line`: 108, `signature`: "def _host_header_allowed(value: str | None, allowed_hostnames: frozenset[str]) -> bool:", `docstring`: "Whether a `Host` header names one of the accepted hostnames.\n\n    Fails closed: a missing or unparseable header is not allowed."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::_origin_header_allowed"}) SET n += {`id`: "sym:repo2graph/http_server.py::_origin_header_allowed", `name`: "_origin_header_allowed", `qualname`: "_origin_header_allowed", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 111, `end_line`: 122, `signature`: "def _origin_header_allowed(value: str | None, allowed_hostnames: frozenset[str]) -> bool:", `docstring`: "Whether an `Origin` header, if present, names an accepted hostname.\n\n    No `Origin` header at all is allowed -- that is the common case for\n    non-browser clients (curl, an MCP client library) and carries none of the\n    cross-origin-browser risk this check exists for. A present-but-unparseable\n    or cross-origin value is refused."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::server_metadata"}) SET n += {`id`: "sym:repo2graph/http_server.py::server_metadata", `name`: "server_metadata", `qualname`: "server_metadata", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 141, `end_line`: 184, `signature`: "def server_metadata(\n    repo: Any,\n    index_present: bool,\n    auth_modes: Any,\n    index_built_at: str | None = None,\n    tools: Any = None,\n) -> dict[str, Any]:", `docstring`: "The `.well-known/mcp-server-metadata` document.\n\n    Lets a registry or client learn what this server does without opening a\n    session. Deliberately says nothing about repository *content* -- only that\n    an index exists and when it was built -- because this endpoint is\n    unauthenticated by necessity.\n\n    Args:\n        repo: Repository path the server was pointed at, or None.\n        index_present: Whether a readable index exists right now.\n        auth_modes: The modes from `AuthConfig.modes`.\n        index_built_at: ISO-8601 build time, or None when there is no index.\n        tools: To"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::index_built_at"}) SET n += {`id`: "sym:repo2graph/http_server.py::index_built_at", `name`: "index_built_at", `qualname`: "index_built_at", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 187, `end_line`: 203, `signature`: "def index_built_at(out: Any) -> str | None:", `docstring`: "When the index at `out` was last written, as ISO-8601, or None.\n\n    Args:\n        out: The index directory.\n\n    Returns:\n        The manifest's mtime in ISO-8601 UTC, or None when absent or unreadable."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::MCPRequestHandler"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler", `name`: "MCPRequestHandler", `qualname`: "MCPRequestHandler", `kind`: "class", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 206, `end_line`: 511, `signature`: "class MCPRequestHandler(BaseHTTPRequestHandler):", `docstring`: "One HTTP request. Configuration arrives via class attributes.\n\n    `BaseHTTPRequestHandler` instantiates the class per request, so there is no\n    constructor to pass configuration through; `make_handler` builds a subclass\n    carrying it instead."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::MCPRequestHandler.log_message"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler.log_message", `name`: "log_message", `qualname`: "MCPRequestHandler.log_message", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 230, `end_line`: 237, `signature`: "def log_message(self, fmt: str, *args: Any) -> None:", `docstring`: "Silence the default stderr access log.\n\n        BaseHTTPRequestHandler writes an apache-style line per request. The\n        audit log is the structured record of the same events, and two\n        overlapping logs on one stream is worse than either alone.", `entrypoint`: true};
