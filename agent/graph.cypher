MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::AuditConfig"}) SET n += {`id`: "sym:repo2graph/audit.py::AuditConfig", `name`: "AuditConfig", `qualname`: "AuditConfig", `kind`: "class", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 281, `end_line`: 290, `signature`: "class AuditConfig:", `docstring`: "Where audit records go and which ones are kept.\n\n    Attributes:\n        level: \"none\", \"errors\" (rejections and failures only) or \"all\".\n        path: Optional file to append to in addition to stderr."};
