MERGE (n:R2G:`Symbol` {id: "sym:scripts/generate_examples.py::clone_scoped"}) SET n += {`id`: "sym:scripts/generate_examples.py::clone_scoped", `name`: "clone_scoped", `qualname`: "clone_scoped", `kind`: "function", `path`: "scripts/generate_examples.py", `lang`: "python", `start_line`: 106, `end_line`: 130, `signature`: "def clone_scoped(entry: dict, dest: Path) -> str:", `docstring`: "Clone entry['url']@entry['ref'] into dest. Returns the checked-out commit SHA.\n\n    Only ever runs: clone (--filter=blob:none, optionally --depth), sparse-checkout\n    set, checkout. No submodules, no hooks (clone-triggered hooks do not exist;\n    none are ever invoked), no build/test/install commands \u2014 that is the whole\n    contract of \"treat the target repository as untrusted input\" from\n    docs/benchmarks.md."};
MERGE (n:R2G:`Symbol` {id: "sym:scripts/generate_examples.py::run_queries"}) SET n += {`id`: "sym:scripts/generate_examples.py::run_queries", `name`: "run_queries", `qualname`: "run_queries", `kind`: "function", `path`: "scripts/generate_examples.py", `lang`: "python", `start_line`: 133, `end_line`: 162, `signature`: "def run_queries(index_dir: Path, queries: list[str]) -> list[dict]:", `docstring`: "Real repo2graph.query.Index.retrieve() calls against the just-built index.\n\n    Runs while the index (including chunks.jsonl) still exists in the scratch\n    workdir. Each flow keeps only the fields a citation needs \u2014 node id, path,\n    line range, symbol name and the reason it was pulled in \u2014 never the chunk's\n    `text`, so no source excerpt survives into the committed flow file."};
MERGE (n:R2G:`Symbol` {id: "sym:scripts/generate_examples.py::_leaks_path"}) SET n += {`id`: "sym:scripts/generate_examples.py::_leaks_path", `name`: "_leaks_path", `qualname`: "_leaks_path", `kind`: "function", `path`: "scripts/generate_examples.py", `lang`: "python", `start_line`: 178, `end_line`: 197, `signature`: "def _leaks_path(text: str, prefix: str) -> bool:", `docstring`: "True when `prefix` occurs in `text` as a filesystem path rather than as\n    a coincidental substring of unrelated content.\n\n    Boundary-matched on both sides. The cost of that precision is a leak\n    embedded with no boundary at all (``file:///root/x``) going unreported;\n    the cost of the bare substring check it replaces was flagging real\n    repository content, which blocks a repository from the gallery outright."};
