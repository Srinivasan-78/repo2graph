MERGE (n:R2G:Symbol {id: "sym:repo2graph/chunks.py::_lines"}) SET n += {id: "sym:repo2graph/chunks.py::_lines", name: "_lines", qualname: "_lines", kind: "function", path: "repo2graph/chunks.py", lang: "python", start_line: 21, end_line: 29, signature: "def _lines(src: str) -> list[str]:", docstring: "Split source the way tree-sitter counts rows: on \"\\\\n\" only.\n\n    str.splitlines() also breaks on U+2028/U+2029/U+0085/\\\\x0b/\\\\x0c, which\n    tree-sitter's row numbers do not; using it here slices every later symbol's\n    chunk from the wrong lines (ISS-22). Drop a trailing \"\\\\r\" per line so\n    CRLF files still index cleanly."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/chunks.py::_keepends_lf"}) SET n += {id: "sym:repo2graph/chunks.py::_keepends_lf", name: "_keepends_lf", qualname: "_keepends_lf", kind: "function", path: "repo2graph/chunks.py", lang: "python", start_line: 32, end_line: 44, signature: "def _keepends_lf(text: str) -> list[str]:", docstring: "Split on \"\\\\n\" only, keeping the newline, so \"\".join(result) == text.\n\n    str.splitlines(keepends=True) also breaks on U+2028/U+2029/U+0085/\\\\x0b/\\\\x0c,\n    which tree-sitter does not treat as row breaks; splitting a chunk there makes\n    its pieces depend on whichever stray separators the source happens to hold\n    (the ISS-22 bug class). Same \"\\\\n\"-only rule as _lines, but lossless."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/chunks.py::_split"}) SET n += {id: "sym:repo2graph/chunks.py::_split", name: "_split", qualname: "_split", kind: "function", path: "repo2graph/chunks.py", lang: "python", start_line: 47, end_line: 60, signature: "def _split(text: str, max_chars: int = MAX_CHARS):", docstring: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/chunks.py::_conf"}) SET n += {id: "sym:repo2graph/chunks.py::_conf", name: "_conf", qualname: "_conf", kind: "function", path: "repo2graph/chunks.py", lang: "python", start_line: 63, end_line: 66, signature: "def _conf(text: str, edge: dict) -> str:", docstring: "Label a CALLS edge with its confidence when the call was ambiguous."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/chunks.py::build_chunks"}) SET n += {id: "sym:repo2graph/chunks.py::build_chunks", name: "build_chunks", qualname: "build_chunks", kind: "function", path: "repo2graph/chunks.py", lang: "python", start_line: 69, end_line: 71, signature: "def build_chunks(g, include_files: bool = True) -> list[dict]:", docstring: "All retrieval chunks as a list (stable public API)."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/chunks.py::iter_chunks"}) SET n += {id: "sym:repo2graph/chunks.py::iter_chunks", name: "iter_chunks", qualname: "iter_chunks", kind: "function", path: "repo2graph/chunks.py", lang: "python", start_line: 74, end_line: 211, signature: "def iter_chunks(g, include_files: bool = True):", docstring: "Yield chunk dicts ready for embedding, one at a time.\n\n    A generator, not a list: on a large repo the chunk text is the single\n    biggest allocation, so write_jsonl streams it straight to disk instead of\n    holding every chunk in memory at once. Source text is dropped from the cache\n    as soon as the last symbol on a file has been emitted."};
