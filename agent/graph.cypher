MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/audit.py::AuditConfig"}) SET n += {`id`: "sym:repo2graph/audit.py::AuditConfig", `name`: "AuditConfig", `qualname`: "AuditConfig", `kind`: "class", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 134, `end_line`: 149, `signature`: "class AuditConfig:", `docstring`: "Where audit records go and which ones are kept.\n\n    Attributes:\n        level: \"none\", \"errors\" (rejections and failures only) or \"all\".\n        path: Optional file to append to in addition to stderr.\n        fsync: Sync the file sink to stable storage after every record. Off by\n            default: flushing already makes the line whole for anything else\n            reading the file, and the same record is on stderr regardless, so\n            the cost of a disk sync per tool call buys only crash durability\n            for the file copy. Deployments that need exactly that turn it on."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/audit.py::AuditLogger"}) SET n += {`id`: "sym:repo2graph/audit.py::AuditLogger", `name`: "AuditLogger", `qualname`: "AuditLogger", `kind`: "class", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 152, `end_line`: 265, `signature`: "class AuditLogger:", `docstring`: "Emits one structured record per tool call.\n\n    Args:\n        config: Level and optional file sink.\n        stream: Where the stderr copy goes; resolved at call time when None."};
