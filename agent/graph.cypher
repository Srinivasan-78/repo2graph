MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::_sanitize_header_value"}) SET n += {`id`: "sym:repo2graph/http_server.py::_sanitize_header_value", `name`: "_sanitize_header_value", `qualname`: "_sanitize_header_value", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 83, `end_line`: 87, `signature`: "def _sanitize_header_value(value: str) -> str:", `docstring`: "Strip CR/LF/NUL from a value about to be placed in a response header."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::_hostname_from_host_header"}) SET n += {`id`: "sym:repo2graph/http_server.py::_hostname_from_host_header", `name`: "_hostname_from_host_header", `qualname`: "_hostname_from_host_header", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 90, `end_line`: 109, `signature`: "def _hostname_from_host_header(value: str | None) -> str | None:", `docstring`: "The bare hostname of a `Host` header, with `:port` and `[...]` stripped.\n\n    Returns None for anything empty or unparseable -- fail closed rather than\n    guess."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::_hostname_from_origin"}) SET n += {`id`: "sym:repo2graph/http_server.py::_hostname_from_origin", `name`: "_hostname_from_origin", `qualname`: "_hostname_from_origin", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 112, `end_line`: 127, `signature`: "def _hostname_from_origin(value: str | None) -> str | None:", `docstring`: "The hostname of an `Origin` header, or None if absent/unparseable.\n\n    `null` (sandboxed iframes, `file://` pages) is treated as unparseable: it\n    never matches an allowlist of real hostnames, so it is rejected."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::_host_header_allowed"}) SET n += {`id`: "sym:repo2graph/http_server.py::_host_header_allowed", `name`: "_host_header_allowed", `qualname`: "_host_header_allowed", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 130, `end_line`: 136, `signature`: "def _host_header_allowed(value: str | None, allowed_hostnames: frozenset[str]) -> bool:", `docstring`: "Whether a `Host` header names one of the accepted hostnames.\n\n    Fails closed: a missing or unparseable header is not allowed."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::_origin_header_allowed"}) SET n += {`id`: "sym:repo2graph/http_server.py::_origin_header_allowed", `name`: "_origin_header_allowed", `qualname`: "_origin_header_allowed", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 139, `end_line`: 150, `signature`: "def _origin_header_allowed(value: str | None, allowed_hostnames: frozenset[str]) -> bool:", `docstring`: "Whether an `Origin` header, if present, names an accepted hostname.\n\n    No `Origin` header at all is allowed -- that is the common case for\n    non-browser clients (curl, an MCP client library) and carries none of the\n    cross-origin-browser risk this check exists for. A present-but-unparseable\n    or cross-origin value is refused."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::_public_repo_label"}) SET n += {`id`: "sym:repo2graph/http_server.py::_public_repo_label", `name`: "_public_repo_label", `qualname`: "_public_repo_label", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 180, `end_line`: 190, `signature`: "def _public_repo_label(repo: Any) -> str | None:", `docstring`: "Basename of `repo` for the unauthenticated discovery document.\n\n    `GET /.well-known/mcp-server-metadata` skips auth, so an absolute host\n    path must never appear. Both `/` and `\\\\` count as separators so a\n    Windows-style path cannot leak on a POSIX host either."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::server_metadata"}) SET n += {`id`: "sym:repo2graph/http_server.py::server_metadata", `name`: "server_metadata", `qualname`: "server_metadata", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 193, `end_line`: 238, `signature`: "def server_metadata(\n    repo: Any,\n    index_present: bool,\n    auth_modes: Any,\n    index_built_at: str | None = None,\n    tools: Any = None,\n) -> dict[str, Any]:", `docstring`: "The `.well-known/mcp-server-metadata` document.\n\n    Lets a registry or client learn what this server does without opening a\n    session. Deliberately says nothing about repository *content* -- only that\n    an index exists and when it was built -- because this endpoint is\n    unauthenticated by necessity. `repo` is the basename only; the absolute\n    path would locate the project on the host.\n\n    Args:\n        repo: Repository path the server was pointed at, or None. Only the\n            basename is published.\n        index_present: Whether a readable index exists right now.\n        auth_mod"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::index_built_at"}) SET n += {`id`: "sym:repo2graph/http_server.py::index_built_at", `name`: "index_built_at", `qualname`: "index_built_at", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 241, `end_line`: 257, `signature`: "def index_built_at(out: Any) -> str | None:", `docstring`: "When the index at `out` was last written, as ISO-8601, or None.\n\n    Args:\n        out: The index directory.\n\n    Returns:\n        The manifest's mtime in ISO-8601 UTC, or None when absent or unreadable."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::MCPRequestHandler"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler", `name`: "MCPRequestHandler", `qualname`: "MCPRequestHandler", `kind`: "class", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 260, `end_line`: 681, `signature`: "class MCPRequestHandler(BaseHTTPRequestHandler):", `docstring`: "One HTTP request. Configuration arrives via class attributes.\n\n    `BaseHTTPRequestHandler` instantiates the class per request, so there is no\n    constructor to pass configuration through; `make_handler` builds a subclass\n    carrying it instead."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::MCPRequestHandler.log_message"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler.log_message", `name`: "log_message", `qualname`: "MCPRequestHandler.log_message", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 298, `end_line`: 305, `signature`: "def log_message(self, fmt: str, *args: Any) -> None:", `docstring`: "Silence the default stderr access log.\n\n        BaseHTTPRequestHandler writes an apache-style line per request. The\n        audit log is the structured record of the same events, and two\n        overlapping logs on one stream is worse than either alone.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::MCPRequestHandler._send_json"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler._send_json", `name`: "_send_json", `qualname`: "MCPRequestHandler._send_json", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 307, `end_line`: 343, `signature`: "def _send_json(\n        self,\n        status: int,\n        payload: dict[str, Any],\n        extra_headers: dict[str, str] | None = None,\n        send_body: bool = True,\n    ) -> None:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::MCPRequestHandler._read_body"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler._read_body", `name`: "_read_body", `qualname`: "MCPRequestHandler._read_body", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 345, `end_line`: 384, `signature`: "def _read_body(self) -> bytes:", `docstring`: "Read the request body, refusing anything this server will not read.\n\n        Raises:\n            AuthError: Carrying the status to refuse with -- 411 for a framing\n                this server does not speak, 400 for an unparseable\n                Content-Length, 413 for an oversized one, 408 for a body that\n                never fully arrived."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::MCPRequestHandler.do_HEAD"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler.do_HEAD", `name`: "do_HEAD", `qualname`: "MCPRequestHandler.do_HEAD", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 388, `end_line`: 390, `signature`: "def do_HEAD(self) -> None:", `docstring`: "Serve headers for GET paths without sending response body.", `entrypoint`: true};
