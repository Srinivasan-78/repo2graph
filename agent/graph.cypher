MERGE (n:R2G:Symbol {id: "sym:tests/test_incremental.py::test_same_bytes_different_language_is_a_cache_miss"}) SET n += {`id`: "sym:tests/test_incremental.py::test_same_bytes_different_language_is_a_cache_miss", `name`: "test_same_bytes_different_language_is_a_cache_miss", `qualname`: "test_same_bytes_different_language_is_a_cache_miss", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 391, `end_line`: 406, `signature`: "def test_same_bytes_different_language_is_a_cache_miss(tmp_path, recorder):", `docstring`: "A rename that changes the language must not reuse the old parse.\n\n    `a.py` and `a.rs` can hold byte-identical content and parse to completely\n    different symbol sets, so the content hash alone is not a sufficient key.", `entrypoint`: true, `reach`: 48};
