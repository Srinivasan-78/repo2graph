MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doctor.py::test_doctor_does_not_read_mcp_client_config_files"}) SET n += {`id`: "sym:tests/test_doctor.py::test_doctor_does_not_read_mcp_client_config_files", `name`: "test_doctor_does_not_read_mcp_client_config_files", `qualname`: "test_doctor_does_not_read_mcp_client_config_files", `kind`: "function", `path`: "tests/test_doctor.py", `lang`: "python", `start_line`: 93, `end_line`: 129, `signature`: "def test_doctor_does_not_read_mcp_client_config_files():", `docstring`: "`doctor --json` is documented as safe to paste into a bug report, which\n    holds only while it stays out of files belonging to other tools.\n\n    Checked over the AST's string *constants*, not the raw source: the probe's\n    own docstring names these files in order to say it does not read them, and a\n    substring scan cannot tell that apart from opening one.", `entrypoint`: true};
