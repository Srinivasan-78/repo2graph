MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_WriterError.__init__"}) SET n += {`id`: "sym:repo2graph/answer.py::_WriterError.__init__", `name`: "__init__", `qualname`: "_WriterError.__init__", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 140, `end_line`: 142, `signature`: "def __init__(self, exc: Exception):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::pick_provider"}) SET n += {`id`: "sym:repo2graph/answer.py::pick_provider", `name`: "pick_provider", `qualname`: "pick_provider", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 145, `end_line`: 186, `signature`: "def pick_provider(\n    env: dict[str, str] | os._Environ[str] | Any | None = None,\n    provider: str | None = None,\n) -> dict[str, str] | None:", `docstring`: "The requested provider, or the only configured one.\n\n    `GOOGLE_API_KEY` is accepted as a fallback for `GEMINI_API_KEY`. With two\n    or more providers configured and none requested, this refuses to choose."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::build_prompt"}) SET n += {`id`: "sym:repo2graph/answer.py::build_prompt", `name`: "build_prompt", `qualname`: "build_prompt", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 189, `end_line`: 213, `signature`: "def build_prompt(pack: dict[str, Any] | None, *, nonce: str | None = None) -> tuple[str, str]:", `docstring`: "(system, user). The pack rides inside a nonced untrusted-content fence.\n\n    `nonce` is injectable for tests only; production callers leave it None and\n    get a fresh random one per call."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_request"}) SET n += {`id`: "sym:repo2graph/answer.py::_request", `name`: "_request", `qualname`: "_request", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 216, `end_line`: 279, `signature`: "def _request(\n    spec: dict[str, str], model: str | None, system: str, user: str\n) -> tuple[str, dict[str, str], dict[str, Any]]:", `docstring`: "(url, headers, payload) for the chosen provider's streaming endpoint."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_ollama_base"}) SET n += {`id`: "sym:repo2graph/answer.py::_ollama_base", `name`: "_ollama_base", `qualname`: "_ollama_base", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 282, `end_line`: 315, `signature`: "def _ollama_base(value: str) -> str:", `docstring`: "Normalise OLLAMA_HOST to an http(s) base URL.\n\n    `ollama serve` documents (and exports) the schemeless `127.0.0.1:11434`,\n    which urlopen rejects with `unknown url type: 127.0.0.1`. Default the\n    scheme to http and refuse anything that is not http(s), so a stray\n    `file://` value cannot turn into an urlopen target."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_blocked_ip_reason"}) SET n += {`id`: "sym:repo2graph/answer.py::_blocked_ip_reason", `name`: "_blocked_ip_reason", `qualname`: "_blocked_ip_reason", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 335, `end_line`: 370, `signature`: "def _blocked_ip_reason(ip: ipaddress.IPv4Address | ipaddress.IPv6Address) -> str | None:", `docstring`: "Why this address is not a legitimate Ollama target, or None if it is.\n\n    Loopback is tested *first* and always allowed: `ollama serve` binds\n    127.0.0.1 by default and the whole point of the backend is to talk to it.\n    That ordering is load-bearing, because `::1` is simultaneously\n    `is_loopback` and `is_reserved` (and `is_private`) -- checking the block\n    predicates first rejected the documented IPv6 local address.\n\n    `is_private` is deliberately *not* a block reason. An Ollama server on the\n    LAN at 10.0.0.5 is a normal, documented deployment -- it is most of why\n    OLLAMA_HOS"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_is_blocked_ssrf_target"}) SET n += {`id`: "sym:repo2graph/answer.py::_is_blocked_ssrf_target", `name`: "_is_blocked_ssrf_target", `qualname`: "_is_blocked_ssrf_target", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 373, `end_line`: 412, `signature`: "def _is_blocked_ssrf_target(host: str) -> str | None:", `docstring`: "The reason `host` is a forbidden Ollama target, or None if it is allowed.\n\n    Resolving the name matters as much as classifying a literal: the previous\n    version called `ip_address(host)` and treated the `ValueError` on any\n    non-literal as \"allowed\", so `http://rebind.attacker.example` with an A\n    record pointing at 169.254.169.254 walked straight through the guard. Every\n    address the name resolves to is checked, so a name has to be clean on all\n    of its records, not just its first.\n\n    This resolves DNS, which is a network call -- acceptable only because this\n    module is `rag "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_is_loopback"}) SET n += {`id`: "sym:repo2graph/answer.py::_is_loopback", `name`: "_is_loopback", `qualname`: "_is_loopback", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 415, `end_line`: 421, `signature`: "def _is_loopback(host: str) -> bool:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_delta"}) SET n += {`id`: "sym:repo2graph/answer.py::_delta", `name`: "_delta", `qualname`: "_delta", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 424, `end_line`: 446, `signature`: "def _delta(name: str, raw: bytes) -> str:", `docstring`: "One streamed line -> the text it carries, or '' if it carries none."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_blocks"}) SET n += {`id`: "sym:repo2graph/answer.py::_blocks", `name`: "_blocks", `qualname`: "_blocks", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 449, `end_line`: 470, `signature`: "def _blocks(resp: Any) -> Iterator[bytes]:", `docstring`: "Yield the response body in READ_BLOCK-sized pieces.\n\n    `http.client.HTTPResponse.read(n)` is the real path here, and the sized read\n    is the whole point: `for raw in resp` reads until a newline, so a body that\n    never sends one is already a single unbounded `bytes` by the time the caller\n    is handed it. Some response-like objects only support iteration (a test\n    stand-in, a pre-split body); those keep their own framing, and the byte\n    ceiling in `_BoundedLines` still applies to what they yield."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_BoundedLines"}) SET n += {`id`: "sym:repo2graph/answer.py::_BoundedLines", `name`: "_BoundedLines", `qualname`: "_BoundedLines", `kind`: "class", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 473, `end_line`: 524, `signature`: "class _BoundedLines:", `docstring`: "Newline framing over a response body, with a hard byte ceiling.\n\n    Three unbounded reads close here. The body arrives in fixed blocks, so no\n    single newline-less line can grow without limit; the running total stops the\n    stream once `limit` bytes have been taken, so a trickle of well-formed small\n    deltas cannot either; and `deadline` stops it once the whole transfer has\n    run longer than a real answer ever does, which is the case neither of the\n    other two catches -- a host sending one byte at a time, slowly, stays under\n    the byte ceiling forever and resets the socket timeout "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_BoundedLines.__init__"}) SET n += {`id`: "sym:repo2graph/answer.py::_BoundedLines.__init__", `name`: "__init__", `qualname`: "_BoundedLines.__init__", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 490, `end_line`: 496, `signature`: "def __init__(self, resp: Any, limit: int, seconds: float | None = None) -> None:", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_BoundedLines.__iter__"}) SET n += {`id`: "sym:repo2graph/answer.py::_BoundedLines.__iter__", `name`: "__iter__", `qualname`: "_BoundedLines.__iter__", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 498, `end_line`: 524, `signature`: "def __iter__(self) -> Iterator[bytes]:", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_note_truncated"}) SET n += {`id`: "sym:repo2graph/answer.py::_note_truncated", `name`: "_note_truncated", `qualname`: "_note_truncated", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 527, `end_line`: 542, `signature`: "def _note_truncated(name: str, limit: int) -> None:", `docstring`: "Say on stderr that the answer was cut off at the byte ceiling.\n\n    A ceiling that silently drops the tail turns a partial answer into one that\n    looks whole, which is the failure mode `_empty_answer` exists to avoid for\n    the no-text case. stderr, not stdout, for the same reason `_disclose` uses\n    it: stdout is the answer and has to stay pipeable."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_note_timed_out"}) SET n += {`id`: "sym:repo2graph/answer.py::_note_timed_out", `name`: "_note_timed_out", `qualname`: "_note_timed_out", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 545, `end_line`: 560, `signature`: "def _note_timed_out(name: str, seconds: float) -> None:", `docstring`: "Say on stderr that the stream ran past its wall-clock budget.\n\n    Distinct wording from `_note_truncated` on purpose: \"too slow\" and \"too\n    much\" point at different causes, and a user who sees the byte-ceiling\n    message for a stalled endpoint will go looking for an answer that was never\n    large."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_writer"}) SET n += {`id`: "sym:repo2graph/answer.py::_writer", `name`: "_writer", `qualname`: "_writer", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 563, `end_line`: 587, `signature`: "def _writer(out: Any = None) -> Callable[[str], None]:", `docstring`: "A write callable that cannot raise UnicodeEncodeError.\n\n    Always writes through the stream's own text-mode `write`, never through\n    `sys.stdout.buffer`: on Windows the console expects bytes in its active\n    codepage (cp1252, cp437, ...), and writing raw UTF-8 bytes straight to\n    the buffer bypasses `TextIOWrapper`'s console translation, producing\n    mojibake even though no exception is raised (#169). A non-ASCII token\n    from a model would otherwise abort the whole answer mid-sentence, so the\n    chunk is folded to what the stream's own encoding can represent first."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_writer.write_text"}) SET n += {`id`: "sym:repo2graph/answer.py::_writer.write_text", `name`: "write_text", `qualname`: "_writer.write_text", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 576, `end_line`: 585, `signature`: "def write_text(chunk: str) -> None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_flush"}) SET n += {`id`: "sym:repo2graph/answer.py::_flush", `name`: "_flush", `qualname`: "_flush", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 590, `end_line`: 594, `signature`: "def _flush(stream: Any) -> None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_http_error"}) SET n += {`id`: "sym:repo2graph/answer.py::_http_error", `name`: "_http_error", `qualname`: "_http_error", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 597, `end_line`: 615, `signature`: "def _http_error(spec: dict[str, str], exc: Any) -> str:", `docstring`: "A one-line explanation of a provider HTTP error, without its URL.\n\n    HTTPError.url can carry credentials for some providers, so it is never\n    echoed; the status and the provider's own message are enough to act on."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_empty_answer"}) SET n += {`id`: "sym:repo2graph/answer.py::_empty_answer", `name`: "_empty_answer", `qualname`: "_empty_answer", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 618, `end_line`: 640, `signature`: "def _empty_answer(spec: dict[str, str], raw_tail: list[bytes]) -> str:", `docstring`: "Why a 200 response carried no answer text.\n\n    Ollama answers HTTP 200 with {\"error\": \"model 'x' not found\"}; without this\n    the command would print nothing and exit 0, which reads as a valid empty\n    answer."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_disclose"}) SET n += {`id`: "sym:repo2graph/answer.py::_disclose", `name`: "_disclose", `qualname`: "_disclose", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 643, `end_line`: 673, `signature`: "def _disclose(name: str, env: str, url: str, n_chars: int) -> None:", `docstring`: "Tell the user, on stderr, where their repository content is going.\n\n    Takes the three scalars it prints rather than the provider `spec`, because\n    that dict also carries the resolved API key under \"value\". A logging\n    function has no business holding a credential even if it never prints it:\n    the only way to be sure a secret cannot be logged is for it not to be in\n    scope. This also clears CodeQL alert #1 (py/clear-text-logging-sensitive-data),\n    which flagged the whole-dict argument reaching a print.\n\n    The pack can contain any indexed file, `.env` included. stderr, not stdout:\n"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_SameOriginRedirect"}) SET n += {`id`: "sym:repo2graph/answer.py::_SameOriginRedirect", `name`: "_SameOriginRedirect", `qualname`: "_SameOriginRedirect", `kind`: "class", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 676, `end_line`: 716, `signature`: "class _SameOriginRedirect(urllib.request.HTTPRedirectHandler):", `docstring`: "Keep a provider redirect on its origin, and never let it downgrade.\n\n    The request carries the API key in a header -- `Authorization`,\n    `x-api-key` or `x-goog-api-key`, depending on the provider -- and CPython's\n    redirect handler forwards every header except `content-length` and\n    `content-type` to the new target, whatever host and whatever scheme it\n    names. A provider answering `302 http://somewhere-else` is therefore handed\n    the credential, in clear, by a client that had no say in it.\n\n    It would also make `_disclose` untrue. That function prints the provider\n    and hostna"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/answer.py::_SameOriginRedirect.redirect_request"}) SET n += {`id`: "sym:repo2graph/answer.py::_SameOriginRedirect.redirect_request", `name`: "redirect_request", `qualname`: "_SameOriginRedirect.redirect_request", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 699, `end_line`: 716, `signature`: "def redirect_request(\n        self,\n        req: urllib.request.Request,\n        fp: Any,\n        code: int,\n        msg: str,\n        headers: Any,\n        newurl: str,\n    ) -> urllib.request.Request | None:", `docstring`: ""};
