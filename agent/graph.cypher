MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_iss124_repo_neighbours_explores_dir_file_and_calls"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss124_repo_neighbours_explores_dir_file_and_calls", `name`: "test_iss124_repo_neighbours_explores_dir_file_and_calls", `qualname`: "test_iss124_repo_neighbours_explores_dir_file_and_calls", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1527, `end_line`: 1544, `signature`: "def test_iss124_repo_neighbours_explores_dir_file_and_calls(mini_index):", `docstring`: "Issue 124: repo_neighbours explores CONTAINS edges for dirs and files, and includes low-confidence calls.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_iss235_concurrent_open_index_builds_the_index_exactly_once"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss235_concurrent_open_index_builds_the_index_exactly_once", `name`: "test_iss235_concurrent_open_index_builds_the_index_exactly_once", `qualname`: "test_iss235_concurrent_open_index_builds_the_index_exactly_once", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1552, `end_line`: 1612, `signature`: "def test_iss235_concurrent_open_index_builds_the_index_exactly_once(\n    mini_index, mini_repo, tmp_path, monkeypatch\n):", `docstring`: "Two simultaneous first calls must cost one build and share one Index.\n\n    The HTTP transport is a `ThreadingHTTPServer` with `daemon_threads = True`,\n    so two clients pointed at a server whose index does not exist yet both\n    reach `open_index` before either has written anything. Unlocked, both pass\n    the `not _has_index(...)` test, both parse the whole repository and then\n    race each other through `atomic_write`, so the loser's work is discarded.\n    The invocation count below is the detector: it reads 2 without the\n    per-directory lock and 1 with it.\n\n    `_build_index` is replaced", `entrypoint`: true, `reach`: 5};
MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_iss235_concurrent_open_index_builds_the_index_exactly_once.slow_build"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss235_concurrent_open_index_builds_the_index_exactly_once.slow_build", `name`: "slow_build", `qualname`: "test_iss235_concurrent_open_index_builds_the_index_exactly_once.slow_build", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1583, `end_line`: 1586, `signature`: "def slow_build(repo, target):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_iss235_concurrent_open_index_builds_the_index_exactly_once.call"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss235_concurrent_open_index_builds_the_index_exactly_once.call", `name`: "call", `qualname`: "test_iss235_concurrent_open_index_builds_the_index_exactly_once.call", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1593, `end_line`: 1598, `signature`: "def call(slot):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_iss203_http_only_without_a_port_refuses_instead_of_serving_stdio"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss203_http_only_without_a_port_refuses_instead_of_serving_stdio", `name`: "test_iss203_http_only_without_a_port_refuses_instead_of_serving_stdio", `qualname`: "test_iss203_http_only_without_a_port_refuses_instead_of_serving_stdio", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1620, `end_line`: 1640, `signature`: "def test_iss203_http_only_without_a_port_refuses_instead_of_serving_stdio(mini_repo, monkeypatch):", `docstring`: "The flag names what to omit, so alone it asks for no transport at all.\n\n    The test used to live inside the block that builds the HTTP transport, so\n    with no --http-port that block never ran, the flag was never read, and main\n    fell through to the stdio `serve()` -- precisely the transport --http-only\n    exists to suppress, and with no diagnostic.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_mcp.py::test_iss203_http_only_closes_the_audit_logger_on_the_way_out"}) SET n += {`id`: "sym:tests/test_mcp.py::test_iss203_http_only_closes_the_audit_logger_on_the_way_out", `name`: "test_iss203_http_only_closes_the_audit_logger_on_the_way_out", `qualname`: "test_iss203_http_only_closes_the_audit_logger_on_the_way_out", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1643, `end_line`: 1686, `signature`: "def test_iss203_http_only_closes_the_audit_logger_on_the_way_out(mini_repo, monkeypatch):", `docstring`: "The long-lived path is the one that must not leak the audit fd.\n\n    `audit.close()` used to sit only in the `finally:` of the `serve()` call,\n    which the --http-only branch's own `return 0` jumped straight over. Both\n    exit paths now share one teardown; this pins that the HTTP-only one runs it.", `entrypoint`: true};
