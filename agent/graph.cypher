MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_rsa_verify_rejects_garbage_in_the_padding"}) SET n += {`id`: "sym:tests/test_auth.py::test_rsa_verify_rejects_garbage_in_the_padding", `name`: "test_rsa_verify_rejects_garbage_in_the_padding", `qualname`: "test_rsa_verify_rejects_garbage_in_the_padding", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 205, `end_line`: 216, `signature`: "def test_rsa_verify_rejects_garbage_in_the_padding():", `docstring`: "The whole block is compared, so a forged DigestInfo in slack space fails.\n\n    A verifier that *scans* for the digest instead of rebuilding the block\n    accepts Bleichenbacher-style forgeries against low exponents.", `entrypoint`: true};
