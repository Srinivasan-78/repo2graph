MERGE (n:R2G:Symbol {id: "sym:repo2graph/http_server.py::MCPRequestHandler.do_GET"}) SET n += {`id`: "sym:repo2graph/http_server.py::MCPRequestHandler.do_GET", `name`: "do_GET", `qualname`: "MCPRequestHandler.do_GET", `kind`: "function", `path`: "repo2graph/http_server.py", `lang`: "python", `start_line`: 270, `end_line`: 300, `signature`: "def do_GET(self) -> None:", `docstring`: "Serve the unauthenticated discovery documents, and nothing else.", `entrypoint`: true, `reach`: 28};
