MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/export.py::atomic_write"}) SET n += {`id`: "sym:repo2graph/export.py::atomic_write", `name`: "atomic_write", `qualname`: "atomic_write", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 51, `end_line`: 77, `signature`: "def atomic_write(path: Path, mode: str = \"w\", **open_kw: Any) -> Iterator[IO[Any]]:", `docstring`: "Context manager for writing files via a temporary sibling file.\n\n    Atomically renames the temporary file to target path upon clean exit,\n    preventing partially written or corrupt files on error.\n\n    Args:\n        path: Target file path.\n        mode: File open mode ('w', 'wb', etc.).\n        **open_kw: Additional keyword arguments passed to open().\n\n    Yields:\n        Open file handle for writing."};
