MERGE (n:R2G:Symbol {id: "sym:repo2graph/cli.py::_resolve_vectors"}) SET n += {`id`: "sym:repo2graph/cli.py::_resolve_vectors", `name`: "_resolve_vectors", `qualname`: "_resolve_vectors", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 279, `end_line`: 313, `signature`: "def _resolve_vectors(idx, args, out=None):", `docstring`: "(vectors, embedder) for a query, honouring --vectors / --no-vectors.\n\n    Dense fusion is **opt-in**. Without `--vectors` the ranking is lexical and\n    no embedder is constructed at all: building one loads sentence-transformers\n    and, on a cold cache, downloads ~90 MB of model weights. An unannounced\n    network fetch has no business on the default `query`/`rag` path, whose only\n    promised dependency is tree-sitter -- and an index is a shippable artifact,\n    so \"the index happens to carry vectors\" is not consent to go fetch a model.\n\n    `--vectors` is a demand: if the index has none, th"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cli.py::cmd_embed"}) SET n += {`id`: "sym:repo2graph/cli.py::cmd_embed", `name`: "cmd_embed", `qualname`: "cmd_embed", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 316, `end_line`: 389, `signature`: "def cmd_embed(args):", `docstring`: "Embed an index's chunks, reusing every vector whose text is unchanged.", `entrypoint`: true, `reach`: 69};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cli.py::_reusable_vectors"}) SET n += {`id`: "sym:repo2graph/cli.py::_reusable_vectors", `name`: "_reusable_vectors", `qualname`: "_reusable_vectors", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 392, `end_line`: 414, `signature`: "def _reusable_vectors(npy: Path, model_id: str, hashes: dict) -> dict:", `docstring`: "Stored vectors whose chunk id *and* chunk text are both unchanged.\n\n    A chunk's vector depends on its own text and nothing else, so this is\n    correct by construction \u2014 unlike reusing anything that depends on the\n    graph, whose call confidences are global."};
