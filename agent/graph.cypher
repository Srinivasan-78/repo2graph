MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss22_symbol_chunk_body_survives_unicode_line_separator"}) SET n += {id: "sym:tests/test_repo2graph.py::test_iss22_symbol_chunk_body_survives_unicode_line_separator", name: "test_iss22_symbol_chunk_body_survives_unicode_line_separator", qualname: "test_iss22_symbol_chunk_body_survives_unicode_line_separator", kind: "function", path: "tests/test_repo2graph.py", lang: "python", start_line: 666, end_line: 679, signature: "def test_iss22_symbol_chunk_body_survives_unicode_line_separator(tmp_path):", docstring: "AC-1 (ISS-22): a file whose first line holds U+2028 must still slice each\n    later symbol's chunk from the right source lines. At HEAD `splitlines()`\n    splits on U+2028 while tree-sitter row numbers do not, so the body comes out\n    as \"\\\\ndef uses_sep():\" and never contains \"return MSG\".", entrypoint: true, reach: 41};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss22_file_residual_excludes_symbol_body"}) SET n += {id: "sym:tests/test_repo2graph.py::test_iss22_file_residual_excludes_symbol_body", name: "test_iss22_file_residual_excludes_symbol_body", qualname: "test_iss22_file_residual_excludes_symbol_body", kind: "function", path: "tests/test_repo2graph.py", lang: "python", start_line: 682, end_line: 701, signature: "def test_iss22_file_residual_excludes_symbol_body(tmp_path):", docstring: "AC-2 (ISS-22): the residual chunk holds only lines no symbol claimed. At\n    HEAD the same mis-slice pulls `return MSG` (the body of uses_sep) into the\n    residual and drops part of the real residual span.", entrypoint: true, reach: 41};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss06_cochange_survives_non_ascii_filenames"}) SET n += {id: "sym:tests/test_repo2graph.py::test_iss06_cochange_survives_non_ascii_filenames", name: "test_iss06_cochange_survives_non_ascii_filenames", qualname: "test_iss06_cochange_survives_non_ascii_filenames", kind: "function", path: "tests/test_repo2graph.py", lang: "python", start_line: 704, end_line: 724, signature: "def test_iss06_cochange_survives_non_ascii_filenames(tmp_path):", docstring: "AC-3/AC-4 (ISS-06): two non-ASCII paths committed together three times\n    must yield a CO_CHANGE edge. At HEAD `git log` runs with text=True and\n    core.quotepath=true, so the paths come back quoted/locale-decoded, never\n    match file_index, and the edge silently vanishes (or raises\n    UnicodeDecodeError on a non-UTF-8 locale).", entrypoint: true, reach: 34};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_sh1_add_cochange_splits_git_log_on_newline_only"}) SET n += {id: "sym:tests/test_repo2graph.py::test_sh1_add_cochange_splits_git_log_on_newline_only", name: "test_sh1_add_cochange_splits_git_log_on_newline_only", qualname: "test_sh1_add_cochange_splits_git_log_on_newline_only", kind: "function", path: "tests/test_repo2graph.py", lang: "python", start_line: 727, end_line: 742, signature: "def test_sh1_add_cochange_splits_git_log_on_newline_only(monkeypatch):", docstring: "REVIEW SH-1 (ISS-22 bug class, graph.py:380): add_cochange must split\n    `git log` output on \"\\\\n\" only. With core.quotepath=false git emits a path\n    containing a raw U+2028; str.splitlines() would cut that path in two so\n    neither fragment matches file_index and the CO_CHANGE edge vanishes.", entrypoint: true, reach: 5};
