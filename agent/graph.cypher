MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp_tools.py::test_path_between_paths_limit_is_clamped_in_the_handler"}) SET n += {`id`: "sym:tests/test_mcp_tools.py::test_path_between_paths_limit_is_clamped_in_the_handler", `name`: "test_path_between_paths_limit_is_clamped_in_the_handler", `qualname`: "test_path_between_paths_limit_is_clamped_in_the_handler", `kind`: "function", `path`: "tests/test_mcp_tools.py", `lang`: "python", `start_line`: 646, `end_line`: 691, `signature`: "def test_path_between_paths_limit_is_clamped_in_the_handler(tmp_path, monkeypatch):", `docstring`: "`max_paths` above MCP_MAX_PATHS must not widen the traversal.\n\n    Nothing exercised this clamp, so deleting it would have let a caller ask for\n    an unbounded number of paths. Asserted where the value is consumed --\n    `_reconstruct`'s `cap` -- rather than by counting returned paths: the\n    bidirectional search reconstructs through one meeting node, so how many\n    paths a fixture yields is a property of the graph shape, not of the ceiling.", `entrypoint`: true, `reach`: 75};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp_tools.py::test_path_between_paths_limit_is_clamped_in_the_handler.spy"}) SET n += {`id`: "sym:tests/test_mcp_tools.py::test_path_between_paths_limit_is_clamped_in_the_handler.spy", `name`: "spy", `qualname`: "test_path_between_paths_limit_is_clamped_in_the_handler.spy", `kind`: "function", `path`: "tests/test_mcp_tools.py", `lang`: "python", `start_line`: 678, `end_line`: 680, `signature`: "def spy(parents, node, root, cap):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp_tools.py::test_repo_search_forwards_every_advertised_parameter"}) SET n += {`id`: "sym:tests/test_mcp_tools.py::test_repo_search_forwards_every_advertised_parameter", `name`: "test_repo_search_forwards_every_advertised_parameter", `qualname`: "test_repo_search_forwards_every_advertised_parameter", `kind`: "function", `path`: "tests/test_mcp_tools.py", `lang`: "python", `start_line`: 694, `end_line`: 733, `signature`: "def test_repo_search_forwards_every_advertised_parameter(mini_index):", `docstring`: "Whatever the schema advertises must reach the tool.\n\n    The dispatcher once dropped `neighbours`/`max_neighbours` while the schema\n    still advertised them, so a client setting `neighbours=\"cite\"` got full-body\n    neighbours and no error. Asserted against the schema rather than a\n    hand-written list, so a newly advertised parameter that is not forwarded\n    fails here.\n\n    Those two parameters are now retired rather than silently dropped: see\n    `test_retired_retrieval_parameters_are_neither_advertised_nor_forwarded`.", `entrypoint`: true, `reach`: 67};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp_tools.py::test_repo_search_forwards_every_advertised_parameter._spy"}) SET n += {`id`: "sym:tests/test_mcp_tools.py::test_repo_search_forwards_every_advertised_parameter._spy", `name`: "_spy", `qualname`: "test_repo_search_forwards_every_advertised_parameter._spy", `kind`: "function", `path`: "tests/test_mcp_tools.py", `lang`: "python", `start_line`: 718, `end_line`: 720, `signature`: "def _spy(index, query, **kw):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp_tools.py::test_retired_retrieval_parameters_are_neither_advertised_nor_forwarded"}) SET n += {`id`: "sym:tests/test_mcp_tools.py::test_retired_retrieval_parameters_are_neither_advertised_nor_forwarded", `name`: "test_retired_retrieval_parameters_are_neither_advertised_nor_forwarded", `qualname`: "test_retired_retrieval_parameters_are_neither_advertised_nor_forwarded", `kind`: "function", `path`: "tests/test_mcp_tools.py", `lang`: "python", `start_line`: 736, `end_line`: 776, `signature`: "def test_retired_retrieval_parameters_are_neither_advertised_nor_forwarded(mini_index):", `docstring`: "Citation mode is retired over MCP, and must not be reachable by accident.\n\n    On 40 held-out lexical and 40 held-out structural questions, `cite`\n    neighbours measured -1/-8/-19 pp and -3/-10/-31 pp against the default, and\n    were dominated by turning expansion off entirely -- better recall for fewer\n    tokens. An agent picks its arguments out of the schema, so advertising a\n    dominated mode is how it gets chosen.\n\n    Unadvertised *and* unforwarded is the point. Advertised-but-inert is the\n    defect this file already records having fixed once.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp_tools.py::test_retired_retrieval_parameters_are_neither_advertised_nor_forwarded._spy"}) SET n += {`id`: "sym:tests/test_mcp_tools.py::test_retired_retrieval_parameters_are_neither_advertised_nor_forwarded._spy", `name`: "_spy", `qualname`: "test_retired_retrieval_parameters_are_neither_advertised_nor_forwarded._spy", `kind`: "function", `path`: "tests/test_mcp_tools.py", `lang`: "python", `start_line`: 758, `end_line`: 760, `signature`: "def _spy(index, query, **kw):", `docstring`: ""};
