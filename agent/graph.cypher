MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::_stub_dns"}) SET n += {`id`: "sym:tests/test_rag.py::_stub_dns", `name`: "_stub_dns", `qualname`: "_stub_dns", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 1124, `end_line`: 1141, `signature`: "def _stub_dns(monkeypatch, mapping):", `docstring`: "Pin name resolution, so the SSRF guard's verdict is not the DNS's.\n\n    `_is_blocked_ssrf_target` resolves non-literal hostnames, so without this\n    every hostname assertion below would depend on the resolver the suite\n    happens to run against -- `ollama.internal` is a name a corporate split\n    horizon really can answer with an RFC1918 address."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::_stub_dns.fake_getaddrinfo"}) SET n += {`id`: "sym:tests/test_rag.py::_stub_dns.fake_getaddrinfo", `name`: "fake_getaddrinfo", `qualname`: "_stub_dns.fake_getaddrinfo", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 1134, `end_line`: 1139, `signature`: "def fake_getaddrinfo(host, *a, **kw):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::test_ollama_base_url_validation"}) SET n += {`id`: "sym:tests/test_rag.py::test_ollama_base_url_validation", `name`: "test_ollama_base_url_validation", `qualname`: "test_ollama_base_url_validation", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 1144, `end_line`: 1182, `signature`: "def test_ollama_base_url_validation(monkeypatch):", `docstring`: "S-15: _ollama_base validates scheme and rejects bad URLs.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::test_ollama_base_allows_loopback_in_both_families"}) SET n += {`id`: "sym:tests/test_rag.py::test_ollama_base_allows_loopback_in_both_families", `name`: "test_ollama_base_allows_loopback_in_both_families", `qualname`: "test_ollama_base_allows_loopback_in_both_families", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 1185, `end_line`: 1197, `signature`: "def test_ollama_base_allows_loopback_in_both_families(monkeypatch):", `docstring`: "`ollama serve` binds loopback by default, so loopback must never be blocked.\n\n    `::1` is the regression this pins: it is `is_loopback` *and* `is_reserved`\n    *and* `is_private`, so any guard that tests the block predicates before\n    loopback rejects the documented IPv6 local address.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::test_ollama_base_blocks_pivot_only_literals"}) SET n += {`id`: "sym:tests/test_rag.py::test_ollama_base_blocks_pivot_only_literals", `name`: "test_ollama_base_blocks_pivot_only_literals", `qualname`: "test_ollama_base_blocks_pivot_only_literals", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 1214, `end_line`: 1230, `signature`: "def test_ollama_base_blocks_pivot_only_literals(monkeypatch, host, fragment):", `docstring`: "Addresses that are never an Ollama server and only ever a pivot target.\n\n    `fd00:ec2::254`, `192.0.0.192` and `100.100.100.200` are the metadata\n    endpoints that are *not* link-local (unique-local, private and CGNAT\n    respectively), so they only get caught by being named.\n    `::ffff:169.254.169.254` is here because the IPv4-mapped form inherits none\n    of the v4 address's classifications -- it has to be unwrapped to be seen.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::test_ollama_base_allows_lan_servers"}) SET n += {`id`: "sym:tests/test_rag.py::test_ollama_base_allows_lan_servers", `name`: "test_ollama_base_allows_lan_servers", `qualname`: "test_ollama_base_allows_lan_servers", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 1234, `end_line`: 1247, `signature`: "def test_ollama_base_allows_lan_servers(monkeypatch, host):", `docstring`: "An Ollama server on the LAN is a normal deployment, not an SSRF target.\n\n    Blocking RFC1918/ULA outright would break the main non-loopback use of\n    OLLAMA_HOST to harden an operator-supplied env var against the operator.\n    The plain-HTTP warning is the proportionate response and is asserted by\n    `test_plain_http_ollama_off_loopback_warns`.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::test_ollama_base_blocks_hostname_resolving_to_metadata"}) SET n += {`id`: "sym:tests/test_rag.py::test_ollama_base_blocks_hostname_resolving_to_metadata", `name`: "test_ollama_base_blocks_hostname_resolving_to_metadata", `qualname`: "test_ollama_base_blocks_hostname_resolving_to_metadata", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 1250, `end_line`: 1264, `signature`: "def test_ollama_base_blocks_hostname_resolving_to_metadata(monkeypatch):", `docstring`: "A name whose A record points at the metadata endpoint must not pass.\n\n    The pre-fix guard classified only literals and treated the `ValueError` on\n    any hostname as \"allowed\", so this walked straight through.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::test_ollama_base_blocks_hostname_with_one_bad_record"}) SET n += {`id`: "sym:tests/test_rag.py::test_ollama_base_blocks_hostname_with_one_bad_record", `name`: "test_ollama_base_blocks_hostname_with_one_bad_record", `qualname`: "test_ollama_base_blocks_hostname_with_one_bad_record", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 1267, `end_line`: 1280, `signature`: "def test_ollama_base_blocks_hostname_with_one_bad_record(monkeypatch):", `docstring`: "Every resolved address is checked, not just the first.\n\n    A split answer -- one routable address and one metadata endpoint -- would\n    otherwise let the blocked target through on whichever record urlopen picks.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::test_gemini_request_model_path_and_key_header"}) SET n += {`id`: "sym:tests/test_rag.py::test_gemini_request_model_path_and_key_header", `name`: "test_gemini_request_model_path_and_key_header", `qualname`: "test_gemini_request_model_path_and_key_header", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 1283, `end_line`: 1306, `signature`: "def test_gemini_request_model_path_and_key_header():", `docstring`: "S-14/S-15: gemini request puts key in header and handles model path.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::test_writer_falls_back_to_utf8_on_an_unknown_stream_encoding"}) SET n += {`id`: "sym:tests/test_rag.py::test_writer_falls_back_to_utf8_on_an_unknown_stream_encoding", `name`: "test_writer_falls_back_to_utf8_on_an_unknown_stream_encoding", `qualname`: "test_writer_falls_back_to_utf8_on_an_unknown_stream_encoding", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 1309, `end_line`: 1333, `signature`: "def test_writer_falls_back_to_utf8_on_an_unknown_stream_encoding():", `docstring`: "An unknown codec must not abort the answer, and must still emit the text.\n\n    `_writer` catches LookupError and re-encodes through utf8. This asserted\n    only that the call did not raise, so a fallback that silently dropped the\n    chunk would have passed.", `entrypoint`: true, `reach`: 9};
