MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::_pyproject_version"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::_pyproject_version", `name`: "_pyproject_version", `qualname`: "_pyproject_version", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 31, `end_line`: 39, `signature`: "def _pyproject_version() -> str:", `docstring`: "`pyproject.toml`'s `[project] version`, read by regex like\n    `scripts/version_surfaces.py` does -- a regex match on the one line that\n    matters keeps this test independent of how the file is parsed."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_cli_commands_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_cli_commands_documented", `name`: "test_cli_commands_documented", `qualname`: "test_cli_commands_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 75, `end_line`: 94, `signature`: "def test_cli_commands_documented():", `docstring`: "Verify all CLI subcommands are documented in README.md and docs/cli.md.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_languages_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_languages_documented", `name`: "test_languages_documented", `qualname`: "test_languages_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 97, `end_line`: 120, `signature`: "def test_languages_documented():", `docstring`: "Verify every LANG_CFG grammar key is documented in README.md.\n\n    Word-boundary regexes, not plain substrings: `\"c\" in readme_text.lower()`\n    or `\"go\" in ...` is true of nearly any English prose regardless of\n    whether the language is mentioned, so those checks passed even with the\n    language name deleted from README.md. `\\\\bC\\\\b` (with a negative\n    lookahead so it doesn't also match the \"C\" inside \"C++\"/\"C#\") actually\n    requires the token to appear.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_language_scorecard_matches_the_generator"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_language_scorecard_matches_the_generator", `name`: "test_language_scorecard_matches_the_generator", `qualname`: "test_language_scorecard_matches_the_generator", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 123, `end_line`: 161, `signature`: "def test_language_scorecard_matches_the_generator():", `docstring`: "The scorecard table in docs/architecture.md is what the generator emits today.\n\n    `scripts/generate_language_scorecard.py` shipped with no consumer: nothing in\n    docs/, README or CI referenced it, and its own docstring pointed at a\n    `docs/LANGUAGE_SCORECARD.json` that was never committed. A generator whose\n    output nobody reads stops being run, and then stops being right -- it scores\n    `LANG_CFG` by introspection, so every language added or extended moves these\n    numbers silently.\n\n    Pinning the rendered table means adding a language fails here until the table\n    is regenerated", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_action_inputs_and_outputs_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_action_inputs_and_outputs_documented", `name`: "test_action_inputs_and_outputs_documented", `qualname`: "test_action_inputs_and_outputs_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 164, `end_line`: 186, `signature`: "def test_action_inputs_and_outputs_documented():", `docstring`: "Verify every input and output in action.yml is documented in docs/cli.md.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_mcp_tools_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_mcp_tools_documented", `name`: "test_mcp_tools_documented", `qualname`: "test_mcp_tools_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 189, `end_line`: 199, `signature`: "def test_mcp_tools_documented():", `docstring`: "Verify every registered tool in repo2graph.mcp is documented in docs/mcp.md.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_citation_cff_matches_pyproject"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_citation_cff_matches_pyproject", `name`: "test_citation_cff_matches_pyproject", `qualname`: "test_citation_cff_matches_pyproject", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 202, `end_line`: 219, `signature`: "def test_citation_cff_matches_pyproject():", `docstring`: "Issue #404: CITATION.cff must parse and stay in lockstep with pyproject.toml.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_npm_launcher_version_matches_pyproject"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_npm_launcher_version_matches_pyproject", `name`: "test_npm_launcher_version_matches_pyproject", `qualname`: "test_npm_launcher_version_matches_pyproject", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 222, `end_line`: 236, `signature`: "def test_npm_launcher_version_matches_pyproject():", `docstring`: "Issue #399: the npx launcher's package.json version stays paired with the PyPI release.\n\n    `npm/README.md`'s \"Release story\" section promises the two are published from the same\n    tag; this is the machine-checkable half of that promise.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_starter_questions_match_the_docs_verbatim"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_starter_questions_match_the_docs_verbatim", `name`: "test_starter_questions_match_the_docs_verbatim", `qualname`: "test_starter_questions_match_the_docs_verbatim", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 239, `end_line`: 258, `signature`: "def test_starter_questions_match_the_docs_verbatim():", `docstring`: "The five starter prompts are authored once, in repo2graph/demo.py.\n\n    README.md renders them and `repo2graph demo` runs them, so a prompt edited\n    in one place and not the other would leave the docs telling users to run\n    something the demo never exercises. Both the template form (what a reader\n    copies onto their own repo) and the one-line rationale beside it are pinned.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_every_exclusion_group_is_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_every_exclusion_group_is_documented", `name`: "test_every_exclusion_group_is_documented", `qualname`: "test_every_exclusion_group_is_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 261, `end_line`: 279, `signature`: "def test_every_exclusion_group_is_documented():", `docstring`: "`--exclude-group` names come from one table; the docs must list them all.\n\n    A group added to `exclusions.GROUPS` and not documented is a flag nobody\n    can discover; a group documented and not implemented is a flag that\n    errors.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_indexing_doc_names_determinism_tests_that_exist"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_indexing_doc_names_determinism_tests_that_exist", `name`: "test_indexing_doc_names_determinism_tests_that_exist", `qualname`: "test_indexing_doc_names_determinism_tests_that_exist", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 282, `end_line`: 302, `signature`: "def test_indexing_doc_names_determinism_tests_that_exist():", `docstring`: "architecture.md's guarantee table points at specific tests by name.\n\n    A renamed or deleted test would leave the documented guarantee pointing\n    at nothing while still reading as though it were enforced.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_git_metadata_fields_are_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_git_metadata_fields_are_documented", `name`: "test_git_metadata_fields_are_documented", `qualname`: "test_git_metadata_fields_are_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 305, `end_line`: 315, `signature`: "def test_git_metadata_fields_are_documented():", `docstring`: "Every provenance field `index-status` surfaces is named in architecture.md.\n\n    `manifest.json`'s `source_revision` is a public surface -- `--json`\n    prints it verbatim -- so a field added without a doc edit is an\n    undocumented API. The *shape* of the report is asserted against a real\n    index in tests/test_index_status.py, not by scraping this source.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_cli_doc_names_every_doctor_check_that_exists"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_cli_doc_names_every_doctor_check_that_exists", `name`: "test_cli_doc_names_every_doctor_check_that_exists", `qualname`: "test_cli_doc_names_every_doctor_check_that_exists", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 318, `end_line`: 333, `signature`: "def test_cli_doc_names_every_doctor_check_that_exists():", `docstring`: "docs/cli.md lists the doctor checks by the name doctor actually prints.\n\n    A check renamed or dropped without a doc edit leaves the list pointing at\n    output that never appears; a check added without one leaves it undocumented.\n    Asserted against the report a real run produces, not against the source.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_architecture_module_reference_names_every_module"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_architecture_module_reference_names_every_module", `name`: "test_architecture_module_reference_names_every_module", `qualname`: "test_architecture_module_reference_names_every_module", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 336, `end_line`: 363, `signature`: "def test_architecture_module_reference_names_every_module():", `docstring`: "\u00a75's tables are the map CONTRIBUTING sends contributors to; a module\n    missing from it makes that map wrong about the architecture, not merely\n    imprecise about size.\n\n    Nine were absent -- `config.py`, `federated.py`, `graphdiff.py`,\n    `neo4j.py`, `pagination.py`, `rerank.py`, `resources.py`, `tokenizers.py`\n    and `watch.py`, every one added in #477-#481, eight of them appearing\n    nowhere in the file at all (#486).\n\n    Completeness is what is gated, not the `Lines` column: a test on the exact\n    counts would make every PR that touches a module edit the doc too, and the\n    table", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_no_doc_sends_a_reader_to_a_doctor_check_that_does_not_exist"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_no_doc_sends_a_reader_to_a_doctor_check_that_does_not_exist", `name`: "test_no_doc_sends_a_reader_to_a_doctor_check_that_does_not_exist", `qualname`: "test_no_doc_sends_a_reader_to_a_doctor_check_that_does_not_exist", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 366, `end_line`: 393, `signature`: "def test_no_doc_sends_a_reader_to_a_doctor_check_that_does_not_exist():", `docstring`: "The other direction, which the test above cannot see.\n\n    `test_cli_doc_names_every_doctor_check_that_exists` asserts every real\n    check is mentioned somewhere; it says nothing about a doc naming a check\n    that is gone. `56f71d37` (\"slim doctor down to core environment, git, and\n    grammar probes\") dropped ~1,500 lines of checks, and four rows of\n    docs/mcp.md's troubleshooting table went on telling readers to run\n    `repo2graph doctor .` and look for \"MCP Client Configuration\", \"Generated /\n    Vendored Code\" and \"Parser Coverage\" -- none of which doctor has printed\n    since. Every ", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_the_shipped_doc_set_is_the_documented_one"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_the_shipped_doc_set_is_the_documented_one", `name`: "test_the_shipped_doc_set_is_the_documented_one", `qualname`: "test_the_shipped_doc_set_is_the_documented_one", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 396, `end_line`: 420, `signature`: "def test_the_shipped_doc_set_is_the_documented_one():", `docstring`: "`docs/` is five reference pages, and adding a sixth is a decision.\n\n    The tree previously grew to 29 documents -- compliance theater, speculative\n    RFCs, roadmap trackers and three overlapping architecture pages -- with an\n    index file to make them findable. Pinning the set means a new page has to be\n    added here deliberately, which is where the \"should this be a section of an\n    existing page\" question gets asked.\n\n    `comparison.md` is the deliberate fifth. The consolidation dropped it and\n    repointed README's \"how it compares with Serena, Aider, ...\" link at\n    architecture.md,", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_architecture_doc_names_the_standard_edge_fields"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_architecture_doc_names_the_standard_edge_fields", `name`: "test_architecture_doc_names_the_standard_edge_fields", `qualname`: "test_architecture_doc_names_the_standard_edge_fields", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 423, `end_line`: 439, `signature`: "def test_architecture_doc_names_the_standard_edge_fields():", `docstring`: "docs/architecture.md lists every field an edge can carry.\n\n    It used to say `CALLS_EXTERNAL` carries no `confidence` -- true until every\n    edge type gained the standard trio, and wrong afterwards. The edge-metadata\n    section and `edgemeta.STANDARD_FIELDS` describe the same records.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_integration_guides_quote_the_real_mcp_bounds"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_integration_guides_quote_the_real_mcp_bounds", `name`: "test_integration_guides_quote_the_real_mcp_bounds", `qualname`: "test_integration_guides_quote_the_real_mcp_bounds", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 447, `end_line`: 491, `signature`: "def test_integration_guides_quote_the_real_mcp_bounds():", `docstring`: "The guides publish the argument ceilings as a contract with the reader.\n\n    A clamp loosened in mcp.py without a doc edit leaves a guide promising a\n    bound the server no longer enforces.", `entrypoint`: true};
