MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_explain_path_agrees_with_build_and_names_the_matching_glob"}) SET n += {`id`: "sym:tests/test_determinism.py::test_explain_path_agrees_with_build_and_names_the_matching_glob", `name`: "test_explain_path_agrees_with_build_and_names_the_matching_glob", `qualname`: "test_explain_path_agrees_with_build_and_names_the_matching_glob", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 379, `end_line`: 408, `signature`: "def test_explain_path_agrees_with_build_and_names_the_matching_glob(tmp_path, capsys):", `docstring`: "`explain-path` must answer from the rule set the build would use.\n\n    It also has to name *which* pattern matched: a `--exclude-group` expands\n    to as many as 60 globs, and echoing the whole list buries the answer in\n    the evidence.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_exclude_group_help_prints_every_group_and_exits_zero"}) SET n += {`id`: "sym:tests/test_determinism.py::test_exclude_group_help_prints_every_group_and_exits_zero", `name`: "test_exclude_group_help_prints_every_group_and_exits_zero", `qualname`: "test_exclude_group_help_prints_every_group_and_exits_zero", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 411, `end_line`: 422, `signature`: "def test_exclude_group_help_prints_every_group_and_exits_zero(capsys):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_discovery_sort_key_is_posix"}) SET n += {`id`: "sym:tests/test_determinism.py::test_discovery_sort_key_is_posix", `name`: "test_discovery_sort_key_is_posix", `qualname`: "test_discovery_sort_key_is_posix", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 426, `end_line`: 439, `signature`: "def test_discovery_sort_key_is_posix(tmp_path):", `docstring`: "Sorting on str(Path) would sort on \"\\\\\" on Windows and \"/\" elsewhere --\n    the same cross-machine divergence one level down from the os.walk bug.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_explain_path_knows_discover_never_indexes_an_index"}) SET n += {`id`: "sym:tests/test_determinism.py::test_explain_path_knows_discover_never_indexes_an_index", `name`: "test_explain_path_knows_discover_never_indexes_an_index", `qualname`: "test_explain_path_knows_discover_never_indexes_an_index", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 442, `end_line`: 478, `signature`: "def test_explain_path_knows_discover_never_indexes_an_index(tmp_path, capsys, monkeypatch):", `docstring`: "`explain-path .r2g/agent/nodes.jsonl` said INCLUDED; no build indexes it.\n\n    discover() skips the -o directory and any directory holding a repo2graph\n    agent/manifest.json before any other rule; explain-path must say so.", `entrypoint`: true, `reach`: 134};
MERGE (n:R2G:`File` {id: "file:tests/test_doc_consistency.py"}) SET n += {`id`: "file:tests/test_doc_consistency.py", `name`: "test_doc_consistency.py", `path`: "tests/test_doc_consistency.py", `lang`: "python", `file_type`: "code", `size`: 26584, `lines`: 631, `parse_errors`: 0, `chunked`: false};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::_pyproject_version"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::_pyproject_version", `name`: "_pyproject_version", `qualname`: "_pyproject_version", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 31, `end_line`: 40, `signature`: "def _pyproject_version() -> str:", `docstring`: "`pyproject.toml`'s `[project] version`, read by regex like\n    `scripts/version_surfaces.py` does -- `tomllib` is 3.11+ only and this\n    project's floor is 3.10, so a regex match on the one line that matters\n    avoids adding a TOML-parsing dependency just for this test."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_cli_commands_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_cli_commands_documented", `name`: "test_cli_commands_documented", `qualname`: "test_cli_commands_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 74, `end_line`: 93, `signature`: "def test_cli_commands_documented():", `docstring`: "Verify all CLI subcommands are documented in README.md and docs/cli.md.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_languages_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_languages_documented", `name`: "test_languages_documented", `qualname`: "test_languages_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 96, `end_line`: 119, `signature`: "def test_languages_documented():", `docstring`: "Verify every LANG_CFG grammar key is documented in README.md.\n\n    Word-boundary regexes, not plain substrings: `\"c\" in readme_text.lower()`\n    or `\"go\" in ...` is true of nearly any English prose regardless of\n    whether the language is mentioned, so those checks passed even with the\n    language name deleted from README.md. `\\\\bC\\\\b` (with a negative\n    lookahead so it doesn't also match the \"C\" inside \"C++\"/\"C#\") actually\n    requires the token to appear.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_language_scorecard_matches_the_generator"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_language_scorecard_matches_the_generator", `name`: "test_language_scorecard_matches_the_generator", `qualname`: "test_language_scorecard_matches_the_generator", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 122, `end_line`: 160, `signature`: "def test_language_scorecard_matches_the_generator():", `docstring`: "The scorecard table in docs/architecture.md is what the generator emits today.\n\n    `scripts/generate_language_scorecard.py` shipped with no consumer: nothing in\n    docs/, README or CI referenced it, and its own docstring pointed at a\n    `docs/LANGUAGE_SCORECARD.json` that was never committed. A generator whose\n    output nobody reads stops being run, and then stops being right -- it scores\n    `LANG_CFG` by introspection, so every language added or extended moves these\n    numbers silently.\n\n    Pinning the rendered table means adding a language fails here until the table\n    is regenerated", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_action_inputs_and_outputs_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_action_inputs_and_outputs_documented", `name`: "test_action_inputs_and_outputs_documented", `qualname`: "test_action_inputs_and_outputs_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 163, `end_line`: 185, `signature`: "def test_action_inputs_and_outputs_documented():", `docstring`: "Verify every input and output in action.yml is documented in docs/cli.md.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_mcp_tools_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_mcp_tools_documented", `name`: "test_mcp_tools_documented", `qualname`: "test_mcp_tools_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 188, `end_line`: 198, `signature`: "def test_mcp_tools_documented():", `docstring`: "Verify every registered tool in repo2graph.mcp is documented in docs/mcp.md.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_citation_cff_matches_pyproject"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_citation_cff_matches_pyproject", `name`: "test_citation_cff_matches_pyproject", `qualname`: "test_citation_cff_matches_pyproject", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 201, `end_line`: 218, `signature`: "def test_citation_cff_matches_pyproject():", `docstring`: "Issue #404: CITATION.cff must parse and stay in lockstep with pyproject.toml.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_npm_launcher_version_matches_pyproject"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_npm_launcher_version_matches_pyproject", `name`: "test_npm_launcher_version_matches_pyproject", `qualname`: "test_npm_launcher_version_matches_pyproject", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 221, `end_line`: 235, `signature`: "def test_npm_launcher_version_matches_pyproject():", `docstring`: "Issue #399: the npx launcher's package.json version stays paired with the PyPI release.\n\n    `npm/README.md`'s \"Release story\" section promises the two are published from the same\n    tag; this is the machine-checkable half of that promise.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_starter_questions_match_the_docs_verbatim"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_starter_questions_match_the_docs_verbatim", `name`: "test_starter_questions_match_the_docs_verbatim", `qualname`: "test_starter_questions_match_the_docs_verbatim", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 238, `end_line`: 257, `signature`: "def test_starter_questions_match_the_docs_verbatim():", `docstring`: "The five starter prompts are authored once, in repo2graph/demo.py.\n\n    README.md renders them and `repo2graph demo` runs them, so a prompt edited\n    in one place and not the other would leave the docs telling users to run\n    something the demo never exercises. Both the template form (what a reader\n    copies onto their own repo) and the one-line rationale beside it are pinned.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_every_exclusion_group_is_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_every_exclusion_group_is_documented", `name`: "test_every_exclusion_group_is_documented", `qualname`: "test_every_exclusion_group_is_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 260, `end_line`: 278, `signature`: "def test_every_exclusion_group_is_documented():", `docstring`: "`--exclude-group` names come from one table; the docs must list them all.\n\n    A group added to `exclusions.GROUPS` and not documented is a flag nobody\n    can discover; a group documented and not implemented is a flag that\n    errors.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_indexing_doc_names_determinism_tests_that_exist"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_indexing_doc_names_determinism_tests_that_exist", `name`: "test_indexing_doc_names_determinism_tests_that_exist", `qualname`: "test_indexing_doc_names_determinism_tests_that_exist", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 281, `end_line`: 301, `signature`: "def test_indexing_doc_names_determinism_tests_that_exist():", `docstring`: "architecture.md's guarantee table points at specific tests by name.\n\n    A renamed or deleted test would leave the documented guarantee pointing\n    at nothing while still reading as though it were enforced.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_git_metadata_fields_are_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_git_metadata_fields_are_documented", `name`: "test_git_metadata_fields_are_documented", `qualname`: "test_git_metadata_fields_are_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 304, `end_line`: 314, `signature`: "def test_git_metadata_fields_are_documented():", `docstring`: "Every provenance field `index-status` surfaces is named in architecture.md.\n\n    `manifest.json`'s `source_revision` is a public surface -- `--json`\n    prints it verbatim -- so a field added without a doc edit is an\n    undocumented API. The *shape* of the report is asserted against a real\n    index in tests/test_index_status.py, not by scraping this source.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_cli_doc_names_every_doctor_check_that_exists"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_cli_doc_names_every_doctor_check_that_exists", `name`: "test_cli_doc_names_every_doctor_check_that_exists", `qualname`: "test_cli_doc_names_every_doctor_check_that_exists", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 317, `end_line`: 332, `signature`: "def test_cli_doc_names_every_doctor_check_that_exists():", `docstring`: "docs/cli.md lists the doctor checks by the name doctor actually prints.\n\n    A check renamed or dropped without a doc edit leaves the list pointing at\n    output that never appears; a check added without one leaves it undocumented.\n    Asserted against the report a real run produces, not against the source.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_the_shipped_doc_set_is_the_documented_one"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_the_shipped_doc_set_is_the_documented_one", `name`: "test_the_shipped_doc_set_is_the_documented_one", `qualname`: "test_the_shipped_doc_set_is_the_documented_one", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 335, `end_line`: 359, `signature`: "def test_the_shipped_doc_set_is_the_documented_one():", `docstring`: "`docs/` is five reference pages, and adding a sixth is a decision.\n\n    The tree previously grew to 29 documents -- compliance theater, speculative\n    RFCs, roadmap trackers and three overlapping architecture pages -- with an\n    index file to make them findable. Pinning the set means a new page has to be\n    added here deliberately, which is where the \"should this be a section of an\n    existing page\" question gets asked.\n\n    `comparison.md` is the deliberate fifth. The consolidation dropped it and\n    repointed README's \"how it compares with Serena, Aider, ...\" link at\n    architecture.md,", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_architecture_doc_names_the_standard_edge_fields"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_architecture_doc_names_the_standard_edge_fields", `name`: "test_architecture_doc_names_the_standard_edge_fields", `qualname`: "test_architecture_doc_names_the_standard_edge_fields", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 362, `end_line`: 378, `signature`: "def test_architecture_doc_names_the_standard_edge_fields():", `docstring`: "docs/architecture.md lists every field an edge can carry.\n\n    It used to say `CALLS_EXTERNAL` carries no `confidence` -- true until every\n    edge type gained the standard trio, and wrong afterwards. The edge-metadata\n    section and `edgemeta.STANDARD_FIELDS` describe the same records.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_integration_guides_quote_the_real_mcp_bounds"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_integration_guides_quote_the_real_mcp_bounds", `name`: "test_integration_guides_quote_the_real_mcp_bounds", `qualname`: "test_integration_guides_quote_the_real_mcp_bounds", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 386, `end_line`: 430, `signature`: "def test_integration_guides_quote_the_real_mcp_bounds():", `docstring`: "The guides publish the argument ceilings as a contract with the reader.\n\n    A clamp loosened in mcp.py without a doc edit leaves a guide promising a\n    bound the server no longer enforces.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::_cli_doc_section"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::_cli_doc_section", `name`: "_cli_doc_section", `qualname`: "_cli_doc_section", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 433, `end_line`: 439, `signature`: "def _cli_doc_section(command: str) -> str:", `docstring`: "The `## `command` ...` section of docs/cli.md, up to the next `## `` heading."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::_help_long_flags"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::_help_long_flags", `name`: "_help_long_flags", `qualname`: "_help_long_flags", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 442, `end_line`: 455, `signature`: "def _help_long_flags(argv: list[str]) -> set[str]:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_cli_doc_tables_cover_every_flag_of_the_retrieval_commands"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_cli_doc_tables_cover_every_flag_of_the_retrieval_commands", `name`: "test_cli_doc_tables_cover_every_flag_of_the_retrieval_commands", `qualname`: "test_cli_doc_tables_cover_every_flag_of_the_retrieval_commands", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 458, `end_line`: 477, `signature`: "def test_cli_doc_tables_cover_every_flag_of_the_retrieval_commands():", `docstring`: "`build --max-call-candidates` and `--max-nodes` were in --help, not docs/cli.md.\n\n    `rag` was added to this list after its table was found to be missing\n    `--secret-policy`, `--secret-keyword` and `--secret-dir`: the three commands\n    originally covered here were the ones that had drifted once, and `rag` then\n    drifted silently because nothing checked it.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_build_reports_the_resolved_absolute_out_path"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_build_reports_the_resolved_absolute_out_path", `name`: "test_build_reports_the_resolved_absolute_out_path", `qualname`: "test_build_reports_the_resolved_absolute_out_path", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 480, `end_line`: 502, `signature`: "def test_build_reports_the_resolved_absolute_out_path(tmp_path, capsys):", `docstring`: "`build` reports the resolved index path, not the `-o` argument verbatim.\n\n    A relative `out` in the report sends a reader looking in whichever directory\n    they happen to be in. This was previously guarded only by a sample pasted\n    into the quickstart, so it broke silently when that page moved; asserting it\n    against the real report keeps it pinned wherever the docs go.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::_all_real_long_flags"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::_all_real_long_flags", `name`: "_all_real_long_flags", `qualname`: "_all_real_long_flags", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 528, `end_line`: 539, `signature`: "def _all_real_long_flags() -> set[str]:", `docstring`: "Every `--flag` the shipped CLI or the MCP server actually accepts."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_unreleased_changelog_does_not_advertise_flags_that_do_not_exist"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_unreleased_changelog_does_not_advertise_flags_that_do_not_exist", `name`: "test_unreleased_changelog_does_not_advertise_flags_that_do_not_exist", `qualname`: "test_unreleased_changelog_does_not_advertise_flags_that_do_not_exist", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 542, `end_line`: 567, `signature`: "def test_unreleased_changelog_does_not_advertise_flags_that_do_not_exist():", `docstring`: "A removed subsystem left its flags behind in `[Unreleased]` (`647e76f3`).\n\n    The HTTP transport and the OIDC/JWT auth engine were deleted, but the\n    section kept advertising `--http-insecure-ok`, `--trust-proxy`,\n    `--rate-limit-requests` and six more. That section is not just prose:\n    `.github/workflows/publish.yml` reads it and uses it as the GitHub Release\n    body, so the next release would have shipped notes describing flags that\n    fail as unknown arguments.\n\n    The `### Removed` subsection is exempt by design -- naming a flag that no\n    longer exists is exactly its job.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_examples_table_matches_the_recorded_run"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_examples_table_matches_the_recorded_run", `name`: "test_examples_table_matches_the_recorded_run", `qualname`: "test_examples_table_matches_the_recorded_run", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 583, `end_line`: 630, `signature`: "def test_examples_table_matches_the_recorded_run():", `docstring`: "`examples/README.md`'s table must be what `benchmarks/results.json` records.\n\n    That page states every number in it \"came from an actual run recorded in\n    ../benchmarks/results.json, never typed in by hand\" -- but the table is\n    hand-maintained (`generate_examples.py` writes `examples/<id>/README.md` and\n    `results.json`, never the index page), so the claim rested on whoever last\n    regenerated remembering to retype five rows. This is the check that was\n    missing when all five examples were regenerated from 1.6.0 to 2.2.0.\n\n    Deliberately *not* asserted here: that `repo2graph_vers", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_examples_table_matches_the_recorded_run._n"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_examples_table_matches_the_recorded_run._n", `name`: "_n", `qualname`: "test_examples_table_matches_the_recorded_run._n", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 612, `end_line`: 613, `signature`: "def _n(text: str) -> int:", `docstring`: ""};
