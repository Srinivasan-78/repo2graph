MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parsecache.py::ChunkedParsedFile"}) SET n += {`id`: "sym:repo2graph/parsecache.py::ChunkedParsedFile", `name`: "ChunkedParsedFile", `qualname`: "ChunkedParsedFile", `kind`: "class", `path`: "repo2graph/parsecache.py", `lang`: "python", `start_line`: 12, `end_line`: 21, `signature`: "class ChunkedParsedFile(ParsedFile):", `docstring`: "What `_chunk_and_parse` produces: a `ParsedFile` plus what it could not read.\n\n    `undecodable_slices` does not belong on `ParsedFile` itself -- it is\n    meaningless for the whole-file reader, which either decodes a file or does\n    not. Every reader of the field uses `getattr(pf, ..., 0)`, the same way\n    `build()` already reads `is_chunked` and `used_cpp`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parsecache.py::cache_entry"}) SET n += {`id`: "sym:repo2graph/parsecache.py::cache_entry", `name`: "cache_entry", `qualname`: "cache_entry", `kind`: "function", `path`: "repo2graph/parsecache.py", `lang`: "python", `start_line`: 68, `end_line`: 117, `signature`: "def cache_entry(\n    lang: str | None, size: int, lines: int, pf: ParsedFile | None, digest: str\n) -> dict[str, Any]:", `docstring`: "Serialise one file's parse result for `parse.cache.json`.\n\n    Args:\n        lang: Language id the file was parsed as, or None for a non-code file.\n        size: Length in bytes of the file as indexed.\n        lines: Newline count + 1, as recorded on the file node.\n        pf: The `ParsedFile` for this file, or None if it was not parsed.\n        digest: sha256 hex digest of the bytes this entry describes.\n\n    Returns:\n        A JSON-serialisable dict holding everything `build()` needs to rebuild\n        this file's nodes and edges without re-reading or re-parsing it."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parsecache.py::entry_read"}) SET n += {`id`: "sym:repo2graph/parsecache.py::entry_read", `name`: "entry_read", `qualname`: "entry_read", `kind`: "function", `path`: "repo2graph/parsecache.py", `lang`: "python", `start_line`: 120, `end_line`: 171, `signature`: "def entry_read(entry: dict[str, Any]) -> tuple[int, int, ParsedFile | None, str] | None:", `docstring`: "Rebuild `_read_and_parse`'s result tuple from a cache entry.\n\n    Args:\n        entry: One record out of `parse.cache.json`.\n\n    Returns:\n        The `(size, lines, ParsedFile | None, digest)` tuple the build loop\n        consumes, or None if the entry is malformed. A malformed entry is a\n        cache miss, never an exception: a corrupt cache must cost a re-parse,\n        not the build."};
MERGE (n:R2G:`File` {id: "file:repo2graph/parsepool.py"}) SET n += {`id`: "file:repo2graph/parsepool.py", `name`: "parsepool.py", `path`: "repo2graph/parsepool.py", `lang`: "python", `file_type`: "code", `size`: 19087, `lines`: 501, `parse_errors`: 0, `chunked`: false};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parsepool.py::_context"}) SET n += {`id`: "sym:repo2graph/parsepool.py::_context", `name`: "_context", `qualname`: "_context", `kind`: "function", `path`: "repo2graph/parsepool.py", `lang`: "python", `start_line`: 70, `end_line`: 85, `signature`: "def _context() -> Any:", `docstring`: "Where workers come from: forkserver on POSIX, the platform default elsewhere.\n\n    Not plain fork: the parent is often multi-threaded (pytest-xdist, the MCP\n    server, a previous pool's management threads), and a child forked while\n    another thread holds a lock can wedge before it runs a line. forkserver\n    forks from a clean single-threaded server instead, and preloading the\n    parser module keeps each worker's start-up cheap."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parsepool.py::PoolUnavailable"}) SET n += {`id`: "sym:repo2graph/parsepool.py::PoolUnavailable", `name`: "PoolUnavailable", `qualname`: "PoolUnavailable", `kind`: "class", `path`: "repo2graph/parsepool.py", `lang`: "python", `start_line`: 88, `end_line`: 89, `signature`: "class PoolUnavailable(RuntimeError):", `docstring`: "The pool broke before it parsed anything: no workers to supervise."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parsepool.py::claim_slot"}) SET n += {`id`: "sym:repo2graph/parsepool.py::claim_slot", `name`: "claim_slot", `qualname`: "claim_slot", `kind`: "function", `path`: "repo2graph/parsepool.py", `lang`: "python", `start_line`: 92, `end_line`: 107, `signature`: "def claim_slot(watch: Any) -> None:", `docstring`: "In a new worker: take a free slot in `watch` and cap this process's memory.\n\n    `watch` is `(shared array, memory cap in MB)` as `_round` builds it: the cap\n    travels with it because a worker started by forkserver or spawn sees this\n    module's defaults, not whatever the parent set."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parsepool.py::_cap_memory"}) SET n += {`id`: "sym:repo2graph/parsepool.py::_cap_memory", `name`: "_cap_memory", `qualname`: "_cap_memory", `kind`: "function", `path`: "repo2graph/parsepool.py", `lang`: "python", `start_line`: 113, `end_line`: 138, `signature`: "def _cap_memory(memory_mb: int) -> None:", `docstring`: "Bound this worker's address space, so a runaway parse kills only it."};
