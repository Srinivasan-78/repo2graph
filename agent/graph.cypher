MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/derived.py::_add_inject"}) SET n += {`id`: "sym:repo2graph/derived.py::_add_inject", `name`: "_add_inject", `qualname`: "_add_inject", `kind`: "function", `path`: "repo2graph/derived.py", `lang`: "python", `start_line`: 420, `end_line`: 436, `signature`: "def _add_inject(\n    g: Graph,\n    rel: str,\n    sid: str,\n    fact: dict[str, Any],\n    imported_files: dict[str, set[str]],\n    import_aliases: dict[str, dict[str, tuple[str, str | None]]],\n    named_in: Callable[[str, Iterable[str]], list[str]],\n) -> None:\n    # `module.provider` binds on its las", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/derived.py::_add_model"}) SET n += {`id`: "sym:repo2graph/derived.py::_add_model", `name`: "_add_model", `qualname`: "_add_model", `kind`: "function", `path`: "repo2graph/derived.py", `lang`: "python", `start_line`: 439, `end_line`: 493, `signature`: "def _add_model(\n    g: Graph,\n    rel: str,\n    sid: str,\n    group: list[dict[str, Any]],\n    imported_files: dict[str, set[str]],\n    import_aliases: dict[str, dict[str, tuple[str, str | None]]],\n    named_in: Callable[[str, Iterable[str]], list[str]],\n) -> None:", `docstring`: "One `MODELS` edge for every relation this class declares to one target.\n\n    `group` is every field naming the same model. The edge cites the first\n    one's line, because that is the one a reader checking the claim will find,\n    and `fields`/`count` say how many more there are -- the same choice a\n    `CALLS` edge makes for repeated calls of one name."};
