MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_github_build_is_reported_as_remote_not_stale"}) SET n += {`id`: "sym:tests/test_index_status.py::test_github_build_is_reported_as_remote_not_stale", `name`: "test_github_build_is_reported_as_remote_not_stale", `qualname`: "test_github_build_is_reported_as_remote_not_stale", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 621, `end_line`: 661, `signature`: "def test_github_build_is_reported_as_remote_not_stale(tmp_path, monkeypatch, capsys):", `docstring`: "`repo2graph github owner/repo -o dir`: the temp clone is gone afterwards.\n\n    Comparing against cwd read as `[STALE] N added` and suggested `build <cwd>`,\n    which indexes the wrong tree. It must say freshness cannot be checked and\n    suggest the github command instead.", `entrypoint`: true, `reach`: 258};
