MERGE (n:R2G:`Symbol` {id: "sym:tests/test_federated.py::test_a_budget_too_small_for_the_header_packs_nothing"}) SET n += {`id`: "sym:tests/test_federated.py::test_a_budget_too_small_for_the_header_packs_nothing", `name`: "test_a_budget_too_small_for_the_header_packs_nothing", `qualname`: "test_a_budget_too_small_for_the_header_packs_nothing", `kind`: "function", `path`: "tests/test_federated.py", `lang`: "python", `start_line`: 95, `end_line`: 115, `signature`: "def test_a_budget_too_small_for_the_header_packs_nothing(two):", `docstring`: "A header that does not fit used to switch the budget off entirely (#482).\n\n    `_fit` reads 0 as \"no ceiling\", which is the caller's sentinel; it was also\n    what `budget - len(header)` came to once the header outgrew the budget, so\n    every merged chunk came back. Measured at 25x the stated ceiling, with\n    `truncated` reporting False.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_federated.py::test_a_budget_of_zero_still_means_unbounded"}) SET n += {`id`: "sym:tests/test_federated.py::test_a_budget_of_zero_still_means_unbounded", `name`: "test_a_budget_of_zero_still_means_unbounded", `qualname`: "test_a_budget_of_zero_still_means_unbounded", `kind`: "function", `path`: "tests/test_federated.py", `lang`: "python", `start_line`: 119, `end_line`: 128, `signature`: "def test_a_budget_of_zero_still_means_unbounded(two, key):", `docstring`: "The caller's 0 is the unlimited sentinel, as in `Index.pack_context`.\n\n    The #482 fix has to keep this distinguishable from a remainder of 0, which\n    is why `_fit` takes None rather than reading 0 two ways.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_federated.py::test_the_header_is_bounded_by_the_budget"}) SET n += {`id`: "sym:tests/test_federated.py::test_the_header_is_bounded_by_the_budget", `name`: "test_the_header_is_bounded_by_the_budget", `qualname`: "test_the_header_is_bounded_by_the_budget", `kind`: "function", `path`: "tests/test_federated.py", `lang`: "python", `start_line`: 131, `end_line`: 145, `signature`: "def test_the_header_is_bounded_by_the_budget(two):", `docstring`: "The header is counted against the budget, so it is also cut by it (#482).", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_federated.py::test_the_pack_carries_every_declared_packresult_key"}) SET n += {`id`: "sym:tests/test_federated.py::test_the_pack_carries_every_declared_packresult_key", `name`: "test_the_pack_carries_every_declared_packresult_key", `qualname`: "test_the_pack_carries_every_declared_packresult_key", `kind`: "function", `path`: "tests/test_federated.py", `lang`: "python", `start_line`: 148, `end_line`: 158, `signature`: "def test_the_pack_carries_every_declared_packresult_key(two):", `docstring`: "A federated `rag --json` promises the same shape as a single-index one.\n\n    Six keys were missing, `token_count_method` among them -- so a consumer\n    reading how `tokens_used` was counted got nothing on this path (#482).", `entrypoint`: true};
