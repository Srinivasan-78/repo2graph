MERGE (n:R2G:`Symbol` {id: "sym:.github/scripts/prod-igy.js::sanitizeAiText"}) SET n += {`id`: "sym:.github/scripts/prod-igy.js::sanitizeAiText", `name`: "sanitizeAiText", `qualname`: "sanitizeAiText", `kind`: "function", `path`: ".github/scripts/prod-igy.js", `lang`: "javascript", `start_line`: 237, `end_line`: 273, `signature`: "function sanitizeAiText(text, maxChars = 4000)", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:.github/scripts/prod-igy.js::buildDiffExcerpt"}) SET n += {`id`: "sym:.github/scripts/prod-igy.js::buildDiffExcerpt", `name`: "buildDiffExcerpt", `qualname`: "buildDiffExcerpt", `kind`: "function", `path`: ".github/scripts/prod-igy.js", `lang`: "javascript", `start_line`: 290, `end_line`: 307, `signature`: "function buildDiffExcerpt(files, diffChars)", `docstring`: "// ---------------------------------------------------------------------------\n// Context assembly\n//\n// The model gets a pre-assembled, bounded document and no tools. It cannot\n// read the repository, run a command, or follow an instruction written in the\n// PR -- the only thing it can do is return one object matching AI_OUTPUT_SCHEMA.\n// That is what makes the token ceiling enforceable and what makes it safe to\n// run under pull_request_target, where the head is fork-controlled: the fork's\n// diff arrives as data via the API and is never checked out or executed.\n// --------------------------"};
MERGE (n:R2G:`Symbol` {id: "sym:.github/scripts/prod-igy.js::buildAiUserContext"}) SET n += {`id`: "sym:.github/scripts/prod-igy.js::buildAiUserContext", `name`: "buildAiUserContext", `qualname`: "buildAiUserContext", `kind`: "function", `path`: ".github/scripts/prod-igy.js", `lang`: "javascript", `start_line`: 309, `end_line`: 335, `signature`: "function buildAiUserContext({ pr, files, deterministic, cfg })", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:.github/scripts/prod-igy.js::buildAiSystemPrompt"}) SET n += {`id`: "sym:.github/scripts/prod-igy.js::buildAiSystemPrompt", `name`: "buildAiSystemPrompt", `qualname`: "buildAiSystemPrompt", `kind`: "function", `path`: ".github/scripts/prod-igy.js", `lang`: "javascript", `start_line`: 337, `end_line`: 373, `signature`: "function buildAiSystemPrompt()", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:.github/scripts/prod-igy.js::runAiEnrichment"}) SET n += {`id`: "sym:.github/scripts/prod-igy.js::runAiEnrichment", `name`: "runAiEnrichment", `qualname`: "runAiEnrichment", `kind`: "function", `path`: ".github/scripts/prod-igy.js", `lang`: "javascript", `start_line`: 384, `end_line`: 495, `signature`: "async function runAiEnrichment({ pr, files, deterministic, cfg, core })", `docstring`: "// Always returns `{ ai, reason }`, never throws.\n//\n// prod-igy predates the AI step and worked without it; the AI is a layer on\n// top, not a dependency. Every failure below -- no SDK, no key, a revoked key,\n// an unreachable endpoint, a rate limit, a refusal, a malformed body -- lands\n// on the same path: `ai` is null, `reason` says what happened, and the caller\n// posts the original deterministic comment exactly as it did before any of\n// this existed. There is no failure of the model step that costs a PR its\n// labels, its rebase warning, or its conflict notice."};
MERGE (n:R2G:`Symbol` {id: "sym:.github/scripts/prod-igy.js::runAiEnrichment.skip"}) SET n += {`id`: "sym:.github/scripts/prod-igy.js::runAiEnrichment.skip", `name`: "skip", `qualname`: "runAiEnrichment.skip", `kind`: "function", `path`: ".github/scripts/prod-igy.js", `lang`: "javascript", `start_line`: 385, `end_line`: 388, `signature`: "skip = (reason, logLine) => {\n    core.warning(`[prod-igy] AI skipped: ${logLine || reason}`);\n    return { ai: null, reason };\n  }", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:.github/scripts/prod-igy.js::escapeMdRef"}) SET n += {`id`: "sym:.github/scripts/prod-igy.js::escapeMdRef", `name`: "escapeMdRef", `qualname`: "escapeMdRef", `kind`: "function", `path`: ".github/scripts/prod-igy.js", `lang`: "javascript", `start_line`: 499, `end_line`: 501, `signature`: "function escapeMdRef(ref)", `docstring`: "// git check-ref-format allows backticks in a ref name. Interpolating a raw\n// fork head/base into markdown `...` would let that ref close the span."};
