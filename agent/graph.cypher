MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::AuthError"}) SET n += {`id`: "sym:repo2graph/auth.py::AuthError", `name`: "AuthError", `qualname`: "AuthError", `kind`: "class", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 89, `end_line`: 100, `signature`: "class AuthError(Exception):", `docstring`: "A request that must be refused, carrying the status to refuse it with.\n\n    Args:\n        message: Human-readable reason, safe to log. Never contains the token.\n        status: HTTP status to return; 401 unless the caller says otherwise."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::AuthError.__init__"}) SET n += {`id`: "sym:repo2graph/auth.py::AuthError.__init__", `name`: "__init__", `qualname`: "AuthError.__init__", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 97, `end_line`: 100, `signature`: "def __init__(self, message: str, status: int = 401):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::Identity"}) SET n += {`id`: "sym:repo2graph/auth.py::Identity", `name`: "Identity", `qualname`: "Identity", `kind`: "class", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 104, `end_line`: 117, `signature`: "class Identity:", `docstring`: "Who made a request, as far as the server can tell.\n\n    Attributes:\n        subject: The token's `sub` claim under OIDC, \"anonymous\" with no auth\n            configured, or \"bearer\" for a shared static token, which by\n            construction identifies no one in particular.\n        mode: Which authentication mode admitted this request.\n        claims: The validated JWT claims, empty for the other two modes."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::b64url_decode"}) SET n += {`id`: "sym:repo2graph/auth.py::b64url_decode", `name`: "b64url_decode", `qualname`: "b64url_decode", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 120, `end_line`: 138, `signature`: "def b64url_decode(text: str) -> bytes:", `docstring`: "Decode base64url without padding, as every JWT field is encoded.\n\n    Args:\n        text: The base64url segment.\n\n    Returns:\n        The decoded bytes.\n\n    Raises:\n        AuthError: If the segment is not valid base64url."};
