MERGE (n:R2G:Symbol {id: "sym:repo2graph/cli.py::verify_rag"}) SET n += {`id`: "sym:repo2graph/cli.py::verify_rag", `name`: "verify_rag", `qualname`: "verify_rag", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 485, `end_line`: 553, `signature`: "def verify_rag(idx, out, embed_model=None) -> tuple[dict, str | None]:", `docstring`: "Self-test the dense-retrieval path against one index.\n\n    Answers the four questions that distinguish \"dense retrieval is working\"\n    from \"dense retrieval silently is not\": are there vectors at all, which\n    model and width were they built with, does the active embedder agree, and\n    does every chunk actually have one.\n\n    Args:\n        idx: An open `Index`.\n        out: The index directory, for error messages.\n        embed_model: Model id to check against, or None for the built-in\n            default. Never defaulted to the index's own `model_id` -- comparing\n            a value with i"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cli.py::cmd_verify_rag"}) SET n += {`id`: "sym:repo2graph/cli.py::cmd_verify_rag", `name`: "cmd_verify_rag", `qualname`: "cmd_verify_rag", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 556, `end_line`: 575, `signature`: "def cmd_verify_rag(args):", `docstring`: "`--verify-rag`: report on the index's dense path, non-zero if broken."};
