MERGE (n:R2G:Symbol {id: "sym:tests/conftest.py::ScriptedEmbedder"}) SET n += {`id`: "sym:tests/conftest.py::ScriptedEmbedder", `name`: "ScriptedEmbedder", `qualname`: "ScriptedEmbedder", `kind`: "class", `path`: "tests/conftest.py", `lang`: "python", `start_line`: 201, `end_line`: 223, `signature`: "class ScriptedEmbedder:", `docstring`: "Returns a pre-computed list of vectors, ignoring the texts it is given.\n\n    `score_rrf(embedder=...)` calls `encode([query] + candidate_texts)` with the\n    candidates in BM25 order, so a test that has already computed that order can\n    hand back exactly the similarities it wants and reason about the fused\n    ranking without asserting on any score value."};
