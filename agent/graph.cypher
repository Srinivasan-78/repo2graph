MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::disambiguate_key"}) SET n += {`id`: "sym:repo2graph/parse.py::disambiguate_key", `name`: "disambiguate_key", `qualname`: "disambiguate_key", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 680, `end_line`: 695, `signature`: "def disambiguate_key(qualname: str, line: int, used: set[str]) -> str:", `docstring`: "Empty string if `qualname` is still free in `used`, else a stable `@L<line>` key.\n\n    Deterministic: depends only on source order and line numbers. Two same-named\n    definitions on one line (minified code) fall back to `@L<line>~<n>`."};
