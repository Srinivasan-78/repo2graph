MERGE (n:R2G:Symbol {id: "sym:repo2graph/cli.py::_nonneg"}) SET n += {`id`: "sym:repo2graph/cli.py::_nonneg", `name`: "_nonneg", `qualname`: "_nonneg", `kind`: "function", `path`: "repo2graph/cli.py", `lang`: "python", `start_line`: 809, `end_line`: 818, `signature`: "def _nonneg(value: str) -> int:", `docstring`: "argparse type: a base-10 int >= 0 (0 has a defined meaning for every\n    numeric flag here; a negative silently mis-slices or breaks a subprocess)."};
