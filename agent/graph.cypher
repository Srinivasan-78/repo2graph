MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::symbol_key"}) SET n += {`id`: "sym:repo2graph/parse.py::symbol_key", `name`: "symbol_key", `qualname`: "symbol_key", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 664, `end_line`: 672, `signature`: "def symbol_key(sym: Symbol) -> str:", `docstring`: "The part of a symbol's node id after `sym:<path>::`.\n\n    Equal to `qualname` for every first definition of a name in a file; a later\n    definition with the same qualname (Java/C#/Kotlin/Swift/C++ overloads, a\n    Python conditional redefinition) carries `@L<line>` so it gets a node and\n    a chunk of its own instead of silently collapsing into the first one."};
