MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::test_every_surface_matches_something_in_every_file_it_claims"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_every_surface_matches_something_in_every_file_it_claims", `name`: "test_every_surface_matches_something_in_every_file_it_claims", `qualname`: "test_every_surface_matches_something_in_every_file_it_claims", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 48, `end_line`: 55, `signature`: "def test_every_surface_matches_something_in_every_file_it_claims():", `docstring`: "A pattern that matches nothing is a check that has become a no-op, which\n    is exactly how the documented `@v1` survived the 2.0.0 release. `findings`\n    reports that as a `<no match>` sentinel rather than silently passing.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_version_surfaces.py::test_the_repo_is_currently_consistent"}) SET n += {`id`: "sym:tests/test_version_surfaces.py::test_the_repo_is_currently_consistent", `name`: "test_the_repo_is_currently_consistent", `qualname`: "test_the_repo_is_currently_consistent", `kind`: "function", `path`: "tests/test_version_surfaces.py", `lang`: "python", `start_line`: 58, `end_line`: 63, `signature`: "def test_the_repo_is_currently_consistent():", `docstring`: "check_version.py is a required CI step; this is the same assertion at\n    unit level so a failure names the surface rather than a subprocess exit.", `entrypoint`: true};
