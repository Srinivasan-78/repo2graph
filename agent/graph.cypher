MERGE (n:R2G:Symbol {id: "sym:repo2graph/parse.py::_split_bases"}) SET n += {`id`: "sym:repo2graph/parse.py::_split_bases", `name`: "_split_bases", `qualname`: "_split_bases", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 715, `end_line`: 735, `signature`: "def _split_bases(text: str) -> list[str]:", `docstring`: "Split a base-class list on top-level commas only.\n\n    A generic's type arguments (`Generic[T, U]`, `Handler<Request, Response>`)\n    contain commas that must not split the base list itself, so track bracket\n    depth and only split where it is zero."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/parse.py::_clean_base"}) SET n += {`id`: "sym:repo2graph/parse.py::_clean_base", `name`: "_clean_base", `qualname`: "_clean_base", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 738, `end_line`: 745, `signature`: "def _clean_base(text: str) -> str:", `docstring`: "'public B', 'extends B', '< B' -> 'B'."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/parse.py::_base_clauses"}) SET n += {`id`: "sym:repo2graph/parse.py::_base_clauses", `name`: "_base_clauses", `qualname`: "_base_clauses", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 748, `end_line`: 761, `signature`: "def _base_clauses(node):", `docstring`: "Supertype clauses of a definition, preferring the innermost one.\n\n    TypeScript wraps extends_clause/implements_clause in a class_heritage and\n    Java wraps a type_list in super_interfaces; the outer node's text would join\n    several names into one string, so descend when a child is a clause too."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/parse.py::_bases_with_details"}) SET n += {`id`: "sym:repo2graph/parse.py::_bases_with_details", `name`: "_bases_with_details", `qualname`: "_bases_with_details", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 764, `end_line`: 822, `signature`: "def _bases_with_details(src: bytes, node, lang: str) -> tuple[list[str], list[dict]]:", `docstring`: "Extract supertype names along with their relationship subtype and raw expression."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/parse.py::_cpp_available"}) SET n += {`id`: "sym:repo2graph/parse.py::_cpp_available", `name`: "_cpp_available", `qualname`: "_cpp_available", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 828, `end_line`: 862, `signature`: "def _cpp_available() -> bool:", `docstring`: "Is a usable `cpp` on PATH? Memoizing only a successful probe.\n\n    `cpp --version` answers the same thing for the life of the process, but it\n    used to be re-run per erroring C/C++ file -- two spawns per file instead of\n    one, which dominates the macro-aware retry's cost on a large C tree and on\n    Windows, where spawn is expensive and parse_all may be fanning this out\n    across a ProcessPoolExecutor.\n\n    Same shape as fetch._git_version, for the same reason: a transient failure\n    (fd exhaustion, fork failure, ...) must not be cached forever, or one bad\n    moment disables the cpp fal"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/parse.py::parse_import_details"}) SET n += {`id`: "sym:repo2graph/parse.py::parse_import_details", `name`: "parse_import_details", `qualname`: "parse_import_details", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 865, `end_line`: 1115, `signature`: "def parse_import_details(raw: str, lang: str) -> list[ImportDetail]:", `docstring`: "Extract structured import metadata (modules, names, aliases)."};
