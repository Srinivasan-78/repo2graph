MERGE (n:R2G:`Symbol` {id: "sym:.github/scripts/prod-igy.js::fetchCheckSummary"}) SET n += {`id`: "sym:.github/scripts/prod-igy.js::fetchCheckSummary", `name`: "fetchCheckSummary", `qualname`: "fetchCheckSummary", `kind`: "function", `path`: ".github/scripts/prod-igy.js", `lang`: "javascript", `start_line`: 800, `end_line`: 831, `signature`: "async function fetchCheckSummary({ github, owner, repo, headSha, core })", `docstring`: "// Check results for the PR head, read from the API -- never inferred, and never\n// asked of the model. `conclusion` is null while a run is still going, which is\n// the normal state on a freshly-pushed head, so \"in progress\" is a real bucket\n// and not an error. Returns null if the checks API is unavailable (the job may\n// be running without `checks: read`), in which case the section is omitted."};
