MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::atomic_write"}) SET n += {id: "sym:repo2graph/export.py::atomic_write", name: "atomic_write", qualname: "atomic_write", kind: "function", path: "repo2graph/export.py", lang: "python", start_line: 24, end_line: 43, signature: "def atomic_write(path: Path, mode: str = \"w\", **open_kw):", docstring: "Write via a sibling temp file renamed onto `path` only on a clean exit.\n\n    A crash, exception or Ctrl-C mid-write then leaves the previous artifact (or\n    none) intact rather than a truncated file that `query`/`map` would choke on.\n    The temp file is in the target's own directory, so os.replace is atomic."};
