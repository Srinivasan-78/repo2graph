MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_symbol_chunk_body_survives_unicode_line_separator"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_symbol_chunk_body_survives_unicode_line_separator", `name`: "test_symbol_chunk_body_survives_unicode_line_separator", `qualname`: "test_symbol_chunk_body_survives_unicode_line_separator", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1245, `end_line`: 1258, `signature`: "def test_symbol_chunk_body_survives_unicode_line_separator(tmp_path):", `docstring`: "Verify a file whose first line holds U+2028 must still slice each\n    later symbol's chunk from the right source lines. Currently, `splitlines()`\n    splits on U+2028 while tree-sitter row numbers do not, so the body comes out\n    as \"\\\\ndef uses_sep():\" and never contains \"return MSG\".", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_file_residual_excludes_symbol_body"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_file_residual_excludes_symbol_body", `name`: "test_file_residual_excludes_symbol_body", `qualname`: "test_file_residual_excludes_symbol_body", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1261, `end_line`: 1282, `signature`: "def test_file_residual_excludes_symbol_body(tmp_path):", `docstring`: "Verify the residual chunk holds only lines no symbol claimed. At\n    HEAD the same mis-slice pulls `return MSG` (the body of uses_sep) into the\n    residual and drops part of the real residual span.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_cochange_survives_non_ascii_filenames"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_cochange_survives_non_ascii_filenames", `name`: "test_cochange_survives_non_ascii_filenames", `qualname`: "test_cochange_survives_non_ascii_filenames", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1285, `end_line`: 1306, `signature`: "def test_cochange_survives_non_ascii_filenames(tmp_path):", `docstring`: "Verify two non-ASCII paths committed together three times\n    must yield a CO_CHANGE edge. Currently, `git log` runs with text=True and\n    core.quotepath=true, so the paths come back quoted/locale-decoded, never\n    match file_index, and the edge silently vanishes (or raises\n    UnicodeDecodeError on a non-UTF-8 locale).", `entrypoint`: true, `reach`: 171};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::FakeGitProc"}) SET n += {`id`: "sym:tests/test_repo2graph.py::FakeGitProc", `name`: "FakeGitProc", `qualname`: "FakeGitProc", `kind`: "class", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1309, `end_line`: 1333, `signature`: "class FakeGitProc:", `docstring`: "Stand-in for the `git log` child `add_cochange` streams .\n\n    add_cochange no longer calls run(capture_output=True), which handed back a\n    CompletedProcess with the whole blob attached; it opens a Popen and reads\n    the pipe in blocks, stopping at MAX_COCHANGE_BYTES. A fake therefore has to\n    behave like a process -- a readable stdout, plus the kill/poll/wait trio the\n    reaping path uses."};
