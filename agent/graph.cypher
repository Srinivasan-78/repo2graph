MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::test_crlf_injection_in_cors_headers_is_sanitized"}) SET n += {`id`: "sym:tests/test_http_transport.py::test_crlf_injection_in_cors_headers_is_sanitized", `name`: "test_crlf_injection_in_cors_headers_is_sanitized", `qualname`: "test_crlf_injection_in_cors_headers_is_sanitized", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 720, `end_line`: 766, `signature`: "def test_crlf_injection_in_cors_headers_is_sanitized(make_server):", `docstring`: "CodeQL alerts #8/#9: CRLF in Origin and Access-Control-Request-Headers\n    must be stripped so an attacker cannot inject arbitrary response headers.\n\n    Python's http.client rejects CRLF in headers on the *client* side, so we\n    must use a raw socket to actually deliver the malicious header to the server.", `entrypoint`: true, `reach`: 11};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::raw_exchange"}) SET n += {`id`: "sym:tests/test_http_transport.py::raw_exchange", `name`: "raw_exchange", `qualname`: "raw_exchange", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 778, `end_line`: 796, `signature`: "def raw_exchange(server, request_bytes, timeout=20):", `docstring`: "Send raw bytes at the server and read the whole response back.\n\n    Returned as latin-1 so the bytes survive byte-for-byte: these tests inspect\n    header framing, and a decode that repairs anything would repair exactly the\n    damage they are looking for."};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::head_and_body"}) SET n += {`id`: "sym:tests/test_http_transport.py::head_and_body", `name`: "head_and_body", `qualname`: "head_and_body", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 799, `end_line`: 802, `signature`: "def head_and_body(response):", `docstring`: "Split a raw response into its header lines and its body."};
MERGE (n:R2G:Symbol {id: "sym:tests/test_http_transport.py::status_of"}) SET n += {`id`: "sym:tests/test_http_transport.py::status_of", `name`: "status_of", `qualname`: "status_of", `kind`: "function", `path`: "tests/test_http_transport.py", `lang`: "python", `start_line`: 805, `end_line`: 807, `signature`: "def status_of(response):", `docstring`: "The numeric status of a raw response, as an int."};
