MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_chunked_transfer_encoding_is_refused_cleanly"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_chunked_transfer_encoding_is_refused_cleanly", `name`: "test_chunked_transfer_encoding_is_refused_cleanly", `qualname`: "test_chunked_transfer_encoding_is_refused_cleanly", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 295, `end_line`: 324, `signature`: "def test_chunked_transfer_encoding_is_refused_cleanly(make_server):", `docstring`: "The #249 behaviour this issue's acceptance criteria also names:\n    chunked bodies are refused with a structured error, not a hang or a\n    desynced connection. `test_http_transport.py`'s\n    `test_iss249_a_chunked_request_body_is_refused_with_411` already proves\n    this at the wire level; this is the same property via urllib.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_a_correct_content_type_is_accepted"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_a_correct_content_type_is_accepted", `name`: "test_a_correct_content_type_is_accepted", `qualname`: "test_a_correct_content_type_is_accepted", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 330, `end_line`: 335, `signature`: "def test_a_correct_content_type_is_accepted(make_server):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_a_content_type_with_charset_parameter_is_accepted"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_a_content_type_with_charset_parameter_is_accepted", `name`: "test_a_content_type_with_charset_parameter_is_accepted", `qualname`: "test_a_content_type_with_charset_parameter_is_accepted", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 338, `end_line`: 348, `signature`: "def test_a_content_type_with_charset_parameter_is_accepted(make_server):", `docstring`: "`application/json; charset=utf-8` is the same media type, just with an\n    optional parameter a well-behaved client may add -- only the part before\n    `;` is the media type per RFC 9110 8.3.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_form_urlencoded_content_type_is_refused"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_form_urlencoded_content_type_is_refused", `name`: "test_form_urlencoded_content_type_is_refused", `qualname`: "test_form_urlencoded_content_type_is_refused", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 351, `end_line`: 365, `signature`: "def test_form_urlencoded_content_type_is_refused(make_server):", `docstring`: "`urllib.request.Request(data=<bytes>)` silently defaults to this media\n    type when a caller sets no Content-Type at all -- the exact shape a\n    misconfigured client produces, and the reason the check treats a missing\n    header the same way (see `_content_type_ok`'s docstring).", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_a_missing_content_type_is_refused"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_a_missing_content_type_is_refused", `name`: "test_a_missing_content_type_is_refused", `qualname`: "test_a_missing_content_type_is_refused", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 368, `end_line`: 379, `signature`: "def test_a_missing_content_type_is_refused(make_server):", `docstring`: "No header at all is refused, not treated as an implicit application/json.", `entrypoint`: true, `reach`: 8};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_a_wrong_content_type_does_not_crash_the_process"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_a_wrong_content_type_does_not_crash_the_process", `name`: "test_a_wrong_content_type_does_not_crash_the_process", `qualname`: "test_a_wrong_content_type_does_not_crash_the_process", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 382, `end_line`: 393, `signature`: "def test_a_wrong_content_type_does_not_crash_the_process(make_server):", `docstring`: "The refusal is a clean, structured error -- not a dropped connection or\n    a dead handler thread. Proven the same way the #293 fuzz suite proves it:\n    a fresh request on the same server still gets served afterward.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_fuzzed_malformed_payloads_never_crash_the_process"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_fuzzed_malformed_payloads_never_crash_the_process", `name`: "test_fuzzed_malformed_payloads_never_crash_the_process", `qualname`: "test_fuzzed_malformed_payloads_never_crash_the_process", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 415, `end_line`: 432, `signature`: "def test_fuzzed_malformed_payloads_never_crash_the_process(make_server, body):", `docstring`: "#293 acceptance: fuzzed malformed payloads must never crash the process.\n\n    Every row gets a bounded, structured 4xx response and the server keeps\n    serving afterward -- the actual property under test, since a crashed\n    handler thread would otherwise be invisible until the next request fails.", `entrypoint`: true};
