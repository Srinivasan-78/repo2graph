MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::JWKSCache.key_for"}) SET n += {`id`: "sym:repo2graph/auth.py::JWKSCache.key_for", `name`: "key_for", `qualname`: "JWKSCache.key_for", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 312, `end_line`: 414, `signature`: "def key_for(self, kid: str) -> dict[str, Any]:", `docstring`: "Return the JWK with this `kid`, refetching under a per-window cap.\n\n        Args:\n            kid: The key id from the token header.\n\n        Returns:\n            The matching JWK as a dict.\n\n        Raises:\n            AuthError: If the key is unknown after any allowed refetch."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::_HTTPSOnlyRedirect"}) SET n += {`id`: "sym:repo2graph/auth.py::_HTTPSOnlyRedirect", `name`: "_HTTPSOnlyRedirect", `qualname`: "_HTTPSOnlyRedirect", `kind`: "class", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 417, `end_line`: 450, `signature`: "class _HTTPSOnlyRedirect(urllib.request.HTTPRedirectHandler):", `docstring`: "Refuse any redirect hop that leaves https.\n\n    The scheme check in `_fetch_json` covers the URL it is handed and nothing\n    after it: `urlopen` follows redirects itself, and CPython's\n    `HTTPRedirectHandler` accepts targets whose scheme is in\n    `('http', 'https', 'ftp', '')`. So an issuer -- or anyone who can answer\n    for it -- returns a `302` from the discovery document or the `jwks_uri` to\n    `http://`, and the signing keys every authentication decision rests on\n    travel in clear. That is not only disclosure: an on-path attacker who\n    answers the downgraded request substitutes t"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::_HTTPSOnlyRedirect.redirect_request"}) SET n += {`id`: "sym:repo2graph/auth.py::_HTTPSOnlyRedirect.redirect_request", `name`: "redirect_request", `qualname`: "_HTTPSOnlyRedirect.redirect_request", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 439, `end_line`: 450, `signature`: "def redirect_request(\n        self,\n        req: urllib.request.Request,\n        fp: Any,\n        code: int,\n        msg: str,\n        headers: Any,\n        newurl: str,\n    ) -> urllib.request.Request | None:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::_fetch_json"}) SET n += {`id`: "sym:repo2graph/auth.py::_fetch_json", `name`: "_fetch_json", `qualname`: "_fetch_json", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 458, `end_line`: 487, `signature`: "def _fetch_json(url: str) -> Any:", `docstring`: "GET `url` and parse the JSON body. The only network call in this package.\n\n    Args:\n        url: An https URL to fetch.\n\n    Returns:\n        The parsed JSON body.\n\n    Raises:\n        AuthError: On a non-https URL, a non-https redirect hop, a transport\n            failure, or a bad body."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::decode_jwt"}) SET n += {`id`: "sym:repo2graph/auth.py::decode_jwt", `name`: "decode_jwt", `qualname`: "decode_jwt", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 490, `end_line`: 579, `signature`: "def decode_jwt(token: str, jwks: JWKSCache, issuer: str, audience: str | None) -> dict[str, Any]:", `docstring`: "Validate a JWT's signature and claims, returning them.\n\n    Args:\n        token: The compact-serialised JWT.\n        jwks: Key source for the issuer.\n        issuer: The expected `iss` value.\n        audience: The expected `aud` value, or None to skip the check.\n\n    Returns:\n        The validated claims.\n\n    Raises:\n        AuthError: On any structural, signature or claim failure."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::_check_claims"}) SET n += {`id`: "sym:repo2graph/auth.py::_check_claims", `name`: "_check_claims", `qualname`: "_check_claims", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 582, `end_line`: 611, `signature`: "def _check_claims(claims: dict[str, Any], issuer: str, audience: str | None) -> None:", `docstring`: "Enforce iss, aud, exp and nbf. A valid signature is not a valid token."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::AuthConfig"}) SET n += {`id`: "sym:repo2graph/auth.py::AuthConfig", `name`: "AuthConfig", `qualname`: "AuthConfig", `kind`: "class", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 615, `end_line`: 643, `signature`: "class AuthConfig:", `docstring`: "How the server authenticates requests.\n\n    Attributes:\n        token: A shared bearer token, or None.\n        oidc_issuer: An OIDC issuer URL, or None.\n        audience: Expected `aud` for OIDC tokens, or None to skip the check.\n        jwks_ttl: Seconds a fetched JWKS is trusted."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::AuthConfig.modes"}) SET n += {`id`: "sym:repo2graph/auth.py::AuthConfig.modes", `name`: "modes", `qualname`: "AuthConfig.modes", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 631, `end_line`: 638, `signature`: "def modes(self) -> list[str]:", `docstring`: "The auth modes in force, for the discovery document.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::AuthConfig.enabled"}) SET n += {`id`: "sym:repo2graph/auth.py::AuthConfig.enabled", `name`: "enabled", `qualname`: "AuthConfig.enabled", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 641, `end_line`: 643, `signature`: "def enabled(self) -> bool:", `docstring`: "True when any credential is required.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::Authenticator"}) SET n += {`id`: "sym:repo2graph/auth.py::Authenticator", `name`: "Authenticator", `qualname`: "Authenticator", `kind`: "class", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 646, `end_line`: 725, `signature`: "class Authenticator:", `docstring`: "Turns an Authorization header into an Identity, or refuses it.\n\n    Args:\n        config: The configured modes.\n        opener: JSON fetcher for OIDC discovery, injected for tests.\n        clock: Monotonic time source for the JWKS cache, injected for tests."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::Authenticator.__init__"}) SET n += {`id`: "sym:repo2graph/auth.py::Authenticator.__init__", `name`: "__init__", `qualname`: "Authenticator.__init__", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 655, `end_line`: 666, `signature`: "def __init__(\n        self,\n        config: AuthConfig,\n        opener: Callable[[str], Any] | None = None,\n        clock: Callable[[], float] = time.monotonic,\n    ) -> None:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::Authenticator.authenticate"}) SET n += {`id`: "sym:repo2graph/auth.py::Authenticator.authenticate", `name`: "authenticate", `qualname`: "Authenticator.authenticate", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 668, `end_line`: 725, `signature`: "def authenticate(self, header: str | None) -> Identity:", `docstring`: "Validate one Authorization header.\n\n        Args:\n            header: The raw header value, or None when absent.\n\n        Returns:\n            The caller's Identity. With no auth configured this is always the\n            anonymous identity and the header is ignored entirely.\n\n        Raises:\n            AuthError: When a credential is required and this one does not pass."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/auth.py::client_metadata_document"}) SET n += {`id`: "sym:repo2graph/auth.py::client_metadata_document", `name`: "client_metadata_document", `qualname`: "client_metadata_document", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 728, `end_line`: 753, `signature`: "def client_metadata_document(base_url: str, name: str = \"repo2graph\") -> dict[str, Any]:", `docstring`: "A Client ID Metadata Document, as RFC 7591 client metadata.\n\n    CIMD serves this at a URL and uses that URL as the `client_id`, so the\n    document must be reachable at the id it advertises.\n\n    Args:\n        base_url: The externally reachable base URL of this server.\n        name: Human-readable client name.\n\n    Returns:\n        The metadata document."};
