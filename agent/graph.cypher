MERGE (n:R2G:Symbol {id: "sym:tests/test_graph_streaming.py::test_iss236_the_byte_cap_stops_the_read_and_the_child_is_reaped"}) SET n += {`id`: "sym:tests/test_graph_streaming.py::test_iss236_the_byte_cap_stops_the_read_and_the_child_is_reaped", `name`: "test_iss236_the_byte_cap_stops_the_read_and_the_child_is_reaped", `qualname`: "test_iss236_the_byte_cap_stops_the_read_and_the_child_is_reaped", `kind`: "function", `path`: "tests/test_graph_streaming.py", `lang`: "python", `start_line`: 168, `end_line`: 188, `signature`: "def test_iss236_the_byte_cap_stops_the_read_and_the_child_is_reaped(tmp_path, monkeypatch):", `docstring`: "The cap has to bind *during* the read. A child with far more to say than\n    the cap allows must be cut off mid-write, killed and waited for -- not read\n    to EOF and trimmed afterwards, which is what capture_output=True did.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_graph_streaming.py::test_iss236_a_timeout_is_still_a_silent_return"}) SET n += {`id`: "sym:tests/test_graph_streaming.py::test_iss236_a_timeout_is_still_a_silent_return", `name`: "test_iss236_a_timeout_is_still_a_silent_return", `qualname`: "test_iss236_a_timeout_is_still_a_silent_return", `kind`: "function", `path`: "tests/test_graph_streaming.py", `lang`: "python", `start_line`: 191, `end_line`: 215, `signature`: "def test_iss236_a_timeout_is_still_a_silent_return(tmp_path, monkeypatch):", `docstring`: "`subprocess.run(timeout=...)` raised TimeoutExpired into a bare `return`;\n    the streamed read enforces the same deadline itself and must behave the\n    same way -- no exception, no edges, and no surviving child.", `entrypoint`: true};
