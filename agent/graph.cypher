MERGE (n:R2G:`Symbol` {id: "sym:tests/test_store.py::test_build_lock_falls_back_inside_an_unwritable_parent"}) SET n += {`id`: "sym:tests/test_store.py::test_build_lock_falls_back_inside_an_unwritable_parent", `name`: "test_build_lock_falls_back_inside_an_unwritable_parent", `qualname`: "test_build_lock_falls_back_inside_an_unwritable_parent", `kind`: "function", `path`: "tests/test_store.py", `lang`: "python", `start_line`: 346, `end_line`: 392, `signature`: "def test_build_lock_falls_back_inside_an_unwritable_parent():", `docstring`: "The documented read-only container run must be able to take the lock.\n\n    `BuildLock` puts its file beside the target (`/out` -> `/.out.r2glock`) so\n    it survives a swap of that directory. The documented container run mounts\n    only `/out` writable with `/` read-only, so that sibling is unwritable and\n    `repo2graph build -o /out` failed outright with \"cannot create build lock\n    /.out.r2glock: Read-only file system\" -- a deployment `.github/SECURITY.md`\n    describes in detail could not actually run. CI never caught it because the\n    container job that exercises it is newer than the bu", `entrypoint`: true};
