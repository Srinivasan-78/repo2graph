MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cache.py::cache_metadata"}) SET n += {`id`: "sym:repo2graph/cache.py::cache_metadata", `name`: "cache_metadata", `qualname`: "cache_metadata", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 69, `end_line`: 78, `signature`: "def cache_metadata(method: str) -> dict[str, Any]:", `docstring`: "The `ttlMs`/`cacheScope` hints for one MCP method.\n\n    Args:\n        method: An MCP method name, e.g. \"tools/list\".\n\n    Returns:\n        The hint mapping, or an empty dict for a method with no hints."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cache.py::make_key"}) SET n += {`id`: "sym:repo2graph/cache.py::make_key", `name`: "make_key", `qualname`: "make_key", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 81, `end_line`: 111, `signature`: "def make_key(tool: str, params: Any) -> str:", `docstring`: "A total, stable cache key for one tool call.\n\n    Args:\n        tool: Tool name.\n        params: The caller's arguments.\n\n    Returns:\n        A string key of bounded length. Equal arguments always produce equal\n        keys, whatever the insertion order, and no argument value can make this\n        raise."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cache.py::ResultCache"}) SET n += {`id`: "sym:repo2graph/cache.py::ResultCache", `name`: "ResultCache", `qualname`: "ResultCache", `kind`: "class", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 114, `end_line`: 223, `signature`: "class ResultCache:", `docstring`: "A thread-safe LRU cache with per-entry expiry.\n\n    Args:\n        max_size: Entries kept before the least recently used is evicted. 0 or\n            less disables the cache entirely, which stays a valid configuration\n            rather than an error.\n        ttl: Seconds an entry may be served for.\n        clock: Monotonic time source, injected so tests can advance it without\n            sleeping."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cache.py::ResultCache.__init__"}) SET n += {`id`: "sym:repo2graph/cache.py::ResultCache.__init__", `name`: "__init__", `qualname`: "ResultCache.__init__", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 126, `end_line`: 139, `signature`: "def __init__(\n        self,\n        max_size: int = DEFAULT_MAX_SIZE,\n        ttl: float = DEFAULT_TTL,\n        clock: Callable[[], float] = time.monotonic,\n    ) -> None:", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cache.py::ResultCache.enabled"}) SET n += {`id`: "sym:repo2graph/cache.py::ResultCache.enabled", `name`: "enabled", `qualname`: "ResultCache.enabled", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 142, `end_line`: 144, `signature`: "def enabled(self) -> bool:", `docstring`: "False when the cache is configured away; every call is then a miss.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cache.py::ResultCache.get"}) SET n += {`id`: "sym:repo2graph/cache.py::ResultCache.get", `name`: "get", `qualname`: "ResultCache.get", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 146, `end_line`: 174, `signature`: "def get(self, key: str) -> Any:", `docstring`: "Return the cached value for `key`, or None when there is none.\n\n        An expired entry is dropped and counted as a miss, so a caller cannot\n        tell \"expired\" from \"never seen\" -- which is the point.\n\n        Args:\n            key: A key from `make_key`.\n\n        Returns:\n            The cached value, or None.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cache.py::ResultCache.put"}) SET n += {`id`: "sym:repo2graph/cache.py::ResultCache.put", `name`: "put", `qualname`: "ResultCache.put", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 176, `end_line`: 186, `signature`: "def put(self, key: str, value: Any) -> None:", `docstring`: "Store `value` under `key`, evicting the oldest entry if needed.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cache.py::ResultCache.clear"}) SET n += {`id`: "sym:repo2graph/cache.py::ResultCache.clear", `name`: "clear", `qualname`: "ResultCache.clear", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 188, `end_line`: 201, `signature`: "def clear(self) -> int:", `docstring`: "Drop every entry. Called whenever the index is rebuilt.\n\n        Counters are deliberately *not* reset: they describe the life of the\n        process, and zeroing them on every rebuild would hide exactly the churn\n        an operator is looking at them to find.\n\n        Returns:\n            How many entries were dropped.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/cache.py::ResultCache.stats"}) SET n += {`id`: "sym:repo2graph/cache.py::ResultCache.stats", `name`: "stats", `qualname`: "ResultCache.stats", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 203, `end_line`: 223, `signature`: "def stats(self) -> dict[str, Any]:", `docstring`: "Counters for the `repo_cache_stats` tool.\n\n        Returns:\n            hits, misses, size, max_size and ttl_s, plus eviction and hit-rate\n            figures an operator needs to tell a working cache from a thrashing\n            one. A cache at max_size with a hit rate near zero is sized wrong,\n            and neither number says that alone."};
MERGE (n:R2G:`Module` {id: "module:collections.OrderedDict"}) SET n += {`id`: "module:collections.OrderedDict", `name`: "collections.OrderedDict", `external`: true};
