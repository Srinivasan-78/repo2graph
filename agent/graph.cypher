MERGE (n:R2G:`Symbol` {id: "sym:scripts/validate_tasks.py::validate"}) SET n += {`id`: "sym:scripts/validate_tasks.py::validate", `name`: "validate", `qualname`: "validate", `kind`: "function", `path`: "scripts/validate_tasks.py", `lang`: "python", `start_line`: 57, `end_line`: 219, `signature`: "def validate(\n    tasks: list[dict[str, Any]],\n    repos: dict[str, dict[str, Any]],\n    cache: Path,\n    slack: int,\n) -> tuple[list[str], list[str]]:", `docstring`: "Check every task's evidence against the built indexes.\n\n    Returns:\n        (problems, gaps). `problems` are defects in the task file itself -- a\n        wrong path, an impossible line range, a duplicate -- and make the file\n        unusable. `gaps` are evidence symbols that exist in the source but not\n        in the index: a parser limitation, not a bad question, and the file\n        stays usable with them recorded."};
