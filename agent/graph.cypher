MERGE (n:R2G:`File` {id: "file:repo2graph/derived.py"}) SET n += {`id`: "file:repo2graph/derived.py", `name`: "derived.py", `path`: "repo2graph/derived.py", `lang`: "python", `file_type`: "code", `size`: 20308, `lines`: 494, `parse_errors`: 0, `chunked`: false};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/derived.py::add_reference_edges"}) SET n += {`id`: "sym:repo2graph/derived.py::add_reference_edges", `name`: "add_reference_edges", `qualname`: "add_reference_edges", `kind`: "function", `path`: "repo2graph/derived.py", `lang`: "python", `start_line`: 23, `end_line`: 83, `signature`: "def add_reference_edges(\n    g: Graph,\n    parsed: dict[str, ParsedFile],\n    imported_files: dict[str, set[str]],\n    import_aliases: dict[str, dict[str, tuple[str, str | None]]],\n    named_in: Callable[[str, Iterable[str]], list[str]],\n) -> None:", `docstring`: "READS / WRITES / REFERENCES from each symbol's captured refs (#397).\n\n    Precision over recall: a name binds only to a value/type symbol defined at\n    the top level of the same file, or one the file imports by that name; a\n    `self.x` / `this.x` binds only to a field declared in the enclosing class.\n    There is no repository-wide name fallback, which is where CALLS gets its\n    ambiguity, so an unresolved reference is counted and dropped, never guessed."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/derived.py::mark_entrypoints"}) SET n += {`id`: "sym:repo2graph/derived.py::mark_entrypoints", `name`: "mark_entrypoints", `qualname`: "mark_entrypoints", `kind`: "function", `path`: "repo2graph/derived.py", `lang`: "python", `start_line`: 90, `end_line`: 134, `signature`: "def mark_entrypoints(g: Graph) -> None:", `docstring`: "Flag the call-graph roots: symbols nothing else in the repo calls.\n\n    Those are the doors into a codebase \u2014 CLI commands, request handlers, test\n    bodies, public API \u2014 and they are where a reader tracing a flow has to\n    start. A symbol nested inside a function is skipped: an uncalled closure is\n    dead weight, not a door. `reach` (how many symbols the root can reach\n    through CALLS) is filled in for the busiest roots only, so ranking them\n    stays cheap on a big repo."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/derived.py::add_tests_edges"}) SET n += {`id`: "sym:repo2graph/derived.py::add_tests_edges", `name`: "add_tests_edges", `qualname`: "add_tests_edges", `kind`: "function", `path`: "repo2graph/derived.py", `lang`: "python", `start_line`: 143, `end_line`: 224, `signature`: "def add_tests_edges(g: Graph) -> None:", `docstring`: "TESTS edges: from each test symbol to every non-test symbol it reaches.\n\n    A test symbol is any `symbol` node defined in a file `is_test_path` claims,\n    helpers and fixtures included. From each one, CALLS edges are walked up to\n    TESTS_MAX_HOPS deep -- through test helpers and production code alike --\n    and a TESTS edge is added to every non-test symbol reached. So TESTS means\n    \"this test reaches that symbol through calls\", never \"this test asserts on\n    it\": nothing here reads an assertion.\n\n    Confidence is the product of the CALLS confidences along the path, the\n    best path w"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/derived.py::_reach"}) SET n += {`id`: "sym:repo2graph/derived.py::_reach", `name`: "_reach", `qualname`: "_reach", `kind`: "function", `path`: "repo2graph/derived.py", `lang`: "python", `start_line`: 227, `end_line`: 235, `signature`: "def _reach(start: str, out: dict[str, Any]) -> int:", `docstring`: "How many distinct symbols `start` reaches through CALLS edges."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/derived.py::add_framework_edges"}) SET n += {`id`: "sym:repo2graph/derived.py::add_framework_edges", `name`: "add_framework_edges", `qualname`: "add_framework_edges", `kind`: "function", `path`: "repo2graph/derived.py", `lang`: "python", `start_line`: 250, `end_line`: 333, `signature`: "def add_framework_edges(\n    g: Graph,\n    parsed: dict[str, ParsedFile],\n    imported_files: dict[str, set[str]],\n    import_aliases: dict[str, dict[str, tuple[str, str | None]]],\n    named_in: Callable[[str, Iterable[str]], list[str]],\n) -> None:", `docstring`: "`ROUTES_TO` / `INJECTS` / `MODELS` from captured framework facts.\n\n    Three different resolution problems, deliberately not forced into one shape:\n\n    * **`ROUTES_TO`** needs no name resolution at all. The handler is the\n      decorated symbol, so the edge is exact and carries confidence 1.0. What\n      it does need is a *node* for the route, because the thing an agent asks\n      about (\"what serves `POST /orders`?\") is the endpoint, and no endpoint\n      existed in the graph before. One `route` node per method-and-path,\n      shared by every handler that declares it -- two handlers on one p"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/derived.py::_add_route"}) SET n += {`id`: "sym:repo2graph/derived.py::_add_route", `name`: "_add_route", `qualname`: "_add_route", `kind`: "function", `path`: "repo2graph/derived.py", `lang`: "python", `start_line`: 336, `end_line`: 356, `signature`: "def _add_route(g: Graph, rel: str, sid: str, fact: dict[str, Any], full: str) -> None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/derived.py::_bind_name"}) SET n += {`id`: "sym:repo2graph/derived.py::_bind_name", `name`: "_bind_name", `qualname`: "_bind_name", `kind`: "function", `path`: "repo2graph/derived.py", `lang`: "python", `start_line`: 359, `end_line`: 392, `signature`: "def _bind_name(\n    g: Graph,\n    rel: str,\n    name: str,\n    wanted_kinds: frozenset[str] | None,\n    imported_files: dict[str, set[str]],\n    import_aliases: dict[str, dict[str, tuple[str, str | None]]],\n    named_in: Callable[[str, Iterable[str]], list[str]],\n) -> tuple[list[str], str]:", `docstring`: "`(candidates, how)` for a name, same-file then imported -- never wider.\n\n    The shared half of `INJECTS` and `MODELS` resolution, and the same policy\n    `add_reference_edges` uses: precision over recall, so a name that does not\n    bind here is reported unresolved rather than matched against the whole\n    repository. `MODELS` adds a wider fallback of its own on top of this."};
