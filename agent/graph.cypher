MERGE (n:R2G:`Symbol` {id: "sym:scripts/llm_agent_eval.py::Provider"}) SET n += {`id`: "sym:scripts/llm_agent_eval.py::Provider", `name`: "Provider", `qualname`: "Provider", `kind`: "class", `path`: "scripts/llm_agent_eval.py", `lang`: "python", `start_line`: 168, `end_line`: 265, `signature`: "class Provider:", `docstring`: "One provider's tool-calling loop, in its own request/response shape.\n\n    Deliberately not built on `answer.py`'s `_request`: that path is streaming\n    and tool-less by design (it exists for `rag --answer`, which sends one pack\n    and reads one answer back). Bending it to carry tools and a growing message\n    list would complicate the one network path in the shipped package for the\n    benefit of a benchmark script."};
