MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_grid_pairs"}) SET n += {id: "sym:repo2graph/export.py::_grid_pairs", name: "_grid_pairs", qualname: "_grid_pairs", kind: "function", path: "repo2graph/export.py", lang: "python", start_line: 40, end_line: 58, signature: "def _grid_pairs(pos, cell):", docstring: "Yield the node pairs sitting within one grid cell of each other.\n\n    Every pair lands in the same bucket or in two adjacent ones, and each\n    unordered pair is yielded once: only four of the eight neighbouring cells\n    are scanned, the other four see the pair from their own side."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_spring"}) SET n += {id: "sym:repo2graph/export.py::_spring", name: "_spring", qualname: "_spring", kind: "function", path: "repo2graph/export.py", lang: "python", start_line: 61, end_line: 108, signature: "def _spring(nodes, adjacency, iterations):", docstring: "Fruchterman-Reingold in pure Python: networkx's needs numpy, we do not.\n\n    Repulsion runs only between nodes less than 2k apart, bucketed on a grid.\n    Past that distance the k^2/d term moves a node by a rounding error, while\n    the all-pairs form costs O(n^2) per iteration and dominates big exports."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_shelf"}) SET n += {id: "sym:repo2graph/export.py::_shelf", name: "_shelf", qualname: "_shelf", kind: "function", path: "repo2graph/export.py", lang: "python", start_line: 111, end_line: 130, signature: "def _shelf(nodes, sizes, pad: float = 24.0):", docstring: "Row-pack the boxes for graphs too big to force-lay-out in Python.\n\n    Rows are filled in node order, which keeps a file next to the symbols it\n    defines, and boxes cannot overlap, so no separation pass is needed."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_layout"}) SET n += {id: "sym:repo2graph/export.py::_layout", name: "_layout", qualname: "_layout", kind: "function", path: "repo2graph/export.py", lang: "python", start_line: 139, end_line: 159, signature: "def _layout(G, sizes):", docstring: "Node positions in points, spread so labels do not collide."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_node_size"}) SET n += {id: "sym:repo2graph/export.py::_node_size", name: "_node_size", qualname: "_node_size", kind: "function", path: "repo2graph/export.py", lang: "python", start_line: 162, end_line: 165, signature: "def _node_size(label: str, degree: int) -> tuple[float, float]:", docstring: "Box a node needs: wide enough for its label, bigger for hubs."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_separate"}) SET n += {id: "sym:repo2graph/export.py::_separate", name: "_separate", qualname: "_separate", kind: "function", path: "repo2graph/export.py", lang: "python", start_line: 168, end_line: 206, signature: "def _separate(pos, sizes, iterations):", docstring: "Push overlapping boxes apart; the spring layout only knows points.\n\n    The grid cell is as wide as the widest box, so two overlapping boxes always\n    share a cell or sit in adjacent ones and no pair is missed."};
