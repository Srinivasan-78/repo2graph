MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_alias_target"}) SET n += {`id`: "sym:repo2graph/parse.py::_alias_target", `name`: "_alias_target", `qualname`: "_alias_target", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1157, `end_line`: 1170, `signature`: "def _alias_target(src: bytes, value: Node | None) -> str | None:", `docstring`: "The name an exported binding's value refers to, or None if it is not a reference."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_exported_declarator_alias"}) SET n += {`id`: "sym:repo2graph/parse.py::_exported_declarator_alias", `name`: "_exported_declarator_alias", `qualname`: "_exported_declarator_alias", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1173, `end_line`: 1187, `signature`: "def _exported_declarator_alias(src: bytes, node: Node) -> str | None:", `docstring`: "The target of `export const NAME = TARGET`, or None.\n\n    Only a declarator whose own statement carries the `export` keyword counts.\n    A file-local `const b = a` renames nothing a consumer can reach, and the\n    direct parent chain -- never an ancestor search -- is what keeps the fields\n    of an `export class C { foo = bar }` out of this path."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_export_specifier_alias"}) SET n += {`id`: "sym:repo2graph/parse.py::_export_specifier_alias", `name`: "_export_specifier_alias", `qualname`: "_export_specifier_alias", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1190, `end_line`: 1208, `signature`: "def _export_specifier_alias(src: bytes, node: Node) -> str | None:", `docstring`: "The new name bound by `export { TARGET as NAME }`, or None.\n\n    `export { x as y } from './mod'` is excluded: nothing is defined at that\n    line, and a barrel file of them would become dozens of one-line nodes\n    bidding against real definitions. Resolving a re-export to the file it\n    forwards to is a separate feature."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_split_bases"}) SET n += {`id`: "sym:repo2graph/parse.py::_split_bases", `name`: "_split_bases", `qualname`: "_split_bases", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1250, `end_line`: 1270, `signature`: "def _split_bases(text: str) -> list[str]:", `docstring`: "Split a base-class list on top-level commas only.\n\n    A generic's type arguments (`Generic[T, U]`, `Handler<Request, Response>`)\n    contain commas that must not split the base list itself, so track bracket\n    depth and only split where it is zero."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_clean_base"}) SET n += {`id`: "sym:repo2graph/parse.py::_clean_base", `name`: "_clean_base", `qualname`: "_clean_base", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1282, `end_line`: 1289, `signature`: "def _clean_base(text: str) -> str:", `docstring`: "'public B', 'extends B', '< B' -> 'B'; 'public NS::Base' -> 'NS::Base'."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_base_clauses"}) SET n += {`id`: "sym:repo2graph/parse.py::_base_clauses", `name`: "_base_clauses", `qualname`: "_base_clauses", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1292, `end_line`: 1305, `signature`: "def _base_clauses(node: Node) -> list[Node]:", `docstring`: "Supertype clauses of a definition, preferring the innermost one.\n\n    TypeScript wraps extends_clause/implements_clause in a class_heritage and\n    Java wraps a type_list in super_interfaces; the outer node's text would join\n    several names into one string, so descend when a child is a clause too."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_bases_with_details"}) SET n += {`id`: "sym:repo2graph/parse.py::_bases_with_details", `name`: "_bases_with_details", `qualname`: "_bases_with_details", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1308, `end_line`: 1382, `signature`: "def _bases_with_details(\n    src: bytes, node: Node, lang: str\n) -> tuple[list[str], list[dict[str, Any]]]:", `docstring`: "Extract supertype names along with their relationship subtype and raw expression."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_win_cap_child_memory"}) SET n += {`id`: "sym:repo2graph/parse.py::_win_cap_child_memory", `name`: "_win_cap_child_memory", `qualname`: "_win_cap_child_memory", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1426, `end_line`: 1506, `signature`: "def _win_cap_child_memory(pid: int, cap_bytes: int) -> int | None:", `docstring`: "Put `pid` and its descendants under a job capping per-process memory.\n\n    Returns the job handle, which the caller must keep alive: the job dies with\n    its last handle, and `KILL_ON_JOB_CLOSE` makes that take any surviving cpp\n    with it rather than leaving one behind holding memory.\n\n    Best effort. On any failure this returns None and the wall-clock bound in\n    `_run_cpp` is what remains, which is the behaviour this had before."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_win_cap_child_memory._IO_COUNTERS"}) SET n += {`id`: "sym:repo2graph/parse.py::_win_cap_child_memory._IO_COUNTERS", `name`: "_IO_COUNTERS", `qualname`: "_win_cap_child_memory._IO_COUNTERS", `kind`: "class", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1442, `end_line`: 1443, `signature`: "class _IO_COUNTERS(ctypes.Structure):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_win_cap_child_memory._BASIC"}) SET n += {`id`: "sym:repo2graph/parse.py::_win_cap_child_memory._BASIC", `name`: "_BASIC", `qualname`: "_win_cap_child_memory._BASIC", `kind`: "class", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1445, `end_line`: 1456, `signature`: "class _BASIC(ctypes.Structure):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_win_cap_child_memory._EXTENDED"}) SET n += {`id`: "sym:repo2graph/parse.py::_win_cap_child_memory._EXTENDED", `name`: "_EXTENDED", `qualname`: "_win_cap_child_memory._EXTENDED", `kind`: "class", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1458, `end_line`: 1466, `signature`: "class _EXTENDED(ctypes.Structure):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_win_close_job"}) SET n += {`id`: "sym:repo2graph/parse.py::_win_close_job", `name`: "_win_close_job", `qualname`: "_win_close_job", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1509, `end_line`: 1518, `signature`: "def _win_close_job(job: int | None) -> None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_run_cpp"}) SET n += {`id`: "sym:repo2graph/parse.py::_run_cpp", `name`: "_run_cpp", `qualname`: "_run_cpp", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1521, `end_line`: 1603, `signature`: "def _run_cpp(source: bytes, limit: int, timeout: float = CPP_TIMEOUT) -> tuple[int, bytes | None]:", `docstring`: "Preprocess `source` on stdin; return (returncode, output or None if over `limit`).\n\n    Streamed rather than `run(capture_output=True)`: macros expand\n    exponentially (`#define A B B`, `#define B C C`, ...), so a few hundred\n    bytes of hostile source can make cpp print gigabytes, all of which\n    `capture_output` would hold in this process before any size check ran.\n    Here the read stops one byte past `limit` and cpp is killed.\n\n    Never pass text=True to a subprocess reading cpp output on Windows -- it\n    decodes with the cp1252 locale and raises UnicodeDecodeError on UTF-8\n    source"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_run_cpp._feed"}) SET n += {`id`: "sym:repo2graph/parse.py::_run_cpp._feed", `name`: "_feed", `qualname`: "_run_cpp._feed", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1549, `end_line`: 1558, `signature`: "def _feed() -> None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_run_cpp._drain"}) SET n += {`id`: "sym:repo2graph/parse.py::_run_cpp._drain", `name`: "_drain", `qualname`: "_run_cpp._drain", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1562, `end_line`: 1572, `signature`: "def _drain() -> None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_strip_cpp_includes"}) SET n += {`id`: "sym:repo2graph/parse.py::_strip_cpp_includes", `name`: "_strip_cpp_includes", `qualname`: "_strip_cpp_includes", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1606, `end_line`: 1614, `signature`: "def _strip_cpp_includes(source: bytes) -> bytes:", `docstring`: "`source` with every file-opening directive blanked, for the cpp retry.\n\n    The retry only needs this file's own macros expanded, and its output is\n    only scored, never adopted. Following includes would let an untrusted file\n    point cpp at `/dev/zero`, a FIFO or any readable path on the machine.\n    Line numbers are irrelevant here (`-P` drops them anyway)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_cpp_available"}) SET n += {`id`: "sym:repo2graph/parse.py::_cpp_available", `name`: "_cpp_available", `qualname`: "_cpp_available", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1617, `end_line`: 1651, `signature`: "def _cpp_available() -> bool:", `docstring`: "Is a usable `cpp` on PATH? Memoizing only a successful probe.\n\n    `cpp --version` answers the same thing for the life of the process, but it\n    used to be re-run per erroring C/C++ file -- two spawns per file instead of\n    one, which dominates the macro-aware retry's cost on a large C tree and on\n    Windows, where spawn is expensive and parse_all may be fanning this out\n    across a ProcessPoolExecutor.\n\n    Same shape as fetch._git_version, for the same reason: a transient failure\n    (fd exhaustion, fork failure, ...) must not be cached forever, or one bad\n    moment disables the cpp fal"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::parse_import_details"}) SET n += {`id`: "sym:repo2graph/parse.py::parse_import_details", `name`: "parse_import_details", `qualname`: "parse_import_details", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1654, `end_line`: 1910, `signature`: "def parse_import_details(raw: str, lang: str) -> list[ImportDetail]:", `docstring`: "Extract structured import metadata (modules, names, aliases)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::normalize_source_bytes"}) SET n += {`id`: "sym:repo2graph/parse.py::normalize_source_bytes", `name`: "normalize_source_bytes", `qualname`: "normalize_source_bytes", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1913, `end_line`: 1923, `signature`: "def normalize_source_bytes(source: bytes) -> bytes:", `docstring`: "If source has UTF BOM (UTF-16/UTF-32), decode and re-encode to UTF-8 for tree-sitter (W10)."};
