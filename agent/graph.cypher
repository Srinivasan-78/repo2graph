MERGE (n:R2G:`Symbol` {id: "sym:tests/test_watch.py::test_snapshot_watches_what_a_build_indexes_and_nothing_else"}) SET n += {`id`: "sym:tests/test_watch.py::test_snapshot_watches_what_a_build_indexes_and_nothing_else", `name`: "test_snapshot_watches_what_a_build_indexes_and_nothing_else", `qualname`: "test_snapshot_watches_what_a_build_indexes_and_nothing_else", `kind`: "function", `path`: "tests/test_watch.py", `lang`: "python", `start_line`: 50, `end_line`: 83, `signature`: "def test_snapshot_watches_what_a_build_indexes_and_nothing_else(tmp_path):", `docstring`: "The watched set is discovery's set, not an approximation of it (#483).\n\n    This asserted `[\"src/a.py\"]` while `discover` on the same tree yields\n    `.pre-commit-config.yaml`, `src/.a.py.swp` and `src/a.py~` as well -- a\n    walk-fallback build indexes every file that is not in a skipped directory,\n    whatever its name begins or ends with. Ignoring a file the build indexes is\n    a rebuild that never happens, which is the whole failure `--watch` exists\n    to avoid, so the dotfile and `~` rules are gone and the two sets agree.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_watch.py::test_snapshot_ignores_gitignored_paths"}) SET n += {`id`: "sym:tests/test_watch.py::test_snapshot_ignores_gitignored_paths", `name`: "test_snapshot_ignores_gitignored_paths", `qualname`: "test_snapshot_ignores_gitignored_paths", `kind`: "function", `path`: "tests/test_watch.py", `lang`: "python", `start_line`: 86, `end_line`: 112, `signature`: "def test_snapshot_ignores_gitignored_paths(tmp_path):", `docstring`: "A build never sees them, so a change to one must not trigger a rebuild.\n\n    `snapshot` walked the tree itself, honouring no `.gitignore`: on\n    repo2graph's own checkout that meant watching 305 files under\n    `.hypothesis`, which every `pytest` run rewrites, so running the suite\n    under `--watch` rebuilt continuously (#483).", `entrypoint`: true};
