MERGE (n:R2G:`Symbol` {id: "sym:tests/test_npm_launcher.py::test_launcher_spawns_batch_shims_through_a_shell"}) SET n += {`id`: "sym:tests/test_npm_launcher.py::test_launcher_spawns_batch_shims_through_a_shell", `name`: "test_launcher_spawns_batch_shims_through_a_shell", `qualname`: "test_launcher_spawns_batch_shims_through_a_shell", `kind`: "function", `path`: "tests/test_npm_launcher.py", `lang`: "python", `start_line`: 51, `end_line`: 63, `signature`: "def test_launcher_spawns_batch_shims_through_a_shell():", `docstring`: "Static guard on the EINVAL fix, so a future edit that drops `shell` fails here.\n\n    Asserts the source still pairs a `.cmd`/`.bat` check with a `shell` option\n    -- the behavioural test below is the real detector, but this one also runs\n    on a machine with no Node.js at all.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_npm_launcher.py::_run_launcher"}) SET n += {`id`: "sym:tests/test_npm_launcher.py::_run_launcher", `name`: "_run_launcher", `qualname`: "_run_launcher", `kind`: "function", `path`: "tests/test_npm_launcher.py", `lang`: "python", `start_line`: 66, `end_line`: 84, `signature`: "def _run_launcher(tmp_path: Path, shim_dir: Path, args: list[str]) -> subprocess.CompletedProcess:", `docstring`: "Run the launcher with PATH pointing only at `shim_dir`.\n\n    Bytes, never `text=True`: the same decoding discipline AGENTS.md requires\n    for git subprocesses applies to any non-ASCII a shim might echo on a\n    cp1252 Windows locale."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_npm_launcher.py::_write_uvx_shim"}) SET n += {`id`: "sym:tests/test_npm_launcher.py::_write_uvx_shim", `name`: "_write_uvx_shim", `qualname`: "_write_uvx_shim", `kind`: "function", `path`: "tests/test_npm_launcher.py", `lang`: "python", `start_line`: 87, `end_line`: 100, `signature`: "def _write_uvx_shim(shim_dir: Path) -> None:", `docstring`: "A fake `uvx` on PATH that echoes its argv and exits 0.\n\n    A `.cmd` on Windows -- which is precisely the shape that used to fail --\n    and a plain shell script elsewhere."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_npm_launcher.py::test_launcher_runs_a_uvx_shim_on_path"}) SET n += {`id`: "sym:tests/test_npm_launcher.py::test_launcher_runs_a_uvx_shim_on_path", `name`: "test_launcher_runs_a_uvx_shim_on_path", `qualname`: "test_launcher_runs_a_uvx_shim_on_path", `kind`: "function", `path`: "tests/test_npm_launcher.py", `lang`: "python", `start_line`: 104, `end_line`: 122, `signature`: "def test_launcher_runs_a_uvx_shim_on_path(tmp_path):", `docstring`: "The launcher finds `uvx` and hands off to it, exiting with its status.\n\n    On Windows the shim is a `.cmd`, so this fails with EINVAL and a non-zero\n    exit if `run()` ever goes back to spawning a resolved path directly.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_npm_launcher.py::test_launcher_propagates_the_child_exit_status"}) SET n += {`id`: "sym:tests/test_npm_launcher.py::test_launcher_propagates_the_child_exit_status", `name`: "test_launcher_propagates_the_child_exit_status", `qualname`: "test_launcher_propagates_the_child_exit_status", `kind`: "function", `path`: "tests/test_npm_launcher.py", `lang`: "python", `start_line`: 126, `end_line`: 141, `signature`: "def test_launcher_propagates_the_child_exit_status(tmp_path):", `docstring`: "A non-zero exit from the underlying server is the launcher's own exit code.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_npm_launcher.py::test_launcher_forwards_an_argument_containing_spaces"}) SET n += {`id`: "sym:tests/test_npm_launcher.py::test_launcher_forwards_an_argument_containing_spaces", `name`: "test_launcher_forwards_an_argument_containing_spaces", `qualname`: "test_launcher_forwards_an_argument_containing_spaces", `kind`: "function", `path`: "tests/test_npm_launcher.py", `lang`: "python", `start_line`: 145, `end_line`: 160, `signature`: "def test_launcher_forwards_an_argument_containing_spaces(tmp_path):", `docstring`: "A repository path with a space survives the Windows shell hand-off.\n\n    `shell: true` re-parses the command line, so an unquoted argument would\n    arrive at the shim split in two. This is the case quoting exists for.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_npm_launcher.py::test_launcher_explains_itself_when_no_python_launcher_is_installed"}) SET n += {`id`: "sym:tests/test_npm_launcher.py::test_launcher_explains_itself_when_no_python_launcher_is_installed", `name`: "test_launcher_explains_itself_when_no_python_launcher_is_installed", `qualname`: "test_launcher_explains_itself_when_no_python_launcher_is_installed", `kind`: "function", `path`: "tests/test_npm_launcher.py", `lang`: "python", `start_line`: 164, `end_line`: 178, `signature`: "def test_launcher_explains_itself_when_no_python_launcher_is_installed(tmp_path):", `docstring`: "With an empty PATH the launcher must not install anything -- it explains and exits 1.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_npm_launcher.py::test_launcher_refuses_a_batch_shim_it_cannot_quote_for"}) SET n += {`id`: "sym:tests/test_npm_launcher.py::test_launcher_refuses_a_batch_shim_it_cannot_quote_for", `name`: "test_launcher_refuses_a_batch_shim_it_cannot_quote_for", `qualname`: "test_launcher_refuses_a_batch_shim_it_cannot_quote_for", `kind`: "function", `path`: "tests/test_npm_launcher.py", `lang`: "python", `start_line`: 183, `end_line`: 223, `signature`: "def test_launcher_refuses_a_batch_shim_it_cannot_quote_for(tmp_path, bad_arg):", `docstring`: "`%`, `!` and `\"` have no in-band escape on a `shell: true` cmd.exe line.\n\n    `quoteForCmd` wraps an argument in double quotes, but cmd.exe still expands\n    `%VAR%` and (under delayed expansion) `!VAR!` *inside* quotes, and it honours\n    no backslash escape for an embedded `\"` -- `\\\\\"` is a C-runtime convention,\n    not a cmd.exe one, so the `\"`-escaping in `quoteForCmd` is a no-op there.\n    Rather than hand cmd.exe a line it will mangle, `run()` refuses.\n\n    Deliberately asserts opposite outcomes per platform, because the gate is\n    reached only via `needsShell`, which is `win32 && (.cmd", `entrypoint`: true};
