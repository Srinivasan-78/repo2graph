MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_shipped_manifest_carries_no_absolute_source_root"}) SET n += {`id`: "sym:tests/test_index_status.py::test_shipped_manifest_carries_no_absolute_source_root", `name`: "test_shipped_manifest_carries_no_absolute_source_root", `qualname`: "test_shipped_manifest_carries_no_absolute_source_root", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 574, `end_line`: 598, `signature`: "def test_shipped_manifest_carries_no_absolute_source_root(tmp_path):", `docstring`: "manifest.json ships (committed .r2g, Action artifacts): no build path in it.\n\n    The absolute root lives in the index root's local.json, which a generated\n    .gitignore keeps out of git, and index-status still finds it through there\n    for an index built outside the tree it describes.", `entrypoint`: true};
