MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_self_recursive_call_resolves_to_itself"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_self_recursive_call_resolves_to_itself", `name`: "test_self_recursive_call_resolves_to_itself", `qualname`: "test_self_recursive_call_resolves_to_itself", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 427, `end_line`: 454, `signature`: "def test_self_recursive_call_resolves_to_itself(tmp_path: Path):", `docstring`: "A top-level function calling its own name recurses; it does not bind elsewhere.\n\n    Every tier filtered the calling symbol out with `c != sid`, so `helper`'s\n    recursive call was handed to the same-named *method* at confidence 1.0 and\n    the recursion edge disappeared: one edge, confidently wrong.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_unambiguous_method_recursion_keeps_its_self_edge"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_unambiguous_method_recursion_keeps_its_self_edge", `name`: "test_unambiguous_method_recursion_keeps_its_self_edge", `qualname`: "test_unambiguous_method_recursion_keeps_its_self_edge", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 457, `end_line`: 470, `signature`: "def test_unambiguous_method_recursion_keeps_its_self_edge(tmp_path: Path):", `docstring`: "A method whose name is unique in its file recurses onto itself, confidently.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_a_methods_own_name_is_never_bound_confidently"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_a_methods_own_name_is_never_bound_confidently", `name`: "test_a_methods_own_name_is_never_bound_confidently", `qualname`: "test_a_methods_own_name_is_never_bound_confidently", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 473, `end_line`: 501, `signature`: "def test_a_methods_own_name_is_never_bound_confidently(tmp_path: Path):", `docstring`: "`c.to_dict()` inside `Report.to_dict` is never a self-call.\n\n    The call has a receiver that is not self, so the caller is not a candidate\n    (audit round 2: receiver-aware tier 0) and the sibling is the only reading.\n\n    This is the shape of repo2graph's own doctor.py:61,\n    `[c.to_dict() for c in self.checks]`, which an earlier version of this fix\n    resolved to `Report.to_dict` itself and got confidently wrong.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_method_recursion_survives_a_same_named_sibling"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_method_recursion_survives_a_same_named_sibling", `name`: "test_method_recursion_survives_a_same_named_sibling", `qualname`: "test_method_recursion_survives_a_same_named_sibling", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 504, `end_line`: 529, `signature`: "def test_method_recursion_survives_a_same_named_sibling(tmp_path: Path):", `docstring`: "Recursion is never dropped, even when the name is ambiguous in the file.\n\n    The bug this guards: every tier excluded the caller with `c != sid`, so the\n    self-edge could not be emitted at all and the call was handed wholesale to\n    the sibling at confidence 1.0.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_decorator_call_counted_once"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_decorator_call_counted_once", `name`: "test_decorator_call_counted_once", `qualname`: "test_decorator_call_counted_once", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 532, `end_line`: 549, `signature`: "def test_decorator_call_counted_once(tmp_path: Path):", `docstring`: "A Python decorator is one call, not two.\n\n    `decorated_definition` and `prev_sibling` both matched the same decorator\n    node -- in tree-sitter-python the function_definition's prev_sibling *is*\n    the decorator -- so `count` came out 2 on every decorated def in the repo.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_stacked_decorators_each_counted_once"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_stacked_decorators_each_counted_once", `name`: "test_stacked_decorators_each_counted_once", `qualname`: "test_stacked_decorators_each_counted_once", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 552, `end_line`: 567, `signature`: "def test_stacked_decorators_each_counted_once(tmp_path: Path):", `docstring`: "Two decorators produce two edges of one call each, not two of two.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_dynamic_call_kind_is_language_scoped"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_dynamic_call_kind_is_language_scoped", `name`: "test_dynamic_call_kind_is_language_scoped", `qualname`: "test_dynamic_call_kind_is_language_scoped", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 570, `end_line`: 596, `signature`: "def test_dynamic_call_kind_is_language_scoped():", `docstring`: "`send` is an ordinary Python method name, not a dynamic invocation.\n\n    The heuristic matched a flat name list against the bare callee, so\n    `queue.send(msg)`, `channel.send(x)` and `fn.apply(...)` were all published\n    as `call_kind='dynamic'` evidence in every language.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_csharp_and_php_import_alias_fields"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_csharp_and_php_import_alias_fields", `name`: "test_csharp_and_php_import_alias_fields", `qualname`: "test_csharp_and_php_import_alias_fields", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 599, `end_line`: 619, `signature`: "def test_csharp_and_php_import_alias_fields():", `docstring`: "C# writes `alias = target`; PHP writes `target as alias`. Both were inverted.\n\n    `using Foo = Bar.Baz;` parsed to `module='Foo', alias='Bar'`, so a call to\n    `Bar(...)` resolved at confidence 1.0 to a symbol named `Foo` while the real\n    alias resolved to nothing.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_long_named_import_still_yields_details"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_long_named_import_still_yields_details", `name`: "test_long_named_import_still_yields_details", `qualname`: "test_long_named_import_still_yields_details", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 622, `end_line`: 641, `signature`: "def test_long_named_import_still_yields_details():", `docstring`: "Import details parse the full text, not the 300-char artifact cap.\n\n    `imports` is capped for artifact size and `parse_import_details` consumed\n    that capped string, so a barrel import lost its closing brace and its\n    `from \"./mod\"` and produced zero details -- every binding invisible to\n    tier-3 resolution, with nothing recording the loss.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_inherits_edges_do_not_duplicate_their_own_dst"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_inherits_edges_do_not_duplicate_their_own_dst", `name`: "test_inherits_edges_do_not_duplicate_their_own_dst", `qualname`: "test_inherits_edges_do_not_duplicate_their_own_dst", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 644, `end_line`: 656, `signature`: "def test_inherits_edges_do_not_duplicate_their_own_dst(tmp_path: Path):", `docstring`: "`resolved_target` was a verbatim copy of the edge's `dst`, in every export.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_explain_path_reports_a_symlink_as_non_regular"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_explain_path_reports_a_symlink_as_non_regular", `name`: "test_explain_path_reports_a_symlink_as_non_regular", `qualname`: "test_explain_path_reports_a_symlink_as_non_regular", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 659, `end_line`: 681, `signature`: "def test_explain_path_reports_a_symlink_as_non_regular(tmp_path: Path):", `docstring`: "`explain-path` must answer for the link, not its target.\n\n    It resolved the path before `lstat`, so a symlink stat'd as its regular-file\n    target and was reported INCLUDED -- for a path `discover()` drops, because\n    discovery lstats what it walks. Same class as commit 8ddd010.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_cache_entry_round_trip_keeps_resolution_evidence"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_cache_entry_round_trip_keeps_resolution_evidence", `name`: "test_cache_entry_round_trip_keeps_resolution_evidence", `qualname`: "test_cache_entry_round_trip_keeps_resolution_evidence", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 684, `end_line`: 709, `signature`: "def test_cache_entry_round_trip_keeps_resolution_evidence():", `docstring`: "A cache entry must carry every field call resolution reads back out of it.\n\n    `import_details`, `call_details` and `base_details` were all missing from the\n    serialised entry, so a cache hit reconstructed them empty: an aliased import\n    became an external call, and every decorator call came back `static`.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_a_cache_without_resolution_evidence_is_refused"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_a_cache_without_resolution_evidence_is_refused", `name`: "test_a_cache_without_resolution_evidence_is_refused", `qualname`: "test_a_cache_without_resolution_evidence_is_refused", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 712, `end_line`: 740, `signature`: "def test_a_cache_without_resolution_evidence_is_refused(tmp_path: Path):", `docstring`: "A cache written before this PR must be rejected, not half-read.\n\n    Its entries carry no `import_details`, `call_details` or `base_details`, so\n    every cached symbol would come back with `call_kind='static'` and every\n    aliased import unresolved. `PARSE_CACHE_FORMAT` is the only thing standing\n    between such a cache and a silently wrong incremental build, which is why\n    the constant has to move whenever an entry's shape does.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_scoped_resolution.py::test_strict_parse_error_is_not_retried_serially"}) SET n += {`id`: "sym:tests/test_scoped_resolution.py::test_strict_parse_error_is_not_retried_serially", `name`: "test_strict_parse_error_is_not_retried_serially", `qualname`: "test_strict_parse_error_is_not_retried_serially", `kind`: "function", `path`: "tests/test_scoped_resolution.py", `lang`: "python", `start_line`: 743, `end_line`: 784, `signature`: "def test_strict_parse_error_is_not_retried_serially(tmp_path: Path, monkeypatch):", `docstring`: "A strict-policy ParseError out of the pool is not a broken pool.\n\n    `parse_all`'s blanket `except Exception` caught it and re-parsed every file\n    serially before raising the same error, doing the whole build's parse twice\n    on the way to failing.", `entrypoint`: true};
