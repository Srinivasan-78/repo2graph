MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_prod_igy_area_patterns_name_paths_that_exist"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_prod_igy_area_patterns_name_paths_that_exist", `name`: "test_prod_igy_area_patterns_name_paths_that_exist", `qualname`: "test_prod_igy_area_patterns_name_paths_that_exist", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 198, `end_line`: 213, `signature`: "def test_prod_igy_area_patterns_name_paths_that_exist():", `docstring`: "Every `repo2graph/...` path prod-igy matches on must still be in the tree.\n\n    `area/walker` pointed at `repo2graph/walker.py` and `area/mcp` at\n    `repo2graph/mcp.py` long after the first was deleted (8ef6d006) and the\n    second became a package (c8c20bdb), so neither label could ever be applied\n    again and nothing failed. The assertions above pinned the stale strings,\n    which is what let it sit. This checks the paths against the filesystem\n    instead, so the next rename fails here rather than going quiet in CI.", `entrypoint`: true};
