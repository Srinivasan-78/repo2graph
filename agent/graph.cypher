MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/auth.py::AuthError"}) SET n += {`id`: "sym:repo2graph/auth.py::AuthError", `name`: "AuthError", `qualname`: "AuthError", `kind`: "class", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 91, `end_line`: 102, `signature`: "class AuthError(Exception):", `docstring`: "A request that must be refused, carrying the status to refuse it with.\n\n    Args:\n        message: Human-readable reason, safe to log. Never contains the token.\n        status: HTTP status to return; 401 unless the caller says otherwise."};
