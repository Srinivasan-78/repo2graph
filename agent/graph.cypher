MERGE (n:R2G:`Symbol` {id: "sym:tests/test_secrets_hardening.py::test_repeated_begin_without_end_stays_linear"}) SET n += {`id`: "sym:tests/test_secrets_hardening.py::test_repeated_begin_without_end_stays_linear", `name`: "test_repeated_begin_without_end_stays_linear", `qualname`: "test_repeated_begin_without_end_stays_linear", `kind`: "function", `path`: "tests/test_secrets_hardening.py", `lang`: "python", `start_line`: 959, `end_line`: 976, `signature`: "def test_repeated_begin_without_end_stays_linear():", `docstring`: "The detector for the quadratic form.\n\n    At 200k characters the paired scan takes tens of milliseconds; the lazy\n    single-pattern form took ~8 seconds, and ~8 minutes at the 1.5 MB file\n    ceiling. The bound below sits far from both, so it survives a slow CI box\n    without going vacuous.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_secrets_hardening.py::test_repeated_incomplete_begin_header_stays_linear"}) SET n += {`id`: "sym:tests/test_secrets_hardening.py::test_repeated_incomplete_begin_header_stays_linear", `name`: "test_repeated_incomplete_begin_header_stays_linear", `qualname`: "test_repeated_incomplete_begin_header_stays_linear", `kind`: "function", `path`: "tests/test_secrets_hardening.py", `lang`: "python", `start_line`: 979, `end_line`: 1013, `signature`: "def test_repeated_incomplete_begin_header_stays_linear():", `docstring`: "`PEM_BEGIN_RE` itself must not backtrack, which the test above cannot see.\n\n    That one feeds *complete* `[REDACTED:private_key]` headers, which\n    match on the first try with no backtracking -- it detects the `_pem_spans`\n    pairing fix, not the anchor regex. The quadratic input is an *incomplete*\n    header: `[-A-Z0-9_ ]` contains every character of `PRIVATE KEY`, so at each\n    of the n/11 offsets where `-----BEGIN ` matches, the engine walks the whole\n    remaining tail before failing. Measured on the unbounded `*` form: 1.10 s at\n    107 KB, 17.6 s at 440 KB, ~90 s at 1 MB -- ", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_secrets_hardening.py::test_every_real_pem_label_is_still_matched"}) SET n += {`id`: "sym:tests/test_secrets_hardening.py::test_every_real_pem_label_is_still_matched", `name`: "test_every_real_pem_label_is_still_matched", `qualname`: "test_every_real_pem_label_is_still_matched", `kind`: "function", `path`: "tests/test_secrets_hardening.py", `lang`: "python", `start_line`: 1019, `end_line`: 1023, `signature`: "def test_every_real_pem_label_is_still_matched(label):", `docstring`: "Bounding the quantifier must not narrow what counts as a private key.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_secrets_hardening.py::test_redact_content_on_repeated_begin_stays_linear"}) SET n += {`id`: "sym:tests/test_secrets_hardening.py::test_redact_content_on_repeated_begin_stays_linear", `name`: "test_redact_content_on_repeated_begin_stays_linear", `qualname`: "test_redact_content_on_repeated_begin_stays_linear", `kind`: "function", `path`: "tests/test_secrets_hardening.py", `lang`: "python", `start_line`: 1026, `end_line`: 1041, `signature`: "def test_redact_content_on_repeated_begin_stays_linear():", `docstring`: "redact_content runs the scan and then rewrites; both must stay bounded.\n\n    Sized at 200k, not 100k: at 100k the quadratic form takes ~2s, which slips\n    under this bound and makes the test a detector in name only.", `entrypoint`: true};
