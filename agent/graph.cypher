MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_split_does_not_break_a_chunk_on_u2028"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_split_does_not_break_a_chunk_on_u2028", `name`: "test_split_does_not_break_a_chunk_on_u2028", `qualname`: "test_split_does_not_break_a_chunk_on_u2028", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2489, `end_line`: 2498, `signature`: "def test_split_does_not_break_a_chunk_on_u2028():", `docstring`: "_split must cut only on \"\\\\n\"; a U+2028 inside a line is not a row break\n    for tree-sitter and must not become a chunk boundary (line separators).", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_import_targets_kotlin_csharp_php"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_import_targets_kotlin_csharp_php", `name`: "test_import_targets_kotlin_csharp_php", `qualname`: "test_import_targets_kotlin_csharp_php", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2501, `end_line`: 2510, `signature`: "def test_import_targets_kotlin_csharp_php():", `docstring`: "Kotlin was mapped to the Rust `use` pattern, C# to Java's `import`, PHP to\n    JS quoted-string \u2014 none matched real syntax, so imports vanished silently.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_ruby_call_resolves_to_method_not_receiver"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_ruby_call_resolves_to_method_not_receiver", `name`: "test_ruby_call_resolves_to_method_not_receiver", `qualname`: "test_ruby_call_resolves_to_method_not_receiver", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2513, `end_line`: 2521, `signature`: "def test_ruby_call_resolves_to_method_not_receiver():", `docstring`: "Ruby's `call` node keeps receiver and method in separate fields; the old\n    fallback picked named_children[0] (the receiver), so `logger.info(x)` was\n    recorded as a call to `logger`.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_parse_source_swift_symbols_calls_and_imports"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_parse_source_swift_symbols_calls_and_imports", `name`: "test_parse_source_swift_symbols_calls_and_imports", `qualname`: "test_parse_source_swift_symbols_calls_and_imports", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2524, `end_line`: 2548, `signature`: "def test_parse_source_swift_symbols_calls_and_imports():", `docstring`: "Swift LANG_CFG had zero direct parse_source coverage (kind_map/calls/imports).", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_repo2graph.py::test_parse_source_tsx_symbols_calls_and_imports"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_parse_source_tsx_symbols_calls_and_imports", `name`: "test_parse_source_tsx_symbols_calls_and_imports", `qualname`: "test_parse_source_tsx_symbols_calls_and_imports", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2551, `end_line`: 2598, `signature`: "def test_parse_source_tsx_symbols_calls_and_imports():", `docstring`: "TSX LANG_CFG had zero direct parse_source coverage (kind_map extras / calls / imports).\n\n    The snippet is JSX-bearing on purpose: LANG_CFG['tsx'] shares typescript's\n    kind_map (interface / type alias / enum), but only the tsx grammar accepts\n    JSX. A silent drift to the javascript map would drop those extras; pointing\n    'tsx' at the non-JSX typescript grammar would ERROR the greet body and drop\n    the function (parse_errors == 0 is the lock).", `entrypoint`: true};
