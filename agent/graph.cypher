MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag_path.py::test_dense_ranking_differs_from_bm25_only"}) SET n += {`id`: "sym:tests/test_rag_path.py::test_dense_ranking_differs_from_bm25_only", `name`: "test_dense_ranking_differs_from_bm25_only", `qualname`: "test_dense_ranking_differs_from_bm25_only", `kind`: "function", `path`: "tests/test_rag_path.py", `lang`: "python", `start_line`: 86, `end_line`: 108, `signature`: "def test_dense_ranking_differs_from_bm25_only(embedded_index):", `docstring`: "Fusion must actually change the ranking, or it is not doing anything.\n\n    A rigged embedder puts the BM25 *last* candidate nearest the query. If the\n    vectors reach the ranker the fused order differs from the lexical one; if\n    they are dropped on the way, the two are identical -- which is exactly what\n    the pre-v1.4.0 path produced.", `entrypoint`: true};
