MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::resolve_paths"}) SET n += {`id`: "sym:repo2graph/mcp.py::resolve_paths", `name`: "resolve_paths", `qualname`: "resolve_paths", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 783, `end_line`: 805, `signature`: "def resolve_paths(repo=None, out=None):", `docstring`: "Work out (index_dir, repo_to_build_from) from what the user passed.\n\n    Returns a repo of None when there is nothing safe to infer, which turns\n    auto-build off and leaves the \"build one first\" error in place.\n\n    Only one convention is trusted: an index directory named `.r2g` belongs to\n    the directory above it, which is how every command, doc and example in this\n    project lays it out. Any other `--out` name and the repo is not guessed --\n    `--out /var/cache/indexes/myproj` must not end up parsing `/var/cache/indexes`.\n    Name the repo positionally to index something that is not la"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::main"}) SET n += {`id`: "sym:repo2graph/mcp.py::main", `name`: "main", `qualname`: "main", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 808, `end_line`: 918, `signature`: "def main(argv=None):", `docstring`: ""};
