MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::ChunkRecord"}) SET n += {`id`: "sym:repo2graph/schema.py::ChunkRecord", `name`: "ChunkRecord", `qualname`: "ChunkRecord", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 185, `end_line`: 209, `signature`: "class ChunkRecord(_ChunkOptional):", `docstring`: "One line of `chunks.jsonl` \u2014 exactly the field list `manifest.json`\n    publishes as `chunk_fields` (`export.write_manifest`), which is the\n    authoritative list this TypedDict mirrors. `split` is the one optional\n    field, published as `chunk_optional_fields`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::RetrievalResult"}) SET n += {`id`: "sym:repo2graph/schema.py::RetrievalResult", `name`: "RetrievalResult", `qualname`: "RetrievalResult", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 212, `end_line`: 220, `signature`: "class RetrievalResult(ChunkRecord):", `docstring`: "A `ChunkRecord` as returned by `Index.retrieve()` or found in\n    `pack_context()`'s `chunks`/`seeds`/`neighbors` lists: the chunk plus why\n    it was picked. `score` is 0.0 for a graph neighbour, never meaningful to\n    compare across `why` values \u2014 see `Index.retrieve`'s docstring."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::PackResult"}) SET n += {`id`: "sym:repo2graph/schema.py::PackResult", `name`: "PackResult", `qualname`: "PackResult", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 223, `end_line`: 252, `signature`: "class PackResult(TypedDict):", `docstring`: "The return value of `Index.pack_context()`. `budget_chars` is 0 when\n    `budget_tokens` was used instead \u2014 see `pack_context`'s docstring for the\n    accounting rules; this type only documents the shape, not the budget\n    semantics."};
