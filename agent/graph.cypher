MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::_has_vector"}) SET n += {`id`: "sym:repo2graph/query.py::_has_vector", `name`: "_has_vector", `qualname`: "_has_vector", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1930, `end_line`: 1939, `signature`: "def _has_vector(vectors: Any, i: int) -> bool:", `docstring`: "True when `vectors` holds a vector for chunk index `i`.\n\n    Used only to count what is missing for a diagnostic message, so it answers\n    False for every failure mode rather than distinguishing them."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::_dim_mismatch_reason"}) SET n += {`id`: "sym:repo2graph/query.py::_dim_mismatch_reason", `name`: "_dim_mismatch_reason", `qualname`: "_dim_mismatch_reason", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1942, `end_line`: 1960, `signature`: "def _dim_mismatch_reason(qvec: Vector, cvecs: Sequence[Vector]) -> str:", `docstring`: "Empty when every candidate vector matches `qvec`'s width, else a reason.\n\n    `zip()` truncates to the shorter operand, so a width mismatch (e.g. 768 vs\n    1536 from two different embedding models) would otherwise pass straight\n    into `_cosine()` and compute a plausible-looking but meaningless score\n    instead of raising. Catching it here keeps the promise the rest of\n    `_vectors_for` makes: a bad vector turns fusion off and falls back to\n    BM25, it never raises out to the caller."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::_cosine"}) SET n += {`id`: "sym:repo2graph/query.py::_cosine", `name`: "_cosine", `qualname`: "_cosine", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1963, `end_line`: 1981, `signature`: "def _cosine(a: Vector, b: Vector) -> float:", `docstring`: "Cosine similarity over any two sequences of floats (no numpy needed).\n\n    Raises `ValueError` on mismatched lengths rather than letting `zip()`\n    silently truncate to the shorter vector and compute a meaningless score.\n    Callers that accept caller-supplied vectors (`score_rrf` via\n    `_vectors_for`) must validate widths themselves and never let this\n    exception reach their own caller -- see `_dim_mismatch_reason`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::_fit_lines"}) SET n += {`id`: "sym:repo2graph/query.py::_fit_lines", `name`: "_fit_lines", `qualname`: "_fit_lines", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1984, `end_line`: 2014, `signature`: "def _fit_lines(text: str, limit: int, measure: Callable[[str], int] = len) -> str:", `docstring`: "Return the longest whole-line prefix of text that fits within limit units.\n\n    Args:\n        text: Input string to truncate at line boundary.\n        limit: Maximum allowed budget (characters or tokens).\n        measure: Measurement function (defaults to len).\n\n    Returns:\n        Truncated string with no broken lines."};
