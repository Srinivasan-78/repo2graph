MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_an_expensive_container_is_penalised"}) SET n += {`id`: "sym:tests/test_answerability.py::test_an_expensive_container_is_penalised", `name`: "test_an_expensive_container_is_penalised", `qualname`: "test_an_expensive_container_is_penalised", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 70, `end_line`: 78, `signature`: "def test_an_expensive_container_is_penalised(index):", `docstring`: "The case the benchmark measured: a big class header must not win a seed.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_a_cheap_container_is_not_penalised"}) SET n += {`id`: "sym:tests/test_answerability.py::test_a_cheap_container_is_not_penalised", `name`: "test_a_cheap_container_is_not_penalised", `qualname`: "test_a_cheap_container_is_not_penalised", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 81, `end_line`: 99, `signature`: "def test_a_cheap_container_is_not_penalised(tmp_path):", `docstring`: "The penalty is about crowding bodies out of the budget, which a small\n    container does not do.\n\n    Penalising by kind alone dropped the demo fixture's 91-token `app/store.py`\n    residual -- the chunk that answered \"trace a request to persistence\" -- for\n    no budget saved. `test_demo.py` caught it; the benchmark did not.", `entrypoint`: true, `reach`: 281};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_a_matching_name_is_boosted"}) SET n += {`id`: "sym:tests/test_answerability.py::test_a_matching_name_is_boosted", `name`: "test_a_matching_name_is_boosted", `qualname`: "test_a_matching_name_is_boosted", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 102, `end_line`: 108, `signature`: "def test_a_matching_name_is_boosted(index):", `docstring`: "Two shared terms is the cap, so this is the full `NAME_TERM_BOOST`.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_one_shared_term_earns_half_the_boost"}) SET n += {`id`: "sym:tests/test_answerability.py::test_one_shared_term_earns_half_the_boost", `name`: "test_one_shared_term_earns_half_the_boost", `qualname`: "test_one_shared_term_earns_half_the_boost", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 111, `end_line`: 122, `signature`: "def test_one_shared_term_earns_half_the_boost(index):", `docstring`: "The boost scales with overlap rather than firing on any single match.\n\n    \"refunded\" shares only \"order\" with `refund_order`: the tokenizer splits\n    subtokens but does not stem, so this is the common case for a question\n    phrased in natural English.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_an_unrelated_name_is_not_boosted"}) SET n += {`id`: "sym:tests/test_answerability.py::test_an_unrelated_name_is_not_boosted", `name`: "test_an_unrelated_name_is_not_boosted", `qualname`: "test_an_unrelated_name_is_not_boosted", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 125, `end_line`: 128, `signature`: "def test_an_unrelated_name_is_not_boosted(index):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_a_container_is_never_name_boosted"}) SET n += {`id`: "sym:tests/test_answerability.py::test_a_container_is_never_name_boosted", `name`: "test_a_container_is_never_name_boosted", `qualname`: "test_a_container_is_never_name_boosted", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 131, `end_line`: 143, `signature`: "def test_a_container_is_never_name_boosted(index):", `docstring`: "Withheld from containers because it would reward a name collision.\n\n    On the demo fixture, \"trace an order *request* from route to persistence\"\n    promoted a test helper class literally named `Request` to rank 1, ahead of\n    every route body the question is about.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_question_words_are_dropped_but_content_words_are_kept"}) SET n += {`id`: "sym:tests/test_answerability.py::test_question_words_are_dropped_but_content_words_are_kept", `name`: "test_question_words_are_dropped_but_content_words_are_kept", `qualname`: "test_question_words_are_dropped_but_content_words_are_kept", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 146, `end_line`: 152, `signature`: "def test_question_words_are_dropped_but_content_words_are_kept():", `docstring`: "`get`/`set` are the load-bearing exclusions: both are extremely common\n    method names, so leaving them in would boost every accessor in the repo on\n    any question phrased \"how do I get ...\". Ordinary nouns must survive.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::_seed_scores"}) SET n += {`id`: "sym:tests/test_answerability.py::_seed_scores", `name`: "_seed_scores", `qualname`: "_seed_scores", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 155, `end_line`: 161, `signature`: "def _seed_scores(pack):", `docstring`: "{qualname: score} for the pack's seeds.\n\n    `seeds` is emitted in a stable order regardless of ranking, so the score is\n    the observable that carries the re-rank -- not the position in the list."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_the_rerank_inverts_container_and_method_ranking"}) SET n += {`id`: "sym:tests/test_answerability.py::test_the_rerank_inverts_container_and_method_ranking", `name`: "test_the_rerank_inverts_container_and_method_ranking", `qualname`: "test_the_rerank_inverts_container_and_method_ranking", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 164, `end_line`: 176, `signature`: "def test_the_rerank_inverts_container_and_method_ranking(index):", `docstring`: "End to end, and the whole point of the change.\n\n    Without the re-rank the class header outscores the method that answers the\n    question: its docstring repeats the question's words and it is long enough\n    to match many of them. With the re-rank the order inverts, so under a\n    budget that cannot hold both it is the method that survives.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_rerank_can_be_turned_off"}) SET n += {`id`: "sym:tests/test_answerability.py::test_rerank_can_be_turned_off", `name`: "test_rerank_can_be_turned_off", `qualname`: "test_rerank_can_be_turned_off", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 179, `end_line`: 191, `signature`: "def test_rerank_can_be_turned_off(index):", `docstring`: "The pre-2.3 ranking stays reachable, so a caller comparing against an\n    older pack is not left guessing which change moved their results.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_the_benchmark_task_files_stay_disjoint"}) SET n += {`id`: "sym:tests/test_answerability.py::test_the_benchmark_task_files_stay_disjoint", `name`: "test_the_benchmark_task_files_stay_disjoint", `qualname`: "test_the_benchmark_task_files_stay_disjoint", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 194, `end_line`: 206, `signature`: "def test_the_benchmark_task_files_stay_disjoint():", `docstring`: "The held-out set only validates a change if it shares no repository with\n    the set the change was developed against.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_path_index"}) SET n += {`id`: "sym:tests/test_answerability.py::test_path_index", `name`: "test_path_index", `qualname`: "test_path_index", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 218, `end_line`: 238, `signature`: "def test_path_index(tmp_path):", `docstring`: "An implementation and a test, where the *test* name reads like the question.", `entrypoint`: true, `reach`: 276};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_a_test_definition_is_not_name_boosted"}) SET n += {`id`: "sym:tests/test_answerability.py::test_a_test_definition_is_not_name_boosted", `name`: "test_a_test_definition_is_not_name_boosted", `qualname`: "test_a_test_definition_is_not_name_boosted", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 241, `end_line`: 261, `signature`: "def test_a_test_definition_is_not_name_boosted(test_path_index):", `docstring`: "A test names the behaviour in the question's own words, so it collects the\n    boost more reliably than the implementation does.\n\n    `test_middleware_chaining_runs_handlers_in_order` overlaps \"how are\n    middleware handlers chained together\" on two terms and would take the full\n    boost; `compose_middleware`, which is the answer, overlaps on one and takes\n    half. Boosting by name and demoting by path then fight, and the boost wins\n    (2.0 * TEST_SEED_PENALTY = 1.2 still beats an unboosted source chunk), which\n    reintroduces exactly the defect `TEST_SEED_PENALTY` exists to remove.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_a_question_about_tests_restores_the_boost"}) SET n += {`id`: "sym:tests/test_answerability.py::test_a_question_about_tests_restores_the_boost", `name`: "test_a_question_about_tests_restores_the_boost", `qualname`: "test_a_question_about_tests_restores_the_boost", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 264, `end_line`: 269, `signature`: "def test_a_question_about_tests_restores_the_boost(test_path_index):", `docstring`: "Withholding it is about *which answer is wanted*, not about test paths\n    being second-class. \"What tests cover X\" is a documented use case.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answerability.py::test_a_cheap_container_is_name_boosted"}) SET n += {`id`: "sym:tests/test_answerability.py::test_a_cheap_container_is_name_boosted", `name`: "test_a_cheap_container_is_name_boosted", `qualname`: "test_a_cheap_container_is_name_boosted", `kind`: "function", `path`: "tests/test_answerability.py", `lang`: "python", `start_line`: 272, `end_line`: 298, `signature`: "def test_a_cheap_container_is_name_boosted(tmp_path):", `docstring`: "The container rule is one rule: a container too cheap to be penalised is\n    also eligible for the boost.\n\n    Sparing a chunk the penalty and then denying it the boost is not protection\n    -- it leaves it to lose its slot to every sibling that can collect 1.5x.\n    That is what dropped `app/store.py` from the demo's \"trace an order request\n    from route to persistence\", the one starter question whose answer spans four\n    modules, while `CONTAINER_PENALTY_MIN_TOKENS` was doing its job.", `entrypoint`: true, `reach`: 281};
