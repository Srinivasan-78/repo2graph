MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss153_split_breaks_a_line_longer_than_max_chars"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss153_split_breaks_a_line_longer_than_max_chars", `name`: "test_iss153_split_breaks_a_line_longer_than_max_chars", `qualname`: "test_iss153_split_breaks_a_line_longer_than_max_chars", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 458, `end_line`: 472, `signature`: "def test_iss153_split_breaks_a_line_longer_than_max_chars():", `docstring`: "Hand-built fixture pinning literal chunk boundaries (AGENTS.md: assert\n    literal values, not a property the old, buggy code also happened to hold).\n\n    text = \"AAAAAAAAAA\\nBB\\n\" (a 10-char line the packer alone can't shrink,\n    plus a short second line), max_chars=5. Before the fix, _split returned a\n    single 14-char chunk (the whole first line plus every line the packer\n    could still fit) because the inner loop always appended at least the\n    first line regardless of its own length -- an unbounded chunk.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iter_chunks_streams_without_materialising"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iter_chunks_streams_without_materialising", `name`: "test_iter_chunks_streams_without_materialising", `qualname`: "test_iter_chunks_streams_without_materialising", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 475, `end_line`: 492, `signature`: "def test_iter_chunks_streams_without_materialising(sample_graph):", `docstring`: "iter_chunks is a generator (chunk text is the biggest allocation on a big\n    repo); build_chunks stays a list for API stability.", `entrypoint`: true};
