MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::make_path"}) SET n += {`id`: "sym:repo2graph/export.py::make_path", `name`: "make_path", `qualname`: "make_path", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 99, `end_line`: 104, `signature`: "def make_path(outdir: Path | str, name: str) -> Path:", `docstring`: "Like path(), but creates the section directory first."};
