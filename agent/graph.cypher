MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::resolve_jobs"}) SET n += {id: "sym:repo2graph/graph.py::resolve_jobs", name: "resolve_jobs", qualname: "resolve_jobs", kind: "function", path: "repo2graph/graph.py", lang: "python", start_line: 200, end_line: 204, signature: "def resolve_jobs(jobs: int) -> int:", docstring: "0 means one worker per core, capped so the parent keeps up with results."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::parse_all"}) SET n += {id: "sym:repo2graph/graph.py::parse_all", name: "parse_all", qualname: "parse_all", kind: "function", path: "repo2graph/graph.py", lang: "python", start_line: 207, end_line: 230, signature: "def parse_all(files, jobs: int):", docstring: "Read and parse every file, in discovery order, across `jobs` processes.\n\n    tree-sitter parsing is CPU bound and dominates a large build, so this is\n    the difference between one core and all of them. Order is preserved, which\n    keeps node ids and edge order identical to a serial run."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::build"}) SET n += {id: "sym:repo2graph/graph.py::build", name: "build", qualname: "build", kind: "function", path: "repo2graph/graph.py", lang: "python", start_line: 234, end_line: 343, signature: "def build(root: Path, include=None, exclude=None, git_history: int = 0,\n          max_files: int = 0, jobs: int = 0) -> Graph:", docstring: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::mark_entrypoints"}) SET n += {id: "sym:repo2graph/graph.py::mark_entrypoints", name: "mark_entrypoints", qualname: "mark_entrypoints", kind: "function", path: "repo2graph/graph.py", lang: "python", start_line: 350, end_line: 375, signature: "def mark_entrypoints(g: Graph):", docstring: "Flag the call-graph roots: symbols nothing else in the repo calls.\n\n    Those are the doors into a codebase \u2014 CLI commands, request handlers, test\n    bodies, public API \u2014 and they are where a reader tracing a flow has to\n    start. A symbol nested inside a function is skipped: an uncalled closure is\n    dead weight, not a door. `reach` (how many symbols the root can reach\n    through CALLS) is filled in for the busiest roots only, so ranking them\n    stays cheap on a big repo."};
