MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::sniff_header_lang"}) SET n += {`id`: "sym:repo2graph/parse.py::sniff_header_lang", `name`: "sniff_header_lang", `qualname`: "sniff_header_lang", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 93, `end_line`: 101, `signature`: "def sniff_header_lang(raw: bytes) -> str:", `docstring`: "Guess \"c\" or \"cpp\" for a `.h` file from its content (#377).\n\n    Cheap and best-effort: any single C++ signal anywhere in `raw` wins,\n    since a plain C header contains none of `CPP_HEADER_HINTS` in ordinary\n    (non-comment, non-string) code. Callers pass the bytes they already read\n    for hashing/parsing -- this never opens the file itself."};
