MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cache.py::test_a_key_distinguishes_every_argument_that_changes_the_answer"}) SET n += {`id`: "sym:tests/test_cache.py::test_a_key_distinguishes_every_argument_that_changes_the_answer", `name`: "test_a_key_distinguishes_every_argument_that_changes_the_answer", `qualname`: "test_a_key_distinguishes_every_argument_that_changes_the_answer", `kind`: "function", `path`: "tests/test_cache.py", `lang`: "python", `start_line`: 50, `end_line`: 60, `signature`: "def test_a_key_distinguishes_every_argument_that_changes_the_answer():", `docstring`: "The quiet failure: a key that drops an argument returns a wrong answer.\n\n    repo_search's k, hops and budget_tokens all change the result, so two calls\n    differing only in one of them must not share a cache entry.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cache.py::test_a_key_is_bounded_however_large_the_arguments_are"}) SET n += {`id`: "sym:tests/test_cache.py::test_a_key_is_bounded_however_large_the_arguments_are", `name`: "test_a_key_is_bounded_however_large_the_arguments_are", `qualname`: "test_a_key_is_bounded_however_large_the_arguments_are", `kind`: "function", `path`: "tests/test_cache.py", `lang`: "python", `start_line`: 63, `end_line`: 82, `signature`: "def test_a_key_is_bounded_however_large_the_arguments_are():", `docstring`: "A key that embeds the request body amplifies memory 256x.\n\n    `dispatch` keys on the *raw* arguments, before a handler's own\n    `_str(query, MCP_MAX_QUERY_CHARS)` cap applies. Storing the serialised params\n    verbatim meant 256 `repo_search` calls with a ~1 MB query each -- every one\n    inside the HTTP server's MAX_BODY_BYTES -- retained ~257 MB in *keys*, for a\n    cache whose values are bounded. Bounded here means constant, not merely\n    smaller: a 1 MB and a 4 MB argument must both yield the same key length.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cache.py::test_a_key_survives_any_lone_surrogate_in_an_argument"}) SET n += {`id`: "sym:tests/test_cache.py::test_a_key_survives_any_lone_surrogate_in_an_argument", `name`: "test_a_key_survives_any_lone_surrogate_in_an_argument", `qualname`: "test_a_key_survives_any_lone_surrogate_in_an_argument", `kind`: "function", `path`: "tests/test_cache.py", `lang`: "python", `start_line`: 86, `end_line`: 103, `signature`: "def test_a_key_survives_any_lone_surrogate_in_an_argument(bad):", `docstring`: "`make_key` promises never to raise; hashing the body must not break that.\n\n    Two separate routes put a lone surrogate in an argument: CONTRIBUTING.md requires\n    git/repo bytes be decoded `utf8`/`surrogateescape`, which produces the\n    U+DC80-U+DCFF range, and a JSON-RPC caller can simply send `\"\\\\ud800\"`.\n\n    The parametrization is the detector, not decoration. `surrogateescape` encodes\n    U+DC80-U+DCFF fine and raises `UnicodeEncodeError` on everything else in the\n    surrogate block, so a test using only `\"caf\\\\udce9\"` stays green against the\n    wrong codec -- which is exactly what a", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cache.py::test_list_and_dict_arguments_do_not_raise"}) SET n += {`id`: "sym:tests/test_cache.py::test_list_and_dict_arguments_do_not_raise", `name`: "test_list_and_dict_arguments_do_not_raise", `qualname`: "test_list_and_dict_arguments_do_not_raise", `kind`: "function", `path`: "tests/test_cache.py", `lang`: "python", `start_line`: 106, `end_line`: 115, `signature`: "def test_list_and_dict_arguments_do_not_raise():", `docstring`: "frozenset(params.items()) raises here; canonical JSON does not.\n\n    JSON-Schema tool arguments permit arrays and objects, so a key built from a\n    frozenset of items is a TypeError waiting for the first caller who sends\n    one -- which is why this cache keys on canonical JSON instead.", `entrypoint`: true};
