MERGE (n:R2G:Symbol {id: "sym:tests/test_integrity.py::TestBuildLock.test_an_aged_lock_is_not_stolen_from_a_live_holder"}) SET n += {`id`: "sym:tests/test_integrity.py::TestBuildLock.test_an_aged_lock_is_not_stolen_from_a_live_holder", `name`: "test_an_aged_lock_is_not_stolen_from_a_live_holder", `qualname`: "TestBuildLock.test_an_aged_lock_is_not_stolen_from_a_live_holder", `kind`: "function", `path`: "tests/test_integrity.py", `lang`: "python", `start_line`: 290, `end_line`: 314, `signature`: "def test_an_aged_lock_is_not_stolen_from_a_live_holder(self, tmp_path):", `docstring`: "A build slower than the stale threshold keeps its lock.\n\n        `_write_metadata` runs once, at acquire, so mtime measures how long\n        the holder has been working -- not whether it is stuck. Reclaiming on\n        that alone meant any build over the threshold was joined by a second.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_integrity.py::TestBuildLock.test_releasing_does_not_unlink_a_lock_file_that_is_not_ours"}) SET n += {`id`: "sym:tests/test_integrity.py::TestBuildLock.test_releasing_does_not_unlink_a_lock_file_that_is_not_ours", `name`: "test_releasing_does_not_unlink_a_lock_file_that_is_not_ours", `qualname`: "TestBuildLock.test_releasing_does_not_unlink_a_lock_file_that_is_not_ours", `kind`: "function", `path`: "tests/test_integrity.py", `lang`: "python", `start_line`: 320, `end_line`: 342, `signature`: "def test_releasing_does_not_unlink_a_lock_file_that_is_not_ours(self, tmp_path):", `docstring`: "release() must not delete whatever happens to sit at the path.\n\n        If the name was replaced while we held our file, the thing at the path\n        is another holder's live lock; removing it would admit a third builder.", `entrypoint`: true};
