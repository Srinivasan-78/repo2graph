MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cpp_parse.py::_require_working_cpp"}) SET n += {`id`: "sym:tests/test_cpp_parse.py::_require_working_cpp", `name`: "_require_working_cpp", `qualname`: "_require_working_cpp", `kind`: "function", `path`: "tests/test_cpp_parse.py", `lang`: "python", `start_line`: 139, `end_line`: 173, `signature`: "def _require_working_cpp(path: Path) -> None:", `docstring`: "Skip unless this machine can actually run the fallback on `path`.\n\n    `shutil.which(\"cpp\") is not None` is not that condition and was the reason\n    this test flaked: on macOS `/usr/bin/cpp` always exists (it shells out to\n    the Xcode toolchain), and the two spawns `parse_source` makes -- the\n    `cpp --version` probe on a 5s timeout, then `cpp -w -P -undef` on a 10s one\n    -- can each fail or time out on a loaded runner. Both failures are\n    swallowed into `used_cpp=False`, so the assertion below reported \"cpp citation accuracy\n    regressed\" for an environment that simply could not prep"};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cpp_parse.py::test_cpp_fallback_line_numbers_match_original"}) SET n += {`id`: "sym:tests/test_cpp_parse.py::test_cpp_fallback_line_numbers_match_original", `name`: "test_cpp_fallback_line_numbers_match_original", `qualname`: "test_cpp_fallback_line_numbers_match_original", `kind`: "function", `path`: "tests/test_cpp_parse.py", `lang`: "python", `start_line`: 176, `end_line`: 209, `signature`: "def test_cpp_fallback_line_numbers_match_original(tmp_path):", `docstring`: "Verify used_cpp=True must still cite the on-disk file, not cpp -P rows.", `entrypoint`: true, `reach`: 182};
