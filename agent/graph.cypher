MERGE (n:R2G:Symbol {id: "sym:tests/test_vectors.py::rigged_order"}) SET n += {`id`: "sym:tests/test_vectors.py::rigged_order", `name`: "rigged_order", `qualname`: "rigged_order", `kind`: "function", `path`: "tests/test_vectors.py", `lang`: "python", `start_line`: 65, `end_line`: 75, `signature`: "def rigged_order(candidates):", `docstring`: "The dense ranking this suite rigs: BM25 rank 2 first, rank 1 third.\n\n    Swapping only ranks 1 and 2 is not enough -- reciprocal rank fusion gives\n    the two chunks identical fused scores and the outcome turns on a tie-break.\n    Demoting the BM25 winner to dense rank 3 makes the intended chunk win\n    outright, whatever the tie-break rule is."};
