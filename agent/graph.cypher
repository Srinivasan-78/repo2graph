MERGE (n:R2G:`Symbol` {id: "sym:tests/test_destructive_paths.py::test_a_build_survives_a_read_only_parent_of_the_output_directory"}) SET n += {`id`: "sym:tests/test_destructive_paths.py::test_a_build_survives_a_read_only_parent_of_the_output_directory", `name`: "test_a_build_survives_a_read_only_parent_of_the_output_directory", `qualname`: "test_a_build_survives_a_read_only_parent_of_the_output_directory", `kind`: "function", `path`: "tests/test_destructive_paths.py", `lang`: "python", `start_line`: 161, `end_line`: 201, `signature`: "def test_a_build_survives_a_read_only_parent_of_the_output_directory(tmp_path, monkeypatch):", `docstring`: "The documented read-only container run must actually produce an index.\n\n    `.github/SECURITY.md` describes running the image with a read-only rootfs\n    and only `-o /out` mounted writable. Both halves of the write path put\n    their scratch directory *beside* the target -- `BuildLock`'s\n    `.out.r2glock` and `dump_all`'s `.out.staging.<pid>` -- so with `/`\n    read-only the build took the lock failure first and, once that was fixed,\n    died at the staging `mkdir` after doing all of its work. Nothing caught it\n    because the container CI job is newer than the bug.\n\n    Only the sibling sta", `entrypoint`: true, `reach`: 275};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_destructive_paths.py::test_a_build_survives_a_read_only_parent_of_the_output_directory.fake_mkdir"}) SET n += {`id`: "sym:tests/test_destructive_paths.py::test_a_build_survives_a_read_only_parent_of_the_output_directory.fake_mkdir", `name`: "fake_mkdir", `qualname`: "test_a_build_survives_a_read_only_parent_of_the_output_directory.fake_mkdir", `kind`: "function", `path`: "tests/test_destructive_paths.py", `lang`: "python", `start_line`: 180, `end_line`: 186, `signature`: "def fake_mkdir(path, *args, **kwargs):\n        # Only the *sibling* staging directory, `.out.staging.<pid>.<hex>`.\n        # The in-target fallback is `.staging.<pid>.<hex>` -- matching on\n        # `.staging.` alone blocks that too, and the build has nowhere left.", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_destructive_paths.py::test_the_in_target_merge_swaps_agent_last"}) SET n += {`id`: "sym:tests/test_destructive_paths.py::test_the_in_target_merge_swaps_agent_last", `name`: "test_the_in_target_merge_swaps_agent_last", `qualname`: "test_the_in_target_merge_swaps_agent_last", `kind`: "function", `path`: "tests/test_destructive_paths.py", `lang`: "python", `start_line`: 204, `end_line`: 253, `signature`: "def test_the_in_target_merge_swaps_agent_last(tmp_path):", `docstring`: "`agent/` must be the final rename, so readers never see a half-new index.\n\n    `_merge_staging_into` is the read-only-parent fallback and cannot swap the\n    whole directory in one step -- renaming needs write permission on the parent\n    of both names. Per-entry replacement is the best available, so the *order*\n    carries the guarantee: everything `query`, `rag` and the MCP server read\n    lives under `agent/` (including `manifest.json`, and so the `build_id`), and\n    that subtree arrives in a single rename. A reader therefore sees the\n    previous index, whole, right up to the instant the ", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_destructive_paths.py::test_the_in_target_merge_swaps_agent_last.spy"}) SET n += {`id`: "sym:tests/test_destructive_paths.py::test_the_in_target_merge_swaps_agent_last.spy", `name`: "spy", `qualname`: "test_the_in_target_merge_swaps_agent_last.spy", `kind`: "function", `path`: "tests/test_destructive_paths.py", `lang`: "python", `start_line`: 235, `end_line`: 237, `signature`: "def spy(src, dst):", `docstring`: ""};
