MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::_int"}) SET n += {`id`: "sym:repo2graph/mcp.py::_int", `name`: "_int", `qualname`: "_int", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 498, `end_line`: 503, `signature`: "def _int(value, fallback: int) -> int:", `docstring`: "An MCP client's arguments are JSON a model wrote: coerce, never raise."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::_clamp"}) SET n += {`id`: "sym:repo2graph/mcp.py::_clamp", `name`: "_clamp", `qualname`: "_clamp", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 506, `end_line`: 508, `signature`: "def _clamp(value, fallback: int, low: int, high: int) -> int:", `docstring`: "_int, then held inside [low, high]: no argument may cost unbounded time."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/mcp.py::_str"}) SET n += {`id`: "sym:repo2graph/mcp.py::_str", `name`: "_str", `qualname`: "_str", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 511, `end_line`: 518, `signature`: "def _str(value, max_chars: int) -> str:", `docstring`: "Coerce a caller-supplied string argument and cap its length.\n\n    A model can hand this dispatcher an arbitrarily long value; this is the\n    string-typed counterpart to `_clamp` for the numeric arguments."};
