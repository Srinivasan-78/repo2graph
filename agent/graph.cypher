MERGE (n:R2G:`Symbol` {id: "sym:tests/test_export_hardening.py::test_doctor_drift_check_can_fire_now"}) SET n += {`id`: "sym:tests/test_export_hardening.py::test_doctor_drift_check_can_fire_now", `name`: "test_doctor_drift_check_can_fire_now", `qualname`: "test_doctor_drift_check_can_fire_now", `kind`: "function", `path`: "tests/test_export_hardening.py", `lang`: "python", `start_line`: 101, `end_line`: 110, `signature`: "def test_doctor_drift_check_can_fire_now(monkeypatch):", `docstring`: "doctor.py compares `repo2graph.__version__` (code_ver) against\n    `importlib.metadata.version(\"repo2graph\")` (dist_ver) to detect a stale\n    install. Before #340's fix, __version__ *was* that same metadata call, so\n    code_ver == dist_ver was true by construction and the check could never\n    fire. It must be able to fire now.", `entrypoint`: true};
