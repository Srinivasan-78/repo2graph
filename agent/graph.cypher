MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::_process_chunk_content"}) SET n += {`id`: "sym:repo2graph/chunks.py::_process_chunk_content", `name`: "_process_chunk_content", `qualname`: "_process_chunk_content", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 18, `end_line`: 51, `signature`: "def _process_chunk_content(\n    text: str, nid: str, path: str, policy: str, g: Any\n) -> tuple[str | None, int]:", `docstring`: "Apply secret scanning and redaction policy to chunk text."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::_lines"}) SET n += {`id`: "sym:repo2graph/chunks.py::_lines", `name`: "_lines", `qualname`: "_lines", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 54, `end_line`: 62, `signature`: "def _lines(src: str) -> list[str]:", `docstring`: "Split source the way tree-sitter counts rows: on \"\\\\n\" only.\n\n    str.splitlines() also breaks on U+2028/U+2029/U+0085/\\\\x0b/\\\\x0c, which\n    tree-sitter's row numbers do not; using it here slices every later symbol's\n    chunk from the wrong lines (ISS-22). Drop a trailing \"\\\\r\" per line so\n    CRLF files still index cleanly."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::_keepends_lf"}) SET n += {`id`: "sym:repo2graph/chunks.py::_keepends_lf", `name`: "_keepends_lf", `qualname`: "_keepends_lf", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 65, `end_line`: 77, `signature`: "def _keepends_lf(text: str) -> list[str]:", `docstring`: "Split on \"\\\\n\" only, keeping the newline, so \"\".join(result) == text.\n\n    str.splitlines(keepends=True) also breaks on U+2028/U+2029/U+0085/\\\\x0b/\\\\x0c,\n    which tree-sitter does not treat as row breaks; splitting a chunk there makes\n    its pieces depend on whichever stray separators the source happens to hold\n    (the ISS-22 bug class). Same \"\\\\n\"-only rule as _lines, but lossless."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::_split"}) SET n += {`id`: "sym:repo2graph/chunks.py::_split", `name`: "_split", `qualname`: "_split", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 80, `end_line`: 112, `signature`: "def _split(text: str, max_chars: int = MAX_CHARS):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::_conf"}) SET n += {`id`: "sym:repo2graph/chunks.py::_conf", `name`: "_conf", `qualname`: "_conf", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 115, `end_line`: 118, `signature`: "def _conf(text: str, edge: dict) -> str:", `docstring`: "Label a CALLS edge with its confidence when the call was ambiguous."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::_neighbour_edge"}) SET n += {`id`: "sym:repo2graph/chunks.py::_neighbour_edge", `name`: "_neighbour_edge", `qualname`: "_neighbour_edge", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 121, `end_line`: 133, `signature`: "def _neighbour_edge(target: str, edge: dict, direction: str) -> dict:", `docstring`: "Structured form of a callers/callees/bases entry.\n\n    Additive sibling of the callers/callees/callees_external string lists --\n    same targets, plus the edge type, direction and (only when < 1.0, to keep\n    the common case small) confidence. IMPORTS/DEFINES/INHERITS edges carry no\n    confidence key, so they fall through the 1.0 default and are never flagged."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::build_chunks"}) SET n += {`id`: "sym:repo2graph/chunks.py::build_chunks", `name`: "build_chunks", `qualname`: "build_chunks", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 136, `end_line`: 138, `signature`: "def build_chunks(g, include_files: bool = True) -> list[dict]:", `docstring`: "All retrieval chunks as a list (stable public API)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/chunks.py::iter_chunks"}) SET n += {`id`: "sym:repo2graph/chunks.py::iter_chunks", `name`: "iter_chunks", `qualname`: "iter_chunks", `kind`: "function", `path`: "repo2graph/chunks.py", `lang`: "python", `start_line`: 141, `end_line`: 333, `signature`: "def iter_chunks(g, include_files: bool = True):", `docstring`: "Yield chunk dicts ready for embedding, one at a time.\n\n    A generator, not a list: on a large repo the chunk text is the single\n    biggest allocation, so write_jsonl streams it straight to disk instead of\n    holding every chunk in memory at once. Source text is dropped from the cache\n    as soon as the last symbol on a file has been emitted."};
