MERGE (n:R2G:Symbol {id: "sym:scripts/commit_release_via_api.py::api"}) SET n += {`id`: "sym:scripts/commit_release_via_api.py::api", `name`: "api", `qualname`: "api", `kind`: "function", `path`: "scripts/commit_release_via_api.py", `lang`: "python", `start_line`: 59, `end_line`: 84, `signature`: "def api(\n    method: str,\n    path: str,\n    token: str,\n    payload: dict[str, Any] | None = None,\n    timeout: float = 30.0,\n) -> dict[str, Any]:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:scripts/commit_release_via_api.py::graphql"}) SET n += {`id`: "sym:scripts/commit_release_via_api.py::graphql", `name`: "graphql", `qualname`: "graphql", `kind`: "function", `path`: "scripts/commit_release_via_api.py", `lang`: "python", `start_line`: 87, `end_line`: 118, `signature`: "def graphql(\n    query: str,\n    variables: dict[str, Any],\n    token: str,\n    timeout: float = 30.0,\n) -> dict[str, Any]:", `docstring`: "POST a GraphQL operation and return `data`.\n\n    GraphQL reports failures as HTTP 200 with an `errors` array, so a plain\n    `urlopen` success here means nothing on its own -- without this check a\n    failed commit would print `None` and the release would carry on."};
MERGE (n:R2G:Symbol {id: "sym:scripts/commit_release_via_api.py::ref_sha"}) SET n += {`id`: "sym:scripts/commit_release_via_api.py::ref_sha", `name`: "ref_sha", `qualname`: "ref_sha", `kind`: "function", `path`: "scripts/commit_release_via_api.py", `lang`: "python", `start_line`: 121, `end_line`: 130, `signature`: "def ref_sha(repo: str, branch: str, token: str) -> str | None:", `docstring`: "Current head of `branch`, or None when the branch does not exist."};
