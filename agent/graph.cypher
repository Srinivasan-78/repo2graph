MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_freshness_does_not_count_the_index_as_added_source"}) SET n += {`id`: "sym:tests/test_index_status.py::test_freshness_does_not_count_the_index_as_added_source", `name`: "test_freshness_does_not_count_the_index_as_added_source", `qualname`: "test_freshness_does_not_count_the_index_as_added_source", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 188, `end_line`: 194, `signature`: "def test_freshness_does_not_count_the_index_as_added_source(built):", `docstring`: "`.r2g` is not in DEFAULT_SKIP_DIRS and did not exist when the build ran\n    discovery, so on a non-git tree every artifact it just wrote came back as\n    a newly \"added\" source file and a brand-new index read as stale.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_a_filtered_build_is_not_instantly_stale"}) SET n += {`id`: "sym:tests/test_index_status.py::test_a_filtered_build_is_not_instantly_stale", `name`: "test_a_filtered_build_is_not_instantly_stale", `qualname`: "test_a_filtered_build_is_not_instantly_stale", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 197, `end_line`: 249, `signature`: "def test_a_filtered_build_is_not_instantly_stale(tmp_path):", `docstring`: "Freshness must re-discover with the filters the *build* used.\n\n    Comparing against default filters re-finds every file the build\n    deliberately excluded, reports them all as newly added, and so any build\n    with `--exclude` or `--exclude-group` reads as stale the instant it\n    finishes -- which makes the whole freshness signal worthless for exactly\n    the users who configured indexing most carefully.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_state_file_records_the_discovery_filters"}) SET n += {`id`: "sym:tests/test_index_status.py::test_state_file_records_the_discovery_filters", `name`: "test_state_file_records_the_discovery_filters", `qualname`: "test_state_file_records_the_discovery_filters", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 252, `end_line`: 281, `signature`: "def test_state_file_records_the_discovery_filters(tmp_path):", `docstring`: "The filters are persisted, not re-derived -- there is nowhere else to\n    recover `--exclude-group generated` from after the build exits.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_freshness_falls_back_when_the_state_file_predates_filters"}) SET n += {`id`: "sym:tests/test_index_status.py::test_freshness_falls_back_when_the_state_file_predates_filters", `name`: "test_freshness_falls_back_when_the_state_file_predates_filters", `qualname`: "test_freshness_falls_back_when_the_state_file_predates_filters", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 284, `end_line`: 295, `signature`: "def test_freshness_falls_back_when_the_state_file_predates_filters(built):", `docstring`: "An index built before filters were recorded must still be checkable,\n    and must say that its comparison used defaults.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_freshness_without_state_file_is_unknown_not_stale"}) SET n += {`id`: "sym:tests/test_index_status.py::test_freshness_without_state_file_is_unknown_not_stale", `name`: "test_freshness_without_state_file_is_unknown_not_stale", `qualname`: "test_freshness_without_state_file_is_unknown_not_stale", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 298, `end_line`: 306, `signature`: "def test_freshness_without_state_file_is_unknown_not_stale(built):", `docstring`: "An index built by an older version cannot be checked at file level.\n    \"I could not tell\" is not the same claim as \"it is out of date\".", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_freshness_respects_the_scan_bound"}) SET n += {`id`: "sym:tests/test_index_status.py::test_freshness_respects_the_scan_bound", `name`: "test_freshness_respects_the_scan_bound", `qualname`: "test_freshness_respects_the_scan_bound", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 309, `end_line`: 318, `signature`: "def test_freshness_respects_the_scan_bound(built, monkeypatch):", `docstring`: "Past the bound the file-level check is skipped and says so, rather\n    than re-hashing an attacker-chosen number of bytes.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_doctor_and_index_status_never_disagree"}) SET n += {`id`: "sym:tests/test_index_status.py::test_doctor_and_index_status_never_disagree", `name`: "test_doctor_and_index_status_never_disagree", `qualname`: "test_doctor_and_index_status_never_disagree", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 321, `end_line`: 339, `signature`: "def test_doctor_and_index_status_never_disagree(built):", `docstring`: "Two implementations of \"is this stale\" drift until they contradict\n    each other in front of a user. There is one, and this pins that.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_git_metadata_reaches_the_report"}) SET n += {`id`: "sym:tests/test_index_status.py::test_git_metadata_reaches_the_report", `name`: "test_git_metadata_reaches_the_report", `qualname`: "test_git_metadata_reaches_the_report", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 347, `end_line`: 369, `signature`: "def test_git_metadata_reaches_the_report(built):", `docstring`: "", `entrypoint`: true, `reach`: 139};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_repo2graphs_own_scratch_files_do_not_mark_the_tree_dirty"}) SET n += {`id`: "sym:tests/test_index_status.py::test_repo2graphs_own_scratch_files_do_not_mark_the_tree_dirty", `name`: "test_repo2graphs_own_scratch_files_do_not_mark_the_tree_dirty", `qualname`: "test_repo2graphs_own_scratch_files_do_not_mark_the_tree_dirty", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 372, `end_line`: 402, `signature`: "def test_repo2graphs_own_scratch_files_do_not_mark_the_tree_dirty(built):", `docstring`: "A clean checkout must not record `dirty: true` because of repo2graph.\n\n    `BuildLock` writes `..r2g.r2glock` and `dump_all` stages artifacts in\n    `..r2g.staging.<pid>.<hex>/`, both *beside* the output directory so they\n    survive the transactional swap -- which means `.r2g/` in .gitignore\n    covers neither. Provenance is captured from inside both windows, so every\n    build of a pristine repository used to report a dirty tree and blame the\n    user for repo2graph's own scratch files.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_dirty_working_tree_is_reported_with_a_count"}) SET n += {`id`: "sym:tests/test_index_status.py::test_dirty_working_tree_is_reported_with_a_count", `name`: "test_dirty_working_tree_is_reported_with_a_count", `qualname`: "test_dirty_working_tree_is_reported_with_a_count", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 405, `end_line`: 415, `signature`: "def test_dirty_working_tree_is_reported_with_a_count(built):", `docstring`: "", `entrypoint`: true};
