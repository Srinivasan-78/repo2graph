MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_http_error"}) SET n += {id: "sym:repo2graph/answer.py::_http_error", name: "_http_error", qualname: "_http_error", kind: "function", path: "repo2graph/answer.py", lang: "python", start_line: 216, end_line: 228, signature: "def _http_error(spec: dict, exc) -> str:", docstring: "A one-line explanation of a provider HTTP error, without its URL.\n\n    HTTPError.url can carry credentials for some providers, so it is never\n    echoed; the status and the provider's own message are enough to act on."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_empty_answer"}) SET n += {id: "sym:repo2graph/answer.py::_empty_answer", name: "_empty_answer", qualname: "_empty_answer", kind: "function", path: "repo2graph/answer.py", lang: "python", start_line: 231, end_line: 252, signature: "def _empty_answer(spec: dict, raw_tail: list) -> str:", docstring: "Why a 200 response carried no answer text.\n\n    Ollama answers HTTP 200 with {\"error\": \"model 'x' not found\"}; without this\n    the command would print nothing and exit 0, which reads as a valid empty\n    answer."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_disclose"}) SET n += {id: "sym:repo2graph/answer.py::_disclose", name: "_disclose", qualname: "_disclose", kind: "function", path: "repo2graph/answer.py", lang: "python", start_line: 255, end_line: 265, signature: "def _disclose(spec: dict, url: str, user: str) -> None:", docstring: "Tell the user, on stderr, where their repository content is going.\n\n    The pack can contain any indexed file, `.env` included. stderr, not stdout:\n    stdout is the answer itself and has to stay pipeable."};
