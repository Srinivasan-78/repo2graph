MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_the_reported_path_lists_are_capped_but_the_counts_are_not"}) SET n += {`id`: "sym:tests/test_index_status.py::test_the_reported_path_lists_are_capped_but_the_counts_are_not", `name`: "test_the_reported_path_lists_are_capped_but_the_counts_are_not", `qualname`: "test_the_reported_path_lists_are_capped_but_the_counts_are_not", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 673, `end_line`: 695, `signature`: "def test_the_reported_path_lists_are_capped_but_the_counts_are_not():", `docstring`: "`index-status --json` is a public surface, and a 4,000-entry list is not\n    a report. The lists are capped at MAX_LISTED_PATHS; the counts beside them\n    stay exact, which is what tells a reader the list was cut.", `entrypoint`: true};
