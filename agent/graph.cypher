MERGE (n:R2G:`File` {id: "file:tests/test_mcp.py"}) SET n += {`id`: "file:tests/test_mcp.py", `name`: "test_mcp.py", `path`: "tests/test_mcp.py", `lang`: "python", `file_type`: "code", `size`: 75842, `lines`: 1959, `parse_errors`: 0, `chunked`: false};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::_has_mcp"}) SET n += {`id`: "sym:tests/test_mcp.py::_has_mcp", `name`: "_has_mcp", `qualname`: "_has_mcp", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 31, `end_line`: 59, `signature`: "def _has_mcp():", `docstring`: "A real, currently-*supported* SDK is importable.\n\n    #407/#291 dropped mcp 1.x: `serve()` now speaks only the 2.x registration\n    API (`on_list_tools=`/`on_call_tool=`), so a test that drives a live\n    subprocess needs mcp>=2.0. This used to check\n    `hasattr(Server, \"list_tools\")`, which is true only for the *unsupported*\n    1.x generation -- so on any environment with the (now required) 2.x SDK\n    installed, every test gated on it silently skipped forever. Detector:\n    reverting this to the old hasattr check makes\n    test_stdio_roundtrip_against_a_repo_with_no_index and\n    test_stdi", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::_has_any_mcp"}) SET n += {`id`: "sym:tests/test_mcp.py::_has_any_mcp", `name`: "_has_any_mcp", `qualname`: "_has_any_mcp", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 65, `end_line`: 78, `signature`: "def _has_any_mcp():", `docstring`: "Any `mcp` SDK is importable at all, supported or not.\n\n    Only `test_tools_call_over_serve_completes_on_the_parallel_path` uses this -- it exercises `serve()`'s\n    own real behaviour (including refusing an unsupported SDK), so it must\n    run whenever *some* SDK is installed, not only a supported one.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::mcp_module"}) SET n += {`id`: "sym:tests/test_mcp.py::mcp_module", `name`: "mcp_module", `qualname`: "mcp_module", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 84, `end_line`: 87, `signature`: "def mcp_module():", `docstring`: ""};
