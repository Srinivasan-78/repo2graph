MERGE (n:R2G:Symbol {id: "sym:tests/test_doctor.py::test_doctor_provider_env_never_leaks_secrets"}) SET n += {`id`: "sym:tests/test_doctor.py::test_doctor_provider_env_never_leaks_secrets", `name`: "test_doctor_provider_env_never_leaks_secrets", `qualname`: "test_doctor_provider_env_never_leaks_secrets", `kind`: "function", `path`: "tests/test_doctor.py", `lang`: "python", `start_line`: 207, `end_line`: 241, `signature`: "def test_doctor_provider_env_never_leaks_secrets(monkeypatch):", `docstring`: "Verify provider environment probe never prints secret values.\n\n    Regression guard: the original masking (`val[:3]}...{val[-2:]}`, plus a\n    `length:` field) leaked the key's tail characters and exact length --\n    neither is caught by only checking the *middle* of the fixture key is\n    absent, so this asserts on the tail and on \"length:\" directly.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_doctor.py::test_doctor_mcp_sdk_reports_fail_when_unusable"}) SET n += {`id`: "sym:tests/test_doctor.py::test_doctor_mcp_sdk_reports_fail_when_unusable", `name`: "test_doctor_mcp_sdk_reports_fail_when_unusable", `qualname`: "test_doctor_mcp_sdk_reports_fail_when_unusable", `kind`: "function", `path`: "tests/test_doctor.py", `lang`: "python", `start_line`: 244, `end_line`: 260, `signature`: "def test_doctor_mcp_sdk_reports_fail_when_unusable(monkeypatch):", `docstring`: "A successful `import mcp` alone is not evidence the SDK is usable --\n    the check must actually probe `mcp.server.Server`, the thing serve()\n    (mcp.py) needs, and FAIL when that's unavailable rather than reporting\n    OK on the bare import.", `entrypoint`: true};
