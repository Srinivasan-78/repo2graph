MERGE (n:R2G:`Symbol` {id: "sym:tests/test_incremental.py::test_incremental_is_byte_identical_to_a_full_rebuild"}) SET n += {`id`: "sym:tests/test_incremental.py::test_incremental_is_byte_identical_to_a_full_rebuild", `name`: "test_incremental_is_byte_identical_to_a_full_rebuild", `qualname`: "test_incremental_is_byte_identical_to_a_full_rebuild", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 331, `end_line`: 350, `signature`: "def test_incremental_is_byte_identical_to_a_full_rebuild(tmp_path, mutate):", `docstring`: "The acceptance test: same bytes out, whatever route got there.\n\n    Two checkouts of the same content, mutated identically. One is built fresh;\n    the other is built once, mutated, then rebuilt incrementally. Every artifact\n    must match byte for byte -- including `stats.json`, which is why the\n    cached/re-parsed tallies live on `Graph.incremental` and not in `stats`.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_incremental.py::test_incremental_against_a_repo_with_no_index_is_a_full_build"}) SET n += {`id`: "sym:tests/test_incremental.py::test_incremental_against_a_repo_with_no_index_is_a_full_build", `name`: "test_incremental_against_a_repo_with_no_index_is_a_full_build", `qualname`: "test_incremental_against_a_repo_with_no_index_is_a_full_build", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 353, `end_line`: 359, `signature`: "def test_incremental_against_a_repo_with_no_index_is_a_full_build(tmp_path):", `docstring`: "`--incremental` on a cold directory works; it simply has nothing to reuse.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_incremental.py::test_a_corrupt_cache_falls_back_to_a_full_build"}) SET n += {`id`: "sym:tests/test_incremental.py::test_a_corrupt_cache_falls_back_to_a_full_build", `name`: "test_a_corrupt_cache_falls_back_to_a_full_build", `qualname`: "test_a_corrupt_cache_falls_back_to_a_full_build", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 365, `end_line`: 375, `signature`: "def test_a_corrupt_cache_falls_back_to_a_full_build(tmp_path, recorder):", `docstring`: "Garbage in `parse.cache.json` must cost a re-parse, never an exception.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_incremental.py::test_a_future_cache_format_is_ignored"}) SET n += {`id`: "sym:tests/test_incremental.py::test_a_future_cache_format_is_ignored", `name`: "test_a_future_cache_format_is_ignored", `qualname`: "test_a_future_cache_format_is_ignored", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 378, `end_line`: 388, `signature`: "def test_a_future_cache_format_is_ignored(tmp_path):", `docstring`: "A cache from a newer repo2graph is dropped rather than half-read.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_incremental.py::test_a_grammar_upgrade_invalidates_the_cache"}) SET n += {`id`: "sym:tests/test_incremental.py::test_a_grammar_upgrade_invalidates_the_cache", `name`: "test_a_grammar_upgrade_invalidates_the_cache", `qualname`: "test_a_grammar_upgrade_invalidates_the_cache", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 391, `end_line`: 419, `signature`: "def test_a_grammar_upgrade_invalidates_the_cache(tmp_path, recorder):", `docstring`: "A tree-sitter upgrade must force a full re-parse, not a silent mix.\n\n    `PARSE_CACHE_FORMAT` is bumped by hand and so only ever catches changes to\n    *our* extraction. A grammar upgrade changes what the same bytes parse to\n    while nothing in this repository changes, so the format constant stays put\n    and `--incremental` would reuse every entry for every unmodified file. The\n    index would then be half old-grammar and half new, and\n    `test_incremental_is_byte_identical_to_a_full_rebuild` cannot see it because\n    it never changes grammars mid-run.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_incremental.py::test_a_cache_written_before_grammars_were_keyed_is_ignored"}) SET n += {`id`: "sym:tests/test_incremental.py::test_a_cache_written_before_grammars_were_keyed_is_ignored", `name`: "test_a_cache_written_before_grammars_were_keyed_is_ignored", `qualname`: "test_a_cache_written_before_grammars_were_keyed_is_ignored", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 422, `end_line`: 437, `signature`: "def test_a_cache_written_before_grammars_were_keyed_is_ignored(tmp_path):", `docstring`: "Entries from an older repo2graph carry no `grammars` key.\n\n    They were produced by a grammar version that was never recorded, so there is\n    no way to tell whether they are reproducible. Absent must read as a miss,\n    not as \"no constraint\".", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_incremental.py::test_same_bytes_different_language_is_a_cache_miss"}) SET n += {`id`: "sym:tests/test_incremental.py::test_same_bytes_different_language_is_a_cache_miss", `name`: "test_same_bytes_different_language_is_a_cache_miss", `qualname`: "test_same_bytes_different_language_is_a_cache_miss", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 440, `end_line`: 455, `signature`: "def test_same_bytes_different_language_is_a_cache_miss(tmp_path, recorder):", `docstring`: "A rename that changes the language must not reuse the old parse.\n\n    `a.py` and `a.rs` can hold byte-identical content and parse to completely\n    different symbol sets, so the content hash alone is not a sufficient key.", `entrypoint`: true, `reach`: 277};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_incremental.py::entry_calls"}) SET n += {`id`: "sym:tests/test_incremental.py::entry_calls", `name`: "entry_calls", `qualname`: "entry_calls", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 486, `end_line`: 496, `signature`: "def entry_calls(out):", `docstring`: "The `(src, dst, type, resolution_kind)` tuples `entry` emits on disk."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_incremental.py::test_incremental_preserves_import_alias_resolution"}) SET n += {`id`: "sym:tests/test_incremental.py::test_incremental_preserves_import_alias_resolution", `name`: "test_incremental_preserves_import_alias_resolution", `qualname`: "test_incremental_preserves_import_alias_resolution", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 499, `end_line`: 518, `signature`: "def test_incremental_preserves_import_alias_resolution(tmp_path):", `docstring`: "An aliased import resolves identically on a cached rebuild.\n\n    `import_details` was not persisted in the parse cache, so a cache hit lost\n    every alias and the full build's `import_alias` edge came back as\n    `CALLS_EXTERNAL` / `unresolved_external`.\n\n    The module's headline byte-equality test cannot see this: a *plain*\n    `from x import y` still resolves through the IMPORTS edges, which are\n    rebuilt from `pf.imports`, and only the alias branch reads `import_details`.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_incremental.py::test_incremental_rename_and_delete_sequence"}) SET n += {`id`: "sym:tests/test_incremental.py::test_incremental_rename_and_delete_sequence", `name`: "test_incremental_rename_and_delete_sequence", `qualname`: "test_incremental_rename_and_delete_sequence", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 521, `end_line`: 565, `signature`: "def test_incremental_rename_and_delete_sequence(tmp_path):", `docstring`: "End-to-end sequence: build -> rename -> incremental -> delete -> incremental -> modify -> compare.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_incremental.py::test_a_changed_parse_option_invalidates_the_cache_and_says_why"}) SET n += {`id`: "sym:tests/test_incremental.py::test_a_changed_parse_option_invalidates_the_cache_and_says_why", `name`: "test_a_changed_parse_option_invalidates_the_cache_and_says_why", `qualname`: "test_a_changed_parse_option_invalidates_the_cache_and_says_why", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 568, `end_line`: 592, `signature`: "def test_a_changed_parse_option_invalidates_the_cache_and_says_why(tmp_path, recorder, capsys):", `docstring`: "#302: cached entries depend on --max-file-mb and --chunk-large-files\n    (whether a file was chunked) as much as on its bytes. Changing either must\n    force a re-parse, and the build must say which key component changed.", `entrypoint`: true, `reach`: 279};
