MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/auth.py::Identity"}) SET n += {`id`: "sym:repo2graph/auth.py::Identity", `name`: "Identity", `qualname`: "Identity", `kind`: "class", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 106, `end_line`: 119, `signature`: "class Identity:", `docstring`: "Who made a request, as far as the server can tell.\n\n    Attributes:\n        subject: The token's `sub` claim under OIDC, \"anonymous\" with no auth\n            configured, or \"bearer\" for a shared static token, which by\n            construction identifies no one in particular.\n        mode: Which authentication mode admitted this request.\n        claims: The validated JWT claims, empty for the other two modes."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/auth.py::b64url_decode"}) SET n += {`id`: "sym:repo2graph/auth.py::b64url_decode", `name`: "b64url_decode", `qualname`: "b64url_decode", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 122, `end_line`: 140, `signature`: "def b64url_decode(text: str) -> bytes:", `docstring`: "Decode base64url without padding, as every JWT field is encoded.\n\n    Args:\n        text: The base64url segment.\n\n    Returns:\n        The decoded bytes.\n\n    Raises:\n        AuthError: If the segment is not valid base64url."};
