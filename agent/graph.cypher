MERGE (n:R2G:Symbol {id: "sym:tests/test_auth.py::test_a_nan_exp_claim_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_nan_exp_claim_is_refused", `name`: "test_a_nan_exp_claim_is_refused", `qualname`: "test_a_nan_exp_claim_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 361, `end_line`: 369, `signature`: "def test_a_nan_exp_claim_is_refused():", `docstring`: "NaN compares False against every relational operator in IEEE 754.\n\n    `float(\"nan\") + CLOCK_SKEW < now` is False, so a naive expiry check lets a\n    NaN `exp` claim through as if the token never expires. It must fail closed.", `entrypoint`: true};
