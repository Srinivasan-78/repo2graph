MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_cy_key"}) SET n += {`id`: "sym:repo2graph/export.py::_cy_key", `name`: "_cy_key", `qualname`: "_cy_key", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 453, `end_line`: 458, `signature`: "def _cy_key(k: str) -> str:\n    # Always backtick-quote: covers Cypher reserved words (order, match, where,\n    # distinct, ...) and any other non-bare-identifier-safe key. Doubling an\n    # embedded backtick is Cypher's own escape for it inside a quoted\n    # identifier, so a key containing one can", `docstring`: ""};
