MERGE (n:R2G:Symbol {id: "sym:tests/test_incremental.py::test_adding_a_duplicate_name_elsewhere_lowers_confidence_repo_wide"}) SET n += {`id`: "sym:tests/test_incremental.py::test_adding_a_duplicate_name_elsewhere_lowers_confidence_repo_wide", `name`: "test_adding_a_duplicate_name_elsewhere_lowers_confidence_repo_wide", `qualname`: "test_adding_a_duplicate_name_elsewhere_lowers_confidence_repo_wide", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 178, `end_line`: 203, `signature`: "def test_adding_a_duplicate_name_elsewhere_lowers_confidence_repo_wide(tmp_path):", `docstring`: "The cross-file case the BACKLOG named as the blocker.\n\n    `caller.entry` calls `handle`. With one `handle` in the repo the edge is\n    confidence 1.0. Adding a *second* `handle` in a file the caller never\n    imports must drop that edge to 0.5 and add a second candidate edge -- even\n    though `pkg/caller.py` itself did not change and is served from cache.", `entrypoint`: true, `reach`: 163};
