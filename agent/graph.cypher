MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::sniff_header_lang"}) SET n += {`id`: "sym:repo2graph/parse.py::sniff_header_lang", `name`: "sniff_header_lang", `qualname`: "sniff_header_lang", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 141, `end_line`: 151, `signature`: "def sniff_header_lang(raw: bytes) -> str:", `docstring`: "Guess \"c\", \"cpp\" or \"objc\" for a `.h` file from its content (#377).\n\n    Cheap and best-effort: any single C++ signal anywhere in `raw` wins,\n    since a plain C header contains none of `CPP_HEADER_HINTS` in ordinary\n    (non-comment, non-string) code. Callers pass the bytes they already read\n    for hashing/parsing -- this never opens the file itself."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::component_script"}) SET n += {`id`: "sym:repo2graph/parse.py::component_script", `name`: "component_script", `qualname`: "component_script", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 160, `end_line`: 178, `signature`: "def component_script(raw: bytes) -> tuple[str, bytes]:", `docstring`: "The `<script>` blocks of a Vue or Svelte component, at their own lines.\n\n    Everything outside them becomes empty lines, so every line number the\n    JavaScript/TypeScript parser reports is the line in the `.vue`/`.svelte`\n    file. A `lang=\"ts\"` on any block parses them all as TypeScript."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::notebook_code"}) SET n += {`id`: "sym:repo2graph/parse.py::notebook_code", `name`: "notebook_code", `qualname`: "notebook_code", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 190, `end_line`: 226, `signature`: "def notebook_code(raw: bytes) -> bytes:", `docstring`: "A Jupyter notebook's code cells, each at the lines it occupies in the file.\n\n    Every other line becomes empty, so the Python parser's line numbers are\n    the notebook's own and a citation opens on the right line of the `.ipynb`.\n    The `\"source\": [` line of each code cell becomes `# cell N` (N counts\n    every cell from 1, as Jupyter shows them), so a chunk names its cell.\n    IPython magics and shell escapes (`%time`, `!pip`) become empty lines.\n    A notebook not written one source line per JSON line (minified) yields\n    nothing rather than wrong line numbers."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::refine_lang"}) SET n += {`id`: "sym:repo2graph/parse.py::refine_lang", `name`: "refine_lang", `qualname`: "refine_lang", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 229, `end_line`: 245, `signature`: "def refine_lang(lang: str | None, suffix: str, raw: bytes) -> tuple[str | None, bytes]:", `docstring`: "The language to parse a file as, and the bytes to give that parser.\n\n    `EXT_LANG` maps an extension; this settles what the extension cannot:\n    a `.h` header's C, C++ or Objective-C (#377), a `.m` file's Objective-C\n    or MATLAB (None: not parsed), and the code inside a Vue or Svelte\n    component or a notebook (#398). Line numbers are always the file's own."};
