MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::test_retrieve_signature_and_cmd_query_output_are_unchanged"}) SET n += {`id`: "sym:tests/test_rag.py::test_retrieve_signature_and_cmd_query_output_are_unchanged", `name`: "test_retrieve_signature_and_cmd_query_output_are_unchanged", `qualname`: "test_retrieve_signature_and_cmd_query_output_are_unchanged", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 478, `end_line`: 523, `signature`: "def test_retrieve_signature_and_cmd_query_output_are_unchanged(rag_out, capsys):", `docstring`: "Verify positional order preserved, and `query` prints the cited pack.\n\n    The output half used to assert `printed == format_pack(Index(out).retrieve(\n    ...))` -- the implementation against itself, so any traversal change moved\n    both sides together and stayed green. `test_retrieve_keeps_every_edge_direction`\n    below documents a real regression that slipped through exactly that\n    assertion. The literals here are hand-derived from `rag_repo`'s fixed\n    synthetic source, so a dropped edge direction or a mangled cite header fails.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::test_format_pack_renders_delimited_sections"}) SET n += {`id`: "sym:tests/test_rag.py::test_format_pack_renders_delimited_sections", `name`: "test_format_pack_renders_delimited_sections", `qualname`: "test_format_pack_renders_delimited_sections", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 526, `end_line`: 548, `signature`: "def test_format_pack_renders_delimited_sections():", `docstring`: "format_pack renders retrieval records as '--- path::qual [why]\\ntext' sections.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::test_retrieve_keeps_every_edge_direction"}) SET n += {`id`: "sym:tests/test_rag.py::test_retrieve_keeps_every_edge_direction", `name`: "test_retrieve_keeps_every_edge_direction", `qualname`: "test_retrieve_keeps_every_edge_direction", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 551, `end_line`: 581, `signature`: "def test_retrieve_keeps_every_edge_direction(dirs_out):", `docstring`: "Verify retrieve() must not inherit expand()'s DEFAULT_EDGE_DIRS.\n\n    The assertion above compares `cmd_query` output against `format_pack(\n    retrieve(...))` -- the implementation against itself -- so a traversal\n    change moves both sides together and stays green. That blind spot let\n    `retrieve()` pick up expand()'s restrictive\n    DEFAULT_EDGE_DIRS ({\"DEFINES\": (\"in\",), \"IMPORTS\": (\"out\",),\n    \"INHERITS\": (\"out\",)}) and silently dropped every DEFINES-out, IMPORTS-in\n    and INHERITS-in neighbour from the `query` command.\n\n    So: pin literal (node_id, why) pairs from the fixed synthet", `entrypoint`: true};
