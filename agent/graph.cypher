MERGE (n:R2G:`Symbol` {id: "sym:tests/test_demo.py::test_bare_repo2graph_lists_every_subcommand"}) SET n += {`id`: "sym:tests/test_demo.py::test_bare_repo2graph_lists_every_subcommand", `name`: "test_bare_repo2graph_lists_every_subcommand", `qualname`: "test_bare_repo2graph_lists_every_subcommand", `kind`: "function", `path`: "tests/test_demo.py", `lang`: "python", `start_line`: 218, `end_line`: 240, `signature`: "def test_bare_repo2graph_lists_every_subcommand(capsys):", `docstring`: "`repo2graph` with no arguments is the first thing a new user types.\n\n    It used to return from `main()` before a single `sub.add_parser(...)` ran,\n    so that help page listed no commands at all -- \"positional arguments: {}\"\n    -- while `repo2graph --help` listed all of them. Asserting on `demo` and\n    `build` alone would not have caught it either, since both are absent from\n    the broken page *and* the empty one; what pins it is that the two pages\n    agree.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_demo.py::test_demo_cli_reports_an_unwritable_target_without_a_traceback"}) SET n += {`id`: "sym:tests/test_demo.py::test_demo_cli_reports_an_unwritable_target_without_a_traceback", `name`: "test_demo_cli_reports_an_unwritable_target_without_a_traceback", `qualname`: "test_demo_cli_reports_an_unwritable_target_without_a_traceback", `kind`: "function", `path`: "tests/test_demo.py", `lang`: "python", `start_line`: 243, `end_line`: 255, `signature`: "def test_demo_cli_reports_an_unwritable_target_without_a_traceback(tmp_path, monkeypatch):", `docstring`: "The one first-run failure that actually happens: nowhere to write.", `entrypoint`: true};
