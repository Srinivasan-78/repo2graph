MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cpp_parse.py::test_the_cpp_version_probe_runs_once_across_many_erroring_files"}) SET n += {`id`: "sym:tests/test_cpp_parse.py::test_the_cpp_version_probe_runs_once_across_many_erroring_files", `name`: "test_the_cpp_version_probe_runs_once_across_many_erroring_files", `qualname`: "test_the_cpp_version_probe_runs_once_across_many_erroring_files", `kind`: "function", `path`: "tests/test_cpp_parse.py", `lang`: "python", `start_line`: 231, `end_line`: 249, `signature`: "def test_the_cpp_version_probe_runs_once_across_many_erroring_files(mock_run):", `docstring`: "#239: `cpp --version` answers the same thing for the life of the\n    process, so a macro-heavy tree must not pay a second spawn per file. The\n    count asserted is a hand-derived literal -- one probe, one preprocess per\n    file -- not a number the parser computed.", `entrypoint`: true};
