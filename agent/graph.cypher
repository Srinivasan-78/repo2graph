MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_cli_json_output_is_the_report_verbatim"}) SET n += {`id`: "sym:tests/test_index_status.py::test_cli_json_output_is_the_report_verbatim", `name`: "test_cli_json_output_is_the_report_verbatim", `qualname`: "test_cli_json_output_is_the_report_verbatim", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 456, `end_line`: 482, `signature`: "def test_cli_json_output_is_the_report_verbatim(built, capsys):", `docstring`: "`index_status`'s docstring promises `--json` prints the report verbatim,\n    so every key it returns is public API. That is the contract under test here:\n    a full dict comparison, not a spot-check of a few keys, because a CLI that\n    renamed or dropped one key on the way to stdout would break a consumer while\n    still satisfying any subset assertion.\n\n    `index.age_seconds` is the one legitimately volatile field -- whole seconds\n    since the manifest was written -- so it is dropped from *both* sides rather\n    than used as an excuse to weaken the comparison. Its presence is still\n    ass", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_cli_check_flag_gates_on_freshness"}) SET n += {`id`: "sym:tests/test_index_status.py::test_cli_check_flag_gates_on_freshness", `name`: "test_cli_check_flag_gates_on_freshness", `qualname`: "test_cli_check_flag_gates_on_freshness", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 485, `end_line`: 501, `signature`: "def test_cli_check_flag_gates_on_freshness(built, capsys):", `docstring`: "`--check` is the CI gate: a committed index that no longer matches the\n    commit it claims is a reviewable failure, not a warning nobody reads.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_pointing_at_the_agent_dir_gives_the_same_answer"}) SET n += {`id`: "sym:tests/test_index_status.py::test_pointing_at_the_agent_dir_gives_the_same_answer", `name`: "test_pointing_at_the_agent_dir_gives_the_same_answer", `qualname`: "test_pointing_at_the_agent_dir_gives_the_same_answer", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 504, `end_line`: 531, `signature`: "def test_pointing_at_the_agent_dir_gives_the_same_answer(built):", `docstring`: "`doctor` documents accepting either the -o directory or `agent/`, and a\n    caller who already resolved the path must not get a different report.\n\n    The source tree is the *index root's* parent -- one level up from `.r2g`,\n    two from `.r2g/agent` -- so deriving it from whatever directory was handed\n    in pointed the freshness check at `.r2g` and reported every source file as\n    removed.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_index_status.py::test_malformed_state_json_handled_gracefully"}) SET n += {`id`: "sym:tests/test_index_status.py::test_malformed_state_json_handled_gracefully", `name`: "test_malformed_state_json_handled_gracefully", `qualname`: "test_malformed_state_json_handled_gracefully", `kind`: "function", `path`: "tests/test_index_status.py", `lang`: "python", `start_line`: 534, `end_line`: 541, `signature`: "def test_malformed_state_json_handled_gracefully(built):", `docstring`: "Corrupted index.state.json reports stale gracefully without crashing.", `entrypoint`: true};
