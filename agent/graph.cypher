MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_surface_removed.py::_ParserReached"}) SET n += {`id`: "sym:tests/test_http_surface_removed.py::_ParserReached", `name`: "_ParserReached", `qualname`: "_ParserReached", `kind`: "class", `path`: "tests/test_http_surface_removed.py", `lang`: "python", `start_line`: 67, `end_line`: 68, `signature`: "class _ParserReached(Exception):", `docstring`: "Sentinel raised in place of `parse_args`, to stop an entrypoint at its parser."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_surface_removed.py::_registered_options"}) SET n += {`id`: "sym:tests/test_http_surface_removed.py::_registered_options", `name`: "_registered_options", `qualname`: "_registered_options", `kind`: "function", `path`: "tests/test_http_surface_removed.py", `lang`: "python", `start_line`: 71, `end_line`: 112, `signature`: "def _registered_options(main_fn, monkeypatch) -> set[str]:", `docstring`: "Every option string the entrypoint's parser and its subparsers accept.\n\n    An exit status alone is not a sufficient check here and a first draft of\n    this file was fooled by exactly that: a re-added `--http-port` that takes a\n    value still makes `main([\"--http-port\"])` exit 2, because argparse now\n    complains that the argument is missing rather than that the option is\n    unknown. Reading the registered options instead asks the question directly\n    -- is this flag back? -- and cannot be satisfied by a different error.\n\n    The parser is built inside `main`, so it is captured by standin"};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_surface_removed.py::_registered_options._capture"}) SET n += {`id`: "sym:tests/test_http_surface_removed.py::_registered_options._capture", `name`: "_capture", `qualname`: "_registered_options._capture", `kind`: "function", `path`: "tests/test_http_surface_removed.py", `lang`: "python", `start_line`: 88, `end_line`: 90, `signature`: "def _capture(self, args=None, namespace=None):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_surface_removed.py::_imported_modules"}) SET n += {`id`: "sym:tests/test_http_surface_removed.py::_imported_modules", `name`: "_imported_modules", `qualname`: "_imported_modules", `kind`: "function", `path`: "tests/test_http_surface_removed.py", `lang`: "python", `start_line`: 115, `end_line`: 135, `signature`: "def _imported_modules(path: Path) -> set[str]:", `docstring`: "Every module name `path` actually imports, from its AST.\n\n    Over `ast.Import` / `ast.ImportFrom` rather than a substring scan, because\n    `answer.py` and `security.py` both contain \"http\" and \"jwt\" in contexts that\n    have nothing to do with importing one: URL handling in the former, and a\n    literal list of secret-bearing key names in the latter (`security.py` has\n    `\"jwt\"` as a credential pattern). A grep for those words over the package\n    reports both files and tells you nothing.\n\n    Relative imports are skipped -- `from .auth import ...` cannot name a\n    third-party library, and"};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_surface_removed.py::test_auth_and_http_server_modules_are_gone_from_disk"}) SET n += {`id`: "sym:tests/test_http_surface_removed.py::test_auth_and_http_server_modules_are_gone_from_disk", `name`: "test_auth_and_http_server_modules_are_gone_from_disk", `qualname`: "test_auth_and_http_server_modules_are_gone_from_disk", `kind`: "function", `path`: "tests/test_http_surface_removed.py", `lang`: "python", `start_line`: 138, `end_line`: 150, `signature`: "def test_auth_and_http_server_modules_are_gone_from_disk():", `docstring`: "The two deleted files must not come back under their old names.\n\n    A restored `auth.py` or `http_server.py` would be dead code at best -- no\n    caller is left -- and at worst an unreviewed resurrection of the crypto the\n    removal existed to delete. Checked on disk as well as through the import\n    system so that a file present but never imported still fails.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_surface_removed.py::test_removed_modules_are_not_importable"}) SET n += {`id`: "sym:tests/test_http_surface_removed.py::test_removed_modules_are_not_importable", `name`: "test_removed_modules_are_not_importable", `qualname`: "test_removed_modules_are_not_importable", `kind`: "function", `path`: "tests/test_http_surface_removed.py", `lang`: "python", `start_line`: 154, `end_line`: 164, `signature`: "def test_removed_modules_are_not_importable(module):", `docstring`: "`import repo2graph.auth` must still fail.\n\n    Separate from the on-disk check: a module can be re-introduced as a package\n    directory, or re-exported from somewhere else under the old name, and either\n    would make the import succeed while no `auth.py` file exists.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_surface_removed.py::test_mcp_entrypoint_registers_no_removed_flag"}) SET n += {`id`: "sym:tests/test_http_surface_removed.py::test_mcp_entrypoint_registers_no_removed_flag", `name`: "test_mcp_entrypoint_registers_no_removed_flag", `qualname`: "test_mcp_entrypoint_registers_no_removed_flag", `kind`: "function", `path`: "tests/test_http_surface_removed.py", `lang`: "python", `start_line`: 167, `end_line`: 183, `signature`: "def test_mcp_entrypoint_registers_no_removed_flag(monkeypatch):", `docstring`: "`repo2graph-mcp` must not have any of the ten flags back on its parser.\n\n    This is the regression that matters most, and the one an exit status alone\n    cannot see. A config left over from 2.2.0 says `--auth-token hunter2`; if\n    the parser ever accepts it again -- even as a deprecated no-op -- the user\n    is told the server started and is never told their bearer token guards\n    nothing. stdio inherits the parent process's identity, so there is no\n    meaning left to give any of these.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_surface_removed.py::test_cli_registers_no_removed_flag"}) SET n += {`id`: "sym:tests/test_http_surface_removed.py::test_cli_registers_no_removed_flag", `name`: "test_cli_registers_no_removed_flag", `qualname`: "test_cli_registers_no_removed_flag", `kind`: "function", `path`: "tests/test_http_surface_removed.py", `lang`: "python", `start_line`: 186, `end_line`: 197, `signature`: "def test_cli_registers_no_removed_flag(monkeypatch):", `docstring`: "Nor may the `repo2graph` CLI, on any of its subcommands.\n\n    The CLI never served MCP over HTTP, but it is the binary users reach for\n    first and the obvious place to retry a flag that `repo2graph-mcp` just\n    refused. Checked across every subparser rather than at top level only,\n    because `build` and `github` are where a plausible-looking `--auth-token`\n    would be added.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_surface_removed.py::test_mcp_entrypoint_exits_nonzero_on_a_removed_flag"}) SET n += {`id`: "sym:tests/test_http_surface_removed.py::test_mcp_entrypoint_exits_nonzero_on_a_removed_flag", `name`: "test_mcp_entrypoint_exits_nonzero_on_a_removed_flag", `qualname`: "test_mcp_entrypoint_exits_nonzero_on_a_removed_flag", `kind`: "function", `path`: "tests/test_http_surface_removed.py", `lang`: "python", `start_line`: 201, `end_line`: 218, `signature`: "def test_mcp_entrypoint_exits_nonzero_on_a_removed_flag(flag, tmp_path, monkeypatch):", `docstring`: "Passing a removed flag must fail the process, not be quietly dropped.\n\n    The companion to the registration check: that one proves the option is not\n    declared, this one proves the end-to-end behaviour a 2.2.0 user actually\n    hits. Exit 2 is argparse's own code for an unrecognised argument, so the\n    status is asserted rather than the wording, which argparse is free to\n    reword between Python versions. `serve` is stubbed so that an accepted flag\n    shows up as a recorded call instead of a server blocking on stdin forever.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_surface_removed.py::test_cli_exits_nonzero_on_a_removed_flag"}) SET n += {`id`: "sym:tests/test_http_surface_removed.py::test_cli_exits_nonzero_on_a_removed_flag", `name`: "test_cli_exits_nonzero_on_a_removed_flag", `qualname`: "test_cli_exits_nonzero_on_a_removed_flag", `kind`: "function", `path`: "tests/test_http_surface_removed.py", `lang`: "python", `start_line`: 222, `end_line`: 226, `signature`: "def test_cli_exits_nonzero_on_a_removed_flag(flag):", `docstring`: "The CLI fails the same way, so neither binary silently accepts one.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_surface_removed.py::test_no_module_imports_an_http_framework_or_jwt_library"}) SET n += {`id`: "sym:tests/test_http_surface_removed.py::test_no_module_imports_an_http_framework_or_jwt_library", `name`: "test_no_module_imports_an_http_framework_or_jwt_library", `qualname`: "test_no_module_imports_an_http_framework_or_jwt_library", `kind`: "function", `path`: "tests/test_http_surface_removed.py", `lang`: "python", `start_line`: 229, `end_line`: 249, `signature`: "def test_no_module_imports_an_http_framework_or_jwt_library():", `docstring`: "No file under `repo2graph/` may import a web framework or a JWT library.\n\n    The flag checks above only cover the two parsers. This covers the shape of\n    the regression that does not go through a flag at all: a new module that\n    imports `fastapi` or `jwt` and brings the transport back beside the stdio\n    server rather than in place of it. It also keeps the README's and\n    SECURITY.md's \"no network calls\" claim honest at the dependency level.", `entrypoint`: true};
