MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss154_write_cypher_backtick_escapes_property_keys"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss154_write_cypher_backtick_escapes_property_keys", `name`: "test_iss154_write_cypher_backtick_escapes_property_keys", `qualname`: "test_iss154_write_cypher_backtick_escapes_property_keys", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2293, `end_line`: 2313, `signature`: "def test_iss154_write_cypher_backtick_escapes_property_keys(tmp_path):", `docstring`: "Issue 154: write_cypher backtick-quotes property keys so a Cypher reserved\n    word (e.g. `order`) doesn't break the generated statement, an embedded\n    backtick is escaped by doubling (no breaking out of the quoting), and a\n    normal bare-identifier-safe key stays exactly as before.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss24_write_html_handles_placeholder_in_title"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss24_write_html_handles_placeholder_in_title", `name`: "test_iss24_write_html_handles_placeholder_in_title", `qualname`: "test_iss24_write_html_handles_placeholder_in_title", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2316, `end_line`: 2328, `signature`: "def test_iss24_write_html_handles_placeholder_in_title(tmp_path):", `docstring`: "Issue 24 (ISS-33): repo name containing __R2G_DATA__ is not replaced by JSON blob in title.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_select_zero_draws_an_empty_graph"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_select_zero_draws_an_empty_graph", `name`: "test_select_zero_draws_an_empty_graph", `qualname`: "test_select_zero_draws_an_empty_graph", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2331, `end_line`: 2355, `signature`: "def test_select_zero_draws_an_empty_graph():", `docstring`: "0 means zero nodes, and `None` is the only spelling for \"no cap\".\n\n    This replaces the ISS-34 behaviour, where `max_nodes <= 0` meant no cap.\n    That made \"draw everything\" and \"draw nothing\" -- the two most opposite\n    intentions a caller can have -- share a spelling, so a mistyped or\n    defaulted-to-zero argument silently rendered the *largest* possible page.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_viz_nodes_flag_parses_all_and_rejects_negatives"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_viz_nodes_flag_parses_all_and_rejects_negatives", `name`: "test_viz_nodes_flag_parses_all_and_rejects_negatives", `qualname`: "test_viz_nodes_flag_parses_all_and_rejects_negatives", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2358, `end_line`: 2370, `signature`: "def test_viz_nodes_flag_parses_all_and_rejects_negatives():", `docstring`: "`--viz-nodes all` is the no-cap spelling; a negative is still refused.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_build_with_viz_nodes_zero_writes_an_empty_map"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_build_with_viz_nodes_zero_writes_an_empty_map", `name`: "test_build_with_viz_nodes_zero_writes_an_empty_map", `qualname`: "test_build_with_viz_nodes_zero_writes_an_empty_map", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2373, `end_line`: 2393, `signature`: "def test_build_with_viz_nodes_zero_writes_an_empty_map(tmp_path, capsys):", `docstring`: "End to end: 0 renders a page with no nodes rather than every node.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss22_chunk_caps_and_residual_span"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss22_chunk_caps_and_residual_span", `name`: "test_iss22_chunk_caps_and_residual_span", `qualname`: "test_iss22_chunk_caps_and_residual_span", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2396, `end_line`: 2424, `signature`: "def test_iss22_chunk_caps_and_residual_span(tmp_path):", `docstring`: "Issue 22 (ISS-23, ISS-26): named constants for chunk caps, and real line spans for residuals.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_split_does_not_break_a_chunk_on_u2028"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_split_does_not_break_a_chunk_on_u2028", `name`: "test_split_does_not_break_a_chunk_on_u2028", `qualname`: "test_split_does_not_break_a_chunk_on_u2028", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2430, `end_line`: 2439, `signature`: "def test_split_does_not_break_a_chunk_on_u2028():", `docstring`: "_split must cut only on \"\\\\n\"; a U+2028 inside a line is not a row break\n    for tree-sitter and must not become a chunk boundary (the ISS-22 class).", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_import_targets_kotlin_csharp_php"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_import_targets_kotlin_csharp_php", `name`: "test_import_targets_kotlin_csharp_php", `qualname`: "test_import_targets_kotlin_csharp_php", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2442, `end_line`: 2451, `signature`: "def test_import_targets_kotlin_csharp_php():", `docstring`: "Kotlin was mapped to the Rust `use` pattern, C# to Java's `import`, PHP to\n    JS quoted-string \u2014 none matched real syntax, so imports vanished silently.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_ruby_call_resolves_to_method_not_receiver"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_ruby_call_resolves_to_method_not_receiver", `name`: "test_ruby_call_resolves_to_method_not_receiver", `qualname`: "test_ruby_call_resolves_to_method_not_receiver", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2454, `end_line`: 2463, `signature`: "def test_ruby_call_resolves_to_method_not_receiver():", `docstring`: "Ruby's `call` node keeps receiver and method in separate fields; the old\n    fallback picked named_children[0] (the receiver), so `logger.info(x)` was\n    recorded as a call to `logger`.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_parse_source_swift_symbols_calls_and_imports"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_parse_source_swift_symbols_calls_and_imports", `name`: "test_parse_source_swift_symbols_calls_and_imports", `qualname`: "test_parse_source_swift_symbols_calls_and_imports", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2466, `end_line`: 2491, `signature`: "def test_parse_source_swift_symbols_calls_and_imports():", `docstring`: "Swift LANG_CFG had zero direct parse_source coverage (kind_map/calls/imports).", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_parse_source_tsx_symbols_calls_and_imports"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_parse_source_tsx_symbols_calls_and_imports", `name`: "test_parse_source_tsx_symbols_calls_and_imports", `qualname`: "test_parse_source_tsx_symbols_calls_and_imports", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2494, `end_line`: 2542, `signature`: "def test_parse_source_tsx_symbols_calls_and_imports():", `docstring`: "TSX LANG_CFG had zero direct parse_source coverage (kind_map extras / calls / imports).\n\n    The snippet is JSX-bearing on purpose: LANG_CFG['tsx'] shares typescript's\n    kind_map (interface / type alias / enum), but only the tsx grammar accepts\n    JSX. A silent drift to the javascript map would drop those extras; pointing\n    'tsx' at the non-JSX typescript grammar would ERROR the greet body and drop\n    the function (parse_errors == 0 is the lock).", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_glob_re_tolerates_malformed_bracket_classes"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_glob_re_tolerates_malformed_bracket_classes", `name`: "test_glob_re_tolerates_malformed_bracket_classes", `qualname`: "test_glob_re_tolerates_malformed_bracket_classes", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2545, `end_line`: 2553, `signature`: "def test_glob_re_tolerates_malformed_bracket_classes():", `docstring`: "A stray/empty bracket in --include/--exclude must not raise re.error.", `entrypoint`: true};
