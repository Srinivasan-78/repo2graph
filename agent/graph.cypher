MERGE (n:R2G:`Symbol` {id: "sym:tests/test_store.py::test_a_future_dated_source_does_not_rebuild_the_cache"}) SET n += {`id`: "sym:tests/test_store.py::test_a_future_dated_source_does_not_rebuild_the_cache", `name`: "test_a_future_dated_source_does_not_rebuild_the_cache", `qualname`: "test_a_future_dated_source_does_not_rebuild_the_cache", `kind`: "function", `path`: "tests/test_store.py", `lang`: "python", `start_line`: 175, `end_line`: 194, `signature`: "def test_a_future_dated_source_does_not_rebuild_the_cache(cached):", `docstring`: "Freshness is the index's `build_id`, never an mtime comparison.\n\n    The first version of this resolver compared the database's mtime with\n    `nodes.jsonl`'s, which rebuilt on *every* query whenever a source file\n    carried a future timestamp -- clock skew between a build host and a query\n    host, or a restored archive -- because the newly written database was\n    still \"older\" than its own input. A `build_id` is an identity rather than\n    an ordering, so a clock cannot outrun it.", `entrypoint`: true};
