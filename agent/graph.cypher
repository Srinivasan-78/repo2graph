MERGE (n:R2G:`Symbol` {id: "sym:scripts/make_demo_gif.py::build_frames"}) SET n += {`id`: "sym:scripts/make_demo_gif.py::build_frames", `name`: "build_frames", `qualname`: "build_frames", `kind`: "function", `path`: "scripts/make_demo_gif.py", `lang`: "python", `start_line`: 180, `end_line`: 205, `signature`: "def build_frames(scenes):", `docstring`: "scenes: list of (command, output_lines[, prompt]). Returns frames.\n\n    The prompt is per scene because not every scene is a shell: an MCP tool\n    call is not something anyone types at a `$`, and drawing it as one would\n    teach the reader the wrong thing about how the server is driven."};
MERGE (n:R2G:`Symbol` {id: "sym:scripts/make_demo_gif.py::master_palette"}) SET n += {`id`: "sym:scripts/make_demo_gif.py::master_palette", `name`: "master_palette", `qualname`: "master_palette", `kind`: "function", `path`: "scripts/make_demo_gif.py", `lang`: "python", `start_line`: 208, `end_line`: 225, `signature`: "def master_palette():", `docstring`: "A fixed palette: the UI colours plus an anti-aliasing ramp for each.\n\n    Quantizing adaptively would spend the whole table on text greys and merge\n    the three window lights -- 113 pixels each -- into one muddy dot. Naming\n    the colours instead keeps them exact and makes every frame's palette\n    identical, which is what lets GIF store later frames as deltas."};
MERGE (n:R2G:`Symbol` {id: "sym:scripts/make_demo_gif.py::save_gif"}) SET n += {`id`: "sym:scripts/make_demo_gif.py::save_gif", `name`: "save_gif", `qualname`: "save_gif", `kind`: "function", `path`: "scripts/make_demo_gif.py", `lang`: "python", `start_line`: 228, `end_line`: 259, `signature`: "def save_gif(frames, path: Path):", `docstring`: "Write the frames as one GIF, small enough to sit in a README.\n\n    Two things do the work. Every frame is quantized against a single palette\n    taken from the last (busiest) frame, so consecutive frames share colour\n    indices and GIF's own delta coding can fire -- a per-frame adaptive palette\n    re-encodes the whole canvas each time and roughly triples the file. And\n    runs of identical frames (the typing pause, the hold at the end) collapse\n    into one frame with a longer delay instead of dozens of copies."};
MERGE (n:R2G:`Symbol` {id: "sym:scripts/make_demo_gif.py::run"}) SET n += {`id`: "sym:scripts/make_demo_gif.py::run", `name`: "run", `qualname`: "run", `kind`: "function", `path`: "scripts/make_demo_gif.py", `lang`: "python", `start_line`: 263, `end_line`: 275, `signature`: "def run(args: list[str], cwd: Path | None = None) -> list[str]:", `docstring`: "Run a command and return its stdout as display lines.\n\n    `PYTHONIOENCODING` is forced because a piped stdout on Windows encodes to\n    cp1252, which turns every em dash in the CLI's own output into `?`."};
