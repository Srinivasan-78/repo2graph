MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_split_does_not_break_a_chunk_on_u2028"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_split_does_not_break_a_chunk_on_u2028", `name`: "test_split_does_not_break_a_chunk_on_u2028", `qualname`: "test_split_does_not_break_a_chunk_on_u2028", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2113, `end_line`: 2122, `signature`: "def test_split_does_not_break_a_chunk_on_u2028():", `docstring`: "_split must cut only on \"\\\\n\"; a U+2028 inside a line is not a row break\n    for tree-sitter and must not become a chunk boundary (the ISS-22 class).", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_import_targets_kotlin_csharp_php"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_import_targets_kotlin_csharp_php", `name`: "test_import_targets_kotlin_csharp_php", `qualname`: "test_import_targets_kotlin_csharp_php", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2125, `end_line`: 2134, `signature`: "def test_import_targets_kotlin_csharp_php():", `docstring`: "Kotlin was mapped to the Rust `use` pattern, C# to Java's `import`, PHP to\n    JS quoted-string \u2014 none matched real syntax, so imports vanished silently.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_ruby_call_resolves_to_method_not_receiver"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_ruby_call_resolves_to_method_not_receiver", `name`: "test_ruby_call_resolves_to_method_not_receiver", `qualname`: "test_ruby_call_resolves_to_method_not_receiver", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2137, `end_line`: 2146, `signature`: "def test_ruby_call_resolves_to_method_not_receiver():", `docstring`: "Ruby's `call` node keeps receiver and method in separate fields; the old\n    fallback picked named_children[0] (the receiver), so `logger.info(x)` was\n    recorded as a call to `logger`.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_parse_source_swift_symbols_calls_and_imports"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_parse_source_swift_symbols_calls_and_imports", `name`: "test_parse_source_swift_symbols_calls_and_imports", `qualname`: "test_parse_source_swift_symbols_calls_and_imports", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2149, `end_line`: 2174, `signature`: "def test_parse_source_swift_symbols_calls_and_imports():", `docstring`: "Swift LANG_CFG had zero direct parse_source coverage (kind_map/calls/imports).", `entrypoint`: true};
