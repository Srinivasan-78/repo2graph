MERGE (n:R2G:`Symbol` {id: "sym:tests/test_secrets_hardening.py::test_an_allowlisted_key_still_has_its_value_inspected"}) SET n += {`id`: "sym:tests/test_secrets_hardening.py::test_an_allowlisted_key_still_has_its_value_inspected", `name`: "test_an_allowlisted_key_still_has_its_value_inspected", `qualname`: "test_an_allowlisted_key_still_has_its_value_inspected", `kind`: "function", `path`: "tests/test_secrets_hardening.py", `lang`: "python", `start_line`: 1073, `end_line`: 1084, `signature`: "def test_an_allowlisted_key_still_has_its_value_inspected():", `docstring`: "Allowlisting the *name* must not blind the value checks.\n\n    A credential that turns up under one of these names is still caught by the\n    shape rules -- the allowlist skips the name test, not the rest.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_secrets_hardening.py::test_every_allowlisted_key_actually_matches_the_regex"}) SET n += {`id`: "sym:tests/test_secrets_hardening.py::test_every_allowlisted_key_actually_matches_the_regex", `name`: "test_every_allowlisted_key_actually_matches_the_regex", `qualname`: "test_every_allowlisted_key_actually_matches_the_regex", `kind`: "function", `path`: "tests/test_secrets_hardening.py", `lang`: "python", `start_line`: 1087, `end_line`: 1097, `signature`: "def test_every_allowlisted_key_actually_matches_the_regex():", `docstring`: "An entry that does not match SECRET_KEY_RE is dead weight.\n\n    It would silently suggest the name is dangerous when the general rule\n    never flagged it, which is how an allowlist rots into a list of guesses.", `entrypoint`: true};
