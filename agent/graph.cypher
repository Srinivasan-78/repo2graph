MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/audit.py::_LockedAppender.write"}) SET n += {`id`: "sym:repo2graph/audit.py::_LockedAppender.write", `name`: "write", `qualname`: "_LockedAppender.write", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 152, `end_line`: 183, `signature`: "def write(self, line: str) -> None:", `docstring`: "Append one line, holding an OS-level lock for the write."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/audit.py::_LockedAppender._acquire"}) SET n += {`id`: "sym:repo2graph/audit.py::_LockedAppender._acquire", `name`: "_acquire", `qualname`: "_LockedAppender._acquire", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 185, `end_line`: 225, `signature`: "def _acquire(self, fh: TextIO) -> None:\n        # sys.platform branches, not a bare try/except ImportError: mypy checks\n        # each platform's CI job against that job's own sys.platform, so it\n        # statically knows the other branch is unreachable there and needs no\n        # ignore comment o", `docstring`: ""};
