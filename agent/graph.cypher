MERGE (n:R2G:Symbol {id: "sym:scripts/make_demo_gif.py::scene_rag"}) SET n += {`id`: "sym:scripts/make_demo_gif.py::scene_rag", `name`: "scene_rag", `qualname`: "scene_rag", `kind`: "function", `path`: "scripts/make_demo_gif.py", `lang`: "python", `start_line`: 301, `end_line`: 310, `signature`: "def scene_rag(repo: Path, index: Path):", `docstring`: "Ask a question, get cited code back -- the one-screen pitch.\n\n    The output is shown unfiltered and simply scrolls: the repo map goes by\n    first and the `[cite: ...]` blocks land on the closing frames, which is\n    both what the terminal does and the half worth freezing on.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:scripts/make_demo_gif.py::scene_build"}) SET n += {`id`: "sym:scripts/make_demo_gif.py::scene_build", `name`: "scene_build", `qualname`: "scene_build", `kind`: "function", `path`: "scripts/make_demo_gif.py", `lang`: "python", `start_line`: 313, `end_line`: 342, `signature`: "def scene_build(repo: Path, index: Path):", `docstring`: "Point it at a folder; no setup step, no language server.\n\n    This one runs verbatim what the caption claims -- no `--exclude` -- because\n    nothing from `scripts/` can reach a stats block anyway.", `entrypoint`: true};
