MERGE (n:R2G:`Symbol` {id: "sym:tests/test_output_schema.py::test_mcp_neighbours_cites_the_call_site_not_just_the_definition"}) SET n += {`id`: "sym:tests/test_output_schema.py::test_mcp_neighbours_cites_the_call_site_not_just_the_definition", `name`: "test_mcp_neighbours_cites_the_call_site_not_just_the_definition", `qualname`: "test_mcp_neighbours_cites_the_call_site_not_just_the_definition", `kind`: "function", `path`: "tests/test_output_schema.py", `lang`: "python", `start_line`: 617, `end_line`: 636, `signature`: "def test_mcp_neighbours_cites_the_call_site_not_just_the_definition(indexed):", `docstring`: "For \"what calls this\", the useful citation is the call site.\n\n    The node label says where the *neighbour* is defined; the edge's evidence\n    says where the relationship is written. `repo_neighbours` must carry both,\n    or an agent asking for callers gets a list of definitions with no way to\n    open the lines that actually do the calling.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_output_schema.py::test_mcp_neighbours_marks_an_ambiguous_edge"}) SET n += {`id`: "sym:tests/test_output_schema.py::test_mcp_neighbours_marks_an_ambiguous_edge", `name`: "test_mcp_neighbours_marks_an_ambiguous_edge", `qualname`: "test_mcp_neighbours_marks_an_ambiguous_edge", `kind`: "function", `path`: "tests/test_output_schema.py", `lang`: "python", `start_line`: 639, `end_line`: 672, `signature`: "def test_mcp_neighbours_marks_an_ambiguous_edge(tmp_path):", `docstring`: "An edge below 1.0 must not read like a certain one.\n\n    Without the marker, a name that matched three candidates is presented to\n    the agent exactly as a unique resolution is -- which is the trust problem\n    the edge schema exists to fix, on the one surface an agent actually reads.", `entrypoint`: true, `reach`: 381};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_output_schema.py::test_mcp_search_returns_cited_markdown"}) SET n += {`id`: "sym:tests/test_output_schema.py::test_mcp_search_returns_cited_markdown", `name`: "test_mcp_search_returns_cited_markdown", `qualname`: "test_mcp_search_returns_cited_markdown", `kind`: "function", `path`: "tests/test_output_schema.py", `lang`: "python", `start_line`: 675, `end_line`: 683, `signature`: "def test_mcp_search_returns_cited_markdown(indexed):", `docstring`: "`repo_search` returns the pack's markdown, headers and all.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_output_schema.py::test_mcp_tools_return_text_not_json"}) SET n += {`id`: "sym:tests/test_output_schema.py::test_mcp_tools_return_text_not_json", `name`: "test_mcp_tools_return_text_not_json", `qualname`: "test_mcp_tools_return_text_not_json", `kind`: "function", `path`: "tests/test_output_schema.py", `lang`: "python", `start_line`: 686, `end_line`: 703, `signature`: "def test_mcp_tools_return_text_not_json(indexed):", `docstring`: "Pinned because docs/architecture.md documents the citation *form* per\n    surface, and it previously claimed these returned per-result `path` and\n    `start_line` fields. They return strings.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_output_schema.py::test_bundle_scrubs_paths_out_of_free_text_notes"}) SET n += {`id`: "sym:tests/test_output_schema.py::test_bundle_scrubs_paths_out_of_free_text_notes", `name`: "test_bundle_scrubs_paths_out_of_free_text_notes", `qualname`: "test_bundle_scrubs_paths_out_of_free_text_notes", `kind`: "function", `path`: "tests/test_output_schema.py", `lang`: "python", `start_line`: 706, `end_line`: 734, `signature`: "def test_bundle_scrubs_paths_out_of_free_text_notes(indexed, monkeypatch):", `docstring`: "Prose assembled elsewhere must not be able to smuggle a path in.\n\n    `compute_freshness` interpolates an exception message into a note, and an\n    `OSError` carries the absolute path that failed -- so a discovery failure\n    put an absolute path to `pkg/secret_roadmap.py` into a bundle that\n    promises no absolute paths and no filenames. The happy path produces no\n    such note, which is why the other privacy tests did not see it.\n\n    Scrubbed at the boundary rather than in each producer: the guarantee has\n    to hold for prose written by code that has never heard of the bundle.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_output_schema.py::test_bundle_scrubs_paths_out_of_free_text_notes._boom"}) SET n += {`id`: "sym:tests/test_output_schema.py::test_bundle_scrubs_paths_out_of_free_text_notes._boom", `name`: "_boom", `qualname`: "test_bundle_scrubs_paths_out_of_free_text_notes._boom", `kind`: "function", `path`: "tests/test_output_schema.py", `lang`: "python", `start_line`: 723, `end_line`: 724, `signature`: "def _boom(*a, **k):", `docstring`: ""};
