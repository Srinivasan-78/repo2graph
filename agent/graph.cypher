MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graphdiff.py::_ambiguous_deep_repo"}) SET n += {`id`: "sym:tests/test_graphdiff.py::_ambiguous_deep_repo", `name`: "_ambiguous_deep_repo", `qualname`: "_ambiguous_deep_repo", `kind`: "function", `path`: "tests/test_graphdiff.py", `lang`: "python", `start_line`: 365, `end_line`: 402, `signature`: "def _ambiguous_deep_repo(tmp_path):", `docstring`: "A test reachable from the edit only through a 3-way-ambiguous call.\n\n    `target` is defined in three modules, so the call in `inner_call` resolves\n    to all three at `confidence = 1/3` -- below the 0.5 floor that used to\n    prune it. The test is 3 hops from the edit, past `derived.py`'s\n    pre-materialized `TESTS` edges (`TESTS_MAX_HOPS = 2`), so the live reverse\n    CALLS walk is the only way to reach it."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graphdiff.py::test_affected_tests_keeps_tests_behind_an_ambiguous_call"}) SET n += {`id`: "sym:tests/test_graphdiff.py::test_affected_tests_keeps_tests_behind_an_ambiguous_call", `name`: "test_affected_tests_keeps_tests_behind_an_ambiguous_call", `qualname`: "test_affected_tests_keeps_tests_behind_an_ambiguous_call", `kind`: "function", `path`: "tests/test_graphdiff.py", `lang`: "python", `start_line`: 405, `end_line`: 424, `signature`: "def test_affected_tests_keeps_tests_behind_an_ambiguous_call(tmp_path):", `docstring`: "#508: a test reached only through a low-confidence CALLS edge must not vanish.\n\n    A 0.5 confidence floor severed the walk at the ambiguous hop and returned\n    `affected_tests: []` -- a silent false negative, which in CI means a green\n    run over code nothing exercised.", `entrypoint`: true, `reach`: 299};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graphdiff.py::test_affected_tests_reports_when_narrowing_drops_edges"}) SET n += {`id`: "sym:tests/test_graphdiff.py::test_affected_tests_reports_when_narrowing_drops_edges", `name`: "test_affected_tests_reports_when_narrowing_drops_edges", `qualname`: "test_affected_tests_reports_when_narrowing_drops_edges", `kind`: "function", `path`: "tests/test_graphdiff.py", `lang`: "python", `start_line`: 427, `end_line`: 450, `signature`: "def test_affected_tests_reports_when_narrowing_drops_edges(tmp_path):", `docstring`: "Asking for the old 0.5 floor still narrows -- but says that it did.\n\n    The point is that the trade is reported rather than implicit: the same walk\n    that loses the test also sets `truncated`, so a CI caller can tell a\n    provably complete subset from a lossy one.", `entrypoint`: true, `reach`: 300};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graphdiff.py::test_affected_tests_flags_a_walk_cut_off_by_max_hops"}) SET n += {`id`: "sym:tests/test_graphdiff.py::test_affected_tests_flags_a_walk_cut_off_by_max_hops", `name`: "test_affected_tests_flags_a_walk_cut_off_by_max_hops", `qualname`: "test_affected_tests_flags_a_walk_cut_off_by_max_hops", `kind`: "function", `path`: "tests/test_graphdiff.py", `lang`: "python", `start_line`: 453, `end_line`: 464, `signature`: "def test_affected_tests_flags_a_walk_cut_off_by_max_hops(tmp_path):", `docstring`: "A hop limit that stops mid-expansion marks the selection incomplete.", `entrypoint`: true, `reach`: 299};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graphdiff.py::test_affected_tests_sees_through_a_test_helper"}) SET n += {`id`: "sym:tests/test_graphdiff.py::test_affected_tests_sees_through_a_test_helper", `name`: "test_affected_tests_sees_through_a_test_helper", `qualname`: "test_affected_tests_sees_through_a_test_helper", `kind`: "function", `path`: "tests/test_graphdiff.py", `lang`: "python", `start_line`: 467, `end_line`: 512, `signature`: "def test_affected_tests_sees_through_a_test_helper(tmp_path):", `docstring`: "A test reached only via a fixture/helper module must not be dropped.\n\n    `is_test_path` is true of every module under `tests/` -- `conftest.py`,\n    fixtures, assertion helpers -- and `derived.py` seeds a `TESTS` edge from\n    the helper nearest the modified code. The walk used to mark that helper\n    visited without ever expanding it, so the real `test_*.py` callers one hop\n    further out were never reached, and the frontier still drained, so nothing\n    reported the answer as incomplete. Fixtures and helpers are the common case,\n    which made this the same silent false negative in a new p", `entrypoint`: true, `reach`: 303};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graphdiff.py::test_affected_tests_sees_through_a_test_helper.w"}) SET n += {`id`: "sym:tests/test_graphdiff.py::test_affected_tests_sees_through_a_test_helper.w", `name`: "w", `qualname`: "test_affected_tests_sees_through_a_test_helper.w", `kind`: "function", `path`: "tests/test_graphdiff.py", `lang`: "python", `start_line`: 483, `end_line`: 486, `signature`: "def w(rel, text):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graphdiff.py::test_affected_tests_does_not_follow_a_shadowed_builtin"}) SET n += {`id`: "sym:tests/test_graphdiff.py::test_affected_tests_does_not_follow_a_shadowed_builtin", `name`: "test_affected_tests_does_not_follow_a_shadowed_builtin", `qualname`: "test_affected_tests_does_not_follow_a_shadowed_builtin", `kind`: "function", `path`: "tests/test_graphdiff.py", `lang`: "python", `start_line`: 515, `end_line`: 558, `signature`: "def test_affected_tests_does_not_follow_a_shadowed_builtin(tmp_path):", `docstring`: "Editing a function that shadows a builtin must not select the whole suite.\n\n    A `shadowed_builtin` edge is not an ambiguous *candidate* the way a 1/n\n    name-resolution edge is -- the call almost certainly went to the builtin and\n    the user symbol merely shares its name. Following them turned a two-line\n    edit into \"run every test that calls `len()`\", which is the feature failing\n    in the over-selection direction.", `entrypoint`: true, `reach`: 303};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graphdiff.py::test_affected_tests_does_not_follow_a_shadowed_builtin.w"}) SET n += {`id`: "sym:tests/test_graphdiff.py::test_affected_tests_does_not_follow_a_shadowed_builtin.w", `name`: "w", `qualname`: "test_affected_tests_does_not_follow_a_shadowed_builtin.w", `kind`: "function", `path`: "tests/test_graphdiff.py", `lang`: "python", `start_line`: 529, `end_line`: 532, `signature`: "def w(rel, text):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graphdiff.py::test_affected_tests_admits_it_cannot_see_fixture_injection"}) SET n += {`id`: "sym:tests/test_graphdiff.py::test_affected_tests_admits_it_cannot_see_fixture_injection", `name`: "test_affected_tests_admits_it_cannot_see_fixture_injection", `qualname`: "test_affected_tests_admits_it_cannot_see_fixture_injection", `kind`: "function", `path`: "tests/test_graphdiff.py", `lang`: "python", `start_line`: 561, `end_line`: 606, `signature`: "def test_affected_tests_admits_it_cannot_see_fixture_injection(tmp_path):", `docstring`: "Reaching a conftest means the untraceable consumers must be declared.\n\n    A test that *receives* a pytest fixture never calls it by name, so there is\n    no call edge and the consumer is invisible to the walk. Here 30 tests reach\n    the modified function only that way: the selection is `['tests/conftest.py']`\n    and the frontier drains, so without this guard the answer would be reported\n    as complete while missing every test that actually exercises the change.", `entrypoint`: true, `reach`: 304};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graphdiff.py::test_affected_tests_admits_it_cannot_see_fixture_injection.w"}) SET n += {`id`: "sym:tests/test_graphdiff.py::test_affected_tests_admits_it_cannot_see_fixture_injection.w", `name`: "w", `qualname`: "test_affected_tests_admits_it_cannot_see_fixture_injection.w", `kind`: "function", `path`: "tests/test_graphdiff.py", `lang`: "python", `start_line`: 575, `end_line`: 578, `signature`: "def w(rel, text):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graphdiff.py::test_affected_tests_stays_complete_without_a_conftest"}) SET n += {`id`: "sym:tests/test_graphdiff.py::test_affected_tests_stays_complete_without_a_conftest", `name`: "test_affected_tests_stays_complete_without_a_conftest", `qualname`: "test_affected_tests_stays_complete_without_a_conftest", `kind`: "function", `path`: "tests/test_graphdiff.py", `lang`: "python", `start_line`: 609, `end_line`: 637, `signature`: "def test_affected_tests_stays_complete_without_a_conftest(tmp_path):", `docstring`: "The fixture caveat must not fire on a repo that has no conftest in range.\n\n    `truncated` is only useful if it means something, so the guard is\n    conditioned on actually reaching a conftest rather than on the repository\n    containing fixtures anywhere.", `entrypoint`: true, `reach`: 303};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graphdiff.py::test_affected_tests_stays_complete_without_a_conftest.w"}) SET n += {`id`: "sym:tests/test_graphdiff.py::test_affected_tests_stays_complete_without_a_conftest.w", `name`: "w", `qualname`: "test_affected_tests_stays_complete_without_a_conftest.w", `kind`: "function", `path`: "tests/test_graphdiff.py", `lang`: "python", `start_line`: 621, `end_line`: 624, `signature`: "def w(rel, text):", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_graphdiff.py::test_follow_shadowed_builtins_recovers_the_dropped_edges"}) SET n += {`id`: "sym:tests/test_graphdiff.py::test_follow_shadowed_builtins_recovers_the_dropped_edges", `name`: "test_follow_shadowed_builtins_recovers_the_dropped_edges", `qualname`: "test_follow_shadowed_builtins_recovers_the_dropped_edges", `kind`: "function", `path`: "tests/test_graphdiff.py", `lang`: "python", `start_line`: 640, `end_line`: 681, `signature`: "def test_follow_shadowed_builtins_recovers_the_dropped_edges(tmp_path):", `docstring`: "The shadowed-builtin exclusion is a heuristic, so it must be overridable.\n\n    Dropping those edges is right by default -- the call almost always went to\n    the builtin -- but a codebase that really does define and call its own `len`\n    would otherwise have no way to select the tests that exercise it, and no way\n    to correct a heuristic that is wrong about their code.", `entrypoint`: true, `reach`: 303};
