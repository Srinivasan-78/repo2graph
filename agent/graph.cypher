MERGE (n:R2G:`Symbol` {id: "sym:scripts/bench_real_repos.py::source_version"}) SET n += {`id`: "sym:scripts/bench_real_repos.py::source_version", `name`: "source_version", `qualname`: "source_version", `kind`: "function", `path`: "scripts/bench_real_repos.py", `lang`: "python", `start_line`: 78, `end_line`: 102, `signature`: "def source_version(root: Path = ROOT) -> str:", `docstring`: "The version of the *checked-out* source, never of an installed dist-info.\n\n    `repo2graph.__version__` asks importlib.metadata first, and an editable\n    install's dist-info keeps whatever version it was installed at -- a 2.2.0\n    run was labelled 2.1.0. pyproject.toml's `[project] version` is what the\n    code on disk is; the `__init__` fallback constant is the second source.\n    (Regex, not tomllib: Python 3.10 is supported.)"};
