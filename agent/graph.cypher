MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answer_limits.py::TricklingResponse"}) SET n += {`id`: "sym:tests/test_answer_limits.py::TricklingResponse", `name`: "TricklingResponse", `qualname`: "TricklingResponse", `kind`: "class", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 426, `end_line`: 443, `signature`: "class TricklingResponse(SizedResponse):", `docstring`: "A response that serves small blocks and charges wall-clock time per read.\n\n    The point of the double is the pairing: every block is tiny, so the byte\n    ceiling is never approached, while the clock advances on each read. That is\n    exactly the shape neither of the other two bounds catches -- `HTTP_TIMEOUT`\n    is a socket timeout and resets on every byte that does arrive."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answer_limits.py::TricklingResponse.__init__"}) SET n += {`id`: "sym:tests/test_answer_limits.py::TricklingResponse.__init__", `name`: "__init__", `qualname`: "TricklingResponse.__init__", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 435, `end_line`: 439, `signature`: "def __init__(self, body: bytes, block: int, seconds_per_read: float):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answer_limits.py::TricklingResponse.read"}) SET n += {`id`: "sym:tests/test_answer_limits.py::TricklingResponse.read", `name`: "read", `qualname`: "TricklingResponse.read", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 441, `end_line`: 443, `signature`: "def read(self, size=-1):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answer_limits.py::trickle"}) SET n += {`id`: "sym:tests/test_answer_limits.py::trickle", `name`: "trickle", `qualname`: "trickle", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 446, `end_line`: 451, `signature`: "def trickle(monkeypatch, body: bytes, block: int, seconds_per_read: float) -> TricklingResponse:", `docstring`: "Serve `body` slowly, with `answer`'s clock driven by the response itself."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answer_limits.py::test_a_trickling_provider_cannot_stream_forever"}) SET n += {`id`: "sym:tests/test_answer_limits.py::test_a_trickling_provider_cannot_stream_forever", `name`: "test_a_trickling_provider_cannot_stream_forever", `qualname`: "test_a_trickling_provider_cannot_stream_forever", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 454, `end_line`: 479, `signature`: "def test_a_trickling_provider_cannot_stream_forever(monkeypatch, capsys):", `docstring`: "Axis 3 (C26b): a slow stream is bounded by wall-clock time, not bytes.\n\n    Neither existing bound closes this. `MAX_ANSWER_BYTES` only fires once the\n    body is enormous, and this one is a few kilobytes. `HTTP_TIMEOUT` measures\n    the gap *between* reads and resets whenever a byte arrives, so a host that\n    sends a little, forever, never trips it. Before `MAX_ANSWER_SECONDS` the\n    call had no upper bound on its own duration at all.\n\n    The budget is the real `MAX_ANSWER_SECONDS`, not a shrunken one, so a\n    fixture that is merely short cannot pass this by accident.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answer_limits.py::test_a_prompt_stream_is_not_reported_as_timed_out"}) SET n += {`id`: "sym:tests/test_answer_limits.py::test_a_prompt_stream_is_not_reported_as_timed_out", `name`: "test_a_prompt_stream_is_not_reported_as_timed_out", `qualname`: "test_a_prompt_stream_is_not_reported_as_timed_out", `kind`: "function", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 482, `end_line`: 492, `signature`: "def test_a_prompt_stream_is_not_reported_as_timed_out(monkeypatch, capsys):", `docstring`: "The budget must not fire on a normal answer that simply took some time.", `entrypoint`: true};
