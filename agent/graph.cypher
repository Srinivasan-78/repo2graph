MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_select_zero_draws_an_empty_graph"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_select_zero_draws_an_empty_graph", `name`: "test_select_zero_draws_an_empty_graph", `qualname`: "test_select_zero_draws_an_empty_graph", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 2014, `end_line`: 2038, `signature`: "def test_select_zero_draws_an_empty_graph():", `docstring`: "0 means zero nodes, and `None` is the only spelling for \"no cap\".\n\n    This replaces the ISS-34 behaviour, where `max_nodes <= 0` meant no cap.\n    That made \"draw everything\" and \"draw nothing\" -- the two most opposite\n    intentions a caller can have -- share a spelling, so a mistyped or\n    defaulted-to-zero argument silently rendered the *largest* possible page.", `entrypoint`: true};
