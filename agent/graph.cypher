MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::FakeGitProc.wait"}) SET n += {`id`: "sym:tests/test_repo2graph.py::FakeGitProc.wait", `name`: "wait", `qualname`: "FakeGitProc.wait", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1327, `end_line`: 1329, `signature`: "def wait(self, timeout=None):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::fake_git_popen"}) SET n += {`id`: "sym:tests/test_repo2graph.py::fake_git_popen", `name`: "fake_git_popen", `qualname`: "fake_git_popen", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1332, `end_line`: 1340, `signature`: "def fake_git_popen(stdout: bytes, returncode: int = 0, seen=None):", `docstring`: "A Popen replacement that always yields `stdout`, recording the argv."};
