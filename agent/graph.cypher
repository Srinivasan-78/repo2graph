MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::_resolved_push_git_calls"}) SET n += {`id`: "sym:tests/test_compat.py::_resolved_push_git_calls", `name`: "_resolved_push_git_calls", `qualname`: "_resolved_push_git_calls", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 595, `end_line`: 625, `signature`: "def _resolved_push_git_calls(tmp_path: Path, token: str) -> list:", `docstring`: "Every `git ...` invocation the \"Push graph to branch\" step's real body\n    makes, as the literal argv bash hands it -- captured by overriding `git`\n    with a shell function instead of truncating/rewriting the script, so the\n    step body under test is exactly what's in action.yml, unmodified."};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_iss165_the_token_never_appears_in_a_git_argv_word"}) SET n += {`id`: "sym:tests/test_compat.py::test_iss165_the_token_never_appears_in_a_git_argv_word", `name`: "test_iss165_the_token_never_appears_in_a_git_argv_word", `qualname`: "test_iss165_the_token_never_appears_in_a_git_argv_word", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 629, `end_line`: 637, `signature`: "def test_iss165_the_token_never_appears_in_a_git_argv_word(tmp_path):", `docstring`: "The exact secret value must not be a word in any `git` invocation's\n    argv -- not just the `push` call, since a leak in `remote add` or\n    elsewhere would be just as visible to `ps`.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_iss165_the_push_call_carries_no_credential_and_no_literal_url"}) SET n += {`id`: "sym:tests/test_compat.py::test_iss165_the_push_call_carries_no_credential_and_no_literal_url", `name`: "test_iss165_the_push_call_carries_no_credential_and_no_literal_url", `qualname`: "test_iss165_the_push_call_carries_no_credential_and_no_literal_url", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 641, `end_line`: 652, `signature`: "def test_iss165_the_push_call_carries_no_credential_and_no_literal_url(tmp_path):", `docstring`: "`git push`'s own argv is exactly the safe, credential-free form --\n    the URL-with-embedded-token this issue reports is gone, and so is any\n    other rendering of the credential (e.g. a bare `x-access-token`).", `entrypoint`: true};
