MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_callee_name"}) SET n += {`id`: "sym:repo2graph/parse.py::_callee_name", `name`: "_callee_name", `qualname`: "_callee_name", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 918, `end_line`: 959, `signature`: "def _callee_name(src: bytes, node) -> str | None:\n    # \"method\": Ruby's `call` node keeps the receiver and the method in separate\n    # fields, so named_children[0] is the receiver \u2014 `logger.info(x)` would be\n    # recorded as a call to `logger`. Read the method field directly instead.\n    # \"macro", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_split_receiver_text"}) SET n += {`id`: "sym:repo2graph/parse.py::_split_receiver_text", `name`: "_split_receiver_text", `qualname`: "_split_receiver_text", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 985, `end_line`: 999, `signature`: "def _split_receiver_text(txt: str) -> tuple[str, bool]:", `docstring`: "Split callee text like `a.b.get` into (`a.b`, static_scope).\n\n    `static_scope` is True when the last separator is `::` (`Config::get`,\n    `std::find`, Ruby `Foo::bar`): the head names a type or namespace, never a\n    value of unknown type. Returns (\"\", False) for a bare name."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_receiver_of"}) SET n += {`id`: "sym:repo2graph/parse.py::_receiver_of", `name`: "_receiver_of", `qualname`: "_receiver_of", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1002, `end_line`: 1027, `signature`: "def _receiver_of(src: bytes, node) -> tuple[str, bool]:", `docstring`: "(receiver head text, static_scope) of a call node; (\"\", False) if bare."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_classify_receiver"}) SET n += {`id`: "sym:repo2graph/parse.py::_classify_receiver", `name`: "_classify_receiver", `qualname`: "_classify_receiver", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1030, `end_line`: 1052, `signature`: "def _classify_receiver(\n    head: str,\n    self_names: frozenset[str] = frozenset(),\n    lang: str = \"\",\n    static: bool = False,\n) -> str:", `docstring`: "Classify what a call is made on: \"none\", \"self\" or \"other\".\n\n    \"none\" is a bare call (`helper()`), \"self\" is a call on the calling object\n    (`self.x()`, `this.x()`, `super().x()`), and \"other\" is a call on anything\n    else (`d.get()`, `os.environ.get()`, `self.cache.get()`). `_callee_name`\n    drops the receiver, so without this `graph.build` cannot tell `self.get()`\n    from `some_dict.get()`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_receiver_fields"}) SET n += {`id`: "sym:repo2graph/parse.py::_receiver_fields", `name`: "_receiver_fields", `qualname`: "_receiver_fields", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1055, `end_line`: 1070, `signature`: "def _receiver_fields(\n    head: str, static: bool, self_names: frozenset[str] = frozenset(), lang: str = \"\"\n) -> dict:", `docstring`: "The receiver keys of one `call_details` entry.\n\n    \"receiver\" is always present (none/self/other). \"receiver_head\" is the\n    receiver's source text when there is one, so `graph.build` can tell an\n    imported module (`store.get()`) or a type (`Util.remove()`) from a value of\n    unknown type (`d.get()`); \"receiver_static\" marks a `::`-scoped call."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_go_receiver_name"}) SET n += {`id`: "sym:repo2graph/parse.py::_go_receiver_name", `name`: "_go_receiver_name", `qualname`: "_go_receiver_name", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1073, `end_line`: 1082, `signature`: "def _go_receiver_name(src: bytes, node) -> str | None:", `docstring`: "The receiver identifier of a Go `func (c *T) M()` -- Go's `self`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_clean_type_name"}) SET n += {`id`: "sym:repo2graph/parse.py::_clean_type_name", `name`: "_clean_type_name", `qualname`: "_clean_type_name", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1085, `end_line`: 1089, `signature`: "def _clean_type_name(txt: str) -> str | None:", `docstring`: "`*List[T]` / `Map<K, V>?` / `(T)` -> `List` / `Map` / `T`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_go_receiver_type"}) SET n += {`id`: "sym:repo2graph/parse.py::_go_receiver_type", `name`: "_go_receiver_type", `qualname`: "_go_receiver_type", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1092, `end_line`: 1101, `signature`: "def _go_receiver_type(src: bytes, node) -> str | None:", `docstring`: "The receiver type of a Go `func (c *T[K]) M()`, pointer/generics stripped."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_kotlin_receiver_type"}) SET n += {`id`: "sym:repo2graph/parse.py::_kotlin_receiver_type", `name`: "_kotlin_receiver_type", `qualname`: "_kotlin_receiver_type", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1104, `end_line`: 1109, `signature`: "def _kotlin_receiver_type(src: bytes, node) -> str | None:", `docstring`: "The receiver type of a Kotlin extension `fun Foo<T>.bar()`, or None."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_decorator_receiver"}) SET n += {`id`: "sym:repo2graph/parse.py::_decorator_receiver", `name`: "_decorator_receiver", `qualname`: "_decorator_receiver", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1112, `end_line`: 1120, `signature`: "def _decorator_receiver(src: bytes, node) -> dict:", `docstring`: "Receiver keys for a decorator/annotation entry.\n\n    `@router.get(\"/x\")` is a call of `get` on `router`. Without these keys the\n    entry looked receiver-less -- a typed call -- and kept every untyped\n    `d.get()` in the decorated function bound at 1.0."};
