MERGE (n:R2G:Symbol {id: "sym:repo2graph/explain.py::explain_edge"}) SET n += {`id`: "sym:repo2graph/explain.py::explain_edge", `name`: "explain_edge", `qualname`: "explain_edge", `kind`: "function", `path`: "repo2graph/explain.py", `lang`: "python", `start_line`: 9, `end_line`: 43, `signature`: "def explain_edge(outdir: Path, src: str, dst: str) -> dict[str, Any]:", `docstring`: "Explain edges between two nodes in the code graph."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/explain.py::explain_node"}) SET n += {`id`: "sym:repo2graph/explain.py::explain_node", `name`: "explain_node", `qualname`: "explain_node", `kind`: "function", `path`: "repo2graph/explain.py", `lang`: "python", `start_line`: 46, `end_line`: 85, `signature`: "def explain_node(outdir: Path, node_id: str) -> dict[str, Any]:", `docstring`: "Explain a node, its metadata, incoming/outgoing edges, and chunks."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/explain.py::explain_retrieval"}) SET n += {`id`: "sym:repo2graph/explain.py::explain_retrieval", `name`: "explain_retrieval", `qualname`: "explain_retrieval", `kind`: "function", `path`: "repo2graph/explain.py", `lang`: "python", `start_line`: 88, `end_line`: 212, `signature`: "def explain_retrieval(\n    outdir: Path,\n    query: str,\n    k: int = 5,\n    hops: int = 1,\n    min_confidence: float | None = None,\n    budget_chars: int = RETRIEVE_BUDGET_CHARS,\n) -> dict[str, Any]:", `docstring`: "Trace query tokenization, seed ranking, graph expansion, and final chunk selection.\n\n    Every step here has to reproduce `Index.retrieve`'s, because the chunks it\n    claims to explain come from `Index.retrieve` twenty lines down. Three things\n    that must not drift: the seed loop stops on `budget_chars` as well as on\n    `k`, the seeds stay in score order (`expand` walks its frontier in order\n    under a per-hop cap, so a reordered seed list is a different traversal), and\n    the expansion passes `ALL_EDGE_DIRS` \u2014 see AGENTS.md, \"A new default on a\n    shared traversal helper narrows its ex"};
