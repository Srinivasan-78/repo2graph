MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/secrets.py::sanitize_url"}) SET n += {`id`: "sym:repo2graph/secrets.py::sanitize_url", `name`: "sanitize_url", `qualname`: "sanitize_url", `kind`: "function", `path`: "repo2graph/secrets.py", `lang`: "python", `start_line`: 639, `end_line`: 651, `signature`: "def sanitize_url(url: str) -> str:", `docstring`: "Redact embedded credentials and sensitive query params from a URL."};
