MERGE (n:R2G:`Symbol` {id: "sym:tests/test_answer_limits.py::SizedResponse"}) SET n += {`id`: "sym:tests/test_answer_limits.py::SizedResponse", `name`: "SizedResponse", `qualname`: "SizedResponse", `kind`: "class", `path`: "tests/test_answer_limits.py", `lang`: "python", `start_line`: 47, `end_line`: 79, `signature`: "class SizedResponse:", `docstring`: "A response double that serves sized reads the way urlopen's does.\n\n    `served` counts every byte handed out through *either* access path -- the\n    sized `read(n)` the fix uses and the line iteration the old code used -- so\n    an assertion on it measures what left the socket, not what the caller\n    happened to keep."};
