MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_prod_igy_area_patterns_name_paths_that_exist"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_prod_igy_area_patterns_name_paths_that_exist", `name`: "test_prod_igy_area_patterns_name_paths_that_exist", `qualname`: "test_prod_igy_area_patterns_name_paths_that_exist", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 198, `end_line`: 213, `signature`: "def test_prod_igy_area_patterns_name_paths_that_exist():", `docstring`: "Every `repo2graph/...` path prod-igy matches on must still be in the tree.\n\n    `area/walker` pointed at `repo2graph/walker.py` and `area/mcp` at\n    `repo2graph/mcp.py` long after the first was deleted (8ef6d006) and the\n    second became a package (c8c20bdb), so neither label could ever be applied\n    again and nothing failed. The assertions above pinned the stale strings,\n    which is what let it sit. This checks the paths against the filesystem\n    instead, so the next rename fails here rather than going quiet in CI.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_prod_igy_issue_extraction_regex"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_prod_igy_issue_extraction_regex", `name`: "test_prod_igy_issue_extraction_regex", `qualname`: "test_prod_igy_issue_extraction_regex", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 216, `end_line`: 230, `signature`: "def test_prod_igy_issue_extraction_regex():", `docstring`: "Verify the issue extraction regex matches action words and issue numbers.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_prod_igy_invariant_guidance_cites_contributing"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_prod_igy_invariant_guidance_cites_contributing", `name`: "test_prod_igy_invariant_guidance_cites_contributing", `qualname`: "test_prod_igy_invariant_guidance_cites_contributing", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 233, `end_line`: 252, `signature`: "def test_prod_igy_invariant_guidance_cites_contributing():", `docstring`: "Verify the invariant rule strings in checkRepositoryInvariants.\n\n    The rules used to cite `AGENTS.md`, which was removed in 58c1f833 when the\n    technical invariants moved into CONTRIBUTING.md. Every citation must name a\n    file that is actually in the repository, or the checklist prod-igy posts on\n    every PR points a contributor at nothing.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_prod_igy_comment_formatting_and_author_tagging"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_prod_igy_comment_formatting_and_author_tagging", `name`: "test_prod_igy_comment_formatting_and_author_tagging", `qualname`: "test_prod_igy_comment_formatting_and_author_tagging", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 255, `end_line`: 276, `signature`: "def test_prod_igy_comment_formatting_and_author_tagging():", `docstring`: "Verify that comment formatting contains @<author> tags and required commands.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_issue_comment_job_requires_trusted_author_association"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_issue_comment_job_requires_trusted_author_association", `name`: "test_issue_comment_job_requires_trusted_author_association", `qualname`: "test_issue_comment_job_requires_trusted_author_association", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 279, `end_line`: 300, `signature`: "def test_issue_comment_job_requires_trusted_author_association():", `docstring`: "Issue #208: outsider PR comments must not start the privileged triage job.\n\n    The gate lives in the workflow `if:` so no runner is allocated. Trusted\n    associations are the three GitHub values for people who can change the\n    repo; CONTRIBUTOR / NONE / FIRST_TIME_CONTRIBUTOR are not among them.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_script_issue_comment_skips_untrusted_association"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_script_issue_comment_skips_untrusted_association", `name`: "test_script_issue_comment_skips_untrusted_association", `qualname`: "test_script_issue_comment_skips_untrusted_association", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 303, `end_line`: 327, `signature`: "def test_script_issue_comment_skips_untrusted_association():", `docstring`: "Issue #208: script defence if the workflow `if:` is ever widened.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_format_bot_comment_strips_backticks_from_refs"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_format_bot_comment_strips_backticks_from_refs", `name`: "test_format_bot_comment_strips_backticks_from_refs", `qualname`: "test_format_bot_comment_strips_backticks_from_refs", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 330, `end_line`: 368, `signature`: "def test_format_bot_comment_strips_backticks_from_refs():", `docstring`: "Issue #208: a fork branch name must not break out of a markdown code span.\n\n    git check-ref-format permits `` ` ``. The Head Commit line (and every\n    other `` `${headRef}` `` / `` `${baseRef}` `` interpolation) wraps the\n    ref in backticks; closing that span plants attacker markdown under the\n    bot identity. SHA slices stay raw \u2014 they are not attacker-controlled\n    the same way.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_prod_igy_auto_retargets_main_to_develop"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_prod_igy_auto_retargets_main_to_develop", `name`: "test_prod_igy_auto_retargets_main_to_develop", `qualname`: "test_prod_igy_auto_retargets_main_to_develop", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 371, `end_line`: 381, `signature`: "def test_prod_igy_auto_retargets_main_to_develop():", `docstring`: "Verify that prod-igy automatically retargets PRs from main to develop and posts notice.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::_js_regex"}) SET n += {`id`: "sym:tests/test_prod_igy.py::_js_regex", `name`: "_js_regex", `qualname`: "_js_regex", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 384, `end_line`: 395, `signature`: "def _js_regex(content: str, name: str, arg: str) -> re.Pattern:", `docstring`: "Pull a `const <name> = /<pattern>/i.test(<arg>)` literal out of the script.\n\n    The retarget guard is the one piece of prod-igy whose *behaviour* is worth\n    asserting rather than its source text, and the pytest environment has no\n    Node (see this module's docstring). Extracting the literal and compiling it\n    with `re` tests the pattern itself: a typo in the login shape fails here\n    instead of silently retargeting a release PR in production."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_prod_igy_never_retargets_a_release_pr"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_prod_igy_never_retargets_a_release_pr", `name`: "test_prod_igy_never_retargets_a_release_pr", `qualname`: "test_prod_igy_never_retargets_a_release_pr", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 398, `end_line`: 422, `signature`: "def test_prod_igy_never_retargets_a_release_pr():", `docstring`: "A release PR must stay on `main`.\n\n    publish.yml has prod-igy raise `release/vX.Y.Z -> main` and then polls for\n    that merge, so retargeting it to `develop` strands the version bump and\n    times the release run out with nothing merged.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_no_standalone_claude_review_workflows_remain"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_no_standalone_claude_review_workflows_remain", `name`: "test_no_standalone_claude_review_workflows_remain", `qualname`: "test_no_standalone_claude_review_workflows_remain", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 436, `end_line`: 454, `signature`: "def test_no_standalone_claude_review_workflows_remain():", `docstring`: "The claude-code-action workflows are gone and must not come back.\n\n    They were the two automated-code-review surfaces. `claude.yml` in\n    particular let *any* commenter start a 30-minute model run with no\n    author_association gate at all -- the exact hole prod-igy's\n    TRUSTED_ASSOCIATIONS closes on its own comment path.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_no_contributor_invokable_ai_path"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_no_contributor_invokable_ai_path", `name`: "test_no_contributor_invokable_ai_path", `qualname`: "test_no_contributor_invokable_ai_path", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 457, `end_line`: 473, `signature`: "def test_no_contributor_invokable_ai_path():", `docstring`: "No workflow may start a model run from untrusted comment text.\n\n    A contributor must not be able to address the AI. The only mention-driven\n    trigger left in the repository is prod-igy's `@prod-igy`, gated on\n    author_association in both the workflow `if:` and the script.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_ai_workflow_wiring"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_ai_workflow_wiring", `name`: "test_ai_workflow_wiring", `qualname`: "test_ai_workflow_wiring", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 476, `end_line`: 503, `signature`: "def test_ai_workflow_wiring():", `docstring`: "The AI step's inputs come from the base checkout, and default to off.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_prod_igy.py::test_ai_env_flag_is_case_folded"}) SET n += {`id`: "sym:tests/test_prod_igy.py::test_ai_env_flag_is_case_folded", `name`: "test_ai_env_flag_is_case_folded", `qualname`: "test_ai_env_flag_is_case_folded", `kind`: "function", `path`: "tests/test_prod_igy.py", `lang`: "python", `start_line`: 506, `end_line`: 533, `signature`: "def test_ai_env_flag_is_case_folded():", `docstring`: "AGENTS.md truthiness rule, applied to the AI gate.\n\n    GitHub's `env.PRODIGY_AI == 'true'` matches 'True' and 'TRUE'. If the JS\n    side used a bare `=== 'true'`, a variable set to 'True' would install the\n    SDK and then skip the AI step -- the same split-gate bug as action.yml's\n    embed/rag seam, and equally invisible to a Python-only suite.", `entrypoint`: true};
