MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::read_jsonl"}) SET n += {`id`: "sym:repo2graph/query.py::read_jsonl", `name`: "read_jsonl", `qualname`: "read_jsonl", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 109, `end_line`: 125, `signature`: "def read_jsonl(path: Path) -> list[Record]:", `docstring`: "Load a JSONL file written by export.write_jsonl.\n\n    newline=\"\\n\" matters: json.dumps(ensure_ascii=False) passes U+2028, U+2029\n    and U+0085 through verbatim, and both str.splitlines() and universal-newline\n    mode treat those as line breaks, which would cut records in half."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::count_tokens"}) SET n += {`id`: "sym:repo2graph/query.py::count_tokens", `name`: "count_tokens", `qualname`: "count_tokens", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 128, `end_line`: 131, `signature`: "def count_tokens(text: str) -> int:", `docstring`: "The default token estimate: len(text) // CHARS_PER_TOKEN, never 0 for a\n    non-empty string (a block that costs nothing would defeat any budget)."};
