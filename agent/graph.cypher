MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp_sse.py::test_sse_auth_rejects_wrong_and_prefix_tokens"}) SET n += {`id`: "sym:tests/test_mcp_sse.py::test_sse_auth_rejects_wrong_and_prefix_tokens", `name`: "test_sse_auth_rejects_wrong_and_prefix_tokens", `qualname`: "test_sse_auth_rejects_wrong_and_prefix_tokens", `kind`: "function", `path`: "tests/test_mcp_sse.py", `lang`: "python", `start_line`: 268, `end_line`: 286, `signature`: "def test_sse_auth_rejects_wrong_and_prefix_tokens(mini_index):", `docstring`: "A token that is a correct *prefix* must be rejected like any other.\n\n    Pins the `hmac.compare_digest` comparison: `==` would also reject these,\n    but these are the cases whose timing it leaked.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp_sse.py::test_sse_auth_rejects_non_ascii_bearer_without_crashing"}) SET n += {`id`: "sym:tests/test_mcp_sse.py::test_sse_auth_rejects_non_ascii_bearer_without_crashing", `name`: "test_sse_auth_rejects_non_ascii_bearer_without_crashing", `qualname`: "test_sse_auth_rejects_non_ascii_bearer_without_crashing", `kind`: "function", `path`: "tests/test_mcp_sse.py", `lang`: "python", `start_line`: 289, `end_line`: 325, `signature`: "def test_sse_auth_rejects_non_ascii_bearer_without_crashing(mini_index):", `docstring`: "A garbage byte in the Authorization header must 401, not raise.\n\n    `hmac.compare_digest` raises TypeError on a `str` carrying any non-ASCII\n    character, and `latin-1` decodes every byte 0x80-0xFF into one. Because\n    `AuthMiddleware` wraps the Starlette app from *outside*, Starlette's\n    `ServerErrorMiddleware` never saw that exception -- it surfaced as an\n    unhandled ASGI error an unauthenticated caller could trigger at will. The\n    comparison is on bytes now, so this is an ordinary rejection.", `entrypoint`: true};
