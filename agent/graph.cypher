MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_tool_descriptions_stay_under_budget"}) SET n += {`id`: "sym:tests/test_mcp.py::test_tool_descriptions_stay_under_budget", `name`: "test_tool_descriptions_stay_under_budget", `qualname`: "test_tool_descriptions_stay_under_budget", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 306, `end_line`: 344, `signature`: "def test_tool_descriptions_stay_under_budget():", `docstring`: "Verify the published tool set, capped under a combined character budget.\n\n    The character budget balances agent context overhead against Glama TDQS\n    (Tool Definition Quality Standard) requirements. Tool descriptions are loaded\n    into every agent's context every turn, so they must stay tightly bounded;\n    however, they must also provide explicit usage guidance, sibling disambiguation,\n    and safety disclosures.\n\n    Round 1 of MCP hardening added four tools (repo_find_symbol, repo_read,\n    repo_path_between, repo_blast_radius) to the original six, each of which\n    needs its own sibli", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_server_instructions_tell_a_client_how_to_parse_a_noted_reply"}) SET n += {`id`: "sym:tests/test_mcp.py::test_server_instructions_tell_a_client_how_to_parse_a_noted_reply", `name`: "test_server_instructions_tell_a_client_how_to_parse_a_noted_reply", `qualname`: "test_server_instructions_tell_a_client_how_to_parse_a_noted_reply", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 347, `end_line`: 362, `signature`: "def test_server_instructions_tell_a_client_how_to_parse_a_noted_reply():", `docstring`: "Notes lead a reply in both formats, JSON included, so a client that\n    calls `JSON.parse` on the whole thing breaks the first time an argument is\n    defaulted or the index goes stale.\n\n    docs/mcp.md says so, but a client's model reads the server's metadata and\n    never the repository's docs. It lives in `instructions` rather than in each\n    JSON tool's description because those are capped at 800 chars each -- four\n    copies did not fit, and this ships once per session instead of per tool.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_tool_descriptions_contain_usage_guidance_and_siblings"}) SET n += {`id`: "sym:tests/test_mcp.py::test_tool_descriptions_contain_usage_guidance_and_siblings", `name`: "test_tool_descriptions_contain_usage_guidance_and_siblings", `qualname`: "test_tool_descriptions_contain_usage_guidance_and_siblings", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 365, `end_line`: 399, `signature`: "def test_tool_descriptions_contain_usage_guidance_and_siblings():", `docstring`: "Glama TDQS: Every tool description must contain explicit usage guidance\n    ('when to use' or 'use when') and cross-reference alternative sibling tools\n    to prevent agent mis-routing.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_tool_descriptions_disclose_read_only_behavior"}) SET n += {`id`: "sym:tests/test_mcp.py::test_tool_descriptions_disclose_read_only_behavior", `name`: "test_tool_descriptions_disclose_read_only_behavior", `qualname`: "test_tool_descriptions_disclose_read_only_behavior", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 402, `end_line`: 414, `signature`: "def test_tool_descriptions_disclose_read_only_behavior():", `docstring`: "Glama TDQS / Safety: Every tool description must explicitly disclose\n    read-only behavior so models know the operation cannot mutate repository state.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_tool_schemas_have_informative_parameter_descriptions"}) SET n += {`id`: "sym:tests/test_mcp.py::test_tool_schemas_have_informative_parameter_descriptions", `name`: "test_tool_schemas_have_informative_parameter_descriptions", `qualname`: "test_tool_schemas_have_informative_parameter_descriptions", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 417, `end_line`: 463, `signature`: "def test_tool_schemas_have_informative_parameter_descriptions():", `docstring`: "Glama TDQS: Tool schemas must provide clear, informative descriptions\n    for all parameters including types, defaults, and constraints where applicable.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_tool_annotations_constant_defined"}) SET n += {`id`: "sym:tests/test_mcp.py::test_tool_annotations_constant_defined", `name`: "test_tool_annotations_constant_defined", `qualname`: "test_tool_annotations_constant_defined", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 466, `end_line`: 474, `signature`: "def test_tool_annotations_constant_defined():", `docstring`: "TOOL_ANNOTATIONS constant is defined at module level and declares\n    read-only, non-destructive, and idempotent hints without needing the SDK.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::_field"}) SET n += {`id`: "sym:tests/test_mcp.py::_field", `name`: "_field", `qualname`: "_field", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 477, `end_line`: 494, `signature`: "def _field(obj, *names):", `docstring`: "The first of `names` found on `obj`, as an attribute or a dict key.\n\n    The installed SDK's pydantic models expose fields under their snake_case\n    Python name (`input_schema`, `read_only_hint`); the wire/constructor\n    spelling stays camelCase (`inputSchema`, `readOnlyHint`) as an alias. A\n    fake `Tool`/`ToolAnnotations` built by this file's own stand-ins (or an\n    older SDK) may only have the camelCase one, and `TOOL_ANNOTATIONS` itself\n    is a plain dict keyed camelCase -- so a real test here has to accept\n    either rather than assume one SDK generation's naming."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_list_tools_returns_quality_annotations"}) SET n += {`id`: "sym:tests/test_mcp.py::test_list_tools_returns_quality_annotations", `name`: "test_list_tools_returns_quality_annotations", `qualname`: "test_list_tools_returns_quality_annotations", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 498, `end_line`: 514, `signature`: "def test_list_tools_returns_quality_annotations():", `docstring`: "When running with the MCP SDK, get_tools() returns tools decorated\n    with quality annotations (readOnlyHint=True, destructiveHint=False, idempotentHint=True).", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_annotations_are_honest_about_auto_build"}) SET n += {`id`: "sym:tests/test_mcp.py::test_annotations_are_honest_about_auto_build", `name`: "test_annotations_are_honest_about_auto_build", `qualname`: "test_annotations_are_honest_about_auto_build", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 518, `end_line`: 550, `signature`: "def test_annotations_are_honest_about_auto_build():", `docstring`: "#292: a client inspecting annotations must not be told a tool is\n    read-only when its first call, on a server that can auto-build, may\n    parse the whole repository, run git, and write `.r2g/**` to disk.\n\n    `get_tools(auto_build=False)` -- an already-indexed server, or one\n    started with `--no-auto-build` -- keeps every tool read-only: that\n    annotation is true in that mode. `get_tools(auto_build=True)` -- stdio\n    with a repo to build from and auto-build not disabled -- must mark every\n    build-capable tool `readOnlyHint=False`, except `repo_build_status`,\n    which `run_tool` spec", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_repo_build_status_is_the_only_non_build_capable_tool"}) SET n += {`id`: "sym:tests/test_mcp.py::test_repo_build_status_is_the_only_non_build_capable_tool", `name`: "test_repo_build_status_is_the_only_non_build_capable_tool", `qualname`: "test_repo_build_status_is_the_only_non_build_capable_tool", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 553, `end_line`: 559, `signature`: "def test_repo_build_status_is_the_only_non_build_capable_tool():", `docstring`: "Pins BUILD_CAPABLE_TOOLS against `run_tool`'s own special case, so a\n    future tool added to TOOL_DESCRIPTIONS without updating the annotation\n    set fails loudly here rather than silently miscategorising a new tool.", `entrypoint`: true};
