MERGE (n:R2G:Symbol {id: "sym:tests/test_incremental.py::test_incremental_is_byte_identical_to_a_full_rebuild"}) SET n += {`id`: "sym:tests/test_incremental.py::test_incremental_is_byte_identical_to_a_full_rebuild", `name`: "test_incremental_is_byte_identical_to_a_full_rebuild", `qualname`: "test_incremental_is_byte_identical_to_a_full_rebuild", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 331, `end_line`: 350, `signature`: "def test_incremental_is_byte_identical_to_a_full_rebuild(tmp_path, mutate):", `docstring`: "The acceptance test: same bytes out, whatever route got there.\n\n    Two checkouts of the same content, mutated identically. One is built fresh;\n    the other is built once, mutated, then rebuilt incrementally. Every artifact\n    must match byte for byte -- including `stats.json`, which is why the\n    cached/re-parsed tallies live on `Graph.incremental` and not in `stats`.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_incremental.py::test_incremental_against_a_repo_with_no_index_is_a_full_build"}) SET n += {`id`: "sym:tests/test_incremental.py::test_incremental_against_a_repo_with_no_index_is_a_full_build", `name`: "test_incremental_against_a_repo_with_no_index_is_a_full_build", `qualname`: "test_incremental_against_a_repo_with_no_index_is_a_full_build", `kind`: "function", `path`: "tests/test_incremental.py", `lang`: "python", `start_line`: 353, `end_line`: 359, `signature`: "def test_incremental_against_a_repo_with_no_index_is_a_full_build(tmp_path):", `docstring`: "`--incremental` on a cold directory works; it simply has nothing to reuse.", `entrypoint`: true};
