MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_alias_target"}) SET n += {`id`: "sym:repo2graph/parse.py::_alias_target", `name`: "_alias_target", `qualname`: "_alias_target", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1199, `end_line`: 1212, `signature`: "def _alias_target(src: bytes, value) -> str | None:", `docstring`: "The name an exported binding's value refers to, or None if it is not a reference."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_exported_declarator_alias"}) SET n += {`id`: "sym:repo2graph/parse.py::_exported_declarator_alias", `name`: "_exported_declarator_alias", `qualname`: "_exported_declarator_alias", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1215, `end_line`: 1229, `signature`: "def _exported_declarator_alias(src: bytes, node) -> str | None:", `docstring`: "The target of `export const NAME = TARGET`, or None.\n\n    Only a declarator whose own statement carries the `export` keyword counts.\n    A file-local `const b = a` renames nothing a consumer can reach, and the\n    direct parent chain -- never an ancestor search -- is what keeps the fields\n    of an `export class C { foo = bar }` out of this path."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_export_specifier_alias"}) SET n += {`id`: "sym:repo2graph/parse.py::_export_specifier_alias", `name`: "_export_specifier_alias", `qualname`: "_export_specifier_alias", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1232, `end_line`: 1250, `signature`: "def _export_specifier_alias(src: bytes, node) -> str | None:", `docstring`: "The new name bound by `export { TARGET as NAME }`, or None.\n\n    `export { x as y } from './mod'` is excluded: nothing is defined at that\n    line, and a barrel file of them would become dozens of one-line nodes\n    bidding against real definitions. Resolving a re-export to the file it\n    forwards to is a separate feature."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_split_bases"}) SET n += {`id`: "sym:repo2graph/parse.py::_split_bases", `name`: "_split_bases", `qualname`: "_split_bases", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1292, `end_line`: 1312, `signature`: "def _split_bases(text: str) -> list[str]:", `docstring`: "Split a base-class list on top-level commas only.\n\n    A generic's type arguments (`Generic[T, U]`, `Handler<Request, Response>`)\n    contain commas that must not split the base list itself, so track bracket\n    depth and only split where it is zero."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_clean_base"}) SET n += {`id`: "sym:repo2graph/parse.py::_clean_base", `name`: "_clean_base", `qualname`: "_clean_base", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1324, `end_line`: 1331, `signature`: "def _clean_base(text: str) -> str:", `docstring`: "'public B', 'extends B', '< B' -> 'B'; 'public NS::Base' -> 'NS::Base'."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_base_clauses"}) SET n += {`id`: "sym:repo2graph/parse.py::_base_clauses", `name`: "_base_clauses", `qualname`: "_base_clauses", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1334, `end_line`: 1347, `signature`: "def _base_clauses(node):", `docstring`: "Supertype clauses of a definition, preferring the innermost one.\n\n    TypeScript wraps extends_clause/implements_clause in a class_heritage and\n    Java wraps a type_list in super_interfaces; the outer node's text would join\n    several names into one string, so descend when a child is a clause too."};
