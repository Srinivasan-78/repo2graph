MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_concurrent_open_index_builds_the_index_exactly_once"}) SET n += {`id`: "sym:tests/test_mcp.py::test_concurrent_open_index_builds_the_index_exactly_once", `name`: "test_concurrent_open_index_builds_the_index_exactly_once", `qualname`: "test_concurrent_open_index_builds_the_index_exactly_once", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1727, `end_line`: 1787, `signature`: "def test_concurrent_open_index_builds_the_index_exactly_once(\n    mini_index, mini_repo, tmp_path, monkeypatch\n):", `docstring`: "Two simultaneous first calls must cost one build and share one Index.\n\n    The HTTP transport is a `ThreadingHTTPServer` with `daemon_threads = True`,\n    so two clients pointed at a server whose index does not exist yet both\n    reach `open_index` before either has written anything. Unlocked, both pass\n    the `not _has_index(...)` test, both parse the whole repository and then\n    race each other through `atomic_write`, so the loser's work is discarded.\n    The invocation count below is the detector: it reads 2 without the\n    per-directory lock and 1 with it.\n\n    `_build_index` is replaced", `entrypoint`: true};
