MERGE (n:R2G:Symbol {id: "sym:repo2graph/query.py::read_jsonl"}) SET n += {id: "sym:repo2graph/query.py::read_jsonl", name: "read_jsonl", qualname: "read_jsonl", kind: "function", path: "repo2graph/query.py", lang: "python", start_line: 103, end_line: 119, signature: "def read_jsonl(path: Path) -> list:", docstring: "Load a JSONL file written by export.write_jsonl.\n\n    newline=\"\\n\" matters: json.dumps(ensure_ascii=False) passes U+2028, U+2029\n    and U+0085 through verbatim, and both str.splitlines() and universal-newline\n    mode treat those as line breaks, which would cut records in half."};
