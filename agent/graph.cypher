MERGE (n:R2G:`Symbol` {id: "sym:tests/test_cpp_parse.py::test_cpp_retry_never_names_the_file_or_follows_includes"}) SET n += {`id`: "sym:tests/test_cpp_parse.py::test_cpp_retry_never_names_the_file_or_follows_includes", `name`: "test_cpp_retry_never_names_the_file_or_follows_includes", `qualname`: "test_cpp_retry_never_names_the_file_or_follows_includes", `kind`: "function", `path`: "tests/test_cpp_parse.py", `lang`: "python", `start_line`: 330, `end_line`: 357, `signature`: "def test_cpp_retry_never_names_the_file_or_follows_includes(mock_run):", `docstring`: "#475: cpp resolves #include, so an untrusted file could point it at\n    /dev/zero or any readable path. The retry feeds the source on stdin with\n    every file-opening directive blanked, in all the spellings cpp accepts.", `entrypoint`: true};
