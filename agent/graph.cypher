MERGE (n:R2G:`Symbol` {id: "sym:tests/test_auth.py::test_unsigned_unknown_kid_tokens_do_not_amplify_jwks_fetches"}) SET n += {`id`: "sym:tests/test_auth.py::test_unsigned_unknown_kid_tokens_do_not_amplify_jwks_fetches", `name`: "test_unsigned_unknown_kid_tokens_do_not_amplify_jwks_fetches", `qualname`: "test_unsigned_unknown_kid_tokens_do_not_amplify_jwks_fetches", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 663, `end_line`: 676, `signature`: "def test_unsigned_unknown_kid_tokens_do_not_amplify_jwks_fetches():", `docstring`: "decode_jwt looks up the kid before rsa_verify.\n\n    Unsigned junk with random kids is therefore enough to reach key_for, and\n    must still hit the per-window cap \u2014 the issue 195 repro, at unit level.", `entrypoint`: true, `reach`: 34};
