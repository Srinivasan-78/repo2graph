MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp/retrieval.py::tool_repo_neighbours"}) SET n += {`id`: "sym:repo2graph/mcp/retrieval.py::tool_repo_neighbours", `name`: "tool_repo_neighbours", `qualname`: "tool_repo_neighbours", `kind`: "function", `path`: "repo2graph/mcp/retrieval.py", `lang`: "python", `start_line`: 252, `end_line`: 324, `signature`: "def tool_repo_neighbours(\n    index: Index,\n    node_id: str,\n    hops: Any = 1,\n    limit: Any = MCP_NEIGHBOUR_LIMIT,\n    min_confidence: Any = 0.0,\n    cursor: Any = None,\n    format: Any = None,\n) -> str:", `docstring`: "Graph traversal from `node_id`, then the TESTS edges on `node_id` itself.\n\n    A `cursor` (even \"\") opts into paging: `limit` rows per page, with a\n    `next_cursor:` line while more remain. None is the unpaged answer.\n    `format=\"json\"` returns the same rows as a JSON object instead of markdown."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp/retrieval.py::_tests_of"}) SET n += {`id`: "sym:repo2graph/mcp/retrieval.py::_tests_of", `name`: "_tests_of", `qualname`: "_tests_of", `kind`: "function", `path`: "repo2graph/mcp/retrieval.py", `lang`: "python", `start_line`: 327, `end_line`: 340, `signature`: "def _tests_of(index: Index, node_id: str, floor: float) -> list[tuple[str, str, float]]:", `docstring`: "`node_id`'s TESTS edges at or above `floor`, most confident first."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp/retrieval.py::_paged_neighbours"}) SET n += {`id`: "sym:repo2graph/mcp/retrieval.py::_paged_neighbours", `name`: "_paged_neighbours", `qualname`: "_paged_neighbours", `kind`: "function", `path`: "repo2graph/mcp/retrieval.py", `lang`: "python", `start_line`: 343, `end_line`: 436, `signature`: "def _paged_neighbours(\n    index: Index,\n    node_id: str,\n    hops: int,\n    limit: int,\n    floor: float,\n    cursor: Any,\n    note: str,\n    as_json: bool = False,\n) -> str:", `docstring`: "One page of `repo_neighbours`: rows [offset, offset + limit) of the full walk.\n\n    The unpaged answer samples at most six edges per node per hop, which is\n    why a symbol with sixty callers showed six. A page has to be a window on\n    one complete, deterministic order or later pages could not reach the rest,\n    so this walks every edge of each hop, bounded in total instead. The node's\n    own TESTS edges follow the walk, as in the unpaged answer."};
