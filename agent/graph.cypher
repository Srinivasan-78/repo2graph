MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_r6_the_off_path_is_still_the_baseline_command_line"}) SET n += {`id`: "sym:tests/test_compat.py::test_r6_the_off_path_is_still_the_baseline_command_line", `name`: "test_r6_the_off_path_is_still_the_baseline_command_line", `qualname`: "test_r6_the_off_path_is_still_the_baseline_command_line", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 584, `end_line`: 603, `signature`: "def test_r6_the_off_path_is_still_the_baseline_command_line(tmp_path):", `docstring`: "R-6 (c): with the input at its default, the argv is baseline's, in\n    baseline's order -- the fix must not reach the workflows that never opt in.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_r6_embed_is_the_only_boolean_input_with_a_split_gate"}) SET n += {`id`: "sym:tests/test_compat.py::test_r6_embed_is_the_only_boolean_input_with_a_split_gate", `name`: "test_r6_embed_is_the_only_boolean_input_with_a_split_gate", `qualname`: "test_r6_embed_is_the_only_boolean_input_with_a_split_gate", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 606, `end_line`: 612, `signature`: "def test_r6_embed_is_the_only_boolean_input_with_a_split_gate():", `docstring`: "R-6 (d): every other `if:` on an input tests non-emptiness, which bash's\n    `-n`/`-z` agree with for every casing. If a second boolean input is added,\n    this fails and the new gate has to be checked the way `embed` now is.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_r9_the_fallback_version_agrees_with_pyproject"}) SET n += {`id`: "sym:tests/test_compat.py::test_r9_the_fallback_version_agrees_with_pyproject", `name`: "test_r9_the_fallback_version_agrees_with_pyproject", `qualname`: "test_r9_the_fallback_version_agrees_with_pyproject", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 625, `end_line`: 638, `signature`: "def test_r9_the_fallback_version_agrees_with_pyproject():", `docstring`: "R-9: every `__version__` literal in the package equals the packaged\n    version. There is no metadata to read in a source checkout, so the literal\n    is the only thing that answers `repo2graph.__version__` there.", `entrypoint`: true, `reach`: 5};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::_resolved_push_git_calls"}) SET n += {`id`: "sym:tests/test_compat.py::_resolved_push_git_calls", `name`: "_resolved_push_git_calls", `qualname`: "_resolved_push_git_calls", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 651, `end_line`: 685, `signature`: "def _resolved_push_git_calls(\n    tmp_path: Path, token: str, extra_env: dict[str, str] | None = None\n) -> list:", `docstring`: "Every `git ...` invocation the \"Push graph to branch\" step's real body\n    makes, as the literal argv bash hands it -- captured by overriding `git`\n    with a shell function instead of truncating/rewriting the script, so the\n    step body under test is exactly what's in action.yml, unmodified."};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_iss165_the_token_never_appears_in_a_git_argv_word"}) SET n += {`id`: "sym:tests/test_compat.py::test_iss165_the_token_never_appears_in_a_git_argv_word", `name`: "test_iss165_the_token_never_appears_in_a_git_argv_word", `qualname`: "test_iss165_the_token_never_appears_in_a_git_argv_word", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 689, `end_line`: 697, `signature`: "def test_iss165_the_token_never_appears_in_a_git_argv_word(tmp_path):", `docstring`: "The exact secret value must not be a word in any `git` invocation's\n    argv -- not just the `push` call, since a leak in `remote add` or\n    elsewhere would be just as visible to `ps`.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_iss165_the_push_call_carries_no_credential_and_no_literal_url"}) SET n += {`id`: "sym:tests/test_compat.py::test_iss165_the_push_call_carries_no_credential_and_no_literal_url", `name`: "test_iss165_the_push_call_carries_no_credential_and_no_literal_url", `qualname`: "test_iss165_the_push_call_carries_no_credential_and_no_literal_url", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 701, `end_line`: 712, `signature`: "def test_iss165_the_push_call_carries_no_credential_and_no_literal_url(tmp_path):", `docstring`: "`git push`'s own argv is exactly the safe, credential-free form --\n    the URL-with-embedded-token this issue reports is gone, and so is any\n    other rendering of the credential (e.g. a bare `x-access-token`).", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_commit_force_false_uses_plain_push"}) SET n += {`id`: "sym:tests/test_compat.py::test_commit_force_false_uses_plain_push", `name`: "test_commit_force_false_uses_plain_push", `qualname`: "test_commit_force_false_uses_plain_push", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 716, `end_line`: 722, `signature`: "def test_commit_force_false_uses_plain_push(tmp_path):", `docstring`: "Setting commit-force to false uses standard push without --force (#310).", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_push_refused_on_fork_pull_request"}) SET n += {`id`: "sym:tests/test_compat.py::test_push_refused_on_fork_pull_request", `name`: "test_push_refused_on_fork_pull_request", `qualname`: "test_push_refused_on_fork_pull_request", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 726, `end_line`: 752, `signature`: "def test_push_refused_on_fork_pull_request(tmp_path):", `docstring`: "The action refuses to push graph to branch when run from a fork PR (#310).", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::_resolved_pip_calls"}) SET n += {`id`: "sym:tests/test_compat.py::_resolved_pip_calls", `name`: "_resolved_pip_calls", `qualname`: "_resolved_pip_calls", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 773, `end_line`: 805, `signature`: "def _resolved_pip_calls(tmp_path: Path, version: str, *, pyproject: bool = True):", `docstring`: "(returncode, [argv, ...]) for the \"Install repo2graph\" step's real body.\n\n    `pip` is overridden by a shell function that logs its argv, so nothing is\n    installed and the script under test is byte-for-byte the one in action.yml\n    -- not a transcription of it."};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_iss204_a_blank_version_installs_the_action_checkout"}) SET n += {`id`: "sym:tests/test_compat.py::test_iss204_a_blank_version_installs_the_action_checkout", `name`: "test_iss204_a_blank_version_installs_the_action_checkout", `qualname`: "test_iss204_a_blank_version_installs_the_action_checkout", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 809, `end_line`: 815, `signature`: "def test_iss204_a_blank_version_installs_the_action_checkout(tmp_path):", `docstring`: "#204 (a): the default path is unchanged -- `uses: ./` and every workflow\n    that never sets `version` still gets an editable install of the checkout.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_iss204_a_non_blank_version_is_the_spec_pip_receives"}) SET n += {`id`: "sym:tests/test_compat.py::test_iss204_a_non_blank_version_is_the_spec_pip_receives", `name`: "test_iss204_a_non_blank_version_is_the_spec_pip_receives", `qualname`: "test_iss204_a_non_blank_version_is_the_spec_pip_receives", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 827, `end_line`: 838, `signature`: "def test_iss204_a_non_blank_version_is_the_spec_pip_receives(tmp_path, version):", `docstring`: "#204 (b): the reported bug. The fixture writes a pyproject.toml into\n    the action checkout -- the precondition the bug lived on, and the normal\n    case for a composite action -- and a pinned spec must still reach pip\n    verbatim rather than the checkout being installed instead of it.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_iss204_a_blank_version_with_no_checkout_source_fails_loudly"}) SET n += {`id`: "sym:tests/test_compat.py::test_iss204_a_blank_version_with_no_checkout_source_fails_loudly", `name`: "test_iss204_a_blank_version_with_no_checkout_source_fails_loudly", `qualname`: "test_iss204_a_blank_version_with_no_checkout_source_fails_loudly", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 842, `end_line`: 847, `signature`: "def test_iss204_a_blank_version_with_no_checkout_source_fails_loudly(tmp_path):", `docstring`: "#204 (c): blank + nothing to install from is a hard error naming the\n    input, not a silent `pip install ''` or a stale hardcoded fallback.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_iss204_the_version_input_defaults_to_blank"}) SET n += {`id`: "sym:tests/test_compat.py::test_iss204_the_version_input_defaults_to_blank", `name`: "test_iss204_the_version_input_defaults_to_blank", `qualname`: "test_iss204_the_version_input_defaults_to_blank", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 850, `end_line`: 856, `signature`: "def test_iss204_the_version_input_defaults_to_blank():", `docstring`: "#204 (d): the default must stay blank. A non-empty default would flip\n    every existing workflow -- CI's own `uses: ./` included -- from installing\n    the checkout to installing a published spec.", `entrypoint`: true, `reach`: 13};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_iss204_the_install_step_gates_on_the_version_input"}) SET n += {`id`: "sym:tests/test_compat.py::test_iss204_the_install_step_gates_on_the_version_input", `name`: "test_iss204_the_install_step_gates_on_the_version_input", `qualname`: "test_iss204_the_install_step_gates_on_the_version_input", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 859, `end_line`: 869, `signature`: "def test_iss204_the_install_step_gates_on_the_version_input():", `docstring`: "#204 (e): a source-level guard on the shape of the gate, so the file\n    test cannot come back as the *first* branch. `-n`/`-z` on the input is\n    also the form GitHub expressions and bash agree on for every casing\n    (AGENTS.md), which is why no `inputs.version ==` gate is needed.", `entrypoint`: true};
