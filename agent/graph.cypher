MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/auth.py::JWKSCache.key_for"}) SET n += {`id`: "sym:repo2graph/auth.py::JWKSCache.key_for", `name`: "key_for", `qualname`: "JWKSCache.key_for", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 322, `end_line`: 424, `signature`: "def key_for(self, kid: str) -> dict[str, Any]:", `docstring`: "Return the JWK with this `kid`, refetching under a per-window cap.\n\n        Args:\n            kid: The key id from the token header.\n\n        Returns:\n            The matching JWK as a dict.\n\n        Raises:\n            AuthError: If the key is unknown after any allowed refetch."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/auth.py::_HTTPSOnlyRedirect"}) SET n += {`id`: "sym:repo2graph/auth.py::_HTTPSOnlyRedirect", `name`: "_HTTPSOnlyRedirect", `qualname`: "_HTTPSOnlyRedirect", `kind`: "class", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 427, `end_line`: 460, `signature`: "class _HTTPSOnlyRedirect(urllib.request.HTTPRedirectHandler):", `docstring`: "Refuse any redirect hop that leaves https.\n\n    The scheme check in `_fetch_json` covers the URL it is handed and nothing\n    after it: `urlopen` follows redirects itself, and CPython's\n    `HTTPRedirectHandler` accepts targets whose scheme is in\n    `('http', 'https', 'ftp', '')`. So an issuer -- or anyone who can answer\n    for it -- returns a `302` from the discovery document or the `jwks_uri` to\n    `http://`, and the signing keys every authentication decision rests on\n    travel in clear. That is not only disclosure: an on-path attacker who\n    answers the downgraded request substitutes t"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/auth.py::_HTTPSOnlyRedirect.redirect_request"}) SET n += {`id`: "sym:repo2graph/auth.py::_HTTPSOnlyRedirect.redirect_request", `name`: "redirect_request", `qualname`: "_HTTPSOnlyRedirect.redirect_request", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 449, `end_line`: 460, `signature`: "def redirect_request(\n        self,\n        req: urllib.request.Request,\n        fp: Any,\n        code: int,\n        msg: str,\n        headers: Any,\n        newurl: str,\n    ) -> urllib.request.Request | None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/auth.py::_fetch_json"}) SET n += {`id`: "sym:repo2graph/auth.py::_fetch_json", `name`: "_fetch_json", `qualname`: "_fetch_json", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 468, `end_line`: 497, `signature`: "def _fetch_json(url: str) -> Any:", `docstring`: "GET `url` and parse the JSON body. The only network call in this package.\n\n    Args:\n        url: An https URL to fetch.\n\n    Returns:\n        The parsed JSON body.\n\n    Raises:\n        AuthError: On a non-https URL, a non-https redirect hop, a transport\n            failure, or a bad body."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/auth.py::decode_jwt"}) SET n += {`id`: "sym:repo2graph/auth.py::decode_jwt", `name`: "decode_jwt", `qualname`: "decode_jwt", `kind`: "function", `path`: "repo2graph/auth.py", `lang`: "python", `start_line`: 500, `end_line`: 595, `signature`: "def decode_jwt(token: str, jwks: JWKSCache, issuer: str, audience: str | None) -> dict[str, Any]:", `docstring`: "Validate a JWT's signature and claims, returning them.\n\n    Args:\n        token: The compact-serialised JWT.\n        jwks: Key source for the issuer.\n        issuer: The expected `iss` value.\n        audience: The expected `aud` value, or None to skip the check.\n\n    Returns:\n        The validated claims.\n\n    Raises:\n        AuthError: On any structural, signature or claim failure."};
