MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_explain_path_agrees_with_build_and_names_the_matching_glob"}) SET n += {`id`: "sym:tests/test_determinism.py::test_explain_path_agrees_with_build_and_names_the_matching_glob", `name`: "test_explain_path_agrees_with_build_and_names_the_matching_glob", `qualname`: "test_explain_path_agrees_with_build_and_names_the_matching_glob", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 379, `end_line`: 408, `signature`: "def test_explain_path_agrees_with_build_and_names_the_matching_glob(tmp_path, capsys):", `docstring`: "`explain-path` must answer from the rule set the build would use.\n\n    It also has to name *which* pattern matched: a `--exclude-group` expands\n    to as many as 60 globs, and echoing the whole list buries the answer in\n    the evidence.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_exclude_group_help_prints_every_group_and_exits_zero"}) SET n += {`id`: "sym:tests/test_determinism.py::test_exclude_group_help_prints_every_group_and_exits_zero", `name`: "test_exclude_group_help_prints_every_group_and_exits_zero", `qualname`: "test_exclude_group_help_prints_every_group_and_exits_zero", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 411, `end_line`: 420, `signature`: "def test_exclude_group_help_prints_every_group_and_exits_zero(capsys):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_discovery_sort_key_is_posix"}) SET n += {`id`: "sym:tests/test_determinism.py::test_discovery_sort_key_is_posix", `name`: "test_discovery_sort_key_is_posix", `qualname`: "test_discovery_sort_key_is_posix", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 424, `end_line`: 437, `signature`: "def test_discovery_sort_key_is_posix(tmp_path):", `docstring`: "Sorting on str(Path) would sort on \"\\\\\" on Windows and \"/\" elsewhere --\n    the same cross-machine divergence one level down from the os.walk bug.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_determinism.py::test_explain_path_knows_discover_never_indexes_an_index"}) SET n += {`id`: "sym:tests/test_determinism.py::test_explain_path_knows_discover_never_indexes_an_index", `name`: "test_explain_path_knows_discover_never_indexes_an_index", `qualname`: "test_explain_path_knows_discover_never_indexes_an_index", `kind`: "function", `path`: "tests/test_determinism.py", `lang`: "python", `start_line`: 440, `end_line`: 476, `signature`: "def test_explain_path_knows_discover_never_indexes_an_index(tmp_path, capsys, monkeypatch):", `docstring`: "`explain-path .r2g/agent/nodes.jsonl` said INCLUDED; no build indexes it.\n\n    discover() skips the -o directory and any directory holding a repo2graph\n    agent/manifest.json before any other rule; explain-path must say so.", `entrypoint`: true, `reach`: 123};
MERGE (n:R2G:`File` {id: "file:tests/test_doc_consistency.py"}) SET n += {`id`: "file:tests/test_doc_consistency.py", `name`: "test_doc_consistency.py", `path`: "tests/test_doc_consistency.py", `lang`: "python", `file_type`: "code", `size`: 23049, `lines`: 542, `parse_errors`: 0, `chunked`: false};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::_pyproject_version"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::_pyproject_version", `name`: "_pyproject_version", `qualname`: "_pyproject_version", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 41, `end_line`: 50, `signature`: "def _pyproject_version() -> str:", `docstring`: "`pyproject.toml`'s `[project] version`, read by regex like\n    `scripts/version_surfaces.py` does -- `tomllib` is 3.11+ only and this\n    project's floor is 3.10, so a regex match on the one line that matters\n    avoids adding a TOML-parsing dependency just for this test."};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_cli_commands_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_cli_commands_documented", `name`: "test_cli_commands_documented", `qualname`: "test_cli_commands_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 83, `end_line`: 102, `signature`: "def test_cli_commands_documented():", `docstring`: "Verify all CLI subcommands are documented in README.md and docs/cli.md.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_languages_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_languages_documented", `name`: "test_languages_documented", `qualname`: "test_languages_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 105, `end_line`: 129, `signature`: "def test_languages_documented():", `docstring`: "Verify every LANG_CFG grammar key is documented in README.md.\n\n    Word-boundary regexes, not plain substrings: `\"c\" in readme_text.lower()`\n    or `\"go\" in ...` is true of nearly any English prose regardless of\n    whether the language is mentioned, so those checks passed even with the\n    language name deleted from README.md. `\\\\bC\\\\b` (with a negative\n    lookahead so it doesn't also match the \"C\" inside \"C++\"/\"C#\") actually\n    requires the token to appear.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_action_inputs_and_outputs_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_action_inputs_and_outputs_documented", `name`: "test_action_inputs_and_outputs_documented", `qualname`: "test_action_inputs_and_outputs_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 132, `end_line`: 154, `signature`: "def test_action_inputs_and_outputs_documented():", `docstring`: "Verify every input and output in action.yml is documented in docs/github-action.md.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_mcp_tools_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_mcp_tools_documented", `name`: "test_mcp_tools_documented", `qualname`: "test_mcp_tools_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 157, `end_line`: 167, `signature`: "def test_mcp_tools_documented():", `docstring`: "Verify every registered tool in repo2graph.mcp is documented in docs/mcp.md.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_citation_cff_matches_pyproject"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_citation_cff_matches_pyproject", `name`: "test_citation_cff_matches_pyproject", `qualname`: "test_citation_cff_matches_pyproject", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 170, `end_line`: 187, `signature`: "def test_citation_cff_matches_pyproject():", `docstring`: "Issue #404: CITATION.cff must parse and stay in lockstep with pyproject.toml.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_npm_launcher_version_matches_pyproject"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_npm_launcher_version_matches_pyproject", `name`: "test_npm_launcher_version_matches_pyproject", `qualname`: "test_npm_launcher_version_matches_pyproject", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 190, `end_line`: 204, `signature`: "def test_npm_launcher_version_matches_pyproject():", `docstring`: "Issue #399: the npx launcher's package.json version stays paired with the PyPI release.\n\n    `npm/README.md`'s \"Release story\" section promises the two are published from the same\n    tag; this is the machine-checkable half of that promise.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_agent_working_files_are_not_committed"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_agent_working_files_are_not_committed", `name`: "test_agent_working_files_are_not_committed", `qualname`: "test_agent_working_files_are_not_committed", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 207, `end_line`: 225, `signature`: "def test_agent_working_files_are_not_committed():", `docstring`: "Issue #403, widened: build-loop state and run logs are working files.\n\n    They were committed at the root, then under docs/, and read to every visitor as\n    an agent's scratchpad. `.gitignore` now keeps them out wherever they are written.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_threat_model_covers_every_deployment_mode"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_threat_model_covers_every_deployment_mode", `name`: "test_threat_model_covers_every_deployment_mode", `qualname`: "test_threat_model_covers_every_deployment_mode", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 228, `end_line`: 258, `signature`: "def test_threat_model_covers_every_deployment_mode():", `docstring`: "Issue #263: docs/deployment-security.md must exist and name every required mode/topic.\n\n    A loose substring check rather than a hand-derived membership assertion (AGENTS.md's usual\n    rule for *behavioural* tests) -- this is a documentation-completeness check, so the thing\n    being pinned is \"the required topic is discussed somewhere in the file,\" not a value the\n    code under test computes.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_threat_model_numeric_claims_match_the_http_and_auth_source"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_threat_model_numeric_claims_match_the_http_and_auth_source", `name`: "test_threat_model_numeric_claims_match_the_http_and_auth_source", `qualname`: "test_threat_model_numeric_claims_match_the_http_and_auth_source", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 261, `end_line`: 271, `signature`: "def test_threat_model_numeric_claims_match_the_http_and_auth_source():", `docstring`: "docs/deployment-security.md cites specific constants from http_server.py/auth.py in prose --\n    this pins those constants so a future change to either module without a doc edit fails\n    here instead of leaving the threat model quietly wrong.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_starter_questions_match_the_docs_verbatim"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_starter_questions_match_the_docs_verbatim", `name`: "test_starter_questions_match_the_docs_verbatim", `qualname`: "test_starter_questions_match_the_docs_verbatim", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 274, `end_line`: 303, `signature`: "def test_starter_questions_match_the_docs_verbatim():", `docstring`: "The five starter prompts are authored once, in repo2graph/demo.py.\n\n    README.md and docs/quickstart.md both render them, and `repo2graph demo`\n    runs them -- so a prompt edited in one place and not the others would\n    leave the docs telling users to run something the demo never exercises.\n    Both the template form (what a reader copies onto their own repo) and the\n    demo form (what actually runs) are pinned.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_every_exclusion_group_is_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_every_exclusion_group_is_documented", `name`: "test_every_exclusion_group_is_documented", `qualname`: "test_every_exclusion_group_is_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 306, `end_line`: 322, `signature`: "def test_every_exclusion_group_is_documented():", `docstring`: "`--exclude-group` names come from one table; the docs must list them all.\n\n    A group added to `exclusions.GROUPS` and not documented is a flag nobody\n    can discover; a group documented and not implemented is a flag that\n    errors.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_indexing_doc_names_determinism_tests_that_exist"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_indexing_doc_names_determinism_tests_that_exist", `name`: "test_indexing_doc_names_determinism_tests_that_exist", `qualname`: "test_indexing_doc_names_determinism_tests_that_exist", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 325, `end_line`: 345, `signature`: "def test_indexing_doc_names_determinism_tests_that_exist():", `docstring`: "INDEXING.md's guarantee table points at specific tests by name.\n\n    A renamed or deleted test would leave the documented guarantee pointing\n    at nothing while still reading as though it were enforced.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_indexing_docs_and_rfc_are_cross_linked"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_indexing_docs_and_rfc_are_cross_linked", `name`: "test_indexing_docs_and_rfc_are_cross_linked", `qualname`: "test_indexing_docs_and_rfc_are_cross_linked", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 348, `end_line`: 358, `signature`: "def test_indexing_docs_and_rfc_are_cross_linked():", `docstring`: "The RFC carries the benchmarks INDEXING.md's performance section defers\n    to; a broken link between them leaves the numbers unfindable.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_git_metadata_fields_are_documented"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_git_metadata_fields_are_documented", `name`: "test_git_metadata_fields_are_documented", `qualname`: "test_git_metadata_fields_are_documented", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 361, `end_line`: 371, `signature`: "def test_git_metadata_fields_are_documented():", `docstring`: "Every provenance field `index-status` surfaces is named in INDEXING.md.\n\n    `manifest.json`'s `source_revision` is a public surface -- `--json`\n    prints it verbatim -- so a field added without a doc edit is an\n    undocumented API. The *shape* of the report is asserted against a real\n    index in tests/test_index_status.py, not by scraping this source.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_quickstart_names_the_doctor_checks_it_promises"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_quickstart_names_the_doctor_checks_it_promises", `name`: "test_quickstart_names_the_doctor_checks_it_promises", `qualname`: "test_quickstart_names_the_doctor_checks_it_promises", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 374, `end_line`: 390, `signature`: "def test_quickstart_names_the_doctor_checks_it_promises():", `docstring`: "The quickstart's troubleshooting table routes each symptom to a named\n    doctor check. A check renamed or dropped without a doc edit leaves the\n    table pointing at output that never appears.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_every_shipped_doc_is_listed_in_the_docs_index"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_every_shipped_doc_is_listed_in_the_docs_index", `name`: "test_every_shipped_doc_is_listed_in_the_docs_index", `qualname`: "test_every_shipped_doc_is_listed_in_the_docs_index", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 393, `end_line`: 413, `signature`: "def test_every_shipped_doc_is_listed_in_the_docs_index():", `docstring`: "A doc nobody can reach from docs/README.md is a doc nobody reads.\n\n    Caught four at once: quickstart, INDEXING, OUTPUT_SCHEMA and the\n    incremental RFC were all written and none was linked.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_doc_consistency.py::test_reference_and_output_schema_agree_on_the_standard_edge_fields"}) SET n += {`id`: "sym:tests/test_doc_consistency.py::test_reference_and_output_schema_agree_on_the_standard_edge_fields", `name`: "test_reference_and_output_schema_agree_on_the_standard_edge_fields", `qualname`: "test_reference_and_output_schema_agree_on_the_standard_edge_fields", `kind`: "function", `path`: "tests/test_doc_consistency.py", `lang`: "python", `start_line`: 416, `end_line`: 439, `signature`: "def test_reference_and_output_schema_agree_on_the_standard_edge_fields():", `docstring`: "`docs/reference.md` claims to list every field an edge can carry.\n\n    It said `CALLS_EXTERNAL` carries no `confidence` -- true until every edge\n    type gained the standard trio, and wrong afterwards. Both pages describe\n    the same records, so both must name the same three fields.", `entrypoint`: true};
