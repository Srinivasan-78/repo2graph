MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rag.py::test_the_backup_suffix_strip_terminates_on_a_hostile_name"}) SET n += {`id`: "sym:tests/test_rag.py::test_the_backup_suffix_strip_terminates_on_a_hostile_name", `name`: "test_the_backup_suffix_strip_terminates_on_a_hostile_name", `qualname`: "test_the_backup_suffix_strip_terminates_on_a_hostile_name", `kind`: "function", `path`: "tests/test_rag.py", `lang`: "python", `start_line`: 1958, `end_line`: 1975, `signature`: "def test_the_backup_suffix_strip_terminates_on_a_hostile_name(path):", `docstring`: "A path is attacker-supplied on every build, and this rule loops.\n\n    Each pass removes at least one character and the loop stops when no suffix\n    matches or nothing but the suffix is left, so a name that is nothing but\n    thousands of stacked suffixes must return rather than recurse without bound.\n    The time bound is deliberately loose (measured ~6ms for the worst of these).", `entrypoint`: true};
