MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/discovery.py::is_binary"}) SET n += {`id`: "sym:repo2graph/discovery.py::is_binary", `name`: "is_binary", `qualname`: "is_binary", `kind`: "function", `path`: "repo2graph/discovery.py", `lang`: "python", `start_line`: 154, `end_line`: 175, `signature`: "def is_binary(path: Path) -> bool:", `docstring`: "True if file contains null bytes (binary) and is not BOM-encoded text (W10).\n    Raises OSError if unreadable (e.g. permission or missing sparse file) (W15)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/discovery.py::_count_gitignored"}) SET n += {`id`: "sym:repo2graph/discovery.py::_count_gitignored", `name`: "_count_gitignored", `qualname`: "_count_gitignored", `kind`: "function", `path`: "repo2graph/discovery.py", `lang`: "python", `start_line`: 178, `end_line`: 216, `signature`: "def _count_gitignored(root: Path) -> int:", `docstring`: "How many untracked files .gitignore (or another exclude-standard rule)\n    kept out of _git_files' listing.\n\n    Purely a count for the human overview's \"what was skipped\" section --\n    `_git_files` already applies `--exclude-standard` itself, so these files\n    never reach `discover()`'s loop below and this never changes what is\n    yielded. Same subprocess pattern as `_git_files`: quotepath=false, bytes\n    decoded with surrogateescape (never text=True -- see .github/CONTRIBUTING.md), bounded\n    timeout."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/discovery.py::candidate_files"}) SET n += {`id`: "sym:repo2graph/discovery.py::candidate_files", `name`: "candidate_files", `qualname`: "candidate_files", `kind`: "function", `path`: "repo2graph/discovery.py", `lang`: "python", `start_line`: 219, `end_line`: 234, `signature`: "def candidate_files(root: Path, skip_dirs: Iterable[str]) -> list[Path]:", `docstring`: "Every path `discover` will consider, before it reads any file's content.\n\n    The two sources `discover` uses, in its precedence: `git ls-files -co\n    --exclude-standard` where git answers, a `skip_dirs`-pruned walk where it\n    does not. `skip_dirs` only reaches the walk, because the git listing\n    honours `.gitignore` instead and `discover` prunes it afterwards -- which\n    is why a caller of this must prune too.\n\n    Exposed for `watch.snapshot` (#483), which has to watch the set a build\n    indexes and no other: its own walk honoured neither `.gitignore` nor the\n    dotfiles a build does"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/discovery.py::discover"}) SET n += {`id`: "sym:repo2graph/discovery.py::discover", `name`: "discover", `qualname`: "discover", `kind`: "function", `path`: "repo2graph/discovery.py", `lang`: "python", `start_line`: 237, `end_line`: 446, `signature`: "def discover(\n    root: Path,\n    include_globs: Iterable[str] | None = None,\n    exclude_globs: Iterable[str] | None = None,\n    stats: dict[str, Any] | None = None,\n    config: BuildConfig | None = None,\n) -> Iterator[tuple[str, Path]]:", `docstring`: "Yield (relative_path, absolute_path) for candidate source files."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/discovery.py::discover._inside_index"}) SET n += {`id`: "sym:repo2graph/discovery.py::discover._inside_index", `name`: "_inside_index", `qualname`: "discover._inside_index", `kind`: "function", `path`: "repo2graph/discovery.py", `lang`: "python", `start_line`: 302, `end_line`: 314, `signature`: "def _inside_index(parts: tuple[str, ...]) -> bool:\n        # Never index a repo2graph output directory: the one this build writes\n        # to (explicit), or any directory an earlier build left behind (marker).", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/discovery.py::explain_path"}) SET n += {`id`: "sym:repo2graph/discovery.py::explain_path", `name`: "explain_path", `qualname`: "explain_path", `kind`: "function", `path`: "repo2graph/discovery.py", `lang`: "python", `start_line`: 449, `end_line`: 727, `signature`: "def explain_path(\n    root: Path | str,\n    target: Path | str,\n    config: BuildConfig | None = None,\n    include_globs: Iterable[str] | None = None,\n    exclude_globs: Iterable[str] | None = None,\n    repo_config: RepoConfig | None = None,\n) -> dict[str, Any]:", `docstring`: "Evaluate a path against the 10 inclusion/exclusion precedence rules.\n\n    `repo_config` holds the settings a config file supplied (#391); a decision\n    one of them made names that file instead of the CLI flag, and carries it\n    as `source`.\n\n    Returns a dict with:\n        path: target path\n        relative_path: relative path to root\n        included: bool (True if the file would be indexed)\n        rule: string identifier of the determining rule\n        reason: human-readable explanation\n        precedence_step: step number (1-10) where the decision was reached"};
