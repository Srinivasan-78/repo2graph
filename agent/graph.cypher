MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_auto_build_reaches_the_pool_and_detaches_its_workers.Recording.__init__"}) SET n += {`id`: "sym:tests/test_mcp.py::test_auto_build_reaches_the_pool_and_detaches_its_workers.Recording.__init__", `name`: "__init__", `qualname`: "test_auto_build_reaches_the_pool_and_detaches_its_workers.Recording.__init__", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1385, `end_line`: 1387, `signature`: "def __init__(self, *args, **kwargs):", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_pool_workers_cannot_reach_the_parents_stdin_or_stdout"}) SET n += {`id`: "sym:tests/test_mcp.py::test_pool_workers_cannot_reach_the_parents_stdin_or_stdout", `name`: "test_pool_workers_cannot_reach_the_parents_stdin_or_stdout", `qualname`: "test_pool_workers_cannot_reach_the_parents_stdin_or_stdout", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1403, `end_line`: 1445, `signature`: "def test_pool_workers_cannot_reach_the_parents_stdin_or_stdout():", `docstring`: "The mechanism itself, in a child process whose stdio is a pipe.\n\n    `_pool_stdio_probe.py` starts a pool with the exact kwargs `parse_all`\n    passes, and has one worker write a sentinel to fd 1 and read a byte from\n    fd 0. Measured on Windows (spawn) before the fix, a worker did both for\n    real: the sentinel landed in the parent's stdout pipe and the worker\n    consumed the byte the parent had queued -- which under `repo2graph-mcp`\n    is a frame of the client's request stream the server then waits for\n    forever.\n\n    `timeout=` is the hard bound: a regression that hangs a worker on fd", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_mcp.py::test_tools_call_over_serve_completes_on_the_parallel_path"}) SET n += {`id`: "sym:tests/test_mcp.py::test_tools_call_over_serve_completes_on_the_parallel_path", `name`: "test_tools_call_over_serve_completes_on_the_parallel_path", `qualname`: "test_tools_call_over_serve_completes_on_the_parallel_path", `kind`: "function", `path`: "tests/test_mcp.py", `lang`: "python", `start_line`: 1449, `end_line`: 1541, `signature`: "def test_tools_call_over_serve_completes_on_the_parallel_path(wide_repo, tmp_path):", `docstring`: "the golden baseline, end to end: a real `serve()` over real pipes against a repo above\n    PARALLEL_MIN_FILES answers its first tool call.\n\n    The marker file is what makes this about the *parallel* path: the launcher\n    records every ProcessPoolExecutor the server process builds, so a silent\n    fall back to serial fails here rather than passing quietly.\n\n    Timeouts everywhere -- a queue-fed reader thread, not a bare readline --\n    because the bug being guarded is a hang, and a test that reproduces it\n    with `proc.stdout.readline()` would never return.", `entrypoint`: true, `reach`: 60};
