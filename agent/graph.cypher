MERGE (n:R2G:`Symbol` {id: "sym:tests/test_parse_budget.py::test_a_runaway_parse_is_stopped_and_counted"}) SET n += {`id`: "sym:tests/test_parse_budget.py::test_a_runaway_parse_is_stopped_and_counted", `name`: "test_a_runaway_parse_is_stopped_and_counted", `qualname`: "test_a_runaway_parse_is_stopped_and_counted", `kind`: "function", `path`: "tests/test_parse_budget.py", `lang`: "python", `start_line`: 46, `end_line`: 79, `signature`: "def test_a_runaway_parse_is_stopped_and_counted(tmp_path, capsys, monkeypatch, extra):", `docstring`: "", `entrypoint`: true, `reach`: 369};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_parse_budget.py::test_the_default_parse_budget_leaves_room_for_the_slowest_real_file"}) SET n += {`id`: "sym:tests/test_parse_budget.py::test_the_default_parse_budget_leaves_room_for_the_slowest_real_file", `name`: "test_the_default_parse_budget_leaves_room_for_the_slowest_real_file", `qualname`: "test_the_default_parse_budget_leaves_room_for_the_slowest_real_file", `kind`: "function", `path`: "tests/test_parse_budget.py", `lang`: "python", `start_line`: 82, `end_line`: 92, `signature`: "def test_the_default_parse_budget_leaves_room_for_the_slowest_real_file():", `docstring`: "The budget is a static promise, so assert it statically.\n\n    The slowest real file across the five benchmark corpora took 0.74 s, so the\n    10 s default is a >13x margin. This used to be checked by parsing a deep\n    fixture under the default budget and asserting it was not flagged -- which\n    made the runner's speed part of the assertion and failed intermittently on\n    a contended CI box (seen on ubuntu/3.12 under `-n auto --cov`). The margin\n    is what the test is really about, and it does not need a stopwatch.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_parse_budget.py::test_a_deep_legitimate_file_is_not_a_false_positive"}) SET n += {`id`: "sym:tests/test_parse_budget.py::test_a_deep_legitimate_file_is_not_a_false_positive", `name`: "test_a_deep_legitimate_file_is_not_a_false_positive", `qualname`: "test_a_deep_legitimate_file_is_not_a_false_positive", `kind`: "function", `path`: "tests/test_parse_budget.py", `lang`: "python", `start_line`: 95, `end_line`: 111, `signature`: "def test_a_deep_legitimate_file_is_not_a_false_positive(tmp_path):", `docstring`: "Deep-but-ordinary content must not trip the runaway heuristic.\n\n    The budget here is explicit and generous rather than the default, because\n    what is under test is the *content* -- 425 KB of literals nested 200 deep\n    parses in ~0.8 s on a developer machine -- not how fast the runner is\n    today. See `test_the_default_parse_budget_leaves_room_for_the_slowest_real_file`\n    for the margin the default actually carries.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_parse_budget.py::test_strict_policy_fails_instead_of_skipping"}) SET n += {`id`: "sym:tests/test_parse_budget.py::test_strict_policy_fails_instead_of_skipping", `name`: "test_strict_policy_fails_instead_of_skipping", `qualname`: "test_strict_policy_fails_instead_of_skipping", `kind`: "function", `path`: "tests/test_parse_budget.py", `lang`: "python", `start_line`: 114, `end_line`: 124, `signature`: "def test_strict_policy_fails_instead_of_skipping(tmp_path):\n    # Either bound, for the reason given in\n    # `test_a_runaway_parse_is_stopped_and_counted`: what strict policy promises\n    # is that a skip becomes an error naming the file, not which bound caught it.", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_parse_budget.py::test_an_in_process_parse_over_budget_is_discarded_too"}) SET n += {`id`: "sym:tests/test_parse_budget.py::test_an_in_process_parse_over_budget_is_discarded_too", `name`: "test_an_in_process_parse_over_budget_is_discarded_too", `qualname`: "test_an_in_process_parse_over_budget_is_discarded_too", `kind`: "function", `path`: "tests/test_parse_budget.py", `lang`: "python", `start_line`: 127, `end_line`: 147, `signature`: "def test_an_in_process_parse_over_budget_is_discarded_too(tmp_path, monkeypatch):", `docstring`: "Small files in a serial build parse in-process, where the budget can only\n    discard the result afterwards; the outcome is the same as a kill.", `entrypoint`: true};
