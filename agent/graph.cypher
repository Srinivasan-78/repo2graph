MERGE (n:R2G:`Symbol` {id: "sym:tests/test_file_limits.py::test_a_file_over_the_size_ceiling_is_skipped_unless_chunking_is_on"}) SET n += {`id`: "sym:tests/test_file_limits.py::test_a_file_over_the_size_ceiling_is_skipped_unless_chunking_is_on", `name`: "test_a_file_over_the_size_ceiling_is_skipped_unless_chunking_is_on", `qualname`: "test_a_file_over_the_size_ceiling_is_skipped_unless_chunking_is_on", `kind`: "function", `path`: "tests/test_file_limits.py", `lang`: "python", `start_line`: 31, `end_line`: 57, `signature`: "def test_a_file_over_the_size_ceiling_is_skipped_unless_chunking_is_on(tmp_path):", `docstring`: "Over the ceiling the file gets no node; `chunk_large_files` rescues it.\n\n    Run against a small `max_file_bytes` rather than the 1.5 MB default: the\n    branch is a single `st.st_size > config.max_file_bytes` comparison, identical\n    at any threshold, and the default version wrote 3 MB to disk and built the\n    graph twice for 5.7s -- the slowest test in the suite by 5x. The default\n    itself is pinned by the test above.", `entrypoint`: true};
