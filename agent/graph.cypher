MERGE (n:R2G:Symbol {id: "sym:repo2graph/fetch.py::_rmtree"}) SET n += {`id`: "sym:repo2graph/fetch.py::_rmtree", `name`: "_rmtree", `qualname`: "_rmtree", `kind`: "function", `path`: "repo2graph/fetch.py", `lang`: "python", `start_line`: 19, `end_line`: 41, `signature`: "def _rmtree(path: Path) -> None:", `docstring`: "Best-effort recursive delete of a temp clone.\n\n    Git marks pack files under .git/objects read-only; on Windows os.unlink then\n    raises PermissionError and shutil.rmtree(ignore_errors=True) would leave the\n    whole clone (often hundreds of MB) behind. Clear the bit and retry."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/fetch.py::_rmtree._on_error"}) SET n += {`id`: "sym:repo2graph/fetch.py::_rmtree._on_error", `name`: "_on_error", `qualname`: "_rmtree._on_error", `kind`: "function", `path`: "repo2graph/fetch.py", `lang`: "python", `start_line`: 27, `end_line`: 32, `signature`: "def _on_error(func, p, _exc):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/fetch.py::_git_version"}) SET n += {`id`: "sym:repo2graph/fetch.py::_git_version", `name`: "_git_version", `qualname`: "_git_version", `kind`: "function", `path`: "repo2graph/fetch.py", `lang`: "python", `start_line`: 53, `end_line`: 75, `signature`: "def _git_version() -> tuple[int, ...]:", `docstring`: "Probe `git --version`, memoizing only a successful result.\n\n    A transient failure (fd exhaustion, fork failure, ...) must not be cached\n    forever: that would permanently mask the version-gated security check in\n    _auth_env for the rest of the process's life. Only a successful probe is\n    memoized; a failed probe is retried on the next call."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/fetch.py::parse_spec"}) SET n += {`id`: "sym:repo2graph/fetch.py::parse_spec", `name`: "parse_spec", `qualname`: "parse_spec", `kind`: "function", `path`: "repo2graph/fetch.py", `lang`: "python", `start_line`: 78, `end_line`: 90, `signature`: "def parse_spec(spec: str) -> tuple[str, str]:", `docstring`: "'owner/repo', a GitHub URL or an SSH remote -> (owner, repo)."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/fetch.py::_redact"}) SET n += {`id`: "sym:repo2graph/fetch.py::_redact", `name`: "_redact", `qualname`: "_redact", `kind`: "function", `path`: "repo2graph/fetch.py", `lang`: "python", `start_line`: 93, `end_line`: 102, `signature`: "def _redact(msg: str, token: str | None) -> str:", `docstring`: "Strip the token, its base64 'basic' form, and URL-encoded form from user-facing text (SH-3)."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/fetch.py::_auth_env"}) SET n += {`id`: "sym:repo2graph/fetch.py::_auth_env", `name`: "_auth_env", `qualname`: "_auth_env", `kind`: "function", `path`: "repo2graph/fetch.py", `lang`: "python", `start_line`: 105, `end_line`: 131, `signature`: "def _auth_env(token: str | None) -> dict:", `docstring`: "Environment carrying the clone credential out of band.\n\n    The token must never be an argv element (ISS-16): it would be visible in\n    `ps`/`/proc` to every other user. git reads http.extraheader from\n    GIT_CONFIG_* for this one invocation only, so nothing lands on disk either."};
