MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_decorator_receiver"}) SET n += {`id`: "sym:repo2graph/parse.py::_decorator_receiver", `name`: "_decorator_receiver", `qualname`: "_decorator_receiver", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 959, `end_line`: 967, `signature`: "def _decorator_receiver(src: bytes, node) -> dict:", `docstring`: "Receiver keys for a decorator/annotation entry.\n\n    `@router.get(\"/x\")` is a call of `get` on `router`. Without these keys the\n    entry looked receiver-less -- a typed call -- and kept every untyped\n    `d.get()` in the decorated function bound at 1.0."};
