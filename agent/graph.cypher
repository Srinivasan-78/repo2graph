MERGE (n:R2G:`Symbol` {id: "sym:tests/test_secrets_hardening.py::test_repo_read_redacts_at_serve_time_like_repo_search_does"}) SET n += {`id`: "sym:tests/test_secrets_hardening.py::test_repo_read_redacts_at_serve_time_like_repo_search_does", `name`: "test_repo_read_redacts_at_serve_time_like_repo_search_does", `qualname`: "test_repo_read_redacts_at_serve_time_like_repo_search_does", `kind`: "function", `path`: "tests/test_secrets_hardening.py", `lang`: "python", `start_line`: 1338, `end_line`: 1370, `signature`: "def test_repo_read_redacts_at_serve_time_like_repo_search_does(tmp_path):", `docstring`: "`repo_read` sliced `index.chunks` straight back to the caller.\n\n    Every other agent-facing path routes through `Index._served`, which\n    re-redacts when the index was built with `off` or `warn-only`. `repo_read`\n    did not, so the same bytes came back in clear from one MCP tool and redacted\n    from another -- while docs/mcp.md stated without qualification that chunks\n    \"have already passed secret-path exclusion and content redaction\".", `entrypoint`: true, `reach`: 393};
