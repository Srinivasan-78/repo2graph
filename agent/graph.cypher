MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_action_yml_run_blocks_take_inputs_only_through_env"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_action_yml_run_blocks_take_inputs_only_through_env", `name`: "test_action_yml_run_blocks_take_inputs_only_through_env", `qualname`: "test_action_yml_run_blocks_take_inputs_only_through_env", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1477, `end_line`: 1482, `signature`: "def test_action_yml_run_blocks_take_inputs_only_through_env():", `docstring`: "Every composite `run:` script reads its inputs from env:, never from a\n    ${{ }} expression -- an input holding shell metacharacters would otherwise\n    be substituted into the script before bash ever sees it.", `entrypoint`: true};
