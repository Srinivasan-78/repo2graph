MERGE (n:R2G:`Symbol` {id: "sym:tests/test_query_bounds.py::TestFitLines.test_fit_lines_custom_measure_still_measures_whole_candidate"}) SET n += {`id`: "sym:tests/test_query_bounds.py::TestFitLines.test_fit_lines_custom_measure_still_measures_whole_candidate", `name`: "test_fit_lines_custom_measure_still_measures_whole_candidate", `qualname`: "TestFitLines.test_fit_lines_custom_measure_still_measures_whole_candidate", `kind`: "function", `path`: "tests/test_query_bounds.py", `lang`: "python", `start_line`: 228, `end_line`: 240, `signature`: "def test_fit_lines_custom_measure_still_measures_whole_candidate(self):", `docstring`: "Non-additive measure path: token-style count_tokens (len // 4,\n        floor) must still be applied to the whole growing string each line,\n        matching the pre-optimization behaviour exactly.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_query_bounds.py::TestFitLines.test_fit_lines_is_linear_not_quadratic"}) SET n += {`id`: "sym:tests/test_query_bounds.py::TestFitLines.test_fit_lines_is_linear_not_quadratic", `name`: "test_fit_lines_is_linear_not_quadratic", `qualname`: "TestFitLines.test_fit_lines_is_linear_not_quadratic", `kind`: "function", `path`: "tests/test_query_bounds.py", `lang`: "python", `start_line`: 242, `end_line`: 275, `signature`: "def test_fit_lines_is_linear_not_quadratic(self):", `docstring`: "Detector for fit_lines linearity. The old implementation called `measure` once\n        per line either way -- the quadratic cost was in the *string building*,\n        which no call counter can see -- so this has to be a wall-clock test.\n\n        Comparing one input size against a larger one does not work here: the\n        ceiling would be anchored on a small-input timing that is itself\n        quadratic, and the two grow together. Measured, a 10x spread separates\n        the regression from the allowance by only ~2x, which is how a timing\n        test becomes a flake on a shared runner.\n\n     ", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_query_bounds.py::TestFitLines.test_fit_lines_is_linear_not_quadratic.timed"}) SET n += {`id`: "sym:tests/test_query_bounds.py::TestFitLines.test_fit_lines_is_linear_not_quadratic.timed", `name`: "timed", `qualname`: "TestFitLines.test_fit_lines_is_linear_not_quadratic.timed", `kind`: "function", `path`: "tests/test_query_bounds.py", `lang`: "python", `start_line`: 265, `end_line`: 269, `signature`: "def timed(fn) -> float:", `docstring`: ""};
