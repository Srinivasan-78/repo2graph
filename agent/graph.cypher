MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index._served"}) SET n += {`id`: "sym:repo2graph/query.py::Index._served", `name`: "_served", `qualname`: "Index._served", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 361, `end_line`: 377, `signature`: "def _served(self, c: Record) -> Record:", `docstring`: "`c` with its text content-redacted when the index may hold raw secrets.\n\n        Serve-time backstop for the agent path (`exclude_secrets=True`): an index\n        whose manifest does not say its chunks were redacted at build time\n        (`--secret-policy off`/`warn-only`, a pre-fix `--include-secrets` build,\n        or no manifest at all) is scanned here, per returned chunk. A redacted\n        index is passed through untouched, so the default path costs nothing."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.score"}) SET n += {`id`: "sym:repo2graph/query.py::Index.score", `name`: "score", `qualname`: "Index.score", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 379, `end_line`: 404, `signature`: "def score(self, query: str) -> list[tuple[float, int]]:\n        # ISS-378: tokenize(query) alone drops single-character terms (TOKEN_RE\n        # requires 2+ chars), so a query of exactly \"T\" would never look up the\n        # \"t\" posting even though Index.__init__ now creates one for a\n        # sin", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index._boost_identifiers"}) SET n += {`id`: "sym:repo2graph/query.py::Index._boost_identifiers", `name`: "_boost_identifiers", `qualname`: "Index._boost_identifiers", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 406, `end_line`: 429, `signature`: "def _boost_identifiers(self, query: str, acc: dict[int, float]) -> None:", `docstring`: "Multiply the score of chunks the query names outright.\n\n        A pinpoint query like `normalize_provider` should return the symbol, not\n        the prose that happens to repeat the word. Only whole identifiers from\n        the query count (not tokenize()'s sub-words), and only chunks BM25\n        already scored are touched, so score()'s invariants are unchanged."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.score_rrf"}) SET n += {`id`: "sym:repo2graph/query.py::Index.score_rrf", `name`: "score_rrf", `qualname`: "Index.score_rrf", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 431, `end_line`: 484, `signature`: "def score_rrf(\n        self,\n        query: str,\n        vectors: Mapping[Any, Vector] | None = None,\n        embedder: \"Embedder | None\" = None,\n    ) -> list[tuple[float, int]]:", `docstring`: "BM25 fused with an optional dense ranking by reciprocal rank fusion.\n\n        With neither `vectors` nor `embedder` this is exactly `score()` \u2014 the\n        zero-dependency default path. `embedder` is any object with\n        `.encode(list[str]) -> list[sequence[float]]` (sentence-transformers\n        satisfies it); `vectors` is a mapping of chunk index -> vector, which may\n        carry the query vector under the key \"query\". Similarity is computed in\n        plain Python, so no optional dependency is imported here either."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index._vectors_for"}) SET n += {`id`: "sym:repo2graph/query.py::Index._vectors_for", `name`: "_vectors_for", `qualname`: "Index._vectors_for", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 486, `end_line`: 556, `signature`: "def _vectors_for(\n        self,\n        query: str,\n        candidates: list[int],\n        vectors: Mapping[Any, Vector] | None,\n        embedder: \"Embedder | None\",\n    ) -> tuple[Vector | None, list[Vector], str]:", `docstring`: "Query vector plus one vector per candidate, or a reason there is none.\n\n        Args:\n            query: The raw query string.\n            candidates: Chunk list-indices BM25 shortlisted, in rank order.\n            vectors: Index-keyed vector mapping, or None to embed on the fly.\n            embedder: An object with `.encode(list[str])`, or None.\n\n        Returns:\n            `(query_vector, candidate_vectors, reason)`. On success `reason` is\n            the empty string; on failure the first two are `None`/`[]` and\n            `reason` names *why*, so the caller can report a fusion that\n     "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.expand"}) SET n += {`id`: "sym:repo2graph/query.py::Index.expand", `name`: "expand", `qualname`: "Index.expand", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 558, `end_line`: 613, `signature`: "def expand(\n        self,\n        seed_nodes: Iterable[str],\n        hops: int = 1,\n        edge_types: Iterable[str] | None = None,\n        per_hop: int = 6,\n        min_confidence: float = 1.0,\n        edge_dirs: Mapping[str, tuple[str, ...]] | None = None,\n    ) -> list[tuple[str, str, str, str]]", `docstring`: "Walk `hops` edges out from `seed_nodes`, newest frontier first.\n\n        `min_confidence` gates CALLS edges only: call resolution is name-based\n        and an overloaded name fans out to several candidates at 1/n confidence,\n        while IMPORTS/DEFINES/INHERITS carry no `confidence` key at all and must\n        never be dropped by the gate. `edge_dirs` maps an edge type to the\n        directions worth following (see DEFAULT_EDGE_DIRS)."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.retrieve"}) SET n += {`id`: "sym:repo2graph/query.py::Index.retrieve", `name`: "retrieve", `qualname`: "Index.retrieve", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 615, `end_line`: 702, `signature`: "def retrieve(\n        self,\n        query: str,\n        k: int = 8,\n        hops: int = 1,\n        budget_chars: int = RETRIEVE_BUDGET_CHARS,\n        *,\n        min_confidence: float | None = None,\n        vectors: Mapping[Any, Vector] | None = None,\n        embedder: \"Embedder | None\" = None,\n     ", `docstring`: "Lexical seeds plus their graph neighbours, budgeted on chunk text.\n\n        `budget_chars` bounds the sum of the returned chunks' `text` only \u2014 it\n        says nothing about how a caller renders them. pack_context() uses the\n        other model (the whole rendered markdown); do not unify the two.\n        `min_confidence=None` means \"do not filter CALLS on confidence\", which is\n        this method's historical behaviour. With `vectors` and `embedder` both\n        None -- the default -- seeds come from `score()` exactly as they always\n        have; supply either and they come from the fused rank"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.retrieve._secret"}) SET n += {`id`: "sym:repo2graph/query.py::Index.retrieve._secret", `name`: "_secret", `qualname`: "Index.retrieve._secret", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 643, `end_line`: 649, `signature`: "def _secret(c: Record, nid: str) -> bool:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.map_prepend"}) SET n += {`id`: "sym:repo2graph/query.py::Index.map_prepend", `name`: "map_prepend", `qualname`: "Index.map_prepend", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 706, `end_line`: 729, `signature`: "def map_prepend(self) -> str:", `docstring`: "The repo map: the prose overview plus the top entry points.\n\n        Entry points come straight off `manifest[\"entrypoints\"]`, which\n        export.write_manifest already sorted by reach. Both sources are\n        optional; with neither, this is the empty string."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.pack_context"}) SET n += {`id`: "sym:repo2graph/query.py::Index.pack_context", `name`: "pack_context", `qualname`: "Index.pack_context", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 731, `end_line`: 886, `signature`: "def pack_context(\n        self,\n        query: str,\n        k: int = 8,\n        hops: int = 1,\n        budget_chars: int = 24000,\n        min_confidence: float = 1.0,\n        expand_graph: bool = True,\n        vectors: Mapping[Any, Vector] | None = None,\n        embedder: \"Embedder | None\" = None,\n ", `docstring`: "An agent-ready markdown pack: repo map, `---`, then cited chunks.\n\n        `budget_chars` bounds the WHOLE returned markdown \u2014 map prepend, `---`\n        separator and every `### [cite: ...]` header included \u2014 unlike\n        retrieve(), which budgets chunk text only. `budget_chars <= 0` means\n        unbounded. Spending order is map (capped at MAP_BUDGET_FRAC of the\n        budget), then seeds in score order at full text, then graph neighbours\n        at full text or, if that no longer fits, compressed to their header\n        lines plus the signature line. Nothing is truncated mid-line.\n\n     "};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::Index.pack_context.fits"}) SET n += {`id`: "sym:repo2graph/query.py::Index.pack_context.fits", `name`: "fits", `qualname`: "Index.pack_context.fits", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 827, `end_line`: 828, `signature`: "def fits(block: str) -> bool:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::_first"}) SET n += {`id`: "sym:repo2graph/query.py::_first", `name`: "_first", `qualname`: "_first", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 889, `end_line`: 892, `signature`: "def _first(seq: Iterable[_T]) -> _T | None:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::_has_vector"}) SET n += {`id`: "sym:repo2graph/query.py::_has_vector", `name`: "_has_vector", `qualname`: "_has_vector", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 895, `end_line`: 904, `signature`: "def _has_vector(vectors: Any, i: int) -> bool:", `docstring`: "True when `vectors` holds a vector for chunk index `i`.\n\n    Used only to count what is missing for a diagnostic message, so it answers\n    False for every failure mode rather than distinguishing them."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::_dim_mismatch_reason"}) SET n += {`id`: "sym:repo2graph/query.py::_dim_mismatch_reason", `name`: "_dim_mismatch_reason", `qualname`: "_dim_mismatch_reason", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 907, `end_line`: 925, `signature`: "def _dim_mismatch_reason(qvec: Vector, cvecs: Sequence[Vector]) -> str:", `docstring`: "Empty when every candidate vector matches `qvec`'s width, else a reason.\n\n    `zip()` truncates to the shorter operand, so a width mismatch (e.g. 768 vs\n    1536 from two different embedding models) would otherwise pass straight\n    into `_cosine()` and compute a plausible-looking but meaningless score\n    instead of raising. Catching it here keeps the promise the rest of\n    `_vectors_for` makes: a bad vector turns fusion off and falls back to\n    BM25, it never raises out to the caller."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::_cosine"}) SET n += {`id`: "sym:repo2graph/query.py::_cosine", `name`: "_cosine", `qualname`: "_cosine", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 928, `end_line`: 946, `signature`: "def _cosine(a: Vector, b: Vector) -> float:", `docstring`: "Cosine similarity over any two sequences of floats (no numpy needed).\n\n    Raises `ValueError` on mismatched lengths rather than letting `zip()`\n    silently truncate to the shorter vector and compute a meaningless score.\n    Callers that accept caller-supplied vectors (`score_rrf` via\n    `_vectors_for`) must validate widths themselves and never let this\n    exception reach their own caller -- see `_dim_mismatch_reason`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::_fit_lines"}) SET n += {`id`: "sym:repo2graph/query.py::_fit_lines", `name`: "_fit_lines", `qualname`: "_fit_lines", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 949, `end_line`: 989, `signature`: "def _fit_lines(text: str, limit: int, measure: Callable[[str], int] = len) -> str:", `docstring`: "The longest whole-line prefix of `text` that fits in `limit` units.\n\n    The candidate is measured whole rather than line by line, so a measure that\n    is not additive (any token estimate) is applied to the string that will\n    actually be emitted. With the default `len` this is exactly the running\n    \"len(line) + a newline\" arithmetic it replaces.\n\n    ISS-345: the old loop rebuilt `\"\\n\".join([*kept, line])` -- a fresh list\n    unpack plus a fresh O(K)-length join -- on every one of N lines, so\n    fitting a K-line prefix cost O(N*K) rather than O(N). `measure is len`\n    (true for the defa"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::_compress"}) SET n += {`id`: "sym:repo2graph/query.py::_compress", `name`: "_compress", `qualname`: "_compress", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 992, `end_line`: 1007, `signature`: "def _compress(text: str) -> str:", `docstring`: "A chunk reduced to its `#` metadata header plus the signature line.\n\n    chunks.build_chunks always emits `# file:` / `# <kind>:` header lines ahead\n    of the body, so the first non-blank line after them is the def/class line."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::_header_len"}) SET n += {`id`: "sym:repo2graph/query.py::_header_len", `name`: "_header_len", `qualname`: "_header_len", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1026, `end_line`: 1035, `signature`: "def _header_len(lines: list[str]) -> int:", `docstring`: "How many leading lines of a chunk's text are its generated header."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::_excerpt_record"}) SET n += {`id`: "sym:repo2graph/query.py::_excerpt_record", `name`: "_excerpt_record", `qualname`: "_excerpt_record", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1038, `end_line`: 1072, `signature`: "def _excerpt_record(chunk: Record, full: str, short: str) -> Record:", `docstring`: "`chunk` re-cited to the source lines `_compress` actually kept.\n\n    `excerpt_of` keeps the whole chunk's span. The shown span replaces\n    `start_line`/`end_line` only where chunk text maps line-for-line onto the\n    source from `start_line` -- a whole file or a whole symbol, first part.\n    A file residual (symbol spans carved out, then stripped) or a later split\n    part does not, so those keep their span and rely on the marker alone."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::_cite_block"}) SET n += {`id`: "sym:repo2graph/query.py::_cite_block", `name`: "_cite_block", `qualname`: "_cite_block", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1075, `end_line`: 1100, `signature`: "def _cite_block(chunk: Record, text: str) -> str:", `docstring`: "One `### [cite: path:start-end] `symbol` (why)` block, trailing blank line.\n\n    A compressed neighbour (`excerpt_of` set) cites the lines it shows and\n    says which span they are an excerpt of, between the symbol and the why."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/query.py::format_pack"}) SET n += {`id`: "sym:repo2graph/query.py::format_pack", `name`: "format_pack", `qualname`: "format_pack", `kind`: "function", `path`: "repo2graph/query.py", `lang`: "python", `start_line`: 1103, `end_line`: 1111, `signature`: "def format_pack(results: Iterable[Record]) -> str:", `docstring`: ""};
