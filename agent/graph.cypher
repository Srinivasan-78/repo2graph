MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::parse_action_block"}) SET n += {`id`: "sym:tests/test_compat.py::parse_action_block", `name`: "parse_action_block", `qualname`: "parse_action_block", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 271, `end_line`: 300, `signature`: "def parse_action_block(text: str, block: str) -> dict:", `docstring`: "The `inputs:` or `outputs:` mapping of action.yml, without PyYAML.\n\n    action.yml's two declaration blocks are a flat two-level mapping of plain\n    scalars, so a deliberately small parser covers them exactly. It is\n    cross-checked against PyYAML in test_ac8_hand_parser_agrees_with_pyyaml\n    whenever PyYAML happens to be installed, and the suite does not require it\n    -- `pip install repo2graph[dev]` is pytest + ruff and nothing else."};
