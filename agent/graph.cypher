MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::_split_bases"}) SET n += {`id`: "sym:repo2graph/parse.py::_split_bases", `name`: "_split_bases", `qualname`: "_split_bases", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 1062, `end_line`: 1082, `signature`: "def _split_bases(text: str) -> list[str]:", `docstring`: "Split a base-class list on top-level commas only.\n\n    A generic's type arguments (`Generic[T, U]`, `Handler<Request, Response>`)\n    contain commas that must not split the base list itself, so track bracket\n    depth and only split where it is zero."};
