MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/store.py::SqliteGraphStore"}) SET n += {`id`: "sym:repo2graph/store.py::SqliteGraphStore", `name`: "SqliteGraphStore", `qualname`: "SqliteGraphStore", `kind`: "class", `path`: "repo2graph/store.py", `lang`: "python", `start_line`: 140, `end_line`: 369, `signature`: "class SqliteGraphStore:", `docstring`: "A prototype on-disk store: one SQLite file, nothing resident but the page cache.\n\n    `build()` writes the database from records (streamed, so a graph larger\n    than memory can be loaded); opening it afterwards reads nothing up front.\n    Records come back as fresh dicts, so a caller cannot mutate the store."};
