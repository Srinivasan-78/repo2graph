MERGE (n:R2G:Symbol {id: "sym:.github/scripts/prod-igy.js::aiConfig"}) SET n += {`id`: "sym:.github/scripts/prod-igy.js::aiConfig", `name`: "aiConfig", `qualname`: "aiConfig", `kind`: "function", `path`: ".github/scripts/prod-igy.js", `lang`: "javascript", `start_line`: 91, `end_line`: 118, `signature`: "function aiConfig()", `docstring`: "// Read at call time, not at module load, so tests can set env per case."};
