MERGE (n:R2G:`Symbol` {id: "sym:tests/test_export_hardening.py::test_version_matches_pyproject_in_this_checkout"}) SET n += {`id`: "sym:tests/test_export_hardening.py::test_version_matches_pyproject_in_this_checkout", `name`: "test_version_matches_pyproject_in_this_checkout", `qualname`: "test_version_matches_pyproject_in_this_checkout", `kind`: "function", `path`: "tests/test_export_hardening.py", `lang`: "python", `start_line`: 44, `end_line`: 47, `signature`: "def test_version_matches_pyproject_in_this_checkout():", `docstring`: "Sanity: importing repo2graph from this tree reports pyproject.toml's\n    own version, not whatever happens to be registered as installed.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_export_hardening.py::test_version_resolves_from_source_checkout_over_stale_dist_info"}) SET n += {`id`: "sym:tests/test_export_hardening.py::test_version_resolves_from_source_checkout_over_stale_dist_info", `name`: "test_version_resolves_from_source_checkout_over_stale_dist_info", `qualname`: "test_version_resolves_from_source_checkout_over_stale_dist_info", `kind`: "function", `path`: "tests/test_export_hardening.py", `lang`: "python", `start_line`: 50, `end_line`: 62, `signature`: "def test_version_resolves_from_source_checkout_over_stale_dist_info(monkeypatch):", `docstring`: "The bug: a stale `pip install repo2graph==1.6.0` elsewhere on this\n    interpreter's path must not shadow the real version of a source checkout.\n\n    Detector proof: reverting repo2graph/__init__.py to\n    `importlib.metadata.version(\"repo2graph\")` with no checkout-first check\n    makes this fail (it returns the faked \"1.6.0\" instead of the real\n    version) -- confirmed by hand before landing this test.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_export_hardening.py::test_version_falls_back_to_dist_info_outside_a_checkout"}) SET n += {`id`: "sym:tests/test_export_hardening.py::test_version_falls_back_to_dist_info_outside_a_checkout", `name`: "test_version_falls_back_to_dist_info_outside_a_checkout", `qualname`: "test_version_falls_back_to_dist_info_outside_a_checkout", `kind`: "function", `path`: "tests/test_export_hardening.py", `lang`: "python", `start_line`: 65, `end_line`: 71, `signature`: "def test_version_falls_back_to_dist_info_outside_a_checkout(monkeypatch):", `docstring`: "No local pyproject.toml to read (a real installed package, e.g. a\n    wheel with no source tree alongside it) -- dist-info must still answer,\n    which is the \"keep the installed-package path correct\" half of #340.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_export_hardening.py::test_version_falls_back_to_static_literal_when_nothing_resolves"}) SET n += {`id`: "sym:tests/test_export_hardening.py::test_version_falls_back_to_static_literal_when_nothing_resolves", `name`: "test_version_falls_back_to_static_literal_when_nothing_resolves", `qualname`: "test_version_falls_back_to_static_literal_when_nothing_resolves", `kind`: "function", `path`: "tests/test_export_hardening.py", `lang`: "python", `start_line`: 74, `end_line`: 84, `signature`: "def test_version_falls_back_to_static_literal_when_nothing_resolves(monkeypatch):", `docstring`: "Neither a checkout's pyproject.toml nor dist-info answers (e.g. a\n    frozen/bundled build) -- the static literal at the top of __init__.py is\n    the last resort, never an exception escaping import.", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_export_hardening.py::test_version_falls_back_to_static_literal_when_nothing_resolves._raise"}) SET n += {`id`: "sym:tests/test_export_hardening.py::test_version_falls_back_to_static_literal_when_nothing_resolves._raise", `name`: "_raise", `qualname`: "test_version_falls_back_to_static_literal_when_nothing_resolves._raise", `kind`: "function", `path`: "tests/test_export_hardening.py", `lang`: "python", `start_line`: 80, `end_line`: 81, `signature`: "def _raise(name):", `docstring`: ""};
