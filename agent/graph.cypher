MERGE (n:R2G:`Symbol` {id: "sym:tests/test_properties.py::StrictStream"}) SET n += {`id`: "sym:tests/test_properties.py::StrictStream", `name`: "StrictStream", `qualname`: "StrictStream", `kind`: "class", `path`: "tests/test_properties.py", `lang`: "python", `start_line`: 141, `end_line`: 161, `signature`: "class StrictStream:", `docstring`: "A stream that really refuses what its codec cannot represent.\n\n    The honest model of a Windows `TextIOWrapper`, copied in spirit from\n    `tests/test_encoding.py`: a stream that accepts everything cannot catch a\n    guard which merely *believes* it made the text safe."};
