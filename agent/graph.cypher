MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::_fingerprint"}) SET n += {`id`: "sym:repo2graph/audit.py::_fingerprint", `name`: "_fingerprint", `qualname`: "_fingerprint", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 86, `end_line`: 89, `signature`: "def _fingerprint(value: str) -> str:", `docstring`: "A short, stable, non-reversible tag for a redacted value."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::redact"}) SET n += {`id`: "sym:repo2graph/audit.py::redact", `name`: "redact", `qualname`: "redact", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 92, `end_line`: 104, `signature`: "def redact(value: str, why: str) -> str:", `docstring`: "Replace a secret with a tag that is still useful in an investigation.\n\n    Args:\n        value: The secret.\n        why: What matched, e.g. \"github_token\" or \"key:password\".\n\n    Returns:\n        e.g. `\"[redacted:github_token len=40 fp=1a2b3c4d]\"`. The length and\n        fingerprint let an investigator correlate occurrences and spot a\n        rotation without the log ever holding the value itself."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::_looks_like_a_secret"}) SET n += {`id`: "sym:repo2graph/audit.py::_looks_like_a_secret", `name`: "_looks_like_a_secret", `qualname`: "_looks_like_a_secret", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 107, `end_line`: 120, `signature`: "def _looks_like_a_secret(value: str) -> str | None:", `docstring`: "Name the credential shape `value` matches, or None."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::sanitize_value"}) SET n += {`id`: "sym:repo2graph/audit.py::sanitize_value", `name`: "sanitize_value", `qualname`: "sanitize_value", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 123, `end_line`: 165, `signature`: "def sanitize_value(key: str, value: Any) -> Any:", `docstring`: "Redact one parameter value, recursing into containers.\n\n    Args:\n        key: The field name this value arrived under; matched against\n            SECRET_KEY_RE so a credential in an obviously-named field is caught\n            even when its shape is unremarkable.\n        value: Any JSON-compatible value.\n\n    Returns:\n        The value with anything secret-looking replaced, and long strings cut."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::sanitize_params"}) SET n += {`id`: "sym:repo2graph/audit.py::sanitize_params", `name`: "sanitize_params", `qualname`: "sanitize_params", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 168, `end_line`: 179, `signature`: "def sanitize_params(params: Any) -> dict[str, Any]:", `docstring`: "Sanitize a whole tool-argument mapping.\n\n    Args:\n        params: The arguments a caller sent, or anything else.\n\n    Returns:\n        A dict safe to write to a log that will be kept and shipped onward."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::_LockedAppender"}) SET n += {`id`: "sym:repo2graph/audit.py::_LockedAppender", `name`: "_LockedAppender", `qualname`: "_LockedAppender", `kind`: "class", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 182, `end_line`: 277, `signature`: "class _LockedAppender:", `docstring`: "Append-only writer that survives several processes sharing one file.\n\n    Locking is advisory and per-write: the lock is taken, one whole line is\n    written and flushed, and the lock is released. Two servers configured with\n    the same `--audit-log` therefore interleave whole records rather than\n    shredding each other's lines.\n\n    Args:\n        path: File to append to; created if absent."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::_LockedAppender.__init__"}) SET n += {`id`: "sym:repo2graph/audit.py::_LockedAppender.__init__", `name`: "__init__", `qualname`: "_LockedAppender.__init__", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 194, `end_line`: 200, `signature`: "def __init__(self, path: Any) -> None:", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::_LockedAppender.write"}) SET n += {`id`: "sym:repo2graph/audit.py::_LockedAppender.write", `name`: "write", `qualname`: "_LockedAppender.write", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 202, `end_line`: 216, `signature`: "def write(self, line: str) -> None:", `docstring`: "Append one line, holding an OS-level lock for the write."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::_LockedAppender._acquire"}) SET n += {`id`: "sym:repo2graph/audit.py::_LockedAppender._acquire", `name`: "_acquire", `qualname`: "_LockedAppender._acquire", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 218, `end_line`: 249, `signature`: "def _acquire(self) -> None:\n        # sys.platform branches, not a bare try/except ImportError: mypy checks\n        # each platform's CI job against that job's own sys.platform, so it\n        # statically knows the other branch is unreachable there and needs no\n        # ignore comment on either pla", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/audit.py::_LockedAppender._release"}) SET n += {`id`: "sym:repo2graph/audit.py::_LockedAppender._release", `name`: "_release", `qualname`: "_LockedAppender._release", `kind`: "function", `path`: "repo2graph/audit.py", `lang`: "python", `start_line`: 251, `end_line`: 271, `signature`: "def _release(self) -> None:", `docstring`: ""};
