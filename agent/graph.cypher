MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/schema.py::ManifestRecord"}) SET n += {`id`: "sym:repo2graph/schema.py::ManifestRecord", `name`: "ManifestRecord", `qualname`: "ManifestRecord", `kind`: "class", `path`: "repo2graph/schema.py", `lang`: "python", `start_line`: 265, `end_line`: 298, `signature`: "class ManifestRecord(TypedDict, total=False):", `docstring`: "`manifest.json`'s shape \u2014 see `export.write_manifest`, the single\n    place that writes it. Every key here is written unconditionally by that\n    function today; `total=False` is precautionary rather than a claim that\n    any of them are actually optional in a current build."};
