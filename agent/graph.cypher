MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rrf_weights.py::test_rrf_unweighted_default_matches_exact_formula"}) SET n += {`id`: "sym:tests/test_rrf_weights.py::test_rrf_unweighted_default_matches_exact_formula", `name`: "test_rrf_unweighted_default_matches_exact_formula", `qualname`: "test_rrf_unweighted_default_matches_exact_formula", `kind`: "function", `path`: "tests/test_rrf_weights.py", `lang`: "python", `start_line`: 46, `end_line`: 66, `signature`: "def test_rrf_unweighted_default_matches_exact_formula(tmp_path: Path):", `docstring`: "Default weights=(1.0, 1.0) must match standard RRF formula: 1/(K+r1) + 1/(K+r2).", `entrypoint`: true};
