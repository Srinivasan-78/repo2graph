MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::BuildConfig"}) SET n += {`id`: "sym:repo2graph/parse.py::BuildConfig", `name`: "BuildConfig", `qualname`: "BuildConfig", `kind`: "class", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 512, `end_line`: 544, `signature`: "class BuildConfig:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::grammar_fingerprint"}) SET n += {`id`: "sym:repo2graph/parse.py::grammar_fingerprint", `name`: "grammar_fingerprint", `qualname`: "grammar_fingerprint", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 570, `end_line`: 599, `signature`: "def grammar_fingerprint() -> str:", `docstring`: "Identity of the installed grammars, for the incremental parse cache key.\n\n    `PARSE_CACHE_FORMAT` is bumped by hand whenever *our* extraction changes, so\n    it catches every change we make and none that we don't. A tree-sitter\n    grammar upgrade is the second kind: the same source, parsed by a newer\n    grammar, can yield different node types and therefore different symbols,\n    calls and qualnames -- with `PARSE_CACHE_FORMAT` untouched, because nothing\n    in this repository changed. `--incremental` would then reuse entries\n    produced by the old grammar for every file whose bytes did not"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::lang_config_fingerprint"}) SET n += {`id`: "sym:repo2graph/parse.py::lang_config_fingerprint", `name`: "lang_config_fingerprint", `qualname`: "lang_config_fingerprint", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 603, `end_line`: 619, `signature`: "def lang_config_fingerprint() -> str:", `docstring`: "Digest of `LANG_CFG`, the node-type tables extraction is driven by.\n\n    Editing a kind map or a call-node list changes what every cached parse\n    would now contain, exactly like a grammar upgrade does, and is just as easy\n    to make without remembering to bump `PARSE_CACHE_FORMAT`."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::lang_config_fingerprint._norm"}) SET n += {`id`: "sym:repo2graph/parse.py::lang_config_fingerprint._norm", `name`: "_norm", `qualname`: "lang_config_fingerprint._norm", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 613, `end_line`: 616, `signature`: "def _norm(o: object) -> str | list[str]:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::parse_cache_identity"}) SET n += {`id`: "sym:repo2graph/parse.py::parse_cache_identity", `name`: "parse_cache_identity", `qualname`: "parse_cache_identity", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 622, `end_line`: 637, `signature`: "def parse_cache_identity(config: \"BuildConfig | None\") -> dict[str, str]:", `docstring`: "Everything besides a file's bytes that decides what its cached parse holds.\n\n    Compared field by field on load, so a mismatch can say which one changed."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::parser_for"}) SET n += {`id`: "sym:repo2graph/parse.py::parser_for", `name`: "parser_for", `qualname`: "parser_for", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 641, `end_line`: 666, `signature`: "def parser_for(lang: str) -> Parser | None:", `docstring`: "The parser for `lang`, or None if one cannot be obtained for any reason.\n\n    The except clause is deliberately broad. It used to name\n    `(LookupError, ValueError, ImportError, AttributeError)`, which covers what\n    tree-sitter-language-pack 0.x raises but not 1.x: that line raises its own\n    `DownloadError`, `ChecksumMismatchError`, `CacheLockError`,\n    `DynamicLoadError`, `ParserSetupError` and friends, all deriving from a\n    private `tree_sitter_language_pack.exceptions.Error` rather than from\n    anything in the tuple. Offline, every one of those escaped `parser_for`\n    instead of a"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::Symbol"}) SET n += {`id`: "sym:repo2graph/parse.py::Symbol", `name`: "Symbol", `qualname`: "Symbol", `kind`: "class", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 670, `end_line`: 699, `signature`: "class Symbol:", `docstring`: ""};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::symbol_key"}) SET n += {`id`: "sym:repo2graph/parse.py::symbol_key", `name`: "symbol_key", `qualname`: "symbol_key", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 702, `end_line`: 710, `signature`: "def symbol_key(sym: Symbol) -> str:", `docstring`: "The part of a symbol's node id after `sym:<path>::`.\n\n    Equal to `qualname` for every first definition of a name in a file; a later\n    definition with the same qualname (Java/C#/Kotlin/Swift/C++ overloads, a\n    Python conditional redefinition) carries `@L<line>` so it gets a node and\n    a chunk of its own instead of silently collapsing into the first one."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::symbol_parent_key"}) SET n += {`id`: "sym:repo2graph/parse.py::symbol_parent_key", `name`: "symbol_parent_key", `qualname`: "symbol_parent_key", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 713, `end_line`: 715, `signature`: "def symbol_parent_key(sym: Symbol) -> str | None:", `docstring`: "The `symbol_key` of the enclosing symbol, or None for a file-level one."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/parse.py::disambiguate_key"}) SET n += {`id`: "sym:repo2graph/parse.py::disambiguate_key", `name`: "disambiguate_key", `qualname`: "disambiguate_key", `kind`: "function", `path`: "repo2graph/parse.py", `lang`: "python", `start_line`: 718, `end_line`: 733, `signature`: "def disambiguate_key(qualname: str, line: int, used: set[str]) -> str:", `docstring`: "Empty string if `qualname` is still free in `used`, else a stable `@L<line>` key.\n\n    Deterministic: depends only on source order and line numbers. Two same-named\n    definitions on one line (minified code) fall back to `@L<line>~<n>`."};
