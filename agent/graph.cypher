MERGE (n:R2G:Symbol {id: "sym:repo2graph/tasks.py::BuildTask.progress_pct"}) SET n += {`id`: "sym:repo2graph/tasks.py::BuildTask.progress_pct", `name`: "progress_pct", `qualname`: "BuildTask.progress_pct", `kind`: "function", `path`: "repo2graph/tasks.py", `lang`: "python", `start_line`: 75, `end_line`: 83, `signature`: "def progress_pct(self) -> int:", `docstring`: "Completion estimate, 0-100. Never reaches 100 while still building."};
