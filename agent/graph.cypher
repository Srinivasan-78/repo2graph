MERGE (n:R2G:Symbol {id: "sym:repo2graph/embed.py::_npy_header"}) SET n += {`id`: "sym:repo2graph/embed.py::_npy_header", `name`: "_npy_header", `qualname`: "_npy_header", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 51, `end_line`: 56, `signature`: "def _npy_header(rows: int, cols: int) -> bytes:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/embed.py::_npy_write"}) SET n += {`id`: "sym:repo2graph/embed.py::_npy_write", `name`: "_npy_write", `qualname`: "_npy_write", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 59, `end_line`: 68, `signature`: "def _npy_write(path: Path, rows: list, cols: int) -> None:", `docstring`: "Write `rows` (a list of equal-length float sequences) as NPY v1.0.\n\n    Opened \"wb\" with no encoding: a text-mode write on Windows rewrites every\n    0x0A inside the binary payload and corrupts the file silently."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/embed.py::_npy_read"}) SET n += {`id`: "sym:repo2graph/embed.py::_npy_read", `name`: "_npy_read", `qualname`: "_npy_read", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 71, `end_line`: 123, `signature`: "def _npy_read(path: Path) -> tuple[list, int]:", `docstring`: "Read a 2-D C-order '<f4' NPY file; returns (rows, cols).\n\n    Anything else -- a different dtype, Fortran order, a truncated header or a\n    short payload -- is a ValueError, which load_vectors turns into \"no\n    vectors\" rather than an exception in the middle of a query."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/embed.py::meta_path"}) SET n += {`id`: "sym:repo2graph/embed.py::meta_path", `name`: "meta_path", `qualname`: "meta_path", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 129, `end_line`: 132, `signature`: "def meta_path(path) -> Path:", `docstring`: "'.../vectors.npy' -> '.../vectors.meta.json' (a sibling, same stem)."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/embed.py::text_hash"}) SET n += {`id`: "sym:repo2graph/embed.py::text_hash", `name`: "text_hash", `qualname`: "text_hash", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 135, `end_line`: 139, `signature`: "def text_hash(chunk) -> str:", `docstring`: "sha256 of a chunk's text. A chunk's vector depends on nothing else, so\n    this is a sound reuse key even when the surrounding graph changed."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/embed.py::model_id_of"}) SET n += {`id`: "sym:repo2graph/embed.py::model_id_of", `name`: "model_id_of", `qualname`: "model_id_of", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 142, `end_line`: 148, `signature`: "def model_id_of(embedder) -> str:", `docstring`: "A stable identity for whatever produced an index's vectors."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/embed.py::dim_of"}) SET n += {`id`: "sym:repo2graph/embed.py::dim_of", `name`: "dim_of", `qualname`: "dim_of", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 151, `end_line`: 157, `signature`: "def dim_of(embedder, probe: str = \"dimension probe\") -> int:", `docstring`: "The width of an embedder's output, without assuming an attribute."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/embed.py::build_vectors"}) SET n += {`id`: "sym:repo2graph/embed.py::build_vectors", `name`: "build_vectors", `qualname`: "build_vectors", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 163, `end_line`: 191, `signature`: "def build_vectors(\n    chunks, embedder, batch: int = DEFAULT_BATCH, reuse=None\n) -> dict[str, list[float]]:", `docstring`: "{chunk id: vector} for every chunk, embedding in batches.\n\n    `reuse` is an optional {chunk id: vector} of vectors already known to be\n    current (see cli.cmd_embed); those chunks are never handed to the embedder."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/embed.py::write_vectors"}) SET n += {`id`: "sym:repo2graph/embed.py::write_vectors", `name`: "write_vectors", `qualname`: "write_vectors", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 194, `end_line`: 231, `signature`: "def write_vectors(\n    path, vectors, model_id: str, dim: int, chunk_ids, text_hashes=None, build_id: str | None = None\n) -> int:", `docstring`: "Write vectors.npy plus its sibling vectors.meta.json; return the count.\n\n    Row order is `chunk_ids` order, which is chunks.jsonl order, so re-running\n    `embed` over an unchanged index reproduces the file byte for byte.\n\n    `build_id` is the manifest build_id for the index these vectors were built\n    against; stored so `verify_artifacts` and `doctor` can detect when a rebuild\n    has produced a new manifest build_id but `embed` has not been re-run."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/embed.py::load_vectors"}) SET n += {`id`: "sym:repo2graph/embed.py::load_vectors", `name`: "load_vectors", `qualname`: "load_vectors", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 234, `end_line`: 276, `signature`: "def load_vectors(path) -> tuple[dict[str, list[float]], dict]:", `docstring`: "Inverse of write_vectors: ({chunk id: vector}, meta).\n\n    Raises ValueError/OSError on anything malformed; callers that must not fail\n    (query.Index) catch both and fall back to BM25."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/embed.py::_SentenceTransformerEmbedder"}) SET n += {`id`: "sym:repo2graph/embed.py::_SentenceTransformerEmbedder", `name`: "_SentenceTransformerEmbedder", `qualname`: "_SentenceTransformerEmbedder", `kind`: "class", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 282, `end_line`: 291, `signature`: "class _SentenceTransformerEmbedder:", `docstring`: "Adapter: sentence-transformers' ndarray output -> plain float lists."};
