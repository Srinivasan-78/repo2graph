MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/bugreport.py::_scrub"}) SET n += {`id`: "sym:repo2graph/bugreport.py::_scrub", `name`: "_scrub", `qualname`: "_scrub", `kind`: "function", `path`: "repo2graph/bugreport.py", `lang`: "python", `start_line`: 93, `end_line`: 108, `signature`: "def _scrub(text: str) -> str:", `docstring`: "Redact anything path-shaped out of free-text prose bound for the bundle.\n\n    Notes and check summaries are prose assembled elsewhere -- several of them\n    interpolate an exception message, and an `OSError` carries the absolute\n    path that failed. `compute_freshness`'s \"could not re-discover the source\n    tree ({exc})\" was a live example: it put\n    `C:\\\\Users\\\\<name>\\\\proj\\\\pkg\\\\secret_roadmap.py` into a bundle that\n    promises no absolute paths and no filenames.\n\n    Scrubbing here rather than fixing each producer is deliberate. The\n    guarantee has to hold for prose written by code th"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/bugreport.py::_scrub_all"}) SET n += {`id`: "sym:repo2graph/bugreport.py::_scrub_all", `name`: "_scrub_all", `qualname`: "_scrub_all", `kind`: "function", `path`: "repo2graph/bugreport.py", `lang`: "python", `start_line`: 111, `end_line`: 113, `signature`: "def _scrub_all(items: Any) -> Any:", `docstring`: "`_scrub` over a list of strings, preserving order."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/bugreport.py::_fingerprint"}) SET n += {`id`: "sym:repo2graph/bugreport.py::_fingerprint", `name`: "_fingerprint", `qualname`: "_fingerprint", `kind`: "function", `path`: "repo2graph/bugreport.py", `lang`: "python", `start_line`: 116, `end_line`: 124, `signature`: "def _fingerprint(value: str) -> str:", `docstring`: "A short, stable, non-reversible tag for a string we will not print.\n\n    Lets a maintainer see that two entries are the same path without learning\n    what it is, and lets a user confirm a specific file is represented. Eight\n    hex characters: enough to distinguish the handful of paths in a report,\n    far too few to brute-force a filesystem from."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/bugreport.py::_safe_environment"}) SET n += {`id`: "sym:repo2graph/bugreport.py::_safe_environment", `name`: "_safe_environment", `qualname`: "_safe_environment", `kind`: "function", `path`: "repo2graph/bugreport.py", `lang`: "python", `start_line`: 127, `end_line`: 161, `signature`: "def _safe_environment() -> dict[str, Any]:", `docstring`: "Versions and platform. No environment variable values, ever."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/bugreport.py::_index_summary"}) SET n += {`id`: "sym:repo2graph/bugreport.py::_index_summary", `name`: "_index_summary", `qualname`: "_index_summary", `kind`: "function", `path`: "repo2graph/bugreport.py", `lang`: "python", `start_line`: 164, `end_line`: 212, `signature`: "def _index_summary(out: Path, repo: Path | None, include_paths: bool) -> dict[str, Any]:", `docstring`: "Shape and health of the index, with provenance narrowed to what helps."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/bugreport.py::_edge_quality"}) SET n += {`id`: "sym:repo2graph/bugreport.py::_edge_quality", `name`: "_edge_quality", `qualname`: "_edge_quality", `kind`: "function", `path`: "repo2graph/bugreport.py", `lang`: "python", `start_line`: 215, `end_line`: 275, `signature`: "def _edge_quality(out: Path) -> dict[str, Any]:", `docstring`: "How much of the graph is confident, and how it was extracted.\n\n    This is the single most useful block for an \"incorrect relationship\"\n    report: it says whether the repository as a whole resolves cleanly or is\n    dominated by ambiguous name matches, which changes what the reported edge\n    means. Counts only -- no ids, no paths."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/bugreport.py::_doctor_summary"}) SET n += {`id`: "sym:repo2graph/bugreport.py::_doctor_summary", `name`: "_doctor_summary", `qualname`: "_doctor_summary", `kind`: "function", `path`: "repo2graph/bugreport.py", `lang`: "python", `start_line`: 278, `end_line`: 304, `signature`: "def _doctor_summary() -> dict[str, Any]:", `docstring`: "Every check's name and status, and remediations. No detail lines.\n\n    The detail lines are where doctor prints filesystem paths and config file\n    locations, so they are dropped wholesale rather than filtered one by one\n    -- a filter that has to be kept in step with another module's output is a\n    leak waiting for the next check to be added."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/bugreport.py::build_report"}) SET n += {`id`: "sym:repo2graph/bugreport.py::build_report", `name`: "build_report", `qualname`: "build_report", `kind`: "function", `path`: "repo2graph/bugreport.py", `lang`: "python", `start_line`: 307, `end_line`: 334, `signature`: "def build_report(\n    out: Path | str = \".r2g\",\n    *,\n    repo: Path | str | None = None,\n    category: str | None = None,\n    include_paths: bool = False,\n) -> dict[str, Any]:", `docstring`: "Assemble the bundle. Never reads a source file."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/bugreport.py::format_report"}) SET n += {`id`: "sym:repo2graph/bugreport.py::format_report", `name`: "format_report", `qualname`: "format_report", `kind`: "function", `path`: "repo2graph/bugreport.py", `lang`: "python", `start_line`: 337, `end_line`: 403, `signature`: "def format_report(report: dict[str, Any]) -> str:", `docstring`: "The markdown a user pastes into an issue."};
