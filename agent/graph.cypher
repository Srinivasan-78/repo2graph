MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::parse_action_block"}) SET n += {`id`: "sym:tests/test_compat.py::parse_action_block", `name`: "parse_action_block", `qualname`: "parse_action_block", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 275, `end_line`: 304, `signature`: "def parse_action_block(text: str, block: str) -> dict:", `docstring`: "The `inputs:` or `outputs:` mapping of action.yml, without PyYAML.\n\n    action.yml's two declaration blocks are a flat two-level mapping of plain\n    scalars, so a deliberately small parser covers them exactly. It is\n    cross-checked against PyYAML in test_ac8_hand_parser_agrees_with_pyyaml\n    whenever PyYAML happens to be installed, and the suite does not require it\n    -- `pip install repo2graph[dev]` is pytest + ruff and nothing else."};
MERGE (n:R2G:Symbol {id: "sym:tests/test_compat.py::test_ac8_hand_parser_agrees_with_pyyaml"}) SET n += {`id`: "sym:tests/test_compat.py::test_ac8_hand_parser_agrees_with_pyyaml", `name`: "test_ac8_hand_parser_agrees_with_pyyaml", `qualname`: "test_ac8_hand_parser_agrees_with_pyyaml", `kind`: "function", `path`: "tests/test_compat.py", `lang`: "python", `start_line`: 307, `end_line`: 323, `signature`: "def test_ac8_hand_parser_agrees_with_pyyaml():", `docstring`: "AC-8 (guard): the hand parser is not quietly wrong.", `entrypoint`: true, `reach`: 14};
