MERGE (n:R2G:`Symbol` {id: "sym:tests/test_http_hardening.py::test_forwarded_for_is_ignored_by_default"}) SET n += {`id`: "sym:tests/test_http_hardening.py::test_forwarded_for_is_ignored_by_default", `name`: "test_forwarded_for_is_ignored_by_default", `qualname`: "test_forwarded_for_is_ignored_by_default", `kind`: "function", `path`: "tests/test_http_hardening.py", `lang`: "python", `start_line`: 628, `end_line`: 650, `signature`: "def test_forwarded_for_is_ignored_by_default(make_server, index):", `docstring`: "#267: trust_proxy defaults False -- X-Forwarded-For never changes the\n    client identity used for rate limiting, so two \"different\" forwarded\n    values from the same real peer share one bucket.", `entrypoint`: true, `reach`: 57};
