MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/scip.py::ScipResolver.base"}) SET n += {`id`: "sym:repo2graph/scip.py::ScipResolver.base", `name`: "base", `qualname`: "ScipResolver.base", `kind`: "function", `path`: "repo2graph/scip.py", `lang`: "python", `start_line`: 750, `end_line`: 803, `signature`: "def base(self, rel: str, sid: str, sym: Symbol, base: str, subtype: str, raw_base: str) -> bool:", `docstring`: "Resolve one base of class `sym`; True when the index decided it.\n\n        An in-repo base gets an INHERITS edge at confidence 1.0, carrying the\n        same `subtype`/`raw_base`/evidence the heuristic edge would have; a\n        base defined in no indexed file gets none, exactly as an unresolved\n        base does. False leaves the base to the heuristic."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/scip.py::ScipResolver.for_build"}) SET n += {`id`: "sym:repo2graph/scip.py::ScipResolver.for_build", `name`: "for_build", `qualname`: "ScipResolver.for_build", `kind`: "function", `path`: "repo2graph/scip.py", `lang`: "python", `start_line`: 806, `end_line`: 837, `signature`: "def for_build(\n        cls, source: str | None, g: GraphLike, parsed: Mapping[str, ParsedFile]\n    ) -> ScipResolver | None:", `docstring`: "Load `source` for `graph.build`, or None to resolve by name alone.\n\n        None, and nothing recorded, when no index was asked for. An index that\n        cannot be read or decoded is reported -- a warning line and a\n        structured `scip_index_rejected` event on stderr, `scip_error` in\n        stats.json -- and the build carries on with heuristic edges only."};
