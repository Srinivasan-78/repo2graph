MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_cy"}) SET n += {`id`: "sym:repo2graph/export.py::_cy", `name`: "_cy", `qualname`: "_cy", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 471, `end_line`: 472, `signature`: "def _cy(v: Any) -> str:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_cy_key"}) SET n += {`id`: "sym:repo2graph/export.py::_cy_key", `name`: "_cy_key", `qualname`: "_cy_key", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 475, `end_line`: 480, `signature`: "def _cy_key(k: str) -> str:\n    # Always backtick-quote: covers Cypher reserved words (order, match, where,\n    # distinct, ...) and any other non-bare-identifier-safe key. Doubling an\n    # embedded backtick is Cypher's own escape for it inside a quoted\n    # identifier, so a key containing one can", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::write_cypher"}) SET n += {`id`: "sym:repo2graph/export.py::write_cypher", `name`: "write_cypher", `qualname`: "write_cypher", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 483, `end_line`: 504, `signature`: "def write_cypher(g: \"Graph\", path: Path) -> None:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::write_overview"}) SET n += {`id`: "sym:repo2graph/export.py::write_overview", `name`: "write_overview", `qualname`: "write_overview", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 507, `end_line`: 539, `signature`: "def write_overview(g: \"Graph\", path: Path, top: int = 25) -> None:", `docstring`: "Human/LLM-readable repo map: top directories, hub files, entry points."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_git_short_sha"}) SET n += {`id`: "sym:repo2graph/export.py::_git_short_sha", `name`: "_git_short_sha", `qualname`: "_git_short_sha", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 542, `end_line`: 572, `signature`: "def _git_short_sha(root: Path | str) -> str | None:", `docstring`: "The short commit `root` was built at, or None outside a git repo.\n\n    Same subprocess pattern as graph.add_cochange / walker._git_files (see\n    AGENTS.md): quotepath=false, bytes decoded with surrogateescape (never\n    text=True -- a Windows cp1252 locale raises UnicodeDecodeError on any\n    non-ASCII byte), stdin closed, bounded timeout. Any failure -- not a repo,\n    no git on PATH, a slow filesystem -- just omits the \"Built at\" row."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::write_overview_human"}) SET n += {`id`: "sym:repo2graph/export.py::write_overview_human", `name`: "write_overview_human", `qualname`: "write_overview_human", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 585, `end_line`: 684, `signature`: "def write_overview_human(g: \"Graph\", path: Path, top: int = 25) -> None:", `docstring`: "Structured, scannable repo map for `human/overview.md`.\n\n    Unlike `write_overview` (still the agent/overview.md prose, unchanged),\n    this reads edge-type and symbol-kind counts straight out of `g.stats`\n    rather than rescanning `g.nodes`/`g.edges`, per the repo convention that\n    `g.stats` is the single source of truth for those counts."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_fanout"}) SET n += {`id`: "sym:repo2graph/export.py::_fanout", `name`: "_fanout", `qualname`: "_fanout", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 796, `end_line`: 806, `signature`: "def _fanout(text: str, max_call_candidates: int) -> str:", `docstring`: "Substitute a build's fan-out limit into one manifest prose template.\n\n    `str.replace`, not `str.format`: these are prose strings that an editor may\n    well one day want a literal brace in (a JSON snippet, a dict example), and\n    `format` would raise KeyError on it here -- turning a typo in documentation\n    copy into a failed build. A template that loses its `{n}` degrades to a\n    sentence with no number, which the top-level `max_call_candidates` key\n    still answers."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::write_manifest"}) SET n += {`id`: "sym:repo2graph/export.py::write_manifest", `name`: "write_manifest", `qualname`: "write_manifest", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 809, `end_line`: 950, `signature`: "def write_manifest(\n    g: Any, path: Path, written: list[str], *, checksums: dict[str, Any] | None = None\n) -> None:", `docstring`: "Describe the agent-facing output so a reader needs no other docs.\n\n    `g` is `Any`, not `Graph`, on purpose: every read below is a defaulted\n    `getattr`, and the contract this function has always offered -- see the\n    `max_call_candidates` note -- is that anything quacking like a Graph is\n    accepted. Narrowing the annotation would document a promise it does not make."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_stats_extra"}) SET n += {`id`: "sym:repo2graph/export.py::_stats_extra", `name`: "_stats_extra", `qualname`: "_stats_extra", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 958, `end_line`: 1007, `signature`: "def _stats_extra(g: \"Graph\") -> dict[str, Any]:", `docstring`: "Additive stats.json fields, computed live from `g` at write time.\n\n    Never re-read from nodes.jsonl/edges.jsonl -- dump_all always has the\n    Graph in memory here, and re-deriving from the files it is about to write\n    would be a circular dependency for no reason."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_mark_has_vectors"}) SET n += {`id`: "sym:repo2graph/export.py::_mark_has_vectors", `name`: "_mark_has_vectors", `qualname`: "_mark_has_vectors", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1010, `end_line`: 1027, `signature`: "def _mark_has_vectors(outdir: Path | str) -> None:", `docstring`: "Flip stats.json's has_vectors to True after `embed` writes vectors.npy.\n\n    Best-effort, same as register_written: a missing or unreadable stats.json\n    (e.g. a fixture built with --formats that never writes one) is not\n    embed's problem to fix, so any failure here is silently skipped."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::register_written"}) SET n += {`id`: "sym:repo2graph/export.py::register_written", `name`: "register_written", `qualname`: "register_written", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1030, `end_line`: 1072, `signature`: "def register_written(outdir: Path | str, names: Iterable[str]) -> bool:", `docstring`: "Merge `names` into an existing manifest's `written`, `files`, and `checksums`.\n\n    `embed` runs after `build` as a separate command, so it must append to the\n    manifest dump_all already wrote rather than rewrite it: every other key --\n    counts, entrypoints, how_to_read -- is left exactly as it was. Returns\n    False when there is no readable manifest to append to."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::write_state"}) SET n += {`id`: "sym:repo2graph/export.py::write_state", `name`: "write_state", `qualname`: "write_state", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1075, `end_line`: 1083, `signature`: "def write_state(g: \"Graph\", path: Path, n_chunks: int) -> None:", `docstring`: "The per-file content hashes a later incremental build reads back."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::write_parse_cache"}) SET n += {`id`: "sym:repo2graph/export.py::write_parse_cache", `name`: "write_parse_cache", `qualname`: "write_parse_cache", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1086, `end_line`: 1101, `signature`: "def write_parse_cache(g: \"Graph\", path: Path) -> None:", `docstring`: "Write the per-file parse cache the next `--incremental` build reads.\n\n    Args:\n        g: The Graph just built; its `parse_cache` is the payload.\n        path: Destination for `parse.cache.json`."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::load_parse_cache"}) SET n += {`id`: "sym:repo2graph/export.py::load_parse_cache", `name`: "load_parse_cache", `qualname`: "load_parse_cache", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1104, `end_line`: 1129, `signature`: "def load_parse_cache(outdir: Path) -> dict[str, Any]:", `docstring`: "Read a previous build's parse cache out of an index directory.\n\n    Every failure mode -- no index, no cache file, unreadable, malformed JSON,\n    a format bump -- returns an empty dict, which makes the next build a full\n    one. An incremental build that silently reuses entries it does not\n    understand is the failure this whole feature was deferred to avoid, so the\n    only safe response to an unrecognised cache is to ignore it.\n\n    Args:\n        outdir: The index directory (the one holding `agent/`).\n\n    Returns:\n        `{relpath: entry}`, or an empty dict when no usable cache is presen"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_atomic_dir_swap"}) SET n += {`id`: "sym:repo2graph/export.py::_atomic_dir_swap", `name`: "_atomic_dir_swap", `qualname`: "_atomic_dir_swap", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1132, `end_line`: 1164, `signature`: "def _atomic_dir_swap(staging: Path, target: Path) -> None:", `docstring`: "Atomically replace target directory with staging directory.\n\n    On Windows, os.replace doesn't work for non-empty directories, so we use\n    a rename dance: target -> backup, staging -> target, then remove backup.\n    If the staging rename fails, we restore the backup."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::dump_all"}) SET n += {`id`: "sym:repo2graph/export.py::dump_all", `name`: "dump_all", `qualname`: "dump_all", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1176, `end_line`: 1269, `signature`: "def dump_all(\n    g: \"Graph\",\n    chunks: Iterable[Record] | None,\n    outdir: Path,\n    formats: set[str],\n    viz_nodes: int = MAX_NODES,\n) -> tuple[list[str], int]:", `docstring`: "Write the requested artifacts. `chunks` is an iterable of chunk dicts (a\n    build_chunks generator) or None. Returns (written_paths, chunk_count).\n\n    Artifacts are staged in a sibling directory and atomically swapped into\n    outdir on success; a failed or interrupted build never leaves a partial\n    index behind."};
