MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::_chunk_and_parse"}) SET n += {`id`: "sym:repo2graph/graph.py::_chunk_and_parse", `name`: "_chunk_and_parse", `qualname`: "_chunk_and_parse", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 277, `end_line`: 345, `signature`: "def _chunk_and_parse(rel, abspath, lang, config, size):", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::_read_and_parse"}) SET n += {`id`: "sym:repo2graph/graph.py::_read_and_parse", `name`: "_read_and_parse", `qualname`: "_read_and_parse", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 348, `end_line`: 381, `signature`: "def _read_and_parse(item):", `docstring`: "Read one file and parse it if it is code.\n\n    Top level, and returns only counts plus the ParsedFile, so a process pool\n    can pickle both the call and its result. The fourth element of the read\n    tuple is the sha256 of the bytes just parsed: it is computed here because\n    this is the only place that holds them, and build() never keeps them."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::cache_entry"}) SET n += {`id`: "sym:repo2graph/graph.py::cache_entry", `name`: "cache_entry", `qualname`: "cache_entry", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 393, `end_line`: 422, `signature`: "def cache_entry(lang: str | None, size: int, lines: int, pf, digest: str) -> dict:", `docstring`: "Serialise one file's parse result for `parse.cache.json`.\n\n    Args:\n        lang: Language id the file was parsed as, or None for a non-code file.\n        size: Length in bytes of the file as indexed.\n        lines: Newline count + 1, as recorded on the file node.\n        pf: The `ParsedFile` for this file, or None if it was not parsed.\n        digest: sha256 hex digest of the bytes this entry describes.\n\n    Returns:\n        A JSON-serialisable dict holding everything `build()` needs to rebuild\n        this file's nodes and edges without re-reading or re-parsing it."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::entry_read"}) SET n += {`id`: "sym:repo2graph/graph.py::entry_read", `name`: "entry_read", `qualname`: "entry_read", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 425, `end_line`: 454, `signature`: "def entry_read(entry: dict) -> tuple | None:", `docstring`: "Rebuild `_read_and_parse`'s result tuple from a cache entry.\n\n    Args:\n        entry: One record out of `parse.cache.json`.\n\n    Returns:\n        The `(size, lines, ParsedFile | None, digest)` tuple the build loop\n        consumes, or None if the entry is malformed. A malformed entry is a\n        cache miss, never an exception: a corrupt cache must cost a re-parse,\n        not the build."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::parse_incremental"}) SET n += {`id`: "sym:repo2graph/graph.py::parse_incremental", `name`: "parse_incremental", `qualname`: "parse_incremental", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 457, `end_line`: 513, `signature`: "def parse_incremental(files, jobs: int, cache: dict, counts: dict, config=None):", `docstring`: "Read every file, but re-parse only the ones whose bytes changed.\n\n    A file's `ParsedFile` is a pure function of its bytes and its language and\n    nothing else, so reusing one for a file whose sha256 still matches is exact\n    -- not an approximation. Everything downstream of parsing (the global name\n    index, CALLS confidences, INHERITS, entrypoints and reach) is then recomputed\n    from scratch over the full symbol set by `build()`, which is what makes an\n    incremental build byte-identical to a full one instead of merely close.\n\n    Reading is still done for every file: the hash *is* th"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::resolve_jobs"}) SET n += {`id`: "sym:repo2graph/graph.py::resolve_jobs", `name`: "resolve_jobs", `qualname`: "resolve_jobs", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 516, `end_line`: 520, `signature`: "def resolve_jobs(jobs: int) -> int:", `docstring`: "0 means one worker per core, capped so the parent keeps up with results."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::parse_all"}) SET n += {`id`: "sym:repo2graph/graph.py::parse_all", `name`: "parse_all", `qualname`: "parse_all", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 523, `end_line`: 547, `signature`: "def parse_all(files, jobs: int, config=None):", `docstring`: "Read and parse every file, in discovery order, across `jobs` processes.\n\n    tree-sitter parsing is CPU bound and dominates a large build, so this is\n    the difference between one core and all of them. Order is preserved, which\n    keeps node ids and edge order identical to a serial run."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::build"}) SET n += {`id`: "sym:repo2graph/graph.py::build", `name`: "build", `qualname`: "build", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 551, `end_line`: 784, `signature`: "def build(\n    root: Path,\n    include=None,\n    exclude=None,\n    git_history: int = 0,\n    max_files: int = 0,\n    jobs: int = 0,\n    cache: dict | None = None,\n    max_call_candidates: int = 5,\n    config=None,\n) -> Graph:", `docstring`: "Parse `root` into a Graph.\n\n    Args:\n        root: Repository directory to index.\n        include: Optional glob(s) restricting discovery.\n        exclude: Optional glob(s) removing paths from discovery.\n        git_history: When non-zero, add CO_CHANGE edges from the last N commits.\n        max_files: When positive, index only the first N discovered files.\n        jobs: Parser processes; 0 means one per core, 1 means serial.\n        cache: A previous build's `{relpath: entry}` parse cache. When given,\n            files whose sha256 and language both still match are not re-parsed.\n           "};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::mark_entrypoints"}) SET n += {`id`: "sym:repo2graph/graph.py::mark_entrypoints", `name`: "mark_entrypoints", `qualname`: "mark_entrypoints", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 791, `end_line`: 824, `signature`: "def mark_entrypoints(g: Graph):", `docstring`: "Flag the call-graph roots: symbols nothing else in the repo calls.\n\n    Those are the doors into a codebase \u2014 CLI commands, request handlers, test\n    bodies, public API \u2014 and they are where a reader tracing a flow has to\n    start. A symbol nested inside a function is skipped: an uncalled closure is\n    dead weight, not a door. `reach` (how many symbols the root can reach\n    through CALLS) is filled in for the busiest roots only, so ranking them\n    stays cheap on a big repo."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::_reach"}) SET n += {`id`: "sym:repo2graph/graph.py::_reach", `name`: "_reach", `qualname`: "_reach", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 827, `end_line`: 835, `signature`: "def _reach(start: str, out: dict) -> int:", `docstring`: "How many distinct symbols `start` reaches through CALLS edges."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/graph.py::add_cochange"}) SET n += {`id`: "sym:repo2graph/graph.py::add_cochange", `name`: "add_cochange", `qualname`: "add_cochange", `kind`: "function", `path`: "repo2graph/graph.py", `lang`: "python", `start_line`: 838, `end_line`: 907, `signature`: "def add_cochange(g: Graph, root: Path, commits: int, file_index: set[str], min_pairs: int = 3):", `docstring`: "CO_CHANGE edges from files edited together in the last N commits."};
