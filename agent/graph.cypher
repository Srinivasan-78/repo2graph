MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::pick_provider"}) SET n += {`id`: "sym:repo2graph/answer.py::pick_provider", `name`: "pick_provider", `qualname`: "pick_provider", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 53, `end_line`: 82, `signature`: "def pick_provider(env=None, provider=None) -> dict | None:", `docstring`: "The configured provider, or first in GEMINI > OPENAI > ANTHROPIC > OLLAMA order."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::build_prompt"}) SET n += {`id`: "sym:repo2graph/answer.py::build_prompt", `name`: "build_prompt", `qualname`: "build_prompt", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 85, `end_line`: 95, `signature`: "def build_prompt(pack) -> tuple[str, str]:", `docstring`: "(system, user). The user turn carries the whole pack, verbatim."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_request"}) SET n += {`id`: "sym:repo2graph/answer.py::_request", `name`: "_request", `qualname`: "_request", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 98, `end_line`: 158, `signature`: "def _request(spec: dict, model: str | None, system: str, user: str):", `docstring`: "(url, headers, payload) for the chosen provider's streaming endpoint."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_ollama_base"}) SET n += {`id`: "sym:repo2graph/answer.py::_ollama_base", `name`: "_ollama_base", `qualname`: "_ollama_base", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 161, `end_line`: 175, `signature`: "def _ollama_base(value: str) -> str:", `docstring`: "Normalise OLLAMA_HOST to an http(s) base URL.\n\n    `ollama serve` documents (and exports) the schemeless `127.0.0.1:11434`,\n    which urlopen rejects with `unknown url type: 127.0.0.1`. Default the\n    scheme to http and refuse anything that is not http(s), so a stray\n    `file://` value cannot turn into an urlopen target."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_delta"}) SET n += {`id`: "sym:repo2graph/answer.py::_delta", `name`: "_delta", `qualname`: "_delta", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 178, `end_line`: 200, `signature`: "def _delta(name: str, raw: bytes) -> str:", `docstring`: "One streamed line -> the text it carries, or '' if it carries none."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_writer"}) SET n += {`id`: "sym:repo2graph/answer.py::_writer", `name`: "_writer", `qualname`: "_writer", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 203, `end_line`: 227, `signature`: "def _writer(out=None):", `docstring`: "A write callable that cannot raise UnicodeEncodeError.\n\n    Always writes through the stream's own text-mode `write`, never through\n    `sys.stdout.buffer`: on Windows the console expects bytes in its active\n    codepage (cp1252, cp437, ...), and writing raw UTF-8 bytes straight to\n    the buffer bypasses `TextIOWrapper`'s console translation, producing\n    mojibake even though no exception is raised (#169). A non-ASCII token\n    from a model would otherwise abort the whole answer mid-sentence, so the\n    chunk is folded to what the stream's own encoding can represent first."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_writer.write_text"}) SET n += {`id`: "sym:repo2graph/answer.py::_writer.write_text", `name`: "write_text", `qualname`: "_writer.write_text", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 216, `end_line`: 225, `signature`: "def write_text(chunk: str) -> None:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_flush"}) SET n += {`id`: "sym:repo2graph/answer.py::_flush", `name`: "_flush", `qualname`: "_flush", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 230, `end_line`: 234, `signature`: "def _flush(stream) -> None:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_http_error"}) SET n += {`id`: "sym:repo2graph/answer.py::_http_error", `name`: "_http_error", `qualname`: "_http_error", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 237, `end_line`: 249, `signature`: "def _http_error(spec: dict, exc) -> str:", `docstring`: "A one-line explanation of a provider HTTP error, without its URL.\n\n    HTTPError.url can carry credentials for some providers, so it is never\n    echoed; the status and the provider's own message are enough to act on."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_empty_answer"}) SET n += {`id`: "sym:repo2graph/answer.py::_empty_answer", `name`: "_empty_answer", `qualname`: "_empty_answer", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 252, `end_line`: 274, `signature`: "def _empty_answer(spec: dict, raw_tail: list) -> str:", `docstring`: "Why a 200 response carried no answer text.\n\n    Ollama answers HTTP 200 with {\"error\": \"model 'x' not found\"}; without this\n    the command would print nothing and exit 0, which reads as a valid empty\n    answer."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::_disclose"}) SET n += {`id`: "sym:repo2graph/answer.py::_disclose", `name`: "_disclose", `qualname`: "_disclose", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 277, `end_line`: 307, `signature`: "def _disclose(name: str, env: str, url: str, n_chars: int) -> None:", `docstring`: "Tell the user, on stderr, where their repository content is going.\n\n    Takes the three scalars it prints rather than the provider `spec`, because\n    that dict also carries the resolved API key under \"value\". A logging\n    function has no business holding a credential even if it never prints it:\n    the only way to be sure a secret cannot be logged is for it not to be in\n    scope. This also clears CodeQL alert #1 (py/clear-text-logging-sensitive-data),\n    which flagged the whole-dict argument reaching a print.\n\n    The pack can contain any indexed file, `.env` included. stderr, not stdout:\n"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/answer.py::stream_answer"}) SET n += {`id`: "sym:repo2graph/answer.py::stream_answer", `name`: "stream_answer", `qualname`: "stream_answer", `kind`: "function", `path`: "repo2graph/answer.py", `lang`: "python", `start_line`: 310, `end_line`: 355, `signature`: "def stream_answer(pack, model=None, env=None, out=None, provider=None) -> str:", `docstring`: "Ask the configured provider and stream the answer out. Returns the text."};
MERGE (n:R2G:Module {id: "module:os"}) SET n += {`id`: "module:os", `name`: "os", `external`: true};
