MERGE (n:R2G:Symbol {id: "sym:repo2graph/cache.py::cache_metadata"}) SET n += {`id`: "sym:repo2graph/cache.py::cache_metadata", `name`: "cache_metadata", `qualname`: "cache_metadata", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 61, `end_line`: 70, `signature`: "def cache_metadata(method: str) -> dict[str, Any]:", `docstring`: "The `ttlMs`/`cacheScope` hints for one MCP method.\n\n    Args:\n        method: An MCP method name, e.g. \"tools/list\".\n\n    Returns:\n        The hint mapping, or an empty dict for a method with no hints."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cache.py::make_key"}) SET n += {`id`: "sym:repo2graph/cache.py::make_key", `name`: "make_key", `qualname`: "make_key", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 73, `end_line`: 93, `signature`: "def make_key(tool: str, params: Any) -> str:", `docstring`: "A total, stable cache key for one tool call.\n\n    Args:\n        tool: Tool name.\n        params: The caller's arguments.\n\n    Returns:\n        A string key. Equal arguments always produce equal keys, whatever the\n        insertion order, and no argument value can make this raise."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cache.py::ResultCache"}) SET n += {`id`: "sym:repo2graph/cache.py::ResultCache", `name`: "ResultCache", `qualname`: "ResultCache", `kind`: "class", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 96, `end_line`: 205, `signature`: "class ResultCache:", `docstring`: "A thread-safe LRU cache with per-entry expiry.\n\n    Args:\n        max_size: Entries kept before the least recently used is evicted. 0 or\n            less disables the cache entirely, which stays a valid configuration\n            rather than an error.\n        ttl: Seconds an entry may be served for.\n        clock: Monotonic time source, injected so tests can advance it without\n            sleeping."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cache.py::ResultCache.__init__"}) SET n += {`id`: "sym:repo2graph/cache.py::ResultCache.__init__", `name`: "__init__", `qualname`: "ResultCache.__init__", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 108, `end_line`: 121, `signature`: "def __init__(\n        self,\n        max_size: int = DEFAULT_MAX_SIZE,\n        ttl: float = DEFAULT_TTL,\n        clock: Callable[[], float] = time.monotonic,\n    ) -> None:", `docstring`: "", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cache.py::ResultCache.enabled"}) SET n += {`id`: "sym:repo2graph/cache.py::ResultCache.enabled", `name`: "enabled", `qualname`: "ResultCache.enabled", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 124, `end_line`: 126, `signature`: "def enabled(self) -> bool:", `docstring`: "False when the cache is configured away; every call is then a miss.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cache.py::ResultCache.get"}) SET n += {`id`: "sym:repo2graph/cache.py::ResultCache.get", `name`: "get", `qualname`: "ResultCache.get", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 128, `end_line`: 156, `signature`: "def get(self, key: str) -> Any:", `docstring`: "Return the cached value for `key`, or None when there is none.\n\n        An expired entry is dropped and counted as a miss, so a caller cannot\n        tell \"expired\" from \"never seen\" -- which is the point.\n\n        Args:\n            key: A key from `make_key`.\n\n        Returns:\n            The cached value, or None."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cache.py::ResultCache.put"}) SET n += {`id`: "sym:repo2graph/cache.py::ResultCache.put", `name`: "put", `qualname`: "ResultCache.put", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 158, `end_line`: 168, `signature`: "def put(self, key: str, value: Any) -> None:", `docstring`: "Store `value` under `key`, evicting the oldest entry if needed."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cache.py::ResultCache.clear"}) SET n += {`id`: "sym:repo2graph/cache.py::ResultCache.clear", `name`: "clear", `qualname`: "ResultCache.clear", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 170, `end_line`: 183, `signature`: "def clear(self) -> int:", `docstring`: "Drop every entry. Called whenever the index is rebuilt.\n\n        Counters are deliberately *not* reset: they describe the life of the\n        process, and zeroing them on every rebuild would hide exactly the churn\n        an operator is looking at them to find.\n\n        Returns:\n            How many entries were dropped."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/cache.py::ResultCache.stats"}) SET n += {`id`: "sym:repo2graph/cache.py::ResultCache.stats", `name`: "stats", `qualname`: "ResultCache.stats", `kind`: "function", `path`: "repo2graph/cache.py", `lang`: "python", `start_line`: 185, `end_line`: 205, `signature`: "def stats(self) -> dict[str, Any]:", `docstring`: "Counters for the `repo_cache_stats` tool.\n\n        Returns:\n            hits, misses, size, max_size and ttl_s, plus eviction and hit-rate\n            figures an operator needs to tell a working cache from a thrashing\n            one. A cache at max_size with a hit rate near zero is sized wrong,\n            and neither number says that alone."};
MERGE (n:R2G:Module {id: "module:collections.OrderedDict"}) SET n += {`id`: "module:collections.OrderedDict", `name`: "collections.OrderedDict", `external`: true};
MERGE (n:R2G:File {id: "file:repo2graph/changelog.py"}) SET n += {`id`: "file:repo2graph/changelog.py", `name`: "changelog.py", `path`: "repo2graph/changelog.py", `lang`: "python", `file_type`: "code", `size`: 8774, `lines`: 235, `parse_errors`: 0, `chunked`: false};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/changelog.py::previous_state"}) SET n += {`id`: "sym:repo2graph/changelog.py::previous_state", `name`: "previous_state", `qualname`: "previous_state", `kind`: "function", `path`: "repo2graph/changelog.py", `lang`: "python", `start_line`: 40, `end_line`: 65, `signature`: "def previous_state(\n    outdir: str | Path,\n) -> tuple[list[dict[str, Any]], list[dict[str, Any]]] | None:", `docstring`: "Snapshot the previous build's nodes/edges, or None if there is none.\n\n    Must be called before `export.dump_all` runs: `dump_all` overwrites\n    `agent/nodes.jsonl` and `agent/edges.jsonl` with the *new* build's data,\n    and by the time this function's return value is used the on-disk files no\n    longer hold what it needs to read.\n\n    Returns:\n        `(prev_nodes, prev_edges)` read from `agent/nodes.jsonl` and\n        `agent/edges.jsonl`, or None when either file is missing or\n        unreadable -- the \"no previous build\" case, which callers must render\n        as `INITIAL_MESSAGE` rather"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/changelog.py::_prev_commit_sha"}) SET n += {`id`: "sym:repo2graph/changelog.py::_prev_commit_sha", `name`: "_prev_commit_sha", `qualname`: "_prev_commit_sha", `kind`: "function", `path`: "repo2graph/changelog.py", `lang`: "python", `start_line`: 68, `end_line`: 84, `signature`: "def _prev_commit_sha(outdir: str | Path) -> str | None:", `docstring`: "A previously recorded commit sha, if one exists.\n\n    `agent/index.json` is written only by `repo2graph github`/`fetch.py`, so a\n    plain `repo2graph build` run over the same `-o` directory has usually never\n    recorded one; that is expected, not an error -- the header then shows only\n    the current sha."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/changelog.py::resolve_shas"}) SET n += {`id`: "sym:repo2graph/changelog.py::resolve_shas", `name`: "resolve_shas", `qualname`: "resolve_shas", `kind`: "function", `path`: "repo2graph/changelog.py", `lang`: "python", `start_line`: 87, `end_line`: 100, `signature`: "def resolve_shas(repo_path: str | Path, outdir: str | Path) -> tuple[str | None, str | None]:", `docstring`: "(current_short_sha, previous_short_sha) for the CHANGELOG.md header.\n\n    Call before `dump_all` writes a new `agent/index.json` (`build` itself\n    never writes one, but a directory reused from a prior `repo2graph github`\n    run might already carry one) -- same \"read the old state first\" ordering\n    as `previous_state`."};
