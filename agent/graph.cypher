MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::check_tree_sitter"}) SET n += {`id`: "sym:repo2graph/doctor.py::check_tree_sitter", `name`: "check_tree_sitter", `qualname`: "check_tree_sitter", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 232, `end_line`: 296, `signature`: "def check_tree_sitter() -> CheckResult:", `docstring`: "Check that grammars actually *load*, not merely that they are configured.\n\n    This used to report `len(LANG_CFG)` grammars \"configured\" and return \"ok\".\n    `LANG_CFG` is a dict literal in `parse.py`, so the count was a property of the\n    source code and the check could not fail for the thing it was named after: with\n    every grammar unloadable, doctor still said ok and `build` still exited 0 with an\n    empty graph. `parser_for()` swallows LookupError/ValueError/ImportError/\n    AttributeError and returns None, so \"no grammar\" and \"nothing to parse\" are\n    indistinguishable downstream unl"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::check_mcp_server"}) SET n += {`id`: "sym:repo2graph/doctor.py::check_mcp_server", `name`: "check_mcp_server", `qualname`: "check_mcp_server", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 299, `end_line`: 377, `signature`: "def check_mcp_server() -> CheckResult:", `docstring`: "Check that `repo2graph-mcp` could actually start, without launching it.\n\n    An MCP client reports a server that fails its SDK preflight as \"server failed\n    to start\" or simply shows no tools -- `server._require_sdk()` raises SystemExit\n    with an accurate message, and the client swallows it. That makes a wrong or\n    absent `mcp` SDK one of the setup failures users cannot diagnose from inside\n    their editor, which is the case for answering it here.\n\n    The version gate is imported from `mcp/server.py` rather than restated, so a\n    doctor that says \"ok\" and a server that refuses to star"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/doctor.py::check_permissions"}) SET n += {`id`: "sym:repo2graph/doctor.py::check_permissions", `name`: "check_permissions", `qualname`: "check_permissions", `kind`: "function", `path`: "repo2graph/doctor.py", `lang`: "python", `start_line`: 380, `end_line`: 406, `signature`: "def check_permissions(path: Path | str) -> CheckResult:", `docstring`: "Verify write permissions for the target directory."};
