MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::tool_annotations"}) SET n += {`id`: "sym:repo2graph/mcp.py::tool_annotations", `name`: "tool_annotations", `qualname`: "tool_annotations", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 169, `end_line`: 189, `signature`: "def tool_annotations(name: str, auto_build: bool) -> dict[str, object]:", `docstring`: "The annotation block for one tool on a server with this build capability.\n\n    The single place that decides between `TOOL_ANNOTATIONS` and\n    `TOOL_ANNOTATIONS_AUTO_BUILD`, including the title. Both transports call it\n    -- `get_tools()` for stdio and `http_server`'s `tools/list` handler -- for\n    the reason #349 exists: the HTTP handler used to assemble this block\n    itself, from the flat `TOOL_ANNOTATIONS` constant, so an HTTP server\n    explicitly started with auto-build on still advertised `readOnlyHint:\n    true`. Two copies of one decision drift, and this one drifts into a\n    disho"};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::ToolError"}) SET n += {`id`: "sym:repo2graph/mcp.py::ToolError", `name`: "ToolError", `qualname`: "ToolError", `kind`: "class", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 564, `end_line`: 573, `signature`: "class ToolError(str):", `docstring`: "A tool result that reports a failure rather than an answer.\n\n    Still a plain string to every caller that only reads text (dispatch() has\n    always returned one), but the stdio and HTTP transports check for it and\n    set the MCP result's `isError: true`, so a client can tell \"bad input /\n    unknown node / git failed\" from a real, possibly empty, answer."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/mcp.py::_index_lock"}) SET n += {`id`: "sym:repo2graph/mcp.py::_index_lock", `name`: "_index_lock", `qualname`: "_index_lock", `kind`: "function", `path`: "repo2graph/mcp.py", `lang`: "python", `start_line`: 601, `end_line`: 607, `signature`: "def _index_lock(key: str) -> threading.Lock:", `docstring`: "The lock covering one index directory, created on first use."};
