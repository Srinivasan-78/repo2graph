MERGE (n:R2G:`Symbol` {id: "sym:tests/test_viz_safety.py::test_the_settle_loop_is_incremental_not_a_blocking_while"}) SET n += {`id`: "sym:tests/test_viz_safety.py::test_the_settle_loop_is_incremental_not_a_blocking_while", `name`: "test_the_settle_loop_is_incremental_not_a_blocking_while", `qualname`: "test_the_settle_loop_is_incremental_not_a_blocking_while", `kind`: "function", `path`: "tests/test_viz_safety.py", `lang`: "python", `start_line`: 159, `end_line`: 170, `signature`: "def test_the_settle_loop_is_incremental_not_a_blocking_while(tmp_path):", `docstring`: "Layout must yield to the browser between batches.\n\n    A synchronous `while (alpha > ...) step()` blocks the main thread for the\n    whole settle: no paint, no input, no scroll. Bounding the iteration count\n    bounds the freeze but does not remove it.", `entrypoint`: true};
