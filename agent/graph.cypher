MERGE (n:R2G:`Symbol` {id: "sym:tests/test_auth.py::test_a_redirect_off_https_is_refused"}) SET n += {`id`: "sym:tests/test_auth.py::test_a_redirect_off_https_is_refused", `name`: "test_a_redirect_off_https_is_refused", `qualname`: "test_a_redirect_off_https_is_refused", `kind`: "function", `path`: "tests/test_auth.py", `lang`: "python", `start_line`: 892, `end_line`: 914, `signature`: "def test_a_redirect_off_https_is_refused():", `docstring`: "urlopen follows redirects; CPython's handler allows http, https and ftp.\n\n    Without this the scheme check in `_fetch_json` covers the first hop only,\n    and a 302 to http:// puts the signing keys on the wire in clear -- where\n    an on-path attacker substitutes their own modulus and mints tokens that\n    pass every remaining check in the module.", `entrypoint`: true};
