MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/embed.py::split_model_spec"}) SET n += {`id`: "sym:repo2graph/embed.py::split_model_spec", `name`: "split_model_spec", `qualname`: "split_model_spec", `kind`: "function", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 362, `end_line`: 372, `signature`: "def split_model_spec(spec: str) -> tuple[str, str | None]:", `docstring`: "`\"org/model@<commit>\"` -> `(\"org/model\", \"<commit>\")`; no `@` -> no revision.\n\n    A revision pins the download to one Hugging Face commit (#452). It stays\n    part of the model id recorded in `vectors.meta.json`, so the query side's\n    model check refuses any other revision of the same model."};
MERGE (n:R2G:`Symbol` {id: "sym:repo2graph/embed.py::_StaticEmbedder"}) SET n += {`id`: "sym:repo2graph/embed.py::_StaticEmbedder", `name`: "_StaticEmbedder", `qualname`: "_StaticEmbedder", `kind`: "class", `path`: "repo2graph/embed.py", `lang`: "python", `start_line`: 375, `end_line`: 389, `signature`: "class _StaticEmbedder:", `docstring`: "Adapter: model2vec's `StaticModel` -> plain float lists.\n\n    The same shape as `_SentenceTransformerEmbedder`, so `build_vectors`,\n    `model_id_of`, `embedder_dim` and `Index.fuse_ok` need no backend\n    awareness at all -- the `Embedder` protocol was already the seam."};
