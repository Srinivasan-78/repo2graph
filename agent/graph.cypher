MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_flat"}) SET n += {`id`: "sym:repo2graph/export.py::_flat", `name`: "_flat", `qualname`: "_flat", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 118, `end_line`: 121, `signature`: "def _flat(d: Mapping[str, Any]) -> dict[str, Any]:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::write_jsonl"}) SET n += {`id`: "sym:repo2graph/export.py::write_jsonl", `name`: "write_jsonl", `qualname`: "write_jsonl", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 124, `end_line`: 136, `signature`: "def write_jsonl(path: Path, rows: Iterable[Any]) -> int:", `docstring`: "Stream `rows` to `path` as JSONL; return how many were written.\n\n    newline=\"\\n\" (ISS-28) + atomic: a crash mid-write must not leave a truncated\n    last line that read_jsonl's json.loads then dies on. Streaming means `rows`\n    may be a generator (build_chunks) that is never fully materialised."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_grid_pairs"}) SET n += {`id`: "sym:repo2graph/export.py::_grid_pairs", `name`: "_grid_pairs", `qualname`: "_grid_pairs", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 153, `end_line`: 169, `signature`: "def _grid_pairs(pos: Mapping[str, Any], cell: float) -> Iterator[tuple[str, str]]:", `docstring`: "Yield the node pairs sitting within one grid cell of each other.\n\n    Every pair lands in the same bucket or in two adjacent ones, and each\n    unordered pair is yielded once: only four of the eight neighbouring cells\n    are scanned, the other four see the pair from their own side."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_spring"}) SET n += {`id`: "sym:repo2graph/export.py::_spring", `name`: "_spring", `qualname`: "_spring", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 172, `end_line`: 219, `signature`: "def _spring(\n    nodes: list[str], adjacency: list[tuple[str, str]], iterations: int\n) -> dict[str, Point]:", `docstring`: "Fruchterman-Reingold in pure Python: networkx's needs numpy, we do not.\n\n    Repulsion runs only between nodes less than 2k apart, bucketed on a grid.\n    Past that distance the k^2/d term moves a node by a rounding error, while\n    the all-pairs form costs O(n^2) per iteration and dominates big exports."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_shelf"}) SET n += {`id`: "sym:repo2graph/export.py::_shelf", `name`: "_shelf", `qualname`: "_shelf", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 222, `end_line`: 239, `signature`: "def _shelf(nodes: list[str], sizes: Mapping[str, Size], pad: float = 24.0) -> dict[str, Point]:", `docstring`: "Row-pack the boxes for graphs too big to force-lay-out in Python.\n\n    Rows are filled in node order, which keeps a file next to the symbols it\n    defines, and boxes cannot overlap, so no separation pass is needed."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_layout"}) SET n += {`id`: "sym:repo2graph/export.py::_layout", `name`: "_layout", `qualname`: "_layout", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 248, `end_line`: 278, `signature`: "def _layout(g: \"Graph\", sizes: Mapping[str, Size]) -> dict[str, Point]:", `docstring`: "Node positions in points, spread so labels do not collide."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_node_size"}) SET n += {`id`: "sym:repo2graph/export.py::_node_size", `name`: "_node_size", `qualname`: "_node_size", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 281, `end_line`: 284, `signature`: "def _node_size(label: str, degree: int) -> Size:", `docstring`: "Box a node needs: wide enough for its label, bigger for hubs."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_separate"}) SET n += {`id`: "sym:repo2graph/export.py::_separate", `name`: "_separate", `qualname`: "_separate", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 287, `end_line`: 327, `signature`: "def _separate(\n    pos: dict[str, Point], sizes: Mapping[str, Size], iterations: int\n) -> dict[str, Point]:", `docstring`: "Push overlapping boxes apart; the spring layout only knows points.\n\n    The grid cell is as wide as the widest box, so two overlapping boxes always\n    share a cell or sit in adjacent ones and no pair is missed."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_xml_safe"}) SET n += {`id`: "sym:repo2graph/export.py::_xml_safe", `name`: "_xml_safe", `qualname`: "_xml_safe", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 330, `end_line`: 345, `signature`: "def _xml_safe(text: str) -> str:", `docstring`: "Drop characters that are not legal in XML 1.0.\n\n    A C0 control char (\\x0b, \\x0c, \\x00) sitting in a docstring or signature\n    is written verbatim by ElementTree and then makes the file unparseable by\n    any conforming reader (ISS-27). Legal set: tab, LF, CR, >=0x20 minus the\n    surrogate block, up to 0x10FFFF, excluding 0xFFFE/0xFFFF."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::write_graphml"}) SET n += {`id`: "sym:repo2graph/export.py::write_graphml", `name`: "write_graphml", `qualname`: "write_graphml", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 348, `end_line`: 468, `signature`: "def write_graphml(g: \"Graph\", path: Path) -> None:", `docstring`: ""};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::write_graphml.key_for"}) SET n += {`id`: "sym:repo2graph/export.py::write_graphml.key_for", `name`: "key_for", `qualname`: "write_graphml.key_for", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 372, `end_line`: 391, `signature`: "def key_for(scope: str, name: str, value: Any) -> str:", `docstring`: ""};
