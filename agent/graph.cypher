MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss22_symbol_chunk_body_survives_unicode_line_separator"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss22_symbol_chunk_body_survives_unicode_line_separator", `name`: "test_iss22_symbol_chunk_body_survives_unicode_line_separator", `qualname`: "test_iss22_symbol_chunk_body_survives_unicode_line_separator", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1062, `end_line`: 1075, `signature`: "def test_iss22_symbol_chunk_body_survives_unicode_line_separator(tmp_path):", `docstring`: "AC-1 (ISS-22): a file whose first line holds U+2028 must still slice each\n    later symbol's chunk from the right source lines. At HEAD `splitlines()`\n    splits on U+2028 while tree-sitter row numbers do not, so the body comes out\n    as \"\\\\ndef uses_sep():\" and never contains \"return MSG\".", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss22_file_residual_excludes_symbol_body"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss22_file_residual_excludes_symbol_body", `name`: "test_iss22_file_residual_excludes_symbol_body", `qualname`: "test_iss22_file_residual_excludes_symbol_body", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1078, `end_line`: 1099, `signature`: "def test_iss22_file_residual_excludes_symbol_body(tmp_path):", `docstring`: "AC-2 (ISS-22): the residual chunk holds only lines no symbol claimed. At\n    HEAD the same mis-slice pulls `return MSG` (the body of uses_sep) into the\n    residual and drops part of the real residual span.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss06_cochange_survives_non_ascii_filenames"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss06_cochange_survives_non_ascii_filenames", `name`: "test_iss06_cochange_survives_non_ascii_filenames", `qualname`: "test_iss06_cochange_survives_non_ascii_filenames", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1102, `end_line`: 1123, `signature`: "def test_iss06_cochange_survives_non_ascii_filenames(tmp_path):", `docstring`: "AC-3/AC-4 (ISS-06): two non-ASCII paths committed together three times\n    must yield a CO_CHANGE edge. At HEAD `git log` runs with text=True and\n    core.quotepath=true, so the paths come back quoted/locale-decoded, never\n    match file_index, and the edge silently vanishes (or raises\n    UnicodeDecodeError on a non-UTF-8 locale).", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_sh1_add_cochange_splits_git_log_on_newline_only"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_sh1_add_cochange_splits_git_log_on_newline_only", `name`: "test_sh1_add_cochange_splits_git_log_on_newline_only", `qualname`: "test_sh1_add_cochange_splits_git_log_on_newline_only", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1126, `end_line`: 1141, `signature`: "def test_sh1_add_cochange_splits_git_log_on_newline_only(monkeypatch):", `docstring`: "REVIEW SH-1 (ISS-22 bug class, graph.py:380): add_cochange must split\n    `git log` output on \"\\\\n\" only. With core.quotepath=false git emits a path\n    containing a raw U+2028; str.splitlines() would cut that path in two so\n    neither fragment matches file_index and the CO_CHANGE edge vanishes.", `entrypoint`: true, `reach`: 10};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss27_graphml_roundtrips_with_a_control_char"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss27_graphml_roundtrips_with_a_control_char", `name`: "test_iss27_graphml_roundtrips_with_a_control_char", `qualname`: "test_iss27_graphml_roundtrips_with_a_control_char", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1144, `end_line`: 1170, `signature`: "def test_iss27_graphml_roundtrips_with_a_control_char(tmp_path):", `docstring`: "AC-5 (ISS-27): a C0 control char inside a docstring must not make the\n    GraphML unparseable. stdlib only, never skipped. At HEAD ElementTree writes\n    the raw \\\\x0c and ET.parse raises ParseError.", `entrypoint`: true, `reach`: 159};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss19_parse_spec_rejects_traversal_and_option_specs"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss19_parse_spec_rejects_traversal_and_option_specs", `name`: "test_iss19_parse_spec_rejects_traversal_and_option_specs", `qualname`: "test_iss19_parse_spec_rejects_traversal_and_option_specs", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1174, `end_line`: 1180, `signature`: "def test_iss19_parse_spec_rejects_traversal_and_option_specs(spec):", `docstring`: "AC-6 (ISS-19): traversal / option-like specs must raise. At HEAD\n    parse_spec(\"owner/..\") returns (\"owner\", \"..\") instead of raising.", `entrypoint`: true};
MERGE (n:R2G:Symbol {id: "sym:tests/test_repo2graph.py::test_iss19_parse_spec_still_accepts_valid_specs"}) SET n += {`id`: "sym:tests/test_repo2graph.py::test_iss19_parse_spec_still_accepts_valid_specs", `name`: "test_iss19_parse_spec_still_accepts_valid_specs", `qualname`: "test_iss19_parse_spec_still_accepts_valid_specs", `kind`: "function", `path`: "tests/test_repo2graph.py", `lang`: "python", `start_line`: 1191, `end_line`: 1195, `signature`: "def test_iss19_parse_spec_still_accepts_valid_specs(spec):", `docstring`: "AC-6 (ISS-19): the hardening must not reject legitimate specs.", `entrypoint`: true};
