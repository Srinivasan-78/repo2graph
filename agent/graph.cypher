MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rrf_weights.py::test_rrf_unweighted_default_matches_exact_formula"}) SET n += {`id`: "sym:tests/test_rrf_weights.py::test_rrf_unweighted_default_matches_exact_formula", `name`: "test_rrf_unweighted_default_matches_exact_formula", `qualname`: "test_rrf_unweighted_default_matches_exact_formula", `kind`: "function", `path`: "tests/test_rrf_weights.py", `lang`: "python", `start_line`: 45, `end_line`: 65, `signature`: "def test_rrf_unweighted_default_matches_exact_formula(tmp_path: Path):", `docstring`: "Default weights=(1.0, 1.0) must match standard RRF formula: 1/(K+r1) + 1/(K+r2).", `entrypoint`: true};
MERGE (n:R2G:`Symbol` {id: "sym:tests/test_rrf_weights.py::test_rrf_weighted_formula_applies_multipliers"}) SET n += {`id`: "sym:tests/test_rrf_weights.py::test_rrf_weighted_formula_applies_multipliers", `name`: "test_rrf_weighted_formula_applies_multipliers", `qualname`: "test_rrf_weighted_formula_applies_multipliers", `kind`: "function", `path`: "tests/test_rrf_weights.py", `lang`: "python", `start_line`: 68, `end_line`: 104, `signature`: "def test_rrf_weighted_formula_applies_multipliers(tmp_path: Path):", `docstring`: "Custom weights=(2.0, 0.5) must compute w_bm25/(K+r1) + w_vec/(K+r2).", `entrypoint`: true};
