MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::write_overview"}) SET n += {`id`: "sym:repo2graph/export.py::write_overview", `name`: "write_overview", `qualname`: "write_overview", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 485, `end_line`: 517, `signature`: "def write_overview(g, path: Path, top: int = 25):", `docstring`: "Human/LLM-readable repo map: top directories, hub files, entry points."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_git_short_sha"}) SET n += {`id`: "sym:repo2graph/export.py::_git_short_sha", `name`: "_git_short_sha", `qualname`: "_git_short_sha", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 520, `end_line`: 550, `signature`: "def _git_short_sha(root) -> str | None:", `docstring`: "The short commit `root` was built at, or None outside a git repo.\n\n    Same subprocess pattern as graph.add_cochange / walker._git_files (see\n    AGENTS.md): quotepath=false, bytes decoded with surrogateescape (never\n    text=True -- a Windows cp1252 locale raises UnicodeDecodeError on any\n    non-ASCII byte), stdin closed, bounded timeout. Any failure -- not a repo,\n    no git on PATH, a slow filesystem -- just omits the \"Built at\" row."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::write_overview_human"}) SET n += {`id`: "sym:repo2graph/export.py::write_overview_human", `name`: "write_overview_human", `qualname`: "write_overview_human", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 562, `end_line`: 657, `signature`: "def write_overview_human(g, path: Path, top: int = 25):", `docstring`: "Structured, scannable repo map for `human/overview.md`.\n\n    Unlike `write_overview` (still the agent/overview.md prose, unchanged),\n    this reads edge-type and symbol-kind counts straight out of `g.stats`\n    rather than rescanning `g.nodes`/`g.edges`, per the repo convention that\n    `g.stats` is the single source of truth for those counts."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::write_manifest"}) SET n += {`id`: "sym:repo2graph/export.py::write_manifest", `name`: "write_manifest", `qualname`: "write_manifest", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 757, `end_line`: 834, `signature`: "def write_manifest(g, path: Path, written: list[str]):", `docstring`: "Describe the agent-facing output so a reader needs no other docs."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_stats_extra"}) SET n += {`id`: "sym:repo2graph/export.py::_stats_extra", `name`: "_stats_extra", `qualname`: "_stats_extra", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 842, `end_line`: 891, `signature`: "def _stats_extra(g) -> dict:", `docstring`: "Additive stats.json fields, computed live from `g` at write time.\n\n    Never re-read from nodes.jsonl/edges.jsonl -- dump_all always has the\n    Graph in memory here, and re-deriving from the files it is about to write\n    would be a circular dependency for no reason."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::_mark_has_vectors"}) SET n += {`id`: "sym:repo2graph/export.py::_mark_has_vectors", `name`: "_mark_has_vectors", `qualname`: "_mark_has_vectors", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 894, `end_line`: 911, `signature`: "def _mark_has_vectors(outdir) -> None:", `docstring`: "Flip stats.json's has_vectors to True after `embed` writes vectors.npy.\n\n    Best-effort, same as register_written: a missing or unreadable stats.json\n    (e.g. a fixture built with --formats that never writes one) is not\n    embed's problem to fix, so any failure here is silently skipped."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::register_written"}) SET n += {`id`: "sym:repo2graph/export.py::register_written", `name`: "register_written", `qualname`: "register_written", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 914, `end_line`: 945, `signature`: "def register_written(outdir, names) -> bool:", `docstring`: "Merge `names` into an existing manifest's `written` and `files`.\n\n    `embed` runs after `build` as a separate command, so it must append to the\n    manifest dump_all already wrote rather than rewrite it: every other key --\n    counts, entrypoints, how_to_read -- is left exactly as it was. Returns\n    False when there is no readable manifest to append to."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::write_state"}) SET n += {`id`: "sym:repo2graph/export.py::write_state", `name`: "write_state", `qualname`: "write_state", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 948, `end_line`: 956, `signature`: "def write_state(g, path: Path, n_chunks: int):", `docstring`: "The per-file content hashes a later incremental build reads back."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::write_parse_cache"}) SET n += {`id`: "sym:repo2graph/export.py::write_parse_cache", `name`: "write_parse_cache", `qualname`: "write_parse_cache", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 959, `end_line`: 974, `signature`: "def write_parse_cache(g, path: Path):", `docstring`: "Write the per-file parse cache the next `--incremental` build reads.\n\n    Args:\n        g: The Graph just built; its `parse_cache` is the payload.\n        path: Destination for `parse.cache.json`."};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::load_parse_cache"}) SET n += {`id`: "sym:repo2graph/export.py::load_parse_cache", `name`: "load_parse_cache", `qualname`: "load_parse_cache", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 977, `end_line`: 1002, `signature`: "def load_parse_cache(outdir: Path) -> dict:", `docstring`: "Read a previous build's parse cache out of an index directory.\n\n    Every failure mode -- no index, no cache file, unreadable, malformed JSON,\n    a format bump -- returns an empty dict, which makes the next build a full\n    one. An incremental build that silently reuses entries it does not\n    understand is the failure this whole feature was deferred to avoid, so the\n    only safe response to an unrecognised cache is to ignore it.\n\n    Args:\n        outdir: The index directory (the one holding `agent/`).\n\n    Returns:\n        `{relpath: entry}`, or an empty dict when no usable cache is presen"};
MERGE (n:R2G:Symbol {id: "sym:repo2graph/export.py::dump_all"}) SET n += {`id`: "sym:repo2graph/export.py::dump_all", `name`: "dump_all", `qualname`: "dump_all", `kind`: "function", `path`: "repo2graph/export.py", `lang`: "python", `start_line`: 1005, `end_line`: 1045, `signature`: "def dump_all(g, chunks, outdir: Path, formats: set[str], viz_nodes: int = MAX_NODES):", `docstring`: "Write the requested artifacts. `chunks` is an iterable of chunk dicts (a\n    build_chunks generator) or None. Returns (written_paths, chunk_count)."};
