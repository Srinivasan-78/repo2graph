      <data key="d13">299</data>
      <data key="d14">def test_iss240_both_cpp_invocations_close_stdin(mock_run):</data>
      <data key="d15">#240: capture_output redirects the child's stdout and stderr only, so
    without stdin=DEVNULL cpp inherits ours -- under repo2graph-mcp on stdio
    that handle is the client's JSON-RPC pipe. Asserted at the call site as
    well as in test_compat's whole-package AST sweep.</data>
      <data key="d16">true</data>
      <data key="d_nodegraphics">
        <y:ShapeNode>
