    <node id="sym:tests/test_pr_impact.py::test_iss422_disconnected_rule_skips_files_the_graph_cannot_relate">
      <data key="d0">sym:tests/test_pr_impact.py::test_iss422_disconnected_rule_skips_files_the_graph_cannot_relate</data>
      <data key="d1">symbol</data>
      <data key="d2">test_iss422_disconnected_rule_skips_files_the_graph_cannot_relate</data>
