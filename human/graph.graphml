      <data key="d13">384</data>
      <data key="d14">def main(argv=None) -&gt; int:
    # $GITHUB_STEP_SUMMARY is UTF-8 and the map/hub labels can carry non-ASCII
    # names; a Windows console's default stdout codec is not UTF-8, so pin it
    # explicitly rather than let this depend on the runner's locale.</data>
      <data key="d15" />
      <data key="d16">true</data>
