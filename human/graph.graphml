    <node id="sym:tests/test_http_transport.py::test_iss249_a_chunked_request_body_is_refused_with_411">
      <data key="d0">sym:tests/test_http_transport.py::test_iss249_a_chunked_request_body_is_refused_with_411</data>
      <data key="d1">symbol</data>
      <data key="d2">test_iss249_a_chunked_request_body_is_refused_with_411</data>
