      <data key="d11">function</data>
      <data key="d3">tests/test_integrity.py</data>
      <data key="d4">python</data>
      <data key="d12">290</data>
      <data key="d13">314</data>
      <data key="d14">def test_an_aged_lock_is_not_stolen_from_a_live_holder(self, tmp_path):</data>
      <data key="d15">A build slower than the stale threshold keeps its lock.

        `_write_metadata` runs once, at acquire, so mtime measures how long
        the holder has been working -- not whether it is stuck. Reclaiming on
        that alone meant any build over the threshold was joined by a second.</data>
      <data key="d16">true</data>
      <data key="d_nodegraphics">
        <y:ShapeNode>
          <y:Geometry x="0.00" y="3892.35" width="145.20" height="31.20" />
