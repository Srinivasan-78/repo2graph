          <y:BorderStyle color="#4a4f57" type="line" width="1.0" />
          <y:NodeLabel alignment="center" fontSize="11" textColor="#1c2330" visible="true">test_degraded_…</y:NodeLabel>
          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
    <node id="sym:tests/test_prod_igy.py::test_comment_never_discloses_how_the_summary_is_produced">
      <data key="d0">sym:tests/test_prod_igy.py::test_comment_never_discloses_how_the_summary_is_produced</data>
      <data key="d1">symbol</data>
