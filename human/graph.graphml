    <node id="sym:tests/test_secrets_hardening.py::test_repo_read_redacts_at_serve_time_like_repo_search_does">
      <data key="d0">sym:tests/test_secrets_hardening.py::test_repo_read_redacts_at_serve_time_like_repo_search_does</data>
      <data key="d1">symbol</data>
