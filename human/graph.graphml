      <data key="d11">function</data>
      <data key="d3">repo2graph/answer.py</data>
      <data key="d4">python</data>
      <data key="d12">254</data>
      <data key="d13">258</data>
      <data key="d14">def __init__(self, resp, limit: int):</data>
      <data key="d15" />
      <data key="d_nodegraphics">
        <y:ShapeNode>
