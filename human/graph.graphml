    <node id="sym:tests/test_http_surface_removed.py::test_no_module_imports_an_http_framework_or_jwt_library">
      <data key="d0">sym:tests/test_http_surface_removed.py::test_no_module_imports_an_http_framework_or_jwt_library</data>
