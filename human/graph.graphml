    <node id="sym:tests/test_prod_igy.py::test_degraded_run_is_invisible_to_the_contributor">
      <data key="d0">sym:tests/test_prod_igy.py::test_degraded_run_is_invisible_to_the_contributor</data>
      <data key="d1">symbol</data>
