    <node id="sym:tests/test_http_transport.py::test_iss233_a_deeply_nested_json_body_is_a_clean_400">
      <data key="d0">sym:tests/test_http_transport.py::test_iss233_a_deeply_nested_json_body_is_a_clean_400</data>
      <data key="d1">symbol</data>
