    <node id="sym:tests/test_doctor.py::test_doctor_generated_code_suggests_a_fix_that_actually_excludes">
      <data key="d0">sym:tests/test_doctor.py::test_doctor_generated_code_suggests_a_fix_that_actually_excludes</data>
      <data key="d1">symbol</data>
      <data key="d2">test_doctor_generated_code_suggests_a_fix_that_actually_excludes</data>
