    <node id="sym:tests/test_answer_limits.py::SizedResponse">
      <data key="d0">sym:tests/test_answer_limits.py::SizedResponse</data>
      <data key="d1">symbol</data>
      <data key="d2">SizedResponse</data>
      <data key="d10">SizedResponse</data>
      <data key="d11">class</data>
