    <node id="sym:repo2graph/mcp.py::_bidirectional_bfs">
      <data key="d0">sym:repo2graph/mcp.py::_bidirectional_bfs</data>
      <data key="d1">symbol</data>
      <data key="d2">_bidirectional_bfs</data>
      <data key="d10">_bidirectional_bfs</data>
      <data key="d11">function</data>
