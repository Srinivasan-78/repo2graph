    <node id="sym:tests/test_prod_igy.py::test_ai_failure_falls_back_to_the_pre_ai_behaviour">
      <data key="d0">sym:tests/test_prod_igy.py::test_ai_failure_falls_back_to_the_pre_ai_behaviour</data>
      <data key="d1">symbol</data>
