    <node id="sym:tests/test_integrity.py::TestVerifyArtifacts.test_manifest_cannot_name_a_path_outside_the_index">
      <data key="d0">sym:tests/test_integrity.py::TestVerifyArtifacts.test_manifest_cannot_name_a_path_outside_the_index</data>
      <data key="d1">symbol</data>
      <data key="d2">test_manifest_cannot_name_a_path_outside_the_index</data>
      <data key="d10">TestVerifyArtifacts.test_manifest_cannot_name_a_path_outside_the_index</data>
      <data key="d11">function</data>
      <data key="d3">tests/test_integrity.py</data>
      <data key="d4">python</data>
      <data key="d12">543</data>
      <data key="d13">572</data>
      <data key="d14">def test_manifest_cannot_name_a_path_outside_the_index(self, tmp_path, shape):</data>
      <data key="d15">An absolute or escaping key must be refused before anything is read.

        `out / rel_path` discards `out` when rel_path is absolute, so the loop
        used to hash any file the process could reach and put the real digest
        in `errors` -- a hash-disclosure oracle -- while a missing file
        reported differently from a mismatching one, probing for existence.</data>
      <data key="d16">true</data>
      <data key="d_nodegraphics">
        <y:ShapeNode>
          <y:Geometry x="5954.32" y="3412.90" width="148.23" height="31.85" />
          <y:Fill color="#57C7E3" transparent="false" />
          <y:BorderStyle color="#4a4f57" type="line" width="1.0" />
          <y:NodeLabel alignment="center" fontSize="11" textColor="#1c2330" visible="true">TestVerifyArti…</y:NodeLabel>
          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
