      <data key="d12">1081</data>
      <data key="d13">1102</data>
      <data key="d14">def _reject(self, rpc_id: Any, method: str, params: Any, exc: AuthError) -&gt; None:</data>
      <data key="d15">Refuse a call, record it, and execute nothing.</data>
