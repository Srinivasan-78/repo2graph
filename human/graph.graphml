    <node id="sym:tests/test_repo2graph.py::test_add_cochange_byte_cap_drops_trailing_partial_commit">
      <data key="d0">sym:tests/test_repo2graph.py::test_add_cochange_byte_cap_drops_trailing_partial_commit</data>
      <data key="d1">symbol</data>
      <data key="d2">test_add_cochange_byte_cap_drops_trailing_partial_commit</data>
      <data key="d10">test_add_cochange_byte_cap_drops_trailing_partial_commit</data>
      <data key="d11">function</data>
      <data key="d3">tests/test_repo2graph.py</data>
      <data key="d4">python</data>
      <data key="d12">2775</data>
      <data key="d13">2795</data>
      <data key="d14">def test_add_cochange_byte_cap_drops_trailing_partial_commit(monkeypatch):</data>
      <data key="d15">When stdout exceeds MAX_COCHANGE_BYTES, the cut truncates the oldest
    commit block. If that commit originally touched &gt; 25 files (a noise commit),
    truncating it must not leave a surviving slice (&lt;= 25 files) that emits
    spurious CO_CHANGE pairs.</data>
      <data key="d16">true</data>
      <data key="d17">66</data>
