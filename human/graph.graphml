    <node id="sym:tests/test_pr_impact.py::test_is_test_path_matches_components_not_a_path_suffix">
      <data key="d0">sym:tests/test_pr_impact.py::test_is_test_path_matches_components_not_a_path_suffix</data>
      <data key="d1">symbol</data>
      <data key="d2">test_is_test_path_matches_components_not_a_path_suffix</data>
      <data key="d10">test_is_test_path_matches_components_not_a_path_suffix</data>
      <data key="d11">function</data>
      <data key="d3">tests/test_pr_impact.py</data>
      <data key="d4">python</data>
      <data key="d12">267</data>
      <data key="d13">283</data>
      <data key="d14">def test_is_test_path_matches_components_not_a_path_suffix():</data>
      <data key="d15">A production module whose name merely ends in `test.py` is not a test.

    The suffix form (`path.endswith("test.py")`) classified `latest.py` as test
    code, which removed every symbol in it from the public API surface, let the
    file count as its own test coverage, and made every rule that skips tests
    skip it.</data>
      <data key="d16">true</data>
      <data key="d_nodegraphics">
        <y:ShapeNode>
          <y:Geometry x="6571.38" y="4340.55" width="127.05" height="27.30" />
          <y:Fill color="#57C7E3" transparent="false" />
          <y:BorderStyle color="#4a4f57" type="line" width="1.0" />
          <y:NodeLabel alignment="center" fontSize="11" textColor="#1c2330" visible="true">test_is_test_p…</y:NodeLabel>
          <y:Shape type="ellipse" />
