          <y:NodeLabel alignment="center" fontSize="11" textColor="#1c2330" visible="true">_warn_locking_…</y:NodeLabel>
          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
    <node id="sym:repo2graph/audit.py::_LockedAppender">
      <data key="d0">sym:repo2graph/audit.py::_LockedAppender</data>
      <data key="d1">symbol</data>
      <data key="d2">_LockedAppender</data>
      <data key="d10">_LockedAppender</data>
      <data key="d11">class</data>
