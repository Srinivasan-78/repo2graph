          <y:Geometry x="332.35" y="2224.85" width="160.32" height="34.45" />
          <y:Fill color="#57C7E3" transparent="false" />
          <y:BorderStyle color="#4a4f57" type="line" width="1.0" />
          <y:NodeLabel alignment="center" fontSize="11" textColor="#1c2330" visible="true">test_a_cheap_c…</y:NodeLabel>
          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
