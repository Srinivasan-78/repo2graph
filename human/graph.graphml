    <node id="sym:tests/test_mcp.py::test_serve_reports_its_own_version_not_the_sdks">
      <data key="d0">sym:tests/test_mcp.py::test_serve_reports_its_own_version_not_the_sdks</data>
      <data key="d1">symbol</data>
