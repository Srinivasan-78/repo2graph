    <node id="sym:repo2graph/query.py::Index._load_text">
      <data key="d0">sym:repo2graph/query.py::Index._load_text</data>
      <data key="d1">symbol</data>
      <data key="d2">_load_text</data>
      <data key="d10">Index._load_text</data>
      <data key="d11">function</data>
      <data key="d3">repo2graph/query.py</data>
      <data key="d5">python</data>
      <data key="d12">169</data>
      <data key="d13">182</data>
      <data key="d14">def _load_text(self, name: str) -&gt; str:</data>
      <data key="d15">Read an optional artifact, trying every section it is written to.

        newline="\n" for the same reason read_jsonl uses it: universal-newline
        mode rewrites U+2028/U+2029/U+0085 line ends and would desync the text
        from what was written.</data>
