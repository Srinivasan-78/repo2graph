        </y:ShapeNode>
      </data>
    </node>
    <node id="sym:tests/test_scoped_resolution.py::test_a_cache_without_resolution_evidence_is_refused">
      <data key="d0">sym:tests/test_scoped_resolution.py::test_a_cache_without_resolution_evidence_is_refused</data>
      <data key="d1">symbol</data>
      <data key="d2">test_a_cache_without_resolution_evidence_is_refused</data>
      <data key="d10">test_a_cache_without_resolution_evidence_is_refused</data>
      <data key="d11">function</data>
      <data key="d3">tests/test_scoped_resolution.py</data>
      <data key="d4">python</data>
      <data key="d12">720</data>
      <data key="d13">748</data>
      <data key="d14">def test_a_cache_without_resolution_evidence_is_refused(tmp_path: Path):</data>
      <data key="d15">A cache written before this PR must be rejected, not half-read.

    Its entries carry no `import_details`, `call_details` or `base_details`, so
    every cached symbol would come back with `call_kind='static'` and every
    aliased import unresolved. `PARSE_CACHE_FORMAT` is the only thing standing
    between such a cache and a silently wrong incremental build, which is why
    the constant has to move whenever an entry's shape does.</data>
      <data key="d16">true</data>
      <data key="d17">46</data>
      <data key="d_nodegraphics">
        <y:ShapeNode>
          <y:Geometry x="1265.88" y="4161.15" width="157.30" height="33.80" />
          <y:Fill color="#57C7E3" transparent="false" />
          <y:BorderStyle color="#4a4f57" type="line" width="1.0" />
          <y:NodeLabel alignment="center" fontSize="11" textColor="#1c2330" visible="true">test_a_cache_w…</y:NodeLabel>
          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
