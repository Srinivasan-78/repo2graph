    <node id="sym:tests/test_prod_igy.py::test_iss375_app_token_probe_env_is_job_level_not_step_level">
      <data key="d0">sym:tests/test_prod_igy.py::test_iss375_app_token_probe_env_is_job_level_not_step_level</data>
      <data key="d1">symbol</data>
      <data key="d2">test_iss375_app_token_probe_env_is_job_level_not_step_level</data>
      <data key="d10">test_iss375_app_token_probe_env_is_job_level_not_step_level</data>
      <data key="d11">function</data>
      <data key="d3">tests/test_prod_igy.py</data>
      <data key="d4">python</data>
      <data key="d12">1088</data>
      <data key="d13">1124</data>
      <data key="d14">def test_iss375_app_token_probe_env_is_job_level_not_step_level():</data>
      <data key="d15">#375: the app-token step's `if:` used to read `env.HAS_APP_ID` /
    `env.HAS_PRIVATE_KEY` from an `env:` block declared on that same step,
    which works only if the step's own `env:` is guaranteed resolved before
    its `if:` evaluates -- behaviour GitHub documents loosely. Promoting the
    probes to job level removes the ordering question: every step's `if:`
    reads the same job-level env the normal way.</data>
      <data key="d16">true</data>
