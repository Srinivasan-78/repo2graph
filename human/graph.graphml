      <data key="d10">test_iss244_audit_log_fsync_is_opt_in_from_the_command_line.RecordingAudit</data>
      <data key="d11">class</data>
      <data key="d3">tests/test_mcp.py</data>
      <data key="d4">python</data>
      <data key="d12">1876</data>
      <data key="d13">1881</data>
      <data key="d14">class RecordingAudit:</data>
      <data key="d15" />
