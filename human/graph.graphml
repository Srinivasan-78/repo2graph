    <node id="sym:tests/test_repo2graph.py::test_manifest_states_the_fan_out_this_build_used">
      <data key="d0">sym:tests/test_repo2graph.py::test_manifest_states_the_fan_out_this_build_used</data>
      <data key="d1">symbol</data>
      <data key="d2">test_manifest_states_the_fan_out_this_build_used</data>
      <data key="d10">test_manifest_states_the_fan_out_this_build_used</data>
      <data key="d11">function</data>
      <data key="d3">tests/test_repo2graph.py</data>
      <data key="d4">python</data>
      <data key="d12">748</data>
      <data key="d13">772</data>
      <data key="d14">def test_manifest_states_the_fan_out_this_build_used(tmp_path, sample_repo, limit):</data>
      <data key="d15">#245: the fan-out limit is per build (`--max-call-candidates`), but the
    manifest's prose used to hardcode "up to 5" -- so an index built with 2
    shipped an artifact asserting 5, to an agent that was told the manifest is
    authoritative. Both limits here are non-default literals on purpose: at the
    default the buggy text and the correct text are the same string, so a test
    run only at 5 detects nothing.</data>
      <data key="d16">true</data>
      <data key="d_nodegraphics">
        <y:ShapeNode>
          <y:Geometry x="5441.22" y="4496.40" width="148.23" height="31.85" />
          <y:Fill color="#57C7E3" transparent="false" />
          <y:BorderStyle color="#4a4f57" type="line" width="1.0" />
          <y:NodeLabel alignment="center" fontSize="11" textColor="#1c2330" visible="true">test_manifest_…</y:NodeLabel>
          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
