      <data key="d2">_safe_read_bytes</data>
      <data key="d10">_safe_read_bytes</data>
      <data key="d11">function</data>
      <data key="d3">repo2graph/graph.py</data>
      <data key="d4">python</data>
      <data key="d12">1047</data>
      <data key="d13">1070</data>
      <data key="d14">def _safe_read_bytes(path: Path) -&gt; bytes:</data>
      <data key="d15">Read file bytes using O_NOFOLLOW where supported to avoid symlink TOCTOU races.

    On POSIX systems, O_NOFOLLOW causes open() to fail if the trailing component is a
    symlink (protecting against an attacker replacing a discovered regular file with a
    symlink to a sensitive file before open). On Windows, O_NOFOLLOW is not supported
    by the OS open(), so standard read flags are used.</data>
      <data key="d_nodegraphics">
        <y:ShapeNode>
          <y:Geometry x="1087.50" y="1141.30" width="172.43" height="37.05" />
          <y:Fill color="#57C7E3" transparent="false" />
          <y:BorderStyle color="#4a4f57" type="line" width="1.0" />
          <y:NodeLabel alignment="center" fontSize="11" textColor="#1c2330" visible="true">_safe_read_byt…</y:NodeLabel>
          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
