    <node id="sym:tests/test_repo2graph.py::test_iss16_token_never_appears_in_clone_argv">
      <data key="d0">sym:tests/test_repo2graph.py::test_iss16_token_never_appears_in_clone_argv</data>
      <data key="d1">symbol</data>
      <data key="d2">test_iss16_token_never_appears_in_clone_argv</data>
      <data key="d10">test_iss16_token_never_appears_in_clone_argv</data>
      <data key="d11">function</data>
      <data key="d3">tests/test_repo2graph.py</data>
      <data key="d4">python</data>
      <data key="d12">1431</data>
      <data key="d13">1443</data>
      <data key="d14">def test_iss16_token_never_appears_in_clone_argv(tmp_path, monkeypatch):</data>
      <data key="d15">AC-7 (ISS-16): no argv element handed to subprocess.run may contain the
