    <node id="sym:tests/test_http_transport.py::test_iss243_a_crlf_in_the_oidc_issuer_cannot_inject_a_response_header">
      <data key="d0">sym:tests/test_http_transport.py::test_iss243_a_crlf_in_the_oidc_issuer_cannot_inject_a_response_header</data>
      <data key="d1">symbol</data>
      <data key="d2">test_iss243_a_crlf_in_the_oidc_issuer_cannot_inject_a_response_header</data>
