    <node id="sym:tests/test_pr_impact.py::test_untested_public_api_rule_needs_the_graph_to_know_the_caller">
      <data key="d0">sym:tests/test_pr_impact.py::test_untested_public_api_rule_needs_the_graph_to_know_the_caller</data>
      <data key="d1">symbol</data>
