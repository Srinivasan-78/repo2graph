    <node id="sym:tests/test_determinism.py::test_serial_and_parallel_builds_agree">
      <data key="d0">sym:tests/test_determinism.py::test_serial_and_parallel_builds_agree</data>
      <data key="d1">symbol</data>
      <data key="d2">test_serial_and_parallel_builds_agree</data>
