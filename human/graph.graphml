    <node id="sym:tests/test_explain.py::test_selected_seeds_are_all_visible_in_the_text_report">
      <data key="d0">sym:tests/test_explain.py::test_selected_seeds_are_all_visible_in_the_text_report</data>
      <data key="d1">symbol</data>
      <data key="d2">test_selected_seeds_are_all_visible_in_the_text_report</data>
      <data key="d10">test_selected_seeds_are_all_visible_in_the_text_report</data>
