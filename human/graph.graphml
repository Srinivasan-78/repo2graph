    <node id="sym:tests/test_http_hardening.py::test_make_handler_binds_configuration_onto_the_handler_class">
      <data key="d0">sym:tests/test_http_hardening.py::test_make_handler_binds_configuration_onto_the_handler_class</data>
      <data key="d1">symbol</data>
      <data key="d2">test_make_handler_binds_configuration_onto_the_handler_class</data>
