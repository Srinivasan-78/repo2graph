          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
    <node id="sym:repo2graph/answer.py::_note_timed_out">
      <data key="d0">sym:repo2graph/answer.py::_note_timed_out</data>
      <data key="d1">symbol</data>
      <data key="d2">_note_timed_out</data>
      <data key="d10">_note_timed_out</data>
      <data key="d11">function</data>
      <data key="d3">repo2graph/answer.py</data>
      <data key="d4">python</data>
      <data key="d12">381</data>
      <data key="d13">396</data>
      <data key="d14">def _note_timed_out(name: str, seconds: float) -&gt; None:</data>
      <data key="d15">Say on stderr that the stream ran past its wall-clock budget.

    Distinct wording from `_note_truncated` on purpose: "too slow" and "too
    much" point at different causes, and a user who sees the byte-ceiling
    message for a stalled endpoint will go looking for an answer that was never
    large.</data>
      <data key="d_nodegraphics">
        <y:ShapeNode>
