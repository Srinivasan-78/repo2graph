    <node id="sym:tests/test_repo2graph.py::test_iss141_file_chunk0_id_matches_node_id">
      <data key="d0">sym:tests/test_repo2graph.py::test_iss141_file_chunk0_id_matches_node_id</data>
      <data key="d1">symbol</data>
