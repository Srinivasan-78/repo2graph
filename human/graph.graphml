      <data key="d2">blend</data>
      <data key="d9">drawText.blend</data>
      <data key="d10">function</data>
      <data key="d3">.authormark/authormark.mjs</data>
      <data key="d5">javascript</data>
      <data key="d11">567</data>
      <data key="d12">572</data>
      <data key="d13">blend = (px, py, rgb, a) =&gt; {
    if (px &lt; 0 || py &lt; 0 || px &gt;= W || py &gt;= H) return;
    const o = (py * W + px) * 4;
    for (let k = 0; k &lt; 3; k++) rgba[o + k] = Math.round(rgba[o + k] * (1 - a) + rgb[k] * a);
    if (rgba[o + 3] &lt; 255) rgba[o + 3] = Math.max(rgba[o + 3], Math.round(255 * a));</data>
      <data key="d14" />
      <data key="d4">
        <y:ShapeNode>
          <y:Geometry x="1131.02" y="2879.94" width="125.40" height="28.60" />
