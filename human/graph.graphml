    <node id="sym:tests/test_integrity.py::TestBuildLock.test_an_aged_lock_is_not_stolen_from_a_live_holder">
      <data key="d0">sym:tests/test_integrity.py::TestBuildLock.test_an_aged_lock_is_not_stolen_from_a_live_holder</data>
      <data key="d1">symbol</data>
      <data key="d2">test_an_aged_lock_is_not_stolen_from_a_live_holder</data>
