    <node id="sym:tests/test_mcp.py::test_iss407_a_1x_sdk_is_refused_at_startup_not_hung">
      <data key="d0">sym:tests/test_mcp.py::test_iss407_a_1x_sdk_is_refused_at_startup_not_hung</data>
      <data key="d1">symbol</data>
      <data key="d2">test_iss407_a_1x_sdk_is_refused_at_startup_not_hung</data>
