          <y:NodeLabel alignment="center" fontSize="11" textColor="#1c2330" visible="true">test_filesyste…</y:NodeLabel>
          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
    <node id="sym:tests/test_determinism.py::test_git_and_walk_discovery_agree_on_the_same_tree">
      <data key="d0">sym:tests/test_determinism.py::test_git_and_walk_discovery_agree_on_the_same_tree</data>
      <data key="d1">symbol</data>
