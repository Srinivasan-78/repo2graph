    <node id="sym:scripts/generate_examples.py::clone_scoped">
      <data key="d0">sym:scripts/generate_examples.py::clone_scoped</data>
      <data key="d1">symbol</data>
      <data key="d2">clone_scoped</data>
      <data key="d10">clone_scoped</data>
      <data key="d11">function</data>
      <data key="d3">scripts/generate_examples.py</data>
      <data key="d4">python</data>
      <data key="d12">104</data>
      <data key="d13">128</data>
      <data key="d14">def clone_scoped(entry: dict, dest: Path) -&gt; str:</data>
      <data key="d15">Clone entry['url']@entry['ref'] into dest. Returns the checked-out commit SHA.

    Only ever runs: clone (--filter=blob:none, optionally --depth), sparse-checkout
    set, checkout. No submodules, no hooks (clone-triggered hooks do not exist;
    none are ever invoked), no build/test/install commands — that is the whole
    contract of "treat the target repository as untrusted input" from
    docs/benchmarks.md.</data>
      <data key="d_nodegraphics">
        <y:ShapeNode>
          <y:Geometry x="1846.42" y="1487.60" width="125.00" height="32.50" />
          <y:Fill color="#57C7E3" transparent="false" />
          <y:BorderStyle color="#4a4f57" type="line" width="1.0" />
          <y:NodeLabel alignment="center" fontSize="11" textColor="#1c2330" visible="true">clone_scoped</y:NodeLabel>
          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
