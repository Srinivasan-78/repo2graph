          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
    <node id="sym:tests/test_http_transport.py::test_iss249_a_chunked_request_body_is_refused_with_411">
      <data key="d0">sym:tests/test_http_transport.py::test_iss249_a_chunked_request_body_is_refused_with_411</data>
      <data key="d1">symbol</data>
      <data key="d2">test_iss249_a_chunked_request_body_is_refused_with_411</data>
      <data key="d10">test_iss249_a_chunked_request_body_is_refused_with_411</data>
      <data key="d11">function</data>
      <data key="d3">tests/test_http_transport.py</data>
      <data key="d4">python</data>
      <data key="d12">1149</data>
      <data key="d13">1170</data>
      <data key="d14">def test_iss249_a_chunked_request_body_is_refused_with_411(make_server):</data>
      <data key="d15">Issue 249: Content-Length is the only framing `_read_body` understands.

    A chunked body measured as zero bytes was never read, so a spec-legal
    client got "expected a JSON-RPC object" and a socket still holding its
    request. Refusing the encoding by name says what is actually wrong.</data>
      <data key="d16">true</data>
      <data key="d17">17</data>
      <data key="d_nodegraphics">
        <y:ShapeNode>
