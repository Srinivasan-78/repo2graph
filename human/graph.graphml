    <node id="sym:repo2graph/graph.py::mark_entrypoints">
      <data key="d0">sym:repo2graph/graph.py::mark_entrypoints</data>
      <data key="d1">symbol</data>
      <data key="d2">mark_entrypoints</data>
      <data key="d10">mark_entrypoints</data>
