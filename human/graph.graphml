    <node id="sym:tests/test_scoped_resolution.py::test_cache_entry_round_trip_keeps_resolution_evidence">
      <data key="d0">sym:tests/test_scoped_resolution.py::test_cache_entry_round_trip_keeps_resolution_evidence</data>
      <data key="d1">symbol</data>
