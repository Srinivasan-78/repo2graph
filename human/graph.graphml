          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
    <node id="sym:repo2graph/answer.py::_SameOriginRedirect">
      <data key="d0">sym:repo2graph/answer.py::_SameOriginRedirect</data>
