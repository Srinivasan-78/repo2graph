          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
    <node id="sym:repo2graph/chunks.py::_keepends_lf">
      <data key="d0">sym:repo2graph/chunks.py::_keepends_lf</data>
      <data key="d1">symbol</data>
      <data key="d2">_keepends_lf</data>
      <data key="d10">_keepends_lf</data>
      <data key="d11">function</data>
      <data key="d3">repo2graph/chunks.py</data>
      <data key="d4">python</data>
      <data key="d12">66</data>
      <data key="d13">78</data>
      <data key="d14">def _keepends_lf(text: str) -&gt; list[str]:</data>
      <data key="d15">Split on "\\n" only, keeping the newline, so "".join(result) == text.

    str.splitlines(keepends=True) also breaks on U+2028/U+2029/U+0085/\\x0b/\\x0c,
    which tree-sitter does not treat as row breaks; splitting a chunk there makes
    its pieces depend on whichever stray separators the source happens to hold.
    Same "\\n"-only rule as _lines, but lossless.</data>
      <data key="d_nodegraphics">
        <y:ShapeNode>
          <y:Geometry x="4951.67" y="708.00" width="115.00" height="29.90" />
