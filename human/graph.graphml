      <data key="d12">286</data>
      <data key="d13">291</data>
      <data key="d14">def __exit__(self, *exc: Any) -&gt; Literal[False]:
        # Never rounds a real call down to 0: a record showing zero duration
        # reads as "never ran", and telling those apart matters in an audit.</data>
      <data key="d15" />
      <data key="d16">true</data>
