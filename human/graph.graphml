    <node id="sym:tests/test_rag.py::test_ac13_retrieve_keeps_every_edge_direction">
      <data key="d0">sym:tests/test_rag.py::test_ac13_retrieve_keeps_every_edge_direction</data>
      <data key="d1">symbol</data>
      <data key="d2">test_ac13_retrieve_keeps_every_edge_direction</data>
