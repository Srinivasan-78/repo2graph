    <node id="sym:tests/test_http_surface_removed.py::_imported_modules">
      <data key="d0">sym:tests/test_http_surface_removed.py::_imported_modules</data>
      <data key="d1">symbol</data>
      <data key="d2">_imported_modules</data>
      <data key="d10">_imported_modules</data>
      <data key="d11">function</data>
