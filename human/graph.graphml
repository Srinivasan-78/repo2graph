          <y:BorderStyle color="#4a4f57" type="line" width="1.0" />
          <y:NodeLabel alignment="center" fontSize="11" textColor="#1c2330" visible="true">test_ambiguous…</y:NodeLabel>
          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
    <node id="sym:tests/test_pr_impact.py::test_blast_radius_counts_only_confidently_resolved_callers">
      <data key="d0">sym:tests/test_pr_impact.py::test_blast_radius_counts_only_confidently_resolved_callers</data>
      <data key="d1">symbol</data>
      <data key="d2">test_blast_radius_counts_only_confidently_resolved_callers</data>
