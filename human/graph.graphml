          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
    <node id="sym:repo2graph/export.py::_spring">
      <data key="d0">sym:repo2graph/export.py::_spring</data>
      <data key="d1">symbol</data>
      <data key="d2">_spring</data>
      <data key="d10">_spring</data>
      <data key="d11">function</data>
      <data key="d3">repo2graph/export.py</data>
      <data key="d4">python</data>
      <data key="d12">172</data>
      <data key="d13">219</data>
      <data key="d14">def _spring(
    nodes: list[str], adjacency: list[tuple[str, str]], iterations: int
) -&gt; dict[str, Point]:</data>
      <data key="d15">Fruchterman-Reingold in pure Python: networkx's needs numpy, we do not.

    Repulsion runs only between nodes less than 2k apart, bucketed on a grid.
    Past that distance the k^2/d term moves a node by a rounding error, while
    the all-pairs form costs O(n^2) per iteration and dominates big exports.</data>
      <data key="d_nodegraphics">
        <y:ShapeNode>
          <y:Geometry x="5577.88" y="722.35" width="82.88" height="33.15" />
          <y:Fill color="#57C7E3" transparent="false" />
