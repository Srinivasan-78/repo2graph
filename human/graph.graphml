          <y:NodeLabel alignment="center" fontSize="11" textColor="#1c2330" visible="true">test_iss199_a_…</y:NodeLabel>
          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
    <node id="sym:tests/test_http_transport.py::test_iss199_an_escaping_handler_error_is_one_json_line">
      <data key="d0">sym:tests/test_http_transport.py::test_iss199_an_escaping_handler_error_is_one_json_line</data>
      <data key="d1">symbol</data>
