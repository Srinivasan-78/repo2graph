    <node id="sym:tests/test_prod_igy.py::test_ai_text_cannot_forge_a_marker_or_a_mention">
      <data key="d0">sym:tests/test_prod_igy.py::test_ai_text_cannot_forge_a_marker_or_a_mention</data>
      <data key="d1">symbol</data>
      <data key="d2">test_ai_text_cannot_forge_a_marker_or_a_mention</data>
