      <data key="d4">python</data>
      <data key="d12">47</data>
      <data key="d13">79</data>
      <data key="d14">class SizedResponse:</data>
      <data key="d15">A response double that serves sized reads the way urlopen's does.

    `served` counts every byte handed out through *either* access path -- the
    sized `read(n)` the fix uses and the line iteration the old code used -- so
    an assertion on it measures what left the socket, not what the caller
    happened to keep.</data>
      <data key="d_nodegraphics">
        <y:ShapeNode>
          <y:Geometry x="4566.55" y="1651.95" width="128.40" height="31.20" />
          <y:Fill color="#57C7E3" transparent="false" />
          <y:BorderStyle color="#4a4f57" type="line" width="1.0" />
          <y:NodeLabel alignment="center" fontSize="11" textColor="#1c2330" visible="true">SizedResponse</y:NodeLabel>
          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
