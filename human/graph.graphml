    <node id="sym:tests/test_prod_igy.py::test_iss208_format_bot_comment_strips_backticks_from_refs">
      <data key="d0">sym:tests/test_prod_igy.py::test_iss208_format_bot_comment_strips_backticks_from_refs</data>
