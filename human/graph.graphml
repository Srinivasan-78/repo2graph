    <node id="sym:tests/test_mcp.py::test_an_absurdly_long_node_id_is_clamped_before_it_reaches_the_error">
      <data key="d0">sym:tests/test_mcp.py::test_an_absurdly_long_node_id_is_clamped_before_it_reaches_the_error</data>
      <data key="d1">symbol</data>
      <data key="d2">test_an_absurdly_long_node_id_is_clamped_before_it_reaches_the_error</data>
      <data key="d10">test_an_absurdly_long_node_id_is_clamped_before_it_reaches_the_error</data>
      <data key="d11">function</data>
