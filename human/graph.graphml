    <node id="sym:repo2graph/audit.py::AuditConfig">
      <data key="d0">sym:repo2graph/audit.py::AuditConfig</data>
      <data key="d1">symbol</data>
      <data key="d2">AuditConfig</data>
      <data key="d10">AuditConfig</data>
      <data key="d11">class</data>
      <data key="d3">repo2graph/audit.py</data>
      <data key="d4">python</data>
      <data key="d12">263</data>
      <data key="d13">278</data>
      <data key="d14">class AuditConfig:</data>
      <data key="d15">Where audit records go and which ones are kept.

    Attributes:
        level: "none", "errors" (rejections and failures only) or "all".
        path: Optional file to append to in addition to stderr.
        fsync: Sync the file sink to stable storage after every record. Off by
            default: flushing already makes the line whole for anything else
            reading the file, and the same record is on stderr regardless, so
            the cost of a disk sync per tool call buys only crash durability
            for the file copy. Deployments that need exactly that turn it on.</data>
      <data key="d_nodegraphics">
        <y:ShapeNode>
          <y:Geometry x="861.33" y="373.50" width="151.12" height="42.25" />
          <y:Fill color="#57C7E3" transparent="false" />
          <y:BorderStyle color="#4a4f57" type="line" width="1.0" />
          <y:NodeLabel alignment="center" fontSize="11" textColor="#1c2330" visible="true">AuditConfig</y:NodeLabel>
          <y:Shape type="ellipse" />
        </y:ShapeNode>
      </data>
    </node>
